@@ -0,0 +1,233 @@
+#!/usr/bin/env python3
+"""Seat handling: the C-press sit and the engine's own seat objective.
+
+A wandering NPC-mode civilian sits by himself when a seat attractor is in
+reach: OBJECTIVE_GOTO_SEAT_ON_FOOT finishes with SetWaitState(WAITSTATE_SIT_DOWN)
+without any C press. VCModUpdateSitting adopts those wait states so the control
+code cannot walk him off the seat and the camera cannot swing him, but the stock
+25-30 s sit timer stays in charge (the manual sit is the one that holds the loop
+indefinitely).
+
+Drives VCModUpdateSitting and VCModStreetSitUp extracted from PlayerPed.cpp
+against a stub ped. The seat search and the sit-down placement are stubbed;
+their real bodies touch the world and the attractor manager.
+"""
+import re
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+SIT = (ROOT / "src/extras/vcmodsit.cpp").read_text()
+# the seat state lives in the module now; the tests drive the same statics
+STATE = "\n".join(re.findall(r"^static (?:bool|float|CVector) [^\n;]*;", SIT, re.M))
+
+STUBS = r'''
+#include <cstdio>
+#include <cstdint>
+#define nil NULL
+typedef int32_t int32;
+typedef uint32_t uint32;
+
+enum { PED_IDLE, PED_WANDER_PATH };
+enum { WAITSTATE_FALSE, WAITSTATE_SIT_DOWN, WAITSTATE_SIT_DOWN_RVRS,
+       WAITSTATE_SIT_UP, WAITSTATE_SIT_IDLE };
+#define VCMOD_SIT_RANGE 2.0f
+#define VCMOD_SIT_HOLD  600000
+
+struct CVector {
+    float x, y, z;
+    CVector(float x = 0, float y = 0, float z = 0) : x(x), y(y), z(z) {}
+    CVector operator-(const CVector &o) const { return CVector(x - o.x, y - o.y, z - o.z); }
+    float MagnitudeSqr(void) const { return x * x + y * y + z * z; }
+};
+static float sq(float v) { return v * v; }
+static float Abs(float v) { return v < 0 ? -v : v; }
+struct CGeneral {
+    static float LimitRadianAngle(float a) { return a; }
+};
+
+struct CPad {
+    bool controlsDisabled, duck, jump;
+    int walkX, walkY;
+    CPad() : controlsDisabled(false), duck(false), jump(false), walkX(0), walkY(0) {}
+    bool ArePlayerControlsDisabled(void) { return controlsDisabled; }
+    bool DuckJustDown(void) { return duck; }
+    bool JumpJustDown(void) { return jump; }
+    int GetPedWalkLeftRight(void) { return walkX; }
+    int GetPedWalkUpDown(void) { return walkY; }
+};
+
+struct CPlayerPed {
+    int m_nPedState, m_nWaitState;
+    bool bInVehicle, bIsDucking, bIsInWater, bIsInTheAir, bDead;
+    float m_fRotationCur, m_fRotationDest;
+    CVector pos;
+    int waitSets, holdValue, sitUps;
+
+    CPlayerPed() : m_nPedState(PED_IDLE), m_nWaitState(WAITSTATE_FALSE),
+                   bInVehicle(false), bIsDucking(false), bIsInWater(false),
+                   bIsInTheAir(false), bDead(false),
+                   m_fRotationCur(0.0f), m_fRotationDest(0.0f),
+                   waitSets(0), holdValue(0), sitUps(0) {}
+
+    bool DyingOrDead(void) { return bDead; }
+    CVector GetPosition(void) { return pos; }
+    void SetPosition(const CVector &p) { pos = p; }
+    void SetHeading(float) {}
+    void SetWaitState(int state, void *time) {
+        m_nWaitState = state;
+        ++waitSets;
+        if (time) holdValue = *(int *)time;
+    }
+};
+
+bool bVCModNpcMode;
+bool bVCModStreetIdle;
+
+static bool VCModStreetFindSeat(CPlayerPed *player, CVector *pos, float *heading, float *nearest)
+{
+    pos->x = 5.0f;
+    *heading = 1.0f;
+    *nearest = 0.0f;
+    return true;
+}
+static void VCModStreetSeatTakenLog(void) {}
+static void VCModStreetSitRefused(const char *, const char *) {}
+static void VCModStreetSitDown(CPlayerPed *player, const CVector &, float)
+{
+    ++player->sitUps;
+}
+'''
+
+SIGS = [
+    "static void\nVCModStreetSitUp(CPlayerPed *player)",
+    "void\nVCModUpdateSitting(CPlayerPed *player, CPad *pad)",
+]
+
+
+def sit_source():
+    return STUBS + "\n" + STATE + "\n" + "\n".join(braced(SIT, s) for s in SIGS) + "\n"
+
+
+def setup(npc=True, wait="WAITSTATE_SIT_DOWN", state="PED_IDLE"):
+    return f'''
+    bVCModNpcMode = {str(npc).lower()};
+    bVCModStreetIdle = false;      // the command forces it off while it runs
+    bVCModSitting = false;
+    bVCModSitStanding = false;
+    bVCModSitIdleHeld = false;
+    bVCModSitEngine = false;
+    CPlayerPed p; CPad pad;
+    p.m_nPedState = {state};
+    p.m_nWaitState = {wait};
+'''
+
+
+class EngineSitTests(unittest.TestCase):
+    def test_adopts_the_engine_sit(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup() + r'''
+    p.pos = CVector(5.0f, 0.0f, 1.0f);
+    p.m_fRotationCur = 0.75f;
+    VCModUpdateSitting(&p, &pad);
+    if (!bVCModSitting) return 1;              // the lock and skip apply
+    if (!bVCModSitEngine) return 2;            // and the stock timer owns the end
+    if (vecVCModSeatPos.x != 5.0f) return 3;   // the seat anchor is his place
+    if (fVCModSeatHeading != 0.75f) return 4;
+    if (p.waitSets != 0) return 5;             // no timer override on adoption
+    if (p.m_nWaitState != WAITSTATE_SIT_DOWN) return 6;
+    return 0;
+}
+''')
+
+    def test_engine_sit_keeps_the_stock_idle_timer(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(wait="WAITSTATE_SIT_IDLE") + r'''
+    VCModUpdateSitting(&p, &pad);
+    if (p.waitSets != 0) return 1;              // 25-30 s stock, not the 10 min hold
+    if (!bVCModSitIdleHeld) return 2;
+    return 0;
+}
+''')
+
+    def test_manual_sit_still_holds_the_idle(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(wait="WAITSTATE_SIT_IDLE") + r'''
+    bVCModSitting = true;                      // the C press sets this
+    bVCModStreetIdle = true;                   // and only runs when the switch is on
+    VCModUpdateSitting(&p, &pad);
+    if (p.waitSets != 1) return 1;
+    if (p.holdValue != VCMOD_SIT_HOLD) return 2;
+    return 0;
+}
+''')
+
+    def test_engine_sit_ignores_keys_in_npc_mode(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(wait="WAITSTATE_SIT_IDLE") + r'''
+    pad.walkX = 9; pad.walkY = -9; pad.jump = true; pad.duck = true;
+    VCModUpdateSitting(&p, &pad);
+    if (!bVCModSitting) return 1;              // input is ignored in NPC mode
+    if (p.m_nWaitState == WAITSTATE_SIT_UP) return 2;
+    return 0;
+}
+''')
+
+    def test_engine_sit_stands_up_on_input_once_the_mode_is_off(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(npc=False, wait="WAITSTATE_SIT_IDLE") + r'''
+    bVCModSitting = true;
+    bVCModSitEngine = true;
+    pad.jump = true;
+    VCModUpdateSitting(&p, &pad);
+    if (p.m_nWaitState != WAITSTATE_SIT_UP) return 1;
+    if (!bVCModSitStanding) return 2;
+    return 0;
+}
+''')
+
+    def test_engine_sit_ends_when_the_sequence_clears(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(wait="WAITSTATE_FALSE") + r'''
+    bVCModSitting = true;
+    bVCModSitEngine = true;
+    VCModUpdateSitting(&p, &pad);
+    if (bVCModSitting) return 1;
+    if (bVCModSitEngine) return 2;
+    return 0;
+}
+''')
+
+    def test_engine_sit_starts_mid_stand_up(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(wait="WAITSTATE_SIT_UP") + r'''
+    VCModUpdateSitting(&p, &pad);
+    if (!bVCModSitting) return 1;
+    if (!bVCModSitStanding) return 2;          // never re-issue SIT_UP
+    return 0;
+}
+''')
+
+    def test_manual_sit_still_stands_when_street_idle_is_off(self):
+        run_cpp(sit_source() + r'''
+int main(void) {
+''' + setup(wait="WAITSTATE_SIT_IDLE") + r'''
+    bVCModSitting = true;
+    VCModUpdateSitting(&p, &pad);
+    if (p.m_nWaitState != WAITSTATE_SIT_UP) return 1;
+    return 0;
+}
+''')
+
+
+if __name__ == "__main__":
+    unittest.main()
