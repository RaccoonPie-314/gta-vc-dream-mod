+#!/usr/bin/env python3
+"""Personal-driver tests: the summon, the drive to the pick-up, dismissal and the
+skip-the-ride travel, all out of PlayerPed.cpp and run against the passenger
+suite's engine stubs."""
+import unittest
+
+from test_vc_passenger import ride_source, run_cpp
+
+SUMMON_FUNCTIONS = ("notice", "phase", "vehicle", "release", "handback", "standdown", "seatfree",
+                    "style", "drive", "skip", "spawn", "call", "pickup", "entry", "update",
+                    "skipride")
+
+
+class DriverTests(unittest.TestCase):
+    def test_summon(self):
+        run_cpp(ride_source(*SUMMON_FUNCTIONS) + r'''
+int main() {
+    CVehicle veh;
+
+    reset(veh);
+    limoModelLoaded = false;
+    VCModCallDriver();
+    check(saw("request:139"), "the limo model is asked for");
+    check(lastLimo == nil, "a model that never loads spawns nothing");
+    check(saw("notice:driver: the limo cannot be loaded"), "and it says why");
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "no ride is armed");
+
+    reset(veh);
+    noRoadNodes = true;
+    VCModCallDriver();
+    check(lastLimo == nil, "no road to come from means no car");
+    check(saw("notice:driver: no road to come from"), "and it says why");
+
+    reset(veh);
+    spawnDriverFails = true;
+    VCModCallDriver();
+    check(lastLimo != nil, "the car still exists");
+    check(lastLimo->status == STATUS_ABANDONED, "an unmanned limo is left abandoned");
+    check(saw("world:add"), "and is put in the world");
+    check(!saw("blip:5"), "with no blip to follow");
+    check(lastLimo->VehicleCreatedBy == RANDOM_VEHICLE && CCarCtrl::NumMissionCars == 0,
+          "and stays ordinary traffic");
+    check(saw("notice:driver: nobody to drive this"), "and it says why");
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "no ride is armed");
+
+    /* the working call */
+    reset(veh);
+    lastLimo = nil;
+    requestedNode = 1;
+    VCModCallDriver();
+    check(lastLimo != nil, "a limo is created");
+    check(lastLimo->GetModelIndex() == MI_STRETCH, "and it is the Stretch");
+    check(saw("node:0,-80:60"), "the road is looked for behind Tommy");
+    check(lastLimo->GetPosition().x == -80.0f, "the limo starts on that road node");
+    check(lastLimo->GetPosition().z == 1.0f, "sitting on the ground plus its own height");
+    check(lastLimo->GetForward().x == 1.0f, "facing the pick-up");
+    check(saw("onroad"), "it is placed on the road properly");
+    check(lastLimo->status == STATUS_PHYSICS, "with real physics");
+    check(saw("driver"), "a chauffeur is put at the wheel");
+    check(lastLimo->VehicleCreatedBy == MISSION_VEHICLE, "the car is mission-owned");
+    check(CCarCtrl::NumMissionCars == 1 && CCarCtrl::NumRandomCars == 0,
+          "and the traffic counts follow");
+    check(saw("clearspace"), "the spot is cleared for it");
+    check(saw("blip:5"), "it gets a radar blip");
+    check(lastLimo->AutoPilot.m_nCarMission == MISSION_GOTOCOORDS, "it is sent to Tommy");
+    check(saw("goto:5:0,0"), "at the pick-up point");
+    check(lastLimo->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_STOP_FOR_CARS,
+          "driving to the safe style by default");
+    check(lastLimo->AutoPilot.m_nCruiseSpeed == 25, "at the safe approach speed");
