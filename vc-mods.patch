+{
+	VCMOD_PEDCAT_COPS,
+	VCMOD_PEDCAT_GANGS,
+	VCMOD_PEDCAT_CIVILIANS,
+	VCMOD_PEDCAT_MISSION,
+	NUM_VCMOD_PEDCATS
+};
+
+// the group the anim swap wants, false when the swap must stand down
+bool VCModPickAnimGroup(AssocGroupId *out);
+void VCModSuspendAdrenaline(void);
