+// the engine's own way of wearing another model, from ChangePlayerCheat: the ped
+// keeps its identity and only the clump underneath it is replaced
+bool
+VCModApplyPedModel(int16 modelIndex)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return false;
+
+	int32 oldIndex = player->GetModelIndex();
+	if (modelIndex == oldIndex)
+		return true;
+	if (modelIndex < 0)
+		return false;
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+
+	if (modelIndex == MI_PLAYER) {
+		if (!CStreaming::HasModelLoaded(MI_PLAYER)) {
+			CStreaming::RequestSpecialModel(MI_PLAYER, "player", STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+			CStreaming::LoadAllRequestedModels(false);
+		}
+	} else if (modelIndex >= MI_SPECIAL01 && modelIndex <= MI_LAST_PED) {
+		// default.ide calls these slots special01..21 and no file answers to that;
+		// the body has to be named before the slot has anything to stream
+		const char *name = CStreaming::GetSpecialCharModelName(modelIndex - MI_SPECIAL01);
+		if (name == nil)
+			return false;
+		CStreaming::RequestSpecialModel(modelIndex, name, STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+		CStreaming::LoadAllRequestedModels(false);
+	} else {
+		CStreaming::RequestModel(modelIndex, STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+		CStreaming::LoadAllRequestedModels(false);
+	}
+	// a slot can report itself loaded while streaming nothing, and SetModelIndex
+	// then hands a nil clump to the anim blend
+	if (!CStreaming::HasModelLoaded(modelIndex) || mi->GetRwObject() == nil) {
+		// nothing was rebuilt, so only the request that failed is worth dropping
+		CStreaming::SetModelIsDeletable(modelIndex);
+		return false;
+	}
+
+	AssocGroupId animGroup;
+	if (!VCModPedAnimGroupFor(modelIndex, &animGroup))
+		animGroup = ASSOCGRP_PLAYER;
+
+	player->DeleteRwObject();
+	player->m_modelIndex = -1;
+	player->SetModelIndex(modelIndex);
+	// SetModelIndex takes both of these from the model, and Tommy is still Tommy
+	player->SetPedStats(PEDSTAT_PLAYER);
+	player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+	player->m_animGroup = animGroup;
+	player->ReApplyMoveAnims();
+
+	// the held weapon is its own atomic parented to the hand each frame, so it
+	// outlived the clump and has to be freed before the new one is attached
+	if (player->m_wepModelID >= 0) {
+		int32 w = player->m_wepModelID;
+		player->RemoveWeaponModel(-1);
+		player->AddWeaponModel(w);
+	}
+
+	// only release what this mod pinned: a model a save or a script put on the
+	// player was never ours to hand back
+	if (nVCModHeldModelRequest >= 0 && nVCModHeldModelRequest != modelIndex) {
+		CStreaming::SetModelIsDeletable(nVCModHeldModelRequest);
+		nVCModHeldModelRequest = -1;
+	}
+	if (modelIndex != MI_PLAYER)
+		nVCModHeldModelRequest = modelIndex;
+
+	return true;
+}
+
+static void
+VCModApplyPedModelDefault(void)
+{
+	if (nVCModPedModel < 0)
+		return;
+
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return;
+
+	// one try per start: a model that cannot be worn is not worth requesting
+	// again on every frame
+	int32 want = nVCModPedModel;
+	nVCModPedModel = -1;
+	VCModApplyPedModel((int16) want);
+}
+
+// respawn rebuilds the ped through Undress/Dress, which takes stats and group
+// from whatever model is worn, and a save can swap the ped out entirely, so the
+// mod's own bookkeeping has to be re-checked rather than trusted
+static void
+VCModReconcilePedModel(CPlayerPed *player)
+{
+	int32 worn = player->GetModelIndex();
+
+	if (nVCModHeldModelRequest >= 0 && nVCModHeldModelRequest != worn) {
+		CStreaming::SetModelIsDeletable(nVCModHeldModelRequest);
+		nVCModHeldModelRequest = -1;
+	}
+
+	if (worn == MI_PLAYER)
+		return;
+
+	if (player->m_pedStats->m_type != PEDSTAT_PLAYER) {
+		player->SetPedStats(PEDSTAT_PLAYER);
+		player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+	}
+}
+
+// ---- passenger mode: an NPC drives, Tommy rides along ---------------------
+// the ride is tracked by pool index because the car can be destroyed or blown up
+// between the enter press and actually sitting down
+static int32 nVCModRideHandle = -1;
+static bool bVCModRideWaiting;
+static bool bVCModRideSpawnedDriver;
+static bool bVCModRideHasDestination;
+static CVector vecVCModRideDestination;
+
+static void
+VCModRideNotice(const char *text)
+{
+	static wchar notice[64];
+	int32 i;
+	for (i = 0; i < (int32) ARRAY_SIZE(notice) - 1 && text[i] != '\0'; i++)
+		notice[i] = (wchar) text[i];
+	notice[i] = 0;
+	CHud::SetHelpMessage(notice, false);
+}
+
+static void
+VCModRideStandDown(void)
+{
+	nVCModRideHandle = -1;
+	bVCModRideWaiting = false;
+	bVCModRideSpawnedDriver = false;
+	bVCModRideHasDestination = false;
+}
+
+static CVehicle *
+VCModRideVehicle(void)
+{
+	if (nVCModRideHandle < 0)
+		return nil;
+	// a handle, not an index: GetAt drops it once the slot has been recycled
+	return CPools::GetVehiclePool()->GetAt(nVCModRideHandle);
+}
+
+static bool
+VCModPassengerSeatFree(CVehicle *veh)
+{
+	for (int32 i = 0; i < veh->m_nNumMaxPassengers; i++)
+		if (veh->pPassengers[i] == nil)
+			return true;
+	return false;
+}
+
+bool
+VCModPassengerEntry(CVehicle *vehicle)
+{
+	if (!bVCModPassengerMode)
+		return false;
+
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl() || player->bInVehicle || vehicle == nil)
+		return false;
+
+	// planes and helis have no passenger seat at all, trains are not rideable here
+	if (vehicle->IsPlane() || vehicle->IsHeli() || vehicle->IsTrain()) {
+		VCModRideNotice("passenger mode: no seat in this");
+		return true;
+	}
+	if (!VCModPassengerSeatFree(vehicle)) {
+		VCModRideNotice("passenger mode: every seat taken");
+		return true;
+	}
+
+	bVCModRideSpawnedDriver = false;
+	if (vehicle->pDriver == nil) {
+		// a parked car has nowhere to put a driver until the traffic counts move it
+		if (vehicle->VehicleCreatedBy == PARKED_VEHICLE) {
+			vehicle->VehicleCreatedBy = RANDOM_VEHICLE;
+			CCarCtrl::NumRandomCars++;
+			CCarCtrl::NumParkedCars--;
+		}
+		// script and mission cars are not ours to crew
+		if (vehicle->VehicleCreatedBy != RANDOM_VEHICLE) {
+			VCModRideNotice("passenger mode: nobody to drive this");
+			return true;
+		}
+		if (vehicle->SetUpDriver() == nil) {
+			VCModRideNotice("passenger mode: nobody to drive this");
+			return true;
+		}
+		bVCModRideSpawnedDriver = true;
+	}
+
+	// hold the car until Tommy is aboard, the way the shortcut taxi waits
+	vehicle->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	vehicle->AutoPilot.m_nCruiseSpeed = 0;
+
+	player->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, vehicle);
+
+	nVCModRideHandle = CPools::GetVehiclePool()->GetIndex(vehicle);
+	bVCModRideWaiting = true;
+	return true;
+}
+
+// traffic driving for the driver we are riding with
+static void
+VCModRideStartCruise(CVehicle *veh)
+{
+	CCarCtrl::JoinCarWithRoadSystem(veh);
+	veh->AutoPilot.m_nCarMission = MISSION_CRUISE;
+	veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	veh->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+	veh->AutoPilot.m_nCruiseSpeed = 25;
+}
+
+static void
+VCModUpdateRide(CPlayerPed *player)
+{
+	if (nVCModRideHandle < 0)
+		return;
+
+	CVehicle *veh = VCModRideVehicle();
+	if (veh == nil) {
+		VCModRideStandDown();
+		return;
+	}
+
+	if (bVCModRideWaiting) {
+		// still walking to the door, or the objective was taken away by something else
+		if (!player->InVehicle() || player->m_pMyVehicle != veh) {
+			if (player->m_objective != OBJECTIVE_ENTER_CAR_AS_PASSENGER || player->m_carInObjective != veh)
+				VCModRideStandDown();
+			return;
+		}
+		bVCModRideWaiting = false;
+
+		// a boat with a driver we conjured up has no route to follow, so it waits
+		// with someone at the wheel instead of guessing at water pathfinding
+		if (veh->IsBoat() && bVCModRideSpawnedDriver)
+			return;
+
+		int32 zoneIndex;
+		CVector dest;
+		if (VCModRideZoneAt(nVCModRideZone, &zoneIndex, nil, &dest) && zoneIndex >= 0) {
+			CCarCtrl::JoinCarWithRoadSystemGotoCoors(veh, dest, false);
+			veh->AutoPilot.m_nCarMission = MISSION_GOTOCOORDS;
+			veh->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+			veh->AutoPilot.m_nCruiseSpeed = 40;
+			vecVCModRideDestination = dest;
+			bVCModRideHasDestination = true;
+		} else {
+			VCModRideStartCruise(veh);
+		}
+		return;
+	}
+
+	// out of the car, or it went away: the ride is over either way
+	if (!player->InVehicle() || player->m_pMyVehicle != veh) {
+		VCModRideStandDown();
+		return;
+	}
+
+	if (bVCModRideHasDestination &&
+			(veh->GetPosition() - vecVCModRideDestination).Magnitude2D() < 20.0f) {
+		veh->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		veh->AutoPilot.m_nCruiseSpeed = 0;
+		VCModRideStandDown();
+		VCModRideNotice("passenger mode: arrived");
+	}
+}
+
+// which group the player wears: the picker when it is on, otherwise whatever the
+// character model brought, and neither while the stock logic needs its own
+static bool
+VCModPlayerAnimGroup(CPlayerPed *player, bool strafing, AssocGroupId *out)
+{
+	if (strafing)
+		return false;
+	if (bVCModPlayerNpcAnims)
+		return VCModPickAnimGroup(out);
+	return VCModPedAnimGroupFor(player->GetModelIndex(), out);
+}
