+        self.assertIn('IniRemoveKey("VC Mods", "AdrenalineSlowMo");', ini)
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        self.assertNotIn("bVCModAdrenaline", switched)
+        self.assertNotIn("&bVCModWalkMode", switched)
+        # the runtime reads the mode, never a switch next to it
+        self.assertIn("nVCModAdrenalineMode != 0", module)
+        self.assertIn("nVCModAdrenalineMode == 2", module)
+        control = braced(player, "void\nCPlayerPed::ProcessControl(void)")
+        self.assertLess(control.index("VCModUpdateAdrenaline(this);"), control.index("CPed::ProcessControl();"))
+        for marker in ("CPlayerPed::~CPlayerPed()", "void\nCPlayerPed::SetInitialState(void)"):
+            self.assertIn("ClearAdrenaline();", braced(player, marker))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/utils/test_vc_aimwalk.py b/utils/test_vc_aimwalk.py
new file mode 100644
index 0000000..351ed68
--- /dev/null
+++ b/utils/test_vc_aimwalk.py
@@ -0,0 +1,238 @@
+#!/usr/bin/env python3
+"""AIM WALK: a locked-on target no longer roots the player for every gun the arm
+cannot aim with. The predicates decide which weapon and which moment gets the
+walk, and the wiring has to fade the parked aim pose out of the walk, keep the
+facing on the input and keep the lock, without touching the pistols or the
+two-hand colt."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PEDFIGHT = ROOT / "src/peds/PedFight.cpp"
+COMBAT = ROOT / "src/extras/vcmodcombat.cpp"
+PLAYERPED = ROOT / "src/peds/PlayerPed.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+typedef int int32;
+#define WEAPONFLAG_CANAIM_WITHARM (1 << 7)
+#define nil 0
+enum { PEDMOVE_NONE, PEDMOVE_STILL, PEDMOVE_WALK, PEDMOVE_RUN, PEDMOVE_SPRINT };
+
+bool bVCModAimWalk = true;
+bool copPose = false;
+
+struct CWeaponInfo { bool armAim; bool IsFlagSet(int) const { return armAim; } };
+struct CPed {
+    bool player;
+    bool bIsDucking;
+    bool IsPlayer() const { return player; }
+};
+struct CPlayerPed : CPed {
+    int m_nMoveState;
+    float m_fMoveSpeed;
+};
+bool VCModCopTwoHandPose(CPed *, CWeaponInfo *) { return copPose; }
+
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+static CPlayerPed makePlayer(int moveState, float speed)
+{
+    CPlayerPed p;
+    p.player = true;
+    p.bIsDucking = false;
+    p.m_nMoveState = moveState;
+    p.m_fMoveSpeed = speed;
+    return p;
+}
+
+int main() {
+    CPlayerPed still = makePlayer(PEDMOVE_STILL, 0.0f);
+    CPlayerPed walking = makePlayer(PEDMOVE_WALK, 0.0f);
+    CPlayerPed running = makePlayer(PEDMOVE_RUN, 0.0f);
+    CPlayerPed drifting = makePlayer(PEDMOVE_STILL, 0.11f);
+    CPlayerPed nudging = makePlayer(PEDMOVE_STILL, 0.1f);
+    CPlayerPed npc = makePlayer(PEDMOVE_RUN, 2.0f);
+    npc.player = false;
+
+    CHECK(!VCModAimHoldMoving(&still), "standing still hands the aim the body");
+    CHECK(VCModAimHoldMoving(&walking), "a walk is movement");
+    CHECK(VCModAimHoldMoving(&running), "a run is movement");
+    CHECK(VCModAimHoldMoving(&drifting), "speed left over from a run is movement");
+    CHECK(!VCModAimHoldMoving(&nudging), "the speed cut is exclusive");
+    CHECK(!VCModAimHoldMoving(&npc), "only the player's walk fades the aim pose");
+
+    CWeaponInfo rifle = { false };
+    CWeaponInfo pistol = { true };
+
+    CHECK(VCModAimWalkWeapon(&still, &rifle), "a rifle the arm cannot aim gets the walk");
+    CHECK(!VCModAimWalkWeapon(&still, &pistol), "the arm-aim pistols keep their own walk");
+    CHECK(!VCModAimWalkWeapon(&npc, &rifle), "NPCs are not the player");
+
+    copPose = true;
+    CHECK(!VCModAimWalkWeapon(&still, &rifle), "the two-hand colt keeps its own hold rules");
+    copPose = false;
+
+    still.bIsDucking = true;
+    CHECK(!VCModAimWalkWeapon(&still, &rifle), "the crouch aim keeps the stock freeze");
+    still.bIsDucking = false;
+
+    bVCModAimWalk = false;
+    CHECK(!VCModAimWalkWeapon(&still, &rifle), "the row off restores the stock freeze");
+    bVCModAimWalk = true;
+    CHECK(VCModAimWalkWeapon(&still, &rifle), "the row on is what frees the walk");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(text, name):
+    match = re.search(r"(?m)^(?:static\s+)?bool\s*\n" + re.escape(name) + r"\(", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {COMBAT}")
+    opening = text.index("{", match.end())
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[match.start():i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+class AimWalkTests(unittest.TestCase):
+    def test_predicates(self):
+        text = COMBAT.read_text()
+        source = PRELUDE + "\n".join(
+            cut(text, name) for name in ("VCModAimHoldMoving", "VCModAimWalkWeapon")) + MAIN
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "aimwalk"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source, text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_only_the_shot_plants_the_player(self):
+        gate = braced(PLAYERPED.read_text(), "CPlayerPed::MovementDisabledBecauseOfTargeting")
+        self.assertIn("VCModCopTwoHandFiring(this, info)", gate)
+        self.assertIn("VCModAimWalkWeapon(this, info)", gate)
+        self.assertIn("m_nPedState == PED_ATTACK", gate)
+        # the colt keeps its own rules, no lock means free aim and free movement
+        self.assertLess(gate.index("VCModCopTwoHandFiring"),
+                        gate.index("VCModAimWalkWeapon"))
+
+    def test_facing_follows_the_input_while_walking(self):
+        rotate = braced(PLAYERPED.read_text(), "CPlayerPed::RotatePlayerToTrackTarget")
+        stand_down = rotate.index("VCModAimWalkWeapon(this, info) && VCModAimHoldMoving(this)")
+        self.assertRegex(rotate[stand_down:], r"return;")
+        # the arm-aim pistols keep their return, and it is not reached first
+        self.assertLess(rotate.index("info->IsFlagSet(WEAPONFLAG_CANAIM_WITHARM)"), stand_down)
+
+    def test_the_lock_survives_the_walk_and_the_shot_plant(self):
+        weapon = PLAYERPED.read_text()
+        guard = weapon[weapon.index("DoesTargetHaveToBeBroken(m_pPointGunAt->GetPosition()"):]
+        guard = guard[:guard.index("ClearWeaponTarget();")]
+        self.assertIn("bCanPointGunAtTarget", guard)
+        # the exemption is the weapon, not the moment: the shot plants the player
+        # a frame before the torso catches up, and that frame must not drop the
+        # lock any more than the walk itself does
+        self.assertIn("!aimWalk", guard)
+        self.assertNotIn("aimWalkMoving", guard)
+        definition = weapon[weapon.index("bool aimWalk"):]
+        definition = definition[:definition.index(";")]
+        self.assertIn("VCModAimWalkWeapon(this, weaponInfo)", definition)
+        self.assertNotIn("VCModAimHoldMoving", definition)
+
+    def test_the_tail_plays_before_the_walk(self):
+        text = COMBAT.read_text()
+        tail = braced(text, "VCModAimTailRunning")
+        # nothing runs once the row is off or the pose is the two-hand colt's
+        self.assertIn("!bVCModWeaponRecovering", tail)
+        self.assertIn("!ped->IsPlayer()", tail)
+        self.assertIn("VCModCopTwoHandPose(ped, info)", tail)
+        # it is the clip playing, not the flag alone: the parked hold is not a tail
+        self.assertIn("assoc->IsRunning()", tail)
+
+        gate = braced(PLAYERPED.read_text(), "CPlayerPed::MovementDisabledBecauseOfTargeting")
+        self.assertIn("m_nPedState == PED_ATTACK || VCModAimTailRunning(this)", gate)
+
+        # the engine hands the aim frame to the module and returns when it owns
+        point = braced(PEDFIGHT.read_text(), "CPed::PointGunAt(void)")
+        self.assertIn("VCModCombatAimTick(this, weaponInfo, weaponAssoc)", point)
+        tick = braced(text, "VCModCombatAimTick(CPed *ped,")
+        walk = tick[tick.index("VCModAimWalkWeapon(ped, weaponInfo) && VCModAimHoldMoving(ped)"):]
+        walk = walk[:walk.index("return true;")]
+        # the walk never cuts the tail: it stands down while the tail runs
+        self.assertIn("!VCModAimTailRunning(ped)", walk)
+        self.assertNotIn("bVCModWeaponRecovering = false", walk)
+
+    def test_the_walk_fades_the_parked_aim_pose_out(self):
+        text = COMBAT.read_text()
+        point = braced(text, "VCModCombatAimTick(CPed *ped,")
+        walk = point[point.index("VCModAimWalkWeapon(ped, weaponInfo) && VCModAimHoldMoving(ped)"):]
+        walk = walk[:walk.index("The tail is the author's recovery")]
+        # locomotion owns the body while he moves
+        self.assertIn("blendDelta = -8.0f;", walk)
+        # the faded clip has to stay alive to fade back in
+        self.assertIn("ASSOC_DELETEFADEDOUT", walk)
+        self.assertIn("return true;", walk)
+        # it never re-parks the aim frame mid-walk
+        self.assertNotIn("SetCurrentTime", walk)
+
+        engine = braced(PEDFIGHT.read_text(), "CPed::PointGunAt(void)")
+        raise_it = engine[engine.index("the walk lowered the weapon"):]
+        self.assertIn("!VCModAimHoldMoving(this)", raise_it)
+        self.assertIn("blendDelta = 8.0f;", raise_it)
+
+        # the lowered hold a walk faded has to come back when he stops, which is a
+        # different branch from the aim pose above
+        hold = point[point.index("if (bVCModWeaponRecovering && weaponAssoc)"):]
+        hold = hold[:hold.index("return true;", hold.index("ASSOC_DELETEFADEDOUT"))]
+        self.assertIn("blendAmount < 1.0f", hold)
+        self.assertIn("blendDelta = 8.0f;", hold)
+
+    def test_the_two_hand_hold_uses_the_same_moving_rule(self):
+        point = braced(COMBAT.read_text(), "VCModCombatAimTick(CPed *ped,")
+        hold = point[point.index("VCModCopSetStance(ped, weaponAssoc, false)"):]
+        hold = hold[:hold.index("} else {")]
+        self.assertEqual(hold.count("VCModAimHoldMoving(ped)"), 2)
+        self.assertNotIn("m_fMoveSpeed", hold)
+
+    def test_row_and_ini(self):
+        panel = PANEL
+        self.assertIn('{ "AIM WALK",        VCMOD_ROW_FLAG,    &bVCModAimWalk,        "AimWalk",        VCMOD_PAGE_COMBAT,', panel)
+        self.assertIn("bool bVCModAimWalk = true;", COMBAT.read_text())
+        self.assertNotIn("bool bVCModAimWalk", panel)
+        self.assertIn('TWEAKBOOLN(bVCModAimWalk, "move while locked on");', panel)
+        self.assertIn("&bVCModAimWalk,", panel)
+        self.assertIn('ReadIniIfExists("VC Mods", "AimWalk", &bVCModAimWalk);', INI.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
