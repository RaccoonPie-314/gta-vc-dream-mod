+#!/usr/bin/env python3
+"""Car light textures: the pack's car and bike models carry a lit lamp texture
+next to the unlit one, so the lamps can glow while the lights are on."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+MOD = ROOT / "src/extras/vcmodlighttex.cpp"
+MOD_H = ROOT / "src/extras/vcmodlighttex.h"
+MODELINFO = ROOT / "src/modelinfo/VehicleModelInfo.cpp"
+MODELINFO_H = ROOT / "src/modelinfo/VehicleModelInfo.h"
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+BIKE = ROOT / "src/vehicles/Bike.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class LightTextureTests(unittest.TestCase):
+    def test_pairs_are_named(self):
+        mod = MOD.read_text()
+        self.assertIn("bool bVCModLightTextures = true;", mod)
+        self.assertIn('{ "lights",        "lightson" },', mod)
+        self.assertIn('{ "servicelights", "servicelightson" },', mod)
+        # the lit texture lives in the model's own TXD, next to the unlit one
+        self.assertIn("mi->GetTxdSlot()", mod)
+        self.assertIn("RwTexDictionaryFindNamedTexture", mod)
+        self.assertIn("RpMaterialSetTexture", mod)
+
+    def test_materials_are_collected_at_load(self):
+        modelinfo = MODELINFO.read_text()
+        collect = braced(modelinfo, "CVehicleModelInfo::GetEditableMaterialListCB(RpMaterial")
+        self.assertIn("VCModLightTextCollect(cbdata->vehicle, material);", collect)
+        find = braced(modelinfo, "CVehicleModelInfo::FindEditableMaterialList(void)")
+        self.assertIn("m_numLightMaterials = 0;", find)
+        self.assertIn("m_lightTexTried = 0;", find)
+        header = MODELINFO_H.read_text()
+        self.assertIn("NUM_LIGHT_MATERIALS = 32,", header)
+        self.assertIn("RpMaterial *m_lightMaterials[NUM_LIGHT_MATERIALS];", header)
+        self.assertIn("RwTexture *m_lightOnTex[NUM_LIGHT_MATERIALS];", header)
+
+    def test_swap_happens_at_draw_time(self):
+        # materials are shared by every car of a model, so the switch rides the
+        # same just-in-time path as the body colour
+        auto = AUTO.read_text()
+        render = braced(auto, "CAutomobile::Render(void)")
+        self.assertIn('#include "vcmodlighttex.h"', auto)
+        self.assertIn("VCModLightTextRender(mi, bLightsOn, m_bSirenOrAlarm);", render)
+        self.assertLess(render.index("SetVehicleColour"),
+                        render.index("VCModLightTextRender"))
+
+        bike = BIKE.read_text()
+        bike_render = braced(bike, "CBike::Render(void)")
+        self.assertIn("VCModLightTextRender(mi, bLightsOn, m_bSirenOrAlarm);", bike_render)
+
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        self.assertIn('"LIGHT TEXTURES"', rows)
+        self.assertIn("&bVCModLightTextures", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "LightTextures"', INI.read_text())
+        self.assertIn("extern bool bVCModLightTextures;", MOD_H.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
