+TWEAKBOOL(bVCModPassengerMode);
+TWEAKINT32(nVCModRideZone, -1, NUMMAPZONES - 1, 1);
+TWEAKFUNCN(VCModToggleAll, "all on/off (not walk)");
+
+// Colour comes from the charset, the same way the debug menu highlights a selected
+// row: an opaque background on every glyph is what makes a row read as a panel.
+enum eVCModFont
+{
+	VCFONT_TITLE,
+	VCFONT_LABEL,
+	VCFONT_ON,
+	VCFONT_OFF,
+	VCFONT_SET,
+	VCFONT_WARN,
+	VCFONT_HINT,
+	VCFONT_MARK,
+	NUM_VCFONTS
+};
+
+static RtCharset *aVCModFonts[NUM_VCFONTS];
+static int32 nVCModCharW, nVCModCharH;
+static bool bVCModPanelOpen;
+static float fVCModCursorX, fVCModCursorY;
+
+// one list is open at a time, and any list longer than the window scrolls
+enum eVCModList
+{
+	VCMOD_LIST_NONE,
+	VCMOD_LIST_ANIM,
+	VCMOD_LIST_PEDCAT,
+	VCMOD_LIST_PEDCHAR,
+	VCMOD_LIST_RIDEZONE,
+	NUM_VCMOD_LISTS
+};
+
+static int32 nVCModOpenList;
+static int32 nVCModListScroll;
+
+#define VCMOD_PANEL_X		20
+#define VCMOD_PANEL_Y		60
+#define VCMOD_NAME_COLS		18
+#define VCMOD_VALUE_COLS	28
+#define VCMOD_LIST_ROWS		16
+
+enum eVCModRowKind
+{
+	VCMOD_ROW_FLAG,		// flips the flag it points at
+	VCMOD_ROW_ANIMSET,	// opens the animation list
+	VCMOD_ROW_MASTER,
+	VCMOD_ROW_ADRENALINE_MODE,
+	VCMOD_ROW_PEDCAT,	// opens the category list
+	VCMOD_ROW_PEDCHAR,	// opens that category's roster
+	VCMOD_ROW_RIDEZONE	// opens the ride destination list
+};
+
+struct VCModRowDef
+{
+	const char *name;
+	eVCModRowKind kind;
+	bool *state;
+};
+
+// WALK MODE is left out on purpose: it says how Tommy moves, not which mods are
+// running, and losing it every time the combat switches get flipped together is
+// the annoying version of a convenience button
+static bool *aVCModSwitched[] = {
+	&bVCModPlayerNpcAnims,
+	&bVCModMouseAimLockOn,
+	&bVCModAimAllWeapons,
+	&bVCModPlayerDoomAim,
+	&bVCModNoScopedAim,
+	&bVCModLockOnVehicles,
+	&bVCModNeverWanted,
+	&bVCModLockOnLatch,
+	&bVCModAdrenaline
+};
+
+static int32
+VCModCountOn(void)
+{
+	int32 n = 0;
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModSwitched); i++)
+		if (*aVCModSwitched[i])
+			n++;
+	return n;
+}
+
+static void
+VCModToggleAll(void)
+{
+	bool on = VCModCountOn() != (int32) ARRAY_SIZE(aVCModSwitched);
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModSwitched); i++)
+		*aVCModSwitched[i] = on;
+}
+
+static const VCModRowDef aVCModRows[] = {
+	{ "ALL ON/OFF",      VCMOD_ROW_MASTER,  nil                   },
+	{ "NPC ANIMATION",   VCMOD_ROW_FLAG,    &bVCModPlayerNpcAnims },
+	{ "ANIM SET",        VCMOD_ROW_ANIMSET, nil                   },
+	{ "PED CATEGORY",    VCMOD_ROW_PEDCAT,  nil                   },
+	{ "CHARACTER",       VCMOD_ROW_PEDCHAR, nil                   },
+	{ "FREEAIM+LOCKON",  VCMOD_ROW_FLAG,    &bVCModMouseAimLockOn },
+	{ "AIM ALL WEAPONS", VCMOD_ROW_FLAG,    &bVCModAimAllWeapons  },
+	{ "NPC DOOM AIM",    VCMOD_ROW_FLAG,    &bVCModPlayerDoomAim  },
+	{ "NO SCOPE CAMERA", VCMOD_ROW_FLAG,    &bVCModNoScopedAim    },
+	{ "COLT TWO-HAND",   VCMOD_ROW_FLAG,    &bVCModCopPistol      },
+	{ "WALK MODE",       VCMOD_ROW_FLAG,    &bVCModWalkMode       },
+	{ "LOCKON VEHICLES", VCMOD_ROW_FLAG,    &bVCModLockOnVehicles },
+	{ "NEVER WANTED",    VCMOD_ROW_FLAG,    &bVCModNeverWanted    },
+	{ "LOCKON LATCH",    VCMOD_ROW_FLAG,    &bVCModLockOnLatch    },
+	{ "ADRENALINE",      VCMOD_ROW_FLAG,    &bVCModAdrenaline     },
+	{ "ADRENALINE MODE", VCMOD_ROW_ADRENALINE_MODE, &bVCModAdrenalineSlowMo },
+	{ "PASSENGER MODE",  VCMOD_ROW_FLAG,    &bVCModPassengerMode  },
+	{ "RIDE TO",         VCMOD_ROW_RIDEZONE, nil },
+};
+
+static void
+VCModMakeFonts(void)
+{
+	static const RwRGBA aFg[NUM_VCFONTS] = {
+		{ 255,  96, 192, 255 },	// title
+		{ 232, 232, 240, 255 },	// label
+		{ 112, 240, 148, 255 },	// on
+		{ 132, 132, 144, 255 },	// off
+		{ 110, 216, 255, 255 },	// anim set name
+		{ 255, 200,  72, 255 },	// warning
+		{ 196, 156, 255, 255 },	// key hints
+		{ 255, 255, 255, 255 }		// marker
+	};
+	static const RwRGBA aBgPanel[NUM_VCFONTS] = {
+		{  32,   8,  40, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  36,  24,   4, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20,   0 }
+	};
+
+	OpenCharsetSafe();
+
+	for (int32 i = 0; i < NUM_VCFONTS; i++) {
+		aVCModFonts[i] = RtCharsetCreate(&aFg[i], &aBgPanel[i]);
+		if (aVCModFonts[i] == nil)
+			return;
+	}
+
+	RtCharsetDesc desc;
+	RtCharsetGetDesc(aVCModFonts[VCFONT_LABEL], &desc);
+	nVCModCharW = desc.width;
+	nVCModCharH = desc.height;
+}
+
+static void
+VCModPrint(int32 style, const char *s, int32 x, int32 y)
+{
+	RtCharsetPrintBuffered(aVCModFonts[style], s, x, y, false);
+}
+
+// every cell is padded to a fixed width, otherwise the row backgrounds end at
+// ragged distances and the panel reads as floating text
+static void
+VCModCell(int32 style, const char *s, int32 x, int32 y, int32 cols)
+{
+	char cell[64];
+	snprintf(cell, sizeof(cell), "%-*s", cols, s);
+	VCModPrint(style, cell, x, y);
+}
+
+static bool
+VCModCursorInRect(float px, float py, int32 x, int32 y, int32 w, int32 h)
+{
+	return px >= x && px < x + w && py >= y && py < y + h;
+}
+
+static void
+VCModUpdateMouse(CPad *pad, int32 screenW, int32 screenH)
+{
+	// the panel cursor has to follow the same invert settings the game's own mouse
+	// look uses, or it moves against the hand that is pointing it
+	int dirX = MousePointerStateHelper.bInvertHorizontally ? -1 : 1;
+	int dirY = MousePointerStateHelper.bInvertVertically ? -1 : 1;
+
+	fVCModCursorX += pad->NewMouseControllerState.x * dirX;
+	fVCModCursorY += pad->NewMouseControllerState.y * dirY;
+	if (fVCModCursorX < 0.0f) fVCModCursorX = 0.0f;
+	if (fVCModCursorY < 0.0f) fVCModCursorY = 0.0f;
+	if (fVCModCursorX >= screenW) fVCModCursorX = screenW - 1.0f;
+	if (fVCModCursorY >= screenH) fVCModCursorY = screenH - 1.0f;
+
+	// the camera must not turn while the panel is being pointed at
+	pad->NewMouseControllerState.x = 0.0f;
+	pad->NewMouseControllerState.y = 0.0f;
+}
+
+static int32
+VCModRowY(int32 row)
+{
+	return VCMOD_PANEL_Y + nVCModCharH * (row + 1);
+}
+
+#define VCMOD_ANIM_SET_ROW	2
+#define VCMOD_PEDCAT_ROW	3
+#define VCMOD_PEDCHAR_ROW	4
+
+// lists open beside the panel instead of pushing the rows down, so the panel
+// keeps one shape while choosing
+static int32
+VCModListX(void)
+{
+	return VCMOD_PANEL_X + (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW + 20;
+}
+
+static int32
+VCModListRowY(int32 anchorRow, int32 visible)
+{
+	return VCModRowY(anchorRow) + nVCModCharH * visible;
+}
+
+static int32
+VCModRowList(int32 kind)
+{
+	switch (kind) {
+	case VCMOD_ROW_ANIMSET:	return VCMOD_LIST_ANIM;
+	case VCMOD_ROW_PEDCAT:	return VCMOD_LIST_PEDCAT;
+	case VCMOD_ROW_PEDCHAR:	return VCMOD_LIST_PEDCHAR;
+	case VCMOD_ROW_RIDEZONE:	return VCMOD_LIST_RIDEZONE;
+	}
+	return VCMOD_LIST_NONE;
+}
+
+static int32
+VCModListAnchorRow(int32 list)
+{
+	switch (list) {
+	case VCMOD_LIST_ANIM:	return VCMOD_ANIM_SET_ROW;
+	case VCMOD_LIST_PEDCAT:	return VCMOD_PEDCAT_ROW;
+	}
+	return VCMOD_PEDCHAR_ROW;
+}
+
+static int32
+VCModListCount(int32 list)
+{
+	switch (list) {
+	case VCMOD_LIST_ANIM:	return ARRAY_SIZE(aVCModAnimGroupNames);
+	case VCMOD_LIST_PEDCAT:	return NUM_VCMOD_PEDCATS;
+	case VCMOD_LIST_RIDEZONE:	return VCModRideZoneCount();
+	}
+	return VCModPedModelCount(nVCModPedCategory);
+}
+
+// the first entry drawn: lists that fit show everything, longer ones scroll
+static int32
+VCModListFirst(int32 list)
+{
+	int32 max = VCModListCount(list) - VCMOD_LIST_ROWS;
+	if (max < 0)
+		max = 0;
+	if (nVCModListScroll > max)
+		nVCModListScroll = max;
+	return nVCModListScroll;
+}
+
+// the character being worn right now is the whole state, so the panel reads it
+// off the ped instead of keeping a second copy of the choice
+static int16
+VCModCurrentPedModel(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil)
+		return MI_PLAYER;
+	return player->GetModelIndex();
+}
+
+static const char *
+VCModCurrentPedLabel(void)
+{
+	int16 modelIndex = VCModCurrentPedModel();
+	if (modelIndex == MI_PLAYER)
+		return "player (Tommy)";
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil)
+		return "unknown";
+	return mi->GetModelName();
+}
+
+static const char *
+VCModListLabel(int32 list, int32 entry, bool *selected)
+{
+	static char missing[24];
+
+	switch (list) {
+	case VCMOD_LIST_ANIM:
+		*selected = entry == nVCModAnimChoice;
+		return aVCModAnimGroupNames[entry];
+	case VCMOD_LIST_PEDCAT:
+		*selected = entry == nVCModPedCategory;
+		return aVCModPedCategoryNames[entry];
+
+	case VCMOD_LIST_RIDEZONE: {
+		int32 zoneIndex;
+		const char *name;
+		if (!VCModRideZoneAt(entry, &zoneIndex, &name, nil))
+			return "unknown";
+		// the stored value is the zone index, and cruise is -1 rather than entry 0
+		*selected = zoneIndex == nVCModRideZone;
+		return name;
+	}
+	}
+
+	int16 modelIndex = MI_PLAYER;
+	const char *name = nil;
+	if (!VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name) || name == nil) {
+		snprintf(missing, sizeof(missing), "model %d", (int) entry);
+		*selected = false;
+		return missing;
+	}
+	*selected = modelIndex == VCModCurrentPedModel();
+	return name;
+}
+
+static void
+VCModListPick(int32 list, int32 entry)
+{
+	switch (list) {
+	case VCMOD_LIST_ANIM:
+		nVCModAnimChoice = entry;
+		bVCModPlayerNpcAnims = true;
+		break;
+
+	case VCMOD_LIST_PEDCAT:
+		nVCModPedCategory = entry;
+		nVCModListScroll = 0;
+		break;
+
+	case VCMOD_LIST_RIDEZONE: {
+		int32 zoneIndex;
+		if (VCModRideZoneAt(entry, &zoneIndex, nil, nil))
+			nVCModRideZone = zoneIndex;
+		break;
+	}
+
+	default: {
+		// the swap streams models and destroys clumps, so it waits for the update
+		// pass rather than running inside the render
+		int16 modelIndex;
+		const char *name;
+		if (VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name))
+			nVCModPedModel = modelIndex;
+		break;
+	}
+	}
+	nVCModOpenList = VCMOD_LIST_NONE;
+}
+
+static void
+VCModTriangle(RwCamera *cam, float x0, float y0, float x1, float y1, float x2, float y2,
+	uint8 r, uint8 g, uint8 b)
+{
+	RwIm2DVertex verts[3];
+	float recipz = 1.0f / RwCameraGetNearClipPlane(cam);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+
+	RwIm2DVertexSetScreenX(&verts[0], x0);
+	RwIm2DVertexSetScreenY(&verts[0], y0);
+	RwIm2DVertexSetScreenZ(&verts[0], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[0], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[0], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[0], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[1], x1);
+	RwIm2DVertexSetScreenY(&verts[1], y1);
+	RwIm2DVertexSetScreenZ(&verts[1], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[1], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[1], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[1], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[2], x2);
+	RwIm2DVertexSetScreenY(&verts[2], y2);
+	RwIm2DVertexSetScreenZ(&verts[2], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[2], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[2], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[2], r, g, b, 255);
+
+	RwIm2DRenderPrimitive(rwPRIMTYPETRILIST, verts, 3);
+}
+
+// a charset "+" was unreadably small, so the pointer is geometry: a filled arrow
+// with a dark edge that stays visible on both the panel and the sky
+static void
+VCModDrawCursor(RwCamera *cam)
+{
+	int32 x = (int32) fVCModCursorX;
+	int32 y = (int32) fVCModCursorY;
+
+	VCModTriangle(cam, x - 2.0f, y - 2.0f, x - 2.0f, y + 22.0f, x + 16.0f, y + 12.0f, 8, 8, 12);
+	VCModTriangle(cam, (float) x, (float) y, (float) x, y + 19.0f, x + 14.0f, y + 10.0f, 255, 255, 255);
+}
+
+// the two-finger scroll is the only gesture the trackpad has left once aiming
+// owns the hold, so it is what moves through a list
+static void
+VCModScroll(CPad *pad)
+{
+	if (nVCModOpenList == VCMOD_LIST_NONE)
+		return;
+
+	int32 max = VCModListCount(nVCModOpenList) - VCMOD_LIST_ROWS;
+	if (max < 0)
+		max = 0;
+
+	if (pad->GetMouseWheelUpJustDown())
+		nVCModListScroll--;
+	if (pad->GetMouseWheelDownJustDown())
+		nVCModListScroll++;
+	if (nVCModListScroll < 0)
+		nVCModListScroll = 0;
+	if (nVCModListScroll > max)
+		nVCModListScroll = max;
+
+	// browsing the roster must not cycle weapons underneath the cursor
+	pad->NewMouseControllerState.WHEELUP = false;
+	pad->NewMouseControllerState.WHEELDN = false;
+}
+
+static void
+VCModClick(CPad *pad)
+{
+	if (!(pad->NewMouseControllerState.LMB && !pad->OldMouseControllerState.LMB))
+		return;
+
+	if (nVCModOpenList != VCMOD_LIST_NONE) {
+		int32 anchor = VCModListAnchorRow(nVCModOpenList);
+		int32 first = VCModListFirst(nVCModOpenList);
+		int32 count = VCModListCount(nVCModOpenList);
+		if (count > first + VCMOD_LIST_ROWS)
+			count = first + VCMOD_LIST_ROWS;
+
+		for (int32 entry = first; entry < count; entry++) {
+			if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCModListX(),
+					VCModListRowY(anchor, entry - first), VCMOD_VALUE_COLS * nVCModCharW, nVCModCharH))
+				continue;
+
+			VCModListPick(nVCModOpenList, entry);
+			return;
+		}
+	}
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCMOD_PANEL_X, VCModRowY(i), rowW, nVCModCharH))
+			continue;
+
+		switch (aVCModRows[i].kind) {
+		case VCMOD_ROW_FLAG:
+		case VCMOD_ROW_ADRENALINE_MODE:
+			*aVCModRows[i].state = !*aVCModRows[i].state;
+			break;
+		case VCMOD_ROW_ANIMSET:
+		case VCMOD_ROW_PEDCAT:
+		case VCMOD_ROW_PEDCHAR:
+		case VCMOD_ROW_RIDEZONE: {
+			int32 want = VCModRowList(aVCModRows[i].kind);
+			nVCModOpenList = nVCModOpenList == want ? VCMOD_LIST_NONE : want;
+			nVCModListScroll = 0;
+			break;
+		}
+		case VCMOD_ROW_MASTER:
+			VCModToggleAll();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+
+	nVCModOpenList = VCMOD_LIST_NONE;
+}
+
+void
+VCModPanelRender(void)
+{
+	CPad *pad = CPad::GetPad(0);
+	if (pad == nil)
+		return;
+
+	// the debug menu's page column occupies the same corner, so it wins while open
+	if (DebugMenuIsActive())
+		return;
+
+	if (ControlsManager.GetIsKeyboardKeyJustDown((RsKeyCodes)'\\'))
+		bVCModPanelOpen = !bVCModPanelOpen;
+	if (!bVCModPanelOpen) {
+		nVCModOpenList = VCMOD_LIST_NONE;
+		return;
+	}
+
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+
+	RwCamera *cam = RwCameraGetCurrentCamera();
+	if (cam == nil)
+		return;
+	int32 screenW = RwRasterGetWidth(RwCameraGetRaster(cam));
+	int32 screenH = RwRasterGetHeight(RwCameraGetRaster(cam));
+
+	if (aVCModFonts[VCFONT_LABEL] == nil) {
+		VCModMakeFonts();
+		if (aVCModFonts[VCFONT_LABEL] == nil)
+			return;
+	}
+
+	VCModUpdateMouse(pad, screenW, screenH);
+	VCModScroll(pad);
+	VCModClick(pad);
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	int32 fullCols = rowW / nVCModCharW;
+	VCModCell(VCFONT_TITLE, " VC MODS ", VCMOD_PANEL_X, VCMOD_PANEL_Y, fullCols);
+
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		int32 y = VCModRowY(i);
+		int32 style = VCFONT_OFF;
+		const char *value = "[--]";
+		char holdCell[16];
+
+		switch (aVCModRows[i].kind) {
+		case VCMOD_ROW_FLAG:
+			if (*aVCModRows[i].state) {
+				style = VCFONT_ON;
+				value = "[ON]";
+				if (aVCModRows[i].state == &bVCModCopPistol) {
+					snprintf(holdCell, sizeof(holdCell), "[ON  f%d]", nVCModCopHoldFrame);
+					value = holdCell;
+				}
+			}
+			break;
+
+		case VCMOD_ROW_ANIMSET:
+			style = VCFONT_SET;
+			value = aVCModAnimGroupNames[nVCModAnimChoice];
+			break;
+
+		case VCMOD_ROW_PEDCAT:
+			style = VCFONT_SET;
+			value = aVCModPedCategoryNames[nVCModPedCategory];
+			break;
+
+		case VCMOD_ROW_PEDCHAR:
+			style = VCFONT_SET;
+			value = VCModCurrentPedLabel();
+			break;
+
+		case VCMOD_ROW_RIDEZONE: {
+			const char *name;
+			style = VCFONT_SET;
+			value = VCModRideZoneAt(nVCModRideZone < 0 ? 0 : nVCModRideZone, nil, &name, nil) ?
+				name : "traffic (cruise)";
+			break;
+		}
+
+		case VCMOD_ROW_ADRENALINE_MODE:
+			style = VCFONT_SET;
+			value = bVCModAdrenalineSlowMo ? "[SLOW-MO]  click to switch" : "[NORMAL]   click to switch";
+			break;
+
+		case VCMOD_ROW_MASTER: {
+			int32 n = VCModCountOn();
+			if (n == (int32) ARRAY_SIZE(aVCModSwitched)) {
+				style = VCFONT_ON;
+				value = "[ALL ON]";
+			} else if (n == 0) {
+				value = "[ALL OFF]";
+			} else {
+				style = VCFONT_WARN;
+				value = "[MIXED]";
+			}
+			break;
+		}
+		}
+
+		VCModCell(VCFONT_LABEL, aVCModRows[i].name, VCMOD_PANEL_X, y, VCMOD_NAME_COLS);
+		VCModCell(style, value, VCMOD_PANEL_X + VCMOD_NAME_COLS*nVCModCharW, y, VCMOD_VALUE_COLS);
+
+		// the affordance that this row opens a list rather than flipping anything
+		int32 rowList = VCModRowList(aVCModRows[i].kind);
+		if (rowList != VCMOD_LIST_NONE)
+			VCModPrint(VCFONT_MARK, nVCModOpenList == rowList ? "-" : "+",
+				VCMOD_PANEL_X + rowW + nVCModCharW, y);
+	}
+
+	if (nVCModOpenList != VCMOD_LIST_NONE) {
+		int32 anchor = VCModListAnchorRow(nVCModOpenList);
+		int32 first = VCModListFirst(nVCModOpenList);
+		int32 count = VCModListCount(nVCModOpenList);
+		int32 last = count;
+		if (last > first + VCMOD_LIST_ROWS)
+			last = first + VCMOD_LIST_ROWS;
+
+		for (int32 entry = first; entry < last; entry++) {
+			bool selected = false;
+			const char *label = VCModListLabel(nVCModOpenList, entry, &selected);
+			int32 listY = VCModListRowY(anchor, entry - first);
+			VCModCell(selected ? VCFONT_ON : VCFONT_SET, label, VCModListX(), listY, VCMOD_VALUE_COLS);
+			if (selected)
+				VCModPrint(VCFONT_ON, ">", VCModListX() - nVCModCharW, listY);
+		}
+
+		// the roster is longer than one list, so mark the directions scroll has left
+		if (count > VCMOD_LIST_ROWS) {
+			int32 markX = VCModListX() + VCMOD_VALUE_COLS * nVCModCharW;
+			if (first > 0)
+				VCModPrint(VCFONT_MARK, "^", markX, VCModListRowY(anchor, 0));
+			if (last < count)
+				VCModPrint(VCFONT_MARK, "v", markX, VCModListRowY(anchor, last - first - 1));
+		}
+	}
+
+	int32 y = VCModRowY((int32) ARRAY_SIZE(aVCModRows));
+	if (bVCModNoScopedAim && !bVCModAimAllWeapons)
+		VCModCell(VCFONT_WARN, "! sniper needs AIM ALL WEAPONS", VCMOD_PANEL_X, y++, fullCols);
+	if (!bVCModMouseAimLockOn && CCamera::m_bUseMouse3rdPerson)
+		VCModCell(VCFONT_WARN, "! two-finger hold does nothing", VCMOD_PANEL_X, y++, fullCols);
+
+	VCModCell(VCFONT_HINT, "fire G   walk B   panel backslash   cheats ctrl-M", VCMOD_PANEL_X, y, fullCols);
+
+	// charset glyphs go through the buffered path, so flush them before the cursor
+	// geometry or the pointer ends up underneath the panel
+	RtCharsetBufferFlush();
+	VCModDrawCursor(cam);
+}
+#endif
