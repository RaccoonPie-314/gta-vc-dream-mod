+int32 nVCModPedModel = -1;
+
+// the model index this mod asked streaming to keep, so a swap or a replaced ped
+// can hand it back
+static int32 nVCModHeldModelRequest;
+
+// only groups built from aStdAnimDescs are offered. The skate group is the one
+// exception to the five-slot rule: it carries walk, run, sprint and idle, and
+// borrows startwalk from the player set the same way the game's skaters do.
+static const char *aVCModAnimGroupNames[] = {
+	"man (police, most male civs)", "gang1", "gang2", "shuffle", "oldman", "fatman",
+	"oldfatman", "jogger", "woman", "shopping", "busywoman", "sexywoman",
+	"fatwoman", "oldwoman", "jogwoman", "panicchunky", "skater (rollerblades)"
+};
+static const int32 aVCModAnimGroups[] = {
+	ASSOCGRP_STD, ASSOCGRP_GANG1, ASSOCGRP_GANG2, ASSOCGRP_SHUFFLE, ASSOCGRP_OLD,
+	ASSOCGRP_FAT, ASSOCGRP_OLDFAT, ASSOCGRP_JOGGER, ASSOCGRP_WOMAN, ASSOCGRP_WOMANSHOP,
+	ASSOCGRP_BUSYWOMAN, ASSOCGRP_SEXYWOMAN, ASSOCGRP_FATWOMAN, ASSOCGRP_OLDWOMAN,
+	ASSOCGRP_JOGWOMAN, ASSOCGRP_PANICCHUNKY, ASSOCGRP_SKATE
+};
+
+// SetRealMoveAnim blends these directly, so a group that cannot hand them out
+// must never become current. STARTWALK is left out: AddAnimation borrows the
+// player's clip for it, and ReApplyMoveAnims skips a slot the group lacks.
+static const AnimationId aVCModMoveAnims[] = {
+	ANIM_STD_IDLE, ANIM_STD_WALK, ANIM_STD_RUN, ANIM_STD_RUNFAST
+};
+
+static bool
+VCModGroupPlayable(AssocGroupId groupId)
+{
+	// model info carries group ids the mod never offered, so range-check before
+	// indexing the group table
+	if (groupId < 0 || groupId >= NUM_ANIM_ASSOC_GROUPS)
+		return false;
+
+	CAnimBlendAssocGroup *grp = &CAnimManager::GetAnimAssocGroups()[groupId];
+	if (grp->numAssociations <= 0) {
+		fprintf(stderr, "VCMOD refusing group %d, nothing built\n", groupId);
+		return false;
+	}
+	for (int32 i = 0; i < grp->numAssociations; i++) {
+		CAnimBlendHierarchy *h = grp->assocList[i].hierarchy;
+		if (h == nil || h->sequences == nil || h->numSequences <= 0) {
+			fprintf(stderr, "VCMOD refusing group %d, assoc %d (%s)\n",
+				groupId, i, h ? h->name : "nil hierarchy");
+			return false;
+		}
+	}
+
+	for (int32 i = 0; i < ARRAY_SIZE(aVCModMoveAnims); i++) {
+		CAnimBlendAssociation *anim = CAnimManager::GetAnimAssociation(groupId, aVCModMoveAnims[i]);
+		if (anim == nil || anim->hierarchy == nil) {
+			fprintf(stderr, "VCMOD refusing group %d, no slot %d\n", groupId, aVCModMoveAnims[i]);
+			return false;
+		}
+	}
+	return true;
+}
+
+bool
+VCModPickAnimGroup(AssocGroupId *out)
+{
+	if (!bVCModPlayerNpcAnims)
+		return false;
+
+	AssocGroupId want = (AssocGroupId) aVCModAnimGroups[nVCModAnimChoice];
+	static AssocGroupId loggedWant = NUM_ANIM_ASSOC_GROUPS;
+	if (want != loggedWant) {
+		fprintf(stderr, "VCMOD selecting %s (list %d -> group %d)\n",
+			aVCModAnimGroupNames[nVCModAnimChoice], nVCModAnimChoice, want);
+		loggedWant = want;
+	}
+	if (!VCModGroupPlayable(want))
+		return false;
+
+	*out = want;
+	return true;
+}
+
+const char *
+VCModAnimSetName(int32 entry)
+{
+	if (entry < 0 || entry >= NUM_VCMOD_ANIM_SETS)
+		return "unknown";
+	return aVCModAnimGroupNames[entry];
+}
+
+int32
+VCModPedCategoryOf(int32 pedType)
+{
+	switch (pedType) {
+	case PEDTYPE_COP:
+	case PEDTYPE_EMERGENCY:
+	case PEDTYPE_FIREMAN:
+		return VCMOD_PEDCAT_COPS;
+	case PEDTYPE_GANG1:
+	case PEDTYPE_GANG2:
+	case PEDTYPE_GANG3:
+	case PEDTYPE_GANG4:
+	case PEDTYPE_GANG5:
+	case PEDTYPE_GANG6:
+	case PEDTYPE_GANG7:
+	case PEDTYPE_GANG8:
+	case PEDTYPE_GANG9:
+		return VCMOD_PEDCAT_GANGS;
+	// the player shelves are Tommy's own, and he is already on the list. The
+	// story bodies are not a ped type either: default.ide hands those slots to
+	// CIVMALE, and their real models live in the cutscene table
+	case PEDTYPE_SPECIAL:
+	case PEDTYPE_PLAYER1:
+	case PEDTYPE_PLAYER2:
+	case PEDTYPE_PLAYER3:
+	case PEDTYPE_PLAYER4:
+		return -1;
+	}
+	return VCMOD_PEDCAT_CIVILIANS;
+}
+
+// read from the model table the game loaded, so every ped it actually ships
+// appears without a hand-kept list going stale
+static bool
+VCModRosterPed(int32 modelIndex, int32 category, int16 *outIndex, const char **outName)
+{
+	if (modelIndex >= MI_SPECIAL01 && modelIndex <= MI_LAST_PED)
+		return false;
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+	if (VCModPedCategoryOf(((CPedModelInfo *) mi)->m_pedType) != category)
+		return false;
+	if (outIndex)
+		*outIndex = modelIndex;
+	if (outName)
+		*outName = mi->GetModelName();
+	return true;
+}
+
+// a special slot only has a body once the archive actually holds the file the
+// cutscene table names for it; asking for the placeholder streams nothing
+static bool
+VCModRosterSpecial(int32 entry, int16 *outIndex, const char **outName)
+{
+	if (entry < 0 || entry > MI_LAST_PED - MI_SPECIAL01)
+		return false;
+
+	const char *name = CStreaming::GetSpecialCharModelName(entry);
+	if (name == nil)
+		return false;
+
+	uint32 pos, size;
+	if (CStreaming::ms_pExtraObjectsDir == nil ||
+			!CStreaming::ms_pExtraObjectsDir->FindItem(name, pos, size))
+		return false;
+
+	if (outIndex)
+		*outIndex = (int16) (MI_SPECIAL01 + entry);
+	if (outName)
+		*outName = name;
+	return true;
+}
+
+int32
+VCModPedModelCount(int32 category)
+{
+	// entry 0 is always Tommy: the way back from any character
+	int32 n = 1;
+	if (category == VCMOD_PEDCAT_MISSION) {
+		for (int32 i = 0; i <= MI_LAST_PED - MI_SPECIAL01; i++)
+			if (VCModRosterSpecial(i, nil, nil))
+				n++;
+		return n;
+	}
+	for (int32 i = MI_COP; i <= MI_LAST_PED; i++)
+		if (VCModRosterPed(i, category, nil, nil))
+			n++;
+	return n;
+}
+
+bool
+VCModPedModelAt(int32 category, int32 entry, int16 *outIndex, const char **outName)
+{
+	if (entry < 0)
+		return false;
+	if (entry == 0) {
+		*outIndex = MI_PLAYER;
+		*outName = "Tommy Vercetti";
+		return true;
+	}
+	if (category == VCMOD_PEDCAT_MISSION) {
+		for (int32 i = 0; i <= MI_LAST_PED - MI_SPECIAL01; i++) {
+			if (!VCModRosterSpecial(i, outIndex, outName))
+				continue;
+			if (--entry == 0)
+				return true;
+		}
+		return false;
+	}
+	for (int32 i = MI_COP; i <= MI_LAST_PED; i++) {
+		if (!VCModRosterPed(i, category, outIndex, outName))
+			continue;
+		if (--entry == 0)
+			return true;
+	}
+	return false;
+}
+
+bool
+VCModPedAnimGroupFor(int16 modelIndex, AssocGroupId *out)
+{
+	// Tommy's stock logic picks a different group per weapon and per strafe, so
+	// pinning him to one group would take those away
+	if (modelIndex == MI_PLAYER)
+		return false;
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+
+	AssocGroupId grp = (AssocGroupId) ((CPedModelInfo *) mi)->m_animGroup;
+	if (!VCModGroupPlayable(grp))
+		return false;
+
+	*out = grp;
+	return true;
+}
+
+// CPed::SetMoveAnim paces every ped by m_randomSeed, rolled once when the ped
+// spawns. The player is built at boot, before the PC build seeds the generator
+// (mysrand is never called), so his roll would be one frozen number forever. A
+// body or anim set change is his spawn, so it rolls a fresh pace there.
+void
+VCModRollPlayerPace(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player)
+		player->m_randomSeed = CGeneral::GetRandomNumber();
+}
+
+// the engine's own way of wearing another model, from ChangePlayerCheat: the ped
+// keeps its identity and only the clump underneath it is replaced
+bool
+VCModApplyPedModel(int16 modelIndex)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return false;
+
+	int32 oldIndex = player->GetModelIndex();
+	if (modelIndex == oldIndex)
+		return true;
+	if (modelIndex < 0)
+		return false;
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+
+	if (modelIndex == MI_PLAYER) {
+		if (!CStreaming::HasModelLoaded(MI_PLAYER)) {
+			CStreaming::RequestSpecialModel(MI_PLAYER, "player", STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+			CStreaming::LoadAllRequestedModels(false);
+		}
+	} else if (modelIndex >= MI_SPECIAL01 && modelIndex <= MI_LAST_PED) {
+		// default.ide calls these slots special01..21 and no file answers to that;
+		// the body has to be named before the slot has anything to stream
+		const char *name = CStreaming::GetSpecialCharModelName(modelIndex - MI_SPECIAL01);
+		if (name == nil)
+			return false;
+		CStreaming::RequestSpecialModel(modelIndex, name, STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+		CStreaming::LoadAllRequestedModels(false);
+	} else {
+		CStreaming::RequestModel(modelIndex, STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+		CStreaming::LoadAllRequestedModels(false);
+	}
+	// a slot can report itself loaded while streaming nothing, and SetModelIndex
+	// then hands a nil clump to the anim blend
+	if (!CStreaming::HasModelLoaded(modelIndex) || mi->GetRwObject() == nil) {
+		// nothing was rebuilt, so only the request that failed is worth dropping
+		CStreaming::SetModelIsDeletable(modelIndex);
+		return false;
+	}
+
+	AssocGroupId animGroup;
+	if (!VCModPedAnimGroupFor(modelIndex, &animGroup))
+		animGroup = ASSOCGRP_PLAYER;
+
+	player->DeleteRwObject();
+	player->m_modelIndex = -1;
+	player->SetModelIndex(modelIndex);
+	// SetModelIndex takes both of these from the model, and Tommy is still Tommy
+	player->SetPedStats(PEDSTAT_PLAYER);
+	player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+	player->m_animGroup = animGroup;
+	player->ReApplyMoveAnims();
+	VCModRollPlayerPace();
+
+	// the held weapon is its own atomic parented to the hand each frame, so it
+	// outlived the clump and has to be freed before the new one is attached
+	if (player->m_wepModelID >= 0) {
+		int32 w = player->m_wepModelID;
+		player->RemoveWeaponModel(-1);
+		player->AddWeaponModel(w);
+	}
+
+	// only release what this mod pinned: a model a save or a script put on the
+	// player was never ours to hand back
+	if (nVCModHeldModelRequest >= 0 && nVCModHeldModelRequest != modelIndex) {
+		CStreaming::SetModelIsDeletable(nVCModHeldModelRequest);
+		nVCModHeldModelRequest = -1;
+	}
+	if (modelIndex != MI_PLAYER)
+		nVCModHeldModelRequest = modelIndex;
+
+	return true;
+}
+
+void
+VCModApplyPedModelDefault(void)
+{
+	if (nVCModPedModel < 0)
+		return;
+
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return;
+
+	// one try per start: a model that cannot be worn is not worth requesting
+	// again on every frame
+	int32 want = nVCModPedModel;
+	nVCModPedModel = -1;
+	VCModApplyPedModel((int16) want);
+}
+
+// respawn rebuilds the ped through Undress/Dress, which takes stats and group
+// from whatever model is worn, and a save can swap the ped out entirely, so the
+// mod's own bookkeeping has to be re-checked rather than trusted
+void
+VCModReconcilePedModel(CPlayerPed *player)
+{
+	int32 worn = player->GetModelIndex();
+
+	if (nVCModHeldModelRequest >= 0 && nVCModHeldModelRequest != worn) {
+		CStreaming::SetModelIsDeletable(nVCModHeldModelRequest);
+		nVCModHeldModelRequest = -1;
+	}
+
+	if (worn == MI_PLAYER)
+		return;
+
+	// an NPC profile owns the stat while it drives him; reconcile only puts the
+	// player stat back when nothing borrows him
+	if (VCModNpcStatsBorrowed())
+		return;
+
+	if (player->m_pedStats->m_type != PEDSTAT_PLAYER) {
+		player->SetPedStats(PEDSTAT_PLAYER);
+		player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+	}
+}
+
+// which group the player wears: the picker when it is on, otherwise whatever the
+// character model brought, and neither while the stock logic needs its own
+bool
+VCModPlayerAnimGroup(CPlayerPed *player, bool strafing, AssocGroupId *out)
+{
+	if (strafing)
+		return false;
+	if (bVCModPlayerNpcAnims)
+		return VCModPickAnimGroup(out);
+	return VCModPedAnimGroupFor(player->GetModelIndex(), out);
+}
+
+static uint32 nVCModLoggedSeed = 0xFFFFFFFF;
+
+// CPed::SetMoveAnim walks a ped at 0.8-1.2 of the clip's authored rate, rolled
+// once per spawn, and that rate is his ground speed because the clip's root
+// motion is what moves him. The player has no spawn to roll at (he is built
+// before the PC build seeds the generator), so a body or anim set change is
+// his spawn and rolls a fresh pace then.
+void
+VCModCharacterMoveTempo(CPlayerPed *player, CAnimBlendAssociation *walk,
+                        CAnimBlendAssociation *run, CAnimBlendAssociation *sprint)
+{
+	if (!player->m_bAdrenalineActive && (bVCModPlayerNpcAnims || player->GetModelIndex() != MI_PLAYER)) {
+		float tempo = 1.2f - player->m_randomSeed * 0.4f / MYRAND_MAX;
+		if (player->m_randomSeed != nVCModLoggedSeed) {
+			VCMOD_DIAG("VCMOD move: tempo %.2f (seed %u, model %d, clip %s)\n",
+				tempo, (unsigned)player->m_randomSeed, player->GetModelIndex(),
+				walk && walk->hierarchy ? walk->hierarchy->name : "none");
+			nVCModLoggedSeed = player->m_randomSeed;
+		}
+		if (walk)
+			walk->speed = tempo;
+		if (run)
+			run->speed = tempo;
+		// the fixed camera owns the sprint's rate for its own look
+		if (sprint && TheCamera.Cams[TheCamera.ActiveCam].Mode != CCam::MODE_FIXED)
+			sprint->speed = tempo;
+	}
+}
