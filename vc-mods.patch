+class DiagnosticGateTests(unittest.TestCase):
+    def test_default_is_off(self):
+        self.assertIn("bool bVCModDiagnostics = false;", DIAG)
+        self.assertIn("if (bVCModDiagnostics)", DIAG_H)
+
+    def test_switch_is_reachable(self):
+        # DEBUG page row, debug-menu entry, and the ini key that remembers it
+        self.assertIn('&bVCModDiagnostics,    "Diagnostics",    VCMOD_PAGE_DEBUG', PANEL)
+        self.assertIn("TWEAKBOOLN(bVCModDiagnostics", PANEL)
+        self.assertIn(
+            'ReadIniIfExists("VC Mods", "Diagnostics", &bVCModDiagnostics);', INI
+        )
+
+    def test_probes_are_gated(self):
+        for label in GATED:
+            self.assertIn(f'VCMOD_DIAG("{label}', SOURCES, label)
+            self.assertNotIn(f'fprintf(stderr, "{label}', SOURCES, label)
+
+    def test_feature_logs_stay_on(self):
+        for label in KEPT:
+            self.assertIn(f'fprintf(stderr, "{label}', SOURCES, label)
+            self.assertNotIn(f'VCMOD_DIAG("{label}', SOURCES, label)
+
+    def test_no_temporary_markers_left(self):
+        for marker in ("TEMP diagnostic", "TEMP flicker", "TEMP probe"):
+            self.assertNotIn(marker, SOURCES)
+
+
+if __name__ == "__main__":
+    unittest.main()
