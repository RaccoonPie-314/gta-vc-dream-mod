diff --git a/src/extras/vcmodsteering.cpp b/src/extras/vcmodsteering.cpp
new file mode 100644
index 0000000..018ee71
--- /dev/null
+++ b/src/extras/vcmodsteering.cpp
@@ -0,0 +1,45 @@
+#include "common.h"
+
+#include "vcmodsteering.h"
+
+#include "Automobile.h"
+#include "Vehicle.h"
+
+bool bVCModSteeringWheel = true;
+
+// the road wheels lock at 35 degrees; a wheel in your hands turns a good deal
+// further, so the two read as connected instead of moving as one piece
+#define VCMOD_STEERING_WHEEL_RATIO	4.0f
+
+void
+VCModSteeringWheelUpdate(CAutomobile *car)
+{
+	RwFrame *frame = car->m_aCarNodes[CAR_STEERING_WHEEL];
+	if(frame == nil)
+		return;
+
+	RwMatrix *matrix = RwFrameGetMatrix(frame);
+
+	// the node's own orientation places the wheel on the column; keep it and
+	// only add the turn on top, or the wheel would flatten back to vertical
+	if(!car->m_steeringWheelRestValid){
+		car->m_steeringWheelRest = *matrix;
+		car->m_steeringWheelRestValid = true;
+	}
+
+	float angle = car->m_fSteerAngle * VCMOD_STEERING_WHEEL_RATIO;
+	if(angle == car->m_steeringWheelAngle)
+		return;
+	car->m_steeringWheelAngle = angle;
+
+	// the wheel mesh is a disc in its own XZ plane, so it turns about local Y
+	// and positive, towards the car's right, matches a right-hand turn
+	CVector axis(0.0f, 1.0f, 0.0f);
+	RwMatrix result = car->m_steeringWheelRest;
+	RwMatrixRotate(&result, &axis, angle, rwCOMBINEPOSTCONCAT);
+	*matrix = result;
+
+	// a parked car never dirties its clump, so the turn would stay invisible
+	// until it moved; the frame has to schedule its own update
+	RwFrameUpdateObjects(frame);
+}
