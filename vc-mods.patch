diff --git a/src/extras/vcmodadrenaline.cpp b/src/extras/vcmodadrenaline.cpp
new file mode 100644
index 0000000..249f8ed
--- /dev/null
+++ b/src/extras/vcmodadrenaline.cpp
@@ -0,0 +1,98 @@
+#include "common.h"
+
+#include "vcmodadrenaline.h"
+
+#include "AnimBlendAssociation.h"
+#include "AnimationId.h"
+#include "CutsceneMgr.h"
+#include "Pad.h"
+#include "PlayerInfo.h"
+#include "PlayerPed.h"
+#include "Replay.h"
+#include "RpAnimBlend.h"
+#include "Timer.h"
+
+// Keep runtime ownership outside the saved player layout.
+static CPlayerPed *pVCModAdrenalinePlayer;
+static float fVCModAdrenalineRestoreScale;
+static bool bVCModAdrenalineSlowing;
+
+// 0 off, 1 normal, 2 slow-mo. One value serves the panel row, the debug-menu
+// entry and the ini, so the mode cannot disagree with the switch next to it.
+int32 nVCModAdrenalineMode;
+
+// defined in PlayerPed.cpp
+CPad *GetPadFromPlayer(CPlayerPed *);
+
+bool
+VCModAdrenalineOwns(CPlayerPed *player)
+{
+	return player != nil && pVCModAdrenalinePlayer == player;
+}
+
+void
+CPlayerPed::ClearAdrenaline(void)
+{
+	if (pVCModAdrenalinePlayer == this) {
+		if (bVCModAdrenalineSlowing && CTimer::GetTimeScale() == 1.0f / 3)
+			CTimer::SetTimeScale(fVCModAdrenalineRestoreScale);
+		pVCModAdrenalinePlayer = nil;
+		bVCModAdrenalineSlowing = false;
+		m_bAdrenalineActive = false;
+		m_nAdrenalineTime = 0;
+
+		const AnimationId moveAnims[] = { ANIM_STD_STARTWALK, ANIM_STD_WALK, ANIM_STD_RUN, ANIM_STD_RUNFAST };
+		for (uint32 i = 0; i < ARRAY_SIZE(moveAnims); i++) {
+			CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(GetClump(), moveAnims[i]);
+			if (assoc)
+				assoc->speed = 1.0f;
+		}
+		return;
+	}
+	if (m_bAdrenalineActive && m_nAdrenalineTime != 0) {
+		m_nAdrenalineTime = 0;
+		CTimer::SetTimeScale(1.0f);
+	}
+}
+
+void
+VCModSuspendAdrenaline(void)
+{
+	if (pVCModAdrenalinePlayer)
+		pVCModAdrenalinePlayer->ClearAdrenaline();
+}
+
+void
+VCModUpdateAdrenaline(CPlayerPed *player)
+{
+	CPad *pad = GetPadFromPlayer(player);
+	bool allowed = player == FindPlayerPed() && nVCModAdrenalineMode != 0 && pad && !pad->ArePlayerControlsDisabled() &&
+		!player->bInVehicle && !player->DyingOrDead() && player->m_nPedState != PED_ARRESTED &&
+		!CCutsceneMgr::IsRunning() && !CReplay::IsPlayingBack();
+	if (!allowed) {
+		if (pVCModAdrenalinePlayer == player)
+			player->ClearAdrenaline();
+		return;
+	}
+
+	if (pVCModAdrenalinePlayer != player) {
+		if (pVCModAdrenalinePlayer)
+			pVCModAdrenalinePlayer->ClearAdrenaline();
+		pVCModAdrenalinePlayer = player;
+		bVCModAdrenalineSlowing = player->m_bAdrenalineActive && CTimer::GetTimeScale() == 1.0f / 3;
+		fVCModAdrenalineRestoreScale = bVCModAdrenalineSlowing ? 1.0f : CTimer::GetTimeScale();
+		player->m_bAdrenalineActive = true;
+		player->m_nAdrenalineTime = CTimer::GetTimeInMilliseconds() + 20000;
+		player->m_fCurrentStamina = player->m_fMaxStamina;
+	}
+
+	bool slowMo = nVCModAdrenalineMode == 2;
+	if (slowMo) {
+		if (!bVCModAdrenalineSlowing || CTimer::GetTimeScale() != 1.0f / 3)
+			fVCModAdrenalineRestoreScale = CTimer::GetTimeScale();
+		CTimer::SetTimeScale(1.0f / 3);
+	} else if (bVCModAdrenalineSlowing && CTimer::GetTimeScale() == 1.0f / 3) {
+		CTimer::SetTimeScale(fVCModAdrenalineRestoreScale);
+	}
+	bVCModAdrenalineSlowing = slowMo;
+}
diff --git a/src/extras/vcmodadrenaline.h b/src/extras/vcmodadrenaline.h
new file mode 100644
index 0000000..58c2099
