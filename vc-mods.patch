@@ -0,0 +1,1082 @@
+#!/usr/bin/env python3
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+PLAYER = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+HEAD = (ROOT / "src/extras/vcmodpanel.h").read_text()
+CHAR = (ROOT / "src/extras/vcmodcharacter.cpp").read_text()
+CHAR_HEAD = (ROOT / "src/extras/vcmodcharacter.h").read_text()
+PLAYERMOD = (ROOT / "src/extras/vcmodplayer.cpp").read_text()
+RIDE_H = (ROOT / "src/extras/vcmodride.h").read_text()
+INI = (ROOT / "src/core/re3.cpp").read_text()
+STREAMING_HEAD = (ROOT / "src/core/Streaming.h").read_text()
+STREAM = (ROOT / "src/core/Streaming.cpp").read_text()
+
+ENGINE_STUBS = r'''
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <sstream>
+#include <string>
+#include <vector>
+#include <stdint.h>
+#define nil NULL
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define VCMOD_DIAG(...) do { } while (0)
+bool bVCModDiagnostics = false;
+bool bVCModTrafficAI = true;
+bool bVCModVanillaFixes = true;
+bool bVCModHudCleanup = true;
+bool bVCModKeepWheelAngle = true;
+bool bVCModExitHoldOff = true;
+bool bVCModLongerFx = true;
+bool bVCModManualReload = true;
+bool bVCModCopCrouchCover = true;
+bool bVCModWheelLoss = true;
+bool bVCModRotorBlades = true;
+bool bVCModShootableProjectiles = true;
+bool bVCModExplosionCover = true;
+bool bVCModFBILights = true;
+bool bVCModFireTruckCannon = true;
+bool bVCModSteeringWheel = true;
+bool bVCModLightTextures = true;
+bool bVCModCrewAggressive;
+bool VCModCarFirstPersonOn(void) { return false; }
+void VCModCarFirstPersonSet(bool) {}
+void VCModRefreshParticleLifetimes(void) {}
+void VCModRollPlayerPace(void) {}
+int VCModSpawnCount(void) { return 0; }
+const char *VCModSpawnName(int) { return ""; }
+bool VCModSpawnPick(int) { return false; }
+// an NPC profile may own the ped's stat; reconcile has to leave it alone
+static bool bVCModNpcStatsBorrowed = false;
+static bool VCModNpcStatsBorrowed(void) { return bVCModNpcStatsBorrowed; }
+typedef int8_t int8;
+typedef uint8_t uint8;
+typedef int16_t int16;
+typedef uint16_t uint16;
+typedef int32_t int32;
+typedef uint32_t uint32;
+struct CGeneral {
+    static bool faststricmp(const char *str1, const char *str2) {
+        for (; *str1; str1++, str2++)
+            if (std::tolower((unsigned char) *str1) != std::tolower((unsigned char) *str2))
+                return true;
+        return *str2 != '\0';
+    }
+};
+static std::string to_string(int value) {
+    std::ostringstream out;
+    out << value;
+    return out.str();
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def run_cpp(source):
+    with tempfile.TemporaryDirectory(prefix="vc-character-test-") as directory:
+        cpp = Path(directory) / "test.cpp"
+        binary = Path(directory) / "test"
+        cpp.write_text(source)
+        build = subprocess.run(["c++", "-std=c++98", "-Wall", "-Wextra", str(cpp), "-o", str(binary)],
+                               capture_output=True, text=True)
+        if build.returncode:
+            print(build.stderr)
+            numbered = "".join(f"{n}: {line}\n" for n, line in enumerate(source.splitlines(), 1))
+            raise RuntimeError("compile failed\n" + numbered)
+        if build.stderr:
+            print(build.stderr)
+        run = subprocess.run([str(binary)], capture_output=True, text=True)
+        if run.returncode:
+            print(run.stdout, run.stderr)
+            raise RuntimeError("test binary failed")
+
+
+class CharacterTests(unittest.TestCase):
+    def test_categories_roster_and_anim_group(self):
+        categories = braced(CHAR, "int32\nVCModPedCategoryOf(int32 pedType)")
+        roster = braced(CHAR, "static bool\nVCModRosterPed(int32 modelIndex, int32 category, int16 *outIndex, const char **outName)")
+        special = braced(CHAR, "static bool\nVCModRosterSpecial(int32 entry, int16 *outIndex, const char **outName)")
+        count = braced(CHAR, "int32\nVCModPedModelCount(int32 category)")
+        at = braced(CHAR, "bool\nVCModPedModelAt(int32 category, int32 entry, int16 *outIndex, const char **outName)")
+        group = braced(CHAR, "bool\nVCModPedAnimGroupFor(int16 modelIndex, AssocGroupId *out)")
+        # the shelf labels are the panel's own display state, so they stay there
+        names = "\n".join(re.findall(r"^(?:static )?const char \*aVCModPedCategoryNames\[\][^;]*;", PANEL, re.M))
+        moveAnims = "\n".join(re.findall(r"^static const AnimationId aVCModMoveAnims\[\][^;]*;", CHAR, re.M))
+        categoryEnum = re.search(r"enum eVCModPedCategory\s*\{.*?\}", CHAR_HEAD, re.S).group(0) + ";"
+        playable = braced(CHAR, "static bool\nVCModGroupPlayable(AssocGroupId groupId)")
+        specialNames = re.search(r"static char \*IGnames\[\] = \{.*?\};", STREAM, re.S).group(0)
+        getSpecialName = braced(STREAM, "const char *\nCStreaming::GetSpecialCharModelName(int32 charId)"
+                                  ).replace("CStreaming::", "")
+        run_cpp(ENGINE_STUBS + r'''
+enum ePedType { PEDTYPE_PLAYER1, PEDTYPE_PLAYER2, PEDTYPE_PLAYER3, PEDTYPE_PLAYER4,
+	PEDTYPE_CIVMALE, PEDTYPE_CIVFEMALE, PEDTYPE_COP,
+	PEDTYPE_GANG1, PEDTYPE_GANG2, PEDTYPE_GANG3, PEDTYPE_GANG4, PEDTYPE_GANG5,
+	PEDTYPE_GANG6, PEDTYPE_GANG7, PEDTYPE_GANG8, PEDTYPE_GANG9,
+	PEDTYPE_EMERGENCY, PEDTYPE_FIREMAN, PEDTYPE_CRIMINAL, PEDTYPE_UNUSED1,
+	PEDTYPE_PROSTITUTE, PEDTYPE_SPECIAL, PEDTYPE_UNUSED2, NUM_PEDTYPES };
+enum AssocGroupId { ASSOCGRP_STD, ASSOCGRP_PLAYER, ASSOCGRP_GANG1, ASSOCGRP_OLD, NUM_ANIM_ASSOC_GROUPS };
+enum { MI_PLAYER = 0, MI_COP = 1, MI_SWAT, MI_FBI, MI_ARMY, MI_MEDIC, MI_FIREMAN, MI_MALE01,
+	MI_HFYST = 9, MI_HFOST, MI_CBA, MI_CBB, MI_HNA, MI_HNB, MI_VICE1, MI_WFYG2 = 106,
+	MI_SPECIAL01 = 109, MI_LAST_PED = 129 };
+#define MITYPE_PED 3
+''' + categoryEnum + r'''
+struct CAnimBlendHierarchy { char name[32]; int32 numSequences; void *sequences; };
+CAnimBlendHierarchy goodHierarchy;
+CAnimBlendHierarchy emptyHierarchy;
+struct CAnimBlendAssocEntry { CAnimBlendHierarchy *hierarchy; };
+struct CAnimBlendAssocGroup { int32 numAssociations; CAnimBlendAssocEntry assocList[2]; };
+CAnimBlendAssocGroup groups[NUM_ANIM_ASSOC_GROUPS];
+enum AnimationId { ANIM_STD_IDLE = 0, ANIM_STD_STARTWALK, ANIM_STD_WALK, ANIM_STD_RUN, ANIM_STD_RUNFAST, ANIM_DIE };
+struct CAnimBlendAssociation { CAnimBlendHierarchy *hierarchy; AnimationId animId; };
+CAnimBlendAssociation moveAssocs[5];
+int32 moveAssocCount = 5;
+struct CAnimManager {
+    static CAnimBlendAssocGroup *GetAnimAssocGroups() { return groups; }
+    static CAnimBlendAssociation *GetAnimAssociation(AssocGroupId, AnimationId id) {
+        return (int32) id < moveAssocCount ? &moveAssocs[id] : nil;
+    }
+};
+struct CBaseModelInfo {
+	uint8 type; char name[24];
+	uint8 GetModelType() { return type; }
+	char *GetModelName() { return name; }
+};
+struct CPedModelInfo {
+	uint8 type; char name[24];
+	int32 m_pedType; uint32 m_animGroup;
+	uint8 GetModelType() { return type; }
+	char *GetModelName() { return name; }
+};
