+}
+
+// mirrors CAnimBlendAssociation::UpdateBlend
+static void Advance(float dt)
+{
+    for (size_t i = 0; i < CAnimBlendAssociation::live.size(); ) {
+        CAnimBlendAssociation *anim = CAnimBlendAssociation::live[i];
+        anim->blendAmount += anim->blendDelta * dt;
+        if (anim->blendAmount <= 0.0f && anim->blendDelta < 0.0f) {
+            anim->blendAmount = 0.0f;
+            anim->blendDelta = 0.0f;
+            if (anim->flags & ASSOC_DELETEFADEDOUT) {
