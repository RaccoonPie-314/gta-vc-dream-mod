+#!/usr/bin/env python3
+import unittest
+from pathlib import Path
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+WANTED = (ROOT / 'src/core/Wanted.cpp').read_text()
+CRIME = (ROOT / 'src/core/Crime.h').read_text()
+HEADER = (ROOT / 'src/core/Wanted.h').read_text().replace('#include "Crime.h"', '').replace('VALIDATE_SIZE(CWanted, 0x204);', '')
+
+STUBS = r'''
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#define nil NULL
+#define ARRAY_SIZE(a) int(sizeof(a) / sizeof((a)[0]))
+typedef int32_t int32;
+typedef uint32_t uint32;
+typedef uint8_t uint8;
+typedef int16_t int16;
+struct CVector { float x, y, z; CVector() : x(0), y(0), z(0) {} };
+class CCopPed {};
+bool bVCModNeverWanted = false;
+uint32 now = 10000;
+int audioCrimes = 0;
+int pursuitResets = 0;
+template<class T> T Min(T a, T b) { return a < b ? a : b; }
+template<class T> T Max(T a, T b) { return a > b ? a : b; }
+struct CTimer { static uint32 GetTimeInMilliseconds() { return now; } };
+struct CStats { static int WantedStarsAttained, WantedStarsEvaded; };
+int CStats::WantedStarsAttained = 0;
+int CStats::WantedStarsEvaded = 0;
+struct CDarkel { static bool FrenzyOnGoing() { return false; } };
+struct CCullZones { static int GetWantedLevelDrop() { return 0; } };
+struct Audio { void ReportCrime(int, const CVector&) { ++audioCrimes; } } DMAudio;
+void Error(const char*) { abort(); }
+CVector FindPlayerCoors() { return CVector(); }
+'''
+
+FUNCTIONS = ('VCModNeverWanted(void)', 'Initialise()', 'SetWantedLevel(int32 level)', 'SetWantedLevelNoDrop(int32 level)',
+             'CheatWantedLevel(int32 level)',
+             'RegisterCrime(eCrimeType type, const CVector &coors, uint32 id, bool policeDoesntCare)',
+             'RegisterCrime_Immediately(eCrimeType type, const CVector &coors, uint32 id, bool policeDoesntCare)',
+             'ClearQdCrimes()',
+             'AddCrimeToQ(eCrimeType type, int32 id, const CVector &coors, bool reported, bool policeDoesntCare)',
+             'ReportCrimeNow(eCrimeType type, const CVector &coors, bool policeDoesntCare)',
+             'UpdateWantedLevel()', 'Update(void)', 'UpdateCrimesQ(void)', 'Suspend(void)')
+
+SOURCE = STUBS + CRIME + HEADER + r'''
+int32 CWanted::MaximumWantedLevel = 6;
+int32 CWanted::nMaximumWantedLevel = 9600;
+int32 CWanted::WorkOutPolicePresence(CVector, float) { return 1; }
+void CWanted::ResetPolicePursuit() { ++pursuitResets; }
+''' + '\n'.join(braced(WANTED, ('bool\nCWanted::' if f.startswith(('AddCrimeToQ', 'VCModNeverWanted'))
+                                    else 'void\nCWanted::') + f) for f in FUNCTIONS)
+
+
+class NeverWantedTests(unittest.TestCase):
+    def check(self, body, significant=True):
+        run_cpp(('#define FIX_SIGNIFICANT_BUGS\n' if significant else '') + SOURCE + r'''
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "line %d: %s\n", __LINE__, #c); return 1; } } while (0)
+int main() {
+    CWanted w; w.Initialise(); CVector pos;
+''' + body + '\nreturn 0;\n}\n')
+
+    def test_direct_setters_never_raise_stars(self):
+        self.check(r'''
+    bVCModNeverWanted = true;
+    w.SetWantedLevel(6);
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0);
+    w.SetWantedLevelNoDrop(2);
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0);
+    w.CheatWantedLevel(4);
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0);
+    CHECK(CStats::WantedStarsAttained == 0);
+''')
+
+    def test_registration_does_not_queue_or_report(self):
+        for significant in (True, False):
+            with self.subTest(significant=significant):
+                self.check(r'''
+    bVCModNeverWanted = true;
+    w.RegisterCrime(CRIME_SHOOT_COP, pos, 1, false);
+    w.RegisterCrime_Immediately(CRIME_HIT_COP, pos, 2, false);
+    CHECK(w.AddCrimeToQ(CRIME_RUNOVER_COP, 3, pos, false, false));
+    w.ReportCrimeNow(CRIME_COP_BURNED, pos, false);
+    for (int i = 0; i < 16; ++i) CHECK(w.m_aCrimes[i].m_nType == CRIME_NONE);
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0 && audioCrimes == 0);
+''', significant)
+
+    def test_preexisting_queue_is_discarded_while_chaos_is_zero(self):
+        self.check(r'''
+    w.RegisterCrime(CRIME_SHOOT_COP, pos, 1, false);
+    CHECK(w.m_nChaos == 0);
+    bVCModNeverWanted = true;
+    w.UpdateCrimesQ();
+    for (int i = 0; i < 16; ++i) CHECK(w.m_aCrimes[i].m_nType == CRIME_NONE);
+    bVCModNeverWanted = false;
+    now += 2000; w.UpdateCrimesQ();
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0 && audioCrimes == 0);
+''')
+
+    def test_enabling_clears_active_and_suspended_wanted_without_resetting_pursuit(self):
+        self.check(r'''
+    w.SetWantedLevel(4); w.Suspend();
+    CCopPed cop; w.m_pCops[0] = &cop; w.m_CurrentCops = 1;
+    int resets = pursuitResets;
+    w.RegisterCrime(CRIME_HIT_COP, pos, 1, false);
+    bVCModNeverWanted = true;
+    w.Update();
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0);
+    CHECK(w.m_nMinChaos == 0 && w.m_nMinWantedLevel == 0);
+    CHECK(!w.m_bIgnoredByCops && !w.m_bIgnoredByEveryone);
+    CHECK(w.m_pCops[0] == &cop && w.m_CurrentCops == 1 && pursuitResets == resets);
+    CHECK(w.m_MaxCops == 0 && w.m_MaximumLawEnforcerVehicles == 0 && w.m_RoadblockDensity == 0);
+    bVCModNeverWanted = false;
+    w.SetWantedLevelNoDrop(0);
+    CHECK(w.GetWantedLevel() == 0 && w.m_nChaos == 0);
+''')
+
+    def test_one_helper_reads_the_switch(self):
+        # the flag is read once, in the helper; every gate goes through it
+        self.assertEqual(WANTED.count("bVCModNeverWanted"), 1)
+        self.assertEqual(WANTED.count("if (VCModNeverWanted())"), 5)
+        self.assertIn("bool VCModNeverWanted(void);", HEADER)
+
+    def test_off_retains_direct_and_suspended_levels(self):
+        self.check(r'''
+    w.SetWantedLevel(4); CHECK(w.GetWantedLevel() == 4 && w.m_nChaos == 1220);
+    w.Suspend(); CHECK(w.GetWantedLevel() == 0 && w.m_nMinWantedLevel == 4);
+    w.SetWantedLevelNoDrop(2); CHECK(w.GetWantedLevel() == 4);
+    w.CheatWantedLevel(0); CHECK(w.GetWantedLevel() == 0);
+''')
+
+    def test_off_retains_crime_timing_deduplication_and_immediate_reporting(self):
+        self.check(r'''
+    w.RegisterCrime(CRIME_SHOOT_COP, pos, 1, false);
+    now += 499; w.UpdateCrimesQ(); CHECK(w.m_nChaos == 0 && audioCrimes == 0);
+    now += 2; w.UpdateCrimesQ(); CHECK(w.GetWantedLevel() == 1 && w.m_nChaos == 80 && audioCrimes == 1);
+    w.UpdateCrimesQ(); CHECK(w.m_nChaos == 80 && audioCrimes == 1);
+    w.RegisterCrime_Immediately(CRIME_SHOOT_COP, pos, 1, false);
+    CHECK(w.m_nChaos == 80 && audioCrimes == 1);
+    w.RegisterCrime_Immediately(CRIME_SHOOT_COP, pos, 2, false);
+    CHECK(w.m_nChaos == 160 && audioCrimes == 2);
+    now += 10001; w.UpdateCrimesQ();
+    for (int i = 0; i < 16; ++i) CHECK(w.m_aCrimes[i].m_nType == CRIME_NONE);
+''')
+
+
+if __name__ == '__main__':
+    unittest.main()
