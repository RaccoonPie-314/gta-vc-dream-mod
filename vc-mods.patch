diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 363aa2d..41b6dea 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -27,6 +27,28 @@ elseif(ANDROID)
     add_library(${EXECUTABLE} SHARED ${${PROJECT}_SOURCES})
 endif()
 
+# A plain build number the player can quote. It lives in the build tree and goes
+# up once per configure, so "build 12" is always newer than "build 11". If the
+# build tree was wiped, it restarts from the commit count, which keeps it sane.
+set(VCMOD_BUILD_COUNTER_FILE "${CMAKE_BINARY_DIR}/vcmods-build-number")
+if(EXISTS "${VCMOD_BUILD_COUNTER_FILE}")
+    file(READ "${VCMOD_BUILD_COUNTER_FILE}" VCMOD_BUILD_NUMBER)
+    string(STRIP "${VCMOD_BUILD_NUMBER}" VCMOD_BUILD_NUMBER)
+endif()
+if(NOT VCMOD_BUILD_NUMBER MATCHES "^[0-9]+$")
+    execute_process(COMMAND git rev-list --count HEAD
+        WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
+        OUTPUT_VARIABLE VCMOD_BUILD_NUMBER
+        OUTPUT_STRIP_TRAILING_WHITESPACE
+        ERROR_QUIET)
+    if(NOT VCMOD_BUILD_NUMBER MATCHES "^[0-9]+$")
+        set(VCMOD_BUILD_NUMBER 0)
+    endif()
+endif()
+math(EXPR VCMOD_BUILD_NUMBER "${VCMOD_BUILD_NUMBER} + 1")
+file(WRITE "${VCMOD_BUILD_COUNTER_FILE}" "${VCMOD_BUILD_NUMBER}\n")
+target_compile_definitions(${EXECUTABLE} PRIVATE "VCMOD_BUILD_NUMBER=\"${VCMOD_BUILD_NUMBER}\"")
+
 target_link_libraries(${EXECUTABLE} PRIVATE
     librw::librw
     Threads::Threads
