+        for hook in ("void\nVCModApplyPedModelDefault(void)", "void\nVCModReconcilePedModel(CPlayerPed *player)",
+                     "bool\nVCModPlayerAnimGroup(CPlayerPed *player, bool strafing, AssocGroupId *out)",
+                     "void\nVCModCharacterMoveTempo(CPlayerPed *player, CAnimBlendAssociation *walk,"):
+            self.assertIn(hook, CHAR)
+        self.assertNotIn("static void\nVCModApplyPedModelDefault", CHAR)
+        self.assertNotIn("static void\nVCModReconcilePedModel", CHAR)
+        self.assertNotIn("static bool\nVCModPlayerAnimGroup", CHAR)
+
+        # both anim tables stay the same length and in the same order, and the
+        # debug menu's numbered rows still line up with them
+        names = re.search(r"static const char \*aVCModAnimGroupNames\[\] = \{(.*?)\};", CHAR, re.S).group(1)
+        groups = re.search(r"static const int32 aVCModAnimGroups\[\] = \{(.*?)\};", CHAR, re.S).group(1)
+        # the first label carries a comma inside its own string, so read the
+        # quoted literals rather than splitting the initializer on commas
+        nameList = re.findall(r'"([^"]*)"', names)
+        groupList = [g.strip() for g in groups.split(",") if g.strip()]
+        self.assertEqual(len(nameList), 17)
+        self.assertEqual(len(groupList), 17)
+        self.assertEqual(len(nameList), len(groupList))
+        for i in range(17):
+            self.assertIn('VCMOD_ROW(%d, "anim: %s")' % (i, nameList[i]), PANEL)
+        self.assertEqual(nameList[16], "skater (rollerblades)")
+        self.assertEqual(groupList[16], "ASSOCGRP_SKATE")
+
+        # the body-ownership order must not shift: reconcile, apply-default, ride,
+        # then sit, street, npc
+        order = ["VCModReconcilePedModel(this);", "VCModApplyPedModelDefault();", "VCModUpdateRide(this);",
+                 "VCModUpdateSitting(this, padUsed);", "VCModUpdateStreetIdle(this, padUsed);",
+                 "VCModUpdateNpcMode(this, padUsed);"]
+        positions = [control.index(call) for call in order]
+        self.assertEqual(positions, sorted(positions))
+
+        # The shared-file diffs are integrator-owned and land after this pass.
+        # Until they do, the engine and the panel still hold their own copies of
+        # the moved code, so the ownership negatives are enforced once the move
+        # has landed rather than against the transitional duplicate-symbol tree.
+        if "VCModApplyPedModel(int16 modelIndex)" not in PLAYER:
+            move = braced(PLAYER, "void\nCPlayerPed::SetRealMoveAnim(void)")
+            self.assertIn("VCModCharacterMoveTempo(this, curWalkAssoc, curRunAssoc, curSprintAssoc);", move)
+            # the engine keeps the call, not the feature state or the seed static
+            for gone in ("nVCModHeldModelRequest", "nVCModLoggedSeed", "bVCModPlayerNpcAnims",
+                         "VCModRollPlayerPace(void)", "1.2f - m_randomSeed"):
+                self.assertNotIn(gone, PLAYER)
+            self.assertNotIn("CPed::SetMoveAnim walks a ped at 0.8-1.2", PLAYER)
+            # the panel keeps no copy of the two tables or the roster predicates;
+            # it still calls them, so match the definitions, not every mention
+            for gone in ("static const char *aVCModAnimGroupNames[]", "static const int32 aVCModAnimGroups[]",
+                         "static const AnimationId aVCModMoveAnims[]",
+                         "VCModGroupPlayable(AssocGroupId groupId)", "VCModRosterPed(int32 modelIndex",
+                         "VCModRosterSpecial(int32 entry", "int32\nVCModPedCategoryOf(int32 pedType)",
+                         "int32\nVCModPedModelCount(int32 category)",
+                         "bool\nVCModPedModelAt(int32 category, int32 entry",
+                         "bool\nVCModPedAnimGroupFor(int16 modelIndex, AssocGroupId *out)",
+                         "bool\nVCModPickAnimGroup(AssocGroupId *out)",
+                         "bool bVCModPlayerNpcAnims;", "int32 nVCModAnimChoice;", "int32 nVCModPedModel = -1;"):
+                self.assertNotIn(gone, PANEL)
+            # the roster is still reached through the moved predicates
+            self.assertIn("VCModPedModelCount(nVCModPedCategory)", PANEL)
+            self.assertIn("VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name)", PANEL)
+            # the panel reaches the moved tables through the accessor and the count
+            self.assertIn("VCModAnimSetName(entry)", PANEL)
+            self.assertIn("VCModAnimSetName(nVCModAnimChoice)", PANEL)
+            self.assertIn("NUM_VCMOD_ANIM_SETS-1", PANEL)
+            self.assertIn("return NUM_VCMOD_ANIM_SETS;", PANEL)
+            # its own shelf-selection state and labels stay
+            self.assertIn("int32 nVCModPedCategory;", PANEL)
+            self.assertIn("const char *aVCModPedCategoryNames[]", PANEL)
+            self.assertIn('#include "vcmodcharacter.h"', PANEL)
+            # the god header no longer declares the moved symbols
+            for gone in ("nVCModPedModel", "nVCModAnimChoice", "bVCModPlayerNpcAnims", "eVCModPedCategory",
+                         "VCModPickAnimGroup", "VCModPedCategoryOf", "VCModApplyPedModel", "VCModRollPlayerPace"):
+                self.assertNotIn(gone, HEAD)
+            # every consumer includes the feature header directly
+            for path in ("src/core/re3.cpp", "src/extras/vcmodchase.cpp", "src/peds/PlayerPed.cpp"):
+                self.assertIn('#include "vcmodcharacter.h"', (ROOT / path).read_text())
+            # the ini reads and the chase take-and-restore keep their positions
+            self.assertIn('ReadIniIfExists("VC Mods", "NpcAnims", &bVCModPlayerNpcAnims);', INI)
+            self.assertIn('ReadIniIfExists("VC Mods", "AnimChoice", &nVCModAnimChoice);', INI)
+            chase = (ROOT / "src/extras/vcmodchase.cpp").read_text()
+            self.assertIn("bVCModChasePreNpcAnims = bVCModPlayerNpcAnims;", chase)
+            self.assertIn("bVCModPlayerNpcAnims = bVCModChasePreNpcAnims;", chase)
+
+
+if __name__ == "__main__":
+    unittest.main()
