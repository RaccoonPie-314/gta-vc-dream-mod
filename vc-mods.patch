diff --git a/src/extras/vcmodreload.cpp b/src/extras/vcmodreload.cpp
new file mode 100644
index 0000000..eaa17d9
--- /dev/null
+++ b/src/extras/vcmodreload.cpp
@@ -0,0 +1,59 @@
+#include "common.h"
+
+#include "vcmodreload.h"
+
+#include "ControllerConfig.h"
+#include "Pad.h"
+#include "PlayerInfo.h"
+#include "PlayerPed.h"
+#include "Weapon.h"
+#include "WeaponInfo.h"
+#include "vcmodkeys.h"
+
+bool bVCModManualReload = true;
+
+bool
+VCModReloadNeeded(int32 ammoInClip, int32 ammoTotal, int32 clipSize)
+{
+	if (ammoTotal <= 0 || clipSize <= 0)
+		return false;
+	return ammoInClip < Min(clipSize, ammoTotal);
+}
+
+void
+VCModManualReloadTick(CPlayerInfo *info)
+{
+	if (!bVCModManualReload)
+		return;
+
+	CPlayerPed *ped = info->m_pPed;
+	if (ped == nil || ped->DyingOrDead() || ped->bInVehicle)
+		return;
+
+	CWeapon *weapon = ped->GetWeapon();
+	if (weapon == nil)
+		return;
+
+	CWeaponInfo *weaponInfo = CWeaponInfo::GetWeaponInfo(weapon->m_eWeaponType);
+	if (weaponInfo == nil || weaponInfo->m_eWeaponFire == WEAPON_FIRE_MELEE)
+		return;
+
+	// a reload already in flight owns the animation; firing and the out-of-ammo
+	// states answer to their own code
+	if (weapon->m_eWeaponState != WEAPONSTATE_READY && weapon->m_eWeaponState != WEAPONSTATE_FIRING)
+		return;
+
+	if (VCModKeyCapturing())
+		return;
+
+	if (!ControlsManager.GetIsKeyboardKeyJustDown((RsKeyCodes)aVCModKeys[VCKEY_RELOAD]))
+		return;
+
+	if (!VCModReloadNeeded(weapon->m_nAmmoInClip, weapon->m_nAmmoTotal,
+			weaponInfo->m_nAmountofAmmunition))
+		return;
+
+	ped->StartReloadNow();
+	debug("vcm: manual reload: clip %d, total %d\n",
+		weapon->m_nAmmoInClip, weapon->m_nAmmoTotal);
+}
