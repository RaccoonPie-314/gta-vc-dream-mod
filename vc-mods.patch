+#!/usr/bin/env python3
+"""FBI siren lights: neither FBI model carries a roof bar, so the pack lights
+them with one lamp inside the cabin, visible through the rear window while the
+car faces away. The positions are the pack's own, ported from its fork."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+MOD_H = ROOT / "src/extras/vcmodfbilights.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class FBILightsTests(unittest.TestCase):
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+
+        self.assertIn('"FBI LIGHT BARS"', rows)
+        self.assertIn("&bVCModFBILights", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "FbiLights"', INI.read_text())
+        self.assertIn("extern bool bVCModFBILights;", MOD_H.read_text())
+
+    def test_siren_group(self):
+        auto = AUTO.read_text()
+        self.assertIn('#include "vcmodfbilights.h"', auto)
+
+        siren = braced(auto, "// Siren and taxi lights")
+        for model in ("MI_FBICAR", "MI_FBIRANCH", "MI_VICECHEE"):
+            self.assertIn("case %s:" % model, siren)
+
+    def test_stock_paths_with_the_toggle_off(self):
+        siren = braced(AUTO.read_text(), "// Siren and taxi lights")
+        # toggle off: the Rancher and the Cheetah keep their stub, the FBI Car
+        # stays dark
+        self.assertIn("(model == MI_VICECHEE || model == MI_FBIRANCH) && !bVCModFBILights", siren)
+        self.assertIn("if(model == MI_FBICAR && !bVCModFBILights)", siren)
+
+    def test_bar_effect_reused_at_each_seat(self):
+        siren = braced(AUTO.read_text(), "// Siren and taxi lights")
+        # all three are one lamp in the cabin: the same stock bar effect with
+        # both ends in the same place
+        self.assertIn("pos1 = pos2 = CVector(0.71f, 1.1f, 0.6f);", siren)
+        self.assertIn("pos1 = pos2 = CVector(0.54f, 0.74f, 0.36f);", siren)
+        self.assertIn("pos1 = pos2 = CVector(0.4f, 0.6f, 0.3f);", siren)
+        # they run the shared bar loop, point light included
+        self.assertIn("(uintptr)this + 21 + i", siren)
+        self.assertIn("CPointLights::AddLight(CPointLights::LIGHT_POINT", siren)
+
+    def test_police_bar_matches_the_roof_blocks(self):
+        # the stock bar blocks sit within ±0.31 and reach z 0.95
+        siren = braced(AUTO.read_text(), "// Siren and taxi lights")
+        station = siren.index("case MI_POLICE:", siren.rindex("switch(GetModelIndex()){"))
+        case = siren[station:siren.index("break;", station)]
+        self.assertIn("CVector(0.3f,  -0.55f, 0.97f)", case)
+        self.assertIn("CVector(-0.3f, -0.55f, 0.97f)", case)
+
+
+if __name__ == "__main__":
+    unittest.main()
