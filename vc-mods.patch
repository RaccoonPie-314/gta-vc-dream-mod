+#!/usr/bin/env python3
+"""Pure chase-mission logic, brace-extracted from vcmodchase.cpp and run
+against C++98 stubs. Mirrors the shape of test_vc_driver.py."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+SRC = pathlib.Path(__file__).resolve().parents[1] / "src/extras/vcmodchase.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+#include <math.h>
+typedef int int32;
+typedef short int16;
+typedef unsigned int uint32;
+#define MI_VICE1 100
+#define VCMOD_CHASE_LEASH 220.0f
+#define VCMOD_CHASE_LEASH_TIME 3000
+#define VCMOD_CHASE_ROPE_BOTTOM 0.98f
+#define VCMOD_CHASE_AIR_CRASH_HEALTH 350.0f
+#define VCMOD_CHASE_AIR_SHOOT_MAX 12000
+struct CVector {
+    float x, y, z;
+    CVector() : x(0), y(0), z(0) {}
+    CVector(float a, float b, float c) : x(a), y(b), z(c) {}
+    CVector operator-(const CVector &o) const { return CVector(x-o.x, y-o.y, z-o.z); }
+    float Magnitude2D() const { return (float)sqrt((double)(x*x + y*y)); }
+};
+static float Abs(float f) { return f < 0.0f ? -f : f; }
+enum eVCModChaseState { VCMOD_CHASE_OFF, VCMOD_CHASE_TIER_SELECT, VCMOD_CHASE_BRIEFING, VCMOD_CHASE_RUNNING };
+enum eVCModChaseEvent { VCMOD_CHASE_EV_ENTER_MARKER, VCMOD_CHASE_EV_CONFIRM, VCMOD_CHASE_EV_CANCEL, VCMOD_CHASE_EV_FINISH };
+enum eVCModChaseUnit { VCMOD_UNIT_NONE, VCMOD_UNIT_COP, VCMOD_UNIT_SWAT, VCMOD_UNIT_VICE, VCMOD_UNIT_FBI, VCMOD_UNIT_ARMY };
+enum eVCModChaseCrime { VCMOD_CRIME_STORE, VCMOD_CRIME_JEWELRY, VCMOD_CRIME_PROTECTION, VCMOD_CRIME_BANK, VCMOD_CRIME_DRUG_PLANE };
+enum eCopType { COP_STREET = 0, COP_FBI = 1, COP_SWAT = 2, COP_HELI_SWAT = 3, COP_ARMY = 4, COP_MIAMIVICE = 5 };
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    eVCModChaseState s;
+
+    s = VCMOD_CHASE_OFF;
+    CHECK(VCModChaseNextState(&s, VCMOD_CHASE_EV_ENTER_MARKER) && s == VCMOD_CHASE_TIER_SELECT,
+          "marker enters tier select");
+    s = VCMOD_CHASE_TIER_SELECT;
+    CHECK(!VCModChaseNextState(&s, VCMOD_CHASE_EV_ENTER_MARKER) && s == VCMOD_CHASE_TIER_SELECT,
+          "marker is ignored while selecting");
+    s = VCMOD_CHASE_TIER_SELECT;
+    CHECK(VCModChaseNextState(&s, VCMOD_CHASE_EV_CANCEL) && s == VCMOD_CHASE_OFF,
+          "cancel leaves tier select");
+    s = VCMOD_CHASE_TIER_SELECT;
+    CHECK(VCModChaseNextState(&s, VCMOD_CHASE_EV_CONFIRM) && s == VCMOD_CHASE_BRIEFING,
+          "confirm opens the briefing");
+    s = VCMOD_CHASE_BRIEFING;
+    CHECK(VCModChaseNextState(&s, VCMOD_CHASE_EV_CONFIRM) && s == VCMOD_CHASE_RUNNING,
+          "confirm starts the run");
+    s = VCMOD_CHASE_RUNNING;
+    CHECK(VCModChaseNextState(&s, VCMOD_CHASE_EV_FINISH) && s == VCMOD_CHASE_OFF,
+          "finish returns to off");
+    s = VCMOD_CHASE_RUNNING;
+    CHECK(VCModChaseNextState(&s, VCMOD_CHASE_EV_CANCEL) && s == VCMOD_CHASE_OFF,
+          "cancel ends the run");
+    s = VCMOD_CHASE_OFF;
+    CHECK(!VCModChaseNextState(&s, VCMOD_CHASE_EV_FINISH) && s == VCMOD_CHASE_OFF,
+          "finish is ignored when off");
+
+    CHECK(VCModChaseUnitForTier(1) == VCMOD_UNIT_COP, "tier 1 is COP");
+    CHECK(VCModChaseUnitForTier(2) == VCMOD_UNIT_SWAT, "tier 2 is SWAT");
+    CHECK(VCModChaseUnitForTier(3) == VCMOD_UNIT_VICE, "tier 3 is VICE");
+    CHECK(VCModChaseUnitForTier(4) == VCMOD_UNIT_FBI, "tier 4 is FBI");
+    CHECK(VCModChaseUnitForTier(5) == VCMOD_UNIT_ARMY, "tier 5 is ARMY");
+    CHECK(VCModChaseUnitForTier(0) == VCMOD_UNIT_NONE, "tier 0 is none");
+    CHECK(VCModChaseUnitForTier(6) == VCMOD_UNIT_NONE, "tier 6 is none");
+
+    CHECK(VCModChaseViceModel(0) == 100, "vice variant 1 is the base model");
+    CHECK(VCModChaseViceModel(7) == 107, "vice variant 8 is the last model");
+    CHECK(VCModChaseViceModel(-1) == 100, "vice variant clamps low");
+    CHECK(VCModChaseViceModel(8) == 107, "vice variant clamps high");
+
+    CHECK(VCModChaseTierAllowed(1, 1), "rank 1 allows tier 1");
+    CHECK(VCModChaseTierAllowed(2, 2), "rank 2 allows tier 2");
+    CHECK(VCModChaseTierAllowed(3, 3), "rank 3 allows tier 3");
+    CHECK(!VCModChaseTierAllowed(4, 3), "rank 3 denies tier 4");
+    CHECK(VCModChaseTierAllowed(5, 5), "rank 5 allows tier 5");
+    CHECK(!VCModChaseTierAllowed(0, 5), "tier 0 is never allowed");
+    CHECK(!VCModChaseTierAllowed(6, 5), "tier 6 is never allowed");
+
+    CHECK(VCModChaseRestoreDue(true, true, true), "restore when pending and in control");
+    CHECK(!VCModChaseRestoreDue(true, false, true), "no restore out of control");
+    CHECK(!VCModChaseRestoreDue(true, true, false), "no restore without a player");
+    CHECK(!VCModChaseRestoreDue(false, true, true), "no restore when not pending");
+
+    CHECK(VCModChaseShouldShowMarker(VCMOD_CHASE_OFF, true), "marker shows when off");
+    CHECK(!VCModChaseShouldShowMarker(VCMOD_CHASE_OFF, false), "no marker without a spot");
+    CHECK(!VCModChaseShouldShowMarker(VCMOD_CHASE_TIER_SELECT, true), "no marker while selecting");
+
+    CHECK(!VCModChaseHasEscaped(100.0f, 0, 5000), "no escape inside the leash");
+    CHECK(!VCModChaseHasEscaped(300.0f, 1000, 2000), "no escape before the timer");
+    CHECK(VCModChaseHasEscaped(300.0f, 1000, 5000), "escape after the timer");
+    CHECK(!VCModChaseHasEscaped(300.0f, 0, 9999), "no escape without a start time");
+
+    CHECK(VCModChaseLeaderPressured(10.0f, true), "pressure inside 25 m with sight");
+    CHECK(!VCModChaseLeaderPressured(10.0f, false), "no pressure without sight");
+    CHECK(!VCModChaseLeaderPressured(40.0f, true), "no pressure beyond 25 m");
+
+    CHECK(VCModChaseCrimeForTier(1) == VCMOD_CRIME_STORE, "tier 1 is a store till");
+    CHECK(VCModChaseCrimeForTier(2) == VCMOD_CRIME_JEWELRY, "tier 2 is a jewelry grab");
+    CHECK(VCModChaseCrimeForTier(3) == VCMOD_CRIME_PROTECTION, "tier 3 is a protection round");
+    CHECK(VCModChaseCrimeForTier(4) == VCMOD_CRIME_BANK, "tier 4 is a bank job");
+    CHECK(VCModChaseCrimeForTier(5) == VCMOD_CRIME_DRUG_PLANE, "tier 5 is the drug plane");
+    CHECK(VCModChaseCrimeForTier(0) == VCMOD_CRIME_STORE, "tier 0 falls back to the store");
+    CHECK(VCModChaseCrimeName(VCMOD_CRIME_BANK) && VCModChaseCrimeName(VCMOD_CRIME_BANK)[0], "the bank has a name");
+    CHECK(VCModChaseCrimeDispatch(VCMOD_CRIME_BANK) && VCModChaseCrimeDispatch(VCMOD_CRIME_BANK)[0], "the bank has a dispatch line");
+
+    CHECK(VCModChaseCrimeThreat(VCMOD_CRIME_STORE) == 1, "the store is a light job");
+    CHECK(VCModChaseCrimeThreat(VCMOD_CRIME_BANK) == 4, "the bank is a heavy job");
+    CHECK(VCModChaseCrimeThreat(VCMOD_CRIME_DRUG_PLANE) == 5, "the plane is the heaviest job");
+    CHECK(VCModChaseCrimeThreat((eVCModChaseCrime)99) == 1, "an unknown crime clamps low");
+    CHECK(VCModChaseThreat(2, 4) == 4, "a heavy crime raises a light response");
+    CHECK(VCModChaseThreat(4, 2) == 4, "the picked unit keeps its own floor");
+    CHECK(VCModChaseThreat(3, 3) == 3, "matching weights stay put");
+
+    CHECK(VCModChaseSquadForThreat(1, 1, 4, true) == 1, "patrol rides as a pair");
+    CHECK(VCModChaseSquadForThreat(1, 1, 2, true) == 1, "patrol fits a two seater");
+    CHECK(VCModChaseSquadForThreat(2, 2, 4, true) == 3, "swat fills the enforcer around the player");
+    CHECK(VCModChaseSquadForThreat(2, 2, 4, false) == 4, "backup fills the whole car with no player");
+    CHECK(VCModChaseSquadForThreat(2, 6, 4, false) == 4, "backup caps at the car");
+    CHECK(VCModChaseSquadForThreat(3, 2, 2, true) == 1, "vice rides as a pair");
+    CHECK(VCModChaseSquadForThreat(3, 2, 2, false) == 2, "vice backup rides as a pair too");
+    CHECK(VCModChaseSquadForThreat(4, 2, 4, true) == 3, "fbi fills the rancher");
+    CHECK(VCModChaseSquadForThreat(5, 2, 6, false) == 6, "army backup fills a larger ride");
+    CHECK(VCModChaseSquadForThreat(5, 2, 1, true) == 0, "a one seater leaves no seat for a partner");
+    CHECK(VCModChaseSquadForThreat(0, 0, 4, true) == 1, "threat clamps low");
+
+    CHECK(VCModChaseRopeProgress(0.5f, 0.005f, 1.0f, true) < 0.5f, "climbing moves toward the top");
+    CHECK(VCModChaseRopeProgress(0.5f, 0.005f, 1.0f, false) > 0.5f, "dropping moves toward the ground");
+    CHECK(VCModChaseRopeProgress(0.001f, 0.005f, 1.0f, true) == 0.0f, "the top is clamped");
+    CHECK(VCModChaseRopeProgress(0.979f, 0.005f, 1.0f, false) == 0.98f, "the ground end is clamped");
+    CHECK(VCModChaseRopeProgress(0.5f, 0.005f, 2.0f, true) < VCModChaseRopeProgress(0.5f, 0.005f, 1.0f, true),
+          "a longer frame climbs more");
+
+    CHECK(VCModChaseAirWrecked(300.0f, 1000), "a shot-up car is wrecked");
+    CHECK(VCModChaseAirWrecked(900.0f, 13000), "a long burst ends the chase anyway");
+    CHECK(!VCModChaseAirWrecked(900.0f, 5000), "a healthy car keeps running");
+
+    CHECK(VCModChaseAirSquad(1) == 1, "the patrol air start keeps its single partner");
+    CHECK(VCModChaseAirSquad(2) == 2, "swat air start carries a pair");
+    CHECK(VCModChaseAirSquad(5) == 2, "the army air start carries a pair");
+
+    // design 6.7: active / reserve per rank, crew excludes the leader
+    int32 sa, sr, ca, cr;
+    VCModChasePoolForTier(1, &sa, &sr, &ca, &cr);
+    CHECK(sa == 2 && sr == 0 && ca == 0 && cr == 0, "tier 1 rides as a pair with nothing behind it");
+    VCModChasePoolForTier(2, &sa, &sr, &ca, &cr);
+    CHECK(sa == 2 && sr == 2 && ca == 1 && cr == 2, "tier 2 is two plus two on both sides");
+    VCModChasePoolForTier(3, &sa, &sr, &ca, &cr);
+    CHECK(sa == 4 && sr == 4 && ca == 4 && cr == 4, "tier 3 is four plus four");
+    VCModChasePoolForTier(4, &sa, &sr, &ca, &cr);
+    CHECK(sa == 5 && sr == 5 && ca == 5 && cr == 5, "tier 4 is five plus five");
+    VCModChasePoolForTier(5, &sa, &sr, &ca, &cr);
+    CHECK(sa == 6 && sr == 6 && ca == 6 && cr == 6, "tier 5 is six plus six");
+    VCModChasePoolForTier(0, &sa, &sr, &ca, &cr);
+    CHECK(sa == 0 && sr == 0 && ca == 0 && cr == 0, "tier 0 has no pools");
+    VCModChasePoolForTier(6, &sa, &sr, &ca, &cr);
+    CHECK(sa == 0 && sr == 0 && ca == 0 && cr == 0, "a tier past the table has no pools");
+    VCModChasePoolForTier(2, 0, 0, 0, 0);
+    CHECK(1, "the pool table tolerates an unused out-parameter");
+
+    CHECK(!VCModChaseReplaceDue(2, 2, 2, 0, 5000, 9000), "no loss, no replacement");
+    CHECK(!VCModChaseReplaceDue(1, 2, 0, 1000, 5000, 9000), "an empty reserve draws nothing");
+    CHECK(!VCModChaseReplaceDue(1, 2, 2, 1000, 5000, 4000), "the refill waits for its delay");
+    CHECK(VCModChaseReplaceDue(1, 2, 2, 1000, 5000, 6000), "a loss refills after the delay");
+    CHECK(!VCModChaseReplaceDue(2, 2, 2, 1000, 5000, 6000), "a filled slot draws nothing");
+
+    CHECK(VCModChaseCrewSize(1) == 1, "tier 1 crew is the leader alone");
+    CHECK(VCModChaseCrewSize(2) == 2, "tier 2 crew is the leader and the pickup");
+    CHECK(VCModChaseCrewSize(3) == 5, "tier 3 crew is the leader plus four");
+    CHECK(VCModChaseCrewSize(5) == 7, "tier 5 crew is the leader plus six");
+
+    // AddPed(PEDTYPE_COP, ...) takes an eCopType, not a model index; a model index
+    // (vice = 100 here) is out of range and leaves the ped with model -1.
+    CHECK(VCModChaseCopType(VCMOD_UNIT_COP) == COP_STREET, "the patrol spawns a street cop");
+    CHECK(VCModChaseCopType(VCMOD_UNIT_SWAT) == COP_SWAT, "swat spawns a swat cop");
+    CHECK(VCModChaseCopType(VCMOD_UNIT_VICE) == COP_MIAMIVICE, "vice spawns a miami vice cop, not a model index");
+    CHECK(VCModChaseCopType(VCMOD_UNIT_FBI) == COP_FBI, "fbi spawns an fbi cop");
+    CHECK(VCModChaseCopType(VCMOD_UNIT_ARMY) == COP_ARMY, "army spawns an army cop");
+    CHECK(VCModChaseCopType(VCMOD_UNIT_NONE) == COP_STREET, "an unknown unit falls back to a street cop");
+    CHECK(VCModChaseCopType(VCMOD_UNIT_VICE) <= 5, "the cop type stays inside the eCopType range");
+
+    return failed ? 1 : 0;
+}
+'''
+
+
+def cut(name):
+    text = SRC.read_text()
+    match = re.search(r"((?:[A-Za-z_][A-Za-z0-9_]*[\s*]+)+)" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {SRC}")
+    start = match.end() - 1
+    depth = 0
+    for i in range(start, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[match.start():i + 1]
+    raise AssertionError(f"unbalanced braces in {name}")
+
+
+def source():
+    return PRELUDE + "\n".join(cut(n) for n in (
+        "VCModChaseNextState",
+        "VCModChaseUnitForTier",
+        "VCModChaseCopType",
+        "VCModChaseCrimeForTier",
+        "VCModChaseCrimeName",
+        "VCModChaseCrimeDispatch",
+        "VCModChaseCrimeThreat",
+        "VCModChaseThreat",
+        "VCModChaseViceModel",
+        "VCModChaseTierAllowed",
+        "VCModChaseHasEscaped",
+        "VCModChaseLeaderPressured",
+        "VCModChaseSquadForThreat",
+        "VCModChasePoolForTier",
+        "VCModChaseReplaceDue",
+        "VCModChaseCrewSize",
+        "VCModChaseRestoreDue",
+        "VCModChaseShouldShowMarker",
+        "VCModChaseRopeProgress",
+        "VCModChaseAirWrecked",
+        "VCModChaseAirSquad",
+    )) + MAIN
+
+
+class ChaseTests(unittest.TestCase):
+    def test_pure_core(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "chase"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source(), text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+
+if __name__ == "__main__":
+    unittest.main()
