+#!/usr/bin/env python3
+"""Passenger-mode tests: the ride state machine out of PlayerPed.cpp and the
+destination list out of vcmodpanel.cpp, compiled against small engine stubs."""
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+PANEL = (ROOT / "src/extras/vcmodpanel.cpp").read_text()
+PLAYER = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+HEAD = (ROOT / "src/extras/vcmodpanel.h").read_text()
+INI = (ROOT / "src/core/re3.cpp").read_text()
+ZONES = (ROOT / "src/core/Zones.h").read_text()
