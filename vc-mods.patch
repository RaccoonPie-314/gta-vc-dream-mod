+#!/usr/bin/env python3
+"""Debug vehicle spawner: the panel lists every car model by name and a pick
+queues a spawn that the update pass performs."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+MOD = ROOT / "src/extras/vcmodspawn.cpp"
+MOD_H = ROOT / "src/extras/vcmodspawn.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+GAME = ROOT / "src/core/Game.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class SpawnTests(unittest.TestCase):
+    def test_lists_cars_sorted(self):
+        mod = MOD.read_text()
+        self.assertIn('m_vehicleType != VEHICLE_TYPE_CAR', mod)
+        # sorted by the IDE name so the list scrolls by name
+        self.assertIn("strcmp(((CBaseModelInfo*)CModelInfo::GetModelInfo(aVCModSpawnModels[j-1]))->GetModelName()", mod)
+        # the Cheetah is the one the owner could not find
+        self.assertIn('{ "vicechee", "Vice Cheetah" }', mod)
+
+    def test_pick_is_deferred(self):
+        mod = MOD.read_text()
+        pick = braced(mod, "VCModSpawnPick(int32 entry)")
+        self.assertIn("nVCModSpawnPending = aVCModSpawnModels[entry];", pick)
+        # nothing streams or allocates from the pick, which runs inside a render
+        self.assertNotIn("RequestModel", pick)
+        self.assertNotIn("new CAutomobile", pick)
+
+        tick = braced(mod, "VCModSpawnTick(void)")
+        for call in ("CStreaming::RequestModel", "CStreaming::HasModelLoaded",
+                     "new CAutomobile", "car->PlaceOnRoadProperly()", "CWorld::Add(car)"):
+            self.assertIn(call, tick)
+        self.assertIn("VCModSpawnTick();", GAME.read_text())
+
+    def test_panel_row_and_list(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        self.assertIn('"SPAWN VEHICLE"', rows)
+        self.assertIn("VCMOD_ROW_SPAWN", rows)
+        self.assertIn("case VCMOD_ROW_SPAWN:\t\treturn VCMOD_LIST_SPAWN;", panel)
+        self.assertIn("case VCMOD_LIST_SPAWN:\t\treturn VCModSpawnCount();", panel)
+        self.assertIn("return VCModSpawnName(entry);", panel)
+        self.assertIn("VCModSpawnPick(entry);", panel)
+        # the row opens a list like the ride destination row does
+        click = braced(panel, "switch (def->kind)")
+        self.assertIn("case VCMOD_ROW_SPAWN: {", click)
+        self.assertIn("int32 VCModSpawnCount(void);", MOD_H.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
