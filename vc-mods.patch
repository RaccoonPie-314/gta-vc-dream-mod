@@ -0,0 +1,226 @@
+#!/usr/bin/env python3
+"""Street-idle wander escalation: the handover to the engine's pedestrian walk.
+
+Drives the mod-owned decision helpers extracted from PlayerPed.cpp against a
+stub ped and pad. The walk itself is the engine's SetWanderPath/WanderPath (the
+same call the Vercetti crew uses), so it is stubbed here, not re-tested.
+"""
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+STREET = (ROOT / "src/extras/vcmodstreet.cpp").read_text()
+
+STUBS = r'''
+#include <cstdio>
+#include <cstdint>
+#include <algorithm>
+#include <string>
+#include <vector>
+#define nil NULL
+typedef int8_t int8;
+typedef uint8_t uint8;
+typedef int16_t int16;
+typedef uint16_t uint16;
+typedef int32_t int32;
+typedef uint32_t uint32;
+
+std::vector<std::string> events;
+
+enum { PED_IDLE, PED_WANDER_PATH, PED_CHAT, PED_DIE, PED_DEAD, PED_ARRESTED, PED_DRIVING };
+enum {
+    VCMOD_CHATBREAK_DEAD     = 1 << 0,
+    VCMOD_CHATBREAK_IN_CAR   = 1 << 1,
+    VCMOD_CHATBREAK_CONTROLS = 1 << 2,
+    VCMOD_CHATBREAK_INPUT    = 1 << 3,
+    VCMOD_CHATBREAK_ACTION   = 1 << 4,
+    VCMOD_CHATBREAK_DUCK     = 1 << 5,
+    VCMOD_CHATBREAK_STATE    = 1 << 6,
+    VCMOD_CHATBREAK_PARTNER  = 1 << 7
+};
+
+struct CGeneral { static int GetRandomNumber(void) { return 3; } };
+
+struct CPad {
+    bool controlsDisabled;
+    int walkX, walkY;
+    bool jump, weapon, target;
+    CPad() : controlsDisabled(false), walkX(0), walkY(0),
+             jump(false), weapon(false), target(false) {}
+    bool ArePlayerControlsDisabled(void) { return controlsDisabled; }
+    int GetPedWalkLeftRight(void) { return walkX; }
+    int GetPedWalkUpDown(void) { return walkY; }
+    bool JumpJustDown(void) { return jump; }
+    int GetWeapon(void) { return weapon ? 1 : 0; }
+    bool GetTarget(void) { return target; }
+};
+
+// set by a test to make the engine's wander handover succeed or fall back
+bool g_wanderSuccess = true;
+
+struct CTimer { static uint32 GetTimeInMilliseconds(void) { return 1000; } };
+
+struct CPlayerPed {
+    int m_nPedState;
+    bool bInVehicle, bIsDucking, bDead, bIsRunning;
+    int m_nMoveState, m_nStoredMoveState;
+    uint32 m_leaveCarTimer;
+    int32 m_nPathDir;
+    CPlayerPed() : m_nPedState(PED_IDLE), bInVehicle(false),
+                   bIsDucking(false), bDead(false), m_leaveCarTimer(0),
+                   m_nPathDir(0) {}
+    bool DyingOrDead(void) { return bDead; }
+    void SetIdle(void) { m_nPedState = PED_IDLE; events.push_back("idle"); }
+    bool SetWanderPath(int) {
+        events.push_back("wander");
+        if (g_wanderSuccess) m_nPedState = PED_WANDER_PATH;
+        return g_wanderSuccess;
+    }
+};
+
+static bool bVCModStreetWander;
+static uint32 nVCModStreetStillSince = 12345;
+static uint32 nVCModStreetNextGesture = 999;
+
+static float fVCModNpcStrollSpeed;
+void VCModNpcResetStroll(void) {}
+static void VCModStreetFadeGesture(CPlayerPed *) { events.push_back("fadeGesture"); }
+static void VCModStreetFadeScratch(CPlayerPed *) { events.push_back("fadeScratch"); }
+static void VCModStreetFadeCrossLook(CPlayerPed *) { events.push_back("fadeCrossLook"); }
+'''
+
+SIGS = [
+    "bool\nVCModStreetWanderOwnsPlayer(void)",
+    "static int32\nVCModStreetWanderBreak(CPlayerPed *player, CPad *pad)",
+    "void\nVCModStreetEndWander(CPlayerPed *player, const char *why)",
+    "void\nVCModStreetStartWander(CPlayerPed *player)",
+]
+
+
+def wander_source():
+    return STUBS + "\n".join(braced(STREET, s) for s in SIGS) + "\n"
+
+
+def has(events_vec, name):
+    return f'(std::find({events_vec}.begin(), {events_vec}.end(), "{name}") != {events_vec}.end())'
+
+
+class OwnershipTests(unittest.TestCase):
+    def test_owns_player_tracks_the_flag(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    bVCModStreetWander = false;
+    if (VCModStreetWanderOwnsPlayer()) return 1;
+    bVCModStreetWander = true;
+    if (!VCModStreetWanderOwnsPlayer()) return 2;
+    return 0;
+}
+''')
+
+
+class StartTests(unittest.TestCase):
+    def test_start_hands_over_and_fades_the_poses(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    CPlayerPed p; CPad pad;
+    g_wanderSuccess = true;
+    VCModStreetStartWander(&p);
+    if (!bVCModStreetWander) return 1;
+    if (p.m_nPedState != PED_WANDER_PATH) return 2;
+    if (!''' + has("events", "wander") + r''') return 3;
+    if (!''' + has("events", "fadeGesture") + r''') return 4;
+    if (!''' + has("events", "fadeScratch") + r''') return 5;
+    if (!''' + has("events", "fadeCrossLook") + r''') return 6;
+    return 0;
+}
+''')
+
+    def test_start_with_no_path_keeps_posing(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    CPlayerPed p; CPad pad;
+    g_wanderSuccess = false;
+    VCModStreetStartWander(&p);
+    if (bVCModStreetWander) return 1;
+    if (p.m_nPedState != PED_IDLE) return 2;
+    return 0;
+}
+''')
+
+
+class BreakTests(unittest.TestCase):
+    def test_a_quiet_wander_does_not_break(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    CPlayerPed p; CPad pad;
+    p.m_nPedState = PED_WANDER_PATH;
+    if (VCModStreetWanderBreak(&p, &pad) != 0) return 1;
+    p.m_nPedState = PED_IDLE;   // a dead-end node drops him here for a frame
+    if (VCModStreetWanderBreak(&p, &pad) != 0) return 2;
+    return 0;
+}
+''')
+
+    def test_each_refusal_names_its_bit(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    CPlayerPed p; CPad pad;
+    p.m_nPedState = PED_WANDER_PATH;
+    pad.walkX = 5;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_INPUT)) return 1;
+    pad.walkX = 0; pad.walkY = -5;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_INPUT)) return 2;
+    pad.walkY = 0; pad.controlsDisabled = true;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_CONTROLS)) return 3;
+    pad.controlsDisabled = false; pad.jump = true;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_ACTION)) return 4;
+    pad.jump = false; pad.weapon = true;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_ACTION)) return 5;
+    pad.weapon = false; p.bIsDucking = true;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_DUCK)) return 6;
+    p.bIsDucking = false; p.bInVehicle = true;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_IN_CAR)) return 7;
+    p.bInVehicle = false; p.bDead = true;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_DEAD)) return 8;
+    p.bDead = false; p.m_nPedState = PED_ARRESTED;
+    if (!(VCModStreetWanderBreak(&p, &pad) & VCMOD_CHATBREAK_STATE)) return 9;
+    return 0;
+}
+''')
+
+
+class EndTests(unittest.TestCase):
+    def test_end_from_wander_idles_and_resets_the_clock(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    CPlayerPed p;
+    p.m_nPedState = PED_WANDER_PATH;
+    bVCModStreetWander = true;
+    VCModStreetEndWander(&p, "walked off");
+    if (bVCModStreetWander) return 1;
+    if (p.m_nPedState != PED_IDLE) return 2;
+    if (nVCModStreetStillSince != 0) return 3;
+    if (nVCModStreetNextGesture != 0) return 4;
+    if (!''' + has("events", "idle") + r''') return 5;
+    return 0;
+}
+''')
+
+    def test_end_from_idle_does_not_re_idle(self):
+        run_cpp(wander_source() + r'''
+int main(void) {
+    CPlayerPed p;
+    p.m_nPedState = PED_IDLE;
+    bVCModStreetWander = true;
+    VCModStreetEndWander(&p, "no path");
+    if (bVCModStreetWander) return 1;
+    if (''' + has("events", "idle") + r''') return 2;
+    return 0;
+}
+''')
+
+
+if __name__ == "__main__":
+    unittest.main()
