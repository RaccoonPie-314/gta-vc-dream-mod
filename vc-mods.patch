+        self.assertIn("m_pedIK.m_flags &= ~CPedIK::AIMS_WITH_ARM", aim_gun)
+
+    def test_lock_on_turns_the_body(self):
+        # the clip owns the thighs (children of the spine), so the body has to turn
+        # on the target at the idle stare rate instead of leaving a torso twist
+        track = braced(PLAYER.read_text(), "CPlayerPed::RotatePlayerToTrackTarget(void)")
+        self.assertIn("VCModCopTwoHandPose(this, info)", track)
+        self.assertIn("neededTurn * 0.2f", track)
+        # no strafe rides the facing: while walking, the aim turn must stand down
+        # or every input becomes "forward"
+        self.assertIn("m_nMoveState == PEDMOVE_WALK || m_nMoveState == PEDMOVE_RUN", track)
+        self.assertLess(track.index("VCModCopTwoHandPose(this, info)"),
+                        track.index("m_fMoveSpeed > 0.1f"))
+        self.assertIn("m_fRotationDest = limitedLookDir", track)
+        # arm-IK weapons still leave the body on the camera
+        self.assertIn("if (info->IsFlagSet(WEAPONFLAG_CANAIM_WITHARM))", track)
+
+    def test_firing_does_not_strip_the_cop_stance(self):
+        text = PEDFIGHT.read_text()
+        attack = braced(text, "CPed::SetAttack(CEntity *victim)")
+        self.assertNotIn("VCModCopUpperBody(this, animAssoc)", attack)
+        self.assertIn("VCModCopSetStance(this, animAssoc, true)", attack)
