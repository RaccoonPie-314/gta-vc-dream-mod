+bool
+CPed::IsOnStealWishList(SCivilianAIState& state, int32 model)
+{
+	for (int i = 0; i < ARRAY_SIZE(state.m_nStealWishList); i++) {
+		if (model == state.m_nStealWishList[i]) {
+			return true;
+		}
+	}
+	return false;
+}
