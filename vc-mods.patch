+
+
+#define VCMOD_CHASE_SWAP_CAR			MI_CHEETAH
+#define VCMOD_CHASE_ACCOMPLICE_MODEL	MI_HMYST	// smartly dressed male, fits the crew
+#define VCMOD_CHASE_SQUAD_MAX			6	// upper bound; the car's seats decide
+// the transport empties only once the chase has ended at this spot: he is on
+// foot, at a staged stop, or cornered. A car that is merely slow is still
+// leaving, and bailing out there leaves the team running behind it.
+#define VCMOD_CHASE_DISMOUNT_RANGE		30.0f
+// once the player has left the transport, the squad follows him out from
+// further away rather than sitting in the car while he fights alone
+#define VCMOD_CHASE_DISMOUNT_LEASH		60.0f
+// a car wedged short of a beat never reaches the 7 m arrival radius; after this
+// long at walking pace near it, he is treated as arrived so the chase cannot hang
+#define VCMOD_CHASE_STALL_RANGE			25.0f
+#define VCMOD_CHASE_STALL_TIME			4000
+// move speed is per frame here; 0.02 is under a metre per second
+#define VCMOD_CHASE_STILL_SPEED			0.02f
+// the city thins out for the chase, the way a wanted level clears the roads
+#define VCMOD_CHASE_CAR_DENSITY			0.4f
+#define VCMOD_CHASE_PED_DENSITY			0.5f
+// he pulls to the kerb before the stand instead of braking in the traffic lane
