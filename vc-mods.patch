+static void
+VCModUpdateAdrenaline(CPlayerPed *player)
+{
+	CPad *pad = GetPadFromPlayer(player);
+	bool allowed = player == FindPlayerPed() && bVCModAdrenaline && pad && !pad->ArePlayerControlsDisabled() &&
+		!player->bInVehicle && !player->DyingOrDead() && player->m_nPedState != PED_ARRESTED &&
+		!CCutsceneMgr::IsRunning() && !CReplay::IsPlayingBack();
+	if (!allowed) {
+		if (pVCModAdrenalinePlayer == player)
+			player->ClearAdrenaline();
+		return;
+	}
+
+	if (pVCModAdrenalinePlayer != player) {
+		if (pVCModAdrenalinePlayer)
+			pVCModAdrenalinePlayer->ClearAdrenaline();
+		pVCModAdrenalinePlayer = player;
+		bVCModAdrenalineSlowing = player->m_bAdrenalineActive && CTimer::GetTimeScale() == 1.0f / 3;
+		fVCModAdrenalineRestoreScale = bVCModAdrenalineSlowing ? 1.0f : CTimer::GetTimeScale();
+		player->m_bAdrenalineActive = true;
+		player->m_nAdrenalineTime = CTimer::GetTimeInMilliseconds() + 20000;
+		player->m_fCurrentStamina = player->m_fMaxStamina;
+	}
+
+	if (bVCModAdrenalineSlowMo) {
+		if (!bVCModAdrenalineSlowing || CTimer::GetTimeScale() != 1.0f / 3)
+			fVCModAdrenalineRestoreScale = CTimer::GetTimeScale();
+		CTimer::SetTimeScale(1.0f / 3);
+	} else if (bVCModAdrenalineSlowing && CTimer::GetTimeScale() == 1.0f / 3) {
+		CTimer::SetTimeScale(fVCModAdrenalineRestoreScale);
+	}
+	bVCModAdrenalineSlowing = bVCModAdrenalineSlowMo;
