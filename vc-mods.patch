+#!/usr/bin/env python3
+"""Shared plumbing for the vc-mod harnesses.
+
+Every harness extracts a function out of the mod sources and compiles it against
+small engine stubs. This module owns the three pieces all of them need: the
+brace matcher that cuts a function out of a source file, the compiler step, and
+the engine preamble the extracted code is compiled against.
+
+A harness-specific stub lives in its own test_vc_<feature>.py; only what two or
+more harnesses use belongs here.
+"""
+import subprocess
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+ENGINE_STUBS = r'''
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <sstream>
+#include <string>
+#include <vector>
+#include <stdint.h>
+#define nil NULL
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#define VCMOD_DIAG(...) do { } while (0)
+bool bVCModDiagnostics = false;
+typedef int8_t int8;
+typedef uint8_t uint8;
+typedef int16_t int16;
+typedef uint16_t uint16;
+typedef int32_t int32;
+typedef uint32_t uint32;
+typedef uint16_t wchar;
+std::string to_string(int value) {
+    std::ostringstream out;
+    out << value;
+    return out.str();
+}
+'''
+
+
+def braced(source, marker):
+    """The marker and its balanced brace block, braces included."""
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def run_cpp(source):
+    """Compile one test program with the host C++ compiler and run it."""
+    with tempfile.TemporaryDirectory(prefix="vcmod-test-") as directory:
+        cpp = Path(directory) / "test.cpp"
+        binary = Path(directory) / "test"
+        cpp.write_text(source)
+        # each test compiles only the functions it drives, so some statics are unused
+        build = subprocess.run(["c++", "-std=c++98", "-Wall", "-Wextra", "-Wno-unused-function",
+                                str(cpp), "-o", str(binary)],
+                               capture_output=True, text=True)
+        if build.returncode:
+            print(build.stderr)
+            numbered = "".join(f"{n}: {line}\n" for n, line in enumerate(source.splitlines(), 1))
+            raise RuntimeError("compile failed\n" + numbered)
+        if build.stderr:
+            print(build.stderr)
+        run = subprocess.run([str(binary)], capture_output=True, text=True)
+        if run.returncode:
+            print(run.stdout, run.stderr)
+            raise RuntimeError("test binary failed")
\ No newline at end of file
