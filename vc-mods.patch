+static bool
+IsRelativeGamePath(const char *file)
+{
+	if(file[0] == '\0' || file[0] == '/' || file[0] == '\\')
+		return false;
+	if(((file[0] >= 'a' && file[0] <= 'z') || (file[0] >= 'A' && file[0] <= 'Z')) &&
+	   file[1] == ':')
+		return false;
+	return true;
+}
+
+static bool
+StartsWithMods(const char *file)
+{
+	static const char prefix[] = "mods/";
+	for(int i = 0; i < 5; i++){
+		char c = file[i];
+		if(c >= 'A' && c <= 'Z')
+			c += 'a' - 'A';
+		if(c != prefix[i])
+			return false;
+	}
+	return true;
+}
+
+static bool
+ValidModName(const char *name)
+{
+	if(name[0] == '\0')
+		return false;
+	for(; *name; name++){
+		char c = *name;
+		if(!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+		     (c >= '0' && c <= '9') || c == '_' || c == '-'))
+			return false;
+	}
+	return true;
+}
+
+void
+CFileMgr::LoadMods(void)
+{
+	ms_numMods = 0;
+
+	FILE *file = fcaseopen("mods/mods.ini", "rb");
+	if(file == nil)
+		return;
+
+	char line[128];
+	while(fgets(line, sizeof(line), file)){
+		char *start = line;
+		while(*start == ' ' || *start == '\t')
+			start++;
+		char *end = start + strlen(start);
+		while(end > start && (end[-1] == '\n' || end[-1] == '\r' ||
+		                      end[-1] == ' ' || end[-1] == '\t'))
+			*--end = '\0';
+
+		if(*start == '\0' || *start == '#' || *start == ';' || *start == '[')
+			continue;
+		if(!ValidModName(start))
+			continue;
+		if(ms_numMods >= MAX_MODS){
+			debug("mods.ini: over %d mods, ignoring %s\n", MAX_MODS, start);
+			break;
+		}
+
+		strncpy(ms_modNames[ms_numMods], start, MOD_NAME_SIZE - 1);
+		ms_modNames[ms_numMods][MOD_NAME_SIZE - 1] = '\0';
+		ms_numMods++;
+	}
+
+	fclose(file);
+}
+
+bool
+CFileMgr::FindModFile(const char *file, char *path, size_t pathSize)
+{
+	if(ms_numMods == 0 || !IsRelativeGamePath(file) || StartsWithMods(file))
+		return false;
+
+	char normalized[FILEMGR_PATH_SIZE];
+	size_t length = strlen(file);
+	if(length >= sizeof(normalized))
+		return false;
+	for(size_t i = 0; i <= length; i++)
+		normalized[i] = file[i] == '\\' ? '/' : file[i];
+
+	// later entries in mods.ini win, so walk the list backwards
+	for(int i = ms_numMods - 1; i >= 0; i--){
+		int written = snprintf(path, pathSize, "mods/%s/%s", ms_modNames[i], normalized);
+		if(written < 0 || written >= (int)pathSize)
+			continue;
+		FILE *found = fcaseopen(path, "rb");
+		if(found){
+			fclose(found);
+			return true;
+		}
+	}
+	return false;
+}
+
+bool
+CFileMgr::FindModOverlay(int index, char *path, size_t pathSize)
+{
+	if(index < 0 || index >= ms_numMods)
+		return false;
+
+	int written = snprintf(path, pathSize, "mods/%s/overlay.img", ms_modNames[index]);
+	if(written < 0 || written >= (int)pathSize)
+		return false;
+
+	FILE *found = fcaseopen(path, "rb");
+	if(found == nil)
+		return false;
+	fclose(found);
+	return true;
+}
