@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Vanilla-fix tests: the three pure helpers and the particle lifespan pass out
+of vcmodqol.cpp, plus static checks that each behaviour is wired to its flag.
+Mirrors the shape of test_vc_chase.py."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+QOL = ROOT / "src/extras/vcmodqol.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+HUD = ROOT / "src/renderer/Hud.cpp"
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+PLAYERINFO = ROOT / "src/core/PlayerInfo.cpp"
+PARTICLE = ROOT / "src/renderer/Particle.cpp"
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+#include <stddef.h>
+#include <string.h>
+typedef int int32;
+typedef unsigned int uint32;
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+static void debug(const char *fmt, ...) { (void)fmt; }
+'''
+
+PARTICLE_STUBS = r'''
+enum tParticleType {
+    PARTICLE_BLOOD, PARTICLE_BLOOD_SMALL, PARTICLE_BLOOD_SPURT,
+    PARTICLE_BLOODDROP, PARTICLE_PEDFOOT_DUST, PARTICLE_FIRE
+};
+struct tParticleSystemData { int32 m_nLifeSpan; };
+static struct { tParticleSystemData m_aParticles[6]; } mod_ParticleSystemManager;
+static bool bVCModVanillaFixes = true;
+static bool bVCModLongerFx = true;
+'''
+
+MAIN = r'''
+int main() {
+    char money[16];
+
+    VCModFormatMoney(money, sizeof(money), 0);
+    CHECK(!strcmp(money, "$0"), "zero prints as $0");
+    VCModFormatMoney(money, sizeof(money), 42);
+    CHECK(!strcmp(money, "$42"), "small balance keeps no padding");
+    VCModFormatMoney(money, sizeof(money), 1234567);
+    CHECK(!strcmp(money, "$1234567"), "large balance prints in full");
+    VCModFormatMoney(money, sizeof(money), -42);
+    CHECK(!strcmp(money, "$-42"), "negative balance keeps its magnitude");
+
+    for (int i = 0; i < 6; i++) {
+        CHECK(!VCModWantedSlotVisible(0, 0, i), "no wanted level hides every slot");
+        CHECK(VCModWantedSlotVisible(0, 3, i), "a pending search keeps the row");
+        CHECK(VCModWantedSlotVisible(3, 0, i), "an active level keeps the row");
+    }
+
+    CHECK(!VCModExitHoldElapsed(1000, 601, 400), "just under the threshold");
+    CHECK(VCModExitHoldElapsed(1000, 600, 400), "exactly at the threshold");
+    CHECK(VCModExitHoldElapsed(1000, 500, 400), "past the threshold");
+    CHECK(!VCModExitHoldElapsed(100, 0xFFFFFF00u, 400), "wrapped clock, under");
+    CHECK(VCModExitHoldElapsed(100, 0xFFFFFF00u, 300), "wrapped clock, over");
+
+    mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan = 300;
+    mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOODDROP].m_nLifeSpan = 100;
+    mod_ParticleSystemManager.m_aParticles[PARTICLE_PEDFOOT_DUST].m_nLifeSpan = 50;
+    mod_ParticleSystemManager.m_aParticles[PARTICLE_FIRE].m_nLifeSpan = 70;
+
+    VCModApplyParticleLifetimes();
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan == 600,
+          "blood lifespan doubles");
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOODDROP].m_nLifeSpan == 200,
+          "blooddrop lifespan doubles");
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_PEDFOOT_DUST].m_nLifeSpan == 100,
+          "foot dust lifespan doubles");
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_FIRE].m_nLifeSpan == 70,
+          "unlisted particle types are untouched");
+
+    VCModApplyParticleLifetimes();
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan == 600,
+          "a second apply does not compound");
+
+    bVCModLongerFx = false;
+    VCModRefreshParticleLifetimes();
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan == 300,
+          "turning the sub-flag off restores the raw lifespan");
+    bVCModLongerFx = true;
+    bVCModVanillaFixes = false;
+    VCModRefreshParticleLifetimes();
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan == 300,
+          "the master switch restores the raw lifespan");
+    bVCModVanillaFixes = true;
+    VCModRefreshParticleLifetimes();
+    CHECK(mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan == 600,
+          "turning it back on doubles again");
+
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(name):
+    text = QOL.read_text()
+    match = re.search(r"((?:[A-Za-z_][A-Za-z0-9_]*[\s*]+)+)" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {QOL}")
+    start = match.start()
+    opening = match.end() - 1
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+def particle_source():
+    """The five-type table and its raw lifespans, plus both apply functions."""
+    text = QOL.read_text()
+    start = text.index("static const tParticleType aVCModLongerFxType")
+    end = text.index("\n}", text.index("VCModApplyParticleLifetimes(void)")) + 2
+    return text[start:end]
+
+
+def source():
+    return (PRELUDE + PARTICLE_STUBS + "\n".join(cut(n) for n in (
+        "VCModFormatMoney",
+        "VCModWantedSlotVisible",
+        "VCModExitHoldElapsed",
+    )) + particle_source() + MAIN)
+
+
+class QolTests(unittest.TestCase):
+    def test_pure_core(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "qol"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source(), text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        ini = INI.read_text()
+        hud = HUD.read_text()
+        auto = AUTO.read_text()
+        info = PLAYERINFO.read_text()
+        particle = PARTICLE.read_text()
+
+        self.assertIn('"VANILLA FIXES"', rows)
+        # the five-row family is one cycle row now; the four items keep their own
+        # flags, ini keys and debug-menu entries underneath it
+        self.assertRegex(rows, r'\{ "VANILLA FIXES",\s*VCMOD_ROW_CYCLE,\s*nil,'
+                               r'\s*"VanillaFixes",\s*VCMOD_PAGE_WORLD,\s*&aVCModVanillaFixCycle,')
+        for name in ("HUD CLEANUP", "KEEP WHEEL ANGLE", "EXIT HOLD OFF", "LONGER BLOOD/SAND"):
+            self.assertNotIn(f'"{name}"', rows)
+        self.assertRegex(rows, r'\{ "PATH LANE",\s*VCMOD_ROW_PATHPROBE_LANE,\s*nil,'
+                               r'\s*nil,\s*VCMOD_PAGE_DEBUG,')
+        for flag in ("bVCModVanillaFixes", "bVCModHudCleanup", "bVCModKeepWheelAngle",
+                     "bVCModExitHoldOff", "bVCModLongerFx"):
+            self.assertIn("&" + flag, switched)
+        for key in ("VanillaFixes", "HudCleanup", "KeepWheelAngle", "ExitHoldOff", "LongerFx"):
+            self.assertIn(f'ReadIniIfExists("VC Mods", "{key}"', ini)
+
+        self.assertIn("VCModFormatMoney(sTemp", hud)
+        self.assertIn("VCModWantedSlotVisible(", hud)
+        # both the disabled and the abandoned status zero the angle; the player's
+        # get-out passes through the disabled one
+        self.assertEqual(auto.count("bVCModVanillaFixes || !bVCModKeepWheelAngle"), 2)
+        self.assertIn("VCModExitHoldTick(this)", info)
+        self.assertIn("VCModApplyParticleLifetimes();", particle)
+        self.assertLess(particle.index("Initialise();", particle.index("void CParticle::ReloadConfig")),
+                        particle.index("VCModApplyParticleLifetimes();"))
+        # the debug menu flips the same flags without going through a panel click,
+        # so the lifespan pass has to run every frame, before either menu returns
+        render = braced(panel, "VCModPanelRender(void)")
+        self.assertIn("VCModRefreshParticleLifetimes();", render)
+        self.assertLess(render.index("VCModRefreshParticleLifetimes();"),
+                        render.index("DebugMenuIsActive()"))
+
+
+if __name__ == "__main__":
+    unittest.main()
