+int32
+VCModPageRowCount(int32 page)
+{
+	int32 n = 0;
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++)
+		if (aVCModRows[i].page == page)
+			n++;
+	return n;
+}
+
+// entry-th row of a page -> its index in the table, -1 when the page is short
+int32
+VCModPageRow(int32 page, int32 entry)
+{
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		if (aVCModRows[i].page != page)
+			continue;
+		if (entry-- == 0)
+			return i;
+	}
+	return -1;
+}
+
+// the panel keeps one height, so the warnings and hints do not jump between tabs
+int32
+VCModMaxPageRows(void)
+{
+	int32 max = 0;
+	for (int32 page = 0; page < NUM_VCMOD_PAGES; page++) {
+		int32 n = VCModPageRowCount(page);
+		if (n > max)
+			max = n;
+	}
+	return max;
+}
