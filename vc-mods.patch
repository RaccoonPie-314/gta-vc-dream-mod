@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Cop crouch-before-cover tests: the decision on its own, plus static checks
+that the beat sits in front of the stock cover timer, not beside it."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+COVER = ROOT / "src/extras/vcmodcopcover.cpp"
+PEDAI = ROOT / "src/peds/PedAI.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+typedef int int32;
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    CHECK(VCModCopCrouchFirst(true, true, true, 2), "a wanted cop shot by an armed player crouches");
+    CHECK(!VCModCopCrouchFirst(false, true, true, 2), "a civilian does not");
+    CHECK(!VCModCopCrouchFirst(true, false, true, 2), "melee does not count");
+    CHECK(!VCModCopCrouchFirst(true, true, false, 2), "a non-player attacker does not");
+    CHECK(!VCModCopCrouchFirst(true, true, true, 0), "no wanted level, no beat");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(name):
+    text = COVER.read_text()
+    match = re.search(r"((?:[A-Za-z_][A-Za-z0-9_]*[\s*]+)+)" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {COVER}")
+    start = match.start()
+    opening = match.end() - 1
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+def source():
+    return PRELUDE + cut("VCModCopCrouchFirst") + MAIN
+
+
+class CopCoverTests(unittest.TestCase):
+    def test_decision(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "copcover"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source(), text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_wiring(self):
+        pedai = PEDAI.read_text()
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        ini = INI.read_text()
+
+        self.assertIn('"COP CROUCH+COVER"', rows)
+        self.assertIn("&bVCModCopCrouchCover", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "CopCrouchCover"', ini)
+        self.assertIn('#include "vcmodcopcover.h"', pedai)
+
+        block = braced(pedai, "CPed::KillCharOnFootArmed")
+        # the beat belongs to the first frame a cop enters cover mode, and it has
+        # to push the cover deadline out rather than run beside the stock line
+        self.assertIn("VCModCopCrouchFirst(", block)
+        self.assertIn("firstEngagement", block)
+        self.assertIn("SetDuck(duckFor, true)", block)
+        self.assertIn("m_duckAndCoverTimer = CTimer::GetTimeInMilliseconds() + duckFor", block)
+        self.assertIn("bNotAllowedToDuck = true;", block)
+        self.assertIn("DuckAndCover()", block)
+
+        # the stock sequence is still there for every other ped
+        self.assertIn("bKindaStayInSamePlace = true;", pedai)
+        # and ReactToAttack keeps its stock duck/cover answers
+        react = braced(pedai, "CPed::ReactToAttack")
+        self.assertNotIn("VCModCopCrouchFirst(", react)
+
+
+if __name__ == "__main__":
+    unittest.main()
