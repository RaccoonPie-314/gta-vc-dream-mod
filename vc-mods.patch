+    car->AutoPilot.m_nCurrentLane = 1;
+    car->pos = CVector(40.0f, 60.0f, 0.0f);
+    int32 entered = car->AutoPilot.m_nTimeEnteredCurve;
+    CVector dest = vecVCModCrewDestination;
+    events.clear();
+
+    bVCModCrewAggressive = true;
+    nowMs += 100;
+    VCModCrewUpdate();
+    check(car->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_AVOID_CARS, "on: aggressive at once");
+    check(car->GetStatus() == STATUS_PHYSICS, "on: off the rails");
+    check(car->AutoPilot.m_nCruiseSpeed == 40, "on: fast");
+    check(!saw("goto") && !saw("join"), "on: no re-route");
+    check(car->AutoPilot.m_nCarMission == MISSION_GOTOCOORDS, "on: same mission");
+    check(car->AutoPilot.m_nCurrentPathNodeInfo == 7 && car->AutoPilot.m_nNextPathNodeInfo == 8 &&
+          car->AutoPilot.m_nCurrentRouteNode == 3 && car->AutoPilot.m_nNextRouteNode == 4 &&
+          car->AutoPilot.m_nCurrentLane == 1, "on: same route and lane");
+    check(car->pos.x == 40.0f && car->pos.y == 60.0f, "on: the car is not moved");
+    check(bVCModCrewHasDestination && vecVCModCrewDestination.x == dest.x &&
+          vecVCModCrewDestination.y == dest.y, "on: same destination");
+    check(nVCModCrewPhase == VCMOD_CREW_ABOARD, "on: the ride is not restarted");
+
+    bVCModCrewAggressive = false;
+    nowMs += 100;
+    VCModCrewUpdate();
+    check(car->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_STOP_FOR_CARS, "off: normal at once");
+    check(car->AutoPilot.m_nCruiseSpeed == 18, "off: traffic pace");
+    check(car->GetStatus() == STATUS_PHYSICS,
+          "off: stays on physics; rails would drag the car onto its lane");
+    check(car->AutoPilot.m_nTimeEnteredCurve == entered, "off: the curve is not re-seeded");
+    check(!saw("goto") && !saw("join"), "off: no re-route");
+    check(car->AutoPilot.m_nCurrentPathNodeInfo == 7 && car->AutoPilot.m_nCurrentRouteNode == 3,
+          "off: same route");
+    check(car->pos.x == 40.0f && car->pos.y == 60.0f, "off: the car is not moved");
+    check(!VCModCrewIgnoresLights(car), "off: the light counts");
+
+    /* Tommy at the wheel: the switch does not touch his car */
+    playerPed.WarpPedIntoCar(car);
+    car->pDriver = &playerPed;
+    car->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_PLOUGH_THROUGH;
+    bVCModCrewAggressive = true;
+    VCModCrewUpdate();
+    check(car->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_PLOUGH_THROUGH,
+          "nobody's AI is restyled under Tommy");
+    bVCModCrewAggressive = false;
+    std::printf("PASS: %d toggle checks\n", checks);
+}
+''')
+
