diff --git a/src/extras/vcmodstreet.cpp b/src/extras/vcmodstreet.cpp
new file mode 100644
index 0000000..d905b73
--- /dev/null
+++ b/src/extras/vcmodstreet.cpp
@@ -0,0 +1,821 @@
+#include "common.h"
+
+#include <stdio.h>
+
+#include "vcmodstreet.h"
+#include "vcmodpanel.h"
+#include "vcmodsit.h"
+#include "vcmodnpc.h"
+
+#include "AnimBlendAssociation.h"
+#include "AnimationId.h"
+#include "DMAudio.h"
+#include "General.h"
+#include "ModelIndices.h"
+#include "Pad.h"
+#include "PathFind.h"
+#include "Ped.h"
+#include "PlayerInfo.h"
+#include "PlayerPed.h"
+#include "RpAnimBlend.h"
+#include "SurfaceTable.h"
+#include "Timer.h"
+
+// ---- street idle: waiting on the pavement, and the pair chat the peds have --
+// the reasons are the peds' own, not new ones: a ped who is stuck waiting on a
+// pavement plays idle_hbhb (WAITSTATE_CROSS_ROAD / DOUBLEBACK), and a wandering
+// ped within 1.8 m of another one starts the same idle_chat pair both ways.
+// Tommy gets both on the same terms, on foot, unarmed and off the tarmac.
+static bool bVCModStreetChat;
+static CPed *pVCModStreetPartner;
+static uint32 nVCModStreetChatEnd;
+static uint32 nVCModStreetStillSince;
+static uint32 nVCModStreetGestureEnd;
+static uint32 nVCModStreetNextGesture;
+static uint32 nVCModStreetNextChat;
+// the chat's own voices: whose line is next, and when it may land
+static uint32 nVCModStreetNextTalk;
+static bool bVCModStreetPlayerTurn;
+// the chat's own gesture: when the speaker's hands go back to rest
+static uint32 nVCModStreetTalkEnd;
+static int32 nVCModStreetLastBlock = -1;
+// the head scratch that sometimes follows the waiting pose
+static bool bVCModStreetScratch;
+static uint32 nVCModStreetScratchEnd;
+// the kerbside look: a ped waiting at a crossing plays roadcross instead of
+// idle_hbhb, and the rule is the path data, not a coin flip
+static bool bVCModStreetCrossLook;
+static uint32 nVCModStreetCrossLookEnd;
+static uint32 nVCModStreetNextCrossLook;
+// the probe is the part that can silently miss, so it is counted and named
+static uint32 nVCModStreetCrossProbes;
+static uint32 nVCModStreetCrossMisses;
+static uint32 nVCModStreetCrossLastMissLog;
+// the peds' other two uses of the same look: after the tired pose that follows
+// a long run, and at the end of a flee that only made walking pace
+static bool bVCModStreetTired;
+static bool bVCModStreetRanIn;
+// the engine's bump reaction owns the arms while it plays; the idle steps aside
+static bool bVCModStreetBumpHand;
+// an ordinary run stop is not a flee, so only this many stops in a hundred get
+// the look, and never two inside the gap
+#define VCMOD_STREET_LOOK_CHANCE 20
+#define VCMOD_STREET_LOOK_GAP	30000
+static uint32 nVCModStreetNextRunLook;
+// the wander escalation: still this long and Tommy hands himself to the engine's
+// own pedestrian wander, the same SetWanderPath call the Vercetti crew walks on
+static bool bVCModStreetWander;
+#define VCMOD_STREET_WANDER_WAIT 30000
+bool bVCModStreetIdle = true;
+
+bool
+VCModStreetChatActive(void)
+{
+	return bVCModStreetChat;
+}
+
+void
+VCModStreetClearWander(void)
+{
+	bVCModStreetWander = false;
+}
+
+#define VCMOD_STREET_WAIT		4000	// still this long before the waiting pose
+#define VCMOD_STREET_GESTURE_GAP 14000
+// the kerb node on the pavement he is standing on, in plain metres
+#define VCMOD_STREET_CROSS_RANGE 6.0f
+#define VCMOD_STREET_CROSS_LEVEL 4.0f	// a kerb this far above or below is another street
+#define VCMOD_STREET_CROSS_GAP	15000
+#define VCMOD_STREET_CHAT_WAIT	2500
+#define VCMOD_STREET_CHAT_RANGE	1.8f	// the ped chat start distance
+#define VCMOD_STREET_CHAT_KEEP	4.0f	// how far they may drift and still talk
+#define VCMOD_STREET_CHAT_MIN	10000
+#define VCMOD_STREET_CHAT_MAX	14000
+#define VCMOD_STREET_CHAT_GAP	30000
+#define VCMOD_STREET_CHAT_ABORT_GAP 10000
+// a line is a second or two, so this leaves a beat of silence between them:
+// Chat()'s own 1.5 s per ped is what made the pair talk over itself
+#define VCMOD_STREET_TALK_MIN	3500
+#define VCMOD_STREET_TALK_MAX	5000
+// a line measures ~1.6 s in the voice bank; the hands ride a little past it and
+// rest until the next turn, instead of Chat()'s restart every two seconds
+#define VCMOD_STREET_TALK_GESTURE 1800
+// the beat after the last line's gesture before the pair parts: a ped walks on
+// after the exchange, and the player needs somewhere for it to end instead of
+// a timer cutting the conversation mid-line
+#define VCMOD_STREET_TALK_REST	600
+
+// one bit per refusal, so a feature that stays silent can say which condition
+// held it back instead of only failing to start
+enum
+{
+	VCMOD_STREET_NO_AI	= 1 << 0,
+	VCMOD_STREET_IN_CAR	= 1 << 1,
+	VCMOD_STREET_DYING	= 1 << 2,
+	VCMOD_STREET_DUCKING = 1 << 3,
+	VCMOD_STREET_AIMING	= 1 << 4,
+	VCMOD_STREET_STATE	= 1 << 5,
+	VCMOD_STREET_MOVING	= 1 << 6,
+	VCMOD_STREET_IN_AIR	= 1 << 7,
+	VCMOD_STREET_IN_WATER = 1 << 8,
+	VCMOD_STREET_CONTROLS = 1 << 9,
+	VCMOD_STREET_INPUT	= 1 << 10,
+	VCMOD_STREET_ACTION	= 1 << 11,
+	VCMOD_STREET_TARMAC	= 1 << 12
+};
+
+static int32
+VCModStreetBlockReason(CPlayerPed *player, CPad *pad)
+{
+	int32 reason = 0;
+	if (!player->IsPedInControl()) reason |= VCMOD_STREET_NO_AI;
+	if (player->bInVehicle) reason |= VCMOD_STREET_IN_CAR;
+	if (player->DyingOrDead()) reason |= VCMOD_STREET_DYING;
+	if (player->bIsDucking) reason |= VCMOD_STREET_DUCKING;
+	if (player->bIsAimingGun || player->bIsPointingGunAt) reason |= VCMOD_STREET_AIMING;
+	if (player->m_nPedState != PED_IDLE && player->m_nPedState != PED_CHAT) reason |= VCMOD_STREET_STATE;
+	if (player->m_fMoveSpeed > 0.05f) reason |= VCMOD_STREET_MOVING;
+	if (player->bIsInTheAir) reason |= VCMOD_STREET_IN_AIR;
+	if (player->bIsInWater) reason |= VCMOD_STREET_IN_WATER;
+	if (pad->ArePlayerControlsDisabled()) reason |= VCMOD_STREET_CONTROLS;
+	if (pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0) reason |= VCMOD_STREET_INPUT;
+	if (pad->JumpJustDown() || pad->GetWeapon() != 0 || pad->GetTarget()) reason |= VCMOD_STREET_ACTION;
+	if (player->m_nSurfaceTouched == SURFACE_TARMAC) reason |= VCMOD_STREET_TARMAC;
+	return reason;
+}
+
+static void
+VCModStreetFadeGesture(CPlayerPed *player)
+{
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_IDLE_HBHB);
+	if (assoc) {
+		// the ped's own waits fade the pose at 8.0, but those end at a timer and
+		// this one ends when Tommy walks off, so give the arms half a second to
+		// come back instead of the 0.125 s cut the engine uses
+		assoc->blendDelta = -2.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+static void
+VCModStreetStartGesture(CPlayerPed *player)
+{
+	CAnimBlendAssociation *assoc = CAnimManager::BlendAnimation(player->GetClump(), ASSOCGRP_STD, ANIM_STD_IDLE_HBHB, 2.0f);
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	// idle_hbhb is one 3.9 s cycle that raises the arms, holds, and puts them
+	// back at the pose it started from. A fixed 3-5 s hold faded the pose at a
+	// random point of that cycle, sometimes a frame after the repeat had started
+	// raising the arms again, which is the snap the ped wait states never show.
+	// Hold exactly one cycle and fade where the clip has already returned.
+	uint32 cycle = (uint32)(assoc->hierarchy->totalLength * 1000.0f);
+	nVCModStreetGestureEnd = now + (cycle > 200 ? cycle - 120 : cycle);
+	nVCModStreetNextGesture = nVCModStreetGestureEnd + VCMOD_STREET_GESTURE_GAP;
+	fprintf(stderr, "VCMOD street idle: waiting pose (%.2fs cycle)\n", assoc->hierarchy->totalLength);
+}
+
+// the ped DOUBLEBACK wait goes from the hands-behind-back pose into a scratch,
+// so half the time Tommy follows his cycle with the same one
+static void
+VCModStreetStartScratch(CPlayerPed *player)
+{
+	CAnimBlendAssociation *assoc = CAnimManager::BlendAnimation(player->GetClump(), ASSOCGRP_STD, ANIM_STD_XPRESS_SCRATCH, 2.0f);
+	// the stock idle pool owns everything flagged ASSOC_IDLE and would fade this
+	// out at 8.0; it is ours until the cycle ends, so take the flag off
+	assoc->flags &= ~ASSOC_IDLE;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	uint32 cycle = (uint32)(assoc->hierarchy->totalLength * 1000.0f);
+	nVCModStreetScratchEnd = now + (cycle > 200 ? cycle - 120 : cycle);
+	bVCModStreetScratch = true;
+	fprintf(stderr, "VCMOD street idle: head scratch (%.2fs cycle)\n", assoc->hierarchy->totalLength);
+}
+
+static void
+VCModStreetFadeScratch(CPlayerPed *player)
+{
+	if (!bVCModStreetScratch)
+		return;
+	bVCModStreetScratch = false;
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_XPRESS_SCRATCH);
+	if (assoc) {
+		assoc->blendDelta = -2.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+static void
+VCModStreetCrossMiss(const char *why, const CVector &pos, float nearest, const CVector *nearPos)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	nVCModStreetCrossMisses++;
+	// the first miss says the probe runs at all; after that one line per 30 s,
+	// so a walk along a pavement does not bury the log
+	if (nVCModStreetCrossMisses == 1 || now - nVCModStreetCrossLastMissLog >= 30000) {
+		nVCModStreetCrossLastMissLog = now;
+		if (nearPos)
+			fprintf(stderr, "VCMOD street idle: no kerb crossing (%s, nearest %.1f m at %.0f,%.0f,%.0f, player at %.0f,%.0f,%.0f, %u misses / %u probes)\n",
+				why, nearest, nearPos->x, nearPos->y, nearPos->z, pos.x, pos.y, pos.z,
+				nVCModStreetCrossMisses, nVCModStreetCrossProbes);
+		else
+			fprintf(stderr, "VCMOD street idle: no kerb crossing (%s, player at %.0f,%.0f,%.0f, %u misses / %u probes)\n",
+				why, pos.x, pos.y, pos.z, nVCModStreetCrossMisses, nVCModStreetCrossProbes);
+	}
+}
+
+// a crossing is a link, and its two ends are the kerbs on either side, so a ped
+// node is a kerb stop when one of its links carries the crossing flag. That is
+// the same bit the wandering peds test on the link they are about to walk; the
+// nearest single node is not enough, because the flagged node is often not the
+// one the player happens to be standing closest to.
+static int32
+VCModStreetCrossingKerb(CPlayerPed *player)
+{
+	nVCModStreetCrossProbes++;
+	CVector pos = player->GetPosition();
+	CVector bestPos;
+	int32 bestNode = -1;
+	float bestDist = 0.0f;
+
+	for (int32 i = ThePaths.m_numCarPathNodes; i < ThePaths.m_numPathNodes; i++) {
+		CPathNode *pNode = ThePaths.GetNode(i);
+		if (pNode == nil || pNode->numLinks == 0 || pNode->bDisabled || pNode->bBetweenLevels)
+			continue;
+
+		bool kerb = false;
+		for (int32 l = 0; l < pNode->numLinks; l++) {
+			if (ThePaths.ConnectionCrossesRoad(pNode->firstLink + l)) {
+				kerb = true;
+				break;
+			}
+		}
+		if (!kerb)
+			continue;
+
+		// the node belongs to a pavement at street level; a kerb above or below
+		// him is a different crossing and must not fire
+		CVector nodePos = pNode->GetPosition();
+		if (Abs(nodePos.z - pos.z) > VCMOD_STREET_CROSS_LEVEL)
+			continue;
+
+		float d = (nodePos - pos).Magnitude2D();
+		if (bestNode < 0 || d < bestDist) {
+			bestNode = i;
+			bestDist = d;
+			bestPos = nodePos;
+		}
+	}
+
+	if (bestNode >= 0 && bestDist <= VCMOD_STREET_CROSS_RANGE)
+		return bestNode;
+
+	if (bestNode < 0)
+		VCModStreetCrossMiss("no flagged kerb at this level", pos, -1.0f, nil);
+	else
+		VCModStreetCrossMiss("nearest kerb out of reach", pos, bestDist, &bestPos);
+	return -1;
+}
+
+static void
+VCModStreetStartCrossLook(CPlayerPed *player, const char *why, uint32 hold, int32 kerb)
+{
+	// the ped handoff fades idle_hbhb at 8.0 before blending roadcross, so the
+	// two partials never share the head; this is that same timer-driven handoff
+	// rather than the walk-off fade, so it gets the engine's faster blend
+	CAnimBlendAssociation *pose = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_IDLE_HBHB);
+	if (pose) {
+		pose->blendDelta = -8.0f;
+		pose->flags |= ASSOC_DELETEFADEDOUT;
+	}
+	CAnimManager::BlendAnimation(player->GetClump(), ASSOCGRP_STD, ANIM_STD_ROADCROSS, 8.0f);
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	nVCModStreetCrossLookEnd = now + hold;
+	nVCModStreetNextCrossLook = now + VCMOD_STREET_CROSS_GAP;
+	bVCModStreetCrossLook = true;
+	if (kerb >= 0)
+		fprintf(stderr, "VCMOD street idle: look both ways (%s, %.1fs, path node %d)\n",
+			why, hold / 1000.0f, kerb);
+	else
+		fprintf(stderr, "VCMOD street idle: look both ways (%s, %.1fs)\n",
+			why, hold / 1000.0f);
+}
+
+static void
+VCModStreetFadeCrossLook(CPlayerPed *player)
+{
+	if (!bVCModStreetCrossLook)
+		return;
+	bVCModStreetCrossLook = false;
+	// an aborted look (chat, a shove, a car) took the waiting pose with it; let
+	// the next still frame re-arm it instead of sitting out the gesture gap
+	nVCModStreetNextGesture = 0;
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_ROADCROSS);
+	if (assoc) {
+		assoc->blendDelta = -4.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+void
+VCModStreetFadePose(CPlayerPed *player)
+{
+	VCModStreetFadeGesture(player);
+	VCModStreetFadeScratch(player);
+	VCModStreetFadeCrossLook(player);
+}
+
+// the pair's own chat gesture: one line gets one talk cycle from the clip's
+// first pose. Chat()'s stock cycle threw the clip in at a random offset and
+// faded it a second or two later, so the arms restarted mid-gesture all
+// through the conversation.
+static void
+VCModStreetFadeTalk(CPed *ped)
+{
+	if (ped == nil)
+		return;
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_CHAT);
+	if (assoc) {
+		assoc->blendDelta = -4.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+static void
+VCModStreetStartTalk(CPlayerPed *player, CPed *ped)
+{
+	// one gesture at a time: the other side's hands rest while this one talks
+	VCModStreetFadeTalk(ped == player ? pVCModStreetPartner : (CPed*)player);
+	CAnimBlendAssociation *assoc = CAnimManager::BlendAnimation(ped->GetClump(), ASSOCGRP_STD, ANIM_STD_CHAT, 4.0f);
+	if (assoc) {
+		assoc->SetCurrentTime(0.0f);
+		assoc->SetRun();
+	}
+	nVCModStreetTalkEnd = CTimer::GetTimeInMilliseconds() + VCMOD_STREET_TALK_GESTURE;
+	fprintf(stderr, "VCMOD street idle: %s gesture\n", ped == player ? "player" : "partner");
+}
+
+static void
+VCModStreetEndTalk(CPlayerPed *player)
+{
+	VCModStreetFadeTalk(player);
+	VCModStreetFadeTalk(pVCModStreetPartner);
+	nVCModStreetTalkEnd = 0;
+}
+
+// the same candidate the ped chat start would pick: a wandering civilian in
+// reach, both able to see each other, on a surface WillChat accepts
+static CPed *
+VCModStreetChatPartner(CPlayerPed *player)
+{
+	float rangeSqr = sq(VCMOD_STREET_CHAT_RANGE);
+	for (int32 i = 0; i < player->m_numNearPeds; i++) {
+		CPed *ped = player->m_nearPeds[i];
+		if (ped == nil || ped == player || ped->CharCreatedBy != RANDOM_CHAR)
+			continue;
+		if (!ped->IsPedShootable() || ped->DyingOrDead() || ped->bInVehicle)
+			continue;
+		if (ped->m_nPedState != PED_WANDER_PATH && ped->m_nPedState != PED_IDLE)
+			continue;
+		// cops and gang members have their own business with Tommy
+		if (ped->m_nPedType != PEDTYPE_CIVMALE && ped->m_nPedType != PEDTYPE_CIVFEMALE)
+			continue;
+		if ((ped->GetPosition() - player->GetPosition()).MagnitudeSqr() > rangeSqr)
+			continue;
+		if (!player->CanSeeEntity(ped) || !ped->CanSeeEntity(player))
+			continue;
+		if (!ped->WillChat(player))
+			continue;
+		return ped;
+	}
+	return nil;
+}
+
+static int32
+VCModStreetChatBreak(CPlayerPed *player, CPad *pad)
+{
+	int32 reason = 0;
+	if (player->DyingOrDead()) reason |= VCMOD_CHATBREAK_DEAD;
+	if (player->bInVehicle) reason |= VCMOD_CHATBREAK_IN_CAR;
+	if (pad->ArePlayerControlsDisabled()) reason |= VCMOD_CHATBREAK_CONTROLS;
+	if (pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0) reason |= VCMOD_CHATBREAK_INPUT;
+	if (pad->JumpJustDown() || pad->GetWeapon() != 0 || pad->GetTarget()) reason |= VCMOD_CHATBREAK_ACTION;
+	if (player->bIsDucking) reason |= VCMOD_CHATBREAK_DUCK;
+	// only a state that actually took him out of the chat (a fall, a stagger)
+	// counts; a shove that leaves him standing keeps him in PED_CHAT
+	if (player->m_nPedState != PED_CHAT && player->m_nPedState != PED_IDLE) reason |= VCMOD_CHATBREAK_STATE;
+	return reason;
+}
+
+static bool
+VCModStreetPartnerLost(CPlayerPed *player, CPed *partner)
+{
+	if (partner == nil || partner->DyingOrDead() || partner->bInVehicle)
+		return true;
+	// a pedestrian that got frightened or pulled into a fight is done talking;
+	// only the shove that knocks it out of the chat for a frame is put back
+	if (partner->m_nPedState != PED_CHAT
+		&& partner->m_nPedState != PED_IDLE
+		&& partner->m_nPedState != PED_WANDER_PATH
+		&& partner->m_nPedState != PED_WANDER_RANGE
+		&& partner->m_nPedState != PED_NONE)
+		return true;
+	return (partner->GetPosition() - player->GetPosition()).MagnitudeSqr() > sq(VCMOD_STREET_CHAT_KEEP);
+}
+
+void
+VCModStreetEndChat(CPlayerPed *player, uint32 nextGap, const char *why)
+{
+	CPed *partner = pVCModStreetPartner;
+	if (partner) {
+		if (partner->m_nPedState == PED_CHAT)
+			partner->ClearChat();
+		partner->CleanUpOldReference((CEntity**)&pVCModStreetPartner);
+		pVCModStreetPartner = nil;
+	}
+	if (player->m_nPedState == PED_CHAT)
+		player->ClearChat();
+	// ClearChat drops the clip at 8.0, an eighth of a second, which is the snap at
+	// the end of the conversation; the hands come down at the gesture's own 4.0
+	// instead, so parting reads as a beat after the last line
+	VCModStreetFadeTalk(player);
+	if (partner)
+		VCModStreetFadeTalk(partner);
+	// the engine's own chat end leaves a 30 s gap before a ped chats again; with
+	// its timer gated for the pair, that gap is set here instead
+	player->m_chatTimer = CTimer::GetTimeInMilliseconds() + 30000;
+	if (partner)
+		partner->m_chatTimer = player->m_chatTimer;
+	nVCModStreetTalkEnd = 0;
+	bVCModStreetChat = false;
+	bVCModStreetPlayerTurn = false;
+	nVCModStreetNextTalk = 0;
+	nVCModStreetStillSince = 0;
+	nVCModStreetNextChat = CTimer::GetTimeInMilliseconds() + nextGap;
+	fprintf(stderr, "VCMOD street idle: chat ended (%s)\n", why);
+}
+
+void
+VCModStreetAbortChat(CPlayerPed *player, const char *why)
+{
+	VCModStreetEndChat(player, VCMOD_STREET_CHAT_ABORT_GAP, why);
+}
+
+// the chat owns its pair's voices and hands; CPed::Chat() runs its own animation
+// cycle for both of them, which put two lines on top of each other and restarted
+// the gesture every couple of seconds
+bool
+VCModStreetChatOwnsPed(CPed *ped)
+{
+	return bVCModStreetChat && (ped == FindPlayerPed() || ped == pVCModStreetPartner);
+}
+
+bool
+VCModStreetWanderOwnsPlayer(void)
+{
+	return bVCModStreetWander;
+}
+
+// the wander breaks on the same things the chat does; the state test differs
+// because the walk itself is PED_WANDER_PATH, and a dead-end node drops him to
+// PED_IDLE for a frame before a new direction is picked
+static int32
+VCModStreetWanderBreak(CPlayerPed *player, CPad *pad)
+{
+	int32 reason = 0;
+	if (player->DyingOrDead()) reason |= VCMOD_CHATBREAK_DEAD;
+	if (player->bInVehicle) reason |= VCMOD_CHATBREAK_IN_CAR;
+	if (pad->ArePlayerControlsDisabled()) reason |= VCMOD_CHATBREAK_CONTROLS;
+	if (pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0) reason |= VCMOD_CHATBREAK_INPUT;
+	if (pad->JumpJustDown() || pad->GetWeapon() != 0 || pad->GetTarget()) reason |= VCMOD_CHATBREAK_ACTION;
+	if (player->bIsDucking) reason |= VCMOD_CHATBREAK_DUCK;
+	if (player->m_nPedState != PED_WANDER_PATH && player->m_nPedState != PED_IDLE) reason |= VCMOD_CHATBREAK_STATE;
+	return reason;
+}
+
+void
+VCModStreetEndWander(CPlayerPed *player, const char *why)
+{
+	if (player->m_nPedState == PED_WANDER_PATH)
+		player->SetIdle();
+	bVCModStreetWander = false;
+	// a fresh stillness clock and gesture cycle, so stopping does not roll
+	// straight back into the wander or leave the arms mid-pose
+	nVCModStreetStillSince = 0;
+	nVCModStreetNextGesture = 0;
+	fprintf(stderr, "VCMOD street idle: wander ended (%s)\n", why);
+}
+
+void
+VCModStreetStartWander(CPlayerPed *player)
+{
+	// the flag lifts SetWanderPath's player guard for this deliberate call; the
+	// engine then walks him on the same path nodes and clips as any pedestrian
+	bVCModStreetWander = true;
+	VCModNpcResetStroll();
+	// the ID check leaves an away-from-the-target heading and a short leave
+	// timer; a random walk can start straight into the pedestrian he just
+	// questioned, which ends in the engine's blocked-ped pose chain
+	int32 dir = CGeneral::GetRandomNumber() & 7;
+	if (player->m_leaveCarTimer != 0
+		&& player->m_leaveCarTimer + 1000 > CTimer::GetTimeInMilliseconds())
+		dir = player->m_nPathDir & 7;
+	if (!player->SetWanderPath(dir)) {
+		// no ped path here (an interior, off-path ground): the engine fell back
+		// to idle, so there is nothing to wander and he keeps posing
+		bVCModStreetWander = false;
+		return;
+	}
+	// a chase leaves this set, and Seek() turns it into a run for every node of
+	// a plain stroll; pedestrians keep it clear
+	player->bIsRunning = false;
+	// hand the arms from the waiting pose to the walk
+	VCModStreetFadeGesture(player);
+	VCModStreetFadeScratch(player);
+	VCModStreetFadeCrossLook(player);
+	fprintf(stderr, "VCMOD street idle: wander started\n");
+}
+
+static void
+VCModStreetSayChat(CPed *ped)
+{
+	// straight into the ped's own voice, with the repeat guard Say() would have
+	// set after speaking: the next line must not repeat the one before it
+	DMAudio.PlayOneShot(ped->m_audioEntityId, SOUND_PED_CHAT, 1.0f);
+	ped->m_lastSoundStart = CTimer::GetTimeInMilliseconds();
+	ped->m_lastQueuedSound = SOUND_PED_CHAT;
+	fprintf(stderr, "VCMOD street idle: %s line\n", ped->IsPlayer() ? "player" : "partner");
+}
+
+static bool
+VCModStreetPlayerHasChatVoice(CPlayerPed *player)
+{
+	int32 model = player->GetModelIndex();
+	// Tommy and the cutscene bodies carry no chat lines in their bank, and a turn
+	// nobody can voice would be a hole in the exchange, so the partner takes it
+	return model != MI_PLAYER && !(model >= MI_SPECIAL01 && model <= MI_LAST_PED);
+}
+
+static void
+VCModStreetStartChat(CPlayerPed *player, CPed *partner, uint32 time)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	VCModStreetFadePose(player);
+	player->SetChat(partner, time);
+	partner->SetChat(player, time);
+	pVCModStreetPartner = partner;
+	pVCModStreetPartner->RegisterReference((CEntity**)&pVCModStreetPartner);
+	bVCModStreetChat = true;
+	nVCModStreetChatEnd = now + time;
+	nVCModStreetNextChat = now + VCMOD_STREET_CHAT_GAP;
+
+	// the partner opens and the player answers, then it goes back and forth on the
+	// same beat; the pair's own Say() is out of the loop while this chat runs
+	VCModStreetSayChat(partner);
+	VCModStreetStartTalk(player, partner);
+	bVCModStreetPlayerTurn = true;
+	nVCModStreetNextTalk = now + CGeneral::GetRandomNumberInRange(VCMOD_STREET_TALK_MIN, VCMOD_STREET_TALK_MAX);
+
+	fprintf(stderr, "VCMOD street idle: chat started with model %d for %.1fs\n",
+		(int)partner->GetModelIndex(), time / 1000.0f);
+}
+
+void
+VCModStreetKeepChat(CPlayerPed *player)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (now >= nVCModStreetChatEnd || pVCModStreetPartner == nil)
+		return;
+
+	uint32 left = nVCModStreetChatEnd - now;
+	// a shove can drop either side out of PED_CHAT for a frame without either of
+	// them having finished; put them back and keep the clock where it was
+	if (pVCModStreetPartner->m_nPedState != PED_CHAT && pVCModStreetPartner->IsPedInControl())
+		pVCModStreetPartner->SetChat(player, left);
+	if (player->m_nPedState != PED_CHAT)
+		player->SetChat(pVCModStreetPartner, left);
+
+	// Chat() only turns the body while the look flag is up, and SetChat gives it
+	// a three second timer, so the pair used to stop facing each other a third of
+	// the way in. Re-arm it after the control code so nothing later overwrites it.
+	if (!player->bIsLooking || player->m_pLookTarget != pVCModStreetPartner)
+		player->SetLookFlag(pVCModStreetPartner, true, true);
+	if (!pVCModStreetPartner->bIsLooking || pVCModStreetPartner->m_pLookTarget != player)
+		pVCModStreetPartner->SetLookFlag(player, true, true);
+
+	// one line a turn with a beat between them: the pair trades lines instead of
+	// both animation cycles barking at their own 1.5 s pace
+	if (nVCModStreetTalkEnd && now >= nVCModStreetTalkEnd) {
+		VCModStreetEndTalk(player);
+		// the hands are down and the next line would land past the clock, so
+		// this rest beat is where the pair parts; without this the chat would
+		// run on in silence until the timer
+		if (nVCModStreetNextTalk >= nVCModStreetChatEnd)
+			nVCModStreetChatEnd = now + VCMOD_STREET_TALK_REST;
+	}
+	if (now >= nVCModStreetNextTalk) {
+		// the hands belong to the turn, not to the voice: a body with no chat
+		// bank still answers with its hands while the partner speaks
+		CPed *turn = bVCModStreetPlayerTurn ? (CPed*)player : pVCModStreetPartner;
+		CPed *speaker = bVCModStreetPlayerTurn && VCModStreetPlayerHasChatVoice(player)
+			? (CPed*)player : pVCModStreetPartner;
+		VCModStreetSayChat(speaker);
+		VCModStreetStartTalk(player, turn);
+		bVCModStreetPlayerTurn = !bVCModStreetPlayerTurn;
+		nVCModStreetNextTalk = now + CGeneral::GetRandomNumberInRange(VCMOD_STREET_TALK_MIN, VCMOD_STREET_TALK_MAX);
+		// a line that runs past the clock moves the clock: the pair parts on the
+		// rest beat after its last line, the way a ped finishes the exchange
+		// before walking on, instead of leaving or cutting it mid-turn
+		if (nVCModStreetTalkEnd + VCMOD_STREET_TALK_REST > nVCModStreetChatEnd)
+			nVCModStreetChatEnd = nVCModStreetTalkEnd + VCMOD_STREET_TALK_REST;
+	}
+}
+
+void
+VCModUpdateStreetIdle(CPlayerPed *player, CPad *pad)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	// the manual NPC command owns him entirely; the idle poses, chat and
+	// escalation stand down so the two never fight over the body
+	if (bVCModNpcMode)
+		return;
+
+	// the seat owns Tommy's pose; no waiting gesture or chat starts on top of it
+	if (VCModSitting()) {
+		VCModStreetFadePose(player);
+		nVCModStreetStillSince = 0;
+		return;
+	}
+
+	if (!bVCModStreetIdle) {
+		VCModStreetFadePose(player);
+		if (bVCModStreetChat)
+			VCModStreetEndChat(player, VCMOD_STREET_CHAT_ABORT_GAP, "switched off");
+		if (bVCModStreetWander)
+			VCModStreetEndWander(player, "switched off");
+		nVCModStreetStillSince = 0;
+		return;
+	}
+
+	if (bVCModStreetChat) {
+		int32 brk = VCModStreetChatBreak(player, pad);
+		if (VCModStreetPartnerLost(player, pVCModStreetPartner))
+			brk |= VCMOD_CHATBREAK_PARTNER;
+		if (brk != 0) {
+			const char *why = brk & VCMOD_CHATBREAK_PARTNER ? "partner gone"
+				: brk & VCMOD_CHATBREAK_DEAD ? "died"
+				: brk & VCMOD_CHATBREAK_IN_CAR ? "into a car"
+				: brk & VCMOD_CHATBREAK_CONTROLS ? "controls taken"
+				: brk & VCMOD_CHATBREAK_STATE ? "knocked down"
+				: brk & VCMOD_CHATBREAK_DUCK ? "crouched"
+				: brk & VCMOD_CHATBREAK_INPUT ? "walked off" : "drew a weapon";
+			VCModStreetEndChat(player, VCMOD_STREET_CHAT_ABORT_GAP, why);
+		} else if (now >= nVCModStreetChatEnd) {
+			VCModStreetEndChat(player, VCMOD_STREET_CHAT_GAP, "time up");
+		}
+		// the pair is kept turned and in the chat by VCModStreetKeepChat, which
+		// runs at the end of the frame, after the control and camera code
+		return;
+	}
+
+	if (bVCModStreetWander) {
+		int32 brk = VCModStreetWanderBreak(player, pad);
+		if (brk != 0) {
+			const char *why = brk & VCMOD_CHATBREAK_DEAD ? "died"
+				: brk & VCMOD_CHATBREAK_IN_CAR ? "into a car"
+				: brk & VCMOD_CHATBREAK_CONTROLS ? "controls taken"
+				: brk & VCMOD_CHATBREAK_STATE ? "knocked down"
+				: brk & VCMOD_CHATBREAK_DUCK ? "crouched"
+				: brk & VCMOD_CHATBREAK_INPUT ? "walked off" : "drew a weapon";
+			VCModStreetEndWander(player, why);
+		} else if (player->m_nPedState == PED_IDLE) {
+			// a dead-end node dropped him to idle; a pedestrian picks a new
+			// direction and walks on, so re-issue the same wander. If there is
+			// no path at all, stop and let the idle poses take over
+			if (!player->SetWanderPath(CGeneral::GetRandomNumber() & 7))
+				VCModStreetEndWander(player, "no path");
+		}
+		// otherwise the engine's WanderPath owns the walk this frame
+		return;
+	}
+
+	int32 block = VCModStreetBlockReason(player, pad);
+	if (block != 0) {
+		// a fast run is the player's flee: the ped rule looks both ways after
+		// one, either straight away or after the tired pose it earns
+		if (player->m_nMoveState >= PEDMOVE_JOG)
+			bVCModStreetRanIn = true;
+		// one line per distinct refusal, so a silent feature names its reason
+		if (block != nVCModStreetLastBlock) {
+			fprintf(stderr, "VCMOD street idle held: 0x%x state=%d wep=%d surf=%d spd=%.2f\n",
+				(uint32)block, (int)player->m_nPedState, (int)player->GetWeapon()->m_eWeaponType,
+				(int)player->m_nSurfaceTouched, player->m_fMoveSpeed);
+			nVCModStreetLastBlock = block;
+		}
+		nVCModStreetStillSince = 0;
+		VCModStreetFadePose(player);
+		return;
+	}
+	nVCModStreetLastBlock = -1;
+
+	if (nVCModStreetStillSince == 0)
+		nVCModStreetStillSince = now;
+
+	uint32 stillFor = now - nVCModStreetStillSince;
+
+	bool waiting = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_IDLE_HBHB) != nil;
+	// the stamina pose is the engine's own: Tommy bends over when the sprint
+	// bar ran out, and the peds hand off to the look when that clip is done
+	CAnimBlendAssociation *tiredAssoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_IDLE_TIRED);
+	bool tired = tiredAssoc && tiredAssoc->blendDelta >= 0.0f;
+	// a pedestrian shoving him (or a car horn, CarCtrl) sets bShakeFist, and the
+	// engine answers with the one-armed FUCKU partial from MoveHeadToLook
+	CAnimBlendAssociation *bumpAssoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_PARTIAL_FUCKU);
+	bool bumping = player->bShakeFist || (bumpAssoc && bumpAssoc->blendDelta >= 0.0f);
+
+	// Pose priority, highest first, and only one owner of the arms at a time:
+	//   1. the seat (that whole update returns before this code runs)
+	//   2. engine reactions - the bump fist, then the stamina pose
+	//   3. the look both ways
+	//   4. the head scratch
+	//   5. the waiting pose (idle_hbhb)
+	// The chat is a ped state of its own and never comes through here.
+	if (bumping) {
+		// a reaction outranks the idle: step the waiting pose and any look aside
+		// so a second gesture is not blended on top of the raised arm
+		if (waiting)
+			VCModStreetFadeGesture(player);
+		if (bVCModStreetCrossLook)
+			VCModStreetFadeCrossLook(player);
+		bVCModStreetBumpHand = true;
+	} else if (bVCModStreetBumpHand) {
+		// the fist is gone; give him his waiting pose back straight away
+		bVCModStreetBumpHand = false;
+		nVCModStreetNextGesture = 0;
+	} else if (bVCModStreetCrossLook) {
+		// the look ends on its own clock, then the waiting pose comes back with
+		// a fresh cycle; waiting for the next gesture gap would leave him
+		// standing with nothing playing
+		if (now >= nVCModStreetCrossLookEnd) {
+			VCModStreetFadeCrossLook(player);
+			VCModStreetStartGesture(player);
+		}
+	} else if (tired) {
+		// nothing goes on top of the stamina pose; the look is queued behind it
+		if (waiting)
+			VCModStreetFadeGesture(player);
+		bVCModStreetTired = true;
+	} else if (bVCModStreetTired) {
+		// WAITSTATE_FINISH_FLEE hands the tired pose to CROSS_ROAD_LOOK for two
+		// seconds; same beat here, then the waiting pose resumes. This stop is
+		// already spent on the stamina pose, so the run rule does not roll again
+		bVCModStreetTired = false;
+		bVCModStreetRanIn = false;
+		VCModStreetStartCrossLook(player, "after catching his breath", 2000, -1);
+	} else if (bVCModStreetRanIn) {
+		// the peds only look when a flee ends; a stop after an ordinary jog is
+		// far more common, so it keeps a low chance and a gap to stay a treat
+		bVCModStreetRanIn = false;
+		if (now >= nVCModStreetNextRunLook
+			&& CGeneral::GetRandomNumberInRange(0, 99) < VCMOD_STREET_LOOK_CHANCE) {
+			nVCModStreetNextRunLook = now + VCMOD_STREET_LOOK_GAP;
+			VCModStreetStartCrossLook(player, "after a run",
+				CGeneral::GetRandomNumberInRange(2000, 5000), -1);
+		}
+	} else if (bVCModStreetScratch) {
+		if (now >= nVCModStreetScratchEnd)
+			VCModStreetFadeScratch(player);
+	} else if (RpAnimBlendClumpGetFirstAssociation(player->GetClump(), ASSOC_IDLE)) {
+		VCModStreetFadeGesture(player);
+	} else if (waiting && now >= nVCModStreetGestureEnd) {
+		// the kerb rule is checked only where a ped would look both ways: one
+		// waiting cycle has finished, and the path data says this kerb crosses
+		int32 kerb = -1;
+		if (now >= nVCModStreetNextCrossLook)
+			kerb = VCModStreetCrossingKerb(player);
+		if (kerb >= 0)
+			VCModStreetStartCrossLook(player, "at a kerb", CGeneral::GetRandomNumberInRange(2000, 5000), kerb);
+		else if (CGeneral::GetRandomNumber() & 1)
+			VCModStreetStartScratch(player);
+		else
+			VCModStreetFadeGesture(player);
+	} else if (!waiting && stillFor >= VCMOD_STREET_WAIT && now >= nVCModStreetNextGesture) {
+		VCModStreetStartGesture(player);
+	}
+
+	if (stillFor >= VCMOD_STREET_CHAT_WAIT && now >= nVCModStreetNextChat) {
+		CPed *partner = VCModStreetChatPartner(player);
+		if (partner)
+			VCModStreetStartChat(player, partner,
+				CGeneral::GetRandomNumberInRange(VCMOD_STREET_CHAT_MIN, VCMOD_STREET_CHAT_MAX));
+		else
+			// nobody to talk to this time; look again once the scene has moved
+			nVCModStreetNextChat = now + 2000;
+	}
+
+	// the last escalation: bored of standing, he becomes a pedestrian. The chat
+	// owns him first when there is a partner; this only fires once he is alone
+	// and has been still past the wander wait
+	if (!bVCModStreetChat && stillFor >= VCMOD_STREET_WANDER_WAIT)
+		VCModStreetStartWander(player);
+}
+
diff --git a/src/extras/vcmodstreet.h b/src/extras/vcmodstreet.h
new file mode 100644
index 0000000..1d615d7
--- /dev/null
+++ b/src/extras/vcmodstreet.h
@@ -0,0 +1,51 @@
+#ifndef VCMODSTREET_H
+#define VCMODSTREET_H
+
+class CPlayerPed;
+class CPed;
+class CPad;
+
+// STREET IDLE: waiting poses on the pavement, the pair chat, the kerbside look
+// and the wander escalation
+extern bool bVCModStreetIdle;
+
+// the pair chat owns its two bodies' voices and hands
+bool VCModStreetChatOwnsPed(CPed *ped);
+// true while the wander escalation owns the player's walk
+bool VCModStreetWanderOwnsPlayer(void);
+// true while the pair chat is running
+bool VCModStreetChatActive(void);
+// NPC mode hand-back: drop the wander flag without restoring the walk
+void VCModStreetClearWander(void);
+// the chat is not a wait state: only a press, a car, a death or being knocked
+// down ends it. The point is what is NOT here - a ped shoving Tommy changes the
+// move speed and the touched surface for a frame or two, and testing those used
+// to end the conversation the moment anybody brushed past.
+enum
+{
+	VCMOD_CHATBREAK_DEAD	= 1 << 0,
+	VCMOD_CHATBREAK_IN_CAR	= 1 << 1,
+	VCMOD_CHATBREAK_CONTROLS = 1 << 2,
+	VCMOD_CHATBREAK_INPUT	= 1 << 3,
+	VCMOD_CHATBREAK_ACTION	= 1 << 4,
+	VCMOD_CHATBREAK_DUCK	= 1 << 5,
+	VCMOD_CHATBREAK_STATE	= 1 << 6,
+	VCMOD_CHATBREAK_PARTNER = 1 << 7
+};
+
+// ends the pair chat at once, for another feature that takes the body
+void VCModStreetAbortChat(CPlayerPed *player, const char *why);
+// ends the pair chat, giving the next one this gap
+void VCModStreetEndChat(CPlayerPed *player, uint32 nextGap, const char *why);
+// stops the wander and restores the idle pose
+void VCModStreetEndWander(CPlayerPed *player, const char *why);
+// hands the player to the engine's pedestrian wander
+void VCModStreetStartWander(CPlayerPed *player);
+// cancels any waiting pose before another feature takes the body
+void VCModStreetFadePose(CPlayerPed *player);
+// keeps the pair facing and talking, after the frame's control code
+void VCModStreetKeepChat(CPlayerPed *player);
+// per frame, before the control code
+void VCModUpdateStreetIdle(CPlayerPed *player, CPad *pad);
+
+#endif
diff --git a/src/extras/vcmodtraffic.cpp b/src/extras/vcmodtraffic.cpp
new file mode 100644
index 0000000..2a978d5
--- /dev/null
+++ b/src/extras/vcmodtraffic.cpp
@@ -0,0 +1,297 @@
+#include "common.h"
+
+#include "vcmodtraffic.h"
+
+#include "Automobile.h"
+#include "Camera.h"
+#include "CarCtrl.h"
+#include "ColPoint.h"
+#include "General.h"
+#include "ModelInfo.h"
+#include "Pools.h"
+#include "Timer.h"
+#include "TrafficLights.h"
+#include "Vehicle.h"
+#include "World.h"
+
+bool bVCModTrafficAI = true;
+
+// Values from Real Traffic Fix's own source (JuniorDjjr, real-traffic-fix), VC build.
+#define RTF_CRUISE		15.0f
+#define RTF_MIN			3.0f
+#define RTF_MAX			30.0f
+#define RTF_TURN_DECREASE	15.0f
+#define RTF_FRONT_MULT		50.0f
+#define RTF_SIDES_DIV		70.0f
+#define RTF_CHECK_GROUND	0.5f
+#define RTF_FINAL_GROUND	0.5f
+#define RTF_HEIGHT_LIMIT	3.0f
+#define RTF_ACCEL		0.005f
+#define RTF_DECEL		0.01f
+#define RTF_OBSTACLE_DECREASE	20.0f
+#define RTF_HORN_ONE_IN		100
+
+static const float MAGIC = 50.0f / 30.0f;
+
+#define FLAG_PHYSICS	1
+#define FLAG_GROUNDFIX	2
+
+static float aFreeLineTimer[NUMVEHICLES];
+static uint8 aFlags[NUMVEHICLES];
+static uint32 aBlockedSince[NUMVEHICLES];
+static uint32 aAvoidUntil[NUMVEHICLES];
+static int32 aStyleBefore[NUMVEHICLES];
+
+#define RTF_STUCK_MS	3000	// held up this long by a stationary car
+#define RTF_AVOID_MS	4000	// then give way / go around for this long
+#define RTF_STOPPED	0.06f	// speed under which the car counts as not moving
+
+int32
+VCModTrafficLane(CVehicle *vehicle, uint8 lanes)
+{
+	if (lanes == 0)
+		return 0;
+
+	if (bVCModTrafficAI && vehicle->GetModelInfo()->m_vehicleClass == CCarCtrl::BIG)
+		return lanes - 1;
+
+	return CGeneral::GetRandomNumber() % lanes;
+}
+
+bool
+VCModTrafficHornAllowed(void)
+{
+	if (!bVCModTrafficAI)
+		return true;
+
+	// the mod spends a dice roll per call instead of a cooldown
+	return CGeneral::GetRandomNumberInRange(0, RTF_HORN_ONE_IN) == 0;
+}
+
+static float
+ClampCruise(float speed)
+{
+	if (speed < RTF_MIN)
+		return RTF_MIN;
+	if (speed > RTF_MAX)
+		return RTF_MAX;
+	return speed;
+}
+
+// A car sitting with no ground underneath it is inside the collision, not floating
+// over a hole: probing above its own roof finds ground again.
+static bool
+NeedsRepos(CVehicle *vehicle, const CVector &local, float roof)
+{
+	CVector world = vehicle->GetMatrix() * local;
+	world.z = vehicle->GetPosition().z;
+
+	bool found;
+	CWorld::FindGroundZFor3DCoord(world.x, world.y, world.z, &found);
+	if (found)
+		return false;
+
+	CWorld::FindGroundZFor3DCoord(world.x, world.y, world.z + roof, &found);
+	return found;
+}
+
+static bool
+ReposVehicle(CVehicle *vehicle)
+{
+	CVector pos = vehicle->GetPosition();
+
+	for (int32 attempt = 0; attempt < 2; attempt++) {
+		pos.x += 0.027f;
+		pos.y += 0.027f;
+		pos.z += 2.0f;
+
+		bool found;
+		float ground = CWorld::FindGroundZFor3DCoord(pos.x, pos.y, pos.z, &found);
+		if (!found)
+			continue;
+
+		pos.z = ground + 0.5f;
+		vehicle->SetPosition(pos);
+		((CAutomobile*)vehicle)->PlaceOnRoadProperly();
+		return true;
+	}
+
+	return false;
+}
+
+static bool
+GroundStuckFix(CVehicle *vehicle, bool isBike)
+{
+	CColModel *col = vehicle->GetModelInfo()->GetColModel();
+	CVector front(0.0f, col->boundingBox.max.y * 0.9f, 0.0f);
+	CVector back(0.0f, col->boundingBox.min.y * 0.9f, 0.0f);
+
+	if (!NeedsRepos(vehicle, back, col->boundingBox.max.z) &&
+	    (isBike || !NeedsRepos(vehicle, front, col->boundingBox.max.z)))
+		return false;
+
+	return ReposVehicle(vehicle);
+}
+
+// Is anything in the way? Returns false and sets the hit point when the road ahead
+// is clear. Three probes: centre, and the two edges of the body for cars.
+static bool
+ProbeAhead(CVehicle *vehicle, bool isBike, float speed, float speedFactor,
+	CColPoint *colPoint)
+{
+	CColModel *col = vehicle->GetModelInfo()->GetColModel();
+	float ground = col->boundingBox.min.z * 0.4f;
+	if (ground < -1.0f)
+		ground = -1.0f;
+	if (ground > 1.0f)
+		ground = 1.0f;
+
+	float bonus = isBike ? 0.5f : 0.15f;
+	float limit = RTF_HEIGHT_LIMIT * (isBike ? 2.0f : 1.0f);
+	float dist = Max(1.0f, vehicle->GetMoveSpeed().Magnitude() * RTF_FRONT_MULT);
+	float steer = -vehicle->m_fSteerAngle * 20.0f * speedFactor;
+	float side = speed / RTF_SIDES_DIV;
+
+	struct { CVector from, to; } ray[3];
+	ray[0].from = CVector(0.0f, col->boundingBox.max.y, ground + bonus);
+	ray[0].to = CVector(steer, col->boundingBox.max.y + dist, ground / 1.5f + bonus * 2.0f);
+	ray[1].from = CVector(col->boundingBox.min.x,
+		col->boundingBox.max.y - Max(0.0f, col->boundingBox.max.y * vehicle->m_fSteerAngle),
+		ground + bonus);
+	ray[1].to = CVector(col->boundingBox.min.x - side + steer,
+		col->boundingBox.max.y + dist, ground / 1.5f);
+	ray[2].from = CVector(col->boundingBox.max.x,
+		col->boundingBox.max.y + Min(0.0f, col->boundingBox.max.y * vehicle->m_fSteerAngle),
+		ground + bonus);
+	ray[2].to = CVector(col->boundingBox.max.x + side + steer,
+		col->boundingBox.max.y + dist, ground / 1.5f);
+
+	CWorld::pIgnoreEntity = vehicle;
+	for (int32 i = 0; i < (isBike ? 1 : 3); i++) {
+		CVector from = vehicle->GetMatrix() * ray[i].from;
+		CVector to = vehicle->GetMatrix() * ray[i].to;
+
+		bool found;
+		float ground = CWorld::FindGroundZFor3DCoord(to.x, to.y, to.z + RTF_CHECK_GROUND, &found);
+		if (!found || ABS(ground - to.z) > limit) {
+			// no road where the car is heading: treat the probe end as the wall
+			colPoint->point = to;
+			return true;
+		}
+		to.z = ground + RTF_FINAL_GROUND;
+
+		CEntity *hit = nil;
+		if (CWorld::ProcessLineOfSight(from, to, *colPoint, hit,
+			true, true, true, false, false, false))
+			return true;
+	}
+	return false;
+}
+
+void
+VCModTrafficUpdate(CVehicle *vehicle)
+{
+	if (!bVCModTrafficAI)
+		return;
+	if (vehicle->pDriver == nil || vehicle->pDriver->IsPlayer())
+		return;
+	// a mission car is left to its script; the crew pick-up runs on rails and is
+	// governed by SlowCarOnRailsDownForTrafficAndLights like any civilian
+	if (vehicle->VehicleCreatedBy == MISSION_VEHICLE)
+		return;
+	if (vehicle->m_vehType != VEHICLE_TYPE_CAR && vehicle->m_vehType != VEHICLE_TYPE_BIKE)
+		return;
+
+	// The mod hooked the render pass, so it only ever touched visible cars. Do the
+	// same explicitly: three line-of-sight probes per car is not free.
+	if ((vehicle->GetPosition() - TheCamera.GetPosition()).Magnitude() > 120.0f)
+		return;
+
+	int32 index = CPools::GetVehiclePool()->GetIndex(vehicle);
+	if (index < 0 || index >= NUMVEHICLES)
+		return;
+
+	bool isBike = vehicle->m_vehType == VEHICLE_TYPE_BIKE;
+	float step = CTimer::GetTimeStep() / MAGIC;
+
+	vehicle->AutoPilot.m_nCruiseSpeed = RTF_CRUISE;
+
+	if ((aFlags[index] & FLAG_PHYSICS) == 0) {
+		CCarCtrl::SwitchVehicleToRealPhysics(vehicle);
+		aFlags[index] |= FLAG_PHYSICS;
+	}
+
+	if ((aFlags[index] & FLAG_GROUNDFIX) && vehicle->GetMoveSpeed().Magnitude() < 0.005f)
+		GroundStuckFix(vehicle, isBike);
+
+	if (vehicle->GetMoveSpeed().Magnitude() <= 0.0005f) {
+		aFreeLineTimer[index] = 0.0f;
+		return;
+	}
+
+	if (vehicle->AutoPilot.m_pTargetCar != nil)
+		return;
+	if (vehicle->m_bSirenOrAlarm && vehicle->GetModelIndex() != MI_MRWHOOP)
+		return;
+
+	float speed = vehicle->GetMoveSpeed().Magnitude() * 50.0f * 3.6f;
+	CVector cam = TheCamera.GetPosition();
+	if (speed > 10.0f && (vehicle->GetPosition() - cam).Magnitude() < 30.0f)
+		aFlags[index] &= ~FLAG_GROUNDFIX;
+
+	if (vehicle->m_nCurrentGear == 0)
+		return;
+
+	float cruise = RTF_CRUISE;
+	if (ABS(vehicle->m_fSteerAngle) > 0.001f)
+		cruise = ClampCruise(RTF_CRUISE - RTF_TURN_DECREASE * ABS(vehicle->m_fSteerAngle));
+
+	float speedFactor = Min(speed / 40.0f, 1.0f);
+	CColPoint colPoint;
+	bool blocked = ProbeAhead(vehicle, isBike, speed, speedFactor, &colPoint);
+
+	// A car held up by something that is not a light gets one chance to give way
+	// rather than sit there for ever. AVOID_CARS is the engine's own style for it.
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	bool atLight = CTrafficLights::ShouldCarStopForLight(vehicle, false) ||
+		CTrafficLights::ShouldCarStopForBridge(vehicle);
+
+	if (aAvoidUntil[index] != 0 && now >= aAvoidUntil[index]) {
+		if (vehicle->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_AVOID_CARS)
+			vehicle->AutoPilot.m_nDrivingStyle = aStyleBefore[index];
+		aAvoidUntil[index] = 0;
+	}
+
+	if (blocked && !atLight && vehicle->GetMoveSpeed().Magnitude() < RTF_STOPPED) {
+		if (aBlockedSince[index] == 0)
+			aBlockedSince[index] = now;
+		else if (now - aBlockedSince[index] >= RTF_STUCK_MS && aAvoidUntil[index] == 0) {
+			aStyleBefore[index] = vehicle->AutoPilot.m_nDrivingStyle;
+			vehicle->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+			aAvoidUntil[index] = now + RTF_AVOID_MS;
+			aBlockedSince[index] = 0;
+		}
+	} else if (!blocked || atLight) {
+		aBlockedSince[index] = 0;
+	}
+
+	if (blocked) {
+		float near = Min(1.0f, (colPoint.point - vehicle->GetPosition()).Magnitude() / 20.0f);
+		float factor = 1.0f - near;
+		aFreeLineTimer[index] -= factor * speedFactor * step;
+		if (aFreeLineTimer[index] < 0.0f)
+			aFreeLineTimer[index] = 0.0f;
+		cruise = ClampCruise(RTF_CRUISE - RTF_OBSTACLE_DECREASE * factor * step);
+	} else if (vehicle->m_fGasPedal >= 0.05f) {
+		aFreeLineTimer[index] += RTF_ACCEL * step;
+		if (aFreeLineTimer[index] > 1.0f)
+			aFreeLineTimer[index] = 1.0f;
+		cruise = ClampCruise(cruise + (RTF_MAX - RTF_CRUISE) * aFreeLineTimer[index]);
+	} else {
+		aFreeLineTimer[index] -= RTF_DECEL * step;
+		if (aFreeLineTimer[index] < 0.0f)
+			aFreeLineTimer[index] = 0.0f;
+	}
+
+	vehicle->AutoPilot.m_nCruiseSpeed = (int8)cruise;
+}
