index 0000000..481ed9c
--- /dev/null
+++ b/utils/test_vc_cop_chase.py
@@ -0,0 +1,179 @@
+#!/usr/bin/env python3
+"""The player copy of PED_SEEK_ENTITY: a seek must survive its target pointer
+going away, and it must drive speed and restore the state the way the native
+ped path does.
+
+Aim code calls SetAimFlag(float), which writes m_pSeekTarget = nil and leaves
+m_nPedState at SEEK_ENTITY. Native ProcessControl answers that with
+RestorePreviousState; this copy read the pointer first and crashed
+(CPlayerPed::ProcessControl +0x2018, ldr w9, [x8,#0x40] with x8 nil).
+"""
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+PLAYER = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+
+BEGIN = "case PED_SEEK_ENTITY:"
+END = "case PED_SNIPER_MODE:"
+
+
+def case():
+    return PLAYER[PLAYER.index(BEGIN):PLAYER.index(END, PLAYER.index(BEGIN))]
+
+
+STUBS = r'''
+#include <cstdio>
+#define nil NULL
+enum { PED_IDLE, PED_SEEK_ENTITY, PED_SEEK_POS };
+enum { PEDMOVE_STILL, PEDMOVE_WALK, PEDMOVE_RUN, PEDMOVE_SPRINT };
+enum { OBJECTIVE_NONE, OBJECTIVE_GOTO_SEAT_ON_FOOT, OBJECTIVE_KILL_CHAR_ON_FOOT };
+struct CVector {
+    float x, y, z;
+    CVector(float x = 0, float y = 0, float z = 0) : x(x), y(y), z(z) {}
+};
+struct CEntity {
+    CVector pos;
+    CVector GetPosition(void) { return pos; }
+};
+'''
+
+WRAP = r'''
+struct SPed {
+    int m_nPedState;
+    int m_nMoveState;
+    int m_nStoredMoveState;
+    float m_fMoveSpeed;
+    int m_objective;
+    CEntity *m_pSeekTarget;
+    CVector m_vecSeekPos;
+    bool seekDone;
+    int cleared, restored, realAnim, idled;
+
+    SPed() : m_nPedState(PED_SEEK_ENTITY), m_nMoveState(PEDMOVE_RUN),
+             m_nStoredMoveState(PEDMOVE_STILL), m_fMoveSpeed(0),
+             m_objective(OBJECTIVE_NONE),
+             m_pSeekTarget(nil), seekDone(false), cleared(0), restored(0), realAnim(0), idled(0) {}
+
+    void ClearSeek(void) { m_nPedState = PED_IDLE; ++cleared; }
+    CVector GetPosition(void) { return CVector(); }
+    void SetRealMoveAnim(void) { ++realAnim; }
+    bool Seek(void) { return seekDone; }
+    void RestorePreviousState(void) { m_nPedState = PED_IDLE; ++restored; }
+    void SetIdle(void) { m_nPedState = PED_IDLE; ++idled; }
+    void SetMoveState(int s) { m_nMoveState = s; }
+    bool IsUseAttractorObjective(int obj) { return obj == OBJECTIVE_GOTO_SEAT_ON_FOOT; }
+
+    void Run(void) {
+        switch (m_nPedState) {
+        @CASE@
+        default: break;
+        }
+    }
+};
+'''
+
+
+def source():
+    return STUBS + WRAP.replace("@CASE@", case())
+
+
+class CopChaseSeekTests(unittest.TestCase):
+    def test_source_keeps_the_nil_guard_before_the_dereference(self):
+        body = case()
+        guard = body.index("if (!m_pSeekTarget)")
+        deref = body.index("m_vecSeekPos = m_pSeekTarget->GetPosition();")
+        self.assertLess(guard, deref)
+
+    def test_a_vanished_target_restores_instead_of_crashing(self):
+        run_cpp(source() + r'''
+int main(void) {
+    SPed ped;
+    ped.m_pSeekTarget = nil;
+    ped.Run();                            // pre-fix: reads nil + 0x40
+    if (ped.restored != 1) return 1;      // native RestorePreviousState
+    if (ped.m_nPedState != PED_IDLE) return 2;
+    if (ped.realAnim != 0) return 3;      // no move work on the way out
+    return 0;
+}
+''')
+
+    def test_a_live_target_drives_the_seek(self):
+        run_cpp(source() + r'''
+int main(void) {
+    SPed ped; CEntity target;
+    target.pos = CVector(12.0f, -4.0f, 9.0f);
+    ped.m_pSeekTarget = &target;
+    ped.seekDone = false;                 // still travelling
+    ped.Run();
+    if (ped.m_vecSeekPos.x != 12.0f || ped.m_vecSeekPos.y != -4.0f || ped.m_vecSeekPos.z != 9.0f) return 1;
+    if (ped.m_fMoveSpeed != 1.8f) return 2;   // PEDMOVE_RUN
+    if (ped.m_nStoredMoveState != ped.m_nMoveState) return 3;
+    if (ped.realAnim != 1) return 4;
+    if (ped.restored != 0 || ped.m_nPedState != PED_SEEK_ENTITY) return 5;
+    return 0;
+}
+''')
+
+    def test_arriving_restores_the_state_and_stops(self):
+        run_cpp(source() + r'''
+int main(void) {
+    SPed ped; CEntity target;
+    ped.m_pSeekTarget = &target;
+    ped.seekDone = true;
+    ped.Run();
+    if (ped.restored != 1) return 1;
+    if (ped.m_nMoveState != PEDMOVE_STILL) return 2;
+    if (ped.m_nPedState != PED_IDLE) return 3;
+    return 0;
+}
+''')
+
+    def test_source_consults_the_objective_before_restoring(self):
+        body = case()
+        guard = body.index("IsUseAttractorObjective(m_objective)")
+        restore = body.index("RestorePreviousState();", guard)
+        self.assertLess(guard, restore)
+
+    def test_arriving_at_an_attractor_hands_over_to_the_objective(self):
+        # native ProcessControl answers a seat/ATM arrival with SetIdle, so the
+        # objective layer can run the last approach, the turn onto the attractor
+        # heading and the sit/use wait state. Restoring the walk there made a
+        # wandering civilian ping-pong beside a bench and never sit.
+        run_cpp(source() + r'''
+int main(void) {
+    SPed ped; CEntity target;
+    ped.m_nPedState = PED_SEEK_POS;
+    ped.m_objective = OBJECTIVE_GOTO_SEAT_ON_FOOT;
+    ped.m_pSeekTarget = &target;
+    ped.seekDone = true;
+    ped.Run();
+    if (ped.idled != 1) return 1;         // the ped stays at the attractor
+    if (ped.restored != 0) return 2;      // not back to the walk
+    if (ped.m_nPedState != PED_IDLE) return 3;
+    return 0;
+}
+''')
+
+    def test_a_kill_seek_still_restores(self):
+        # the attractor branch must not swallow combat seeks (gang/cop chases)
+        run_cpp(source() + r'''
+int main(void) {
+    SPed ped; CEntity target;
+    ped.m_nPedState = PED_SEEK_POS;
+    ped.m_objective = OBJECTIVE_KILL_CHAR_ON_FOOT;
+    ped.m_pSeekTarget = &target;
+    ped.seekDone = true;
+    ped.Run();
+    if (ped.restored != 1) return 1;
+    if (ped.idled != 0) return 2;
+    if (ped.m_nMoveState != PEDMOVE_STILL) return 3;
+    return 0;
+}
+''')
+
+
+if __name__ == "__main__":
+    unittest.main()
