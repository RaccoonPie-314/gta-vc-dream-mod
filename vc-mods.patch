+    def test_the_stroll_yields_to_an_engine_wait_pose(self):
+        # the stroll wrote speed, move state and a walk clip every frame; the
+        # engine's wait pose (blocked-ped tired, after-kill hands-behind-back)
+        # was blended over about a second in, so it never played its full timer
+        stroll = braced(NPC, "void\nVCModNpcStrollGait(CPlayerPed *ped)")
+        run_cpp(r'''
+#include <cstdio>
+#include <cstdint>
+#define nil NULL
+typedef int8_t int8; typedef uint8_t uint8; typedef int16_t int16; typedef uint16_t uint16;
+typedef int32_t int32; typedef uint32_t uint32;
+enum { PEDMOVE_NONE, PEDMOVE_STILL, PEDMOVE_WALK, PEDMOVE_RUN, PEDMOVE_SPRINT };
+typedef int eMoveState;
+enum { WAITSTATE_FALSE = 0, WAITSTATE_STUCK = 1, WAITSTATE_DOUBLEBACK = 2 };
+template<class T> T Min(T a, T b) { return a < b ? a : b; }
+struct CTimer { static float GetTimeStep(void) { return 16.0f; } };
+struct CPlayerPed {
+    int m_nMoveState, m_nStoredMoveState, m_nWaitState;
+    float m_fMoveSpeed;
+    int anims;
+    CPlayerPed() : m_nMoveState(PEDMOVE_WALK), m_nStoredMoveState(PEDMOVE_WALK),
+                   m_nWaitState(WAITSTATE_FALSE), m_fMoveSpeed(1.0f), anims(0) {}
+    void SetRealMoveAnim(void) { ++anims; }
+};
+static float fVCModNpcStrollSpeed;
+''' + stroll + r'''
+int main(void) {
+    CPlayerPed p;
+    p.m_nWaitState = WAITSTATE_STUCK;
+    VCModNpcStrollGait(&p);
+    if (p.anims != 0) return 1;              // the pose owns the clips
+    if (p.m_fMoveSpeed != 0.0f) return 2;    // and the legs
+    p.m_nWaitState = WAITSTATE_DOUBLEBACK;
+    VCModNpcStrollGait(&p);
+    if (p.anims != 0) return 3;
+    p.m_nWaitState = WAITSTATE_FALSE;        // pose over: the stroll resumes
+    VCModNpcStrollGait(&p);
+    if (p.anims != 1) return 4;
+    if (p.m_fMoveSpeed <= 0.0f) return 5;
+    return 0;
+}
+''')
