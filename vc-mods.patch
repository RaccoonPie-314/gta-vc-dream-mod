+    g_playerStat.m_type = PEDSTAT_PLAYER; g_gangStat.m_type = PEDSTAT_GANG7;
+    g_playerStat.m_headingChangeRate = 15.0f; g_gangStat.m_headingChangeRate = 7.5f;
+    g_bodyStat.m_type = 99; g_bodyStat.m_headingChangeRate = 6.0f;
