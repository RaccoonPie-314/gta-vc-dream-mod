+#!/usr/bin/env python3
+"""Wheel-loss tests: the impulse threshold on its own, plus static checks that
+the drop goes through the engine's missing-wheel state and a real wheel object."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+WHEEL = ROOT / "src/extras/vcmodwheel.cpp"
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+AUTO_H = ROOT / "src/vehicles/Automobile.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    CHECK(!VCModWheelShouldDrop(25.0f), "a normal minimum impulse does nothing");
+    CHECK(!VCModWheelShouldDrop(400.0f), "a solid crash below the bar keeps its wheels");
+    CHECK(!VCModWheelShouldDrop(700.0f), "the bar itself is not enough");
+    CHECK(VCModWheelShouldDrop(701.0f), "past the bar the wheel goes");
+    CHECK(VCModWheelShouldDrop(1600.0f), "a top-speed hit certainly goes");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(name):
+    text = WHEEL.read_text()
+    match = re.search(r"((?:[A-Za-z_][A-Za-z0-9_]*[\s*]+)+)" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {WHEEL}")
+    start = match.start()
+    opening = match.end() - 1
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+def source():
+    text = WHEEL.read_text()
+    define = re.search(r"#define VCMOD_WHEEL_LOSS_IMPULSE\s+(\S+)", text)
+    if define is None:
+        raise AssertionError("VCMOD_WHEEL_LOSS_IMPULSE not found")
+    return (PRELUDE + f"#define VCMOD_WHEEL_LOSS_IMPULSE {define.group(1)}\n"
+            + cut("VCModWheelShouldDrop") + MAIN)
+
+
+class WheelTests(unittest.TestCase):
+    def test_threshold(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "wheel"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source(), text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_wiring(self):
+        auto = AUTO.read_text()
+        auto_h = AUTO_H.read_text()
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        ini = INI.read_text()
+
+        self.assertIn('"WHEEL FALLS OFF"', rows)
+        self.assertIn("&bVCModWheelLoss", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "WheelLoss"', ini)
+        self.assertIn("void DropWheel(uint16 piece, const CVector &impactPos, float impulse);", auto_h)
+
+        damage = braced(auto, "CAutomobile::VehicleDamage")
+        self.assertIn("VCModWheelShouldDrop(impulse)", damage)
+        self.assertIn("DropWheel(damagedPiece, pos, impulse)", damage)
+
+        drop = braced(auto, "CAutomobile::DropWheel")
+        self.assertIn("WHEEL_STATUS_MISSING", drop)
+        self.assertIn("SpawnFlyingComponent(node[slot], COMPGROUP_WHEEL)", drop)
+        # wheels have no damage-variant atomic ids, so SetComponentVisibility
+        # leaves them on screen; the render flag has to be cleared directly
+        self.assertNotIn("SetComponentVisibility(", drop)
+        self.assertIn("RpAtomicSetFlags(atomic, 0)", drop)
+        self.assertIn("GetCurrentAtomicObjectCB", drop)
+        self.assertIn("MI_RHINO", drop)
+        self.assertIn("bTyresDontBurst", drop)
+        # a body hit without a wheel piece takes the nearest wheel, never a random one
+        self.assertIn("MagnitudeSqr()", drop)
+        self.assertIn("slot < 0", drop)
+
+        # the wheel piece cases in the damage switch must stay no-ops: the drop is
+        # decided after the switch, where the impact position is known
+        self.assertIn("GetWheelStatus(status[slot]) == WHEEL_STATUS_MISSING", drop)
+
+
+if __name__ == "__main__":
+    unittest.main()
