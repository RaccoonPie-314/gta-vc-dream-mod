+#!/usr/bin/env python3
+"""AIM RAISE: a fresh lock enters the aim the way a ped does — the body sweeps
+onto the target at CPed::TurnBody's stare rate and the trigger is dead until the
+sweep and the aim pose land. The rate must be the ped's own, not a timer; target
+switching must not re-wind; the lock release owns the clear; NPCs never raise."""
+import pathlib
+import re
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PEDFIGHT = ROOT / "src/peds/PedFight.cpp"
+COMBAT = ROOT / "src/extras/vcmodcombat.cpp"
+PLAYERPED = ROOT / "src/peds/PlayerPed.cpp"
+PEDAI = ROOT / "src/peds/PedAI.cpp"
+HEADER = ROOT / "src/extras/vcmodcombat.h"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class AimRaiseTests(unittest.TestCase):
+    def test_a_fresh_lock_starts_the_raise(self):
+        lock = braced(PLAYERPED.read_text(), "CPlayerPed::FindWeaponLockOnTarget")
+        self.assertIn("VCModAimRaiseStart();", lock)
+        # it arms the raise only after the point-gun state exists
+        self.assertLess(lock.index("SetPointGunAt(nextTarget);"),
+                        lock.index("VCModAimRaiseStart();"))
+
+    def test_target_switching_does_not_rewind(self):
+        nxt = braced(PLAYERPED.read_text(), "CPlayerPed::FindNextWeaponLockOnTarget")
+        self.assertNotIn("VCModAimRaiseStart", nxt)
+
+    def test_the_raise_is_the_ped_turn(self):
+        weapon = braced(PLAYERPED.read_text(), "CPlayerPed::ProcessPlayerWeapon")
+        self.assertIn("VCModAimRaising()", weapon)
+        # the aimy branch runs the ped stare turn, not the instant body clamp
+        raise_at = weapon.index("if (VCModAimRaising())")
+        turn_at = weapon.index("TurnBody()")
+        clamp_at = weapon.index("RotatePlayerToTrackTarget();")
+        self.assertLess(raise_at, turn_at)
+        self.assertLess(turn_at, clamp_at)
+        # the walk owns the heading while he moves, the ped turn only plants him
+        self.assertIn("VCModAimHoldMoving(this)", weapon[raise_at:clamp_at])
+        # the raise ends on the turn's own done flag plus the visible pose, never
+        # on a wall-clock duration
+        self.assertIn("VCModAimPoseRaised(this)", weapon[raise_at:clamp_at])
+        self.assertRegex(weapon[raise_at:clamp_at], r"TurnBody\(\)\s*&&\s*VCModAimPoseRaised")
+        self.assertNotIn("GetTimeInMilliseconds", weapon[raise_at:clamp_at])
+        self.assertNotIn("CTimer", weapon[raise_at:clamp_at])
+
+    def test_the_trigger_waits_for_the_raise(self):
+        weapon = braced(PLAYERPED.read_text(), "CPlayerPed::ProcessPlayerWeapon")
+        self.assertEqual(weapon.count("SetAttack(m_pPointGunAt);"), 1)
+        # the gate is the module's call, not a read of the raise state
+        self.assertIn("if (VCModPlayerAttackAllowed())\n\t\t\t\t\tSetAttack(m_pPointGunAt);",
+                      weapon)
+        self.assertNotIn("!VCModAimRaising()", weapon)
+        gate = braced(COMBAT.read_text(), "VCModPlayerAttackAllowed")
+        self.assertIn("return !VCModAimRaising();", gate)
+
+    def test_moving_and_ducked_entries_end_the_raise(self):
+        # only a planted standing entry winds up: AIM WALK and the two-hand hold
+        # keep the gun lowered while he moves, so waiting on the pose there
+        # swallows every shot; the ducked entry poses a different clip
+        weapon = braced(PLAYERPED.read_text(), "CPlayerPed::ProcessPlayerWeapon")
+        raise_at = weapon.index("if (VCModAimRaising())")
+        block = weapon[raise_at:weapon.index("RotatePlayerToTrackTarget();", raise_at)]
+        ducked = block[block.index("bIsDucking"):block.index("VCModAimHoldMoving")]
+        self.assertIn("VCModAimRaiseStop();", ducked)
+        standing_end = block.rindex("VCModAimPoseRaised")
+        moving = block[block.index("\n", standing_end):]
+        self.assertNotIn("VCModAimPoseRaised", moving)
+        self.assertIn("VCModAimRaiseStop();", moving)
+
+    def test_the_free_camera_raise_leaves_the_heading_to_the_camera(self):
+        # the free mouse camera rewrites the ped heading every frame, so the
+        # TurnBody sweep can never land there; only the pose blend may gate fire
+        weapon = braced(PLAYERPED.read_text(), "CPlayerPed::ProcessPlayerWeapon")
+        raise_at = weapon.index("if (VCModAimRaising())")
+        block = weapon[raise_at:weapon.index("RotatePlayerToTrackTarget();", raise_at)]
+        free_at = block.index("VCModFreeAimCameraLock()")
+        turn_at = block.index("TurnBody()")
+        self.assertLess(free_at, turn_at)
+        branch = block[free_at:turn_at]
+        self.assertIn("VCModAimPoseRaised(this)", branch)
+        self.assertIn("VCModAimRaiseStop();", branch)
+
+    def test_the_raise_plays_the_clip_to_the_hold(self):
+        # a fresh lock plays the climb: a parked recovery tail is played back and
+        # a cold clip runs its own raise frames; the stock snap only runs when no
+        # raise owns the clip
+        point = braced(PEDFIGHT.read_text(), "CPed::PointGunAt(void)")
+        self.assertIn("bool raising = IsPlayer() && VCModAimRaising();", point)
+        self.assertIn("weaponAssoc->speed = -1.0f;", point)
+        self.assertIn("VCModAimRaiseHoldLanded();", point)
+        # the hold park is what the trigger waits for
+        pose = braced(COMBAT.read_text(), "VCModAimPoseRaised(CPed *ped)")
+        self.assertIn("bVCModAimHoldLanded", pose)
+        start = braced(COMBAT.read_text(), "VCModAimRaiseStart(void)")
+        self.assertIn("bVCModAimHoldLanded = false;", start)
+        tails = braced(COMBAT.read_text(), "VCModCombatClearTails(CPed *ped)")
+        self.assertIn("bVCModAimHoldLanded = false;", tails)
+
+    def test_the_lock_release_owns_the_clear(self):
+        clear = braced(PEDFIGHT.read_text(), "CPed::ClearPointGunAt(void)")
+        self.assertIn("VCModCombatClearTails(this);", clear)
+        tails = braced(COMBAT.read_text(), "VCModCombatClearTails(CPed *ped)")
+        self.assertIn("bVCModAimRaising = false;", tails)
+        self.assertIn("IsPlayer()", tails)
+
+    def test_the_pose_is_raised_when_the_gun_is_up(self):
+        feet = COMBAT.read_text()
+        pose = braced(feet, "VCModAimPoseRaised(CPed *ped)")
+        self.assertIn("VCModCopAimAnim(ped, info)", pose)
+        self.assertIn("blendAmount >= 1.0f", pose)
+        # a missing clip cannot hold the trigger hostage
+        self.assertIn("assoc == nil", pose)
+
+    def test_the_trigger_state_has_no_timer(self):
+        feet = COMBAT.read_text()
+        start = feet.index("VCModAimRaiseStart(void)")
+        state = feet[start:feet.index("VCModAimPoseRaised(CPed *ped)")]
+        self.assertNotIn("GetTimeInMilliseconds", state)
+        self.assertNotIn("CTimer", state)
+        self.assertIn("void VCModAimRaiseStart(void);", HEADER.read_text())
+        self.assertIn("void VCModAimRaiseStop(void);", HEADER.read_text())
+
+    def test_npcs_never_raise(self):
+        for source in (PEDAI.read_text(), (ROOT / "src/peds/Ped.cpp").read_text()):
+            self.assertNotIn("VCModAimRaiseStart", source)
+
+
+if __name__ == "__main__":
+    unittest.main()
