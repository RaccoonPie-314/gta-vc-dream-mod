+#!/usr/bin/env python3
+"""Cockpit view: no camera is written here. CAM_ZOOM_1STPRS is already a stop on
+the vehicle camera ring and the stock code turns it into MODE_1STPERSON at the
+front seat. The mod only moves the ring — key, panel row and nothing else."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+FP = ROOT / "src/extras/vcmodfirstperson.cpp"
+CAM = ROOT / "src/core/Cam.cpp"
+CAMERA = ROOT / "src/core/Camera.cpp"
+GAME = ROOT / "src/core/Game.cpp"
+INI = ROOT / "src/core/re3.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+KEYS_H = ROOT / "src/extras/vcmodkeys.h"
+
+
+class FirstPersonTests(unittest.TestCase):
+    def test_moves_the_stock_ring_stop(self):
+        fp = FP.read_text()
+        self.assertIn("TheCamera.CarZoomIndicator == CAM_ZOOM_1STPRS", fp)
+        self.assertIn("TheCamera.CarZoomIndicator = on ? CAM_ZOOM_1STPRS : CAM_ZOOM_2;", fp)
+
+    def test_no_camera_mode_is_written_by_the_mod(self):
+        # the stock branch owns MODE_1STPERSON; a second writer would fight it
+        camera = CAMERA.read_text()
+        self.assertNotIn("bVCModCarFirstPerson", camera)
+        self.assertNotIn("vcmodfirstperson", camera)
+
+    def test_tick_reads_its_own_key_before_the_camera(self):
+        fp = FP.read_text()
+        self.assertIn("aVCModKeys[VCKEY_FIRSTPERSON]", fp)
+        self.assertIn("if (VCModKeyCapturing())", fp)
+        self.assertLess(fp.index("if (VCModKeyCapturing())"), fp.index("IsKeyboardKeyJustDown"))
+        game = GAME.read_text()
+        tick = game.index("VCModCarFirstPersonTick();")
+        self.assertLess(tick, game.index("TheCamera.Process();", tick))
+
+    def test_view_sits_at_the_back_of_the_bonnet(self):
+        # the car body is a shell: from the seat there is no car in the frame
+        cam = CAM.read_text()
+        start = cam.index("// A Vice City car body is a shell")
+        block = cam[start:cam.index("\n\t}\n", start)]
+        self.assertIn("VCModCarFirstPersonOn()", block)
+        self.assertIn("m_vehType == VEHICLE_TYPE_CAR", block)
+        # anchored on the car's bonnet node, with a seat-relative fallback
+        self.assertIn("GetComponentWorldPosition(CAR_BONNET, bonnet);", block)
+        self.assertIn("Source = bonnet + Up*0.22f - Front*0.12f;", block)
+        self.assertIn("bonnet.y += 0.8f;", block)
+        self.assertIn("bonnet.z += 0.55f;", block)
+        # the seat camera is still built first, for bikes and boats
+        self.assertGreater(start, cam.index("CVector CamPos = mi->GetFrontSeatPosn();"))
+
+    def test_panel_row_is_the_same_ring(self):
+        panel = PANEL
+        self.assertIn('{ "1ST PERSON",      VCMOD_ROW_CYCLE,   nil,                   '
+                      '"CarFirstPerson", VCMOD_PAGE_DRIVING, &aVCModFirstPersonCycle,', panel)
+        self.assertIn("return VCModCarFirstPersonOn();", panel)
+        self.assertIn("VCModCarFirstPersonSet(value != 0);", panel)
+        self.assertIn('TWEAKFUNCN(VCModCarFirstPersonToggle, "1st person car camera");', panel)
+        self.assertIn('{ "1ST PERSON KEY",  VCMOD_ROW_KEY,', panel)
+        self.assertIn("VCKEY_FIRSTPERSON", KEYS_H.read_text())
+
+    def test_keys_read_through_the_ini(self):
+        ini = INI.read_text()
+        self.assertIn('ReadIniIfExists("VC Mods", "KeyFirstPerson", '
+                      '&aVCModKeys[VCKEY_FIRSTPERSON]);', ini)
+
+
+if __name__ == "__main__":
+    unittest.main()
