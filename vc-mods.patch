+#ifdef LOAD_INI_SETTINGS
+// one file write for a change that may have touched several pinned rows
+void
+VCModSavePins(void)
+{
+	bool any = false;
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++)
+		if (VCModRowPinned(&aVCModRows[i]))
+			any = true;
+	if (!any)
+		return;
+
+	VCModPersistPinned();
+	if (!IniFlush())
+		fprintf(stderr, "VCMOD could not write reVC.ini\n");
+}
+
+// the pin cell: a key in [VC Mods] is the whole record, so pinning writes the
+// current value now and unpinning deletes the key
+void
+VCModTogglePin(const VCModRowDef *row)
+{
+	if (row->iniKey == nil)
+		return;
+
+	if (VCModRowPinned(row)) {
+		IniRemoveKey("VC Mods", row->iniKey);
+		fprintf(stderr, "VCMOD unpinned %s\n", row->name);
+	} else {
+		IniStoreKey("VC Mods", row->iniKey, VCModRowValue(row));
+		fprintf(stderr, "VCMOD pinned %s = %d\n", row->name, (int) VCModRowValue(row));
+	}
+
+	VCModPersistPinned();
+	if (!IniFlush())
+		fprintf(stderr, "VCMOD could not write reVC.ini\n");
+}
+#else
+void VCModSavePins(void) {}
+void VCModTogglePin(const VCModRowDef *row) {}
+#endif
