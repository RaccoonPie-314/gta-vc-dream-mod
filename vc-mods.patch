+
+static char aVCModPedLabel[32];
+
+static const char *
+VCModPedDisplayName(const char *modelName)
+{
+	uint32 i;
+
+	if (modelName == nil || modelName[0] == '\0')
+		return "unknown";
+
+	for (i = 0; i < ARRAY_SIZE(aVCModPedNames); i++)
+		if (!CGeneral::faststricmp(modelName, aVCModPedNames[i].model))
+			return aVCModPedNames[i].label;
+
+	// hfyst is race + sex + age + clothing: Hispanic, female, young, street.
+	if (strlen(modelName) == 5) {
+		char race = tolower((unsigned char) modelName[0]);
+		char sex = tolower((unsigned char) modelName[1]);
+		char age = tolower((unsigned char) modelName[2]);
+		char code0 = tolower((unsigned char) modelName[3]);
+		char code1 = tolower((unsigned char) modelName[4]);
+		const char *raceName = nil;
+		const char *person = nil;
+
+		switch (race) {
+		case 'h': raceName = "Hispanic"; break;
+		case 'b': raceName = "Black"; break;
+		case 'w': raceName = "White"; break;
+		case 'j': raceName = "Japanese"; break;
+		}
+		if (sex == 'm')
+			person = age == 'y' ? "guy" : age == 'o' ? "man" : nil;
+		else if (sex == 'f')
+			person = age == 'y' ? "girl" : age == 'o' ? "woman" : nil;
+
+		if (raceName != nil && person != nil) {
+			for (i = 0; i < ARRAY_SIZE(aVCModPedStyles); i++) {
+				if (code0 == aVCModPedStyles[i].code[0] &&
+				    code1 == aVCModPedStyles[i].code[1]) {
+					snprintf(aVCModPedLabel, sizeof(aVCModPedLabel),
+						"%s %s, %s", raceName, person, aVCModPedStyles[i].style);
+					return aVCModPedLabel;
+				}
+			}
+			snprintf(aVCModPedLabel, sizeof(aVCModPedLabel), "%s %s", raceName, person);
+			return aVCModPedLabel;
+		}
+	}
+
+	// a modded IDE gets its own name back rather than an empty row
+	snprintf(aVCModPedLabel, sizeof(aVCModPedLabel), "%.28s", modelName);
+	return aVCModPedLabel;
+}
+
+static const char *
+VCModCurrentPedLabel(void)
+{
+	int16 modelIndex = VCModCurrentPedModel();
+	if (modelIndex == MI_PLAYER)
+		return "Tommy Vercetti";
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil)
+		return "unknown";
+	return VCModPedDisplayName(mi->GetModelName());
+}
+
+static const char *
+VCModDriverCell(void)
+{
+	switch (VCModRidePhase()) {
+	case VCMOD_RIDE_APPROACH:	return "[EN ROUTE]  H dismiss";
+	case VCMOD_RIDE_PICKUP:		return "[WAITING]   H dismiss";
+	case VCMOD_RIDE_BOARDING:	return "[BOARDING]";
+	case VCMOD_RIDE_DRIVING:	return "[DRIVING]   H dismiss";
+	}
+	return "[CALL]      H";
+}
+
+static const char *
+VCModListLabel(int32 list, int32 entry, bool *selected)
+{
+	static char missing[24];
+
+	switch (list) {
+	case VCMOD_LIST_ANIM:
+		*selected = entry == nVCModAnimChoice;
+		return aVCModAnimGroupNames[entry];
+	case VCMOD_LIST_PEDCAT:
+		*selected = entry == nVCModPedCategory;
+		return aVCModPedCategoryNames[entry];
+
+	case VCMOD_LIST_RIDESTYLE:
+		*selected = entry == nVCModRideStyle;
+		return aVCModRideStyleNames[entry];
+
+	case VCMOD_LIST_RIDEZONE: {
+		int32 zoneIndex;
+		const char *name;
+		if (!VCModRideZoneAt(entry, &zoneIndex, &name, nil))
+			return "unknown";
+		// the stored value is the zone index, and cruise is -1 rather than entry 0
+		*selected = zoneIndex == nVCModRideZone;
+		return name;
+	}
+	}
+
+	int16 modelIndex = MI_PLAYER;
+	const char *name = nil;
+	if (!VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name) || name == nil) {
+		snprintf(missing, sizeof(missing), "model %d", (int) entry);
+		*selected = false;
+		return missing;
+	}
+	*selected = modelIndex == VCModCurrentPedModel();
+	return VCModPedDisplayName(name);
+}
+
+static void
+VCModListPick(int32 list, int32 entry)
+{
+	switch (list) {
+	case VCMOD_LIST_ANIM:
+		nVCModAnimChoice = entry;
+		bVCModPlayerNpcAnims = true;
+		VCModRollPlayerPace();
+		break;
+
+	case VCMOD_LIST_PEDCAT:
+		nVCModPedCategory = entry;
+		nVCModListScroll = 0;
+		break;
+
+	case VCMOD_LIST_RIDESTYLE:
+		nVCModRideStyle = entry;
+		break;
+
+	case VCMOD_LIST_RIDEZONE: {
+		int32 zoneIndex;
+		if (VCModRideZoneAt(entry, &zoneIndex, nil, nil))
+			nVCModRideZone = zoneIndex;
+		break;
+	}
+
+	default: {
+		// the swap streams models and destroys clumps, so it waits for the update
+		// pass rather than running inside the render
+		int16 modelIndex;
+		const char *name;
+		if (VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name))
+			nVCModPedModel = modelIndex;
+		break;
+	}
+	}
+	nVCModOpenList = VCMOD_LIST_NONE;
+}
+
+static void
+VCModTriangle(RwCamera *cam, float x0, float y0, float x1, float y1, float x2, float y2,
+	uint8 r, uint8 g, uint8 b)
+{
+	RwIm2DVertex verts[3];
+	float recipz = 1.0f / RwCameraGetNearClipPlane(cam);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+
+	RwIm2DVertexSetScreenX(&verts[0], x0);
+	RwIm2DVertexSetScreenY(&verts[0], y0);
+	RwIm2DVertexSetScreenZ(&verts[0], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[0], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[0], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[0], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[1], x1);
+	RwIm2DVertexSetScreenY(&verts[1], y1);
+	RwIm2DVertexSetScreenZ(&verts[1], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[1], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[1], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[1], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[2], x2);
+	RwIm2DVertexSetScreenY(&verts[2], y2);
+	RwIm2DVertexSetScreenZ(&verts[2], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[2], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[2], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[2], r, g, b, 255);
+
+	RwIm2DRenderPrimitive(rwPRIMTYPETRILIST, verts, 3);
+}
+
+// a charset "+" was unreadably small, so the pointer is geometry: a filled arrow
+// with a dark edge that stays visible on both the panel and the sky
+static void
+VCModDrawCursor(RwCamera *cam)
+{
+	int32 x = (int32) fVCModCursorX;
+	int32 y = (int32) fVCModCursorY;
+
+	VCModTriangle(cam, x - 2.0f, y - 2.0f, x - 2.0f, y + 22.0f, x + 16.0f, y + 12.0f, 8, 8, 12);
+	VCModTriangle(cam, (float) x, (float) y, (float) x, y + 19.0f, x + 14.0f, y + 10.0f, 255, 255, 255);
+}
+
+// the two-finger scroll is the only gesture the trackpad has left once aiming
+// owns the hold, so it is what moves through a list
+static void
+VCModScroll(CPad *pad)
+{
+	if (nVCModOpenList == VCMOD_LIST_NONE)
+		return;
+
+	int32 max = VCModListCount(nVCModOpenList) - VCMOD_LIST_ROWS;
+	if (max < 0)
+		max = 0;
+
+	if (pad->GetMouseWheelUpJustDown())
+		nVCModListScroll--;
+	if (pad->GetMouseWheelDownJustDown())
+		nVCModListScroll++;
+	if (nVCModListScroll < 0)
+		nVCModListScroll = 0;
+	if (nVCModListScroll > max)
+		nVCModListScroll = max;
+
+	// browsing the roster must not cycle weapons underneath the cursor
+	pad->NewMouseControllerState.WHEELUP = false;
+	pad->NewMouseControllerState.WHEELDN = false;
+}
+
+static void
+VCModClick(CPad *pad)
+{
+	if (!(pad->NewMouseControllerState.LMB && !pad->OldMouseControllerState.LMB))
+		return;
+
+	if (nVCModOpenList != VCMOD_LIST_NONE) {
+		int32 anchor = VCModListAnchorRow(nVCModOpenList);
+		int32 first = VCModListFirst(nVCModOpenList);
+		int32 count = VCModListCount(nVCModOpenList);
+		if (count > first + VCMOD_LIST_ROWS)
+			count = first + VCMOD_LIST_ROWS;
+
+		for (int32 entry = first; entry < count; entry++) {
+			if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCModListX(),
+					VCModListRowY(anchor, entry - first), VCMOD_VALUE_COLS * nVCModCharW, nVCModCharH))
+				continue;
+
+			VCModListPick(nVCModOpenList, entry);
+			return;
+		}
+	}
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCMOD_PANEL_X, VCModRowY(i), rowW, nVCModCharH))
+			continue;
+
+		switch (aVCModRows[i].kind) {
+		case VCMOD_ROW_FLAG:
+		case VCMOD_ROW_ADRENALINE_MODE:
+			*aVCModRows[i].state = !*aVCModRows[i].state;
+			break;
+		case VCMOD_ROW_ANIMSET:
+		case VCMOD_ROW_PEDCAT:
+		case VCMOD_ROW_PEDCHAR:
+		case VCMOD_ROW_RIDEZONE:
+		case VCMOD_ROW_RIDESTYLE: {
+			int32 want = VCModRowList(aVCModRows[i].kind);
+			nVCModOpenList = nVCModOpenList == want ? VCMOD_LIST_NONE : want;
+			nVCModListScroll = 0;
+			break;
+		}
+		case VCMOD_ROW_CALLDRIVER:
+			VCModCallDriver();
+			break;
+		case VCMOD_ROW_SKIPRIDE:
+			VCModSkipRide();
+			break;
+		case VCMOD_ROW_MASTER:
+			VCModToggleAll();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+
+	nVCModOpenList = VCMOD_LIST_NONE;
+}
+
+void
+VCModPanelRender(void)
+{
+	CPad *pad = CPad::GetPad(0);
+	if (pad == nil)
+		return;
+
+	// the debug menu's page column occupies the same corner, so it wins while open
+	if (DebugMenuIsActive())
+		return;
+
+	if (ControlsManager.GetIsKeyboardKeyJustDown((RsKeyCodes)'\\'))
+		bVCModPanelOpen = !bVCModPanelOpen;
+	if (!bVCModPanelOpen) {
+		nVCModOpenList = VCMOD_LIST_NONE;
+		return;
+	}
+
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+
+	RwCamera *cam = RwCameraGetCurrentCamera();
+	if (cam == nil)
+		return;
+	int32 screenW = RwRasterGetWidth(RwCameraGetRaster(cam));
+	int32 screenH = RwRasterGetHeight(RwCameraGetRaster(cam));
+
+	if (aVCModFonts[VCFONT_LABEL] == nil) {
+		VCModMakeFonts();
+		if (aVCModFonts[VCFONT_LABEL] == nil)
+			return;
+	}
+
+	VCModUpdateMouse(pad, screenW, screenH);
+	VCModScroll(pad);
+	VCModClick(pad);
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	int32 fullCols = rowW / nVCModCharW;
+	VCModCell(VCFONT_TITLE, " VC MODS ", VCMOD_PANEL_X, VCMOD_PANEL_Y, fullCols);
+
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		int32 y = VCModRowY(i);
+		int32 style = VCFONT_OFF;
+		const char *value = "[--]";
+		char holdCell[16];
+
+		switch (aVCModRows[i].kind) {
+		case VCMOD_ROW_FLAG:
+			if (*aVCModRows[i].state) {
+				style = VCFONT_ON;
+				value = "[ON]";
+				if (aVCModRows[i].state == &bVCModCopPistol) {
+					snprintf(holdCell, sizeof(holdCell), "[ON  f%d]", nVCModCopHoldFrame);
+					value = holdCell;
+				}
+			}
+			break;
+
+		case VCMOD_ROW_ANIMSET:
+			style = VCFONT_SET;
+			value = aVCModAnimGroupNames[nVCModAnimChoice];
+			break;
+
+		case VCMOD_ROW_PEDCAT:
+			style = VCFONT_SET;
+			value = aVCModPedCategoryNames[nVCModPedCategory];
+			break;
+
+		case VCMOD_ROW_PEDCHAR:
+			style = VCFONT_SET;
+			value = VCModCurrentPedLabel();
+			break;
+
+		case VCMOD_ROW_RIDEZONE: {
+			const char *name;
+			style = VCFONT_SET;
+			value = VCModRideZoneAt(nVCModRideZone < 0 ? 0 : nVCModRideZone, nil, &name, nil) ?
+				name : "traffic (cruise)";
+			break;
+		}
+
+		case VCMOD_ROW_RIDESTYLE:
+			style = VCFONT_SET;
+			value = aVCModRideStyleNames[nVCModRideStyle];
+			break;
+
+		case VCMOD_ROW_SKIPRIDE: {
+			int32 zoneIndex;
+			bool hasDestination = VCModRideZoneAt(nVCModRideZone, &zoneIndex, nil, nil) && zoneIndex >= 0;
+			style = hasDestination ? VCFONT_SET : VCFONT_WARN;
+			value = hasDestination ? "[JUMP]  to RIDE TO" : "[--]  pick RIDE TO";
+			break;
+		}
+
+		case VCMOD_ROW_CALLDRIVER:
+			style = VCModRidePhase() == VCMOD_RIDE_NONE ? VCFONT_OFF : VCFONT_ON;
+			value = VCModDriverCell();
+			break;
+
+		case VCMOD_ROW_ADRENALINE_MODE:
+			style = VCFONT_SET;
+			value = bVCModAdrenalineSlowMo ? "[SLOW-MO]  click to switch" : "[NORMAL]   click to switch";
+			break;
+
+		case VCMOD_ROW_PATHPROBE_NODE:
+			style = VCFONT_SET;
+			value = VCModPathProbeNodeCell();
+			break;
+
+		case VCMOD_ROW_PATHPROBE_LANE:
+			style = VCFONT_SET;
+			value = VCModPathProbeLaneCell();
+			break;
+
+		case VCMOD_ROW_MASTER: {
+			int32 n = VCModCountOn();
+			if (n == (int32) ARRAY_SIZE(aVCModSwitched)) {
+				style = VCFONT_ON;
+				value = "[ALL ON]";
+			} else if (n == 0) {
+				value = "[ALL OFF]";
+			} else {
+				style = VCFONT_WARN;
+				value = "[MIXED]";
+			}
+			break;
+		}
+		}
+
+		VCModCell(VCFONT_LABEL, aVCModRows[i].name, VCMOD_PANEL_X, y, VCMOD_NAME_COLS);
+		VCModCell(style, value, VCMOD_PANEL_X + VCMOD_NAME_COLS*nVCModCharW, y, VCMOD_VALUE_COLS);
+
+		// the affordance that this row opens a list rather than flipping anything
+		int32 rowList = VCModRowList(aVCModRows[i].kind);
+		if (rowList != VCMOD_LIST_NONE)
+			VCModPrint(VCFONT_MARK, nVCModOpenList == rowList ? "-" : "+",
+				VCMOD_PANEL_X + rowW + nVCModCharW, y);
+	}
+
+	if (nVCModOpenList != VCMOD_LIST_NONE) {
+		int32 anchor = VCModListAnchorRow(nVCModOpenList);
+		int32 first = VCModListFirst(nVCModOpenList);
+		int32 count = VCModListCount(nVCModOpenList);
+		int32 last = count;
+		if (last > first + VCMOD_LIST_ROWS)
+			last = first + VCMOD_LIST_ROWS;
+
+		for (int32 entry = first; entry < last; entry++) {
+			bool selected = false;
+			const char *label = VCModListLabel(nVCModOpenList, entry, &selected);
+			int32 listY = VCModListRowY(anchor, entry - first);
+			VCModCell(selected ? VCFONT_ON : VCFONT_SET, label, VCModListX(), listY, VCMOD_VALUE_COLS);
+			if (selected)
+				VCModPrint(VCFONT_ON, ">", VCModListX() - nVCModCharW, listY);
+		}
+
+		// the roster is longer than one list, so mark the directions scroll has left
+		if (count > VCMOD_LIST_ROWS) {
+			int32 markX = VCModListX() + VCMOD_VALUE_COLS * nVCModCharW;
+			if (first > 0)
+				VCModPrint(VCFONT_MARK, "^", markX, VCModListRowY(anchor, 0));
+			if (last < count)
+				VCModPrint(VCFONT_MARK, "v", markX, VCModListRowY(anchor, last - first - 1));
+		}
+	}
+
+	int32 y = VCModRowY((int32) ARRAY_SIZE(aVCModRows));
+	if (bVCModNoScopedAim && !bVCModAimAllWeapons)
+		VCModCell(VCFONT_WARN, "! sniper needs AIM ALL WEAPONS", VCMOD_PANEL_X, y++, fullCols);
+	if (!bVCModMouseAimLockOn && CCamera::m_bUseMouse3rdPerson)
+		VCModCell(VCFONT_WARN, "! two-finger hold does nothing", VCMOD_PANEL_X, y++, fullCols);
+
+	VCModCell(VCFONT_HINT, "G fire B walk H driver K spin \\ panel ctrl-M cheats", VCMOD_PANEL_X, y, fullCols);
+
+	// charset glyphs go through the buffered path, so flush them before the cursor
+	// geometry or the pointer ends up underneath the panel
+	RtCharsetBufferFlush();
+	VCModDrawCursor(cam);
+}
+#endif
