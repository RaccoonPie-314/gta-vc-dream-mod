+	weapon->m_eWeaponState = WEAPONSTATE_RELOADING;
+	weapon->m_nTimer = now + (fast ? info->m_nReload / 4 : info->m_nReload);
+
+	if (fast || GetReloadAnim(info) == 0)
+		return;
+
+	// the automatic reload only starts at the end of a fire animation; a manual
+	// one has to move the ped into the same pose itself
+	CAnimBlendAssociation *reloadAssoc = CAnimManager::BlendAnimation(GetClump(),
+		info->m_AnimToPlay,
+		bIsDucking && GetCrouchReloadAnim(info) ? GetCrouchReloadAnim(info) : GetReloadAnim(info),
+		8.0f);
+	reloadAssoc->SetFinishCallback(FinishedReloadCB, this);
+	ClearLookFlag();
+	ClearAimFlag();
+	bIsAttacking = false;
+	bIsPointingGunAt = false;
+	m_shootTimer = now;
+	DMAudio.PlayOneShot(m_audioEntityId, SOUND_WEAPON_AK47_BULLET_ECHO, weapon->m_eWeaponType);
