@@ -0,0 +1,211 @@
+#!/usr/bin/env python3
+"""Gun recovery: the tail predicate every firearm shares, plus the wiring that
+lets the player play the tail NPCs always run. The two-hand colt keeps its own
+tail and must not be routed through this switch."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PEDFIGHT = ROOT / "src/peds/PedFight.cpp"
+COMBAT = ROOT / "src/extras/vcmodcombat.cpp"
+PED = ROOT / "src/peds/Ped.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+#include <string.h>
+typedef int int32;
+#define nil 0
+static bool bVCModWeaponRecovering;
+
+bool bVCModWeaponRecovery = true;
+bool copPose = false;
+
+struct CWeaponInfo {};
+struct CPed {
+    bool player;
+    bool bIsDucking;
+    bool IsPlayer() const { return player; }
+};
+bool VCModCopTwoHandPose(CPed *, CWeaponInfo *) { return copPose; }
+
+struct CAnimBlendHierarchy { float totalLength; };
+struct CAnimBlendAssociation { CAnimBlendHierarchy *hierarchy; };
+
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    CPed player = { true, false };
+    CPed cop = { false, false };
+    CWeaponInfo gun;
+    CAnimBlendHierarchy longClip = { 1.93f };
+    CAnimBlendHierarchy shortClip = { 0.60f };
+    CAnimBlendHierarchy noTail = { 0.645f };
+    CAnimBlendAssociation withTail = { &longClip };
+    CAnimBlendAssociation withoutTail = { &shortClip };
+    CAnimBlendAssociation exactlyCut = { &noTail };
+    CAnimBlendAssociation noHier = { nil };
+
+    bVCModWeaponRecovery = true;
+    copPose = false;
+    CHECK(VCModWeaponRecoveryWanted(&player, &gun, &withTail, 0.6f),
+          "a firearm clip with a tail gets the recovery");
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, &withoutTail, 0.6f),
+          "a clip that ends on the loop end has nothing to play");
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, &exactlyCut, 0.6f),
+          "a tail no longer than the cut is not a recovery");
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, nil, 0.6f), "no clip, no tail");
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, &noHier, 0.6f), "no hierarchy, no tail");
+
+    CHECK(!VCModWeaponRecoveryWanted(&cop, &gun, &withTail, 0.6f),
+          "NPCs run their own tails and keep them");
+
+    copPose = true;
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, &withTail, 0.6f),
+          "the two-hand colt keeps its own tail");
+    copPose = false;
+
+    player.bIsDucking = true;
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, &withTail, 0.6f),
+          "the crouch fire clip parks its own duck idle");
+    player.bIsDucking = false;
+
+    bVCModWeaponRecovery = false;
+    CHECK(!VCModWeaponRecoveryWanted(&player, &gun, &withTail, 0.6f),
+          "the row off parks on the loop end like stock");
+    bVCModWeaponRecovery = true;
+
+    bVCModWeaponRecovering = false;
+    CHECK(!VCModWeaponRecovering(), "idle recovery is off");
+    bVCModWeaponRecovering = true;
+    CHECK(VCModWeaponRecovering(), "the tail owns the arms while it runs");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(text, name):
+    match = re.search(r"(?m)^(?:static\s+)?bool\s*\n" + re.escape(name) + r"\(", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {COMBAT}")
+    opening = text.index("{", match.end())
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[match.start():i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+class WeaponRecoveryTests(unittest.TestCase):
+    def test_tail_predicate(self):
+        text = COMBAT.read_text()
+        const = re.search(r"static const float VCModCopRecoverCut[^;]*;", text).group(0)
+        source = PRELUDE + const + "\n" + "\n".join(
+            cut(text, name) for name in ("VCModWeaponRecoveryWanted", "VCModWeaponRecovering")) + MAIN
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "recover"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source, text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_burst_end_hands_the_tail_to_point_gun(self):
+        attack = braced(PEDFIGHT.read_text(), "CPed::Attack(void)")
+        start = attack.index("GetWeapon()->m_eWeaponState != WEAPONSTATE_RELOADING")
+        aim = attack[start:]
+        self.assertIn("VCModCombatArmRecovery(this, ourWeapon, weaponAnimAssoc, animLoopEnd)", aim)
+        # the parked hold is the fallback, not what the player gets with the row on
+        self.assertIn("weaponAnimAssoc->SetCurrentTime(animLoopEnd);", aim)
+        self.assertLess(aim.index("VCModCombatArmRecovery"), aim.index("SetCurrentTime(animLoopEnd)"))
+
+        arm = braced(COMBAT.read_text(), "VCModCombatArmRecovery(CPed *ped,")
+        self.assertIn("VCModWeaponRecoveryWanted(ped, info, assoc, loopEnd)", arm)
+        self.assertIn("bVCModWeaponRecovering = true;", arm)
+        # the two-hand colt is decided first and keeps its own path
+        self.assertLess(arm.index("VCModCopTwoHandPose(ped, info)"),
+                        arm.index("bVCModWeaponRecovering = true;"))
+
+    def test_new_burst_outranks_the_tail(self):
+        attack = braced(PEDFIGHT.read_text(), "CPed::Attack(void)")
+        self.assertIn("VCModCombatNewBurst(this, ourWeapon, weaponAnimAssoc, attackShouldContinue, animLoopStart, animLoopEnd)", attack)
+        # the rewind has to land before the fire branch reads the clip time
+        self.assertLess(attack.index("VCModCombatNewBurst"), attack.index("float animStart"))
+
+        abort = braced(COMBAT.read_text(), "VCModCombatNewBurst(CPed *ped,")
+        self.assertIn("SetCurrentTime(loopStart)", abort)
+        self.assertIn("SetRun()", abort)
+        self.assertIn("stillAttacking", abort)
+        self.assertIn("bVCModWeaponRecovering = false;", abort)
+        self.assertIn("!VCModCopTwoHandPose(ped, info)", abort)
+
+    def test_point_gun_parks_only_after_the_tail(self):
+        # the engine hands the aim frame to the module and returns when it owns
+        engine = braced(PEDFIGHT.read_text(), "CPed::PointGunAt(void)")
+        self.assertIn("if (VCModCombatAimTick(this, weaponInfo, weaponAssoc))", engine)
+        point = braced(COMBAT.read_text(), "VCModCombatAimTick(CPed *ped,")
+        tail = point[point.index("bVCModWeaponRecovering"):]
+        tail = tail[:tail.index("bVCModWeaponRecovering = false;")]
+        # the tail runs to its end, and that lowered end is the hold
+        self.assertIn("weaponAssoc->IsRunning()", tail)
+        self.assertIn("return true;", tail)
+        # the clip's own fadeout would raise the arm again; the hold cancels it
+        self.assertIn("ASSOC_DELETEFADEDOUT", tail)
+        self.assertIn("SetBlend(1.0f, 0.0f)", tail)
+        # the aim frame is never re-seeked while holding
+        self.assertNotIn("SetCurrentTime(animLoopStart)", tail)
+        # a recovery only exists off the two-hand pose
+        self.assertIn("VCModCopTwoHandPose(ped, weaponInfo)", point)
+        self.assertLess(point.index("VCModCopTwoHandPose(ped, weaponInfo)"),
+                        point.index("bVCModWeaponRecovering"))
+
+    def test_leaving_the_aim_ends_the_tail(self):
+        clear = braced(PEDFIGHT.read_text(), "CPed::ClearPointGunAt(void)")
+        self.assertIn("VCModCombatClearTails(this);", clear)
+        tails = braced(COMBAT.read_text(), "VCModCombatClearTails(CPed *ped)")
+        self.assertIn("bVCModCopRecovering = false;", tails)
+        self.assertIn("bVCModWeaponRecovering = false;", tails)
+
+    def test_aim_does_not_fight_the_tail(self):
+        aim_gun = braced(PED.read_text(), "CPed::AimGun(void)")
+        self.assertIn("VCModWeaponRecovering()", aim_gun)
+        self.assertIn("m_pedIK.m_flags &= ~CPedIK::AIMS_WITH_ARM", aim_gun)
+
+    def test_row_and_ini(self):
+        panel = PANEL
+        self.assertIn('{ "GUN RECOVERY",    VCMOD_ROW_FLAG,    &bVCModWeaponRecovery, "WeaponRecovery", VCMOD_PAGE_COMBAT,', panel)
+        self.assertIn("bool bVCModWeaponRecovery = true;", COMBAT.read_text())
+        self.assertNotIn("bool bVCModWeaponRecovery", panel)
+        self.assertIn("TWEAKBOOL(bVCModWeaponRecovery);", panel)
+        self.assertIn("&bVCModWeaponRecovery,", panel)
+        self.assertIn('ReadIniIfExists("VC Mods", "WeaponRecovery", &bVCModWeaponRecovery);', INI.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
