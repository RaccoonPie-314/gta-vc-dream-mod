+static void
+VCModChaseClearScenario(void)
+{
+	// a mission cancelled mid-flight must not leave the player in a pilotless
+	// heli holding station over the city; put him back on the forecourt
+	CPlayerPed *player = FindPlayerPed();
+	bool onRopes = nVCModChaseAir == VCMOD_AIR_CLIMB || nVCModChaseAir == VCMOD_AIR_DROP;
+	if (player != nil &&
+	    (onRopes || (pVCModChaseHeli != nil && player->m_pMyVehicle == pVCModChaseHeli))) {
+		VCModChaseEjectPed(player);
+		player->Teleport(vecVCModChaseAirSpot);
+		player->SetPedState(PED_IDLE);
+		player->bUsesCollision = true;
+	}
+	VCModChaseClearApproachBlips();
+	VCModChaseReleaseRopes();
+	VCModChaseStopAlarm();
+	VCModChaseSetDensity(false);
+	nVCModChaseTableau = VCMOD_TABLEAU_OFF;
+	nVCModChaseTableauUntil = 0;
+	bVCModChaseBoarding = false;
+	nVCModChaseBoardUntil = 0;
+	bVCModChaseCornered = false;
+	bVCModChasePullingOver = false;
+	if (nVCModChaseLeaderBlip >= 0) {
+		CRadar::ClearBlip(nVCModChaseLeaderBlip);
+		nVCModChaseLeaderBlip = -1;
+	}
+	for (int32 i = 0; i < VCMOD_CHASE_CREW_MAX; i++) {
+		CPed *ped = VCModChaseCrewPed(i);
+		VCModChaseRemovePed(ped);
+		nVCModChaseCrewHandle[i] = -1;
+	}
+	for (int32 i = 0; i < nVCModChaseCrewCars; i++)
+		VCModChaseRemoveVehicle(pVCModChaseCrewCar[i]);
+	nVCModChaseCrewCars = 0;
+	nVCModChaseCrewCap = 0;
+	nVCModChaseCrewReserve = 0;
+	nVCModChaseCrewLostAt = 0;
+	bVCModChaseCrewOut = false;
+	bVCModChaseCrewSpent = false;
+	VCModChaseClearSquad();
+	VCModChaseRemoveVehicle(pVCModChaseSquadCar);
+	VCModChaseRemoveVehicle(pVCModChaseBoat);
+	VCModChaseRemoveHeli();
+	nVCModChaseAir = VCMOD_AIR_OFF;
+	fVCModChaseRopePos = 0.0f;
+	nVCModChaseAirAt = 0;
+	bVCModChaseHeliHeld = false;
+	bVCModChaseApproachChosen = false;
+	nVCModChaseSetup = VCMOD_CHASE_SETUP_APPROACH;
+	bVCModChaseBoating = false;
+	nVCModChaseBoatAt = 0;
+	nVCModChaseBoatDeadline = 0;
+	CPed *leader = VCModChaseLeader();
+	VCModChaseRemovePed(leader);
+	nVCModChaseLeaderHandle = -1;
+	VCModChaseRemoveVehicle(pVCModChaseAbandonedCar);
+	VCModChaseRemoveVehicle(pVCModChaseSwapCar);
+	VCModChaseRemoveVehicle(pVCModChaseLeaderCar);
+	bVCModChaseSwapping = false;
+	nVCModChaseSwapDeadline = 0;
+	bVCModChaseSquadDismounted = false;
+	nVCModChaseLeaderStillSince = 0;
+	nVCModChaseAwaySince = 0;
+	nVCModChaseBeat = 0;
+	nVCModChaseStopUntil = 0;
+	bVCModChaseAtStop = false;
