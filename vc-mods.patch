+
+// A node at or below the water line is a boat lane, not a road.
+static bool
+VCModChaseInWater(CVector p)
+{
+	float level = 0.0f;
+	return CWaterLevel::GetWaterLevel(p.x, p.y, p.z, &level, true) && p.z <= level + 1.0f;
+}
+
+// A node over water whose road sits well above the water is a bridge or a
+// causeway. Planning a route onto one strands the car, so keep them out of the
+// leader's spawn and beats and out of the dock search.
+static bool
+VCModChaseBridge(CVector p)
+{
+	float level = 0.0f;
+	return CWaterLevel::GetWaterLevel(p.x, p.y, p.z, &level, true) && p.z > level + 3.0f;
+}
+
+// Road nodes are chosen by distance from the station. Walking the path links
+// is not reliable in this data, and the car only has to drive to the point.
+static int32
+VCModChaseRoadNode(float distance, CVector *dir, bool keepBearing)
+{
+	int32 best = -1;
+	float bestErr = 1.0e6f;
+	for (int32 i = 0; i < ThePaths.m_numCarPathNodes; i++) {
+		CPathNode *n = &ThePaths.m_pathNodes[i];
+		if (n->bWaterPath || n->bDisabled || n->bBetweenLevels)
+			continue;
+		CVector np = n->GetPosition();
+		if (VCModChaseInWater(np) || VCModChaseBridge(np))
+			continue;
+		CVector off = np - vecVCModChaseStation;
+		off.z = 0.0f;
+		float d = off.Magnitude();
+		if (d < 1.0f)
+			continue;
+		if (keepBearing && dir != nil && (off.x*dir->x + off.y*dir->y) < 0.5f * d)
+			continue;
+		float err = Abs(d - distance);
+		if (err < bestErr) {
+			bestErr = err;
+			best = i;
+		}
+	}
+	return best;
+}
+
+// A dock is a car node that ends beside a water path; the boat leaves from there.
+static bool
+VCModChaseFindDock(CVector near)
+{
+	float best = 700.0f;
+	bool found = false;
+	for (int32 i = 0; i < ThePaths.m_numPathNodes; i++) {
+		CPathNode *w = &ThePaths.m_pathNodes[i];
+		if (!w->bWaterPath)
+			continue;
+		CVector wp = w->GetPosition();
+		if ((wp - near).Magnitude2D() > 600.0f)
+			continue;
+		int32 c = ThePaths.FindNodeClosestToCoors(wp, PATH_CAR, 25.0f, true, true);
+		if (c < 0)
+			continue;
+		CPathNode *d = &ThePaths.m_pathNodes[c];
+		if (d->bWaterPath)
+			continue;
+		CVector dp = d->GetPosition();
+		if (VCModChaseBridge(dp))
+			continue;
+		float dist = (dp - near).Magnitude2D();
+		if (dist < best) {
+			best = dist;
+			vecVCModChaseDock = dp;
+			vecVCModChaseWater = wp;
+			found = true;
+		}
+	}
+	return found;
+}
+
+// Head start and two stops, laid out at 200/290/380 m from the station along
+// a random street out of the station, so the opening is not always the same
+// run and the leader never starts on top of the car parked at the station. The
+// distance stays fixed: it is the gap that keeps the leash from failing the
+// player while he is still getting into his car.
+static bool
+VCModChaseBuildRoute(void)
+{
+	float angle = CGeneral::GetRandomNumberInRange(0.0f, 2.0f * PI);
+	CVector heading(Cos(angle), Sin(angle), 0.0f);
+	int32 spawn = VCModChaseRoadNode(VCMOD_CHASE_LEAD_START, &heading, true);
+	if (spawn < 0)
+		spawn = VCModChaseRoadNode(VCMOD_CHASE_LEAD_START, nil, false);
+	if (spawn < 0)
+		return false;
+	vecVCModChaseLeaderSpawn = ThePaths.m_pathNodes[spawn].GetPosition();
+
+	CVector dir = vecVCModChaseLeaderSpawn - vecVCModChaseStation;
+	dir.z = 0.0f;
+	dir.Normalise2D();
+
+	int32 b0 = VCModChaseRoadNode(VCMOD_CHASE_LEAD_START + VCMOD_CHASE_BEAT_GAP, &dir, true);
+	int32 b1 = VCModChaseRoadNode(VCMOD_CHASE_LEAD_START + VCMOD_CHASE_BEAT_GAP * 2.0f, &dir, true);
+	if (b0 < 0)
+		b0 = VCModChaseRoadNode(VCMOD_CHASE_LEAD_START + VCMOD_CHASE_BEAT_GAP, &dir, false);
+	if (b1 < 0)
+		b1 = VCModChaseRoadNode(VCMOD_CHASE_LEAD_START + VCMOD_CHASE_BEAT_GAP * 2.0f, &dir, false);
+	if (b0 < 0 || b1 < 0)
+		return false;
+	vecVCModChaseBeat[0] = ThePaths.m_pathNodes[b0].GetPosition();
+	vecVCModChaseBeat[1] = ThePaths.m_pathNodes[b1].GetPosition();
+
+	if (VCModChaseFindDock(vecVCModChaseStation)) {
+		vecVCModChaseBeat[2] = vecVCModChaseDock;
+		nVCModChaseBeatCount = 3;
+	} else {
+		nVCModChaseBeatCount = 2;
+	}
+	return true;
+}
+
+static bool
+VCModChaseDriveCar(CVehicle *car, CVector dest)
+{
+	// JoinCarWithRoadSystemGotoCoors returns true when it could not build a
+	// route and leaves the route nodes at 0. Heading straight for the point is
+	// what the engine itself does then: GOTOCOORDS_STRAIGHT re-runs the path
+	// search every few frames, so it picks the road back up as soon as one
+	// exists. Staying in GOTOCOORDS with no nodes would drive at the origin.
+	bool noRoute = CCarCtrl::JoinCarWithRoadSystemGotoCoors(car, dest, false);
+	car->AutoPilot.m_nCarMission = noRoute ? MISSION_GOTOCOORDS_STRAIGHT : MISSION_GOTOCOORDS;
+	if (noRoute)
+		fprintf(stderr, "VCMOD CHASE no route to %.1f %.1f %.1f\n", dest.x, dest.y, dest.z);
+	// chase pace: full speed and weave around traffic, but keep trying not to hit
+	// it; PLOUGH_THROUGH is what makes a car ram everything in its lane
+	car->AutoPilot.m_nCruiseSpeed = 40;
+	car->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+	car->AutoPilot.m_fMaxTrafficSpeed = 40.0f;
+	car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	car->SetStatus(STATUS_PHYSICS);
+	return !noRoute;
+}
+
+static void
+VCModChaseDriveTo(CVector dest)
+{
+	VCModChaseDriveCar(pVCModChaseLeaderCar, dest);
+}
+
+// The stock wanted-response chase, aimed at a mission target instead of the
+// player: MISSION_RAMCAR_* path-follows far out, steers straight at the target
+// inside the switch distance and reverses out when it ends up wedged
+// (CarAI.cpp:259-300), with the AVOID_CARS style police cars use
+// (CarAI.cpp:360). Without a car to chase — the target is on foot — it falls
+// back to a plain GOTO at the same pace.
+static void
+VCModChasePursueCar(CVehicle *car, CVehicle *target, CVector fallback)
+{
+	if (car == nil)
+		return;
+	car->SetStatus(STATUS_PHYSICS);
+	car->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+	car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	car->AutoPilot.m_nCruiseSpeed = 45;
+	car->AutoPilot.m_fMaxTrafficSpeed = 45.0f;
+	if (target != nil && target != car) {
+		bool pursuing = car->AutoPilot.m_nCarMission == MISSION_RAMCAR_FARAWAY ||
+		                car->AutoPilot.m_nCarMission == MISSION_RAMCAR_CLOSE ||
+		                car->AutoPilot.m_nCarMission == MISSION_BLOCKCAR_FARAWAY ||
+		                car->AutoPilot.m_nCarMission == MISSION_BLOCKCAR_CLOSE;
+		// re-registering the target every second would pile up references, so
+		// only the mission is refreshed while it is still a pursuit
+		if (!pursuing || car->AutoPilot.m_pTargetCar != target)
+			CCarAI::TellCarToRamOtherCar(car, target);
+		return;
+	}
+	if (car->AutoPilot.m_nCarMission != MISSION_GOTOCOORDS &&
+	    car->AutoPilot.m_nCarMission != MISSION_GOTOCOORDS_STRAIGHT)
+		VCModChaseDriveCar(car, fallback);
+}
+
+static void
+VCModChaseStopHere(void)
+{
+	pVCModChaseLeaderCar->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	pVCModChaseLeaderCar->AutoPilot.m_nCruiseSpeed = 0;
+	pVCModChaseLeaderCar->AutoPilot.m_nTempAction = TEMPACT_NONE;
+}
+
+static CVehicle *
+VCModChaseSpawnMissionCar(int16 model, CVector pos)
+{
+	CStreaming::RequestModel(model, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(model)) {
+		VCModChaseNotice("chase: a mission car cannot be loaded");
+		return nil;
+	}
+
+	CAutomobile *car = new CAutomobile(model, RANDOM_VEHICLE);
+	if (car == nil)
+		return nil;
+	// the constructor locks police cars until a cop opens them; the player has
+	// to be able to get into the squad car
+	car->m_nDoorLock = CARLOCK_UNLOCKED;
+	pos.z += car->GetDistanceFromCentreOfMassToBaseOfModel();
+	CTheScripts::ClearSpaceForMissionEntity(pos, car);
+	car->SetPosition(pos);
+	car->PlaceOnRoadProperly();
+	car->SetStatus(STATUS_PHYSICS);
+	car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	car->AutoPilot.m_nCruiseSpeed = 0;
+	car->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	CWorld::Add(car);
+	return car;
+}
+
+static bool
+VCModChaseStageSwapCar(void)
+{
+	// Six metres to the side is the pavement, and at a shop stop it is the very
+	// wall the collection runs into: the swap car ends up wedged there with the
+	// leader at the wheel and never moves. Put it in the lane he just drove
+	// through instead, on the nearest car node behind him.
+	CVector pos = pVCModChaseLeaderCar->GetPosition() - pVCModChaseLeaderCar->GetForward() * 8.0f;
+	int32 node = ThePaths.FindNodeClosestToCoors(pos, PATH_CAR, 20.0f, true, true);
+	if (node >= 0) {
+		CVector np = ThePaths.m_pathNodes[node].GetPosition();
+		if (!ThePaths.m_pathNodes[node].bWaterPath && !VCModChaseInWater(np) && !VCModChaseBridge(np))
+			pos = np;
+	}
+	pVCModChaseSwapCar = VCModChaseSpawnMissionCar(VCMOD_CHASE_SWAP_CAR, pos);
+	return pVCModChaseSwapCar != nil;
+}
+
+static bool
+VCModChaseStartSwap(void)
+{
+	CPed *leader = VCModChaseLeader();
+	if (leader == nil)
+		return false;
+	if (pVCModChaseSwapCar == nil && !VCModChaseStageSwapCar())
+		return false;
+	leader->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, pVCModChaseSwapCar);
+	nVCModChaseSwapDeadline = CTimer::GetTimeInMilliseconds() + 4000;
+	bVCModChaseSwapping = true;
+	return true;
+}
+
+// The stock shop alarm is a looping script object at a point, so the scene only
+// needs the one sample the game already ships.
+static void
+VCModChaseStartAlarm(CVector at)
+{
+	if (pVCModChaseAlarm != nil)
+		return;
+	pVCModChaseAlarm = new cAudioScriptObject;
+	if (pVCModChaseAlarm == nil)
+		return;
+	pVCModChaseAlarm->AudioId = SCRIPT_SOUND_BANK_ALARM_LOOP;
+	pVCModChaseAlarm->Posn = at;
+	pVCModChaseAlarm->AudioEntity = DMAudio.CreateLoopingScriptObject(pVCModChaseAlarm);
+	nVCModChaseAlarmEntity = pVCModChaseAlarm->AudioEntity;
+}
+
+static void
+VCModChaseStopAlarm(void)
+{
+	if (nVCModChaseAlarmEntity >= 0) {
+		DMAudio.DestroyLoopingScriptObject(nVCModChaseAlarmEntity);
+		nVCModChaseAlarmEntity = -1;
+	}
+	if (pVCModChaseAlarm != nil) {
+		delete pVCModChaseAlarm;
+		pVCModChaseAlarm = nil;
+	}
+}
+
+// The shop is the first wall off either side of the car. The errand ends a step
+// short of it, on the pavement, instead of inside the wall.
+static CVector
+VCModChaseShopPoint(CVector car)
+{
+	CVector right = pVCModChaseLeaderCar->GetRight();
+	right.z = 0.0f;
+	if (right.Magnitude2D() < 0.01f)
+		return car + CVector(7.0f, 0.0f, 0.0f);
+	right.Normalise2D();
+
+	CVector best = car + right * 7.0f;
+	float bestDist = VCMOD_CHASE_SHOP_TRY;
+	for (int32 side = -1; side <= 1; side += 2) {
+		CVector dir = right * (float)side;
+		CVector from = car;
+		CVector to = car + dir * VCMOD_CHASE_SHOP_TRY;
+		from.z += 1.2f;
+		to.z += 1.2f;
+		CColPoint point;
+		CEntity *hit = nil;
+		if (!CWorld::ProcessLineOfSight(from, to, point, hit, true, false, false, false, true, false))
+			continue;
+		float d = (point.point - car).Magnitude2D();
+		if (d < bestDist) {
+			bestDist = d;
+			best = point.point - dir * 1.5f;
+			best.z = car.z;
+		}
+	}
+	return best;
+}
+
+// The first stop opens with the collection: he parks outside, walks in, the
+// alarm goes off, and he comes back out to the car he swaps into.
+static bool
+VCModChaseStartTableau(uint32 now)
+{
+	CPed *leader = VCModChaseLeader();
+	if (leader == nil)
+		return false;
+	if (pVCModChaseSwapCar == nil && !VCModChaseStageSwapCar())
+		return false;
+	vecVCModChaseShop = VCModChaseShopPoint(pVCModChaseLeaderCar->GetPosition());
+	leader->SetObjective(OBJECTIVE_LEAVE_CAR, pVCModChaseLeaderCar);
+	nVCModChaseTableau = VCMOD_TABLEAU_LEAVE;
+	nVCModChaseTableauUntil = now + VCMOD_CHASE_TABLEAU_LEAVE;
+	VCModChaseNotice("chase: he stops to clean the place out");
+	fprintf(stderr, "VCMOD CHASE tableau shop %.1f %.1f %.1f\n",
+		vecVCModChaseShop.x, vecVCModChaseShop.y, vecVCModChaseShop.z);
+	return true;
+}
+
+static void
+VCModChaseTickTableau(CPed *leader, uint32 now)
+{
+	switch (nVCModChaseTableau) {
+	case VCMOD_TABLEAU_LEAVE:
+		if (leader->m_pMyVehicle == nil || now > nVCModChaseTableauUntil) {
+			leader->SetObjective(OBJECTIVE_RUN_TO_AREA, vecVCModChaseShop);
+			nVCModChaseTableau = VCMOD_TABLEAU_WALK;
+			nVCModChaseTableauUntil = now + VCMOD_CHASE_TABLEAU_WALK;
+		}
+		break;
+	case VCMOD_TABLEAU_WALK:
+		if ((leader->GetPosition() - vecVCModChaseShop).Magnitude2D() < VCMOD_CHASE_SHOP_REACH ||
+		    now > nVCModChaseTableauUntil) {
+			VCModChaseStartAlarm(vecVCModChaseShop);
+			nVCModChaseTableau = VCMOD_TABLEAU_INSIDE;
+			nVCModChaseTableauUntil = now + VCMOD_CHASE_TABLEAU_INSIDE;
+		}
+		break;
+	case VCMOD_TABLEAU_INSIDE:
+		if (now > nVCModChaseTableauUntil) {
+			VCModChaseStopAlarm();
+			nVCModChaseTableau = VCMOD_TABLEAU_OFF;
+			leader->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, pVCModChaseSwapCar);
+			nVCModChaseSwapDeadline = now + 6000;
+			bVCModChaseSwapping = true;
+		}
+		break;
+	}
+}
+
+static void
+VCModChaseFinishSwap(void)
+{
+	CPed *leader = VCModChaseLeader();
+	CVehicle *old = pVCModChaseLeaderCar;
+	// m_pMyVehicle is set while he is still walking to the door; only bInVehicle
+	// means he is sitting in it
+	if (leader != nil && !(leader->bInVehicle && leader->m_pMyVehicle == pVCModChaseSwapCar)) {
+		// the walk over did not finish in time; seat him rather than stall the beat
+		if (old->pDriver == leader)
+			old->pDriver = nil;
+		leader->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, pVCModChaseSwapCar);
+		leader->WarpPedIntoCar(pVCModChaseSwapCar);
+	}
+	pVCModChaseAbandonedCar = old;
+	pVCModChaseLeaderCar = pVCModChaseSwapCar;
+	pVCModChaseSwapCar = nil;
+	bVCModChaseSwapping = false;
+	bVCModChaseAtStop = false;
+	nVCModChaseBeat++;
+	VCModChaseDriveTo(VCModChaseBeatCoors(nVCModChaseBeat));
+}
