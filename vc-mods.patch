+        if (anim->blendAmount > 1.0f) {
+            anim->blendAmount = 1.0f;
+            anim->blendDelta = 0.0f;
+        }
+        ++i;
+    }
+}
+
+static void RunFrames(CPlayerPed &ped, float seconds)
+{
+    int frames = (int)(seconds * 30.0f + 0.5f);
+    for (int i = 0; i < frames; i++) {
+        ped.SetRealMoveAnim();
+        Advance(1.0f / 30.0f);
+    }
+}
