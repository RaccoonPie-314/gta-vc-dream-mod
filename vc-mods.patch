+// Traffic and crowds are what make a city chase unreadable, and the engine
+// itself clears the roads for a wanted player. Keep the mission's own numbers
+// and put them back on cleanup.
+static void
+VCModChaseSetDensity(bool on)
+{
+	if (on) {
+		if (bVCModChaseDensitySet)
+			return;
+		fVCModChasePreCarDensity = CCarCtrl::CarDensityMultiplier;
+		fVCModChasePrePedDensity = CPopulation::PedDensityMultiplier;
+		CCarCtrl::CarDensityMultiplier = VCMOD_CHASE_CAR_DENSITY;
+		CPopulation::PedDensityMultiplier = VCMOD_CHASE_PED_DENSITY;
+		bVCModChaseDensitySet = true;
+		fprintf(stderr, "VCMOD CHASE density traffic %.2f crowds %.2f\n",
+			VCMOD_CHASE_CAR_DENSITY, VCMOD_CHASE_PED_DENSITY);
+	} else if (bVCModChaseDensitySet) {
+		CCarCtrl::CarDensityMultiplier = fVCModChasePreCarDensity;
+		CPopulation::PedDensityMultiplier = fVCModChasePrePedDensity;
+		bVCModChaseDensitySet = false;
+	}
+}
