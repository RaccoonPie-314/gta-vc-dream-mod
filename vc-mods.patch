+// Ground force: the squad and crew pools, their transport, boarding, the
+// dismount, and the endgame stand on foot.
+
+CPed *
+VCModChaseSquadPed(int32 i)
+{
+	if (i < 0 || i >= VCMOD_CHASE_SQUAD_MAX)
+		return nil;
+	return nVCModChaseSquadHandle[i] >= 0 ? CPools::GetPedPool()->GetAt(nVCModChaseSquadHandle[i]) : nil;
+}
+
+CPed *
+VCModChaseCrewPed(int32 slot)
+{
+	if (slot < 0 || slot >= VCMOD_CHASE_CREW_MAX)
+		return nil;
+	return nVCModChaseCrewHandle[slot] >= 0 ? CPools::GetPedPool()->GetAt(nVCModChaseCrewHandle[slot]) : nil;
+}
+
+CPed *
+VCModChaseAccomplice(void)
+{
+	return VCModChaseCrewPed(0);
+}
+
+// A slot the pool may fill: no man, or a corpse the engine left behind.
+bool
+VCModChaseCrewSlotFree(int32 slot)
+{
+	CPed *ped = VCModChaseCrewPed(slot);
+	return ped == nil || ped->DyingOrDead();
+}
+
+int32
+VCModChaseSquadAlive(void)
+{
+	int32 alive = 0;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped != nil && !ped->DyingOrDead())
+			alive++;
+	}
+	return alive;
+}
+
+int32
+VCModChaseCrewAlive(void)
+{
+	int32 alive = 0;
+	for (int32 i = 0; i < nVCModChaseCrewCap; i++) {
+		CPed *ped = VCModChaseCrewPed(i);
+		if (ped != nil && !ped->DyingOrDead())
+			alive++;
+	}
+	return alive;
+}
+
+// The cop a crew member should fight: the player or one of the squad. A cop on
+// foot beats one sitting in a car — `KillCharOnFootArmed` sends the attacker to
+// the target car's door to pull him out when the target is mounted
+// (PedAI.cpp:6510), which reads as an endless enter/leave at the stand. `other`
+// is the man the other crew member already has, so the two spread across the
+// police instead of stacking on one target.
+CPed *
+VCModChaseCopTarget(CPed *from, CPed *other)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (from == nil)
+		return player;
+	// keep the man he is already shooting at unless he is dead, mounted, or out
+	// of range, so the objective does not flip between two equally close cops
+	CPed *current = from->m_pedInObjective;
+	if (current != nil && current != other && !current->DyingOrDead() && !current->bInVehicle &&
+	    (current->GetPosition() - from->GetPosition()).Magnitude2D() < 15.0f)
+		return current;
+
+	CPed *best = nil;
+	float bestScore = 1.0e6f;
+	for (int32 i = -1; i < nVCModChaseSquadCount; i++) {
+		CPed *cop = i < 0 ? (CPed*)player : VCModChaseSquadPed(i);
+		if (cop == nil || cop->DyingOrDead())
+			continue;
+		// mounted cops are a last resort; the other man's target only if alone
+		float score = (cop->GetPosition() - from->GetPosition()).Magnitude2D();
+		if (cop->bInVehicle)
+			score += 1000.0f;
+		if (cop == other)
+			score += 500.0f;
+		if (score < bestScore) {
+			bestScore = score;
+			best = cop;
+		}
+	}
+	return best;
+}
+
+// The patrol tier is the teaching run: the leader works alone, every higher
+// tier brings the partner he picks up later, and the heavy tiers bring a crew.
+int32
+VCModChaseCrewSize(int32 tier)
+{
+	int32 active = 0;
+	VCModChasePoolForTier(tier, 0, 0, &active, 0);
+	return active + 1;	// the leader rides with them
+}
+
+// Drop the squad the handles point at. The air team exists from the moment the
+// call goes out, so a ground pick has to clear it before the car team is made.
+void
+VCModChaseClearSquad(void)
+{
+	for (int32 i = 0; i < VCMOD_CHASE_SQUAD_MAX; i++) {
+		if (nVCModChaseSquadHandle[i] < 0)
+			continue;
+		CPed *ped = CPools::GetPedPool()->GetAt(nVCModChaseSquadHandle[i]);
+		VCModChaseRemovePed(ped);
+		nVCModChaseSquadHandle[i] = -1;
+	}
+	for (int32 i = 0; i < nVCModChaseBackupCars; i++)
+		VCModChaseRemoveVehicle(pVCModChaseBackupCar[i]);
+	nVCModChaseBackupCars = 0;
+	nVCModChaseSquadCount = 0;
+	nVCModChaseSquadReserve = 0;
+	nVCModChaseSquadLostAt = 0;
+	bVCModChaseSquadSpent = false;
+}
+
+int16
+VCModChaseTransportModel(eVCModChaseUnit unit)
+{
+	switch (unit) {
+	case VCMOD_UNIT_COP: return MI_POLICE;
+	case VCMOD_UNIT_SWAT: return MI_ENFORCER;
+	case VCMOD_UNIT_VICE: return MI_CHEETAH;
+	case VCMOD_UNIT_FBI: return MI_FBIRANCH;
+	case VCMOD_UNIT_ARMY: return MI_BARRACKS;
+	default: return MI_ENFORCER;
+	}
+}
+
+void
+VCModChaseSpawnSquad(void)
+{
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	int16 pedModel = unit == VCMOD_UNIT_VICE ? VCModChaseViceModel(nVCModChaseVariant)
+	                                         : VCModChaseUnitModel(unit);
+	int16 carModel = VCModChaseTransportModel(unit);
+	CStreaming::RequestModel(pedModel, 0);
+	CStreaming::RequestModel(carModel, 0);
+	VCModChaseRequestCopWeapon(unit);
+	CStreaming::LoadAllRequestedModels(false);
+
+	if (CStreaming::HasModelLoaded(carModel)) {
+		int32 node = ThePaths.FindNodeClosestToCoors(vecVCModChaseSquadDoor, PATH_CAR, 60.0f, true, true);
+		CVector at = node >= 0 ? ThePaths.m_pathNodes[node].GetPosition() : vecVCModChaseStation;
+		pVCModChaseSquadCar = VCModChaseSpawnMissionCar(carModel, at);
+	}
+	if (pVCModChaseSquadCar == nil || !CStreaming::HasModelLoaded(pedModel))
+		return;
+
+	// the response scales with the crew and the tier, so a heavy chase fills
+	// every seat while a patrol call rides as a pair; seats include the wheel
+	int32 seats = pVCModChaseSquadCar->m_nNumMaxPassengers + 1;
+	if (seats > VCMOD_CHASE_SQUAD_MAX + 1)
+		seats = VCMOD_CHASE_SQUAD_MAX + 1;
+	// the vice car is a two seater, so that tier always rides as a pair
+	if (unit == VCMOD_UNIT_VICE && seats > 2)
+		seats = 2;
+	// the job's own weight can pull in more than the picked unit would
+	int32 threat = VCModChaseThreat(nVCModChaseTier, VCModChaseCrimeThreat(nVCModChaseCrime));
+	int32 want = VCModChaseSquadForThreat(threat, VCModChaseCrewSize(nVCModChaseTier), seats, true);
+
+	// The team starts at the captured HQ door and runs out to the car together;
+	// the player runs with them instead of being followed.
+	CVector home = vecVCModChaseSquadDoor;
+	CVector dir = pVCModChaseSquadCar->GetPosition() - home;
+	dir.z = 0.0f;
+	if (dir.Magnitude2D() < 1.0f)
+		dir = pVCModChaseSquadCar->GetForward();
+	dir.Normalise2D();
+	CVector side(-dir.y, dir.x, 0.0f);
+
+	int32 made = 0;
+	for (int32 i = 0; i < want; i++) {
+		CVector at = home + side * ((i - (want - 1) * 0.5f) * 1.4f);
+		CPed *ped = CPopulation::AddPed(PEDTYPE_COP, VCModChaseCopType(unit), at,
+			unit == VCMOD_UNIT_VICE ? nVCModChaseVariant : 0);
+		if (ped == nil)
+			continue;
+		ped->CharCreatedBy = MISSION_CHAR;
+		ped->bIsPlayerFriend = true;
+		// the player taking the wheel must not empty the car of his own squad
+		ped->bStayInCarOnJack = true;
+		ped->SetObjective(OBJECTIVE_RUN_TO_AREA, pVCModChaseSquadCar->GetPosition());
+		nVCModChaseSquadHandle[made++] = CPools::GetPedPool()->GetIndex(ped);
+	}
+	nVCModChaseSquadCount = made;
+	// the men behind the ones who ride; the pool refills a loss from here
+	int32 poolActive = 0, poolReserve = 0;
+	VCModChasePoolForTier(nVCModChaseTier, &poolActive, &poolReserve, 0, 0);
+	nVCModChaseSquadReserve = poolReserve;
+	nVCModChaseSquadLostAt = 0;
+	bVCModChaseBoarding = made > 0;
+	nVCModChaseBoardUntil = CTimer::GetTimeInMilliseconds() + 30000;
+	VCMOD_DIAG("VCMOD CHASE squad car %p seats %d crew %d reserve %d home %.1f %.1f %.1f\n",
+		(void*)pVCModChaseSquadCar, seats, made, poolReserve, home.x, home.y, home.z);
+}
+
+// One frame of the station boarding. The player drives his own transport now;
+// every squad man runs to it and rides passenger, and nobody takes the wheel, so
+// there is no AI driver to chase with. The team holds at the kerb until the
+// whole squad and the player are seated.
+void
+VCModChaseTickBoarding(CPlayerPed *player)
+{
+	if (!bVCModChaseBoarding)
+		return;
+	CVehicle *car = pVCModChaseSquadCar;
+	if (car == nil) {
+		bVCModChaseBoarding = false;
+		return;
+	}
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	// m_pMyVehicle is set while a ped is still walking to the door; only
+	// bInVehicle means he is actually seated
+	bool playerAboard = player->bInVehicle && player->m_pMyVehicle == car;
+
+	int32 alive = 0;
+	int32 seated = 0;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead())
+			continue;
+		alive++;
+		if (ped->bInVehicle && ped->m_pMyVehicle == car) {
+			seated++;
+			continue;
+		}
+		if (ped->m_pMyVehicle != nil)
+			continue;	// walking to or climbing into a car already
+		if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER)
+			continue;
+		if ((ped->GetPosition() - car->GetPosition()).Magnitude2D() > 4.0f) {
+			// the run target was the spot the car was parked at; keep the men
+			// running at the car if it has been nudged or moved
+			if (now >= nVCModChaseBoardRetargetAt)
+				ped->SetObjective(OBJECTIVE_RUN_TO_AREA, car->GetPosition());
+			continue;
+		}
+		ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+	}
+	if (now >= nVCModChaseBoardRetargetAt)
+		nVCModChaseBoardRetargetAt = now + 1000;
+
+	if (!playerAboard || (seated < alive && now < nVCModChaseBoardUntil))
+		return;
+
+	bVCModChaseBoarding = false;
+	VCMOD_DIAG("VCMOD CHASE board done driver %s seated %d alive %d\n",
+		car->pDriver == player ? "player" : "none", seated, alive);
+	if (car->pDriver == player)
+		VCModHudNotice("chase: you have the wheel, follow him");
+}
+
+// ---- Force pools (design 6.7) --------------------------------------------
+//
+// Both sides have a finite reserve behind the men who are here now. A loss
+// queues one replacement after the refill delay; it spawns on a road node
+// 80-120 m out, out of the player's sight, and drives in, so nobody appears in
+// the middle of the fight. The cars the crew and the reserves arrive in then
+// follow the car being chased until it stops, and the men get out and fight.
+
+
+// A road node 80-120 m from `near` and out of the player's sight. The second
+// pass takes any node on that ring, so a spawn is never lost to a crowded view.
+bool
+VCModChaseBackupSpot(CVector near, CVector *out)
+{
+	CPlayerPed *player = FindPlayerPed();
+	CVector eye = player != nil ? player->GetPosition() : near;
+	for (int32 pass = 0; pass < 2; pass++) {
+		for (int32 tries = 0; tries < 32; tries++) {
+			float angle = CGeneral::GetRandomNumberInRange(0.0f, 2.0f * PI);
+			float radius = CGeneral::GetRandomNumberInRange(VCMOD_CHASE_BACKUP_NEAR, VCMOD_CHASE_BACKUP_FAR);
+			CVector probe = near + CVector(cos(angle) * radius, sin(angle) * radius, 0.0f);
+			int32 node = ThePaths.FindNodeClosestToCoors(probe, PATH_CAR, VCMOD_CHASE_BACKUP_NODE, true, true);
+			if (node < 0)
+				continue;
+			CVector np = ThePaths.m_pathNodes[node].GetPosition();
+			if (ThePaths.m_pathNodes[node].bWaterPath || VCModChaseInWater(np) || VCModChaseBridge(np))
+				continue;
+			float dist = (np - near).Magnitude2D();
+			if (dist < VCMOD_CHASE_BACKUP_NEAR || dist > VCMOD_CHASE_BACKUP_FAR + 20.0f)
+				continue;
+			if (pass == 0 &&
+			    CWorld::GetIsLineOfSightClear(eye, np, true, false, false, false, true, false, false))
+				continue;
+			*out = np;
+			return true;
+		}
+	}
+	return false;
+}
+
+// The crew's own ride for the tiers whose crew is bigger than the leader's car.
+int16
+VCModChaseCrewCarModel(int32 tier)
+{
+	switch (tier) {
+	case 2: return MI_SENTINEL;	// the pickup's reserve comes in a plain sedan
+	case 3: return MI_STINGER;	// vice runs fast cars
+	case 4: return MI_SENTINEL;	// fbi crew comes in a plain cruiser
+	case 5: return MI_PATRIOT;	// army brings a convoy truck
+	default: return -1;
+	}
+}
+
+void
+VCModChasePoolNotice(void)
+{
+	char text[96];
+	snprintf(text, sizeof(text), "chase: %d squad in reserve, %d crew in reserve",
+		nVCModChaseSquadReserve, nVCModChaseCrewReserve);
+	VCModHudNotice(text);
+}
+
+// One replacement for a dead squad slot: a man at the wheel of a transport car
+// on a road node behind the player, driving in.
+bool
+VCModChaseSpawnSquadBackup(CPlayerPed *player)
+{
+	if (player == nil || nVCModChaseSquadReserve <= 0)
+		return false;
+	int32 slot = -1;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead()) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0)
+		return false;
+
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	int16 pedModel = unit == VCMOD_UNIT_VICE ? VCModChaseViceModel(nVCModChaseVariant)
+	                                         : VCModChaseUnitModel(unit);
+	int16 carModel = VCModChaseTransportModel(unit);
+	CStreaming::RequestModel(pedModel, 0);
+	CStreaming::RequestModel(carModel, 0);
+	VCModChaseRequestCopWeapon(unit);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(pedModel))
+		return false;
+
+	CVector at;
+	if (!VCModChaseBackupSpot(player->GetPosition(), &at))
+		return false;
+	CVehicle *car = VCModChaseSpawnMissionCar(carModel, at);
+	if (car == nil)
+		return false;
+
+	CPed *ped = CPopulation::AddPed(PEDTYPE_COP, VCModChaseCopType(unit), at,
+		unit == VCMOD_UNIT_VICE ? nVCModChaseVariant : 0);
+	if (ped == nil) {
+		VCModChaseRemoveVehicle(car);
+		return false;
+	}
+	ped->CharCreatedBy = MISSION_CHAR;
+	ped->bIsPlayerFriend = true;
+	ped->bStayInCarOnJack = true;
+	ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+	ped->WarpPedIntoCar(car);
+	// stock pursuit: the car hunts the criminal's car and rams it, the way a
+	// wanted-response cruiser hunts the player
+	VCModChasePursueCar(car, pVCModChaseLeaderCar, player->GetPosition());
+
+	nVCModChaseSquadHandle[slot] = CPools::GetPedPool()->GetIndex(ped);
+	if (nVCModChaseBackupCars < VCMOD_CHASE_SQUAD_MAX)
+		pVCModChaseBackupCar[nVCModChaseBackupCars++] = car;
+	nVCModChaseSquadReserve--;
+	VCMOD_DIAG("VCMOD CHASE squad backup slot %d at %.1f %.1f reserve %d\n",
+		slot, at.x, at.y, nVCModChaseSquadReserve);
+	return true;
+}
+
+// Put up to `count` empty crew slots from `first` into one arrival car; the
+// first man drives. Returns how many were placed.
+int32
+VCModChaseCrewCarry(int32 first, int32 count, bool fromReserve)
+{
+	if (pVCModChaseLeaderCar == nil || count <= 0 || nVCModChaseCrewCars >= VCMOD_CHASE_CREW_MAX)
+		return 0;
+	int16 carModel = VCModChaseCrewCarModel(nVCModChaseTier);
+	if (carModel < 0)
+		return 0;
+	CStreaming::RequestModel(VCMOD_CHASE_ACCOMPLICE_MODEL, 0);
+	CStreaming::RequestModel(CWeaponInfo::GetWeaponInfo(WEAPONTYPE_UZI)->m_nModelId, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_ACCOMPLICE_MODEL))
+		return 0;
+
+	CVector at;
+	if (!VCModChaseBackupSpot(pVCModChaseLeaderCar->GetPosition(), &at))
+		return 0;
+	CVehicle *car = VCModChaseSpawnMissionCar(carModel, at);
+	if (car == nil)
+		return 0;
+
+	int32 seats = car->m_nNumMaxPassengers + 1;
+	int32 made = 0;
+	for (int32 i = first; i < nVCModChaseCrewCap && made < seats && count > 0; i++) {
+		if (!VCModChaseCrewSlotFree(i))
+			continue;
+		CPed *ped = CPopulation::AddPed(PEDTYPE_CIVMALE, VCMOD_CHASE_ACCOMPLICE_MODEL, car->GetPosition());
+		if (ped == nil)
+			continue;
+		ped->CharCreatedBy = MISSION_CHAR;
+		ped->bIsPlayerFriend = false;
+		ped->m_fHealth = VCMOD_CHASE_CREW_HEALTH;
+		ped->GiveWeapon(WEAPONTYPE_UZI, 1000);
+		ped->SetCurrentWeapon(WEAPONTYPE_UZI);
+		// the first man takes the wheel; the rest ride
+		if (made == 0) {
+			ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+			ped->WarpPedIntoCar(car);
+		} else {
+			ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+			ped->WarpPedIntoCar(car);
+		}
+		nVCModChaseCrewHandle[i] = CPools::GetPedPool()->GetIndex(ped);
+		made++;
+		count--;
+		if (fromReserve && nVCModChaseCrewReserve > 0)
+			nVCModChaseCrewReserve--;
+	}
+	if (made == 0) {
+		VCModChaseRemoveVehicle(car);
+		return 0;
+	}
+	pVCModChaseCrewCar[nVCModChaseCrewCars++] = car;
+	// the crew hunts the player the same way the police hunt him
+	CPlayerPed *player = FindPlayerPed();
+	CVehicle *playerVeh = player != nil && player->bInVehicle ? player->m_pMyVehicle : nil;
+	VCModChasePursueCar(car, playerVeh, player != nil ? player->GetPosition()
+	                                                  : pVCModChaseLeaderCar->GetPosition());
+	VCMOD_DIAG("VCMOD CHASE crew car %p carrying %d at %.1f %.1f reserve %d\n",
+		(void*)car, made, at.x, at.y, nVCModChaseCrewReserve);
+	return made;
+}
+
+// Stop an arrival car for good and put every man in it on foot, with the fight
+// order in the same frame as LEAVE_CAR: an exit restores the boarding order
+// stored before it, so a later kill order would only be stashed (PedAI.cpp:242).
+void
+VCModChaseBailOut(CVehicle *car, bool crew)
+{
+	if (car == nil)
+		return;
+	car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	car->AutoPilot.m_nCruiseSpeed = 0;
+	car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+
+	CPed *men[5];
+	int32 count = 0;
+	if (car->pDriver != nil)
+		men[count++] = car->pDriver;
+	for (int32 i = 0; i < 4 && count < 5; i++)
+		if (car->pPassengers[i] != nil)
+			men[count++] = car->pPassengers[i];
+
+	bool bailed = false;
+	for (int32 i = 0; i < count; i++) {
+		CPed *ped = men[i];
+		if (ped->DyingOrDead() || !ped->bInVehicle)
+			continue;
+		CPed *target = crew ? VCModChaseCopTarget(ped, nil) : VCModChaseCriminalTarget(ped);
+		if (target == nil)
+			continue;
+		if (ped->m_objective != OBJECTIVE_LEAVE_CAR)
+			ped->SetObjective(OBJECTIVE_LEAVE_CAR, car);
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, target);
+		bailed = true;
+	}
+	if (bailed)
+		VCMOD_DIAG("VCMOD CHASE %s out at %.1f %.1f\n",
+			crew ? "crew" : "squad backup", car->GetPosition().x, car->GetPosition().y);
+}
+
+// One frame of both pools: losses, the refill timers, the arrival cars' driving
+// and their dismount. Runs from the mission update, before the leader tick.
+void
+VCModChaseTickPools(CPlayerPed *player)
+{
+	if (pVCModChaseLeaderCar == nil)
+		return;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	CVehicle *target = pVCModChaseLeaderCar;
+
+	int32 squadAlive = VCModChaseSquadAlive();
+	if (nVCModChaseSquadCount > 0) {
+		if (nVCModChaseSquadReserve > 0) {
+			if (squadAlive >= nVCModChaseSquadCount) {
+				nVCModChaseSquadLostAt = 0;
+			} else if (nVCModChaseSquadLostAt == 0) {
+				nVCModChaseSquadLostAt = now;
+				VCMOD_DIAG("VCMOD CHASE squad loss %d/%d reserve %d\n",
+					squadAlive, nVCModChaseSquadCount, nVCModChaseSquadReserve);
+			} else if (VCModChaseReplaceDue(squadAlive, nVCModChaseSquadCount, nVCModChaseSquadReserve,
+			                               nVCModChaseSquadLostAt, VCMOD_CHASE_SQUAD_REPLACE, now)) {
+				nVCModChaseSquadLostAt = 0;
+				if (VCModChaseSpawnSquadBackup(player))
+					VCModChasePoolNotice();
+			}
+		} else if (squadAlive < nVCModChaseSquadCount && !bVCModChaseSquadSpent) {
+			bVCModChaseSquadSpent = true;
+			VCModHudNotice("chase: the squad has no reserves left");
+		}
+	}
+
+	if (nVCModChaseCrewCap > 0 && bVCModChaseCrewOut) {
+		int32 crewAlive = VCModChaseCrewAlive();
+		if (nVCModChaseCrewReserve > 0) {
+			if (crewAlive >= nVCModChaseCrewCap) {
+				nVCModChaseCrewLostAt = 0;
+			} else if (nVCModChaseCrewLostAt == 0) {
+				nVCModChaseCrewLostAt = now;
+				VCMOD_DIAG("VCMOD CHASE crew loss %d/%d reserve %d\n",
+					crewAlive, nVCModChaseCrewCap, nVCModChaseCrewReserve);
+			} else if (VCModChaseReplaceDue(crewAlive, nVCModChaseCrewCap, nVCModChaseCrewReserve,
+			                                nVCModChaseCrewLostAt, VCMOD_CHASE_CREW_REPLACE, now)) {
+				nVCModChaseCrewLostAt = 0;
+				if (VCModChaseCrewCarry(0, 1, true) > 0)
+					VCModChasePoolNotice();
+			}
+		} else if (crewAlive < nVCModChaseCrewCap && !bVCModChaseCrewSpent) {
+			bVCModChaseCrewSpent = true;
+			VCModHudNotice("chase: the crew has no reserves left");
+		}
+	}
+
+	// the arrival cars hunt until the fight stops, then bail out
+	bool retarget = now >= nVCModChaseBackupAt;
+	if (retarget)
+		nVCModChaseBackupAt = now + VCMOD_CHASE_BACKUP_RETARGET;
+	CVehicle *playerVeh = player != nil && player->bInVehicle ? player->m_pMyVehicle : nil;
+	CVector playerPos = player != nil ? player->GetPosition() : target->GetPosition();
+	bool playerStill = playerVeh == nil ||
+	                   playerVeh->GetMoveSpeed().Magnitude2D() < VCMOD_CHASE_STILL_SPEED;
+
+	for (int32 i = 0; i < nVCModChaseCrewCars; i++) {
+		CVehicle *car = pVCModChaseCrewCar[i];
+		if (car == nil)
+			continue;
+		float gap = playerVeh != nil ? (car->GetPosition() - playerVeh->GetPosition()).Magnitude2D()
+		                             : (car->GetPosition() - playerPos).Magnitude2D();
+		if (bVCModChaseCornered || (gap < VCMOD_CHASE_BACKUP_JOIN && playerStill))
+			VCModChaseBailOut(car, true);
+		else if (retarget)
+			VCModChasePursueCar(car, playerVeh, playerPos);
+	}
+
+	float targetSpeed = target->GetMoveSpeed().Magnitude2D();
+	for (int32 i = 0; i < nVCModChaseBackupCars; i++) {
+		CVehicle *car = pVCModChaseBackupCar[i];
+		if (car == nil)
+			continue;
+		CPed *ped = car->pDriver;
+		if (ped == nil) {
+			// the driver died inside the car; park it rather than let it roll
+			car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+			car->AutoPilot.m_nCruiseSpeed = 0;
+			continue;
+		}
+		if (!(ped->bInVehicle && ped->m_pMyVehicle == car))
+			continue;	// he is out and fighting, the car stays for cleanup
+		float gap = (car->GetPosition() - target->GetPosition()).Magnitude2D();
+		// in contact, or close to a chase that has stopped: stock cops get out
+		// and shoot once their car has pulled up on the target
+		bool close = gap < 15.0f ||
+		             (gap < VCMOD_CHASE_BACKUP_JOIN && targetSpeed < VCMOD_CHASE_STILL_SPEED);
+		if (bVCModChaseCornered || close)
+			VCModChaseBailOut(car, false);
+		else if (retarget)
+			VCModChasePursueCar(car, target, target->GetPosition());
+	}
+}
+
+void
+VCModChaseSpawnAccomplice(void)
+{
+	if (pVCModChaseLeaderCar == nil || nVCModChaseCrewCap <= 0)
+		return;
+	CStreaming::RequestModel(VCMOD_CHASE_ACCOMPLICE_MODEL, 0);
+	CStreaming::RequestModel(CWeaponInfo::GetWeaponInfo(WEAPONTYPE_UZI)->m_nModelId, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_ACCOMPLICE_MODEL)) {
+		// the retry runs every frame; one line a second is enough to show it
+		uint32 now = CTimer::GetTimeInMilliseconds();
+		if (now - nVCModChaseCrewLogAt > 1000) {
+			nVCModChaseCrewLogAt = now;
+			VCMOD_DIAG("VCMOD CHASE crew model still streaming\n");
+		}
+		return;
+	}
+
+	CPed *leader = VCModChaseLeader();
+	CVector pos;
+	if (bVCModChaseCornered && leader != nil)
+		pos = leader->GetPosition() + leader->GetRight() * 1.2f;
+	else
+		pos = pVCModChaseLeaderCar->GetPosition() + pVCModChaseLeaderCar->GetRight() * 4.0f;
+	CPed *ped = CPopulation::AddPed(PEDTYPE_CIVMALE, VCMOD_CHASE_ACCOMPLICE_MODEL, pos);
+	if (ped == nil) {
+		VCMOD_DIAG("VCMOD CHASE pickup spawn failed\n");
+		return;
+	}
+	ped->CharCreatedBy = MISSION_CHAR;
+	ped->bIsPlayerFriend = false;
+	ped->m_fHealth = VCMOD_CHASE_CREW_HEALTH;
+	// a pistol loses the stand against four rifles; the crew carries the team's
+	// own submachinegun so he draws fire off the leader
+	ped->GiveWeapon(WEAPONTYPE_UZI, 1000);
+	ped->SetCurrentWeapon(WEAPONTYPE_UZI);
+	if (bVCModChaseCornered)
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, VCModChaseCopTarget(ped, nil));
+	else
+		ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, pVCModChaseLeaderCar);
+	nVCModChaseCrewHandle[0] = CPools::GetPedPool()->GetIndex(ped);
+	bVCModChaseCrewOut = true;
+	VCMOD_DIAG("VCMOD CHASE pickup %p at %.1f %.1f %.1f cornered %d\n",
+		(void*)ped, pos.x, pos.y, pos.z, bVCModChaseCornered);
+}
+
+void
+VCModChaseTickCrew(void)
+{
+	if (nVCModChaseCrewCap <= 0)
+		return;
+	if (VCModChaseCrewSlotFree(0)) {
+		// the pickup happens at the second beat; if he is still missing when
+		// the stand starts, he joins it on foot rather than leaving the leader
+		// alone
+		if (bVCModChaseCornered || (bVCModChaseAtStop && nVCModChaseBeat == 1))
+			VCModChaseSpawnAccomplice();
+	}
+	if (!bVCModChaseCrewOut || bVCModChaseCornered)
+		return;
+
+	// the men beyond the pickup arrive in the crew's own car: at the pickup beat
+	// on the ground, or as soon as the leader rolls on the air start
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	int32 missing = 0;
+	for (int32 i = 1; i < nVCModChaseCrewCap; i++)
+		if (VCModChaseCrewSlotFree(i))
+			missing++;
+	bool arrive = (nVCModChaseAir != VCMOD_AIR_OFF && bVCModChaseGo) ||
+	              (bVCModChaseAtStop && nVCModChaseBeat == 1);
+	if (missing > 0 && arrive && now >= nVCModChaseCrewArriveAt) {
+		nVCModChaseCrewArriveAt = now + 1000;
+		VCModChaseCrewCarry(1, missing, false);
+	}
+
+	// the walk to the passenger door can fail while the car is nudged by the
+	// player; seat him instead of leaving the crew standing at the kerb
+	CPed *ped = VCModChaseCrewPed(0);
+	if (ped == nil || ped->DyingOrDead())
+		return;
+	CPed *leader = VCModChaseLeader();
+	if (leader != nil && leader->bInVehicle && pVCModChaseLeaderCar != nil &&
+	    !(ped->bInVehicle && ped->m_pMyVehicle == pVCModChaseLeaderCar) &&
+	    pVCModChaseLeaderCar->GetMoveSpeed().Magnitude2D() < VCMOD_CHASE_STILL_SPEED)
+		VCModChaseBoardAccomplice();
+}
+
+void
+VCModChaseBoardAccomplice(void)
+{
+	CPed *ped = VCModChaseAccomplice();
+	if (ped == nil || (ped->bInVehicle && ped->m_pMyVehicle == pVCModChaseLeaderCar))
+		return;
+	ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, pVCModChaseLeaderCar);
+	ped->WarpPedIntoCar(pVCModChaseLeaderCar);
+}
+
+// The team fights on foot only in the endgame: once the leader is cornered at
+// the last beat. Leaving the transport at an ordinary stop stranded the whole
+// squad when he pulled away again, so the chase itself stays mounted.
+void
+VCModChaseTickSquadDismount(CPed *leader, CPlayerPed *player)
+{
+	if (pVCModChaseSquadCar == nil || nVCModChaseSquadCount == 0 || bVCModChaseBoarding)
+		return;
+
+	CVehicle *car = pVCModChaseSquadCar;
+	if (!bVCModChaseSquadDismounted) {
+		if (!bVCModChaseCornered)
+			return;
+		float gap = (car->GetPosition() - leader->GetPosition()).Magnitude2D();
+		// the player drives and chooses where to park; if he walks off to the
+		// fight from further out, the squad follows him out of the car
+		bool playerOut = !(player->bInVehicle && player->m_pMyVehicle == car);
+		if (gap > VCMOD_CHASE_DISMOUNT_RANGE &&
+		    !(playerOut && gap < VCMOD_CHASE_DISMOUNT_LEASH))
+			return;
+		bVCModChaseSquadDismounted = true;
+		VCMOD_DIAG("VCMOD CHASE squad dismount gap %.1f\n", gap);
+	}
+
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead())
+			continue;
+		if (ped->bInVehicle) {
+			if (ped->m_pMyVehicle == nil)
+				continue;
+			if (ped->m_objective != OBJECTIVE_LEAVE_CAR)
+				ped->SetObjective(OBJECTIVE_LEAVE_CAR, ped->m_pMyVehicle);
+			// the fight order has to be queued in the same frame as the exit:
+			// an exit restores whatever was stored before LEAVE_CAR, and the
+			// boarding order stored there walks the man straight back in. A
+			// later SetObjective cannot replace that temporary objective; the
+			// engine only stashes it and keeps ENTER_CAR (PedAI.cpp:242-251).
+			ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, leader);
+			continue;
+		}
+		// a man restored into a boarding order after the exit would walk back
+		// to the door; clear it before giving him the fight
+		if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+		    ped->m_objective == OBJECTIVE_ENTER_CAR_AS_DRIVER)
+			ped->ClearObjective();
+		// on-foot, not any-means: any-means makes a ped whose target is more
+		// than 30 m away get into a car (PedAI.cpp:929), which fights the
+		// leave-car order and loops him in and out of the seat
+		if (ped->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT)
+			ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, leader);
+	}
+}
+
+// No boat finale on this route means the beats simply run out. Ending the run
+// with "he got away" while the player is standing next to him is wrong, so the
+// last beat becomes his stand: the car stops, he and his passenger get out and
+// fight, and the mission still ends the way the design says — on his death.
+void
+VCModChaseCornerPed(CPed *ped, CVehicle *car, CPed *target)
+{
+	if (ped == nil || ped->DyingOrDead() || target == nil)
+		return;
+	if (ped->bInVehicle) {
+		if (ped->m_objective != OBJECTIVE_LEAVE_CAR)
+			ped->SetObjective(OBJECTIVE_LEAVE_CAR, ped->m_pMyVehicle != nil ? ped->m_pMyVehicle : car);
+		// queue the fight behind the exit in the same frame: the exit restores
+		// whatever was stored before LEAVE_CAR (the boarding order, for the
+		// pickup), which would walk him back into the car
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, target);
+		return;
+	}
+	if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+	    ped->m_objective == OBJECTIVE_ENTER_CAR_AS_DRIVER)
+		ped->ClearObjective();
+	// on-foot kill also attacks a target sitting in his car; any-means would
+	// make the ped grab a car and fight the leave-car order
+	if (ped->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT || ped->m_pedInObjective != target)
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, target);
+}
+
+// The criminal a squad man should fight: the one he is already on, else the
+// nearest living one. Sticking to the current target stops the order flipping
+// between two equally close men, which makes the cop hesitate.
+CPed *
+VCModChaseCriminalTarget(CPed *from)
+{
+	if (from == nil)
+		return nil;
+	CPed *leader = VCModChaseLeader();
+	CPed *current = from->m_pedInObjective;
+	// the leader, or one of the crew: mission-owned and not on the player's side
+	bool currentCriminal = current != nil &&
+		(current == leader ||
+		 (current->CharCreatedBy == MISSION_CHAR && !current->bIsPlayerFriend && !current->IsPlayer()));
+	if (currentCriminal && !current->DyingOrDead())
+		return current;
+
+	CPed *best = nil;
+	float bestDist = 1.0e6f;
+	for (int32 i = -1; i < nVCModChaseCrewCap; i++) {
+		CPed *c = i < 0 ? leader : VCModChaseCrewPed(i);
+		if (c == nil || c == from || c->DyingOrDead())
+			continue;
+		float d = (c->GetPosition() - from->GetPosition()).Magnitude2D();
+		if (d < bestDist) {
+			bestDist = d;
+			best = c;
+		}
+	}
+	return best;
+}
+
+void
+VCModChaseCorner(CPed *leader, CPlayerPed *player)
+{
+	if (!bVCModChaseCornered) {
+		bVCModChaseCornered = true;
+		VCModHudNotice("chase: he is cornered");
+		VCMOD_DIAG("VCMOD CHASE cornered at %.1f %.1f %.1f\n",
+			leader->GetPosition().x, leader->GetPosition().y, leader->GetPosition().z);
+	}
+	CVehicle *car = leader->m_pMyVehicle;
+	if (car != nil) {
+		car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		car->AutoPilot.m_nCruiseSpeed = 0;
+		car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	}
+	// the crew fights the police crew, not only the player: each man takes the
+	// closest cop who is not already taken, so they spread instead of stacking
+	CPed *leaderTarget = VCModChaseCopTarget(leader, nil);
+	VCModChaseCornerPed(leader, car, leaderTarget);
+	CPed *lastTarget = leaderTarget;
+	for (int32 i = 0; i < nVCModChaseCrewCap; i++) {
+		CPed *crew = VCModChaseCrewPed(i);
+		if (crew == nil || crew->DyingOrDead())
+			continue;
+		CPed *target = VCModChaseCopTarget(crew, lastTarget);
+		if (target == nil)
+			target = lastTarget;
+		if (target != nil)
+			lastTarget = target;
+		VCModChaseCornerPed(crew, car, target);
+	}
+	// The air team lands with no transport, so VCModChaseTickSquadDismount (which
+	// re-issues the ground squad's fight every frame) has nothing to run on and
+	// the cops stand passive until someone shoots them. Keep the fight order
+	// alive here; the ground start still uses the squad car's dismount path.
+	if (pVCModChaseSquadCar == nil) {
+		for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+			CPed *ped = VCModChaseSquadPed(i);
+			if (ped == nil || ped->DyingOrDead())
+				continue;
+			CPed *target = VCModChaseCriminalTarget(ped);
+			if (target != nil)
+				VCModChaseCornerPed(ped, nil, target);
+		}
+	}
+}
+
+// A spot off the driving lane on the first side without a wall or water, so the
+// car parks at the kerb instead of stopping dead in the road.
+bool
+VCModChasePullSpot(CVehicle *car, CVector *out)
+{
+	CVector right = car->GetRight();
+	right.z = 0.0f;
+	if (right.Magnitude2D() < 0.01f)
+		return false;
+	right.Normalise2D();
+	for (int32 side = 1; side >= -1; side -= 2) {
+		CVector dir = right * (float)side;
+		CVector spot = car->GetPosition() + dir * VCMOD_CHASE_PULL_DIST;
+		if (VCModChaseInWater(spot) || VCModChaseBridge(spot))
+			continue;
+		CVector from = car->GetPosition();
+		CVector to = spot;
+		from.z += 1.2f;
+		to.z += 1.2f;
+		CColPoint point;
+		CEntity *hit = nil;
+		if (CWorld::ProcessLineOfSight(from, to, point, hit, true, false, false, false, true, false))
+			continue;
+		spot.z = car->GetPosition().z;
+		*out = spot;
+		return true;
+	}
+	return false;
+}
+
+// End of the route with no boat finale. Pull over first, then call the stand.
+bool
+VCModChaseTickCornerReady(CPed *leader, CPlayerPed *player, uint32 now)
+{
+	if (bVCModChaseCornered)
+		return true;
+	if (!bVCModChasePullingOver) {
+		bVCModChasePullingOver = true;
+		nVCModChasePullAt = now + VCMOD_CHASE_PULL_TIME;
+		CVehicle *car = pVCModChaseLeaderCar;
+		CVector spot;
+		if (car != nil && VCModChasePullSpot(car, &spot)) {
+			vecVCModChasePullSpot = spot;
+			VCMOD_DIAG("VCMOD CHASE pull over to %.1f %.1f %.1f\n", spot.x, spot.y, spot.z);
+			VCModChaseDriveCar(car, spot);
+			car->AutoPilot.m_nCruiseSpeed = VCMOD_CHASE_PULL_SPEED;
+			car->AutoPilot.m_fMaxTrafficSpeed = VCMOD_CHASE_PULL_SPEED;
+			return false;
+		}
+		nVCModChasePullAt = now;	// no room: stop where he is
+	}
+	CVehicle *car = pVCModChaseLeaderCar;
+	if (car != nil && (car->GetPosition() - vecVCModChasePullSpot).Magnitude2D() > VCMOD_CHASE_PULL_NEAR &&
+	    now < nVCModChasePullAt)
+		return false;
+	VCModChaseCorner(leader, player);
+	return true;
+}
diff --git a/src/extras/vcmodcombat.cpp b/src/extras/vcmodcombat.cpp
new file mode 100644
index 0000000..93bea06
--- /dev/null
+++ b/src/extras/vcmodcombat.cpp
@@ -0,0 +1,556 @@
+#include "common.h"
+
+#include <stdio.h>
+
+#include "vcmodcombat.h"
+#include "vcmodnpc.h"
+#include "vcmodhud.h"
+#include "vcmodsit.h"
+#include "vcmodstreet.h"
+
+#include "AnimBlendAssociation.h"
+#include "AnimBlendClumpData.h"
+#include "AnimManager.h"
+#include "General.h"
+#include "Ped.h"
+#include "PlayerInfo.h"
+#include "PlayerPed.h"
+#include "RpAnimBlend.h"
+#include "Timer.h"
+#include "Wanted.h"
+#include "Weapon.h"
+#include "WeaponInfo.h"
+
+bool bVCModAimAllWeapons;
+bool bVCModPlayerDoomAim;
+bool bVCModNoScopedAim;
+bool bVCModNeverWanted;
+bool bVCModCopPistol;
+// ambient behaviour rather than a cheat: NPCs always play the tail out, so the
+// player does too until the row is flipped off
+bool bVCModWeaponRecovery = true;
+// walking with a lock is the same freedom the arm-aim pistols always had, so it
+// starts on; the row turns the stock freeze back on for anyone who wants it
+bool bVCModAimWalk = true;
+int32 nVCModCopHoldFrame;
+
+// The colt's two-hand pose is the fifth animation of its group (colt45_cop), which
+// upstream gives only to PEDTYPE_COP. WEAPON.DAT sets WEAPONFLAG_COP3_RD on Colt45
+// and on nothing else that owns the anim, so the flag alone decides coverage.
+bool
+VCModCopTwoHandPose(CPed *ped, CWeaponInfo *info)
+{
+	return bVCModCopPistol && ped->IsPlayer() && info->IsFlagSet(WEAPONFLAG_COP3_RD);
+}
+
+AnimationId
+VCModCopFireAnim(CPed *ped, CWeaponInfo *info)
+{
+	if (VCModCopTwoHandPose(ped, info))
+		return CPed::Get3rdFireAnim(info);
+	return ped->GetFireAnimNotDucking(info);
+}
+
+// Holding the cop pose is the same animation, parked at a frame the player picks
+// instead of the loop start weapon.dat only defines for colt45_fire
+AnimationId
+VCModCopAimAnim(CPed *ped, CWeaponInfo *info)
+{
+	if (VCModCopTwoHandPose(ped, info))
+		return ANIM_WEAPON_FIRE_3RD;
+	return ANIM_WEAPON_FIRE;
+}
+
+static bool bVCModCopRecovering;
+
+void
+VCModCopSetStance(CPed *ped, CAnimBlendAssociation *assoc, bool firing)
+{
+	// the shot plays the clip's stance; the lowered hold keeps the arms only, so the
+	// movement clip still walks and bobs the body under the two-hand grip. The legs
+	// hang off Spine, so leaving the torso out is what stops a walk from stiffening.
+	// The shot keeps the clip's Root: its drop (~0.14m) is the weight the stance
+	// puts on the floor. Only the limb translations are pinned, because those are
+	// what displace the legs out of the hips on the player's skeleton.
+	static const char *aCopedBones[] = {
+		"Root", "Pelvis", "Spine", "Spine1",
+		"L Thigh", "R Thigh", "L Calf", "R Calf", "L Foot", "R Foot"
+	};
+	// the clip's per-bone translations are authored on the cop skeleton; on the
+	// player they push the legs out of the hips instead of posing them
+	static const char *aShiftedBones[] = {
+		"Pelvis", "L Thigh", "R Thigh", "L Calf", "R Calf", "L Foot", "R Foot"
+	};
+
+	if (!ped->IsPlayer() || assoc == nil || assoc->animId != ANIM_WEAPON_FIRE_3RD || assoc->nodes == nil)
+		return;
+	if (assoc->groupId < 0 || assoc->groupId >= NUM_ANIM_ASSOC_GROUPS)
+		return;
+	RpClump *clump = ped->GetClump();
+	CAnimBlendClumpData *clumpData = *RPANIMBLENDCLUMPDATA(clump);
+	if (clumpData == nil)
+		return;
+	CAnimBlendAssociation *stock = CAnimManager::GetAnimAssociation((AssocGroupId)assoc->groupId, (AnimationId)assoc->animId);
+	if (stock == nil || stock->nodes == nil)
+		return;
+	// A masked node stops advancing, so masking a clip that is still playing leaves
+	// the spine and legs on an older frame than the arms. Only the parked clip is a
+	// hold: while it runs it is the shot, its lowering tail, or a shot starting
+	// mid-tail, and the callers that ask for a hold there race with that.
+	bool shot = firing
+		|| assoc->IsRunning() || bVCModCopRecovering
+		|| VCModCopTwoHandFiring(ped, CWeaponInfo::GetWeaponInfo(ped->GetWeapon()->m_eWeaponType));
+	bool restored = false;
+	for (int i = 0; i < ARRAY_SIZE(aCopedBones); i++) {
+		AnimBlendFrameData *frame = RpAnimBlendClumpFindFrame(clump, aCopedBones[i]);
+		if (frame != nil) {
+			int node = frame - clumpData->frames;
+			CAnimBlendSequence *sequence = shot ? stock->nodes[node].sequence : nil;
+			if (assoc->nodes[node].sequence != sequence) {
+				assoc->nodes[node].sequence = sequence;
+				restored |= sequence != nil;
+			}
+		}
+	}
+	for (int i = 0; i < ARRAY_SIZE(aShiftedBones); i++) {
+		AnimBlendFrameData *frame = RpAnimBlendClumpFindFrame(clump, aShiftedBones[i]);
+		if (frame != nil) {
+			if (shot)
+				frame->flag |= AnimBlendFrameData::IGNORE_TRANSLATION;
+			else
+				frame->flag &= ~AnimBlendFrameData::IGNORE_TRANSLATION;
+		}
+	}
+	// Masked nodes stop advancing; seek restored tracks before the next blend.
+	if (restored)
+		assoc->SetCurrentTime(assoc->currentTime);
+}
+
+// colt45_cop raises the gun for the shot and ends back on the lowered hold pose.
+// Letting the tail (recoil -> lowered) play after a burst is the recovery; parking
+// the hold the moment the trigger is let go would snap the gun down instead.
+static const float VCModCopRecoverCut = 0.05f;
+
+bool
+VCModCopTwoHandFiring(CPed *ped, CWeaponInfo *info)
+{
+	return VCModCopTwoHandPose(ped, info)
+		&& (ped->m_nPedState == PED_ATTACK || bVCModCopRecovering);
+}
+
+bool
+VCModCopRecoveringTail(void)
+{
+	return bVCModCopRecovering;
+}
+
+// Every firearm clip has the cop clip's shape: a loop window that weapon.dat
+// parks on, then a tail that returns the arms to the lowered pose. NPCs run the
+// clip out and stay on that lowered pose; the player parks on the loop end, so
+// his tail never shows while he still aims. The tail's end is the hold, the same
+// way colt45_cop's lowered carry is the two-hand hold.
+static bool bVCModWeaponRecovering;
+
+bool
+VCModWeaponRecovering(void)
+{
+	return bVCModWeaponRecovering;
+}
+
+// the two-hand colt browses its own tail through bVCModCopRecovering, so this
+// stands down for that pose and leaves it exactly as it was
+static bool
+VCModWeaponRecoveryWanted(CPed *ped, CWeaponInfo *info, CAnimBlendAssociation *assoc, float loopEnd)
+{
+	if (!bVCModWeaponRecovery || !ped->IsPlayer() || ped->bIsDucking || assoc == nil || assoc->hierarchy == nil)
+		return false;
+	if (VCModCopTwoHandPose(ped, info))
+		return false;
+	return assoc->hierarchy->totalLength > loopEnd + VCModCopRecoverCut;
+}
+
+// The tail is the author's lowering, and it is a planted pose: the player watches
+// it out before he walks again, the same way an NPC plays it. The parked hold it
+// ends on is not part of the tail, so walking from the hold stays free.
+bool
+VCModAimTailRunning(CPed *ped)
+{
+	if (!bVCModWeaponRecovering || !ped->IsPlayer())
+		return false;
+	CWeaponInfo *info = CWeaponInfo::GetWeaponInfo(ped->GetWeapon()->m_eWeaponType);
+	if (VCModCopTwoHandPose(ped, info))
+		return false;
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(ped->GetClump(), VCModCopAimAnim(ped, info));
+	return assoc != nil && assoc->IsRunning();
+}
+
+// AIM RAISE: a fresh lock plays the climb instead of jumping the clip — the
+// clip's own raise frames from a cold start, or the recovery tail played back
+// from the lowered hold — while the body sweeps with CPed::TurnBody and the
+// pose blends at the stock rate. The trigger is dead until both land.
+static bool bVCModAimRaising;
+// set by CPed::PointGunAt once the clip is parked on the hold frame, so a clip
+// parked in the lowered recovery hold cannot report the raise as finished
+static bool bVCModAimHoldLanded;
+
+void
+VCModAimRaiseStart(void)
+{
+	bVCModAimRaising = true;
+	bVCModAimHoldLanded = false;
+}
+
+void
+VCModAimRaiseStop(void)
+{
+	bVCModAimRaising = false;
+}
+
+bool
+VCModAimRaising(void)
+{
+	return bVCModAimRaising;
+}
+
+// the trigger is dead while the gun is climbing, so the engine asks instead of
+// reading the raise state
+bool
+VCModPlayerAttackAllowed(void)
+{
+	return !VCModAimRaising();
+}
+
+void
+VCModAimRaiseHoldLanded(void)
+{
+	if (bVCModAimRaising)
+		bVCModAimHoldLanded = true;
+}
+
+// true once the clip is parked on the hold and the stock aim-pose blend has
+// finished, i.e. the gun is visually up; a missing clip (melee, a group without
+// the aim anim) must not hold the trigger
+bool
+VCModAimPoseRaised(CPed *ped)
+{
+	CWeaponInfo *info = CWeaponInfo::GetWeaponInfo(ped->GetWeapon()->m_eWeaponType);
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(ped->GetClump(), VCModCopAimAnim(ped, info));
+	return assoc == nil || (bVCModAimHoldLanded && assoc->blendAmount >= 1.0f);
+}
+
+// The IK aims by twisting the spine, and colt45_cop's legs and pelvis hang off
+// that spine: the twist splays the baked stance mid-chase and pins the torso
+// while the player walks with the lowered hold. RotatePlayerToTrackTarget turns
+// the whole body on the target instead, so the pose wants no torso twist at all.
+bool
+VCModCopStanceAim(CPed *ped)
+{
+	if (!ped->IsPlayer())
+		return false;
+	return VCModCopTwoHandPose(ped, CWeaponInfo::GetWeaponInfo(ped->GetWeapon()->m_eWeaponType));
+}
+
+bool
+VCModAimHoldMoving(CPed *ped)
+{
+	if (!ped->IsPlayer())
+		return false;
+	CPlayerPed *player = (CPlayerPed*)ped;
+	return player->m_nMoveState == PEDMOVE_WALK || player->m_nMoveState == PEDMOVE_RUN
+		|| player->m_fMoveSpeed > 0.1f;
+}
+
+bool
+VCModAimWalkWeapon(CPed *ped, CWeaponInfo *info)
+{
+	return bVCModAimWalk && ped->IsPlayer() && !ped->bIsDucking
+		&& !VCModCopTwoHandPose(ped, info)
+		&& !info->IsFlagSet(WEAPONFLAG_CANAIM_WITHARM);
+}
+
+// The player's per-frame accuracy, the value PlayerPed used to write into
+// itself: 95 for a gun weapon.dat marks CANAIM, 100 otherwise, and 60 with DOOM
+// AIM so a locked-on shot sprays like an NPC's instead of landing dead centre.
+void
+VCModPlayerWepAccuracy(CPlayerPed *player, CWeaponInfo *info)
+{
+	if (info->IsFlagSet(WEAPONFLAG_CANAIM))
+		player->m_wepAccuracy = 95;
+	else
+		player->m_wepAccuracy = 100;
+	// what CPed's constructor hands every ped. Their locked-on shots spray, and the
+	// first round of a burst is no more accurate than the last.
+	if (bVCModPlayerDoomAim)
+		player->m_wepAccuracy = 60;
+}
+
+// The ramp is the player's trigger feel: the first round of a burst is dead-on
+// and sustained fire wanders. It is driven off m_fAttackButtonCounter, which only
+// ProcessPlayerWeapon maintains; NPC mode skips that function, so the counter
+// only ever grows and the cop's aim collapsed the longer a hunt ran. The AI has
+// no trigger to model, so it fires like the ped it is: off the accuracy value.
+bool
+VCModPlayerAimRamp(CEntity *shooter)
+{
+	return shooter == FindPlayerPed() && !bVCModPlayerDoomAim && !VCModNpcCombatActive();
+}
+
+// The post-burst aim hold belongs to the trigger: the player keeps the pose parked
+// while the button is down. NPC mode has no button, and a ped's burst end drops
+// the pose (ClearAimFlag) so the AI can lower the gun, run in, or re-raise on the
+// next beat; keeping the hold made the cop's gun never come down during a hunt.
+bool
+VCModPlayerAimPoseHold(CPed *ped)
+{
+	return ped->IsPlayer() && !VCModNpcCombatActive();
+}
+
+// NO SCOPED AIM: the scope camera owns these weapons' first-person entry, and the
+// camera weapon keeps it either way.
+bool
+VCModScopeSkip(CPlayerPed *player)
+{
+	eWeaponType weapon = player->GetWeapon()->m_eWeaponType;
+	return bVCModNoScopedAim && weapon != WEAPONTYPE_CAMERA &&
+		(weapon == WEAPONTYPE_ROCKETLAUNCHER || weapon == WEAPONTYPE_SNIPERRIFLE ||
+		 weapon == WEAPONTYPE_LASERSCOPE || weapon == WEAPONTYPE_M4 ||
+		 weapon == WEAPONTYPE_RUGER || weapon == WEAPONTYPE_M60);
+}
+
+bool
+VCModCombatAimTick(CPed *ped, CWeaponInfo *weaponInfo, CAnimBlendAssociation *weaponAssoc)
+{
+	if (ped->IsPlayer()) {
+		if (VCModCopTwoHandPose(ped, weaponInfo)) {
+			// the lowering tail is still playing; park the hold only once it lands
+			if (bVCModCopRecovering) {
+				float clipEnd = weaponAssoc ? weaponAssoc->hierarchy->totalLength : 0.0f;
+				if (weaponAssoc && weaponAssoc->IsRunning() && weaponAssoc->currentTime < clipEnd - VCModCopRecoverCut
+					&& !VCModAimRaising())
+					return true;
+				bVCModCopRecovering = false;
+			}
+			VCModCopSetStance(ped, weaponAssoc, false);
+			// the held pose leaves the arms in the carry, so walking with it makes
+			// Tommy glide with pinned arms; let locomotion own the body while he
+			// moves and bring the two-hand carry back when he stands still or fires
+			if (weaponAssoc) {
+				if (VCModAimHoldMoving(ped) && weaponAssoc->blendAmount > 0.0f)
+					weaponAssoc->blendDelta = -8.0f;
+				else if (!VCModAimHoldMoving(ped) && weaponAssoc->blendAmount < 1.0f)
+					weaponAssoc->blendDelta = 8.0f;
+			}
+		} else {
+			bVCModCopRecovering = false;
+			// AIM WALK: walking with a lock hands the body to locomotion, the way the
+			// two-hand hold does, so the parked aim pose does not glide under the
+			// walk. The tail is never cut: while it plays the player is planted and
+			// this branch is unreachable, so the lowering always lands first.
+			if (VCModAimWalkWeapon(ped, weaponInfo) && VCModAimHoldMoving(ped)
+				&& !VCModAimTailRunning(ped)) {
+				if (weaponAssoc) {
+					weaponAssoc->flags &= ~ASSOC_DELETEFADEDOUT;
+					if (weaponAssoc->blendAmount > 0.0f)
+						weaponAssoc->blendDelta = -8.0f;
+				}
+				return true;
+			}
+			// The tail is the author's recovery and it ends on the lowered pose.
+			// Let it run out, then keep that end pose: the clip would otherwise
+			// fade itself into the idle arms, and the aim pose would come back.
+			if (bVCModWeaponRecovering && weaponAssoc) {
+				if (weaponAssoc->IsRunning() && !VCModAimRaising())
+					return true;
+				if (weaponAssoc->flags & ASSOC_DELETEFADEDOUT) {
+					weaponAssoc->flags &= ~ASSOC_DELETEFADEDOUT;
+					weaponAssoc->SetBlend(1.0f, 0.0f);
+				} else if (weaponAssoc->blendAmount < 1.0f) {
+					// the walk faded the lowered hold out; standing brings it back
+					weaponAssoc->blendDelta = 8.0f;
+				}
+				// a fresh raise takes the climb over; otherwise the hold stays
+				if (!VCModAimRaising())
+					return true;
+			}
+			bVCModWeaponRecovering = false;
+		}
+	}
+	return false;
+}
+
+bool
+VCModCombatArmRecovery(CPed *ped, CWeaponInfo *info, CAnimBlendAssociation *assoc, float loopEnd)
+{
+	// NPC mode fires on the AI's beat, not a trigger: a ped holds the aim pose
+	// between beats and never plays the player's lowering tail, so taking the
+	// recovery here made the cop lower the gun after every burst
+	if (VCModNpcCombatActive())
+		return false;
+	if (VCModCopTwoHandPose(ped, info)) {
+		// leave the clip running: the lowering tail is the recovery
+		bVCModCopRecovering = true;
+		return true;
+	}
+	if (VCModWeaponRecoveryWanted(ped, info, assoc, loopEnd)) {
+		// the same tail an NPC plays; PointGunAt parks the hold after it
+		bVCModWeaponRecovering = true;
+		return true;
+	}
+	return false;
+}
+
+void
+VCModCombatNewBurst(CPed *ped, CWeaponInfo *info, CAnimBlendAssociation *assoc,
+	bool stillAttacking, float loopStart, float loopEnd)
+{
+	// A new burst outranks a recovery in progress: the gun has to come up again,
+	// and the clip is parked in its tail, so rewind it or the shot is swallowed.
+	if (ped->IsPlayer() && stillAttacking && bVCModWeaponRecovering
+		&& !VCModCopTwoHandPose(ped, info)) {
+		bVCModWeaponRecovering = false;
+		if (assoc->currentTime > loopEnd) {
+			assoc->SetCurrentTime(loopStart);
+			assoc->SetRun();
+		}
+		assoc->SetBlend(1.0f, 8.0f);
+	}
+}
+
+void
+VCModCombatClearTails(CPed *ped)
+{
+	if (ped->IsPlayer()) {
+		bVCModCopRecovering = false;
+		bVCModWeaponRecovering = false;
+		bVCModAimRaising = false;
+		bVCModAimHoldLanded = false;
+	}
+}
+
+// a move the player asked for by name, waiting for the next attack slot
+static int32 nVCModForcedFightMove = FIGHTMOVE_NULL;
+
+void
+VCModCombatRequestFightMove(int32 move)
+{
+	nVCModForcedFightMove = move;
+}
+
+int32
+VCModCombatTakeFightMove(void)
+{
+	int32 move = nVCModForcedFightMove;
+	nVCModForcedFightMove = FIGHTMOVE_NULL;
+	return move;
+}
+
+void
+VCModCombatClearFightMove(void)
+{
+	nVCModForcedFightMove = FIGHTMOVE_NULL;
+}
+
+// the spinning roundhouse the peds throw at arm's length: the same
+// FIGHT_ROUNDHOUSE clip through the fight path, so the spin, reach, height and
+// damage are the ped's own instead of a scripted animation
+void
+VCModSpinKick(CPlayerPed *player)
+{
+	if (player->DyingOrDead() || player->bInVehicle || VCModSitting())
+		return;
+	if (player->GetWeapon()->m_eWeaponType != WEAPONTYPE_UNARMED) {
+		static uint32 lastAt;
+		uint32 now = CTimer::GetTimeInMilliseconds();
+		if (lastAt == 0 || now - lastAt > 5000) {
+			lastAt = now;
+			fprintf(stderr, "VCMOD spin kick: fists only\n");
+			VCModHudNotice("spin kick: select fists");
+		}
+		return;
+	}
+	// the stock melee attack only starts from a near-stop or mid-fight
+	if (player->m_fMoveSpeed >= 1.0f && player->m_nPedState != PED_FIGHT)
+		return;
+	VCModStreetFadePose(player);
+	if (VCModStreetChatActive())
+		VCModStreetAbortChat(player, "spin kick");
+	player->StartFightAttack(255, FIGHTMOVE_ROUNDHOUSE);
+}
+
+// SetWantedLevel(0) clears the crime queue and the chaos that feeds it
+void
+VCModNeverWantedClamp(CPlayerPed *player)
+{
+	if (bVCModNeverWanted && (player->m_pWanted->GetWantedLevel() != 0 || player->m_pWanted->m_nChaos != 0))
+		player->m_pWanted->SetWantedLevel(0);
+}
+
+// the profiles that fight like a ped: the chase objective hands combat to the
+// engine, because NPC mode never presses a trigger
+bool
+VCModNpcCombatOwnsControl(CPlayerPed *player)
+{
+	bool npcCombatProfile = VCModNpcGangActive() || VCModNpcCopActive() || VCModNpcCivilianActive();
+	return npcCombatProfile && !player->bInVehicle
+		&& (player->m_objective == OBJECTIVE_KILL_CHAR_ON_FOOT || player->m_objective == OBJECTIVE_KILL_CHAR_ANY_MEANS)
+		&& player->m_pedInObjective && player->m_pedInObjective->m_fHealth > 0.0f
+		&& !player->m_pedInObjective->DyingOrDead() && !player->m_pedInObjective->bInVehicle;
+}
+
+bool
+VCModNpcCombatControl(CPlayerPed *player, bool npcCombatOwnsControl)
+{
+	bool npcCombatProfile = VCModNpcGangActive() || VCModNpcCopActive() || VCModNpcCivilianActive();
+	if (npcCombatProfile && (player->m_nPedState == PED_ATTACK || player->m_nPedState == PED_FIGHT
+		|| player->m_nPedState == PED_AIM_GUN || (player->m_nPedState == PED_IDLE && npcCombatOwnsControl))) {
+		bool ownsCombat = true;
+		if (player->m_nPedState == PED_ATTACK) {
+			if (!npcCombatOwnsControl) {
+				// a bump shove or a stray attack: the one-shot animation is
+				// all it is, and leaving its last frame up is the stuck
+				// wind-up pose. End the state and let the stock block below
+				// restore the walk/idle clip
+				player->ClearAttack();
+				ownsCombat = false;
+			} else {
+				// only a real kill objective starts a fight; the melee
+				// route is the ped entry (StartFightAttack) because there
+				// is no attack button to press. A gun is left to the base
+				// CPed::ProcessControl, which already ran Attack() this
+				// frame: a second call fires the shot twice
+				CWeaponInfo *wi = CWeaponInfo::GetWeaponInfo(player->GetWeapon()->m_eWeaponType);
+				if (player->GetWeapon()->m_eWeaponType == WEAPONTYPE_UNARMED
+					|| player->GetWeapon()->m_eWeaponType == WEAPONTYPE_BRASSKNUCKLE
+					|| wi->IsFlagSet(WEAPONFLAG_FIGHTMODE)) {
+					player->StartFightAttack(CGeneral::GetRandomNumber());
+					player->SetAttackTimer(CGeneral::GetRandomNumberInRange(300, 900));
+				}
+			}
+		} else if (player->m_nPedState == PED_FIGHT) {
+			if (!npcCombatOwnsControl) {
+				// no live target: a stray fight must end, not idle in the
+				// fight stance and swing at whoever is nearby
+				player->EndFight(ENDFIGHT_FAST);
+				ownsCombat = false;
+			} else if (player->m_attackTimer < CTimer::GetTimeInMilliseconds()) {
+				// the AI re-arms the next move through SetAttack every
+				// beat; with no pad, NPC mode requests it on the same
+				// timer. Fight() is the base layer's call, once per frame
+				player->StartFightAttack(CGeneral::GetRandomNumber());
+				player->SetAttackTimer(CGeneral::GetRandomNumberInRange(300, 900));
+			}
+		} else if (player->m_nPedState == PED_AIM_GUN) {
+			// the base layer's aim block (ReactToPointGun + PointGunAt)
+			// already ran this frame; a second pass is not needed
+		} else {
+			player->m_fMoveSpeed = 0.0f;
+			player->m_nStoredMoveState = player->m_nMoveState;
+			player->SetRealMoveAnim();
+		}
+		// a stray attack/fight ends above; let the stock handling below
+		// restore the pose instead of breaking out with the last frame held
+		if (ownsCombat)
+			return true;
+	}
+	return false;
+}
diff --git a/src/extras/vcmodcombat.h b/src/extras/vcmodcombat.h
new file mode 100644
index 0000000..8f7901c
--- /dev/null
+++ b/src/extras/vcmodcombat.h
@@ -0,0 +1,118 @@
+#ifndef VCMODCOMBAT_H
+#define VCMODCOMBAT_H
+
+#include "AnimManager.h"
+
+class CPed;
+class CPlayerPed;
+class CEntity;
+class CWeaponInfo;
+class CAnimBlendAssociation;
+
+// every weapon may lock on, not only the ones weapon.dat sets CANAIM on
+extern bool bVCModAimAllWeapons;
+// the player's locked shots spray like an NPC's instead of landing dead centre
+extern bool bVCModPlayerDoomAim;
+// the scope camera is suppressed; those weapons aim from third person instead
+extern bool bVCModNoScopedAim;
+// no star ever sticks: crimes are still registered, the level is clamped to zero
+extern bool bVCModNeverWanted;
+extern bool bVCModCopPistol;
+// weapon.dat has no loop window for the cop animation, so the frame it is held at
+// has to come from somewhere the player can see and change. 0 is the clip's
+// lowered stance, which is where a locked-on two-hand hold sits between bursts.
+extern int32 nVCModCopHoldFrame;
+// every firearm clip carries a tail past its loop window that lowers the arms;
+// NPCs play it, the player used to park on the loop end and cut it. The two-hand
+// colt browses its own tail and is not part of this switch.
+extern bool bVCModWeaponRecovery;
+// a locked-on target used to root the player for every gun without CANAIM_WITHARM,
+// leaving that to the pistols. With the row on he walks with any weapon, lowering
+// it to the carry while he moves and raising it again when he stops; the shot
+// itself still plants him.
+extern bool bVCModAimWalk;
+
+// true while the two-hand colt pose owns the weapon clips: the player, the row
+// on, and a weapon whose cop clip exists
+bool VCModCopTwoHandPose(CPed *ped, CWeaponInfo *info);
+// the clip a shot plays under the pose: the cop clip for the two-hand colt, the
+// weapon's own otherwise
+AnimationId VCModCopFireAnim(CPed *ped, CWeaponInfo *info);
+// the clip the aim parks on: the cop clip for the two-hand colt, the weapon's own
+// otherwise
+AnimationId VCModCopAimAnim(CPed *ped, CWeaponInfo *info);
+// pins the two-hand stance onto a running clip; firing keeps the clip's own limbs
+void VCModCopSetStance(CPed *ped, CAnimBlendAssociation *assoc, bool firing);
+// true while the two-hand fire clip owns the player, recovery tail included
+bool VCModCopTwoHandFiring(CPed *ped, CWeaponInfo *info);
+// true while the two-hand colt's lowering tail is still playing
+bool VCModCopRecoveringTail(void);
+// true while the player is playing a recovery tail or fading the aim back up; the
+// arm IK has to stand down for both, or it re-aims the lowered arm
+bool VCModWeaponRecovering(void);
+// true while a recovery tail is still playing: the tail is planted, so the player
+// cannot walk until the lowering has landed
+bool VCModAimTailRunning(CPed *ped);
+// true while the pose wants the body, not the IK, to aim the spine
+bool VCModCopStanceAim(CPed *ped);
+// true while the player is walking or running: a parked aim pose cannot own the
+// body then, or the walk glides under it
+bool VCModAimHoldMoving(CPed *ped);
+// true when AIM WALK owns this weapon: the row on, the player standing, and a gun
+// the arm cannot aim with; the pistols already walk and the two-hand colt has its
+// own hold rules
+bool VCModAimWalkWeapon(CPed *ped, CWeaponInfo *info);
+// AIM RAISE: a fresh lock plays the climb — the clip's own raise frames from a
+// cold start, or the recovery tail played back from the lowered hold — while
+// the body sweeps with CPed::TurnBody; the trigger is dead until both land
+void VCModAimRaiseStart(void);
+void VCModAimRaiseStop(void);
+bool VCModAimRaising(void);
+// the player's fire trigger, gated by the raise: false while the gun is climbing
+bool VCModPlayerAttackAllowed(void);
+// PlayerPed's per-frame aim accuracy, the value it used to set itself: 95 for an
+// aimable gun, 100 otherwise, 60 with DOOM AIM
+void VCModPlayerWepAccuracy(CPlayerPed *player, CWeaponInfo *info);
+// the player-only aim ramp: off under DOOM AIM, and off while NPC mode fires the
+// shots, because the AI shoots like a ped off the accuracy value, not the trigger
+bool VCModPlayerAimRamp(CEntity *shooter);
+// the player-only post-burst aim hold: a human still holds the trigger, so the
+// pose stays parked; NPC mode's AI has no trigger and a ped drops the pose
+bool VCModPlayerAimPoseHold(CPed *ped);
+// NO SCOPED AIM: the scope camera must leave these weapons' first-person entry alone
+bool VCModScopeSkip(CPlayerPed *player);
+// CPed::PointGunAt parks the aim clip on the hold frame; the raise only counts
+// as landed from here
+void VCModAimRaiseHoldLanded(void);
+bool VCModAimPoseRaised(CPed *ped);
+
+// true when the aim/recovery state owns the frame and CPed::PointGunAt has to
+// return before it parks the stock hold
+bool VCModCombatAimTick(CPed *ped, CWeaponInfo *info, CAnimBlendAssociation *assoc);
+// the burst is over: arms the lowering tail the shot leaves behind. True means
+// the clip is already parked by the tail, false parks it on the loop end
+bool VCModCombatArmRecovery(CPed *ped, CWeaponInfo *info, CAnimBlendAssociation *assoc, float loopEnd);
+// a new burst outranks a recovery in progress: rewinds the tail the shot landed in
+void VCModCombatNewBurst(CPed *ped, CWeaponInfo *info, CAnimBlendAssociation *assoc,
+	bool stillAttacking, float loopStart, float loopEnd);
+// leaving the aim ends every tail the player owns
+void VCModCombatClearTails(CPed *ped);
+
+// the spin kick command: FIGHTMOVE_ROUNDHOUSE through the fight path
+void VCModSpinKick(CPlayerPed *player);
+// a move the player asked for by name, waiting for the next attack slot
+void VCModCombatRequestFightMove(int32 move);
+int32 VCModCombatTakeFightMove(void);
+void VCModCombatClearFightMove(void);
+
+// NEVER WANTED: a star or a queued crime is cleared the moment it appears
+void VCModNeverWantedClamp(CPlayerPed *player);
+
+// the profiles that fight like a ped; ownsControl is live only while a kill
+// objective points at a living, reachable target
+bool VCModNpcCombatOwnsControl(CPlayerPed *player);
+// true when the NPC combat profile owns this frame's state, so ProcessControl
+// keeps the engine's handling instead of the stock input block
+bool VCModNpcCombatControl(CPlayerPed *player, bool ownsControl);
+
+#endif
