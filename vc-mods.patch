+// The rope parameter runs 0 at the top to just short of 1 at the ground; the
+// stock abseil moves it down, the climb moves it up. Keeping it in one pure
+// step makes the two directions share the same clamps.
+float
+VCModChaseRopeProgress(float t, float rate, float frame, bool up)
+{
+	float next = t + (up ? -rate : rate) * frame;
+	if (next < 0.0f)
+		next = 0.0f;
+	if (next > VCMOD_CHASE_ROPE_BOTTOM)
+		next = VCMOD_CHASE_ROPE_BOTTOM;
+	return next;
+}
