+#!/usr/bin/env python3
+"""Blades-after-bail wiring: the blade pass must run in the spin-down branch and
+keep the stock radii, without a second copy of the collision block anywhere."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+AUTO_H = ROOT / "src/vehicles/Automobile.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class RotorTests(unittest.TestCase):
+    def test_wiring(self):
+        auto = AUTO.read_text()
+        auto_h = AUTO_H.read_text()
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        ini = INI.read_text()
+
+        self.assertIn('"BLADES AFTER BAIL"', rows)
+        self.assertIn("&bVCModRotorBlades", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "RotorsAfterBail"', ini)
+        self.assertIn('#include "vcmodrotor.h"', auto)
+        self.assertIn("void DoHeliBladeCollision(void);", auto_h)
+
+        helper = braced(auto, "CAutomobile::DoHeliBladeCollision")
+        for radius in ("0.72f, 0.9f", "5.15f, 0.8f", "6.15f, 0.5f", "6.15f, 1.0f"):
+            self.assertIn(radius, helper)
+        self.assertIn("m_aWheelSpeed[1] <= 0.015f", helper)
+        self.assertIn("m_aCarNodes[CAR_BONNET]", helper)
+
+        # one definition only: the four collision calls all live in the helper
+        self.assertEqual(auto.count("DoBladeCollision(mat.GetPosition()"), 4)
+
+        # spin-down branch: engine off, rotor decaying, blades still cutting
+        spin = auto.index("m_aWheelSpeed[1] = Max(m_aWheelSpeed[1]-0.0005f, 0.0f);")
+        spin_block = auto[spin:auto.index("}else if(isPlane", spin)]
+        self.assertIn("if(bVCModRotorBlades)", spin_block)
+        self.assertIn("DoHeliBladeCollision();", spin_block)
+
+        # flown branch keeps its stock call
+        flight = auto.index("// Blade collision")
+        self.assertIn("DoHeliBladeCollision();", auto[flight:flight + 120])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/utils/test_vc_shootable.py b/utils/test_vc_shootable.py
new file mode 100644
index 0000000..4d3295c
--- /dev/null
+++ b/utils/test_vc_shootable.py
@@ -0,0 +1,122 @@
+#!/usr/bin/env python3
+"""Shoot-down-projectiles tests: the segment/sphere test on its own, plus static
+checks that the bullet path consults it before handing out damage."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+SHOOT = ROOT / "src/extras/vcmodshootable.cpp"
+WEAPON = ROOT / "src/weapons/Weapon.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+struct CVector {
+    float x, y, z;
+    CVector(float a = 0, float b = 0, float c = 0) : x(a), y(b), z(c) {}
+    CVector operator-(const CVector &o) const { return CVector(x-o.x, y-o.y, z-o.z); }
+    CVector operator+(const CVector &o) const { return CVector(x+o.x, y+o.y, z+o.z); }
+    CVector operator*(float f) const { return CVector(x*f, y*f, z*f); }
+    float MagnitudeSqr() const { return x*x + y*y + z*z; }
+};
+static float DotProduct(const CVector &a, const CVector &b) { return a.x*b.x + a.y*b.y + a.z*b.z; }
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    CVector o(0, 0, 0), far(10, 0, 0);
+    CHECK(VCModShotHitsPoint(o, far, CVector(5, 0, 0), 0.6f), "a projectile on the line goes up");
+    CHECK(VCModShotHitsPoint(o, far, CVector(10, 0, 0), 0.6f), "the far end counts");
+    CHECK(VCModShotHitsPoint(o, far, CVector(5, 0.5f, 0), 0.6f), "inside the radius counts");
+    CHECK(!VCModShotHitsPoint(o, far, CVector(5, 0.7f, 0), 0.6f), "outside the radius misses");
+    CHECK(!VCModShotHitsPoint(o, far, CVector(-1, 0, 0), 0.6f), "behind the muzzle misses");
+    CHECK(!VCModShotHitsPoint(o, far, CVector(11, 0, 0), 0.6f), "past the wall the shot stopped at misses");
+    CHECK(!VCModShotHitsPoint(o, o, CVector(0, 0, 0), 0.6f), "a zero-length shot hits nothing");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(name):
+    text = SHOOT.read_text()
+    match = re.search(r"((?:[A-Za-z_][A-Za-z0-9_]*[\s*]+)+)" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {SHOOT}")
+    start = match.start()
+    opening = match.end() - 1
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+def source():
+    return PRELUDE + cut("VCModShotHitsPoint") + MAIN
+
+
+class ShootableTests(unittest.TestCase):
+    def test_hit_geometry(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "shootable"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source(), text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_wiring(self):
+        weapon = WEAPON.read_text()
+        shoot = SHOOT.read_text()
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        ini = INI.read_text()
+
+        self.assertIn('"SHOOT PROJECTILES"', rows)
+        self.assertIn("&bVCModShootableProjectiles", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "ShootProjectiles"', ini)
+        self.assertIn('#include "vcmodshootable.h"', weapon)
+
+        # the bullet path asks before it damages anything
+        impact = braced(weapon, "CWeapon::DoBulletImpact")
+        self.assertIn("VCModShootProjectiles(*source, shotEnd, shooter)", impact)
+        self.assertLess(impact.index("VCModShootProjectiles("), impact.index("CGlass::WasGlassHitByBullet"))
+        self.assertIn("victim ? point->point : *target", impact)
+
+        # detonation goes through the engine's own removal, which picks the boom
+        self.assertIn("CProjectileInfo::RemoveProjectile(info, CProjectileInfo::ms_apProjectile[i])", shoot)
+        for weaponType in ("WEAPONTYPE_GRENADE", "WEAPONTYPE_MOLOTOV", "WEAPONTYPE_ROCKET"):
+            self.assertIn(weaponType, shoot)
+        # a rocket's removal dereferences its source
+        self.assertIn("info->m_pSource == nil", shoot)
+        self.assertIn("NUM_PROJECTILES", shoot)
+
+
+if __name__ == "__main__":
+    unittest.main()
