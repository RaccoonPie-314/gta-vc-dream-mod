+#!/usr/bin/env python3
+"""Passenger-mode tests: the ride state machine out of vcmodride.cpp and the
+destination list out of vcmodpanel.cpp, compiled against small engine stubs.
+
+The stubs here are shared with test_vc_driver.py, which covers the chauffeur;
+the compiler step, the brace matcher and the engine preamble live in
+vcmod_test_support.py.
+"""
+import re
+import unittest
+
+from vcmod_test_support import ENGINE_STUBS, ROOT, braced, run_cpp
+
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+PLAYER = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+PLAYERMOD = (ROOT / "src/extras/vcmodplayer.cpp").read_text()
+HEAD = (ROOT / "src/extras/vcmodpanel.h").read_text()
+RIDE = (ROOT / "src/extras/vcmodride.cpp").read_text()
+HUD = (ROOT / "src/extras/vcmodhud.cpp").read_text()
+RIDE_H = (ROOT / "src/extras/vcmodride.h").read_text()
+INI = (ROOT / "src/core/re3.cpp").read_text()
+KEYS = (ROOT / "src/extras/vcmodkeys.cpp").read_text()
+ZONES = (ROOT / "src/core/Zones.h").read_text()
+
+def ride_statics():
+    """The ride's own state, tuning constants and forward declarations."""
+    start = RIDE.index("static int32 nVCModRideHandle")
+    end = RIDE.index("int32\nVCModRidePhase(void)")
+    return RIDE[start:end]
+
+
+def ride_enums():
+    return (braced(RIDE_H, "enum eVCModRideStyle") + ";\n" +
+            braced(RIDE_H, "enum eVCModRidePhase") + ";\n")
+
+
+VEHICLE_STUBS = r'''
+std::vector<std::string> events;
+enum eVCModRideVehicleType { VEH_CAR, VEH_BIKE, VEH_BOAT, VEH_PLANE, VEH_HELI, VEH_TRAIN };
+enum { STATUS_SIMPLE, STATUS_PHYSICS, STATUS_PLAYER, STATUS_ABANDONED, STATUS_WRECKED,
+       STATUS_TRAIN_NOT_MOVING };
+enum { CAR_CREATED_BY_RANDOM, CAR_CREATED_BY_MISSION, CAR_CREATED_BY_SCRIPT, CAR_CREATED_BY_PARKED };
+#define RANDOM_VEHICLE CAR_CREATED_BY_RANDOM
+#define PARKED_VEHICLE CAR_CREATED_BY_PARKED
+#define MISSION_VEHICLE CAR_CREATED_BY_MISSION
+enum eObjective { OBJECTIVE_NONE, OBJECTIVE_ENTER_CAR_AS_DRIVER, OBJECTIVE_ENTER_CAR_AS_PASSENGER, OBJECTIVE_LEAVE_CAR };
+enum ePedState { PED_IDLE, PED_ENTER_CAR, PED_DRIVING, PED_ON_FOOT };
+enum { MISSION_NONE, MISSION_CRUISE, MISSION_GOTOCOORDS, MISSION_STOP_FOREVER,
+       MISSION_GOTOCOORDS_STRAIGHT };
+enum { TEMPACT_NONE };
+enum { DRIVINGSTYLE_STOP_FOR_CARS, DRIVINGSTYLE_SLOW_DOWN_FOR_CARS, DRIVINGSTYLE_AVOID_CARS,
+       DRIVINGSTYLE_PLOUGH_THROUGH, DRIVINGSTYLE_STOP_FOR_CARS_IGNORE_LIGHTS };
+enum { MI_PLAYER, MI_STRETCH = 139 };
+enum { PATH_CAR, PATH_PED };
+enum { BLIP_CAR, BLIP_CHAR };
+enum { BLIP_DISPLAY_BOTH, BLIP_DISPLAY_MARKER_ONLY };
+enum { FADE_IN, FADE_OUT };
+struct CVector2D {
+    float x, y;
+    CVector2D() : x(0.0f), y(0.0f) {}
+    CVector2D(float xx, float yy) : x(xx), y(yy) {}
+    void Normalise(void) {
+        float m = (float) std::sqrt(x * x + y * y);
+        if (m > 0.0f) { x /= m; y /= m; }
+    }
+};
+struct CVector : CVector2D {
+    float z;
+    CVector() : CVector2D(), z(0.0f) {}
+    CVector(float xx, float yy, float zz) : CVector2D(xx, yy), z(zz) {}
+    CVector operator-(const CVector &o) const { return CVector(x - o.x, y - o.y, z - o.z); }
+    CVector operator*(float s) const { return CVector(x * s, y * s, z * s); }
+    float Magnitude2D() const { return (float) std::sqrt(x * x + y * y); }
+};
+'''
+
+RIDE_STUBS = r'''
+struct CAutoPilot {
+    int32 m_nCarMission; int32 m_nTempAction; int32 m_nDrivingStyle; int32 m_nCruiseSpeed;
+    float m_fMaxTrafficSpeed;
+    /* an ordinary generated traffic car: conservative pace, no weaving */
+    CAutoPilot() : m_nCarMission(MISSION_NONE), m_nTempAction(TEMPACT_NONE),
+                   m_nDrivingStyle(DRIVINGSTYLE_STOP_FOR_CARS), m_nCruiseSpeed(11),
+                   m_fMaxTrafficSpeed(11.0f) {}
+};
+struct CPed { int32 dummy; };
+CPed driverPed;
+bool spawnDriverFails = false;
+struct CEntity {
+    CVector pos; CVector fwd; CVector right; CVector up;
+    bool isVehicle; int32 modelIndex;
+    CEntity() : fwd(0.0f, 1.0f, 0.0f), right(1.0f, 0.0f, 0.0f), up(0.0f, 0.0f, 1.0f),
+                isVehicle(false), modelIndex(MI_PLAYER) {}
+    virtual ~CEntity() {}
+    CVector GetPosition(void) { return pos; }
+    void SetPosition(const CVector &p) { pos = p; }
+    CVector &GetForward(void) { return fwd; }
+    CVector &GetRight(void) { return right; }
+    CVector &GetUp(void) { return up; }
+    bool IsVehicle(void) { return isVehicle; }
+    virtual bool IsCar(void) { return false; }
+    virtual void Teleport(CVector p) { pos = p; events.push_back("teleport"); }
+    float GetDistanceFromCentreOfMassToBaseOfModel(void) { return 1.0f; }
+    int32 GetModelIndex(void) { return modelIndex; }
+};
+struct CVehicle : CEntity {
+    eVCModRideVehicleType kind; int32 handle; CAutoPilot AutoPilot;
+    CPed *pDriver; CPed *pPassengers[8]; int32 m_nNumMaxPassengers; int32 VehicleCreatedBy;
+    int32 status;
+    CVehicle() : kind(VEH_CAR), handle(0), pDriver(nil), m_nNumMaxPassengers(4),
+                 VehicleCreatedBy(RANDOM_VEHICLE), status(STATUS_PHYSICS) {
+        isVehicle = true;
+        for (int i = 0; i < 8; ++i) pPassengers[i] = nil;
+    }
+    bool IsCar(void) { return kind == VEH_CAR; }
+    bool IsBike(void) { return kind == VEH_BIKE; }
+    bool IsBoat(void) { return kind == VEH_BOAT; }
+    bool IsPlane(void) { return kind == VEH_PLANE; }
+    bool IsHeli(void) { return kind == VEH_HELI; }
+    bool IsTrain(void) { return kind == VEH_TRAIN; }
+    int32 GetStatus(void) { return status; }
+    void SetStatus(int32 s) { status = s; events.push_back("status:" + to_string(s)); }
+    CPed *SetUpDriver(void) {
+        if (spawnDriverFails || VehicleCreatedBy != RANDOM_VEHICLE) return nil;
+        events.push_back("driver");
+        pDriver = &driverPed;
+        return &driverPed;
+    }
+};
+struct CPlayerPed : CEntity {
+    bool controlsOn; bool bInVehicle; CVehicle *m_pMyVehicle;
+    int32 m_objective; CVehicle *m_carInObjective; int32 m_nPedState;
+    CPlayerPed() : controlsOn(true), bInVehicle(false), m_pMyVehicle(nil),
+                   m_objective(OBJECTIVE_NONE), m_carInObjective(nil), m_nPedState(PED_ON_FOOT) {}
+    bool IsPedInControl(void) { return controlsOn; }
+    bool InVehicle(void) { return bInVehicle && m_pMyVehicle; }
+    bool EnteringCar(void) { return false; }
+    void SetObjective(int32 obj, CVehicle *veh) {
+        events.push_back("objective:" + to_string(obj));
+        m_objective = obj; m_carInObjective = veh;
+    }
+};
+CPlayerPed playerPed;
+CPlayerPed *FindPlayerPed(void) { return &playerPed; }
+/* no crew in these tests: every car is an ordinary one */
+bool VCModCrewOwnsCar(CVehicle*) { return false; }
+bool VCModCrewEntry(CVehicle*) { return false; }
+CEntity *FindPlayerEntity(void) {
+    if (playerPed.bInVehicle && playerPed.m_pMyVehicle) return playerPed.m_pMyVehicle;
+    return &playerPed;
+}
+/* a pool that can hold the car under test and one more, so a ride can be
+   replaced without the old vehicle vanishing */
+CVehicle *poolSlots[4] = { nil, nil, nil, nil };
+void poolClear(void) { for (int i = 0; i < 4; ++i) poolSlots[i] = nil; }
+void poolAdd(CVehicle *veh) {
+    for (int i = 0; i < 4; ++i)
+        if (poolSlots[i] == nil) { poolSlots[i] = veh; return; }
+}
+struct CVehiclePool {
+    int32 GetIndex(CVehicle *veh) { return veh->handle; }
+    CVehicle *GetAt(int32 handle) {
+        // a handle, not an index: a recycled slot stops resolving
+        if (handle < 0) return nil;
+        for (int i = 0; i < 4; ++i)
+            if (poolSlots[i] != nil && poolSlots[i]->handle == handle) return poolSlots[i];
+        return nil;
+    }
+    int32 GetSize(void) { return 4; }
+    CVehicle *GetSlot(int32 i) { return i >= 0 && i < 4 ? poolSlots[i] : nil; }
+};
+CVehiclePool vehiclePool;
+struct CPools { static CVehiclePool *GetVehiclePool(void) { return &vehiclePool; } };
+bool noGotoRoute = false;
+struct CCarCtrl {
+    static int32 NumRandomCars, NumParkedCars, NumMissionCars;
+    static void JoinCarWithRoadSystem(CVehicle *veh) { events.push_back("join:" + to_string(veh->handle)); }
+    static bool JoinCarWithRoadSystemGotoCoors(CVehicle *veh, CVector dest, bool) {
+        events.push_back("goto:" + to_string(veh->handle) + ":" + to_string((int) dest.x) + "," + to_string((int) dest.y));
+        return noGotoRoute;
+    }
+    static void SwitchVehicleToRealPhysics(CVehicle *veh) {
+        events.push_back("onrails-off:" + to_string(veh->handle));
+        veh->AutoPilot.m_nCarMission = MISSION_CRUISE;
+        veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+    }
+    static void UpdateCarCount(CVehicle *veh, bool remove) {
+        int32 *slot = nil;
+        switch (veh->VehicleCreatedBy) {
+        case RANDOM_VEHICLE: slot = &NumRandomCars; break;
+        case MISSION_VEHICLE: slot = &NumMissionCars; break;
+        case PARKED_VEHICLE: slot = &NumParkedCars; break;
+        }
+        if (slot) *slot += remove ? -1 : 1;
+    }
+};
+int32 CCarCtrl::NumRandomCars = 0;
+int32 CCarCtrl::NumParkedCars = 0;
+int32 CCarCtrl::NumMissionCars = 0;
+/* the destination list, stubbed with the same cruise-first contract the panel has.
+   RIDE TO's auto entry is -1: these tests place a marker through autoMarkerPlaced
+   instead of reading CRadar, and entry 4 stands in for the marker. */
+#define VCMOD_RIDE_ZONE_AUTO	(-1)
+bool autoMarkerPlaced = false;
+CVector autoMarkerPos;
+static int32 VCModRideZoneEntry(int32 stored) {
+    if (stored != VCMOD_RIDE_ZONE_AUTO) return stored;
+    return autoMarkerPlaced ? 4 : 0;
+}
+static bool VCModRideZoneMoved(const CVector &applied) {
+    return autoMarkerPlaced && (autoMarkerPos - applied).Magnitude2D() > 25.0f;
+}
+static bool VCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos) {
+    if (entry < 0 || entry > 4) return false;
+    if (entry == 0) {
+        if (outZoneIndex) *outZoneIndex = -1;
+        if (outName) *outName = "traffic (cruise)";
+        return true;
+    }
+    if (entry == 3) return false;                 /* a zone the list cannot resolve */
+    if (entry == 4) {                             /* the pause-map marker */
+        if (!autoMarkerPlaced) return false;
+        if (outZoneIndex) *outZoneIndex = 4;
+        if (outName) *outName = "map marker";
+        if (outPos) *outPos = autoMarkerPos;
+        return true;
+    }
+    if (outZoneIndex) *outZoneIndex = entry;
+    if (outName) *outName = "zone";
+    if (outPos) *outPos = CVector((float) (100 * entry), (float) (200 * entry), 0.0f);
+    return true;
+}
