+#!/usr/bin/env python3
+"""Personal-driver tests: the summon, the drive to the pick-up, dismissal and the
+skip-the-ride travel, all out of vcmodride.cpp and run against the passenger
+suite's engine stubs."""
+import unittest
+
+from vcmod_test_support import run_cpp
+from test_vc_passenger import ride_source
+
+SUMMON_FUNCTIONS = ("notice", "phase", "vehicle", "release", "handback", "standdown", "seatfree",
+                    "nearest", "seats", "passkey",
+                    "style", "drive", "skip", "spawn", "call", "pickup", "entry", "update",
+                    "skipride")
+
+
+class DriverTests(unittest.TestCase):
+    def test_summon(self):
+        run_cpp(ride_source(*SUMMON_FUNCTIONS) + r'''
+int main() {
+    CVehicle veh;
+
+    reset(veh);
+    limoModelLoaded = false;
+    VCModCallDriver();
+    check(saw("request:139"), "the limo model is asked for");
+    check(lastLimo == nil, "a model that never loads spawns nothing");
+    check(saw("notice:driver: the limo cannot be loaded"), "and it says why");
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "no ride is armed");
+
+    reset(veh);
+    noRoadNodes = true;
+    VCModCallDriver();
+    check(lastLimo == nil, "no road to come from means no car");
+    check(saw("notice:driver: no road to come from"), "and it says why");
+
+    reset(veh);
+    spawnDriverFails = true;
+    VCModCallDriver();
+    check(lastLimo != nil, "the car still exists");
+    check(lastLimo->status == STATUS_ABANDONED, "an unmanned limo is left abandoned");
+    check(saw("world:add"), "and is put in the world");
+    check(!saw("blip:5"), "with no blip to follow");
+    check(lastLimo->VehicleCreatedBy == RANDOM_VEHICLE && CCarCtrl::NumMissionCars == 0,
+          "and stays ordinary traffic");
+    check(saw("notice:driver: nobody to drive this"), "and it says why");
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "no ride is armed");
+
+    /* the working call */
+    reset(veh);
+    lastLimo = nil;
+    requestedNode = 1;
+    VCModCallDriver();
+    check(lastLimo != nil, "a limo is created");
+    check(lastLimo->GetModelIndex() == MI_STRETCH, "and it is the Stretch");
+    check(saw("node:0,-80:60"), "the road is looked for behind Tommy");
+    check(lastLimo->GetPosition().x == -80.0f, "the limo starts on that road node");
+    check(lastLimo->GetPosition().z == 1.0f, "sitting on the ground plus its own height");
+    check(lastLimo->GetForward().x == 1.0f, "facing the pick-up");
+    check(saw("onroad"), "it is placed on the road properly");
+    check(lastLimo->status == STATUS_PHYSICS, "with real physics");
+    check(saw("driver"), "a chauffeur is put at the wheel");
+    check(lastLimo->VehicleCreatedBy == MISSION_VEHICLE, "the car is mission-owned");
+    check(CCarCtrl::NumMissionCars == 1 && CCarCtrl::NumRandomCars == 0,
+          "and the traffic counts follow");
+    check(saw("clearspace"), "the spot is cleared for it");
+    check(saw("blip:5"), "it gets a radar blip");
+    check(lastLimo->AutoPilot.m_nCarMission == MISSION_GOTOCOORDS, "it is sent to Tommy");
+    check(saw("goto:5:0,0"), "at the pick-up point");
+    check(lastLimo->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_STOP_FOR_CARS,
+          "driving to the safe style by default");
+    check(lastLimo->AutoPilot.m_nCruiseSpeed == 25, "at the safe approach speed");
+    check(nVCModRidePhase == VCMOD_RIDE_APPROACH, "the ride is in the approach phase");
+    check(nVCModRideHandle == 5 && bVCModRideSummoned, "tracked as our own summoned car");
+    check(saw("notice:your driver is on the way"), "and Tommy is told");
+
+    /* refusals that must not disturb anything else */
+    reset(veh);
+    playerPed.controlsOn = false;
+    VCModCallDriver();
+    check(saw("notice:driver: not right now"), "no driver while out of control");
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "and nothing is armed");
+
+    reset(veh);
+    lastLimo = nil;
+    playerPed.bInVehicle = true; playerPed.m_pMyVehicle = &veh;
+    VCModCallDriver();
+    check(saw("notice:driver: get out first"), "no car while already riding");
+    check(lastLimo == nil, "and none is spawned");
+    std::printf("PASS: %d summon checks\n", checks);
+}
+''')
+
+    def test_pickup(self):
+        run_cpp(ride_source(*SUMMON_FUNCTIONS) + r'''
+CVehicle veh;
+CAutomobile *limo = nil;
+void callDriver(void) {
+    reset(veh);
+    lastLimo = nil;
+    VCModCallDriver();
+    limo = lastLimo;
+}
+int main() {
+    /* he arrives */
+    callDriver();
+    check(nVCModRidePhase == VCMOD_RIDE_APPROACH, "on his way");
+    limo->pos = CVector(10.0f, 0.0f, 0.0f);
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(limo->AutoPilot.m_nCarMission == MISSION_STOP_FOREVER, "he stops at the kerb");
+    check(limo->AutoPilot.m_nCruiseSpeed == 0, "with the wheels stopped");
+    check(nVCModRidePhase == VCMOD_RIDE_PICKUP, "and waits");
+    check(saw("notice:your driver is here"), "which is announced");
+
+    /* far away is not close enough */
+    callDriver();
+    limo->pos = CVector(16.0f, 0.0f, 0.0f);
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_APPROACH, "just outside the kerb is still driving up");
+
+    /* the pick-up point follows Tommy, but not every frame */
+    callDriver();
+    playerPed.pos = CVector(50.0f, 0.0f, 0.0f);
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(saw("goto:5:50,0"), "a moved Tommy is re-targeted");
+    check(vecVCModRidePickup.x == 50.0f, "and the pick-up point follows him");
+    events.clear();
+    playerPed.pos = CVector(90.0f, 0.0f, 0.0f);
+    VCModUpdateRide(&playerPed);
+    check(!saw("goto:5:90,0"), "a second move inside the window waits");
+    nowMs += 3000;
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(saw("goto:5:90,0"), "and is followed once the window opens");
+
+    /* a small shuffle is not worth a new route */
+    callDriver();
+    playerPed.pos = CVector(10.0f, 0.0f, 0.0f);
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(!saw("goto:5:10,0"), "a few metres of walking is within the same kerb");
+
+    /* walking off abandons the pick-up */
+    callDriver();
+    limo->pos = CVector(5.0f, 0.0f, 0.0f);
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_PICKUP, "waiting at the kerb");
+    playerPed.pos = CVector(400.0f, 0.0f, 0.0f);
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "walking far away calls it off");
