+++ b/utils/test_vc_combat.py
@@ -0,0 +1,244 @@
+#!/usr/bin/env python3
+"""vcmodcombat owns the aim/recovery state, the two-hand colt's hold, the spin
+kick command, the forced fight move, the never-wanted clamp and the NPC combat
+profile. This harness extracts those from the module and checks the engine keeps
+only the hook calls, so the combat slice has one home."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+COMBAT = ROOT / "src/extras/vcmodcombat.cpp"
+COMBAT_H = ROOT / "src/extras/vcmodcombat.h"
+PLAYERPED = ROOT / "src/peds/PlayerPed.cpp"
+PEDFIGHT = ROOT / "src/peds/PedFight.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+PANEL_H = ROOT / "src/extras/vcmodpanel.h"
+
+PRELUDE = r'''
+#include <stdio.h>
+typedef int int32;
+typedef unsigned int uint32;
+typedef unsigned char uint8;
+#define nil 0
+
+enum PedFightMoves { FIGHTMOVE_NULL = 0, FIGHTMOVE_ROUNDHOUSE = 9 };
+enum { PED_IDLE, PED_FIGHT };
+enum { WEAPONTYPE_UNARMED, WEAPONTYPE_COLT45 };
+
+struct CTimer {
+    static uint32 time;
+    static uint32 GetTimeInMilliseconds() { return time; }
+};
+uint32 CTimer::time = 100000;
+
+bool bVCModNeverWanted = false;
+bool dying = false, inVehicle = false, sitting = false, streetChat = false;
+int notices = 0, fades = 0, aborts = 0, attacks = 0, lastMove = -1;
+uint8 lastPressure = 0;
+
+void VCModHudNotice(const char *) { ++notices; }
+void VCModStreetFadePose(void *) { ++fades; }
+bool VCModStreetChatActive(void) { return streetChat; }
+void VCModStreetAbortChat(void *, const char *) { ++aborts; }
+
+struct CWeapon { int m_eWeaponType; };
+struct CWanted {
+    int level;
+    int m_nChaos;
+    int GetWantedLevel() const { return level; }
+    void SetWantedLevel(int l) { level = l; if (l == 0) m_nChaos = 0; }
+};
+struct CPed {
+    float m_fMoveSpeed;
+    int m_nPedState;
+    CWeapon weapon;
+    CWeapon *GetWeapon() { return &weapon; }
+};
+struct CPlayerPed : CPed {
+    bool bInVehicle;
+    CWanted *m_pWanted;
+    bool DyingOrDead() { return dying; }
+    void StartFightAttack(uint8 pressure, PedFightMoves move) {
+        ++attacks;
+        lastPressure = pressure;
+        lastMove = move;
+    }
+};
+bool VCModSitting(void) { return sitting; }
+
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    // the forced move is a one-shot request for the next attack slot
+    CHECK(VCModCombatTakeFightMove() == FIGHTMOVE_NULL, "an empty slot takes nothing");
+    VCModCombatRequestFightMove(FIGHTMOVE_ROUNDHOUSE);
+    CHECK(VCModCombatTakeFightMove() == FIGHTMOVE_ROUNDHOUSE, "the request comes back");
+    CHECK(VCModCombatTakeFightMove() == FIGHTMOVE_NULL, "taking it empties the slot");
+    VCModCombatRequestFightMove(FIGHTMOVE_ROUNDHOUSE);
+    VCModCombatClearFightMove();
+    CHECK(VCModCombatTakeFightMove() == FIGHTMOVE_NULL, "clearing drops the request");
+
+    // NEVER WANTED clamps every fresh star and queued crime
+    CPlayerPed tommy;
+    CWanted wanted = { 0, 0 };
+    tommy.m_pWanted = &wanted;
+    bVCModNeverWanted = false;
+    wanted.level = 3;
+    wanted.m_nChaos = 40;
+    VCModNeverWantedClamp(&tommy);
+    CHECK(wanted.level == 3 && wanted.m_nChaos == 40, "the row off leaves the level alone");
+    bVCModNeverWanted = true;
+    VCModNeverWantedClamp(&tommy);
+    CHECK(wanted.level == 0 && wanted.m_nChaos == 0, "the row on clears the level and the queue");
+    wanted.level = 0;
+    wanted.m_nChaos = 1;
+    VCModNeverWantedClamp(&tommy);
+    CHECK(wanted.m_nChaos == 0, "a queued crime with no stars is cleared too");
+    wanted.level = 2;
+    wanted.m_nChaos = 0;
+    VCModNeverWantedClamp(&tommy);
+    CHECK(wanted.level == 0, "a suspended level is cleared");
+    bVCModNeverWanted = false;
+
+    // the spin kick is the ped roundhouse through the fight path
+    tommy.m_fMoveSpeed = 0.0f;
+    tommy.m_nPedState = PED_IDLE;
+    tommy.bInVehicle = false;
+    tommy.weapon.m_eWeaponType = WEAPONTYPE_UNARMED;
+    dying = inVehicle = sitting = streetChat = false;
+    VCModSpinKick(&tommy);
+    CHECK(attacks == 1 && lastMove == FIGHTMOVE_ROUNDHOUSE && lastPressure == 255,
+          "fists at a near-stop throw the roundhouse");
+    CHECK(fades == 1, "the street pose stands down for the kick");
+
+    attacks = fades = 0;
+    streetChat = true;
+    VCModSpinKick(&tommy);
+    CHECK(aborts == 1, "a street chat is aborted for the kick");
+    streetChat = false;
+
+    attacks = 0;
+    tommy.weapon.m_eWeaponType = WEAPONTYPE_COLT45;
+    VCModSpinKick(&tommy);
+    CHECK(attacks == 0 && notices == 1, "a gun refuses the kick and says why");
+    notices = 0;
+    tommy.weapon.m_eWeaponType = WEAPONTYPE_UNARMED;
+
+    tommy.m_fMoveSpeed = 1.5f;
+    VCModSpinKick(&tommy);
+    CHECK(attacks == 0, "a run is not a fight stance, so no kick");
+    tommy.m_nPedState = PED_FIGHT;
+    VCModSpinKick(&tommy);
+    CHECK(attacks == 1, "mid-fight the kick still starts");
+    attacks = 0;
+
+    dying = true;
+    VCModSpinKick(&tommy);
+    dying = false;
+    tommy.bInVehicle = true;
+    VCModSpinKick(&tommy);
+    tommy.bInVehicle = false;
+    sitting = true;
+    VCModSpinKick(&tommy);
+    sitting = false;
+    CHECK(attacks == 0, "dead, driving and seated refuse the kick");
+    return failed != 0;
+}
+'''
+
+
+def cut(text, name, kinds="void|bool|int32"):
+    match = re.search(r"(?m)^(?:static\s+)?(?:" + kinds + r")\s*\n" + re.escape(name) + r"\(", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {COMBAT}")
+    opening = text.index("{", match.end())
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[match.start():i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+class CombatModuleTests(unittest.TestCase):
+    def test_module_behaviour(self):
+        text = COMBAT.read_text()
+        state = re.search(r"^static int32 nVCModForcedFightMove[^\n]*;", text, re.M).group(0)
+        source = PRELUDE + state + "\n" + "\n".join(cut(text, name) for name in (
+            "VCModCombatRequestFightMove", "VCModCombatTakeFightMove",
+            "VCModCombatClearFightMove", "VCModNeverWantedClamp", "VCModSpinKick")) + MAIN
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "combat"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source, text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_engine_keeps_hooks_only(self):
+        player = PLAYERPED.read_text()
+        control = player[player.index("CPlayerPed::ProcessControl"):]
+        self.assertIn("VCModNeverWantedClamp(this);", control)
+        self.assertIn("VCModSpinKick(this);", control)
+        self.assertIn("VCModNpcCombatControl(this, npcCombatOwnsControl)", control)
+        self.assertIn("npcCombatOwnsControl = VCModNpcCombatOwnsControl(this);", control)
+        # the clamp sits right after the wanted update, before the rest of the frame
+        self.assertLess(control.index("m_pWanted->Update();"),
+                        control.index("VCModNeverWantedClamp(this);"))
+        for gone in ("bVCModNeverWanted &&", "static void\nVCModSpinKick",
+                     "npcCombatProfile &&", "bool ownsCombat = true;"):
+            self.assertNotIn(gone, control)
+
+        fight = PEDFIGHT.read_text()
+        self.assertIn("VCModCombatRequestFightMove(forceMove);", fight)
+        self.assertIn("VCModCombatClearFightMove();", fight)
+        self.assertIn("VCModCombatTakeFightMove()", fight)
+        self.assertIn("VCModCombatAimTick(this, weaponInfo, weaponAssoc)", fight)
+        self.assertIn("VCModCombatArmRecovery(this, ourWeapon, weaponAnimAssoc, animLoopEnd)", fight)
+        self.assertIn("VCModCombatNewBurst(this, ourWeapon, weaponAnimAssoc, attackShouldContinue, animLoopStart, animLoopEnd)", fight)
+        self.assertIn("VCModCombatClearTails(this);", fight)
+        # no feature state survives in the engine file
+        for gone in ("VCModForcedFightMove", "bVCModCopRecovering", "bVCModWeaponRecovering",
+                     "bVCModAimRaising", "VCModWeaponRecoveryWanted"):
+            self.assertNotIn(gone, fight)
+
+    def test_flags_have_one_home(self):
+        panel = PANEL
+        header = PANEL_H.read_text()
+        combat = COMBAT.read_text()
+        for flag in ("bVCModAimAllWeapons", "bVCModPlayerDoomAim", "bVCModNoScopedAim",
+                     "bVCModNeverWanted", "bVCModCopPistol", "bVCModWeaponRecovery",
+                     "bVCModAimWalk", "nVCModCopHoldFrame"):
+            self.assertIn(f"extern ", COMBAT_H.read_text())
+            self.assertIn(flag, COMBAT_H.read_text())
+            self.assertIn(flag, panel)          # the row still points at it
+            self.assertNotIn(f"bool {flag} =", panel)
+            self.assertNotIn(f"bool {flag};", panel)
+            self.assertNotIn(f"int32 {flag};", panel)
+            self.assertNotIn(flag, header)
+
+    def test_engine_includes_the_module_header(self):
+        for path in (PLAYERPED, PEDFIGHT,
+                     ROOT / "src/peds/Ped.cpp", ROOT / "src/peds/PedIK.cpp",
+                     ROOT / "src/weapons/Weapon.cpp", ROOT / "src/core/Wanted.cpp",
+                     ROOT / "src/extras/vcmodchase.cpp"):
+            text = path.read_text()
+            if "VCMod" in text:
+                self.assertIn('#include "vcmodcombat.h"', text, str(path))
+
+
+if __name__ == "__main__":
+    unittest.main()
