+static int32
+VCModChaseSquadAlive(void)
+{
+	int32 alive = 0;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped != nil && !ped->DyingOrDead())
+			alive++;
