@@ -0,0 +1,281 @@
+#!/usr/bin/env python3
+"""Behavior checks for the cop foot-patrol scan extracted from CCopPed onto CPed
+(NPC mode full 1:1). Pins the chase early-exit (bool true) and the hassle path
+(bool false, timer written) on representative near-ped inputs.
+"""
+import unittest
+from pathlib import Path
+
+from test_vc_passenger import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+PED = (ROOT / "src/peds/Ped.cpp").read_text()
+
+STUBS = r'''
+#include <cstdio>
+#include <cstdint>
+#include <cmath>
+#define nil NULL
+#define sq(x) ((x)*(x))
+#define VCMOD_DIAG(...) do { } while (0)
+typedef int8_t int8;
+typedef int32_t int32;
+typedef uint32_t uint32;
+typedef int16_t int16;
+enum { OBJECTIVE_NONE, OBJECTIVE_KILL_CHAR_ON_FOOT, OBJECTIVE_HASSLE_CHAR,
+       OBJECTIVE_FLEE_CHAR_ON_FOOT_TILL_SAFE, OBJECTIVE_WAIT_ON_FOOT_FOR_COP };
+enum { PEDTYPE_COP, PEDTYPE_CRIMINAL, PEDTYPE_GANG7, PEDTYPE_CIVMALE };
+enum { PED_WANDER_PATH, PED_FLEE_ENTITY };
+enum { RANDOM_CHAR, MISSION_CHAR };
+enum { SOUND_PED_COP_ASK_FOR_ID };
+enum { MI_PLAYER, MI_COP, MI_SWAT, MI_FBI, MI_ARMY, MI_MALE01 };
+enum { SURFACE_TARMAC };
+uint32 g_now = 1000000;
+struct CTimer { static uint32 GetTimeInMilliseconds(void) { return g_now; } };
