+    static void FindObjectsKindaColliding(const CVector &pos, float radius, bool, int16 *n, int16 max,
+                                          CEntity **out, bool buildings, bool vehicles, bool peds,
+                                          bool, bool) {
+        *n = 0;
+        for (size_t i = 0; i < gNearby.size() && *n < max; ++i) {
+            CEntity *e = gNearby[i];
+            int32 t = e->GetType();
+            if (t == ENTITY_TYPE_VEHICLE && !vehicles) continue;
+            if (t == ENTITY_TYPE_PED && !peds) continue;
+            if (t == ENTITY_TYPE_BUILDING && !buildings) continue;
+            float dx = e->pos.x - pos.x, dy = e->pos.y - pos.y;
+            if (dx * dx + dy * dy > radius * radius) continue;
+            out[(*n)++] = e;
+        }
