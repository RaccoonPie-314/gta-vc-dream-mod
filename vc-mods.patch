+// light reaches 60 m, the lock takes 1500 ms and the cadence is 200 ms a round
+#define VCMOD_CHASE_AIR_LOCK_RANGE		60.0f
+#define VCMOD_CHASE_AIR_LOCK_TIME		1500
+#define VCMOD_CHASE_AIR_SHOOT_EVERY		200
+#define VCMOD_CHASE_AIR_SHOOT_MAX		12000	// the run has to end even if rounds miss
+#define VCMOD_CHASE_AIR_SHOT_DAMAGE		20
+#define VCMOD_CHASE_AIR_CRASH_HEALTH	350.0f	// 1000 hp car; stop short of fire
+// the descent always starts from a fixed station over the wreck, never from
+// wherever the chase left the hull
+#define VCMOD_CHASE_DROP_STATION_H		6.0f
+#define VCMOD_CHASE_DROP_STATION_V		2.0f
+#define VCMOD_CHASE_AIR_SETTLE			1500
+#define VCMOD_CHASE_AIR_ESCAPE			600.0f
+#define VCMOD_CHASE_AIR_LAND_NEAR		2.0f	// stock releases two metres over the ground
+// the heli carries a smaller boarding party than the ground chase; the seat
+// count is raised after construction because retail heli door data is thin
+#define VCMOD_CHASE_AIR_SEATS			4
