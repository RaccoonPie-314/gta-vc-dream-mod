+static void
+VCModChaseRemovePed(CPed *&ped)
+{
+	if (ped == nil)
+		return;
+	fprintf(stderr, "VCMOD CHASE cleanup ped %p\n", (void*)ped);
+	CWorld::Remove(ped);
+	CWorld::RemoveReferencesToDeletedObject(ped);
+	delete ped;
+	ped = nil;
+}
+
+// The squad is on the player's side, but the game still treats the player as a
+// car thief for taking a law-enforcement vehicle, and a cop then walks him in.
+// Only the cops are told to ignore him: ignored-by-everyone also makes every
+// ped with a kill objective on the player stand idle (PedAI.cpp:6446), which
+// is exactly what the cornered crew has to do.
+static void
+VCModChaseMuteWanted(bool mute)
+{
+	CPlayerPed *player = FindPlayerPed();
+	CWanted *wanted = player != nil ? player->m_pWanted : nil;
+	if (mute) {
+		if (wanted != nil && !bVCModChaseWantedMuted) {
+			bVCModChasePreIgnoredByCops = wanted->m_bIgnoredByCops;
+			wanted->m_bIgnoredByCops = true;
+			bVCModChaseWantedMuted = true;
+		}
+	} else if (bVCModChaseWantedMuted) {
+		if (wanted != nil)
+			wanted->m_bIgnoredByCops = bVCModChasePreIgnoredByCops;
+		bVCModChaseWantedMuted = false;
+	}
+}
+
+static void
+VCModChaseRemoveVehicle(CVehicle *&veh)
+{
+	if (veh == nil)
+		return;
+	fprintf(stderr, "VCMOD CHASE cleanup car %p\n", (void*)veh);
+	CPlayerPed *player = FindPlayerPed();
+	if (player != nil && player->m_pMyVehicle == veh) {
+		// never free a car the player is sitting in; let traffic own it instead
+		veh->VehicleCreatedBy = RANDOM_VEHICLE;
+		CCarCtrl::NumMissionCars--;
+		CCarCtrl::NumRandomCars++;
+		veh = nil;
+		return;
+	}
+	CWorld::Remove(veh);
+	CWorld::RemoveReferencesToDeletedObject(veh);
+	delete veh;
+	veh = nil;
+}
