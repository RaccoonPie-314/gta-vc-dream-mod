+}
+struct CAnimBlendAssociation;
+struct CPed;
+struct CWeaponInfo { static CWeaponInfo *GetWeaponInfo(int) { return nil; } };
+bool gShot;
+bool VCModCopTwoHandFiring(CPed *ped, CWeaponInfo *info);
+struct CWeapon { int m_eWeaponType; };
