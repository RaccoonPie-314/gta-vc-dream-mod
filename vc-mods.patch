+        assert((frames[1].flag & AnimBlendFrameData::IGNORE_TRANSLATION) == 0);
+        assoc.flags &= ~1;
+        VCModCopSetStance(&player, &assoc, false);
+        for (int i = 1; i < 11; ++i) assert(nodes[i].sequence == nil);
+        for (int i = 0; i < 11; ++i)
+            assert((frames[i].flag & AnimBlendFrameData::IGNORE_TRANSLATION) == 0);
+        assoc.flags |= 1;
+    }
+    // a hold request that lands mid-burst must not strip the stance: a held
+    // trigger re-acquires the lock through SetPointGunAt during PED_ATTACK
+    gShot = true;
+    VCModCopSetStance(&player, &assoc, false);
+    for (int i = 0; i < 11; ++i) assert(nodes[i].sequence == &sequences[i]);
+    assert(assoc.seeks == 4);
+    gShot = false;
+    assoc.flags &= ~1;
+    VCModCopSetStance(&player, &assoc, false);
+    for (int i = 1; i < 11; ++i) assert(nodes[i].sequence == nil);
+    assoc.flags |= 1;
+    gShot = true;
+    assoc.animId = ANIM_WEAPON_FIRE;
+    VCModCopSetStance(&player, &assoc, true);
+    assert(nodes[3].sequence == nil);
+    assoc.animId = ANIM_WEAPON_FIRE_3RD;
+    frames[5].name = nil;
+    VCModCopSetStance(&player, &assoc, true);
+    assert(nodes[5].sequence == nil && nodes[4].sequence == &sequences[4]);
+    VCModCopSetStance(&player, nil, true);
+    return 0;
+}
+'''
+        with tempfile.TemporaryDirectory() as tmp:
