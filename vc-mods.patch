+#ifndef __VCMODTRAFFIC_H__
+#define __VCMODTRAFFIC_H__
+
+#include "common.h"
+
+class CVehicle;
+
+// One switch for the traffic behaviour taken from Real Traffic Fix: big vehicles
+// hold the outer lane, and jam honking is thinned out.
+extern bool bVCModTrafficAI;
+
+// The lane a car joins when it starts a route. Large vehicles take the outermost
+// one; everything else scatters the way it always has.
+int32 VCModTrafficLane(CVehicle *vehicle, uint8 lanes);
+
+// A stuck car honks at its neighbours; background traffic does it often enough
+// to grate, so the jam honk is held to every other two-second window.
+bool VCModTrafficHornAllowed(void);
+
+// Port of Real Traffic Fix's per-vehicle traffic logic: cruise moderation,
+// obstacle probing, the real-physics latch and the ground-stuck repair.
+void VCModTrafficUpdate(CVehicle *vehicle);
+
+#endif
