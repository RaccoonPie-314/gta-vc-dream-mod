+#include "vcmodpanel.h"
+
+bool bVCModPlayerNpcAnims;
+int32 nVCModAnimChoice;
+bool bVCModMouseAimLockOn;
+bool bVCModAimAllWeapons;
+bool bVCModPlayerDoomAim;
+bool bVCModNoScopedAim;
+bool bVCModWalkMode;
+bool bVCModLockOnVehicles;
+bool bVCModNeverWanted;
+bool bVCModLockOnLatch;
+
+// only groups built from aStdAnimDescs are offered: they are the ones carrying all
+// five locomotion slots, so the swap can't leave a slot unresolved
+static const char *aVCModAnimGroupNames[] = {
+	"man (police, most male civs)", "gang1", "gang2", "shuffle", "oldman", "fatman",
+	"oldfatman", "jogger", "woman", "shopping", "busywoman", "sexywoman",
+	"fatwoman", "oldwoman", "jogwoman", "panicchunky"
+};
+static const int32 aVCModAnimGroups[] = {
+	ASSOCGRP_STD, ASSOCGRP_GANG1, ASSOCGRP_GANG2, ASSOCGRP_SHUFFLE, ASSOCGRP_OLD,
+	ASSOCGRP_FAT, ASSOCGRP_OLDFAT, ASSOCGRP_JOGGER, ASSOCGRP_WOMAN, ASSOCGRP_WOMANSHOP,
+	ASSOCGRP_BUSYWOMAN, ASSOCGRP_SEXYWOMAN, ASSOCGRP_FATWOMAN, ASSOCGRP_OLDWOMAN,
+	ASSOCGRP_JOGWOMAN, ASSOCGRP_PANICCHUNKY
+};
+
+// SetRealMoveAnim reaches m_animGroup every frame from ProcessControl, using ids
+// beyond the five move slots, so every association a group can hand out has to be
+// usable before the group becomes current
+static bool
+VCModGroupPlayable(AssocGroupId groupId)
+{
+	CAnimBlendAssocGroup *grp = &CAnimManager::GetAnimAssocGroups()[groupId];
+	for (int32 i = 0; i < grp->numAssociations; i++) {
+		CAnimBlendHierarchy *h = grp->assocList[i].hierarchy;
+		if (h == nil || h->sequences == nil || h->numSequences <= 0) {
+			fprintf(stderr, "VCMOD refusing group %d, assoc %d (%s)\n",
+				groupId, i, h ? h->name : "nil hierarchy");
+			return false;
+		}
+	}
+	return true;
+}
+
+bool
+VCModPickAnimGroup(AssocGroupId *out)
+{
+	if (!bVCModPlayerNpcAnims)
+		return false;
+
+	AssocGroupId want = (AssocGroupId) aVCModAnimGroups[nVCModAnimChoice];
+	static AssocGroupId loggedWant = NUM_ANIM_ASSOC_GROUPS;
+	if (want != loggedWant) {
+		fprintf(stderr, "VCMOD selecting %s (list %d -> group %d)\n",
+			aVCModAnimGroupNames[nVCModAnimChoice], nVCModAnimChoice, want);
+		loggedWant = want;
+	}
+	if (!VCModGroupPlayable(want))
+		return false;
+
+	*out = want;
+	return true;
+}
+
+#ifdef DEBUGMENU
+#include "rtcharse.h"
+#include "re3_inttypes.h"
+#include "ControllerConfig.h"
+#include "debugmenu.h"
+
+// one row per group: activating a row applies it immediately, which a cycling
+// value cannot. Row order must match aVCModAnimGroups / aVCModAnimGroupNames.
+#define VCMOD_ROW(idx, label) \
+	static void VCModPick##idx(void) { nVCModAnimChoice = idx; bVCModPlayerNpcAnims = true; } \
+	TWEAKFUNCN(VCModPick##idx, label);
+
+SETTWEAKPATH("VC Mods");
+TWEAKBOOL(bVCModPlayerNpcAnims);
+TWEAKINT32(nVCModAnimChoice, 0, ARRAY_SIZE(aVCModAnimGroups)-1, 1);
+VCMOD_ROW(0, "anim: man (police, most male civs)")
+VCMOD_ROW(1, "anim: gang1")
+VCMOD_ROW(2, "anim: gang2")
+VCMOD_ROW(3, "anim: shuffle")
+VCMOD_ROW(4, "anim: oldman")
+VCMOD_ROW(5, "anim: fatman")
+VCMOD_ROW(6, "anim: oldfatman")
+VCMOD_ROW(7, "anim: jogger")
+VCMOD_ROW(8, "anim: woman")
+VCMOD_ROW(9, "anim: shopping")
+VCMOD_ROW(10, "anim: busywoman")
+VCMOD_ROW(11, "anim: sexywoman")
+VCMOD_ROW(12, "anim: fatwoman")
+VCMOD_ROW(13, "anim: oldwoman")
+VCMOD_ROW(14, "anim: jogwoman")
+VCMOD_ROW(15, "anim: panicchunky")
+TWEAKBOOL(bVCModMouseAimLockOn);
+TWEAKBOOL(bVCModAimAllWeapons);
+TWEAKBOOL(bVCModPlayerDoomAim);
+TWEAKBOOL(bVCModNoScopedAim);
+TWEAKBOOL(bVCModWalkMode);
+TWEAKBOOL(bVCModLockOnVehicles);
+TWEAKBOOL(bVCModNeverWanted);
+TWEAKBOOL(bVCModLockOnLatch);
+
+// Colour comes from the charset, the same way the debug menu highlights a selected
+// row: an opaque background on every glyph is what makes a row read as a panel.
+enum eVCModFont
+{
+	VCFONT_TITLE,
+	VCFONT_LABEL,
+	VCFONT_ON,
+	VCFONT_OFF,
+	VCFONT_SET,
+	VCFONT_WARN,
+	VCFONT_HINT,
+	VCFONT_MARK,
+	NUM_VCFONTS
+};
+
+static RtCharset *aVCModFonts[NUM_VCFONTS];
+static int32 nVCModCharW, nVCModCharH;
+static bool bVCModPanelOpen;
+static bool bVCModAnimListOpen;
+static float fVCModCursorX, fVCModCursorY;
+
+#define VCMOD_PANEL_X		20
+#define VCMOD_PANEL_Y		60
+#define VCMOD_NAME_COLS		18
+#define VCMOD_VALUE_COLS	28
+
+struct VCModRowDef
+{
+	const char *name;
+	bool *state;	// nil means the row cycles the anim set instead
+};
+
+static const VCModRowDef aVCModRows[] = {
+	{ "NPC ANIMATION",   &bVCModPlayerNpcAnims  },
+	{ "ANIM SET",        nil                    },
+	{ "FREEAIM+LOCKON",  &bVCModMouseAimLockOn  },
+	{ "AIM ALL WEAPONS", &bVCModAimAllWeapons   },
+	{ "NPC DOOM AIM",    &bVCModPlayerDoomAim   },
+	{ "NO SCOPE CAMERA", &bVCModNoScopedAim     },
+	{ "WALK MODE",       &bVCModWalkMode        },
+	{ "LOCKON VEHICLES", &bVCModLockOnVehicles  },
+	{ "NEVER WANTED",    &bVCModNeverWanted     },
+	{ "LOCKON LATCH",    &bVCModLockOnLatch     },
+};
+
+static void
+VCModMakeFonts(void)
+{
+	static const RwRGBA aFg[NUM_VCFONTS] = {
+		{ 255,  96, 192, 255 },	// title
+		{ 232, 232, 240, 255 },	// label
+		{ 112, 240, 148, 255 },	// on
+		{ 132, 132, 144, 255 },	// off
+		{ 110, 216, 255, 255 },	// anim set name
+		{ 255, 200,  72, 255 },	// warning
+		{ 196, 156, 255, 255 },	// key hints
+		{ 255, 255, 255, 255 }		// marker
+	};
+	static const RwRGBA aBgPanel[NUM_VCFONTS] = {
+		{  32,   8,  40, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  36,  24,   4, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20,   0 }
+	};
+
+	OpenCharsetSafe();
+
+	for (int32 i = 0; i < NUM_VCFONTS; i++) {
+		aVCModFonts[i] = RtCharsetCreate(&aFg[i], &aBgPanel[i]);
+		if (aVCModFonts[i] == nil)
+			return;
+	}
+
+	RtCharsetDesc desc;
+	RtCharsetGetDesc(aVCModFonts[VCFONT_LABEL], &desc);
+	nVCModCharW = desc.width;
+	nVCModCharH = desc.height;
+}
+
+static void
+VCModPrint(int32 style, const char *s, int32 x, int32 y)
+{
+	RtCharsetPrintBuffered(aVCModFonts[style], s, x, y, false);
+}
+
+// every cell is padded to a fixed width, otherwise the row backgrounds end at
+// ragged distances and the panel reads as floating text
+static void
+VCModCell(int32 style, const char *s, int32 x, int32 y, int32 cols)
+{
+	char cell[64];
+	snprintf(cell, sizeof(cell), "%-*s", cols, s);
+	VCModPrint(style, cell, x, y);
+}
+
+static bool
+VCModCursorInRect(float px, float py, int32 x, int32 y, int32 w, int32 h)
+{
+	return px >= x && px < x + w && py >= y && py < y + h;
+}
+
+static void
+VCModUpdateMouse(CPad *pad, int32 screenW, int32 screenH)
+{
+	// the panel cursor has to follow the same invert settings the game's own mouse
+	// look uses, or it moves against the hand that is pointing it
+	int dirX = MousePointerStateHelper.bInvertHorizontally ? -1 : 1;
+	int dirY = MousePointerStateHelper.bInvertVertically ? -1 : 1;
+
+	fVCModCursorX += pad->NewMouseControllerState.x * dirX;
+	fVCModCursorY += pad->NewMouseControllerState.y * dirY;
+	if (fVCModCursorX < 0.0f) fVCModCursorX = 0.0f;
+	if (fVCModCursorY < 0.0f) fVCModCursorY = 0.0f;
+	if (fVCModCursorX >= screenW) fVCModCursorX = screenW - 1.0f;
+	if (fVCModCursorY >= screenH) fVCModCursorY = screenH - 1.0f;
+
+	// the camera must not turn while the panel is being pointed at
+	pad->NewMouseControllerState.x = 0.0f;
+	pad->NewMouseControllerState.y = 0.0f;
+}
+
+static int32
+VCModRowY(int32 row)
+{
+	return VCMOD_PANEL_Y + nVCModCharH * (row + 1);
+}
+
+#define VCMOD_ANIM_SET_ROW	1
+
+// the anim list opens beside the panel instead of pushing the rows down, so the
+// panel keeps one shape while choosing
+static int32
+VCModListX(void)
+{
+	return VCMOD_PANEL_X + (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW + 20;
+}
+
+static int32
+VCModListRowY(int32 entry)
+{
+	return VCModRowY(VCMOD_ANIM_SET_ROW) + nVCModCharH * entry;
+}
+
+static void
+VCModTriangle(RwCamera *cam, float x0, float y0, float x1, float y1, float x2, float y2,
+	uint8 r, uint8 g, uint8 b)
+{
+	RwIm2DVertex verts[3];
+	float recipz = 1.0f / RwCameraGetNearClipPlane(cam);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+
+	RwIm2DVertexSetScreenX(&verts[0], x0);
+	RwIm2DVertexSetScreenY(&verts[0], y0);
+	RwIm2DVertexSetScreenZ(&verts[0], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[0], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[0], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[0], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[1], x1);
+	RwIm2DVertexSetScreenY(&verts[1], y1);
+	RwIm2DVertexSetScreenZ(&verts[1], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[1], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[1], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[1], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[2], x2);
+	RwIm2DVertexSetScreenY(&verts[2], y2);
+	RwIm2DVertexSetScreenZ(&verts[2], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[2], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[2], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[2], r, g, b, 255);
+
+	RwIm2DRenderPrimitive(rwPRIMTYPETRILIST, verts, 3);
+}
+
+// a charset "+" was unreadably small, so the pointer is geometry: a filled arrow
+// with a dark edge that stays visible on both the panel and the sky
+static void
+VCModDrawCursor(RwCamera *cam)
+{
+	int32 x = (int32) fVCModCursorX;
+	int32 y = (int32) fVCModCursorY;
+
+	VCModTriangle(cam, x - 2.0f, y - 2.0f, x - 2.0f, y + 22.0f, x + 16.0f, y + 12.0f, 8, 8, 12);
+	VCModTriangle(cam, (float) x, (float) y, (float) x, y + 19.0f, x + 14.0f, y + 10.0f, 255, 255, 255);
+}
+
+static void
+VCModClick(CPad *pad)
+{
+	if (!(pad->NewMouseControllerState.LMB && !pad->OldMouseControllerState.LMB))
+		return;
+
+	if (bVCModAnimListOpen) {
+		for (uint32 k = 0; k < ARRAY_SIZE(aVCModAnimGroupNames); k++) {
+			if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCModListX(), VCModListRowY(k),
+					VCMOD_VALUE_COLS * nVCModCharW, nVCModCharH))
+				continue;
+
+			nVCModAnimChoice = k;
+			bVCModPlayerNpcAnims = true;
+			bVCModAnimListOpen = false;
+			return;
+		}
+	}
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCMOD_PANEL_X, VCModRowY(i), rowW, nVCModCharH))
+			continue;
+
+		if (aVCModRows[i].state)
+			*aVCModRows[i].state = !*aVCModRows[i].state;
+		else
+			bVCModAnimListOpen = !bVCModAnimListOpen;
+		return;
+	}
+
+	bVCModAnimListOpen = false;
+}
+
+void
+VCModPanelRender(void)
+{
+	CPad *pad = CPad::GetPad(0);
+	if (pad == nil)
+		return;
+
+	// the debug menu's page column occupies the same corner, so it wins while open
+	if (DebugMenuIsActive())
+		return;
+
+	if (ControlsManager.GetIsKeyboardKeyJustDown((RsKeyCodes)'\\'))
+		bVCModPanelOpen = !bVCModPanelOpen;
+	if (!bVCModPanelOpen) {
+		bVCModAnimListOpen = false;
+		return;
+	}
+
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+
+	RwCamera *cam = RwCameraGetCurrentCamera();
+	if (cam == nil)
+		return;
+	int32 screenW = RwRasterGetWidth(RwCameraGetRaster(cam));
+	int32 screenH = RwRasterGetHeight(RwCameraGetRaster(cam));
+
+	if (aVCModFonts[VCFONT_LABEL] == nil) {
+		VCModMakeFonts();
+		if (aVCModFonts[VCFONT_LABEL] == nil)
+			return;
+	}
+
+	VCModUpdateMouse(pad, screenW, screenH);
+	VCModClick(pad);
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	int32 fullCols = rowW / nVCModCharW;
+	VCModCell(VCFONT_TITLE, " VC MODS ", VCMOD_PANEL_X, VCMOD_PANEL_Y, fullCols);
+
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++) {
+		int32 y = VCModRowY(i);
+		int32 style = VCFONT_OFF;
+		const char *value = "[--]";
+
+		if (aVCModRows[i].state) {
+			if (*aVCModRows[i].state) {
+				style = VCFONT_ON;
+				value = "[ON]";
+			}
+		} else {
+			style = VCFONT_SET;
+			value = aVCModAnimGroupNames[nVCModAnimChoice];
+		}
+
+		VCModCell(VCFONT_LABEL, aVCModRows[i].name, VCMOD_PANEL_X, y, VCMOD_NAME_COLS);
+		VCModCell(style, value, VCMOD_PANEL_X + VCMOD_NAME_COLS*nVCModCharW, y, VCMOD_VALUE_COLS);
+
+		// the affordance that this row opens a list rather than flipping anything
+		if (aVCModRows[i].state == nil)
+			VCModPrint(VCFONT_MARK, bVCModAnimListOpen ? "-" : "+",
+				VCMOD_PANEL_X + rowW + nVCModCharW, y);
+	}
+
+	if (bVCModAnimListOpen) {
+		for (uint32 k = 0; k < ARRAY_SIZE(aVCModAnimGroupNames); k++) {
+			bool selected = (int32) k == nVCModAnimChoice;
+			VCModCell(selected ? VCFONT_ON : VCFONT_SET, aVCModAnimGroupNames[k],
+				VCModListX(), VCModListRowY(k), VCMOD_VALUE_COLS);
+			if (selected)
+				VCModPrint(VCFONT_ON, ">", VCModListX() - nVCModCharW, VCModListRowY(k));
+		}
+	}
+
+	int32 y = VCModRowY((int32) ARRAY_SIZE(aVCModRows));
+	if (bVCModNoScopedAim && !bVCModAimAllWeapons)
+		VCModCell(VCFONT_WARN, "! sniper needs AIM ALL WEAPONS", VCMOD_PANEL_X, y++, fullCols);
