+int32
+VCModChaseSquadForThreat(int32 tier, int32 crew, int32 seats, bool withPlayer)
+{
+	// the leader counts as crew; each rating step and each extra body pulls in
+	// another partner
+	int32 want = tier * 2 - 1 + (crew - 1);
+	if (want < 1)
+		want = 1;
+	// the player takes a seat in his own ride; a backup crew fills the whole
+	// car, driver included, because the player is already with the first team
+	int32 free = seats - (withPlayer ? 1 : 0);
+	if (free < 0)
+		free = 0;
+	if (want > free)
+		want = free;
+	return want;
+}
+
+// Design 6.7. The active count is what rides now; the reserve is finite and
+// refills a loss after a delay, so a long fight runs both sides down instead of
+// feeding them forever. Crew counts exclude the leader.
+void
+VCModChasePoolForTier(int32 tier, int32 *squadActive, int32 *squadReserve,
+                      int32 *crewActive, int32 *crewReserve)
+{
+	static const int32 squadActiveTab[5] = { 2, 2, 4, 5, 6 };
+	static const int32 squadReserveTab[5] = { 0, 2, 4, 5, 6 };
+	static const int32 crewActiveTab[5] = { 0, 1, 4, 5, 6 };
+	static const int32 crewReserveTab[5] = { 0, 2, 4, 5, 6 };
+	int32 row = tier - 1;
+	int32 sa = 0, sr = 0, ca = 0, cr = 0;
+	if (row >= 0 && row < 5) {
+		sa = squadActiveTab[row];
+		sr = squadReserveTab[row];
+		ca = crewActiveTab[row];
+		cr = crewReserveTab[row];
+	}
+	if (squadActive) *squadActive = sa;
+	if (squadReserve) *squadReserve = sr;
+	if (crewActive) *crewActive = ca;
+	if (crewReserve) *crewReserve = cr;
+}
+
