+
+    beginRide(veh, -1);
+    seated(veh);
+    playerPed.bInVehicle = false; playerPed.m_pMyVehicle = nil;
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(nVCModRideHandle == -1, "getting out ends the ride");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE,
+          "and the street car goes back to traffic");
+    check(veh.AutoPilot.m_nCruiseSpeed == 11 &&
+          veh.AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_STOP_FOR_CARS &&
+          veh.AutoPilot.m_fMaxTrafficSpeed == 11.0f,
+          "at the pace the car kept before we borrowed it, not the ride's");
+    check(saw("join:1"), "and rejoins the road system");
+
+    beginRide(veh, -1);
+    seated(veh);
+    veh.handle = 999;
+    VCModUpdateRide(&playerPed);
+    check(nVCModRideHandle == -1, "a recycled car handle is dropped");
+
+    reset(veh);
+    veh.kind = VEH_BOAT; veh.handle = 2;
+    check(!VCModPassengerEntry(&veh), "an empty boat is left to the game");
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "so no boat ride is armed");
