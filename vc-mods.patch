+def post_kill_source():
+    objective = PEDAI[PEDAI.index("void\nCPed::ProcessObjective(void)"):]
+    completion = braced(objective, "if (bObjectiveCompleted\n")
+    return doubleback_source() + "void CPed::ProcessObjective(void) {" + completion + "}"
