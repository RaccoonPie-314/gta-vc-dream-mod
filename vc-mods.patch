+    def test_stance_tracks_restore_at_current_shot_time(self):
+        helper = "void\n" + braced(COMBAT.read_text(), "VCModCopSetStance(CPed *ped,")
+        source = r'''
+#include <assert.h>
+#include <string.h>
+#define nil 0
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+enum AssocGroupId { ASSOCGRP_COLT };
+enum { NUM_ANIM_ASSOC_GROUPS = 60 };
+enum AnimationId { ANIM_WEAPON_FIRE, ANIM_WEAPON_FIRE_3RD };
+struct CAnimBlendSequence { int id; };
+struct CAnimBlendNode { CAnimBlendSequence *sequence; float sampledTime; };
+struct AnimBlendFrameData {
