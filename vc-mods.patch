+#!/usr/bin/env python3
+"""Rebindable hotkeys: the panel's KEYS page must own the eleven codes, every
+consumer must read them instead of a literal, and a bound key must not act on
+the frame it is captured. The drive camera's vertical axis is deliberately
+inverted; its yaw stays as it was."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+KEYS = ROOT / "src/extras/vcmodkeys.cpp"
+KEYS_H = ROOT / "src/extras/vcmodkeys.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+PLAYER = ROOT / "src/peds/PlayerPed.cpp"
+RELOAD = ROOT / "src/extras/vcmodreload.cpp"
+CHASE = ROOT / "src/extras/vcmodchase.cpp"
+INI = ROOT / "src/core/re3.cpp"
+DRIVECAM = ROOT / "src/extras/vcmoddrivecam.cpp"
+SKELETON = ROOT / "src/skel/skeleton.h"
+
+
+def braced(text, marker):
+    i = text.index(marker)
+    j = text.index("{", i)
+    depth = 0
+    for k in range(j, len(text)):
+        if text[k] == "{":
+            depth += 1
+        elif text[k] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[j + 1:k]
+    raise AssertionError("unbalanced braces after " + marker)
+
+
+def run_cpp(source):
+    with tempfile.TemporaryDirectory() as tmp:
+        path = pathlib.Path(tmp) / "t.cpp"
+        path.write_text(source)
+        exe = pathlib.Path(tmp) / "t"
+        subprocess.run(["c++", "-std=c++11", "-O0", str(path), "-o", str(exe)], check=True)
+        return subprocess.run([str(exe)], check=True, capture_output=True, text=True).stdout
+
+
+class KeysTest(unittest.TestCase):
+    def test_defaults_and_slots(self):
+        keys = KEYS.read_text()
+        self.assertIn("'\\\\', 'B', 'G', 'H', 'K', 'R', 'J', 'U', 'C', 'V', 'P'", keys)
+        for name in ("KeyPanel", "KeyWalk", "KeyFire", "KeyDriver",
+                     "KeyKick", "KeyReload", "KeySpot", "KeyCapture",
+                     "KeyFirstPerson", "KeyCrew", "KeyPassenger"):
+            self.assertIn('"%s"' % name, keys)
+        self.assertIn("VCKEY_PANEL", KEYS_H.read_text())
+        self.assertEqual(len(re.findall(r"VCKEY_[A-Z]+,", KEYS_H.read_text())), 11)
+
+    def test_ini_round_trip(self):
+        keys = KEYS.read_text()
+        self.assertIn('IniStoreKey("VC Mods", aVCModKeyIniNames[which], aVCModKeys[which]);', keys)
+        ini = INI.read_text()
+        for ini_key, slot in (
+                ("KeyPanel", "VCKEY_PANEL"), ("KeyWalk", "VCKEY_WALK"),
+                ("KeyFire", "VCKEY_FIRE"), ("KeyDriver", "VCKEY_DRIVER"),
+                ("KeyKick", "VCKEY_KICK"), ("KeyReload", "VCKEY_RELOAD"),
+                ("KeySpot", "VCKEY_SPOT"), ("KeyCapture", "VCKEY_CAPTURE"),
+                ("KeyFirstPerson", "VCKEY_FIRSTPERSON"),
+                ("KeyCrew", "VCKEY_CREW"), ("KeyPassenger", "VCKEY_PASSENGER")):
+            self.assertIn('ReadIniIfExists("VC Mods", "%s", &aVCModKeys[%s]);' % (ini_key, slot), ini)
+        self.assertIn("VCModKeySanitize();", ini)
+        self.assertIn("VCModKeySanitize(void)", keys)
+
+    def test_capture_assigns_and_esc_cancels(self):
+        poll = braced(KEYS.read_text(), "VCModKeyPoll(void)")
+        self.assertIn("CPad::EditCodesForControls(&code, 1);", poll)
+        self.assertIn("if (code == rsNULL)", poll)
+        self.assertIn("if (code == rsESC)", poll)
+        self.assertIn("aVCModKeys[which] = code;", poll)
+        self.assertIn("VCModKeySave(which);", poll)
+        # the assignment must come after the escape check, or Esc becomes a binding
+        self.assertLess(poll.index("if (code == rsESC)"), poll.index("aVCModKeys[which] = code;"))
+        self.assertIn("return nVCModCaptureWhich >= 0;", braced(KEYS.read_text(), "VCModKeyCapturing(void)"))
+
