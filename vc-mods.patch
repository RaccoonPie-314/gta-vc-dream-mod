+static bool bVCModLockOnHeld;
+
+// NO STRAFE: the movement keys pick the heading, the way a ped's own AI does.
+// Aiming or firing takes it back, because the torso has to point at the
+// crosshair; a locked target already owns the aim, so the keys keep it there —
+// until the trigger hands the body to the FIRING STANCE.
+bool
+VCModPlayerTurnsWithInput(void)
+{
+	if (!bVCModNoStrafe)
+		return false;
+	CPed *player = FindPlayerPed();
+	if (player == nil)
+		return false;
+	// the lock is the aim; the free camera's crosshair does not need the body
+	if (player->m_pPointGunAt)
+		return !VCModFiringStance();
+	CPad *pad = CPad::GetPad(0);
+	if (pad && (pad->GetTarget() || pad->GetWeapon()))
+		return false;
+	return player->m_nPedState != PED_ATTACK && player->m_nPedState != PED_AIM_GUN;
+}
+
+bool
+VCModWalkModeOn(void)
+{
+	return bVCModWalkMode;
+}
+
+void
+VCModPlayerToggleWalkMode(void)
+{
+	bVCModWalkMode = !bVCModWalkMode;
+}
+
+void
+VCModWalkModeCap(CPlayerPed *player)
+{
+	if (bVCModWalkMode && player->m_fMoveSpeed > 0.9f) {
+		player->m_fMoveSpeed = 0.9f;
+		player->m_nMoveState = PEDMOVE_WALK;
+	}
+}
+
+bool
+VCModMouseLockOn(void)
+{
+	return bVCModMouseAimLockOn;
+}
+
+// a locked target owns the shot even when the body faces elsewhere: NO STRAFE
+// can turn the ped while he walks, and the arm's pointed flag would otherwise
+// fall the shot back to the body's heading
+bool
+VCModLockShotHomes(CPed *shooter)
+{
+	return shooter->IsPlayer() && shooter->m_pPointGunAt != nil;
+}
+
+// FREEAIM+LOCKON keeps the free mouse camera over a lock: the stock lock camera
+// angle belongs to the classic control method and would take the view away
+bool
+VCModFreeAimCameraLock(void)
+{
+	return bVCModMouseAimLockOn && CCamera::m_bUseMouse3rdPerson;
+}
+
+// the free-aim crosshair is the mouse camera's reticle; a locked target already
+// carries the marker, so the two reticles must not stack
+bool
+VCModFreeAimCrosshairHidden(CPed *player)
+{
+	return bVCModMouseAimLockOn && player->m_pPointGunAt != nil;
+}
+
+// FIRING STANCE: while the trigger is held at a lock in the free camera, the
+// aim owns the body so the muzzle, the flash and the shot agree; the keys
+// strafe under it. The attack state carries the stance through a burst's pauses.
+bool
+VCModFiringStance(void)
+{
+	if (!VCModFreeAimCameraLock())
+		return false;
+	CPed *player = FindPlayerPed();
+	if (player == nil || player->m_pPointGunAt == nil)
+		return false;
+	CPad *pad = CPad::GetPad(0);
+	return (pad && pad->GetWeapon()) || player->m_nPedState == PED_ATTACK;
+}
+
+// the stance's body turn, at the ped's own stare rate: the same sweep the
+// two-hand pose uses, so the entry reads as a turn, not a snap
+bool
+VCModFiringStanceTurn(CPlayerPed *player)
+{
+	if (!VCModFiringStance() || player->m_pPointGunAt == nil)
+		return false;
+	CVector targetPos = player->m_pPointGunAt->GetPosition();
+	float angleToFace = CGeneral::GetRadianAngleBetweenPoints(
+		targetPos.x, targetPos.y, player->GetPosition().x, player->GetPosition().y);
+	float limitedLookDir = CGeneral::LimitRadianAngle(angleToFace);
+	float currentRot = player->m_fRotationCur;
+	if (currentRot - PI > limitedLookDir)
+		limitedLookDir += 2 * PI;
+	else if (PI + currentRot < limitedLookDir)
+		limitedLookDir -= 2 * PI;
+
+	float neededTurn = currentRot - limitedLookDir;
+	player->m_fRotationDest = limitedLookDir;
+	if (Abs(neededTurn) > 0.05f)
+		player->m_fRotationCur = currentRot - neededTurn * 0.2f;
+	return true;
+}
+
+void
+VCModLockOnLatchTick(CPlayerPed *player, CPad *pad)
+{
+	// re-arming the aim button each frame is what keeps the lock alive once the
+	// fingers are off it; it lets go on its own when the target is gone
+	if (!bVCModLockOnLatch || (bVCModLockOnHeld && player->m_pPointGunAt == nil))
+		bVCModLockOnHeld = false;
+	if (bVCModLockOnLatch && pad->GetRightMouseJustDown())
+		bVCModLockOnHeld = !bVCModLockOnHeld;
+	if (bVCModLockOnHeld)
+		pad->NewState.RightShoulder1 = true;
+}
+
+void
+VCModPlayerReleaseAim(void)
+{
+	bVCModLockOnHeld = false;
+}
+
+void
+VCModLockOnVehiclesNext(CPlayerPed *player, CEntity *previousTarget, CEntity **nextTarget,
+	float *lastCloseness, float weaponRange, float referenceBeta, bool lookToLeft)
+{
+	if (!bVCModLockOnVehicles)
+		return;
+	for (int v = CPools::GetVehiclePool()->GetSize() - 1; v >= 0; v--) {
+		CVehicle *veh = CPools::GetVehiclePool()->GetSlot(v);
+		if (veh == nil || veh->pDriver == nil || veh->pDriver == player ||
+			(CEntity *)veh == previousTarget || veh->GetStatus() == STATUS_WRECKED)
+			continue;
+		if (player->OurPedCanSeeThisOne(veh, true) && player->CanIKReachThisTarget(veh->GetPosition(), player->GetWeapon(), true))
+			player->EvaluateNeighbouringTarget(veh, nextTarget, lastCloseness, weaponRange, referenceBeta, lookToLeft, false);
+	}
+}
+
+void
+VCModLockOnVehiclesFirst(CPlayerPed *player, CEntity **nextTarget,
+	float *lastCloseness, float weaponRange, float referenceBeta)
+{
+	if (!bVCModLockOnVehicles)
+		return;
+	for (int v = CPools::GetVehiclePool()->GetSize() - 1; v >= 0; v--) {
+		CVehicle *veh = CPools::GetVehiclePool()->GetSlot(v);
+		// an empty or wrecked hull is scenery, not a target
+		if (veh == nil || veh->pDriver == nil || veh->pDriver == player || veh->GetStatus() == STATUS_WRECKED)
+			continue;
+		if (player->OurPedCanSeeThisOne(veh) && player->CanIKReachThisTarget(veh->GetPosition(), player->GetWeapon(), true))
+			player->EvaluateTarget(veh, nextTarget, lastCloseness, weaponRange, referenceBeta, false);
+	}
+}
diff --git a/src/extras/vcmodplayer.h b/src/extras/vcmodplayer.h
new file mode 100644
index 0000000..e750475
--- /dev/null
+++ b/src/extras/vcmodplayer.h
@@ -0,0 +1,67 @@
+#ifndef VCMODPLAYER_H
+#define VCMODPLAYER_H
+
+class CPlayerPed;
+class CPad;
+class CEntity;
+class CPed;
+
+// WALK MODE: the move speed is capped at a walking pace everywhere, the start
+// fade included
+extern bool bVCModWalkMode;
+// direction keys choose the body's heading: A and D turn him and walk forward
+// instead of side-stepping. Aiming or firing hands the heading back to the
+// mouse camera, because the torso has to follow the crosshair; a locked target
+// already owns the aim, so the keys keep the heading there
+extern bool bVCModNoStrafe;
+// lock-on can pick a driven, undamaged vehicle as a target
+extern bool bVCModLockOnVehicles;
+// the aim button is re-armed every frame while the lock is latched
+extern bool bVCModLockOnLatch;
+// the free-aim mouse camera can still lock on
+extern bool bVCModMouseAimLockOn;
+
+// true while WALK MODE is on
+bool VCModWalkModeOn(void);
+// the walk key: flips the WALK MODE switch
+void VCModPlayerToggleWalkMode(void);
+// caps the player's speed at a walking pace when WALK MODE is on
+void VCModWalkModeCap(CPlayerPed *player);
+
+// true while the no-strafe scheme owns the body's heading: the flag is on and
+// the player is not free-aiming or free-firing, so the mouse camera must stand
+// down; a locked target keeps the keys on the heading
+bool VCModPlayerTurnsWithInput(void);
+// true while the free-aim camera keeps the lock-on on
+bool VCModMouseLockOn(void);
+// true while a locked target owns the shot: NO STRAFE can turn the body while
+// he walks, and the arm's pointed flag would fall the shot back to the heading
+bool VCModLockShotHomes(CPed *shooter);
+// true while the free mouse camera must keep the view over a lock; the stock
+// lock camera belongs to the classic control method
+bool VCModFreeAimCameraLock(void);
+// true while the free-aim crosshair must stand down: a locked target already
+// carries the marker, and both reticles must not stack
+bool VCModFreeAimCrosshairHidden(CPed *player);
+// FIRING STANCE: while the trigger is held at a lock in the free camera the aim
+// owns the body, so the muzzle, the flash and the shot agree; the keys strafe
+// under the turn instead of choosing the heading
+bool VCModFiringStance(void);
+// the stance's body turn, at the ped's own stare rate; true when the stance
+// owns this frame, so the stock aim clamp stands down
+bool VCModFiringStanceTurn(CPlayerPed *player);
+
+// per frame: holds a latched lock-on by re-arming the aim button
+void VCModLockOnLatchTick(CPlayerPed *player, CPad *pad);
+// a latched lock-on re-arms the aim button every frame, and PED_SEEK_CAR drops
+// the entry as soon as that target input is down, so boarding has to let it go
+void VCModPlayerReleaseAim(void);
+
+// the vehicle scan shared by both lock-on searches: Next steps on from the
+// current target, First finds the first one
+void VCModLockOnVehiclesNext(CPlayerPed *player, CEntity *previousTarget, CEntity **nextTarget,
+	float *lastCloseness, float weaponRange, float referenceBeta, bool lookToLeft);
+void VCModLockOnVehiclesFirst(CPlayerPed *player, CEntity **nextTarget,
+	float *lastCloseness, float weaponRange, float referenceBeta);
+
+#endif
diff --git a/src/extras/vcmodqol.cpp b/src/extras/vcmodqol.cpp
new file mode 100644
index 0000000..974c345
--- /dev/null
+++ b/src/extras/vcmodqol.cpp
@@ -0,0 +1,148 @@
+#include "common.h"
+
+#include "vcmodqol.h"
+
+#include "General.h"
+#include "Pad.h"
+#include "ParticleMgr.h"
+#include "PlayerInfo.h"
+#include "PlayerPed.h"
+#include "Pools.h"
+#include "Timer.h"
+#include "Vehicle.h"
+
+// Cleaner HUD, wheels that stay put and a longer bleed are the original's
+// missing polish rather than a feature, so they start on like street idle does.
+bool bVCModVanillaFixes = true;
+bool bVCModHudCleanup = true;
+bool bVCModKeepWheelAngle = true;
+bool bVCModExitHoldOff = true;
+bool bVCModLongerFx = true;
+
+#define VCMOD_EXIT_HOLD_MS	400
+
+void
+VCModFormatMoney(char *out, size_t size, int32 money)
+{
+	snprintf(out, size, "$%d", money);
+}
+
+bool
+VCModWantedSlotVisible(int32 level, int32 minLevel, int32 slot)
+{
+	(void)slot;
+	return level != 0 || minLevel != 0;
+}
+
+bool
+VCModExitHoldElapsed(uint32 now, uint32 since, uint32 threshold)
+{
+	return (uint32)(now - since) >= threshold;
+}
+
+void
+VCModExitHoldTick(CPlayerInfo *info)
+{
+	static bool bArmed;
+	static uint32 nPressedAt;
+	static CVehicle *pPressedVeh;
+
+	if (!(bVCModVanillaFixes && bVCModExitHoldOff)) {
+		bArmed = false;
+		return;
+	}
+
+	CPad *pad = CPad::GetPad(0);
+	CPlayerPed *ped = info->m_pPed;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	if (!bArmed) {
+		// arm on a fresh press made while driving: the same binding is held while
+		// entering a car, and that hold must not count towards an exit nobody asked for
+		if (ped == nil || !ped->bInVehicle || ped->m_pMyVehicle == nil
+			|| ped->m_pMyVehicle->pDriver != ped || !pad->ExitVehicleJustDown())
+			return;
+		bArmed = true;
+		pPressedVeh = ped->m_pMyVehicle;
+		nPressedAt = now;
+		debug("vcm: exit hold armed (model %d)\n", (int32)pPressedVeh->GetModelIndex());
+		return;
+	}
+
+	if (!pad->GetExitVehicle()) {
+		bArmed = false;
+		return;
+	}
+
+	if (!VCModExitHoldElapsed(now, nPressedAt, VCMOD_EXIT_HOLD_MS))
+		return;
+
+	// the get-out animation can finish before the hold does, so the cut follows the
+	// car the press started in instead of needing the ped to still be sitting in it
+	bArmed = false;
+	int32 slot = CPools::GetVehiclePool()->GetJustIndex_NoFreeAssert(pPressedVeh);
+	if (slot < 0 || slot >= CPools::GetVehiclePool()->GetSize()
+		|| CPools::GetVehiclePool()->GetSlot(slot) != pPressedVeh)
+		return;
+	if (pPressedVeh->pDriver != nil && pPressedVeh->pDriver != ped)
+		return;	// someone else took it while the key was held
+	pPressedVeh->bEngineOn = false;
+	debug("vcm: exit hold %ums: engine off (model %d)\n",
+		(uint32)(now - nPressedAt), (int32)pPressedVeh->GetModelIndex());
+}
+
+// the five types LongerFx stretches, in the order their raw values are kept
+static const tParticleType aVCModLongerFxType[] = {
+	PARTICLE_BLOOD,
+	PARTICLE_BLOOD_SMALL,
+	PARTICLE_BLOOD_SPURT,
+	PARTICLE_BLOODDROP,
+	PARTICLE_PEDFOOT_DUST
+};
+
+static int32 aVCModFxRawLifeSpan[ARRAY_SIZE(aVCModLongerFxType)];
+// the config reader runs again on a save load and from the debug tweak, so the
+// raw values are kept from the first read: multiplying them twice would compound
+static bool bVCModFxRawValid;
+
+void
+VCModRefreshParticleLifetimes(void)
+{
+	bool longer = bVCModVanillaFixes && bVCModLongerFx;
+	static bool bLastLonger;
+	static bool bHaveLast;
+
+	if (!bVCModFxRawValid)
+		return;
+
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModLongerFxType); i++) {
+		tParticleSystemData *data = &mod_ParticleSystemManager.m_aParticles[aVCModLongerFxType[i]];
+		data->m_nLifeSpan = longer ? aVCModFxRawLifeSpan[i] * 2 : aVCModFxRawLifeSpan[i];
+	}
+
+	if (!bHaveLast || bLastLonger != longer) {
+		bHaveLast = true;
+		bLastLonger = longer;
+		debug("vcm: fx lifespan %s: blood %d, blooddrop %d, dust %d\n",
+			longer ? "x2" : "x1",
+			mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOOD].m_nLifeSpan,
+			mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOODDROP].m_nLifeSpan,
+			mod_ParticleSystemManager.m_aParticles[PARTICLE_PEDFOOT_DUST].m_nLifeSpan);
+	}
+}
+
+void
+VCModApplyParticleLifetimes(void)
+{
+	if (!bVCModFxRawValid) {
+		for (uint32 i = 0; i < ARRAY_SIZE(aVCModLongerFxType); i++)
+			aVCModFxRawLifeSpan[i] = mod_ParticleSystemManager.m_aParticles[aVCModLongerFxType[i]].m_nLifeSpan;
+		bVCModFxRawValid = true;
+		debug("vcm: fx raw lifespan blood %d, blooddrop %d, dust %d\n",
+			aVCModFxRawLifeSpan[0],
+			mod_ParticleSystemManager.m_aParticles[PARTICLE_BLOODDROP].m_nLifeSpan,
+			mod_ParticleSystemManager.m_aParticles[PARTICLE_PEDFOOT_DUST].m_nLifeSpan);
+	}
+
+	VCModRefreshParticleLifetimes();
+}
