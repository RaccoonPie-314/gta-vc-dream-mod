+static void
+VCModCrewCarBuild(void)
+{
+	nVCModCrewCarCount = 0;
+	for (int32 i = 0; i < MODELINFOSIZE && nVCModCrewCarCount < VCMOD_CREW_CAR_MAX; i++) {
+		CBaseModelInfo *info = CModelInfo::GetModelInfo(i);
+		if (info == nil || info->GetModelType() != MITYPE_VEHICLE)
+			continue;
+		if (((CVehicleModelInfo*)info)->m_vehicleType != VEHICLE_TYPE_CAR)
+			continue;
+		// three passenger seats: the two rear men and one for Tommy
+		if (CVehicleModelInfo::GetMaximumNumberOfPassengersFromNumberOfDoors(i) < 3)
+			continue;
+		int32 j = nVCModCrewCarCount;
+		while (j > 0 && strcmp(((CBaseModelInfo*)CModelInfo::GetModelInfo(aVCModCrewCars[j-1]))->GetModelName(),
+		                       info->GetModelName()) > 0) {
+			aVCModCrewCars[j] = aVCModCrewCars[j-1];
+			j--;
+		}
+		aVCModCrewCars[j] = i;
+		nVCModCrewCarCount++;
+	}
+}
+
+int32
+VCModCrewCarCount(void)
+{
+	if (nVCModCrewCarCount < 0)
+		VCModCrewCarBuild();
+	return nVCModCrewCarCount;
+}
+
+bool
+VCModCrewCarAt(int32 entry, int16 *outModel, const char **outName)
+{
+	if (entry < 0 || entry >= VCModCrewCarCount())
+		return false;
+	int32 model = aVCModCrewCars[entry];
+	if (outModel) *outModel = model;
+	if (outName) *outName = ((CBaseModelInfo*)CModelInfo::GetModelInfo(model))->GetModelName();
+	return true;
+}
+
+void
+VCModCrewCarValidate(void)
+{
+	for (int32 i = 0; i < VCModCrewCarCount(); i++)
+		if (aVCModCrewCars[i] == nVCModCrewCar)
+			return;
+	nVCModCrewCar = MI_ADMIRAL;
+}
+
+int32
+VCModCrewPhase(void)
+{
+	return nVCModCrewPhase;
+}
+
+CVehicle *
+VCModCrewVehicle(void)
+{
+	if (nVCModCrewHandle < 0)
+		return nil;
+	return CPools::GetVehiclePool()->GetAt(nVCModCrewHandle);
+}
+
+static CPed *
+VCModCrewPed(int32 slot)
+{
+	if (slot < 0 || slot >= VCMOD_CREW_SIZE)
+		return nil;
+	int32 handle = nVCModCrewPedHandle[slot];
+	if (handle < 0)
+		return nil;
+	CPed *ped = CPools::GetPedPool()->GetAt(handle);
+	// a recycled slot may now hold a stranger
+	if (ped == nil || ped->m_nPedType != PEDTYPE_GANG7) {
+		nVCModCrewPedHandle[slot] = -1;
+		return nil;
+	}
+	return ped;
+}
+
+bool
+VCModCrewOwnsCar(CVehicle *vehicle)
+{
+	return vehicle != nil && vehicle == VCModCrewVehicle();
+}
+
+bool
+VCModCrewOwnsPed(CPed *ped)
+{
+	if (ped == nil)
+		return false;
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++)
+		if (ped == VCModCrewPed(i))
+			return true;
+	return false;
+}
+
+bool
+VCModCrewIgnoresLights(CVehicle *vehicle)
+{
+	return nVCModCrewPhase == VCMOD_CREW_APPROACH && VCModCrewOwnsCar(vehicle);
+}
+
+// Civilian traffic never touches the pedals: it is STATUS_SIMPLE and CCarCtrl
+// drags it along its lane at a speed the AI can only lower (UpdateCarOnRails).
+// That is why NPCs do not flash their brake lights, and why a rails car cannot
+// steer into a building. An AI crew car drives the same way.
+static void
+VCModCrewRailsSeed(CVehicle *car, int32 cruise);
+
+static void
+VCModCrewRails(CVehicle *car, int32 cruise)
+{
+	car->SetStatus(STATUS_SIMPLE);
+	car->m_fGasPedal = 0.0f;
+	car->m_fBrakePedal = 0.0f;
+	car->bIsHandbrakeOn = false;
+	car->AutoPilot.m_nCruiseSpeed = cruise;
+	VCModCrewRailsSeed(car, cruise);
+}
+
+// Normal is STOP_FOR_CARS: it queues behind cars and stops at red lights.
+// Aggressive is AVOID_CARS, which steers round traffic and has no light check;
+// it needs physics to steer, and like every stock style it cannot see buildings.
+static void
+VCModCrewApplyStyle(CVehicle *car, bool goingSomewhere, bool rails)
+{
+	bVCModCrewAppliedAggressive = bVCModCrewAggressive;
+	if (bVCModCrewAggressive) {
+		if (car->GetStatus() == STATUS_SIMPLE) {
+			car->SetStatus(STATUS_PHYSICS);
+			CCarCtrl::SwitchVehicleToRealPhysics(car);
+		}
+		car->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+		car->AutoPilot.m_nCruiseSpeed = goingSomewhere ? VCMOD_CREW_RUSH_SPEED : VCMOD_CREW_RUSH_CRUISE;
+		return;
+	}
+	int32 cruise = goingSomewhere ? VCMOD_CREW_RIDE_SPEED : VCMOD_CREW_CRUISE_SPEED;
+	car->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_STOP_FOR_CARS;
+	if (rails) {
+		VCModCrewRails(car, cruise);
+		return;
+	}
+	car->SetStatus(STATUS_PHYSICS);
+	car->AutoPilot.m_nCruiseSpeed = cruise;
+}
+
+static CPed *
+VCModCrewAddMan(CVehicle *car, int32 model, bool driver)
+{
+	CPed *ped = CPopulation::AddPed(PEDTYPE_GANG7, model, car->GetPosition());
+	if (ped == nil)
+		return nil;
+	ped->CharCreatedBy = MISSION_CHAR;
+	ped->bIsPlayerFriend = true;
+	ped->bStayInCarOnJack = true;
+	// ped.dat gives GANG7 no COP threat, so police are invisible to their scan
+	ped->m_fearFlags |= PED_FLAG_COP;
+	ped->GiveDelayedWeapon(WEAPONTYPE_M4, VCMOD_CREW_M4_AMMO);
+	ped->SetCurrentWeapon(CWeaponInfo::GetWeaponInfo(WEAPONTYPE_M4)->m_nWeaponSlot);
+	// the warp reads the objective, so the driver seat has to be asked for first
+	ped->SetObjective(driver ? OBJECTIVE_ENTER_CAR_AS_DRIVER : OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+	ped->WarpPedIntoCar(car);
+	// no leader link here: a follower seated in a car whose leader is on foot is
+	// ordered straight out by UpdateFromLeader. The link is attached in the aboard
+	// pass, once Tommy is in the car with them.
+	return ped;
+}
+
+static void
+VCModCrewRemoveMen(void)
+{
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		CPed *ped = VCModCrewPed(i);
+		nVCModCrewPedHandle[i] = -1;
+		if (ped == nil)
+			continue;
+		CWorld::Remove(ped);
+		CWorld::RemoveReferencesToDeletedObject(ped);
+		delete ped;
+	}
+}
+
+static void
+VCModCrewRemoveCar(void)
+{
+	int32 handle = nVCModCrewHandle;
+	CVehicle *car = VCModCrewVehicle();
+	nVCModCrewHandle = -1;
+	if (car == nil)
+		return;
+	CRadar::ClearBlipForEntity(BLIP_CAR, handle);
+	CPlayerPed *player = FindPlayerPed();
+	// never delete a car the player is sitting in; hand it to traffic instead
+	if (player != nil && player->InVehicle() && player->m_pMyVehicle == car) {
+		if (car->VehicleCreatedBy == MISSION_VEHICLE) {
+			car->VehicleCreatedBy = RANDOM_VEHICLE;
+			CCarCtrl::NumMissionCars--;
+			CCarCtrl::NumRandomCars++;
+		}
+		return;
+	}
+	CWorld::Remove(car);
+	CWorld::RemoveReferencesToDeletedObject(car);
+	delete car;
+}
+
+static void
+VCModCrewReset(void)
+{
+	nVCModCrewHandle = -1;
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++)
+		nVCModCrewPedHandle[i] = -1;
+	nVCModCrewPhase = VCMOD_CREW_NONE;
+	vecVCModCrewPickup = CVector(0.0f, 0.0f, 0.0f);
+	nVCModCrewRetargetAt = 0;
+	nVCModCrewSwapAt = 0;
+	nVCModCrewSwapFrom = VCMOD_CREW_PICKUP;
+	bVCModCrewPlayerObjective = false;
+	nVCModCrewAppliedZone = -2;
+	vecVCModCrewDestination = CVector(0.0f, 0.0f, 0.0f);
+	bVCModCrewHasDestination = false;
+	nVCModCrewDismissAt = 0;
+	nVCModCrewDriveRetryAt = 0;
+	// the crew can end with Tommy still in the car; the flag is ours to take back
+	if (bVCModCrewPlayerStay) {
+		CPlayerPed *player = FindPlayerPed();
+		if (player != nil && player->bStayInCarOnJack)
+			player->bStayInCarOnJack = false;
+		bVCModCrewPlayerStay = false;
+	}
+}
+
+static void
+VCModCrewStandDown(void)
+{
+	VCModCrewRemoveMen();
+	VCModCrewRemoveCar();
+	VCModCrewReset();
+}
+
+// the handle is set before the men, so a half-made crew can still be removed
+static bool
+VCModCrewSummon(CPlayerPed *player)
+{
+	VCModCrewCarValidate();
+	CStreaming::RequestModel(nVCModCrewCar, 0);
+	CStreaming::RequestModel(MI_M4, 0);
+	CStreaming::RequestModel(MI_PGA, 0);
+	CStreaming::RequestModel(MI_PGB, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(nVCModCrewCar)) {
+		VCModHudNotice("crew: the car cannot be loaded");
+		return false;
+	}
+	if (!CStreaming::HasModelLoaded(MI_M4)) {
+		VCModHudNotice("crew: the M4 cannot be loaded");
+		return false;
+	}
+	if (!CStreaming::HasModelLoaded(MI_PGA) || !CStreaming::HasModelLoaded(MI_PGB)) {
+		VCModHudNotice("crew: the crew cannot be loaded");
+		return false;
+	}
+
+	// come from behind Tommy so the approach is a drive, not a car under his feet
+	CVector here = player->GetPosition();
+	CVector from = here - player->GetForward() * VCMOD_CREW_SPAWN_BACK;
+	int32 node = ThePaths.FindNodeClosestToCoors(from, PATH_CAR, 60.0f, true, true);
+	if (node < 0)
+		node = ThePaths.FindNodeClosestToCoors(here, PATH_CAR, 200.0f, true, true);
+	if (node < 0) {
+		VCModHudNotice("crew: no road to come from");
+		return false;
+	}
+
+	CAutomobile *car = new CAutomobile(nVCModCrewCar, RANDOM_VEHICLE);
+	if (car == nil) {
+		VCModHudNotice("crew: no room for the car");
+		return false;
+	}
+
+	CVector pos = ThePaths.m_pathNodes[node].GetPosition();
+	car->SetPosition(pos);
+	CVector2D dir = here - pos;
+	dir.Normalise();
+	car->GetForward() = CVector(dir.x, dir.y, 0.0f);
+	car->GetRight() = CVector(dir.y, -dir.x, 0.0f);
+	car->GetUp() = CVector(0.0f, 0.0f, 1.0f);
+	pos.z += car->GetDistanceFromCentreOfMassToBaseOfModel();
+	car->SetPosition(pos);
+	car->PlaceOnRoadProperly();
+	car->SetStatus(STATUS_PHYSICS);
+	car->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	CTheScripts::ClearSpaceForMissionEntity(pos, car);
+	CWorld::Add(car);
+	nVCModCrewHandle = CPools::GetVehiclePool()->GetIndex(car);
+
+	int32 made = 0;
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		int32 model = CGangs::ChooseGangPedModel(GANG_PLAYER);
+		CPed *ped = VCModCrewAddMan(car, model, i == 0);
+		if (ped == nil)
+			break;
+		nVCModCrewPedHandle[i] = CPools::GetPedPool()->GetIndex(ped);
+		made++;
+	}
+	if (made < VCMOD_CREW_SIZE) {
+		VCModCrewStandDown();
+		VCModHudNotice("crew: the men could not be made");
+		return false;
+	}
+
+	CRadar::SetEntityBlip(BLIP_CAR, nVCModCrewHandle, 0, BLIP_DISPLAY_BOTH);
+	nVCModCrewPhase = VCMOD_CREW_APPROACH;
+	vecVCModCrewPickup = VCModCrewPickupPoint(here);
+	nVCModCrewRetargetAt = 0;
+	VCModCrewGoto(car, vecVCModCrewPickup);
+	VCModCrewFaceRoute(car);
+	VCModHudNotice("your crew is on the way");
+	return true;
+}
+
+static void
+VCModCrewTickApproach(CPlayerPed *player, CVehicle *car)
+{
+	if (player->InVehicle()) {
+		VCModCrewStandDown();
+		return;
+	}
+	CVector here = player->GetPosition();
+	// Tommy walked on: send the car to the road beside where he is now. Comparing
+	// pick-up points rather than his distance to one keeps a man standing off the
+	// road from re-routing the car to the same point every few seconds.
+	if (CTimer::GetTimeInMilliseconds() >= nVCModCrewRetargetAt) {
+		nVCModCrewRetargetAt = CTimer::GetTimeInMilliseconds() + VCMOD_CREW_RETARGET_WAIT;
+		CVector point = VCModCrewPickupPoint(here);
+		if ((point - vecVCModCrewPickup).Magnitude2D() > VCMOD_CREW_RETARGET_NEAR) {
+			vecVCModCrewPickup = point;
+			VCModCrewGoto(car, vecVCModCrewPickup);
+		}
+	}
+	// stop beside Tommy, or at the road point when he stands farther off the road
+	// than that: it is as close as the car can come
+	if ((car->GetPosition() - here).Magnitude2D() < VCMOD_CREW_PICKUP_NEAR ||
+			(car->GetPosition() - vecVCModCrewPickup).Magnitude2D() < VCMOD_CREW_PICKUP_POINT_NEAR) {
+		car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		car->AutoPilot.m_nCruiseSpeed = 0;
+		CRadar::ClearBlipForEntity(BLIP_CAR, nVCModCrewHandle);
+		nVCModCrewPhase = VCMOD_CREW_PICKUP;
+		VCModHudNotice("your crew is here");
+	}
+}
+
+void
+VCModCrewCall(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return;
+	if (nVCModCrewPhase != VCMOD_CREW_NONE) {
+		VCModCrewDismiss();
+		return;
+	}
+	if (player->bInVehicle) {
+		VCModHudNotice("crew: get out first");
+		return;
+	}
+	VCModCrewSummon(player);
+}
+
+static void
+VCModCrewTickPickup(CPlayerPed *player, CVehicle *car)
+{
+	CVector here = player->GetPosition();
+	if ((here - car->GetPosition()).Magnitude2D() > VCMOD_CREW_ABANDON_FAR) {
+		VCModHudNotice("crew left: too far away");
+		VCModCrewStandDown();
+		return;
+	}
+	if (player->InVehicle()) {
+		if (player->m_pMyVehicle != car) {
+			VCModCrewStandDown();
+			return;
+		}
+		nVCModCrewPhase = VCMOD_CREW_ABOARD;
+	}
+}
+
+bool
+VCModCrewEntry(CVehicle *vehicle)
+{
+	if (!VCModCrewOwnsCar(vehicle))
+		return false;
+	// every press on the crew car belongs to us; none of them may become a carjack
+	if (nVCModCrewPhase == VCMOD_CREW_APPROACH) {
+		VCModHudNotice("crew: wait for the car to stop");
+		return true;
+	}
+	// the wheel can be asked for again after leaving an escort, if a man is in it
+	if (nVCModCrewPhase != VCMOD_CREW_PICKUP && nVCModCrewPhase != VCMOD_CREW_ESCORT)
+		return true;
+
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || player->bInVehicle)
+		return true;
+	// an empty crew car has no driver to yield: the stock driver entry is right
+	if (vehicle->pDriver == nil)
+		return false;
+
+	CPed *driver = vehicle->pDriver;
+	if (driver->m_nPedType != PEDTYPE_GANG7)
+		return false;
+
+	// the link is lifted for the swap, or he walks off toward Tommy instead of out
+	driver->ClearLeader();
+	driver->SetObjective(OBJECTIVE_LEAVE_CAR, vehicle);
+	nVCModCrewSwapAt = CTimer::GetTimeInMilliseconds();
+	nVCModCrewSwapFrom = nVCModCrewPhase;
+	bVCModCrewPlayerObjective = false;
+	nVCModCrewPhase = VCMOD_CREW_SWAP;
+	VCModHudNotice("the driver is getting out");
+	return true;
+}
+
+static void
+VCModCrewTickSwap(CPlayerPed *player, CVehicle *car)
+{
+	CPed *driver = car->pDriver != nil ? car->pDriver : VCModCrewPed(0);
+
+	// the seat only becomes Tommy's once the ex-driver is out of the car and off
+	// the door, because m_pMyVehicle stays set while a ped is still walking to it
+	if (!bVCModCrewPlayerObjective && car->pDriver == nil &&
+			(driver == nil || !driver->bInVehicle)) {
+		if (driver != nil) {
+			driver->SetObjective(OBJECTIVE_WAIT_ON_FOOT);
+			driver->SetObjectiveTimer(0);
+		}
+		player->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+		bVCModCrewPlayerObjective = true;
+	}
+
+	if (player->InVehicle() && player->m_pMyVehicle == car) {
+		nVCModCrewPhase = VCMOD_CREW_ABOARD;
+		if (driver != nil) {
+			driver->SetLeader(player);
+			driver->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+		}
+		return;
+	}
+
+	// no clear seat in time, or Tommy walked off: the driver takes the wheel back
+	if (CTimer::GetTimeInMilliseconds() - nVCModCrewSwapAt > VCMOD_CREW_SWAP_TIMEOUT ||
+			(player->GetPosition() - car->GetPosition()).Magnitude2D() > VCMOD_CREW_SWAP_FAR) {
+		if (driver != nil && driver->bInVehicle && car->pDriver == driver)
+			driver->SetObjective(OBJECTIVE_NONE);
+		else if (driver != nil)
+			driver->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+		bVCModCrewPlayerObjective = false;
+		nVCModCrewPhase = nVCModCrewSwapFrom;
+		VCModHudNotice("crew: the driver is back at the wheel");
+	}
+}
+
+static bool
+VCModCrewSeatFree(CVehicle *car)
+{
+	for (int32 i = 0; i < car->m_nNumMaxPassengers; i++)
+		if (car->pPassengers[i] == nil)
+			return true;
+	return false;
+}
+
+static void
+VCModCrewFill(CPlayerPed *player, CVehicle *car)
+{
+	bool driverNeeded = car->pDriver == nil;
+	bool playerDriving = player->InVehicle() && player->m_pMyVehicle == car &&
+		car->pDriver == player;
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		CPed *ped = VCModCrewPed(i);
+		if (ped == nil || ped->bInVehicle)
+			continue;
+		// riding as a passenger: UpdateFromLeader would keep calling the men to
+		// the car, so the link is lifted until each man is seated
+		if (!playerDriving && ped->m_leader != nil)
+			ped->ClearLeader();
+		if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+				ped->m_objective == OBJECTIVE_ENTER_CAR_AS_DRIVER)
+			continue;
+		if (driverNeeded) {
+			ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+			driverNeeded = false;
+		} else if (VCModCrewSeatFree(car)) {
+			ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+		}
+	}
+}
+
+static void
+VCModCrewDrive(CVehicle *car)
+{
+	int32 zoneIndex;
+	CVector dest;
+	int32 entry = VCModRideZoneEntry(nVCModRideZone);
+	if (VCModRideZoneAt(entry, &zoneIndex, nil, &dest) && zoneIndex >= 0) {
+		bool rails = !CCarCtrl::JoinCarWithRoadSystemGotoCoors(car, dest, false);
+		car->AutoPilot.m_nCarMission = rails ? MISSION_GOTOCOORDS : MISSION_GOTO_COORDS_STRAIGHT_ACCURATE;
+		vecVCModCrewDestination = dest;
+		bVCModCrewHasDestination = true;
+		VCModCrewApplyStyle(car, true, rails);
+	} else {
+		CCarCtrl::JoinCarWithRoadSystem(car);
+		if (car->AutoPilot.m_nCurrentRouteNode == 0 || car->AutoPilot.m_nNextRouteNode == 0) {
+			// no road links under the car: wait rather than follow a path that is
+			// not there, which drives it at whatever route node 0 happens to be
+			car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+			car->AutoPilot.m_nCruiseSpeed = 0;
+			car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+			bVCModCrewHasDestination = false;
+			nVCModCrewAppliedZone = -2;
+			nVCModCrewDriveRetryAt = CTimer::GetTimeInMilliseconds() + 2000;
+			return;
+		}
+		car->AutoPilot.m_nCarMission = MISSION_CRUISE;
+		bVCModCrewHasDestination = false;
+		VCModCrewApplyStyle(car, false, true);
+	}
+	car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	nVCModCrewAppliedZone = entry;
+}
+
+// A ped taking the driver seat ejects every passenger without this flag
+// (Ped.cpp: PedSetInCarCB), and that includes Tommy when a crew man is put at the
+// wheel of the car Tommy is already riding in.
+static void
+VCModCrewKeepPlayerSeated(CPlayerPed *player, CVehicle *car)
+{
+	if (player == nil)
+		return;
+	if (player->InVehicle() && player->m_pMyVehicle == car) {
+		if (!player->bStayInCarOnJack) {
+			player->bStayInCarOnJack = true;
+			bVCModCrewPlayerStay = true;
+		}
+	} else if (bVCModCrewPlayerStay) {
+		if (player->bStayInCarOnJack)
+			player->bStayInCarOnJack = false;
+		bVCModCrewPlayerStay = false;
+	}
+}
+
+static void
+VCModCrewTickAboard(CPlayerPed *player, CVehicle *car)
+{
+	VCModCrewKeepPlayerSeated(player, car);
+	if (!player->InVehicle() || player->m_pMyVehicle != car) {
+		// he is getting out: boarding again has to issue the ride afresh, or the
+		// car sits exactly where he left it
+		nVCModCrewAppliedZone = -2;
+		nVCModCrewPhase = VCMOD_CREW_ESCORT;
+		return;
+	}
+	VCModCrewFill(player, car);
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		CPed *ped = VCModCrewPed(i);
+		if (ped != nil && ped->bInVehicle && ped->m_leader == nil)
+			ped->SetLeader(player);
+	}
+	// Tommy at the wheel: nobody's AI may steer; a crew man driving follows RIDE TO.
+	// An empty driver seat keeps the car stopped: the mission is issued once a man
+	// is actually at the wheel, not while he is still walking to the door.
+	if (car->pDriver != nil && car->pDriver != player) {
+		// RIDE TO is read live, and in auto the marker is part of it: placing one,
+		// clearing it, or dragging it to a new place all re-route the car
+		int32 entry = VCModRideZoneEntry(nVCModRideZone);
+		if ((nVCModCrewAppliedZone != entry || VCModRideZoneMoved(vecVCModCrewDestination)) &&
+				CTimer::GetTimeInMilliseconds() >= nVCModCrewDriveRetryAt)
+			VCModCrewDrive(car);
+		// The switch changes how the car drives, never where: no re-route, and
+		// back to normal stays on physics, since rails would drag the car onto its
+		// lane line in one frame.
+		if (bVCModCrewAppliedAggressive != bVCModCrewAggressive &&
+				nVCModCrewAppliedZone == entry &&
+				car->AutoPilot.m_nCarMission != MISSION_STOP_FOREVER)
+			VCModCrewApplyStyle(car, bVCModCrewHasDestination, false);
+		if (bVCModCrewHasDestination &&
+				(car->GetPosition() - vecVCModCrewDestination).Magnitude2D() < VCMOD_CREW_ARRIVE_NEAR) {
+			car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+			car->AutoPilot.m_nCruiseSpeed = 0;
+			car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+			bVCModCrewHasDestination = false;
+			VCModHudNotice("your crew has arrived");
+		}
+	}
+}
+
+static void
+VCModCrewTickEscort(CPlayerPed *player, CVehicle *car)
+{
+	if (player->InVehicle() && player->m_pMyVehicle == car)
+		nVCModCrewPhase = VCMOD_CREW_ABOARD;
+}
+
+// the crew stops being ours: one living man leads the rest as a street gang. The
+// men are never despawned here; RANDOM_CHAR only lets the world reclaim the group
+// once it is far away and off screen, exactly like any other gang.
+static void
+VCModCrewHandover(void)
+{
+	CPed *living[VCMOD_CREW_SIZE];
+	int32 n = 0;
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		CPed *ped = VCModCrewPed(i);
+		if (ped != nil && !ped->Dead())
+			living[n++] = ped;
+	}
+	if (n == 0)
+		return;
+
+	CPed *leader = living[CGeneral::GetRandomNumberInRange(0, n)];
+	for (int32 i = 0; i < n; i++) {
+		CPed *ped = living[i];
+		// a fight already running survives the handover; only a flee is replaced
+		eObjective keep = (eObjective) ped->m_objective;
+		CEntity *target = ped->m_pedInObjective;
+		ped->ClearLeader();
+		ped->bIsPlayerFriend = false;
+		ped->bStayInCarOnJack = false;
+		ped->CharCreatedBy = RANDOM_CHAR;
+		ped->m_fearFlags &= ~PED_FLAG_COP;
+		if (keep == OBJECTIVE_KILL_CHAR_ON_FOOT || keep == OBJECTIVE_KILL_CHAR_ANY_MEANS)
+			ped->SetObjective(keep, target);
+	}
+	for (int32 i = 0; i < n; i++) {
+		CPed *ped = living[i];
+		if (ped == leader)
+			continue;
+		ped->SetLeader(leader);
+		if (ped->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT &&
+				ped->m_objective != OBJECTIVE_KILL_CHAR_ANY_MEANS) {
+			ped->SetObjective(OBJECTIVE_FOLLOW_CHAR_IN_FORMATION, leader);
+			ped->SetFormation((eFormation) i);
+		}
+	}
+	if (leader->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT &&
+			leader->m_objective != OBJECTIVE_KILL_CHAR_ANY_MEANS) {
+		leader->SetObjective(OBJECTIVE_NONE);
+		leader->SetWanderPath(CGeneral::GetRandomNumber() & 7);
+	}
+	leader->bIsLeader = true;
+}
+
+// a mission ped is never reclaimed by the world, so a body left in the pool would
+// be permanent; this is the only removal the mod does
+static void
+VCModCrewRemoveDead(void)
+{
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		int32 handle = nVCModCrewPedHandle[i];
+		if (handle < 0)
+			continue;
+		CPed *ped = CPools::GetPedPool()->GetAt(handle);
+		if (ped == nil || !ped->Dead())
+			continue;
+		nVCModCrewPedHandle[i] = -1;
+		CWorld::Remove(ped);
+		CWorld::RemoveReferencesToDeletedObject(ped);
+		delete ped;
+	}
+}
+
+static void
+VCModCrewDismiss(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	CVehicle *car = VCModCrewVehicle();
+	bool aboard = player != nil && car != nil && player->InVehicle() && player->m_pMyVehicle == car;
+	// in the car the men have to get out first, or they are handed over while still
+	// seated in a car that is about to leave them behind
+	if (aboard) {
+		car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		car->AutoPilot.m_nCruiseSpeed = 0;
+		car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+		for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+			CPed *ped = VCModCrewPed(i);
+			if (ped != nil && ped->bInVehicle)
+				ped->SetObjective(OBJECTIVE_LEAVE_CAR, car);
+		}
+		nVCModCrewDismissAt = CTimer::GetTimeInMilliseconds();
+		nVCModCrewPhase = VCMOD_CREW_DISMISS_WAIT;
+		VCModHudNotice("crew dismissed");
+		return;
+	}
+	VCModCrewHandover();
+	VCModCrewRemoveDead();
+	VCModCrewRemoveCar();
+	VCModCrewReset();
+	VCModHudNotice("crew dismissed");
+}
+
+static void
+VCModCrewTickDismissWait(CPlayerPed *player, CVehicle *car)
+{
+	bool anyAboard = false;
+	for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+		CPed *ped = VCModCrewPed(i);
+		if (ped != nil && ped->bInVehicle)
+			anyAboard = true;
+	}
+	if (!anyAboard || CTimer::GetTimeInMilliseconds() - nVCModCrewDismissAt > 10000) {
+		VCModCrewHandover();
+		VCModCrewRemoveDead();
+		VCModCrewRemoveCar();
+		VCModCrewReset();
+	}
+}
+
+void
+VCModCrewPlayerDied(void)
+{
+	if (nVCModCrewPhase == VCMOD_CREW_NONE)
+		return;
+	CVehicle *car = VCModCrewVehicle();
+	CPlayerPed *player = FindPlayerPed();
+	if (car != nil && player != nil && player->InVehicle() && player->m_pMyVehicle == car) {
+		car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		car->AutoPilot.m_nCruiseSpeed = 0;
+		for (int32 i = 0; i < VCMOD_CREW_SIZE; i++) {
+			CPed *ped = VCModCrewPed(i);
+			if (ped != nil && ped->bInVehicle)
+				ped->SetObjective(OBJECTIVE_LEAVE_CAR, car);
+		}
+		nVCModCrewDismissAt = CTimer::GetTimeInMilliseconds();
+		nVCModCrewPhase = VCMOD_CREW_DISMISS_WAIT;
+		return;
+	}
+	VCModCrewHandover();
+	VCModCrewRemoveDead();
+	VCModCrewRemoveCar();
+	VCModCrewReset();
+}
+
+// The car has to arrive at a road point, not at Tommy's feet: a GOTOCOORDS
+// mission switches to a straight line within 20 m of the destination, which
+// drives a car through fences and walls when the destination is off the road.
+// Nodes sit 20-40 m apart along a road that may pass right beside him, so the
+// point is the nearest one on the nearest node's links, not the node itself.
+static CVector
+VCModCrewPickupPoint(CVector here)
+{
+	int32 node = ThePaths.FindNodeClosestToCoors(here, PATH_CAR, 15.0f, true, true);
+	if (node < 0)
+		node = ThePaths.FindNodeClosestToCoors(here, PATH_CAR, 60.0f, true, true);
+	if (node < 0)
+		return here;
+	CPathNode *from = &ThePaths.m_pathNodes[node];
+	CVector a = from->GetPosition();
+	CVector best = a;
+	float bestDist = (here - a).Magnitude2D();
+	for (int32 i = 0; i < from->numLinks; i++) {
+		CPathNode *to = &ThePaths.m_pathNodes[ThePaths.ConnectedNode(from->firstLink + i)];
+		if (to->bDisabled)
+			continue;
+		CVector ab = to->GetPosition() - a;
+		float len2 = ab.x * ab.x + ab.y * ab.y;
+		if (len2 < 0.01f)
+			continue;
+		float t = ((here.x - a.x) * ab.x + (here.y - a.y) * ab.y) / len2;
+		t = Min(1.0f, Max(0.0f, t));
+		CVector p = a + ab * t;
+		float d = (here - p).Magnitude2D();
+		if (d < bestDist) {
+			bestDist = d;
+			best = p;
+		}
+	}
+	return best;
+}
+
+// The rails motion is a curve timed by the car's speed, so the timing has to be
+// rebuilt from the car's real place on the link pair. Without it the first frame
+// drags the car back to the start of the link; after a re-route, to the node
+// behind it.
+static void
+VCModCrewRailsSeed(CVehicle *car, int32 cruise)
+{
+	CAutoPilot *ap = &car->AutoPilot;
+	float speed = (float) cruise;
+	ap->m_fMaxTrafficSpeed = speed;
+	ap->m_nTimeToSpendOnCurrentCurve = 1000;
+	ap->m_nTimeEnteredCurve = CTimer::GetTimeInMilliseconds();
+	ap->ModifySpeed(speed);
+
+	CCarPathLink *cur = &ThePaths.m_carPathLinks[ap->m_nCurrentPathNodeInfo];
+	CCarPathLink *next = &ThePaths.m_carPathLinks[ap->m_nNextPathNodeInfo];
+	float fwdX = ap->m_nCurrentDirection * cur->GetDirX();
+	float fwdY = ap->m_nCurrentDirection * cur->GetDirY();
+	float nfwdX = ap->m_nNextDirection * next->GetDirX();
+	float nfwdY = ap->m_nNextDirection * next->GetDirY();
+	// the same lane points CAutoPilot::ModifySpeed timed the curve with
+	CVector a(cur->GetX() + ((ap->m_nCurrentLane + 0.5f) * LANE_WIDTH) * fwdY,
+	          cur->GetY() - ((ap->m_nCurrentLane + 0.5f) * LANE_WIDTH) * fwdX, 0.0f);
+	CVector b(next->GetX() + ((ap->m_nNextLane + 0.5f) * LANE_WIDTH) * nfwdY,
+	          next->GetY() - ((ap->m_nNextLane + 0.5f) * LANE_WIDTH) * nfwdX, 0.0f);
+	CVector ab = b - a;
+	float len2 = ab.x * ab.x + ab.y * ab.y;
+	float t = 0.0f;
+	if (len2 > 0.01f) {
+		CVector pa = car->GetPosition() - a;
+		t = (pa.x * ab.x + pa.y * ab.y) / len2;
+	}
+	if (t < 0.0f) t = 0.0f;
+	if (t > 0.9f) t = 0.9f;
+	ap->m_nTimeEnteredCurve = CTimer::GetTimeInMilliseconds() -
+		(uint32)(t * ap->m_nTimeToSpendOnCurrentCurve);
+}
+
+// A car placed facing Tommy may be facing against the legal lane; it then starts
+// the run nose-to-nose with traffic. The route's first link knows the right way.
+static void
+VCModCrewFaceRoute(CVehicle *car)
+{
+	if (car->AutoPilot.m_nCarMission != MISSION_GOTOCOORDS)
+		return;
+	CCarPathLink *link = &ThePaths.m_carPathLinks[car->AutoPilot.m_nCurrentPathNodeInfo];
+	float dx = link->GetDirX() * car->AutoPilot.m_nCurrentDirection;
+	float dy = link->GetDirY() * car->AutoPilot.m_nCurrentDirection;
+	car->GetForward() = CVector(dx, dy, 0.0f);
+	car->GetRight() = CVector(dy, -dx, 0.0f);
+}
+
+// the engine's own mission for a route: a path when one exists, a straight run
+// when there is none (the same choice CCarAI makes)
+static void
+VCModCrewGoto(CVehicle *car, CVector dest)
+{
+	bool straight = CCarCtrl::JoinCarWithRoadSystemGotoCoors(car, dest, false);
+	car->AutoPilot.m_nCarMission = straight ? MISSION_GOTO_COORDS_STRAIGHT_ACCURATE : MISSION_GOTOCOORDS;
+	car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	car->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_STOP_FOR_CARS;
+	if (straight) {
+		// no lane to drag the car along: on rails this mission picks nodes at random
+		car->SetStatus(STATUS_PHYSICS);
+		car->AutoPilot.m_nCruiseSpeed = 15;
+	} else if (car->GetStatus() == STATUS_SIMPLE) {
+		// a re-route moves the links under a car that is already on rails
+		VCModCrewRailsSeed(car, car->AutoPilot.m_nCruiseSpeed);
+	} else {
+		VCModCrewRails(car, 15);
+	}
+}
+
+static void
+VCModCrewTelemetry(CPlayerPed *player, CVehicle *car)
+{
+	static uint32 next;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (now < next)
+		return;
+	next = now + 1000;
+	VCMOD_DIAG("VCMOD CREW state phase %d car %p seat %d driver %d speed %d"
+		" mission %d style %d status %d temp %d gas %d brake %d slowed %d%d"
+		" pos %.1f %.1f %.1f tommy %.1f %.1f target %.1f %.1f dT %.1f dN %.1f\n",
+		(int) nVCModCrewPhase, (void*) car,
+		player->InVehicle() && player->m_pMyVehicle == car,
+		car->pDriver == player ? 1 : car->pDriver != nil,
+		(int) car->AutoPilot.m_nCruiseSpeed,
+		(int) car->AutoPilot.m_nCarMission, (int) car->AutoPilot.m_nDrivingStyle,
+		(int) car->GetStatus(),
+		(int) car->AutoPilot.m_nTempAction,
+		(int) (car->m_fGasPedal * 100.0f), (int) (car->m_fBrakePedal * 100.0f),
+		car->AutoPilot.m_bSlowedDownBecauseOfCars,
+		car->AutoPilot.m_bSlowedDownBecauseOfPeds,
+		car->GetPosition().x, car->GetPosition().y, car->GetPosition().z,
+		player->GetPosition().x, player->GetPosition().y,
+		vecVCModCrewPickup.x, vecVCModCrewPickup.y,
+		(car->GetPosition() - player->GetPosition()).Magnitude2D(),
+		(car->GetPosition() - vecVCModCrewPickup).Magnitude2D());
+}
+
+void
+VCModCrewUpdate(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (nVCModCrewPhase == VCMOD_CREW_NONE)
+		return;
+	CVehicle *car = VCModCrewVehicle();
+	if (player == nil || car == nil) {
+		VCModCrewStandDown();
+		return;
+	}
+	switch (nVCModCrewPhase) {
+	case VCMOD_CREW_APPROACH:	VCModCrewTickApproach(player, car); break;
+	case VCMOD_CREW_PICKUP:		VCModCrewTickPickup(player, car); break;
+	case VCMOD_CREW_SWAP:		VCModCrewTickSwap(player, car); break;
+	case VCMOD_CREW_ABOARD:		VCModCrewTickAboard(player, car); break;
+	case VCMOD_CREW_ESCORT:		VCModCrewTickEscort(player, car); break;
+	case VCMOD_CREW_DISMISS_WAIT:	VCModCrewTickDismissWait(player, car); break;
+	default:			break;
+	}
+	VCModCrewTelemetry(player, car);
+}
