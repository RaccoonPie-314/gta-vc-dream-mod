+
+// The cop a crew member should fight: the player or one of the squad. A cop on
+// foot beats one sitting in a car — `KillCharOnFootArmed` sends the attacker to
+// the target car's door to pull him out when the target is mounted
+// (PedAI.cpp:6510), which reads as an endless enter/leave at the stand. `other`
+// is the man the other crew member already has, so the two spread across the
+// police instead of stacking on one target.
+static CPed *
+VCModChaseCopTarget(CPed *from, CPed *other)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (from == nil)
+		return player;
+	// keep the man he is already shooting at unless he is dead, mounted, or out
+	// of range, so the objective does not flip between two equally close cops
+	CPed *current = from->m_pedInObjective;
+	if (current != nil && current != other && !current->DyingOrDead() && !current->bInVehicle &&
+	    (current->GetPosition() - from->GetPosition()).Magnitude2D() < 15.0f)
+		return current;
+
+	CPed *best = nil;
+	float bestScore = 1.0e6f;
+	for (int32 i = -1; i < nVCModChaseSquadCount; i++) {
+		CPed *cop = i < 0 ? (CPed*)player : VCModChaseSquadPed(i);
+		if (cop == nil || cop->DyingOrDead())
+			continue;
+		// mounted cops are a last resort; the other man's target only if alone
+		float score = (cop->GetPosition() - from->GetPosition()).Magnitude2D();
+		if (cop->bInVehicle)
+			score += 1000.0f;
+		if (cop == other)
+			score += 500.0f;
+		if (score < bestScore) {
+			bestScore = score;
+			best = cop;
+		}
+	}
+	return best;
+}
+
+// The patrol tier is the teaching run: the leader works alone, every higher
+// tier brings the partner he picks up later, and the heavy tiers bring a crew.
+static int32
+VCModChaseCrewSize(int32 tier)
+{
+	int32 active = 0;
+	VCModChasePoolForTier(tier, 0, 0, &active, 0);
+	return active + 1;	// the leader rides with them
+}
+
+// Drop the squad the handles point at. The air team exists from the moment the
+// call goes out, so a ground pick has to clear it before the car team is made.
+static void
+VCModChaseClearSquad(void)
+{
+	for (int32 i = 0; i < VCMOD_CHASE_SQUAD_MAX; i++) {
+		if (nVCModChaseSquadHandle[i] < 0)
+			continue;
+		CPed *ped = CPools::GetPedPool()->GetAt(nVCModChaseSquadHandle[i]);
+		VCModChaseRemovePed(ped);
+		nVCModChaseSquadHandle[i] = -1;
+	}
+	for (int32 i = 0; i < nVCModChaseBackupCars; i++)
+		VCModChaseRemoveVehicle(pVCModChaseBackupCar[i]);
+	nVCModChaseBackupCars = 0;
+	nVCModChaseSquadCount = 0;
+	nVCModChaseSquadReserve = 0;
+	nVCModChaseSquadLostAt = 0;
+	bVCModChaseSquadSpent = false;
+}
+
+static int16
+VCModChaseTransportModel(eVCModChaseUnit unit)
+{
+	switch (unit) {
+	case VCMOD_UNIT_COP: return MI_POLICE;
+	case VCMOD_UNIT_SWAT: return MI_ENFORCER;
+	case VCMOD_UNIT_VICE: return MI_CHEETAH;
+	case VCMOD_UNIT_FBI: return MI_FBIRANCH;
+	case VCMOD_UNIT_ARMY: return MI_BARRACKS;
+	default: return MI_ENFORCER;
+	}
+}
+
+static void
+VCModChaseSpawnSquad(void)
+{
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	int16 pedModel = unit == VCMOD_UNIT_VICE ? VCModChaseViceModel(nVCModChaseVariant)
+	                                         : VCModChaseUnitModel(unit);
+	int16 carModel = VCModChaseTransportModel(unit);
+	CStreaming::RequestModel(pedModel, 0);
+	CStreaming::RequestModel(carModel, 0);
+	VCModChaseRequestCopWeapon(unit);
+	CStreaming::LoadAllRequestedModels(false);
+
+	if (CStreaming::HasModelLoaded(carModel)) {
+		int32 node = ThePaths.FindNodeClosestToCoors(vecVCModChaseSquadDoor, PATH_CAR, 60.0f, true, true);
+		CVector at = node >= 0 ? ThePaths.m_pathNodes[node].GetPosition() : vecVCModChaseStation;
+		pVCModChaseSquadCar = VCModChaseSpawnMissionCar(carModel, at);
+	}
+	if (pVCModChaseSquadCar == nil || !CStreaming::HasModelLoaded(pedModel))
+		return;
+
+	// the response scales with the crew and the tier, so a heavy chase fills
+	// every seat while a patrol call rides as a pair; seats include the wheel
+	int32 seats = pVCModChaseSquadCar->m_nNumMaxPassengers + 1;
+	if (seats > VCMOD_CHASE_SQUAD_MAX + 1)
+		seats = VCMOD_CHASE_SQUAD_MAX + 1;
+	// the vice car is a two seater, so that tier always rides as a pair
+	if (unit == VCMOD_UNIT_VICE && seats > 2)
+		seats = 2;
+	// the job's own weight can pull in more than the picked unit would
+	int32 threat = VCModChaseThreat(nVCModChaseTier, VCModChaseCrimeThreat(nVCModChaseCrime));
+	int32 want = VCModChaseSquadForThreat(threat, VCModChaseCrewSize(nVCModChaseTier), seats, true);
+
+	// The team starts at the captured HQ door and runs out to the car together;
+	// the player runs with them instead of being followed.
+	CVector home = vecVCModChaseSquadDoor;
+	CVector dir = pVCModChaseSquadCar->GetPosition() - home;
+	dir.z = 0.0f;
+	if (dir.Magnitude2D() < 1.0f)
+		dir = pVCModChaseSquadCar->GetForward();
+	dir.Normalise2D();
+	CVector side(-dir.y, dir.x, 0.0f);
+
+	int32 made = 0;
+	for (int32 i = 0; i < want; i++) {
+		CVector at = home + side * ((i - (want - 1) * 0.5f) * 1.4f);
+		CPed *ped = CPopulation::AddPed(PEDTYPE_COP, VCModChaseCopType(unit), at,
+			unit == VCMOD_UNIT_VICE ? nVCModChaseVariant : 0);
+		if (ped == nil)
+			continue;
+		ped->CharCreatedBy = MISSION_CHAR;
+		ped->bIsPlayerFriend = true;
+		// the player taking the wheel must not empty the car of his own squad
+		ped->bStayInCarOnJack = true;
+		ped->SetObjective(OBJECTIVE_RUN_TO_AREA, pVCModChaseSquadCar->GetPosition());
+		nVCModChaseSquadHandle[made++] = CPools::GetPedPool()->GetIndex(ped);
+	}
+	nVCModChaseSquadCount = made;
+	// the men behind the ones who ride; the pool refills a loss from here
+	int32 poolActive = 0, poolReserve = 0;
+	VCModChasePoolForTier(nVCModChaseTier, &poolActive, &poolReserve, 0, 0);
+	nVCModChaseSquadReserve = poolReserve;
+	nVCModChaseSquadLostAt = 0;
+	bVCModChaseBoarding = made > 0;
+	nVCModChaseBoardUntil = CTimer::GetTimeInMilliseconds() + 30000;
+	fprintf(stderr, "VCMOD CHASE squad car %p seats %d crew %d reserve %d home %.1f %.1f %.1f\n",
+		(void*)pVCModChaseSquadCar, seats, made, poolReserve, home.x, home.y, home.z);
+}
+
+// One frame of the station boarding. The player drives his own transport now;
+// every squad man runs to it and rides passenger, and nobody takes the wheel, so
+// there is no AI driver to chase with. The team holds at the kerb until the
+// whole squad and the player are seated.
+static void
+VCModChaseTickBoarding(CPlayerPed *player)
+{
+	if (!bVCModChaseBoarding)
+		return;
+	CVehicle *car = pVCModChaseSquadCar;
+	if (car == nil) {
+		bVCModChaseBoarding = false;
+		return;
+	}
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	// m_pMyVehicle is set while a ped is still walking to the door; only
+	// bInVehicle means he is actually seated
+	bool playerAboard = player->bInVehicle && player->m_pMyVehicle == car;
+
+	int32 alive = 0;
+	int32 seated = 0;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead())
+			continue;
+		alive++;
+		if (ped->bInVehicle && ped->m_pMyVehicle == car) {
+			seated++;
+			continue;
+		}
+		if (ped->m_pMyVehicle != nil)
+			continue;	// walking to or climbing into a car already
+		if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER)
+			continue;
+		if ((ped->GetPosition() - car->GetPosition()).Magnitude2D() > 4.0f) {
+			// the run target was the spot the car was parked at; keep the men
+			// running at the car if it has been nudged or moved
+			if (now >= nVCModChaseBoardRetargetAt)
+				ped->SetObjective(OBJECTIVE_RUN_TO_AREA, car->GetPosition());
+			continue;
+		}
+		ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+	}
+	if (now >= nVCModChaseBoardRetargetAt)
+		nVCModChaseBoardRetargetAt = now + 1000;
+
+	if (!playerAboard || (seated < alive && now < nVCModChaseBoardUntil))
+		return;
+
+	bVCModChaseBoarding = false;
+	fprintf(stderr, "VCMOD CHASE board done driver %s seated %d alive %d\n",
+		car->pDriver == player ? "player" : "none", seated, alive);
+	if (car->pDriver == player)
+		VCModChaseNotice("chase: you have the wheel, follow him");
+}
+
+// ---- Force pools (design 6.7) --------------------------------------------
+//
+// Both sides have a finite reserve behind the men who are here now. A loss
+// queues one replacement after the refill delay; it spawns on a road node
+// 80-120 m out, out of the player's sight, and drives in, so nobody appears in
+// the middle of the fight. The cars the crew and the reserves arrive in then
+// follow the car being chased until it stops, and the men get out and fight.
+
+static CPed *VCModChaseCriminalTarget(CPed *from);
+
+// A road node 80-120 m from `near` and out of the player's sight. The second
+// pass takes any node on that ring, so a spawn is never lost to a crowded view.
+static bool
+VCModChaseBackupSpot(CVector near, CVector *out)
+{
+	CPlayerPed *player = FindPlayerPed();
+	CVector eye = player != nil ? player->GetPosition() : near;
+	for (int32 pass = 0; pass < 2; pass++) {
+		for (int32 tries = 0; tries < 32; tries++) {
+			float angle = CGeneral::GetRandomNumberInRange(0.0f, 2.0f * PI);
+			float radius = CGeneral::GetRandomNumberInRange(VCMOD_CHASE_BACKUP_NEAR, VCMOD_CHASE_BACKUP_FAR);
+			CVector probe = near + CVector(cos(angle) * radius, sin(angle) * radius, 0.0f);
+			int32 node = ThePaths.FindNodeClosestToCoors(probe, PATH_CAR, VCMOD_CHASE_BACKUP_NODE, true, true);
+			if (node < 0)
+				continue;
+			CVector np = ThePaths.m_pathNodes[node].GetPosition();
+			if (ThePaths.m_pathNodes[node].bWaterPath || VCModChaseInWater(np) || VCModChaseBridge(np))
+				continue;
+			float dist = (np - near).Magnitude2D();
+			if (dist < VCMOD_CHASE_BACKUP_NEAR || dist > VCMOD_CHASE_BACKUP_FAR + 20.0f)
+				continue;
+			if (pass == 0 &&
+			    CWorld::GetIsLineOfSightClear(eye, np, true, false, false, false, true, false, false))
+				continue;
+			*out = np;
+			return true;
+		}
+	}
+	return false;
+}
+
+// The crew's own ride for the tiers whose crew is bigger than the leader's car.
+static int16
+VCModChaseCrewCarModel(int32 tier)
+{
+	switch (tier) {
+	case 2: return MI_SENTINEL;	// the pickup's reserve comes in a plain sedan
+	case 3: return MI_STINGER;	// vice runs fast cars
+	case 4: return MI_SENTINEL;	// fbi crew comes in a plain cruiser
+	case 5: return MI_PATRIOT;	// army brings a convoy truck
+	default: return -1;
+	}
+}
+
+static void
+VCModChasePoolNotice(void)
+{
+	char text[96];
+	snprintf(text, sizeof(text), "chase: %d squad in reserve, %d crew in reserve",
+		nVCModChaseSquadReserve, nVCModChaseCrewReserve);
+	VCModChaseNotice(text);
+}
+
+// One replacement for a dead squad slot: a man at the wheel of a transport car
+// on a road node behind the player, driving in.
+static bool
+VCModChaseSpawnSquadBackup(CPlayerPed *player)
+{
+	if (player == nil || nVCModChaseSquadReserve <= 0)
+		return false;
+	int32 slot = -1;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead()) {
+			slot = i;
+			break;
+		}
+	}
+	if (slot < 0)
+		return false;
+
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	int16 pedModel = unit == VCMOD_UNIT_VICE ? VCModChaseViceModel(nVCModChaseVariant)
+	                                         : VCModChaseUnitModel(unit);
+	int16 carModel = VCModChaseTransportModel(unit);
+	CStreaming::RequestModel(pedModel, 0);
+	CStreaming::RequestModel(carModel, 0);
+	VCModChaseRequestCopWeapon(unit);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(pedModel))
+		return false;
+
+	CVector at;
+	if (!VCModChaseBackupSpot(player->GetPosition(), &at))
+		return false;
+	CVehicle *car = VCModChaseSpawnMissionCar(carModel, at);
+	if (car == nil)
+		return false;
+
+	CPed *ped = CPopulation::AddPed(PEDTYPE_COP, VCModChaseCopType(unit), at,
+		unit == VCMOD_UNIT_VICE ? nVCModChaseVariant : 0);
+	if (ped == nil) {
+		VCModChaseRemoveVehicle(car);
+		return false;
+	}
+	ped->CharCreatedBy = MISSION_CHAR;
+	ped->bIsPlayerFriend = true;
+	ped->bStayInCarOnJack = true;
+	ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+	ped->WarpPedIntoCar(car);
+	// stock pursuit: the car hunts the criminal's car and rams it, the way a
+	// wanted-response cruiser hunts the player
+	VCModChasePursueCar(car, pVCModChaseLeaderCar, player->GetPosition());
+
+	nVCModChaseSquadHandle[slot] = CPools::GetPedPool()->GetIndex(ped);
+	if (nVCModChaseBackupCars < VCMOD_CHASE_SQUAD_MAX)
+		pVCModChaseBackupCar[nVCModChaseBackupCars++] = car;
+	nVCModChaseSquadReserve--;
+	fprintf(stderr, "VCMOD CHASE squad backup slot %d at %.1f %.1f reserve %d\n",
+		slot, at.x, at.y, nVCModChaseSquadReserve);
+	return true;
+}
+
+// Put up to `count` empty crew slots from `first` into one arrival car; the
+// first man drives. Returns how many were placed.
+static int32
+VCModChaseCrewCarry(int32 first, int32 count, bool fromReserve)
+{
+	if (pVCModChaseLeaderCar == nil || count <= 0 || nVCModChaseCrewCars >= VCMOD_CHASE_CREW_MAX)
+		return 0;
+	int16 carModel = VCModChaseCrewCarModel(nVCModChaseTier);
+	if (carModel < 0)
+		return 0;
+	CStreaming::RequestModel(VCMOD_CHASE_ACCOMPLICE_MODEL, 0);
+	CStreaming::RequestModel(CWeaponInfo::GetWeaponInfo(WEAPONTYPE_UZI)->m_nModelId, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_ACCOMPLICE_MODEL))
+		return 0;
+
+	CVector at;
+	if (!VCModChaseBackupSpot(pVCModChaseLeaderCar->GetPosition(), &at))
+		return 0;
+	CVehicle *car = VCModChaseSpawnMissionCar(carModel, at);
+	if (car == nil)
+		return 0;
+
+	int32 seats = car->m_nNumMaxPassengers + 1;
+	int32 made = 0;
+	for (int32 i = first; i < nVCModChaseCrewCap && made < seats && count > 0; i++) {
+		if (!VCModChaseCrewSlotFree(i))
+			continue;
+		CPed *ped = CPopulation::AddPed(PEDTYPE_CIVMALE, VCMOD_CHASE_ACCOMPLICE_MODEL, car->GetPosition());
+		if (ped == nil)
+			continue;
+		ped->CharCreatedBy = MISSION_CHAR;
+		ped->bIsPlayerFriend = false;
+		ped->m_fHealth = VCMOD_CHASE_CREW_HEALTH;
+		ped->GiveWeapon(WEAPONTYPE_UZI, 1000);
+		ped->SetCurrentWeapon(WEAPONTYPE_UZI);
+		// the first man takes the wheel; the rest ride
+		if (made == 0) {
+			ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, car);
+			ped->WarpPedIntoCar(car);
+		} else {
+			ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, car);
+			ped->WarpPedIntoCar(car);
+		}
+		nVCModChaseCrewHandle[i] = CPools::GetPedPool()->GetIndex(ped);
+		made++;
+		count--;
+		if (fromReserve && nVCModChaseCrewReserve > 0)
+			nVCModChaseCrewReserve--;
+	}
+	if (made == 0) {
+		VCModChaseRemoveVehicle(car);
+		return 0;
+	}
+	pVCModChaseCrewCar[nVCModChaseCrewCars++] = car;
+	// the crew hunts the player the same way the police hunt him
+	CPlayerPed *player = FindPlayerPed();
+	CVehicle *playerVeh = player != nil && player->bInVehicle ? player->m_pMyVehicle : nil;
+	VCModChasePursueCar(car, playerVeh, player != nil ? player->GetPosition()
+	                                                  : pVCModChaseLeaderCar->GetPosition());
+	fprintf(stderr, "VCMOD CHASE crew car %p carrying %d at %.1f %.1f reserve %d\n",
+		(void*)car, made, at.x, at.y, nVCModChaseCrewReserve);
+	return made;
+}
+
+// Stop an arrival car for good and put every man in it on foot, with the fight
+// order in the same frame as LEAVE_CAR: an exit restores the boarding order
+// stored before it, so a later kill order would only be stashed (PedAI.cpp:242).
+static void
+VCModChaseBailOut(CVehicle *car, bool crew)
+{
+	if (car == nil)
+		return;
+	car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	car->AutoPilot.m_nCruiseSpeed = 0;
+	car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+
+	CPed *men[5];
+	int32 count = 0;
+	if (car->pDriver != nil)
+		men[count++] = car->pDriver;
+	for (int32 i = 0; i < 4 && count < 5; i++)
+		if (car->pPassengers[i] != nil)
+			men[count++] = car->pPassengers[i];
+
+	bool bailed = false;
+	for (int32 i = 0; i < count; i++) {
+		CPed *ped = men[i];
+		if (ped->DyingOrDead() || !ped->bInVehicle)
+			continue;
+		CPed *target = crew ? VCModChaseCopTarget(ped, nil) : VCModChaseCriminalTarget(ped);
+		if (target == nil)
+			continue;
+		if (ped->m_objective != OBJECTIVE_LEAVE_CAR)
+			ped->SetObjective(OBJECTIVE_LEAVE_CAR, car);
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, target);
+		bailed = true;
+	}
+	if (bailed)
+		fprintf(stderr, "VCMOD CHASE %s out at %.1f %.1f\n",
+			crew ? "crew" : "squad backup", car->GetPosition().x, car->GetPosition().y);
+}
+
+// One frame of both pools: losses, the refill timers, the arrival cars' driving
+// and their dismount. Runs from the mission update, before the leader tick.
+static void
+VCModChaseTickPools(CPlayerPed *player)
+{
+	if (pVCModChaseLeaderCar == nil)
+		return;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	CVehicle *target = pVCModChaseLeaderCar;
+
+	int32 squadAlive = VCModChaseSquadAlive();
+	if (nVCModChaseSquadCount > 0) {
+		if (nVCModChaseSquadReserve > 0) {
+			if (squadAlive >= nVCModChaseSquadCount) {
+				nVCModChaseSquadLostAt = 0;
+			} else if (nVCModChaseSquadLostAt == 0) {
+				nVCModChaseSquadLostAt = now;
+				fprintf(stderr, "VCMOD CHASE squad loss %d/%d reserve %d\n",
+					squadAlive, nVCModChaseSquadCount, nVCModChaseSquadReserve);
+			} else if (VCModChaseReplaceDue(squadAlive, nVCModChaseSquadCount, nVCModChaseSquadReserve,
+			                               nVCModChaseSquadLostAt, VCMOD_CHASE_SQUAD_REPLACE, now)) {
+				nVCModChaseSquadLostAt = 0;
+				if (VCModChaseSpawnSquadBackup(player))
+					VCModChasePoolNotice();
+			}
+		} else if (squadAlive < nVCModChaseSquadCount && !bVCModChaseSquadSpent) {
+			bVCModChaseSquadSpent = true;
+			VCModChaseNotice("chase: the squad has no reserves left");
+		}
+	}
+
+	if (nVCModChaseCrewCap > 0 && bVCModChaseCrewOut) {
+		int32 crewAlive = VCModChaseCrewAlive();
+		if (nVCModChaseCrewReserve > 0) {
+			if (crewAlive >= nVCModChaseCrewCap) {
+				nVCModChaseCrewLostAt = 0;
+			} else if (nVCModChaseCrewLostAt == 0) {
+				nVCModChaseCrewLostAt = now;
+				fprintf(stderr, "VCMOD CHASE crew loss %d/%d reserve %d\n",
+					crewAlive, nVCModChaseCrewCap, nVCModChaseCrewReserve);
+			} else if (VCModChaseReplaceDue(crewAlive, nVCModChaseCrewCap, nVCModChaseCrewReserve,
+			                                nVCModChaseCrewLostAt, VCMOD_CHASE_CREW_REPLACE, now)) {
+				nVCModChaseCrewLostAt = 0;
+				if (VCModChaseCrewCarry(0, 1, true) > 0)
+					VCModChasePoolNotice();
+			}
+		} else if (crewAlive < nVCModChaseCrewCap && !bVCModChaseCrewSpent) {
+			bVCModChaseCrewSpent = true;
+			VCModChaseNotice("chase: the crew has no reserves left");
+		}
+	}
+
+	// the arrival cars hunt until the fight stops, then bail out
+	bool retarget = now >= nVCModChaseBackupAt;
+	if (retarget)
+		nVCModChaseBackupAt = now + VCMOD_CHASE_BACKUP_RETARGET;
+	CVehicle *playerVeh = player != nil && player->bInVehicle ? player->m_pMyVehicle : nil;
+	CVector playerPos = player != nil ? player->GetPosition() : target->GetPosition();
+	bool playerStill = playerVeh == nil ||
+	                   playerVeh->GetMoveSpeed().Magnitude2D() < VCMOD_CHASE_STILL_SPEED;
+
+	for (int32 i = 0; i < nVCModChaseCrewCars; i++) {
+		CVehicle *car = pVCModChaseCrewCar[i];
+		if (car == nil)
+			continue;
+		float gap = playerVeh != nil ? (car->GetPosition() - playerVeh->GetPosition()).Magnitude2D()
+		                             : (car->GetPosition() - playerPos).Magnitude2D();
+		if (bVCModChaseCornered || (gap < VCMOD_CHASE_BACKUP_JOIN && playerStill))
+			VCModChaseBailOut(car, true);
+		else if (retarget)
+			VCModChasePursueCar(car, playerVeh, playerPos);
+	}
+
+	float targetSpeed = target->GetMoveSpeed().Magnitude2D();
+	for (int32 i = 0; i < nVCModChaseBackupCars; i++) {
+		CVehicle *car = pVCModChaseBackupCar[i];
+		if (car == nil)
+			continue;
+		CPed *ped = car->pDriver;
+		if (ped == nil) {
+			// the driver died inside the car; park it rather than let it roll
+			car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+			car->AutoPilot.m_nCruiseSpeed = 0;
+			continue;
+		}
+		if (!(ped->bInVehicle && ped->m_pMyVehicle == car))
+			continue;	// he is out and fighting, the car stays for cleanup
+		float gap = (car->GetPosition() - target->GetPosition()).Magnitude2D();
+		// in contact, or close to a chase that has stopped: stock cops get out
+		// and shoot once their car has pulled up on the target
+		bool close = gap < 15.0f ||
+		             (gap < VCMOD_CHASE_BACKUP_JOIN && targetSpeed < VCMOD_CHASE_STILL_SPEED);
+		if (bVCModChaseCornered || close)
+			VCModChaseBailOut(car, false);
+		else if (retarget)
+			VCModChasePursueCar(car, target, target->GetPosition());
+	}
+}
+
+// ---- Air insertion -------------------------------------------------------
+//
+// The heli is a CAutomobile, not the AI CHeli: only a real heli has seats and
+// an AI pilot. The air start is a pursuit, not a delivery. The team climbs in,
+// the pilot chases the fleeing criminal, and the heli guns his car until it is
+// wrecked and he bails out; only then does the team rope down and finish him
+// on foot. MISSION_HELI_FLYTOCOORS makes the car skip ordinary physics and
+// translate itself toward the destination, so the pilot never has to touch the
+// pad, and FlyingControl returns early for a non-player car.
+
+static CPed *
+VCModChasePilot(void)
+{
+	return nVCModChasePilotHandle >= 0 ? CPools::GetPedPool()->GetAt(nVCModChasePilotHandle) : nil;
+}
+
+static int16
+VCModChaseTierPedModel(void)
+{
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	return unit == VCMOD_UNIT_VICE ? VCModChaseViceModel(nVCModChaseVariant)
+	                               : VCModChaseUnitModel(unit);
+}
+
+// Three ropes under the heli's belly, spread across its width; slot 0 is the
+// player's.
+static CVector
+VCModChaseRopeTop(int32 slot)
+{
+	if (pVCModChaseHeli == nil)
+		return vecVCModChaseAirSpot;
+	CVector local((float)(slot - 1) * 2.4f, -1.0f, -VCMOD_CHASE_ROPE_TOP);
+	return pVCModChaseHeli->GetMatrix() * local;
+}
+
+// The AI autopilot rebuilds the hull basis every frame from the residual move
+// speed (up = normalise(3*speed.x, 3*speed.y, 1)), and it keeps nudging the
+// heading while it settles on the station. A hull that is only held in place
+// therefore still rocks and turns, and the men hang off that hull, so the ropes
+// swing under them. Capture an upright basis once the hull is on station and put
+// it back after the autopilot has run: the descent line is then fixed.
+static void
+VCModChaseCaptureHeliHeading(void)
+{
+	CVector fwd = pVCModChaseHeli->GetForward();
+	fwd.z = 0.0f;
+	if (fwd.MagnitudeSqr() < 0.0001f)
+		fwd = CVector(0.0f, 1.0f, 0.0f);
+	fwd.Normalise();
+	CVector right = pVCModChaseHeli->GetRight();
+	right.z = 0.0f;
+	right -= fwd * DotProduct(right, fwd);
+	if (right.MagnitudeSqr() < 0.0001f)
+		right = CrossProduct(CVector(0.0f, 0.0f, 1.0f), fwd);
+	right.Normalise();
+	vecVCModChaseHeliFwd = fwd;
+	vecVCModChaseHeliRight = right;
+}
+
+// Called from the tick, after CWorld::Process has already run the autopilot.
+static void
+VCModChasePinHeli(void)
+{
+	CAutomobile *heli = pVCModChaseHeli;
+	if (heli == nil)
+		return;
+	heli->SetPosition(vecVCModChaseHeliHold);
+	heli->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+	heli->m_vecTurnSpeed = CVector(0.0f, 0.0f, 0.0f);
+	heli->GetMatrix().GetRight() = vecVCModChaseHeliRight;
+	heli->GetMatrix().GetForward() = vecVCModChaseHeliFwd;
+	heli->GetMatrix().GetUp() = CVector(0.0f, 0.0f, 1.0f);
+	heli->GetMatrix().UpdateRW();
+}
+
+// The stock descent leaves the rope registered while the SWAT is on it and
+// stops re-registering on release; the top node then falls and the pool frees
+// the slot. Pushing the top down makes that happen before the next mission.
+static void
+VCModChaseReleaseRopes(void)
+{
+	for (int32 i = 0; i < 3; i++) {
+		CRopes::SetSpeedOfTopNode(nVCModChaseRopeId[i], CVector(0.0f, 0.0f, -0.6f));
+		CRopes::SetSpeedOfTopNode(nVCModChaseRopeDropId[i], CVector(0.0f, 0.0f, -0.6f));
+	}
+}
+
+static void
+VCModChaseSitInCar(CPed *ped)
+{
+	CAnimManager::BlendAnimation(ped->GetClump(), ASSOCGRP_STD, ANIM_STD_CAR_SIT, 100.0f);
+}
+
+// Hold one ped on his rope at parameter t (0 top, 1 bottom). The position is
+// the straight line the rope hangs on, not the simulated chain: the top is the
+// pinned hull, so the climb and the descent are the same scripted move and a
+// forming chain can never drag the man sideways. The abseil clip runs top to
+// bottom, so its time follows t in both directions: climbing walks the clock
+// backwards, descending walks it forwards, and no engine change to the
+// animation code is needed.
+static void
+VCModChaseHoldRope(CPed *ped, int32 slot, float t)
+{
+	if (ped == nil || ped->DyingOrDead())
+		return;
+	CVector pos = VCModChaseRopeTop(slot);
+	pos.z -= t * VCMOD_CHASE_ROPE_SPAN;
+	ped->SetPosition(pos);
+	ped->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+	ped->m_vecTurnSpeed = CVector(0.0f, 0.0f, 0.0f);
+	ped->bUsesCollision = false;
+	if (ped->m_nPedState != PED_ABSEIL)
+		ped->SetPedState(PED_ABSEIL);
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_ABSEIL);
+	if (assoc == nil)
+		assoc = CAnimManager::BlendAnimation(ped->GetClump(), ASSOCGRP_STD, ANIM_STD_ABSEIL, 4.0f);
+	if (assoc != nil && assoc->hierarchy != nil) {
+		assoc->speed = 0.0f;
+		assoc->SetCurrentTime(assoc->hierarchy->totalLength * t);
+	}
+}
+
+// Step off the rope: the last metre is a fall, the same way the stock descent
+// releases a SWAT man.
+static void
+VCModChaseDropOffRope(CPed *ped)
+{
+	if (ped == nil)
+		return;
+	ped->bUsesCollision = true;
+	ped->bIsInTheAir = false;
+	ped->SetPedState(PED_IDLE);
+	ped->SetInTheAir();
+	ped->bKnockedUpIntoAir = true;
+}
+
+// The player is not an AI body: the stock knock-up-into-air release leaves him
+// falling the last couple of metres and then in a get-up animation, which is the
+// second of no control after the ropes. Put him down on his feet at ground level
+// so he is free the moment the rappel ends.
+static void
+VCModChaseLandPlayer(CPlayerPed *player)
+{
+	if (player == nil)
+		return;
+	CVector pos = player->GetPosition();
+	CPedPlacement::FindZCoorForPed(&pos);
+	player->SetPosition(pos);
+	player->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+	player->m_vecTurnSpeed = CVector(0.0f, 0.0f, 0.0f);
+	player->bUsesCollision = true;
+	player->bIsInTheAir = false;
+	player->bKnockedUpIntoAir = false;
+	player->SetPedState(PED_IDLE);
+}
+
+// Leave a seat without the door animation: the team goes over the side. The
+// stale seat and objective references are cleared here, or the boarding tick
+// would send a man back to the heli he just left.
+static void
+VCModChaseEjectPed(CPed *ped)
+{
+	if (ped == nil)
+		return;
+	CVehicle *veh = ped->m_pMyVehicle;
+	if (veh != nil) {
+		if (veh->pDriver == ped)
+			veh->pDriver = nil;
+		for (int32 i = 0; i < 4; i++)
+			if (veh->pPassengers[i] == ped)
+				veh->pPassengers[i] = nil;
+	}
+	ped->m_pMyVehicle = nil;
+	ped->m_carInObjective = nil;
+	ped->bInVehicle = false;
+	ped->bVehExitWillBeInstant = false;
+	ped->ClearObjective();
+	ped->SetPedState(PED_IDLE);
+}
+
+static bool
+VCModChaseSpawnHeli(void)
+{
+	// the army start flies the Hunter; every other tier the police Maverick
+	int16 heliModel = nVCModChaseTier >= 5 ? MI_HUNTER : VCMOD_CHASE_HELI_MODEL;
+	int16 pedModel = VCModChaseTierPedModel();
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	CStreaming::RequestModel(heliModel, 0);
+	CStreaming::RequestModel(pedModel, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(heliModel) ||
+	    !CStreaming::HasModelLoaded(pedModel))
+		return false;
+
+	CAutomobile *heli = new CAutomobile(heliModel, RANDOM_VEHICLE);
+	if (heli == nil)
+		return false;
+	heli->m_nDoorLock = CARLOCK_UNLOCKED;
+	CVector pos = vecVCModChaseAirSpot;
+	pos.z += VCMOD_CHASE_HELI_HOVER;
+	heli->SetPosition(pos);
+	heli->SetStatus(STATUS_PHYSICS);
+	heli->bEngineOn = true;
+	heli->m_fHealth = VCMOD_CHASE_HELI_HEALTH;
+	// The AI chopper never takes the world collision pass: CHeli::ProcessControl
+	// ends with RemoveAndAdd() and bIsInSafePosition = true. A CAutomobile on
+	// MISSION_HELI_FLYTOCOORS does the opposite (the skip block sets the flag
+	// false), so the world resolves it against buildings every frame and a 50 m/s
+	// impact destroys the hull with the team aboard. Flying through the world is
+	// the stock heli's behaviour, and it also keeps our own line of sight and our
+	// gun's rounds from starting inside the hull.
+	heli->bUsesCollision = false;
+	heli->m_aWheelSpeed[1] = 0.22f;	// rotors already turning
+	heli->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	// retail heli door data undercounts the cabin; the mission needs the pilot
+	// plus the boarding party, and CPed::pPassengers has room for it
+	int32 stockSeats = heli->m_nNumMaxPassengers;
+	if (heli->m_nNumMaxPassengers < VCMOD_CHASE_AIR_SEATS - 1)
+		heli->m_nNumMaxPassengers = VCMOD_CHASE_AIR_SEATS - 1;
+	CWorld::Add(heli);
+	heli->TellHeliToGoToCoors(pos.x, pos.y, pos.z, 0);
+
+	CPed *pilot = CPopulation::AddPed(PEDTYPE_COP, VCModChaseCopType(unit), pos,
+		unit == VCMOD_UNIT_VICE ? nVCModChaseVariant : 0);
+	if (pilot != nil) {
+		pilot->CharCreatedBy = MISSION_CHAR;
+		pilot->bIsPlayerFriend = true;
+		pilot->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, heli);
+		pilot->WarpPedIntoCar(heli);
+		nVCModChasePilotHandle = CPools::GetPedPool()->GetIndex(pilot);
+	}
+	pVCModChaseHeli = heli;
+	vecVCModChaseHeliHold = pos;
+	fprintf(stderr, "VCMOD CHASE heli %p model %d retail seats %d seats %d pilot %p at %.1f %.1f %.1f\n",
+		(void*)heli, heliModel, stockSeats, heli->m_nNumMaxPassengers, (void*)pilot, pos.x, pos.y, pos.z);
+	return true;
+}
+
+static void
+VCModChaseRemoveHeli(void)
+{
+	if (nVCModChasePilotHandle >= 0) {
+		CPed *pilot = VCModChasePilot();
+		if (pilot != nil && pVCModChaseHeli != nil && pilot->m_pMyVehicle == pVCModChaseHeli) {
+			pilot->m_pMyVehicle = nil;
+			pilot->bInVehicle = false;
+		}
+		VCModChaseRemovePed(pilot);
+		nVCModChasePilotHandle = -1;
+	}
+	CVehicle *heli = pVCModChaseHeli;
+	VCModChaseRemoveVehicle(heli);
+	pVCModChaseHeli = nil;
+}
+
+static void
+VCModChaseSpawnAirSquad(void)
+{
+	int16 pedModel = VCModChaseTierPedModel();
+	eVCModChaseUnit unit = VCModChaseUnitForTier(nVCModChaseTier);
+	CStreaming::RequestModel(pedModel, 0);
+	VCModChaseRequestCopWeapon(unit);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(pedModel))
+		return;
+
+	CVector dir = vecVCModChaseAirSpot - vecVCModChaseSquadDoor;
+	dir.z = 0.0f;
+	if (dir.Magnitude2D() < 1.0f)
+		dir = CVector(1.0f, 0.0f, 0.0f);
+	dir.Normalise2D();
+	CVector side(-dir.y, dir.x, 0.0f);
+
+	int32 want = VCModChaseAirSquad(nVCModChaseTier);
+	int32 made = 0;
+	for (int32 i = 0; i < want; i++) {
+		CVector spot = vecVCModChaseAirSpot + side * ((i - (want - 1) * 0.5f) * 1.6f);
+		// they come out of the HQ and run to their rope instead of appearing
+		// under it; the climb waits for them in VCMOD_AIR_RALLY
+		CVector at = vecVCModChaseSquadDoor + side * ((i - (want - 1) * 0.5f) * 1.4f);
+		CPed *ped = CPopulation::AddPed(PEDTYPE_COP, VCModChaseCopType(unit), at,
+			unit == VCMOD_UNIT_VICE ? nVCModChaseVariant : 0);
+		if (ped == nil)
+			continue;
+		ped->CharCreatedBy = MISSION_CHAR;
+		ped->bIsPlayerFriend = true;
+		ped->bStayInCarOnJack = true;
+		ped->SetObjective(OBJECTIVE_RUN_TO_AREA, spot);
+		vecVCModChaseRallySpot[made] = spot;
+		nVCModChaseSquadHandle[made++] = CPools::GetPedPool()->GetIndex(ped);
+	}
+	nVCModChaseSquadCount = made;
+	int32 poolActive = 0, poolReserve = 0;
+	VCModChasePoolForTier(nVCModChaseTier, &poolActive, &poolReserve, 0, 0);
+	nVCModChaseSquadReserve = poolReserve;
+	nVCModChaseSquadLostAt = 0;
+	fprintf(stderr, "VCMOD CHASE air squad %d reserve %d from %.1f %.1f running to %.1f %.1f\n",
+		made, poolReserve, vecVCModChaseSquadDoor.x, vecVCModChaseSquadDoor.y,
+		vecVCModChaseAirSpot.x, vecVCModChaseAirSpot.y);
+}
+
+// On the ground route the pickup waits for beat 2; on the air route the partner
+// rides from the start, so the car the heli guns down has both of them aboard.
+static void
+VCModChaseSpawnAirCrew(void)
+{
+	if (nVCModChaseCrewCap <= 0 || pVCModChaseLeaderCar == nil)
+		return;
+	CStreaming::RequestModel(VCMOD_CHASE_ACCOMPLICE_MODEL, 0);
+	CStreaming::RequestModel(CWeaponInfo::GetWeaponInfo(WEAPONTYPE_UZI)->m_nModelId, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_ACCOMPLICE_MODEL))
+		return;
+
+	CVector pos = pVCModChaseLeaderCar->GetPosition() + pVCModChaseLeaderCar->GetRight() * 2.0f;
+	CPed *ped = CPopulation::AddPed(PEDTYPE_CIVMALE, VCMOD_CHASE_ACCOMPLICE_MODEL, pos);
+	if (ped == nil)
+		return;
+	ped->CharCreatedBy = MISSION_CHAR;
+	ped->bIsPlayerFriend = false;
+	ped->m_fHealth = VCMOD_CHASE_CREW_HEALTH;
+	ped->GiveWeapon(WEAPONTYPE_UZI, 1000);
+	ped->SetCurrentWeapon(WEAPONTYPE_UZI);
+	ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, pVCModChaseLeaderCar);
+	ped->WarpPedIntoCar(pVCModChaseLeaderCar);
+	nVCModChaseCrewHandle[0] = CPools::GetPedPool()->GetIndex(ped);
+	bVCModChaseCrewOut = true;
+	fprintf(stderr, "VCMOD CHASE crew aboard %p\n", (void*)ped);
+}
+
+static void
+VCModChaseClearApproachBlips(void)
+{
+	for (int32 i = 0; i < 2; i++) {
+		if (nVCModChaseApproachBlip[i] >= 0) {
+			CRadar::ClearBlip(nVCModChaseApproachBlip[i]);
+			nVCModChaseApproachBlip[i] = -1;
+		}
+	}
+}
+
+// The heli waits over the nearest road node, the pair of markers chooses the
+// approach: ground next to the HQ doors, air under the helicopter.
+static void
+VCModChaseStartApproach(void)
+{
+	if (pVCModChaseHeli != nil)
+		return;
+	int32 node = ThePaths.FindNodeClosestToCoors(vecVCModChaseSquadDoor, PATH_CAR, 60.0f, true, true);
+	vecVCModChaseAirSpot = node >= 0 ? ThePaths.m_pathNodes[node].GetPosition() : vecVCModChaseSquadDoor;
+	if (!VCModChaseSpawnHeli())
+		return;
+	VCModChaseNotice("chase: blue marker for the car, yellow under the heli");
+	fprintf(stderr, "VCMOD CHASE approach markers ground %.1f %.1f %.1f air %.1f %.1f %.1f\n",
+		vecVCModChaseSquadDoor.x, vecVCModChaseSquadDoor.y, vecVCModChaseSquadDoor.z,
+		vecVCModChaseAirSpot.x, vecVCModChaseAirSpot.y, vecVCModChaseAirSpot.z);
+}
+
+static void
+VCModChaseSetPedOnRope(CPed *ped)
+{
+	ped->bUsesCollision = false;
+	ped->bIsInTheAir = false;
+	ped->SetPedState(PED_ABSEIL);
+	ped->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+}
+
+// Everyone is at the ropes: the player and his two men climb together, from the
+// bottom to the top, the way the air insertion was scripted.
+static void
+VCModChaseBeginClimb(CPlayerPed *player)
+{
+	fVCModChaseRopePos = VCMOD_CHASE_ROPE_BOTTOM;
+	VCModChaseSetPedOnRope(player);
+	nVCModChaseAir = VCMOD_AIR_CLIMB;
+	VCModChaseNotice("chase: on the ropes, climb");
+	CVector here = player->GetPosition();
+	fprintf(stderr, "VCMOD CHASE air rally done, player at %.1f %.1f %.1f\n", here.x, here.y, here.z);
+}
+
+static void
+VCModChaseTickApproach(CPlayerPed *player)
+{
+	if (nVCModChaseSetup != VCMOD_CHASE_SETUP_APPROACH || bVCModChaseApproachChosen)
+		return;
+	if (pVCModChaseHeli == nil) {
+		VCModChaseStartApproach();
+		if (pVCModChaseHeli == nil)
+			return;
+	}
+	CVector groundSpot = vecVCModChaseSquadDoor;
+	CVector airSpot = vecVCModChaseAirSpot;
+	C3dMarkers::PlaceMarkerSet(VCMOD_CHASE_GROUND_MARKER_ID, MARKERTYPE_CYLINDER, groundSpot,
+		2.0f, 80, 140, 255, 180, 1024, 0.25f, 0);
+	C3dMarkers::PlaceMarkerSet(VCMOD_CHASE_AIR_MARKER_ID, MARKERTYPE_CYLINDER, airSpot,
+		2.0f, 255, 210, 60, 180, 1024, 0.25f, 0);
+	if (nVCModChaseApproachBlip[0] < 0)
+		nVCModChaseApproachBlip[0] = CRadar::SetCoordBlip(BLIP_COORD, vecVCModChaseSquadDoor, 0, BLIP_DISPLAY_BOTH);
+	if (nVCModChaseApproachBlip[1] < 0)
+		nVCModChaseApproachBlip[1] = CRadar::SetCoordBlip(BLIP_COORD, vecVCModChaseAirSpot, 0, BLIP_DISPLAY_BOTH);
+
+	// the team is with the player from the call, not from the pick: they leave
+	// the HQ now and wait at the heli's ropes, so choosing the yellow marker is
+	// not the moment two cops appear out of nothing
+	if (nVCModChaseSquadCount == 0)
+		VCModChaseSpawnAirSquad();
+
+	// the pick has to be a deliberate walk into a marker; a player still in a
+	// car, in the air, or standing on the station marker is not choosing
+	if (player->m_pMyVehicle != nil || !player->IsPedInControl())
+		return;
+	if ((player->GetPosition() - vecVCModChaseStation).Magnitude2D() < 4.0f)
+		return;
+	float ground = (player->GetPosition() - vecVCModChaseSquadDoor).Magnitude2D();
+	float air = (player->GetPosition() - vecVCModChaseAirSpot).Magnitude2D();
+	if (ground > VCMOD_CHASE_AIR_ENTER_NEAR && air > VCMOD_CHASE_AIR_ENTER_NEAR)
+		return;
+
+	bVCModChaseApproachChosen = true;
+	VCModChaseClearApproachBlips();
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (ground <= VCMOD_CHASE_AIR_ENTER_NEAR) {
+		fprintf(stderr, "VCMOD CHASE approach ground\n");
+		VCModChaseClearSquad();	// the air team waiting at the heli is stood down
+		VCModChaseSpawnSquad();
+		VCModChaseRemoveHeli();
+		nVCModChaseSetup = VCMOD_CHASE_SETUP_READY;
+		nVCModChaseGoTime = now + VCMOD_CHASE_GO_FAILSAFE;
+		return;
+	}
+
+	fprintf(stderr, "VCMOD CHASE approach air\n");
+	if (nVCModChaseSquadCount == 0)
+		VCModChaseSpawnAirSquad();
+	if (nVCModChaseSquadCount == 0) {
+		VCModChaseNotice("chase: the air team is missing, using the car");
+		VCModChaseSpawnSquad();
+		VCModChaseRemoveHeli();
+		nVCModChaseSetup = VCMOD_CHASE_SETUP_READY;
+		nVCModChaseGoTime = now + VCMOD_CHASE_GO_FAILSAFE;
+		return;
+	}
+	VCModChaseSpawnAirCrew();
+
+	// the leg he flees along; he bolts when the roof closes, so the heli has a
+	// real chase to fly rather than a scripted drop on a parked car
+	CVector dir = vecVCModChaseLeaderSpawn - vecVCModChaseStation;
+	dir.z = 0.0f;
+	if (dir.Magnitude2D() < 1.0f)
+		dir = CVector(1.0f, 0.0f, 0.0f);
+	dir.Normalise2D();
+	int32 escape = VCModChaseRoadNode(VCMOD_CHASE_AIR_ESCAPE, &dir, true);
+	vecVCModChaseAirEscape = escape >= 0 ? ThePaths.m_pathNodes[escape].GetPosition()
+	                                     : vecVCModChaseLeaderSpawn + dir * VCMOD_CHASE_AIR_ESCAPE;
+
+	nVCModChaseAir = VCMOD_AIR_RALLY;
+	nVCModChaseAirAt = now + VCMOD_CHASE_RALLY_MAX;
+	for (int32 i = 0; i < 3; i++)
+		CRopes::RegisterRope(nVCModChaseRopeId[i], VCModChaseRopeTop(i), false);
+	VCModChaseNotice("chase: get on the ropes");
+	fprintf(stderr, "VCMOD CHASE air rally %d men, %u ms\n", nVCModChaseSquadCount, VCMOD_CHASE_RALLY_MAX);
+}
+
+// Climb done: the team rides the rest of the way. A passenger player must not
+// flip the car to STATUS_PLAYER, or the AI pilot would stop flying.
+static void
+VCModChaseSeatTeam(CPlayerPed *player)
+{
+	CAutomobile *heli = pVCModChaseHeli;
+	if (heli == nil)
+		return;
+	heli->m_nDoorLock = CARLOCK_LOCKED_PLAYER_INSIDE;	// no bailing out at altitude
+	int32 seated = 0;
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead())
+			continue;
+		ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, heli);
+		ped->WarpPedIntoCar(heli);
+		VCModChaseSitInCar(ped);
+		seated++;
+	}
+	player->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, heli);
+	player->WarpPedIntoCar(heli);
+	VCModChaseSitInCar(player);
+	heli->SetStatus(STATUS_PHYSICS);
+	VCModChaseReleaseRopes();
+	nVCModChaseAir = VCMOD_AIR_CHASE;
+	nVCModChaseAirFollowAt = 0;
+	nVCModChaseAirShootStart = 0;	// armed with the first round
+	VCModChaseTakeHeliOffAutopilot();
+	// he runs from the moment the roof closes
+	if (pVCModChaseLeaderCar != nil)
+		VCModChaseDriveCar(pVCModChaseLeaderCar, vecVCModChaseAirEscape);
+	bVCModChaseGo = true;
+	VCModChaseNotice("chase: stay on him, the guns are hot");
+	fprintf(stderr, "VCMOD CHASE air seated %d chasing to %.1f %.1f %.1f\n", seated,
+		vecVCModChaseAirEscape.x, vecVCModChaseAirEscape.y, vecVCModChaseAirEscape.z);
+}
+
+// Take the hull off the station autopilot: from here the flight model below owns
+// the position, the speed and the basis. The engine's autopilot keeps running in
+// CWorld::Process (it is what keeps the vehicle physics out of the heli), so this
+// runs after it every frame and overwrites everything it did.
+static void
+VCModChaseTakeHeliOffAutopilot(void)
+{
+	CAutomobile *heli = pVCModChaseHeli;
+	if (heli == nil)
+		return;
+	CVector fwd = heli->GetForward();
+	vecVCModChaseHeliPos = heli->GetPosition();
+	vecVCModChaseHeliSpeed = heli->m_vecMoveSpeed;
+	// CHeli's heading runs opposite its forward vector; the car heli's
+	// m_fOrientation is the same angle plus pi
+	fVCModChaseHeliOrientation = CGeneral::GetATanOfXY(-fwd.x, -fwd.y);
+	fVCModChaseHeliAngularSpeed = 0.0f;
+	fVCModChaseHeliTargetZ = vecVCModChaseHeliPos.z;
+	bVCModChaseHeliTestRight = true;
+	bVCModChaseHeliHover = false;
+	nVCModChaseHeliLockAt = CTimer::GetTimeInMilliseconds();
+	nVCModChaseHeliLastShot = 0;
+}
+
+// 1:1 of the stock police chopper's flight model (CHeli::Process), flown at the
+// criminal's car instead of at the player: the same distances, speeds, ground
+// relative altitude, bob, turn rates and basis. Retargeted every frame, which is
+// what makes the hull lean and swing with the car instead of stepping to a
+// station every half second.
+static void
+VCModChaseFlyHeli(CVehicle *target)
+{
+	CAutomobile *heli = pVCModChaseHeli;
+	if (heli == nil || target == nil)
+		return;
+	float frame = CTimer::GetTimeStep();
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	CVector toTarget = target->GetPosition() - vecVCModChaseHeliPos;
+	float dist = toTarget.Magnitude();
+
+	// stock hover/chase switch: settle over the target once it is close and in
+	// sight, run it down again past 40 m
+	if (bVCModChaseHeliHover) {
+		if (dist > VCMOD_CHASE_AIR_HOVER_LEAVE)
+			bVCModChaseHeliHover = false;
+	} else if (dist < 1.0f ||
+	           (dist < VCMOD_CHASE_AIR_HOVER_DIST &&
+	            CWorld::GetIsLineOfSightClear(vecVCModChaseHeliPos, target->GetPosition(),
+	                                          true, false, false, false, false, false))) {
+		bVCModChaseHeliHover = true;
+	}
+
+	float groundZ = CWorld::FindGroundZFor3DCoord(vecVCModChaseHeliPos.x, vecVCModChaseHeliPos.y, 1000.0f, nil);
+	fVCModChaseHeliTargetZ = Max(groundZ, target->GetPosition().z) +
+	                         (bVCModChaseHeliHover ? VCMOD_CHASE_AIR_HOVER_OVER : VCMOD_CHASE_AIR_CHASE_OVER);
+
+	// never sink into the ground; the stock chopper lifts itself the same way
+	if (vecVCModChaseHeliPos.z - 2.0f < groundZ)
+		vecVCModChaseHeliSpeed.z += frame * 0.01f;
+	vecVCModChaseHeliSpeed.z = Clamp(vecVCModChaseHeliSpeed.z, -0.3f, 0.3f);
+
+	float speed;
+	if (dist > 100.0f)
+		speed = 1.0f;
+	else if (dist > 75.0f)
+		speed = 0.7f;
+	else
+		speed = 0.4f;
+	if (bVCModChaseHeliHover)
+		speed = 0.0f;
+
+	CVector2D dir;
+	if (dist != 0.0f) {
+		dir.x = toTarget.x / dist;
+		dir.y = toTarget.y / dist;
+	} else {
+		dir.x = 1.0f;
+		dir.y = 0.0f;
+	}
+	CVector2D targetSpeed(dir.x * speed, dir.y * speed);
+
+	if (bVCModChaseHeliHover) {
+		// stock HOVER2's side-step: slide around the target instead of parking on
+		// top of it, swapping sides when the hull is about to touch a wall
+		bool force = !!((CTimer::GetFrameCounter()) & 8);
+		CVector right = heli->GetRight();
+		if (bVCModChaseHeliTestRight) {
+			if (force || CWorld::TestSphereAgainstWorld(vecVCModChaseHeliPos + 4.0f * right, 2.0f, heli,
+			                                           true, false, false, false, false, false) == nil) {
+				targetSpeed.x += dir.x * 0.05f;
+				targetSpeed.y -= dir.y * 0.05f;
+			} else
+				bVCModChaseHeliTestRight = false;
+		} else {
+			if (force || CWorld::TestSphereAgainstWorld(vecVCModChaseHeliPos - 4.0f * right, 2.0f, heli,
+			                                           true, false, false, false, false, false) == nil) {
+				targetSpeed.x -= dir.x * 0.05f;
+				targetSpeed.y += dir.y * 0.05f;
+			} else
+				bVCModChaseHeliTestRight = true;
+		}
+	}
+
+	CVector2D speedDelta(targetSpeed.x - vecVCModChaseHeliSpeed.x, targetSpeed.y - vecVCModChaseHeliSpeed.y);
+	float speedDiff = speedDelta.Magnitude();
+	if (speedDiff != 0.0f)
+		speedDelta /= speedDiff;
+	else
+		speedDelta.x = 1.0f;
+	float speedInc = frame * 0.002f;
+	if (speedDiff < speedInc) {
+		vecVCModChaseHeliSpeed.x = targetSpeed.x;
+		vecVCModChaseHeliSpeed.y = targetSpeed.y;
+	} else {
+		vecVCModChaseHeliSpeed.x += speedDelta.x * speedInc;
+		vecVCModChaseHeliSpeed.y += speedDelta.y * speedInc;
+	}
+	vecVCModChaseHeliPos.x += vecVCModChaseHeliSpeed.x * frame;
+	vecVCModChaseHeliPos.y += vecVCModChaseHeliSpeed.y * frame;
+
+	// stock bob: two metres up and down on a timer, so the hover breathes
+	if (now & 0x800)
+		fVCModChaseHeliTargetZ += 2.0f;
+	float targetSpeedZ = (fVCModChaseHeliTargetZ - vecVCModChaseHeliPos.z) * 0.01f;
+	float speedDiffZ = targetSpeedZ - vecVCModChaseHeliSpeed.z;
+	float speedIncZ = frame * 0.001f;
+	if (Abs(speedDiffZ) < speedIncZ)
+		vecVCModChaseHeliSpeed.z = targetSpeedZ;
+	else if (speedDiffZ < 0.0f)
+		vecVCModChaseHeliSpeed.z -= speedIncZ;
+	else
+		vecVCModChaseHeliSpeed.z += speedIncZ * 1.5f;
+	vecVCModChaseHeliPos.z += vecVCModChaseHeliSpeed.z * frame;
+
+	fVCModChaseHeliAngularSpeed *= Pow(0.995f, frame);
+	float targetAngularSpeed;
+	if (dist < 8.0f)
+		targetAngularSpeed = 0.0f;
+	else {
+		float rotationDiff = CGeneral::GetATanOfXY(toTarget.x, toTarget.y) - fVCModChaseHeliOrientation;
+		while (rotationDiff < -3.14f) rotationDiff += 6.28f;
+		while (rotationDiff > 3.14f) rotationDiff -= 6.28f;
+		if (Abs(rotationDiff) > 0.4f)
+			targetAngularSpeed = rotationDiff < 0.0f ? -0.2f : 0.2f;
+		else
+			targetAngularSpeed = 0.0f;
+	}
+	float angularDiff = targetAngularSpeed - fVCModChaseHeliAngularSpeed;
+	float angularInc = frame * 0.0001f;
+	if (Abs(angularDiff) < angularInc)
+		fVCModChaseHeliAngularSpeed = targetAngularSpeed;
+	else if (angularDiff < 0.0f)
+		fVCModChaseHeliAngularSpeed -= angularInc;
+	else
+		fVCModChaseHeliAngularSpeed += angularInc;
+	fVCModChaseHeliOrientation += fVCModChaseHeliAngularSpeed * frame;
+
+	CVector up(3.0f * vecVCModChaseHeliSpeed.x, 3.0f * vecVCModChaseHeliSpeed.y, 1.0f);
+	up.Normalise();
+	CVector fwd(-Cos(fVCModChaseHeliOrientation), -Sin(fVCModChaseHeliOrientation), 0.0f);
+	CVector right = CrossProduct(up, fwd);
+	fwd = CrossProduct(up, right);
+
+	heli->SetPosition(vecVCModChaseHeliPos);
+	heli->GetMatrix().GetRight() = right;
+	heli->GetMatrix().GetForward() = fwd;
+	heli->GetMatrix().GetUp() = up;
+	heli->GetMatrix().UpdateRW();
+	heli->m_vecMoveSpeed = vecVCModChaseHeliSpeed;
+	heli->m_vecTurnSpeed = CVector(0.0f, 0.0f, 0.0f);
+	heli->m_fOrientation = fVCModChaseHeliOrientation + PI;
+	while (heli->m_fOrientation > TWOPI)
+		heli->m_fOrientation -= TWOPI;
+}
+
+// The stock chopper's gun, 1:1: same searchlight-style lock, same 1500 ms wait
+// for a settled lock, same 200 ms cadence, same jitter, same 3 m muzzle offset,
+// same 20 damage, same round and sound. The stock gun shoots at the player; an
+// allied heli shoots at the criminal's car.
+static void
+VCModChaseAirFire(CVehicle *car)
+{
+	if (car == nil || pVCModChaseHeli == nil)
+		return;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	CVector hull = pVCModChaseHeli->GetPosition();
+	CVector target = car->GetPosition();
+	target.z += 0.8f;	// a car's origin sits at road level; the body is above it
+
+	bool locked = (hull - target).Magnitude() < VCMOD_CHASE_AIR_LOCK_RANGE &&
+	              CWorld::GetIsLineOfSightClear(hull, target, true, false, false, false, false, false);
+	if (!locked) {
+		nVCModChaseHeliLockAt = now;
+		return;
+	}
+	if (now <= nVCModChaseHeliLockAt + VCMOD_CHASE_AIR_LOCK_TIME ||
+	    now <= nVCModChaseHeliLastShot + VCMOD_CHASE_AIR_SHOOT_EVERY)
+		return;
+
+	CVector shotTarget = target;
+	shotTarget.x += ((CGeneral::GetRandomNumber() & 0xFF) - 128) / 50.0f;
+	shotTarget.y += ((CGeneral::GetRandomNumber() & 0xFF) - 128) / 50.0f;
+	// the stock aim is the clean target, not the jittered one
+	CVector direction = target - hull;
+	direction.Normalise();
+	shotTarget += 3.0f * direction;
+	CVector shotSource = hull;
+	shotSource += 3.0f * direction;
+	FireOneInstantHitRound(&shotSource, &shotTarget, VCMOD_CHASE_AIR_SHOT_DAMAGE);
+	DMAudio.PlayOneShot(pVCModChaseHeli->m_audioEntityId, SOUND_WEAPON_SHOT_FIRED, 0.0f);
+	nVCModChaseHeliLastShot = now;
+	// the burst clock starts with the first round: the hull may need a while to
+	// catch the car, and the 12 s cap is there to bound the shooting, not the chase
+	if (nVCModChaseAirShootStart == 0)
+		nVCModChaseAirShootStart = now;
+}
+
+// Shot off the road: dead engine, burst tyre, smoke, and both criminals get
+// out. No fire: a burning car would explode beside them and could end the run
+// before the team has even landed. The hull is sent to a fixed station over the
+// wreck; the descent starts from that station, not from wherever the chase left
+// the heli.
+static void
+VCModChaseAirCrash(void)
+{
+	CVehicle *car = pVCModChaseLeaderCar;
+	if (car == nil)
+		return;
+	CAutomobile *wreck = (CAutomobile*)car;
+	wreck->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	wreck->AutoPilot.m_nCruiseSpeed = 0;
+	wreck->bEngineOn = false;
+	wreck->Damage.SetEngineStatus(ENGINE_STATUS_SMOKE);
+	wreck->Damage.SetWheelStatus(CARWHEEL_FRONT_LEFT, WHEEL_STATUS_BURST);
+	CVector smoke = car->GetPosition();
+	smoke.z += 1.0f;
+	for (int32 i = 0; i < 8; i++)
+		CParticle::AddParticle(PARTICLE_ENGINE_SMOKE, smoke, CVector(0.0f, 0.0f, 0.03f), nil, 2.5f);
+	CPed *leader = VCModChaseLeader();
+	if (leader != nil)
+		leader->SetObjective(OBJECTIVE_LEAVE_CAR, car);
+	CPed *accomplice = VCModChaseAccomplice();
+	if (accomplice != nil && accomplice->bInVehicle)
+		accomplice->SetObjective(OBJECTIVE_LEAVE_CAR, car);
+
+	vecVCModChaseDropStation = car->GetPosition();
+	vecVCModChaseDropStation.z += VCMOD_CHASE_HELI_HOVER;
+	pVCModChaseHeli->TellHeliToGoToCoors(vecVCModChaseDropStation.x, vecVCModChaseDropStation.y,
+		vecVCModChaseDropStation.z, VCMOD_CHASE_AIR_SPEED);
+	nVCModChaseAir = VCMOD_AIR_HOLD;
+	nVCModChaseAirAt = 0;	// armed once the hull is over the station
+	nVCModChaseAirFollowAt = 0;
+	bVCModChaseHeliHeld = false;
+	VCModChaseNotice("chase: he is going down");
+	fprintf(stderr, "VCMOD CHASE air crash health %.0f heli %.0f station %.1f %.1f %.1f\n",
+		car->m_fHealth, pVCModChaseHeli->m_fHealth,
+		vecVCModChaseDropStation.x, vecVCModChaseDropStation.y, vecVCModChaseDropStation.z);
+}
+
+// Over the wreck: bring the hull onto the station, let the ropes hang, then put
+// everyone on them and lower them the same way they climbed, at a fixed rate.
+static void
+VCModChaseStartDrop(CPlayerPed *player)
+{
+	CAutomobile *heli = pVCModChaseHeli;
+	vecVCModChaseHeliHold = vecVCModChaseDropStation;
+	VCModChasePinHeli();
+	heli->TellHeliToGoToCoors(vecVCModChaseHeliHold.x, vecVCModChaseHeliHold.y,
+		vecVCModChaseHeliHold.z, 0);
+	heli->m_nDoorLock = CARLOCK_UNLOCKED;
+
+	VCModChaseEjectPed(player);
+	VCModChaseSetPedOnRope(player);
+	// the car camera would otherwise interpolate into a falling ped mid-screen;
+	// a clean cut reads as stepping over the side
+	TheCamera.RestoreWithJumpCut();
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead())
+			continue;
+		VCModChaseEjectPed(ped);
+		VCModChaseSetPedOnRope(ped);
+	}
+	fVCModChaseRopePos = 0.0f;
+	nVCModChaseAir = VCMOD_AIR_DROP;
+	VCModChaseNotice("chase: down the ropes");
+	fprintf(stderr, "VCMOD CHASE air drop at %.1f %.1f %.1f\n",
+		vecVCModChaseHeliHold.x, vecVCModChaseHeliHold.y, vecVCModChaseHeliHold.z);
+}
+
+// Ground: the criminal is out of his car, so this is the endgame on foot.
+static void
+VCModChaseLandTeam(CPlayerPed *player)
+{
+	VCModChaseLandPlayer(player);
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++)
+		VCModChaseDropOffRope(VCModChaseSquadPed(i));
+	VCModChaseReleaseRopes();
+	nVCModChaseAir = VCMOD_AIR_FOLLOW;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	nVCModChaseAirAt = now + VCMOD_CHASE_AIR_FOLLOW_EVERY;
+
+	CPed *leader = VCModChaseLeader();
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead() || leader == nil)
+			continue;
+		ped->ClearObjective();
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, leader);
+	}
+	bVCModChaseSquadDismounted = true;
+	// he is on foot now; the cornered branch drives both sides of the stand
+	bVCModChaseCornered = true;
+	nVCModChaseSetup = VCMOD_CHASE_SETUP_READY;
+	bVCModChaseGo = true;
+	VCModChaseNotice("chase: take him down");
+	fprintf(stderr, "VCMOD CHASE air down, stand at %.1f %.1f %.1f\n",
+		player->GetPosition().x, player->GetPosition().y, player->GetPosition().z);
+}
+
+static void
+VCModChaseTickAir(CPlayerPed *player)
+{	if (nVCModChaseAir == VCMOD_AIR_OFF || pVCModChaseHeli == nil)
+		return;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	float frame = CTimer::GetTimeStep();
+
+	// the autopilot bobs and rocks the hull while it holds; put the upright
+	// station basis back during the descent so the rope the men are on is a
+	// steady line
+	if (nVCModChaseAir == VCMOD_AIR_DROP)
+		VCModChasePinHeli();
+
+	if (nVCModChaseAir == VCMOD_AIR_RALLY) {
+		for (int32 i = 0; i < 3; i++)
+			CRopes::RegisterRope(nVCModChaseRopeId[i], VCModChaseRopeTop(i), false);
+		bool allHere = true;
+		for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+			CPed *ped = VCModChaseSquadPed(i);
+			if (ped == nil || ped->DyingOrDead())
+				continue;
+			if ((ped->GetPosition() - vecVCModChaseRallySpot[i]).Magnitude2D() > VCMOD_CHASE_RALLY_NEAR)
+				allHere = false;
+		}
+		if (allHere || now >= nVCModChaseAirAt)
+			VCModChaseBeginClimb(player);
+		return;
+	}
+
+	if (nVCModChaseAir == VCMOD_AIR_CLIMB) {
+		for (int32 i = 0; i < 3; i++)
+			CRopes::RegisterRope(nVCModChaseRopeId[i], VCModChaseRopeTop(i), false);
+		fVCModChaseRopePos = VCModChaseRopeProgress(fVCModChaseRopePos, VCMOD_CHASE_CLIMB_RATE, frame, true);
+		VCModChaseHoldRope(player, 0, fVCModChaseRopePos);
+		for (int32 i = 0; i < nVCModChaseSquadCount && i < 2; i++)
+			VCModChaseHoldRope(VCModChaseSquadPed(i), i + 1, fVCModChaseRopePos);
+		if (fVCModChaseRopePos <= 0.0f)
+			VCModChaseSeatTeam(player);
+		return;
+	}
+
+	if (nVCModChaseAir == VCMOD_AIR_CHASE) {
+		CVehicle *car = pVCModChaseLeaderCar;
+		if (car == nil) {
+			// the car is gone; drop where the hull is rather than hang here
+			vecVCModChaseDropStation = pVCModChaseHeli->GetPosition();
+			nVCModChaseAir = VCMOD_AIR_HOLD;
+			nVCModChaseAirAt = 0;
+			return;
+		}
+		VCModChaseFlyHeli(car);
+		VCModChaseAirFire(car);
+		uint32 shootingFor = nVCModChaseAirShootStart != 0 ? now - nVCModChaseAirShootStart : 0;
+		if (VCModChaseAirWrecked(car->m_fHealth, shootingFor))
+			VCModChaseAirCrash();
+		return;
+	}
+
+	if (nVCModChaseAir == VCMOD_AIR_HOLD) {
+		CVector hull = pVCModChaseHeli->GetPosition();
+		bool onStation = (hull - vecVCModChaseDropStation).Magnitude2D() <= VCMOD_CHASE_DROP_STATION_H &&
+		                 Abs(hull.z - vecVCModChaseDropStation.z) <= VCMOD_CHASE_DROP_STATION_V;
+		if (!onStation) {
+			// fly the hull onto the station first; the descent always starts there
+			if (now >= nVCModChaseAirFollowAt) {
+				nVCModChaseAirFollowAt = now + VCMOD_CHASE_AIR_FOLLOW_EVERY;
+				pVCModChaseHeli->TellHeliToGoToCoors(vecVCModChaseDropStation.x, vecVCModChaseDropStation.y,
+					vecVCModChaseDropStation.z, VCMOD_CHASE_AIR_SPEED);
+			}
+			return;
+		}
+		// on the station: hold the hull upright on a fixed heading and hang the
+		// drop ropes before anyone steps on them, so the line is settled when the
+		// descent starts
+		vecVCModChaseHeliHold = vecVCModChaseDropStation;
+		if (!bVCModChaseHeliHeld) {
+			VCModChaseCaptureHeliHeading();
+			bVCModChaseHeliHeld = true;
+			fprintf(stderr, "VCMOD CHASE air station held, heading %.2f %.2f\n",
+				vecVCModChaseHeliFwd.x, vecVCModChaseHeliFwd.y);
+		}
+		VCModChasePinHeli();
+		for (int32 i = 0; i < 3; i++)
+			CRopes::RegisterRope(nVCModChaseRopeDropId[i], VCModChaseRopeTop(i), false);
+		if (nVCModChaseAirAt == 0)
+			nVCModChaseAirAt = now + VCMOD_CHASE_AIR_SETTLE;
+		CPed *leader = VCModChaseLeader();
+		bool out = leader == nil || leader->DyingOrDead() || !leader->bInVehicle;
+		if (now >= nVCModChaseAirAt && (out || now >= nVCModChaseAirAt + 4000))
+			VCModChaseStartDrop(player);
+		return;
+	}
+
+	if (nVCModChaseAir == VCMOD_AIR_DROP) {
+		for (int32 i = 0; i < 3; i++)
+			CRopes::RegisterRope(nVCModChaseRopeDropId[i], VCModChaseRopeTop(i), false);
+		fVCModChaseRopePos = VCModChaseRopeProgress(fVCModChaseRopePos, VCMOD_CHASE_DROP_RATE, frame, false);
+		VCModChaseHoldRope(player, 0, fVCModChaseRopePos);
+		for (int32 i = 0; i < nVCModChaseSquadCount && i < 2; i++)
+			VCModChaseHoldRope(VCModChaseSquadPed(i), i + 1, fVCModChaseRopePos);
+		// the hover height can differ from the rope length, so the ground is what
+		// ends the rappel rather than a fixed point on the rope
+		CVector feet = player->GetPosition();
+		float ground = CWorld::FindGroundZFor3DCoord(feet.x, feet.y, feet.z, nil);
+		if (fVCModChaseRopePos >= VCMOD_CHASE_ROPE_BOTTOM || feet.z - ground <= VCMOD_CHASE_AIR_LAND_NEAR)
+			VCModChaseLandTeam(player);
+		return;
+	}
+
+	// FOLLOW: the heli holds over the stand while the fight plays
+	if (nVCModChaseAir == VCMOD_AIR_FOLLOW && now >= nVCModChaseAirAt) {
+		nVCModChaseAirAt = now + VCMOD_CHASE_AIR_FOLLOW_EVERY;
+		CPed *leader = VCModChaseLeader();
+		if (leader != nil) {
+			CVector to = leader->GetPosition();
+			to.z += VCMOD_CHASE_AIR_FOLLOW_HIGH;
+			pVCModChaseHeli->TellHeliToGoToCoors(to.x, to.y, to.z, 60);
+		}
+	}
+}
+
+static void
+VCModChaseSpawnAccomplice(void)
+{
+	if (pVCModChaseLeaderCar == nil || nVCModChaseCrewCap <= 0)
+		return;
+	CStreaming::RequestModel(VCMOD_CHASE_ACCOMPLICE_MODEL, 0);
+	CStreaming::RequestModel(CWeaponInfo::GetWeaponInfo(WEAPONTYPE_UZI)->m_nModelId, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_ACCOMPLICE_MODEL)) {
+		// the retry runs every frame; one line a second is enough to show it
+		uint32 now = CTimer::GetTimeInMilliseconds();
+		if (now - nVCModChaseCrewLogAt > 1000) {
+			nVCModChaseCrewLogAt = now;
+			fprintf(stderr, "VCMOD CHASE crew model still streaming\n");
+		}
+		return;
+	}
+
+	CPed *leader = VCModChaseLeader();
+	CVector pos;
+	if (bVCModChaseCornered && leader != nil)
+		pos = leader->GetPosition() + leader->GetRight() * 1.2f;
+	else
+		pos = pVCModChaseLeaderCar->GetPosition() + pVCModChaseLeaderCar->GetRight() * 4.0f;
+	CPed *ped = CPopulation::AddPed(PEDTYPE_CIVMALE, VCMOD_CHASE_ACCOMPLICE_MODEL, pos);
+	if (ped == nil) {
+		fprintf(stderr, "VCMOD CHASE pickup spawn failed\n");
+		return;
+	}
+	ped->CharCreatedBy = MISSION_CHAR;
+	ped->bIsPlayerFriend = false;
+	ped->m_fHealth = VCMOD_CHASE_CREW_HEALTH;
+	// a pistol loses the stand against four rifles; the crew carries the team's
+	// own submachinegun so he draws fire off the leader
+	ped->GiveWeapon(WEAPONTYPE_UZI, 1000);
+	ped->SetCurrentWeapon(WEAPONTYPE_UZI);
+	if (bVCModChaseCornered)
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, VCModChaseCopTarget(ped, nil));
+	else
+		ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, pVCModChaseLeaderCar);
+	nVCModChaseCrewHandle[0] = CPools::GetPedPool()->GetIndex(ped);
+	bVCModChaseCrewOut = true;
+	fprintf(stderr, "VCMOD CHASE pickup %p at %.1f %.1f %.1f cornered %d\n",
+		(void*)ped, pos.x, pos.y, pos.z, bVCModChaseCornered);
+}
+
+static void
+VCModChaseTickCrew(void)
+{
+	if (nVCModChaseCrewCap <= 0)
+		return;
+	if (VCModChaseCrewSlotFree(0)) {
+		// the pickup happens at the second beat; if he is still missing when
+		// the stand starts, he joins it on foot rather than leaving the leader
+		// alone
+		if (bVCModChaseCornered || (bVCModChaseAtStop && nVCModChaseBeat == 1))
+			VCModChaseSpawnAccomplice();
+	}
+	if (!bVCModChaseCrewOut || bVCModChaseCornered)
+		return;
+
+	// the men beyond the pickup arrive in the crew's own car: at the pickup beat
+	// on the ground, or as soon as the leader rolls on the air start
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	int32 missing = 0;
+	for (int32 i = 1; i < nVCModChaseCrewCap; i++)
+		if (VCModChaseCrewSlotFree(i))
+			missing++;
+	bool arrive = (nVCModChaseAir != VCMOD_AIR_OFF && bVCModChaseGo) ||
+	              (bVCModChaseAtStop && nVCModChaseBeat == 1);
+	if (missing > 0 && arrive && now >= nVCModChaseCrewArriveAt) {
+		nVCModChaseCrewArriveAt = now + 1000;
+		VCModChaseCrewCarry(1, missing, false);
+	}
+
+	// the walk to the passenger door can fail while the car is nudged by the
+	// player; seat him instead of leaving the crew standing at the kerb
+	CPed *ped = VCModChaseCrewPed(0);
+	if (ped == nil || ped->DyingOrDead())
+		return;
+	CPed *leader = VCModChaseLeader();
+	if (leader != nil && leader->bInVehicle && pVCModChaseLeaderCar != nil &&
+	    !(ped->bInVehicle && ped->m_pMyVehicle == pVCModChaseLeaderCar) &&
+	    pVCModChaseLeaderCar->GetMoveSpeed().Magnitude2D() < VCMOD_CHASE_STILL_SPEED)
+		VCModChaseBoardAccomplice();
+}
+
+static bool
+VCModChaseSpawnBoat(void)
+{
+	CStreaming::RequestModel(VCMOD_CHASE_BOAT, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_BOAT))
+		return false;
+
+	CVector pos = vecVCModChaseWater;
+	float water = pos.z;
+	CWaterLevel::GetWaterLevel(pos.x, pos.y, pos.z + 2.0f, &water, false);
+	pos.z = water;
+
+	CBoat *boat = new CBoat(VCMOD_CHASE_BOAT, RANDOM_VEHICLE);
+	if (boat == nil)
+		return false;
+	boat->SetPosition(pos);
+	boat->SetStatus(STATUS_PHYSICS);
+	boat->bEngineOn = false;
+	boat->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	boat->AutoPilot.m_nCruiseSpeed = 0;
+	boat->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	CWorld::Add(boat);
+
+	pVCModChaseBoat = boat;
+	CPed *leader = VCModChaseLeader();
+	if (leader != nil)
+		leader->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, boat);
+	nVCModChaseBoatDeadline = CTimer::GetTimeInMilliseconds() + 2000;
+	return true;
+}
+
+static void
+VCModChaseBoatEscape(void)
+{
+	CPed *leader = VCModChaseLeader();
+	CVehicle *old = pVCModChaseLeaderCar;
+	if (leader != nil && !(leader->bInVehicle && leader->m_pMyVehicle == pVCModChaseBoat)) {
+		// the walk to the dock did not finish in time; seat him rather than stall
+		if (old->pDriver == leader)
+			old->pDriver = nil;
+		leader->SetObjective(OBJECTIVE_ENTER_CAR_AS_DRIVER, pVCModChaseBoat);
+		leader->WarpPedIntoCar(pVCModChaseBoat);
+	}
+	VCModChaseRemoveVehicle(old);
+
+	CVector dir = vecVCModChaseWater - vecVCModChaseDock;
+	dir.z = 0.0f;
+	dir.Normalise();
+	pVCModChaseBoat->AutoPilot.m_vecDestinationCoors = vecVCModChaseWater + dir * 150.0f;
+	pVCModChaseBoat->AutoPilot.m_nCarMission = MISSION_GOTOCOORDS_ASTHECROWSWIMS;
+	pVCModChaseBoat->AutoPilot.m_nCruiseSpeed = 30;
+	pVCModChaseBoat->AutoPilot.m_nAntiReverseTimer = CTimer::GetTimeInMilliseconds();
+	pVCModChaseBoat->SetStatus(STATUS_PHYSICS);
+	pVCModChaseBoat->bEngineOn = true;
+
+	pVCModChaseLeaderCar = pVCModChaseBoat;
+	pVCModChaseBoat = nil;
+	bVCModChaseBoating = true;
+	nVCModChaseBoatAt = CTimer::GetTimeInMilliseconds();
+}
+
+static void
+VCModChaseBoardAccomplice(void)
+{
+	CPed *ped = VCModChaseAccomplice();
+	if (ped == nil || (ped->bInVehicle && ped->m_pMyVehicle == pVCModChaseLeaderCar))
+		return;
+	ped->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, pVCModChaseLeaderCar);
+	ped->WarpPedIntoCar(pVCModChaseLeaderCar);
+}
+
+// The team fights on foot only in the endgame: once the leader is cornered at
+// the last beat. Leaving the transport at an ordinary stop stranded the whole
+// squad when he pulled away again, so the chase itself stays mounted.
+static void
+VCModChaseTickSquadDismount(CPed *leader, CPlayerPed *player)
+{
+	if (pVCModChaseSquadCar == nil || nVCModChaseSquadCount == 0 || bVCModChaseBoarding)
+		return;
+
+	CVehicle *car = pVCModChaseSquadCar;
+	if (!bVCModChaseSquadDismounted) {
+		if (!bVCModChaseCornered)
+			return;
+		float gap = (car->GetPosition() - leader->GetPosition()).Magnitude2D();
+		// the player drives and chooses where to park; if he walks off to the
+		// fight from further out, the squad follows him out of the car
+		bool playerOut = !(player->bInVehicle && player->m_pMyVehicle == car);
+		if (gap > VCMOD_CHASE_DISMOUNT_RANGE &&
+		    !(playerOut && gap < VCMOD_CHASE_DISMOUNT_LEASH))
+			return;
+		bVCModChaseSquadDismounted = true;
+		fprintf(stderr, "VCMOD CHASE squad dismount gap %.1f\n", gap);
+	}
+
+	for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+		CPed *ped = VCModChaseSquadPed(i);
+		if (ped == nil || ped->DyingOrDead())
+			continue;
+		if (ped->bInVehicle) {
+			if (ped->m_pMyVehicle == nil)
+				continue;
+			if (ped->m_objective != OBJECTIVE_LEAVE_CAR)
+				ped->SetObjective(OBJECTIVE_LEAVE_CAR, ped->m_pMyVehicle);
+			// the fight order has to be queued in the same frame as the exit:
+			// an exit restores whatever was stored before LEAVE_CAR, and the
+			// boarding order stored there walks the man straight back in. A
+			// later SetObjective cannot replace that temporary objective; the
+			// engine only stashes it and keeps ENTER_CAR (PedAI.cpp:242-251).
+			ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, leader);
+			continue;
+		}
+		// a man restored into a boarding order after the exit would walk back
+		// to the door; clear it before giving him the fight
+		if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+		    ped->m_objective == OBJECTIVE_ENTER_CAR_AS_DRIVER)
+			ped->ClearObjective();
+		// on-foot, not any-means: any-means makes a ped whose target is more
+		// than 30 m away get into a car (PedAI.cpp:929), which fights the
+		// leave-car order and loops him in and out of the seat
+		if (ped->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT)
+			ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, leader);
+	}
+}
+
+// No boat finale on this route means the beats simply run out. Ending the run
+// with "he got away" while the player is standing next to him is wrong, so the
+// last beat becomes his stand: the car stops, he and his passenger get out and
+// fight, and the mission still ends the way the design says — on his death.
+static void
+VCModChaseCornerPed(CPed *ped, CVehicle *car, CPed *target)
+{
+	if (ped == nil || ped->DyingOrDead() || target == nil)
+		return;
+	if (ped->bInVehicle) {
+		if (ped->m_objective != OBJECTIVE_LEAVE_CAR)
+			ped->SetObjective(OBJECTIVE_LEAVE_CAR, ped->m_pMyVehicle != nil ? ped->m_pMyVehicle : car);
+		// queue the fight behind the exit in the same frame: the exit restores
+		// whatever was stored before LEAVE_CAR (the boarding order, for the
+		// pickup), which would walk him back into the car
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, target);
+		return;
+	}
+	if (ped->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+	    ped->m_objective == OBJECTIVE_ENTER_CAR_AS_DRIVER)
+		ped->ClearObjective();
+	// on-foot kill also attacks a target sitting in his car; any-means would
+	// make the ped grab a car and fight the leave-car order
+	if (ped->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT || ped->m_pedInObjective != target)
+		ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, target);
+}
+
+// The criminal a squad man should fight: the one he is already on, else the
+// nearest living one. Sticking to the current target stops the order flipping
+// between two equally close men, which makes the cop hesitate.
+static CPed *
+VCModChaseCriminalTarget(CPed *from)
+{
+	if (from == nil)
+		return nil;
+	CPed *leader = VCModChaseLeader();
+	CPed *current = from->m_pedInObjective;
+	// the leader, or one of the crew: mission-owned and not on the player's side
+	bool currentCriminal = current != nil &&
+		(current == leader ||
+		 (current->CharCreatedBy == MISSION_CHAR && !current->bIsPlayerFriend && !current->IsPlayer()));
+	if (currentCriminal && !current->DyingOrDead())
+		return current;
+
+	CPed *best = nil;
+	float bestDist = 1.0e6f;
+	for (int32 i = -1; i < nVCModChaseCrewCap; i++) {
+		CPed *c = i < 0 ? leader : VCModChaseCrewPed(i);
+		if (c == nil || c == from || c->DyingOrDead())
+			continue;
+		float d = (c->GetPosition() - from->GetPosition()).Magnitude2D();
+		if (d < bestDist) {
+			bestDist = d;
+			best = c;
+		}
+	}
+	return best;
+}
+
+static void
+VCModChaseCorner(CPed *leader, CPlayerPed *player)
+{
+	if (!bVCModChaseCornered) {
+		bVCModChaseCornered = true;
+		VCModChaseNotice("chase: he is cornered");
+		fprintf(stderr, "VCMOD CHASE cornered at %.1f %.1f %.1f\n",
+			leader->GetPosition().x, leader->GetPosition().y, leader->GetPosition().z);
+	}
+	CVehicle *car = leader->m_pMyVehicle;
+	if (car != nil) {
+		car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		car->AutoPilot.m_nCruiseSpeed = 0;
+		car->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	}
+	// the crew fights the police crew, not only the player: each man takes the
+	// closest cop who is not already taken, so they spread instead of stacking
+	CPed *leaderTarget = VCModChaseCopTarget(leader, nil);
+	VCModChaseCornerPed(leader, car, leaderTarget);
+	CPed *lastTarget = leaderTarget;
+	for (int32 i = 0; i < nVCModChaseCrewCap; i++) {
+		CPed *crew = VCModChaseCrewPed(i);
+		if (crew == nil || crew->DyingOrDead())
+			continue;
+		CPed *target = VCModChaseCopTarget(crew, lastTarget);
+		if (target == nil)
+			target = lastTarget;
+		if (target != nil)
+			lastTarget = target;
+		VCModChaseCornerPed(crew, car, target);
+	}
+	// The air team lands with no transport, so VCModChaseTickSquadDismount (which
+	// re-issues the ground squad's fight every frame) has nothing to run on and
+	// the cops stand passive until someone shoots them. Keep the fight order
+	// alive here; the ground start still uses the squad car's dismount path.
+	if (pVCModChaseSquadCar == nil) {
+		for (int32 i = 0; i < nVCModChaseSquadCount; i++) {
+			CPed *ped = VCModChaseSquadPed(i);
+			if (ped == nil || ped->DyingOrDead())
+				continue;
+			CPed *target = VCModChaseCriminalTarget(ped);
+			if (target != nil)
+				VCModChaseCornerPed(ped, nil, target);
+		}
+	}
+}
+
+// A spot off the driving lane on the first side without a wall or water, so the
+// car parks at the kerb instead of stopping dead in the road.
+static bool
+VCModChasePullSpot(CVehicle *car, CVector *out)
+{
+	CVector right = car->GetRight();
+	right.z = 0.0f;
+	if (right.Magnitude2D() < 0.01f)
+		return false;
+	right.Normalise2D();
+	for (int32 side = 1; side >= -1; side -= 2) {
+		CVector dir = right * (float)side;
+		CVector spot = car->GetPosition() + dir * VCMOD_CHASE_PULL_DIST;
+		if (VCModChaseInWater(spot) || VCModChaseBridge(spot))
+			continue;
+		CVector from = car->GetPosition();
+		CVector to = spot;
+		from.z += 1.2f;
+		to.z += 1.2f;
+		CColPoint point;
+		CEntity *hit = nil;
+		if (CWorld::ProcessLineOfSight(from, to, point, hit, true, false, false, false, true, false))
+			continue;
+		spot.z = car->GetPosition().z;
+		*out = spot;
+		return true;
+	}
+	return false;
+}
+
+// End of the route with no boat finale. Pull over first, then call the stand.
+static bool
+VCModChaseTickCornerReady(CPed *leader, CPlayerPed *player, uint32 now)
+{
+	if (bVCModChaseCornered)
+		return true;
+	if (!bVCModChasePullingOver) {
+		bVCModChasePullingOver = true;
+		nVCModChasePullAt = now + VCMOD_CHASE_PULL_TIME;
+		CVehicle *car = pVCModChaseLeaderCar;
+		CVector spot;
+		if (car != nil && VCModChasePullSpot(car, &spot)) {
+			vecVCModChasePullSpot = spot;
+			fprintf(stderr, "VCMOD CHASE pull over to %.1f %.1f %.1f\n", spot.x, spot.y, spot.z);
+			VCModChaseDriveCar(car, spot);
+			car->AutoPilot.m_nCruiseSpeed = VCMOD_CHASE_PULL_SPEED;
+			car->AutoPilot.m_fMaxTrafficSpeed = VCMOD_CHASE_PULL_SPEED;
+			return false;
+		}
+		nVCModChasePullAt = now;	// no room: stop where he is
+	}
+	CVehicle *car = pVCModChaseLeaderCar;
+	if (car != nil && (car->GetPosition() - vecVCModChasePullSpot).Magnitude2D() > VCMOD_CHASE_PULL_NEAR &&
+	    now < nVCModChasePullAt)
+		return false;
+	VCModChaseCorner(leader, player);
+	return true;
+}
+
+// One frame of the chase. Returns true when the run is over because the
+// leader escaped; the caller owns the state change and cleanup.
+static bool
+VCModChaseTickLeader(CPlayerPed *player)
+{
+	CPed *leader = VCModChaseLeader();
+	if (leader == nil)
+		return true;
+	float dist = (leader->GetPosition() - player->GetPosition()).Magnitude2D();
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (bVCModChaseBoating) {
+		if (now - nVCModChaseBoatAt > VCMOD_CHASE_BOAT_ESCAPE) {
+			VCModChaseNotice("chase: he escaped by boat");
+			return true;
+		}
+		return false;
+	}
+	if (dist > VCMOD_CHASE_LEASH && nVCModChaseAwaySince == 0)
+		nVCModChaseAwaySince = now;
+	else if (dist <= VCMOD_CHASE_LEASH)
+		nVCModChaseAwaySince = 0;
+	if (VCModChaseHasEscaped(dist, nVCModChaseAwaySince, now)) {
+		VCModChaseNotice("chase: the leader got away");
+		return true;
+	}
+
+	// when the transport pulls up on him and he is not moving, the squad piles
+	// out and goes for him; the collection plays out first so the stop reads
+	// before the shooting starts
+	VCModChaseTickSquadDismount(leader, player);
+
+	if (now - nVCModChaseDebugAt > 1000) {
+		CVehicle *car = pVCModChaseLeaderCar;
+		nVCModChaseDebugAt = now;
+		fprintf(stderr, "VCMOD CHASE state beat %d atstop %d tab %d swap %d pull %d board %d pdrive %d driver %d mission %d ped %d obj %d sq %d+%d cr %d+%d speed %.1f pos %.1f %.1f %.1f\n",
+			nVCModChaseBeat, bVCModChaseAtStop, nVCModChaseTableau, bVCModChaseSwapping,
+			bVCModChasePullingOver, bVCModChaseBoarding,
+			pVCModChaseSquadCar != nil && pVCModChaseSquadCar->pDriver == player,
+			car != nil && car->pDriver != nil,
+			car != nil ? car->AutoPilot.m_nCarMission : -1,
+			leader->m_nPedState, leader->m_objective,
+			VCModChaseSquadAlive(), nVCModChaseSquadReserve,
+			VCModChaseCrewAlive(), nVCModChaseCrewReserve,
+			car != nil ? car->GetMoveSpeed().Magnitude() : 0.0f,
+			leader->GetPosition().x, leader->GetPosition().y, leader->GetPosition().z);
+	}
+
+	if (bVCModChaseCornered) {
+		VCModChaseCorner(leader, player);
+		return false;
+	}
+
+	// end of the route: no beat left to drive to, so `VCModChaseBeatCoors`
+	// would be reading past the array. This has to be checked before the beat
+	// driving below, or the pull-over starts and never resolves.
+	if (nVCModChaseBeat >= nVCModChaseBeatCount) {
+		VCModChaseTickCornerReady(leader, player, now);
+		return false;
+	}
+
+	if (bVCModChaseAtStop) {
+		if (nVCModChaseTableau != VCMOD_TABLEAU_OFF) {
+			VCModChaseTickTableau(leader, now);
+			return false;
+		}
+		if (bVCModChaseSwapping) {
+			if (leader->bInVehicle && leader->m_pMyVehicle == pVCModChaseSwapCar ||
+			    now > nVCModChaseSwapDeadline)
+				VCModChaseFinishSwap();
+			return false;
+		}
+		if (pVCModChaseBoat != nil) {
+			if (leader->bInVehicle && leader->m_pMyVehicle == pVCModChaseBoat ||
+			    now > nVCModChaseBoatDeadline)
+				VCModChaseBoatEscape();
+			return false;
+		}
+		if (now <= nVCModChaseStopUntil)
+			return false;
+		if (nVCModChaseBeat == 0 && VCModChaseStartSwap()) {
+			nVCModChaseStopUntil = now + 5000;
+			return false;
+		}
+		if (nVCModChaseBeat == 1)
+			VCModChaseBoardAccomplice();
+		bVCModChaseAtStop = false;
+		nVCModChaseBeat++;
+	} else {
+		float toBeat = (pVCModChaseLeaderCar->GetPosition() - VCModChaseBeatCoors(nVCModChaseBeat)).Magnitude2D();
+		bool arrived = toBeat < VCMOD_CHASE_BEAT_NEAR;
+		if (!arrived) {
+			// a car wedged short of the beat never reaches the arrival radius and
+			// keeps pushing at zero speed forever; near the beat, a long stall is
+			// taken as arrival so the stop still plays and the run keeps moving
+			if (toBeat < VCMOD_CHASE_STALL_RANGE && pVCModChaseLeaderCar->GetMoveSpeed().Magnitude2D() < VCMOD_CHASE_STILL_SPEED) {
+				if (nVCModChaseLeaderStillSince == 0)
+					nVCModChaseLeaderStillSince = now;
+				else if (now - nVCModChaseLeaderStillSince > VCMOD_CHASE_STALL_TIME) {
+					nVCModChaseLeaderStillSince = 0;
+					arrived = true;
+					fprintf(stderr, "VCMOD CHASE leader stalled %.1f m short of beat %d\n", toBeat, nVCModChaseBeat);
+				}
+			} else {
+				nVCModChaseLeaderStillSince = 0;
+			}
+		}
+		if (!arrived)
+			return false;
+		float pdist = (leader->GetPosition() - player->GetPosition()).Magnitude2D();
+		bool sight = CWorld::GetIsLineOfSightClear(leader->GetPosition(),
+			player->GetPosition(), true, false, false, false, false, false, false);
+		if (!VCModChaseLeaderPressured(pdist, sight)) {
+			nVCModChaseLeaderStillSince = 0;
+			VCModChaseStopHere();
+			bVCModChaseAtStop = true;
+			nVCModChaseStopUntil = now + VCMOD_CHASE_STOP_TIME;
+			// the swap stop is staged; a failed stage falls back to the plain swap
+			if (nVCModChaseBeat == 0 && !VCModChaseStartTableau(now))
+				VCModChaseStartSwap();
+			// the crew pickup is spawned by the per-frame tick, not here
+			if (nVCModChaseBeat == 2)
+				VCModChaseSpawnBoat();
+			return false;
+		}
+		VCModChaseNotice("chase: the leader skipped his stop");
+		nVCModChaseLeaderStillSince = 0;
+		nVCModChaseBeat++;
+	}
+
+	// the stop or skip just finished the last beat; next frame the route-end
+	// branch pulls him over, and driving to a beat that does not exist would
+	// send the car at the origin
+	if (nVCModChaseBeat >= nVCModChaseBeatCount)
+		return false;
+	VCModChaseDriveTo(VCModChaseBeatCoors(nVCModChaseBeat));
+	return false;
+}
+
+// The leader is the objective, so he gets a bright red radar blip and the 3D
+// arrow; red rather than the default dim yellow so he reads on the map.
+static void
+VCModChaseBlipLeader(void)
+{
+	if (nVCModChaseLeaderBlip >= 0 || nVCModChaseLeaderHandle < 0)
+		return;
+	nVCModChaseLeaderBlip = CRadar::SetEntityBlip(BLIP_CHAR,
+		nVCModChaseLeaderHandle, 0, BLIP_DISPLAY_BOTH);
+	if (nVCModChaseLeaderBlip >= 0) {
+		CRadar::ChangeBlipColour(nVCModChaseLeaderBlip, RADAR_TRACE_RED);
+		CRadar::ChangeBlipBrightness(nVCModChaseLeaderBlip, 1);
+	}
+	fprintf(stderr, "VCMOD CHASE leader blip %d handle %d\n",
+		nVCModChaseLeaderBlip, nVCModChaseLeaderHandle);
+}
+
+static bool
+VCModChaseSpawnLeader(CVector at)
+{
+	CStreaming::RequestModel(VCMOD_CHASE_LEADER_MODEL, 0);
+	CStreaming::RequestModel(VCMOD_CHASE_LEADER_CAR, 0);
+	// stream the pickup now; the stop where he appears can be reached before a
+	// fresh request finishes, and the spawn is retried every frame there
+	CStreaming::RequestModel(VCMOD_CHASE_ACCOMPLICE_MODEL, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_CHASE_LEADER_MODEL) ||
+	    !CStreaming::HasModelLoaded(VCMOD_CHASE_LEADER_CAR)) {
+		VCModChaseNotice("chase: the leader cannot be loaded");
+		return false;
+	}
+
+	if (!VCModChaseBuildRoute()) {
+		fprintf(stderr, "VCMOD CHASE route fallback\n");
+		vecVCModChaseLeaderSpawn = at;
+		vecVCModChaseBeat[0] = vecVCModChaseBeatAnchor[0];
+		vecVCModChaseBeat[1] = vecVCModChaseBeatAnchor[1];
+		nVCModChaseBeatCount = 2;
+	}
+	int32 node = ThePaths.FindNodeClosestToCoors(vecVCModChaseLeaderSpawn, PATH_CAR, 80.0f, true, true);
+	CVector pos = vecVCModChaseLeaderSpawn;
+	if (node >= 0) {
+		CVector np = ThePaths.m_pathNodes[node].GetPosition();
+		if (!ThePaths.m_pathNodes[node].bWaterPath && !VCModChaseInWater(np) && !VCModChaseBridge(np))
+			pos = np;
+	}
+	// the origin means the route walk never found a road; never put him there
+	if (pos.Magnitude2D() < 1.0f)
+		pos = at;
+	fprintf(stderr, "VCMOD CHASE route spawn %.1f %.1f %.1f beat0 %.1f %.1f %.1f beat1 %.1f %.1f %.1f beats %d\n",
+		pos.x, pos.y, pos.z,
+		vecVCModChaseBeat[0].x, vecVCModChaseBeat[0].y, vecVCModChaseBeat[0].z,
+		vecVCModChaseBeat[1].x, vecVCModChaseBeat[1].y, vecVCModChaseBeat[1].z,
+		nVCModChaseBeatCount);
+
+	CAutomobile *car = new CAutomobile(VCMOD_CHASE_LEADER_CAR, RANDOM_VEHICLE);
+	if (car == nil) {
+		VCModChaseNotice("chase: no room for the leader's car");
+		return false;
+	}
+	car->m_nDoorLock = CARLOCK_UNLOCKED;
+	pos.z += car->GetDistanceFromCentreOfMassToBaseOfModel();
+	CTheScripts::ClearSpaceForMissionEntity(pos, car);
+	car->SetPosition(pos);
+	car->PlaceOnRoadProperly();
+	car->SetStatus(STATUS_PHYSICS);
+	car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	car->AutoPilot.m_nCruiseSpeed = 0;
+
+	if (car->SetUpDriver() == nil) {
+		CWorld::Remove(car);
+		delete car;
+		VCModChaseNotice("chase: nobody to drive the leader's car");
+		return false;
+	}
+	// SetUpDriver refuses cars that already have mission ownership
+	car->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	CWorld::Add(car);
+
+	CPed *leader = car->pDriver;
+	pVCModChaseLeaderCar = car;
+	nVCModChaseLeaderHandle = CPools::GetPedPool()->GetIndex(leader);
+	leader->CharCreatedBy = MISSION_CHAR;
+	leader->bIsPlayerFriend = false;
+	leader->m_fHealth = VCMOD_CHASE_LEADER_HEALTH;
+	// armed, so the last beat can be a stand rather than a harmless park
+	leader->GiveWeapon(WEAPONTYPE_COLT45, 999);
+	leader->SetCurrentWeapon(WEAPONTYPE_COLT45);
+	VCModChaseBlipLeader();
+	nVCModChaseAwaySince = 0;
+	nVCModChaseBeat = 0;
+	nVCModChaseStopUntil = 0;
+	bVCModChaseAtStop = false;
+	bVCModChaseSquadDismounted = false;
+	bVCModChaseCornered = false;
+	bVCModChasePullingOver = false;
+	nVCModChaseBoardRetargetAt = 0;
+	nVCModChaseLeaderStillSince = 0;
+	nVCModChaseGoTime = CTimer::GetTimeInMilliseconds() + VCMOD_CHASE_GO_FAILSAFE;
+	bVCModChaseGo = false;
+	nVCModChaseAir = VCMOD_AIR_OFF;
+	bVCModChaseApproachChosen = false;
+	nVCModChaseSetup = VCMOD_CHASE_SETUP_APPROACH;
+	// the player is the law now; a wanted level would put the squad on him
+	if (!bVCModChaseNeverWantedOn) {
+		bVCModChasePreNeverWanted = bVCModNeverWanted;
+		bVCModChaseNeverWantedOn = true;
+		bVCModNeverWanted = true;
+	}
+	VCModChaseMuteWanted(true);
+	nVCModChaseCrime = VCModChaseCrimeForTier(nVCModChaseTier);
+	int32 crimeThreat = VCModChaseCrimeThreat(nVCModChaseCrime);
+	// the crew the rank brings, and the men behind them
+	int32 poolSquadActive = 0, poolSquadReserve = 0, poolCrewActive = 0, poolCrewReserve = 0;
+	VCModChasePoolForTier(nVCModChaseTier, &poolSquadActive, &poolSquadReserve,
+	                      &poolCrewActive, &poolCrewReserve);
+	nVCModChaseCrewCap = poolCrewActive;
+	nVCModChaseCrewReserve = poolCrewReserve;
+	nVCModChaseCrewLostAt = 0;
+	nVCModChaseCrewArriveAt = 0;
+	nVCModChaseBackupAt = 0;
+	fprintf(stderr, "VCMOD CHASE leader %p car %p crime %s threat %d crew %d+%d squad %d+%d\n",
+		(void*)leader, (void*)car, VCModChaseCrimeName(nVCModChaseCrime), crimeThreat,
+		poolCrewActive, poolCrewReserve, poolSquadActive, poolSquadReserve);
+	char text[96];
+	snprintf(text, sizeof(text), "chase: %s, threat %d. Drive the team after him",
+		VCModChaseCrimeDispatch(nVCModChaseCrime), crimeThreat);
+	VCModChaseNotice(text);
+	return true;
+}
+
+static void
+VCModChaseEnd(void)
+{
+	fprintf(stderr, "VCMOD CHASE end\n");
+	nVCModChaseTier = 0;
+	nVCModChaseVariant = 0;
+	bVCModChaseUniformWanted = false;
+	VCModChaseRestoreUniform();
+	VCModChaseClearScenario();
+	nVCModChaseCooldownUntil = CTimer::GetTimeInMilliseconds() + 2000;
+}
+
+void
+VCModChaseUpdate(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil)
+		return;
+
+	// The engine pins every crime to the player's wanted record, a teammate
+	// running someone over included. The panel clamp runs in the player's own
+	// process, before the world resolves the run-over, so the star was already
+	// up by the time it cleared. This update runs after the world, so the star
+	// never reaches the screen while the mission's never-wanted is on.
+	if (bVCModChaseNeverWantedOn && player->m_pWanted != nil &&
+	    (player->m_pWanted->GetWantedLevel() != 0 || player->m_pWanted->m_nChaos != 0))
+		player->m_pWanted->SetWantedLevel(0);
+
+	if (bVCModChaseRestorePending &&
+	    VCModChaseRestoreDue(true, player->IsPedInControl(), true)) {
+		bVCModPlayerNpcAnims = bVCModChasePreNpcAnims;
+		if (VCModApplyPedModel(nVCModChasePreModel)) {
+			nVCModChasePreModel = -1;
+			bVCModChaseRestorePending = false;
+		}
+	}
+
+	if (KEYJUSTDOWN(VCMOD_CHASE_CAPTUREKEY)) {
+		CVector here = player->GetPosition();
+		fprintf(stderr, "VCMOD CHASE spot %.2f %.2f %.2f\n", here.x, here.y, here.z);
+		VCModChaseNotice("chase: spot logged");
+	}
+
+	if (KEYJUSTDOWN(VCMOD_CHASE_SPOTKEY)) {
+		if (player->m_pMyVehicle != nil) {
+			VCModChaseNotice("chase: leave the vehicle to teleport");
+		} else {
+			player->Teleport(vecVCModChaseTeleport);
+			VCModChaseNotice("chase: teleported to VCPD HQ");
+			fprintf(stderr, "VCMOD CHASE teleport %.2f %.2f %.2f\n",
+				vecVCModChaseTeleport.x, vecVCModChaseTeleport.y, vecVCModChaseTeleport.z);
+		}
+	}
+
+	if (VCModChaseShouldShowMarker(nVCModChaseState, bVCModChaseSpotSet)) {
+		C3dMarkers::PlaceMarkerSet(VCMOD_CHASE_MARKER_ID, MARKERTYPE_CYLINDER, vecVCModChaseStation,
+			2.0f, 255, 105, 180, 180, 1024, 0.25f, 0);
+		if (nVCModChaseBlip < 0)
+			nVCModChaseBlip = CRadar::SetCoordBlip(BLIP_COORD, vecVCModChaseStation, 0, BLIP_DISPLAY_BOTH);
+	} else if (nVCModChaseBlip >= 0) {
+		CRadar::ClearBlip(nVCModChaseBlip);
+		nVCModChaseBlip = -1;
+	}
+
+	switch (nVCModChaseState) {
+	case VCMOD_CHASE_OFF:
+		if (!bVCModChaseRestorePending &&
+		    CTimer::GetTimeInMilliseconds() > nVCModChaseCooldownUntil &&
+		    bVCModChaseSpotSet &&
+		    (FindPlayerCoors() - vecVCModChaseStation).Magnitude() < VCMOD_CHASE_ENTER_NEAR) {
+			VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_ENTER_MARKER);
+			VCModChaseNotice("chase: 1 COP, 2 SWAT, 3 VICE (tap to cycle), 4 FBI, 5 ARMY. ENTER to confirm");
+		}
+		break;
+	case VCMOD_CHASE_TIER_SELECT:
+		for (int32 tier = 1; tier <= 5; tier++) {
+			if (!KEYJUSTDOWN('0' + tier) || !VCModChaseTierAllowed(tier, nVCModChaseRank))
+				continue;
+			if (tier == 3 && nVCModChaseTier == 3)
+				nVCModChaseVariant = (nVCModChaseVariant + 1) % 8;
+			else
+				nVCModChaseVariant = 0;
+			nVCModChaseTier = tier;
+			bVCModChaseUniformWanted = true;
+
+			char text[96];
+			int32 threat = VCModChaseThreat(tier, VCModChaseCrimeThreat(VCModChaseCrimeForTier(tier)));
+			if (tier == 3)
+				snprintf(text, sizeof(text), "chase: VICE %d of 8, threat %d. ENTER to confirm",
+					nVCModChaseVariant + 1, threat);
+			else
+				snprintf(text, sizeof(text), "chase: %s selected, threat %d. ENTER to confirm",
+					VCModChaseUnitName(VCModChaseUnitForTier(tier)), threat);
+			VCModChaseNotice(text);
+		}
+		if (bVCModChaseUniformWanted)
+			VCModChaseApplyUniform();
+		if (KEYJUSTDOWN(rsENTER)) {
+			if (nVCModChaseTier == 0) {
+				VCModChaseNotice("chase: pick a tier first");
+			} else {
+				VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_CONFIRM);
+				eVCModChaseCrime crime = VCModChaseCrimeForTier(nVCModChaseTier);
+				char brief[96];
+				snprintf(brief, sizeof(brief), "chase: %s, threat %d. ENTER to start, BACKSPACE to cancel",
+					VCModChaseCrimeDispatch(crime), VCModChaseCrimeThreat(crime));
+				VCModChaseNotice(brief);
+			}
+		} else if (KEYJUSTDOWN(rsBACKSP)) {
+			VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_CANCEL);
+			VCModChaseEnd();
+			VCModChaseNotice("chase: cancelled");
+		}
+		break;
+	case VCMOD_CHASE_BRIEFING:
+		if (KEYJUSTDOWN(rsENTER)) {
+			VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_CONFIRM);
+			VCModChaseNotice("chase: the leader is fleeing. BACKSPACE to end");
+		} else if (KEYJUSTDOWN(rsBACKSP)) {
+			VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_CANCEL);
+			VCModChaseEnd();
+			VCModChaseNotice("chase: cancelled");
+		}
+		break;
+	case VCMOD_CHASE_RUNNING:
+		if (pVCModChaseLeaderCar == nil) {
+			if (!VCModChaseSpawnLeader(vecVCModChaseStation))
+				break;
+			// the leader waits while the approach is picked; the go gate only
+			// arms once a start has actually been chosen
+			VCModChaseStartApproach();
+			VCModChaseSetDensity(true);
+		}
+		CPed *leader = VCModChaseLeader();
+		if (leader == nil || leader->DyingOrDead()) {
+			// a driver who dies is destroyed by the engine inside the same world
+			// update, so a nil handle here means he is already gone
+			fprintf(stderr, "VCMOD CHASE leader lost %s\n", leader == nil ? "gone" : "dead");
+			VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_FINISH);
+			VCModChaseEnd();
+			VCModChaseNotice("chase: the leader is down");
+			break;
+		}
+		VCModChaseBlipLeader();
+		VCModChaseTickApproach(player);
+		VCModChaseTickAir(player);
+		VCModChaseTickBoarding(player);
+		// both pools tick during the whole run, air leg included: the crew can
+		// die in the car the heli is shooting at, and a backup car has to be
+		// driven in even while the team is still in the air
+		VCModChaseTickPools(player);
+		VCModChaseTickCrew();
+		if (nVCModChaseSetup == VCMOD_CHASE_SETUP_READY) {
+			if (!bVCModChaseGo) {
+				uint32 now = CTimer::GetTimeInMilliseconds();
+				// no setup pause: he leaves the instant the team is aboard, so the
+				// player cannot catch him parked. The failsafe is the only wait, for
+				// a boarding that never finishes.
+				if (!bVCModChaseBoarding || now >= nVCModChaseGoTime) {
+					bVCModChaseGo = true;
+					VCModChaseDriveTo(VCModChaseBeatCoors(0));
+					VCModChaseNotice("chase: he is moving");
+				}
+			} else if (VCModChaseTickLeader(player)) {
+				VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_FINISH);
+				VCModChaseEnd();
+				break;
+			}
+		}
+		if (KEYJUSTDOWN(rsBACKSP)) {
+			VCModChaseNextState(&nVCModChaseState, VCMOD_CHASE_EV_FINISH);
+			VCModChaseEnd();
+			VCModChaseNotice("chase: ended");
+		}
+		break;
+	}
+}
+
+void
+VCModChaseReset(void)
+{
+	nVCModChaseState = VCMOD_CHASE_OFF;
+	nVCModChaseTier = 0;
+	nVCModChaseVariant = 0;
+	VCModChaseClearScenario();
+	vecVCModChaseStation = vecVCModChaseStationHome;
+	bVCModChaseSpotSet = true;
+	bVCModChaseUniformWanted = false;
+	bVCModChaseRestorePending = false;
+	nVCModChasePreModel = -1;
+	if (nVCModChaseBlip >= 0) {
+		CRadar::ClearBlip(nVCModChaseBlip);
+		nVCModChaseBlip = -1;
+	}
+	nVCModChaseCooldownUntil = 0;
+}
diff --git a/src/extras/vcmodchase.h b/src/extras/vcmodchase.h
new file mode 100644
index 0000000..7387a55
--- /dev/null
+++ b/src/extras/vcmodchase.h
@@ -0,0 +1,66 @@
+#ifndef __VCMODCHASE_H__
+#define __VCMODCHASE_H__
+
+#include "common.h"
+
+enum eVCModChaseState
+{
+	VCMOD_CHASE_OFF,
+	VCMOD_CHASE_TIER_SELECT,
+	VCMOD_CHASE_BRIEFING,
+	VCMOD_CHASE_RUNNING
+};
+
+enum eVCModChaseEvent
+{
+	VCMOD_CHASE_EV_ENTER_MARKER,
+	VCMOD_CHASE_EV_CONFIRM,
+	VCMOD_CHASE_EV_CANCEL,
+	VCMOD_CHASE_EV_FINISH
+};
+
+enum eVCModChaseUnit
+{
+	VCMOD_UNIT_NONE,
+	VCMOD_UNIT_COP,
+	VCMOD_UNIT_SWAT,
+	VCMOD_UNIT_VICE,
+	VCMOD_UNIT_FBI,
+	VCMOD_UNIT_ARMY
+};
+
+enum eVCModChaseCrime
+{
+	VCMOD_CRIME_STORE,
+	VCMOD_CRIME_JEWELRY,
+	VCMOD_CRIME_PROTECTION,
+	VCMOD_CRIME_BANK,
+	VCMOD_CRIME_DRUG_PLANE
+};
+
+bool VCModChaseNextState(eVCModChaseState *state, eVCModChaseEvent event);
+eVCModChaseUnit VCModChaseUnitForTier(int32 tier);
+eVCModChaseCrime VCModChaseCrimeForTier(int32 tier);
+const char *VCModChaseCrimeName(eVCModChaseCrime crime);
+const char *VCModChaseCrimeDispatch(eVCModChaseCrime crime);
+int32 VCModChaseCrimeThreat(eVCModChaseCrime crime);
+int32 VCModChaseThreat(int32 tier, int32 crimeThreat);
+int16 VCModChaseUnitModel(eVCModChaseUnit unit);
+int16 VCModChaseViceModel(int32 variant);
+bool VCModChaseTierAllowed(int32 tier, int32 rank);
+bool VCModChaseHasEscaped(float dist, uint32 awaySince, uint32 now);
+bool VCModChaseLeaderPressured(float dist, bool lineOfSight);
+int32 VCModChaseSquadForThreat(int32 tier, int32 crew, int32 seats, bool withPlayer);
+void VCModChasePoolForTier(int32 tier, int32 *squadActive, int32 *squadReserve,
+                           int32 *crewActive, int32 *crewReserve);
+bool VCModChaseReplaceDue(int32 alive, int32 cap, int32 reserve, uint32 lostSince,
+                          uint32 delay, uint32 now);
+bool VCModChaseRestoreDue(bool pending, bool inControl, bool playerExists);
+bool VCModChaseShouldShowMarker(eVCModChaseState state, bool spotSet);
+float VCModChaseRopeProgress(float t, float rate, float frame, bool up);
+bool VCModChaseAirWrecked(float health, uint32 shootingFor);
+int32 VCModChaseAirSquad(int32 tier);
+void VCModChaseUpdate(void);
+void VCModChaseReset(void);
+
+#endif
diff --git a/src/extras/vcmodinteriors.cpp b/src/extras/vcmodinteriors.cpp
new file mode 100644
index 0000000..840fcf3
--- /dev/null
+++ b/src/extras/vcmodinteriors.cpp
@@ -0,0 +1,90 @@
+#include "common.h"
+
+#include "vcmodinteriors.h"
+
+#include "Building.h"
+#include "CutsceneMgr.h"
+#include "Entity.h"
+#include "Game.h"
+#include "ModelInfo.h"
+#include "Object.h"
+#include "Pools.h"
+#include "Script.h"
+#include "Streaming.h"
+
+// Interior geometry already sits inside its building shell at the real map
+// position, but carries an interior area id, so the streamer only touches it
+// while that area is current. Keeping it resident from the start leaves the
+// scripted door teleport nothing to read from disk.
+static bool s_bInteriorModel[NUMSTREAMINFO];
+
+static bool
+IsInteriorArea(int32 area)
+{
+	return area > AREA_MAIN_MAP && area != AREA_EVERYWHERE;
+}
+
+static void
+MarkInteriorModel(CEntity *entity)
+{
+	int32 model;
+
+	if(entity == nil)
+		return;
+	if(!IsInteriorArea(entity->m_area))
+		return;
+	model = entity->GetModelIndex();
+	if(model >= 0 && model < NUMSTREAMINFO)
+		s_bInteriorModel[model] = true;
+}
+
+void
+VCModInteriorsPreload(void)
+{
+	int32 id, requested, resident;
+
+	memset(s_bInteriorModel, 0, sizeof(s_bInteriorModel));
+
+	for(int i = CPools::GetBuildingPool()->GetSize() - 1; i >= 0; i--)
+		MarkInteriorModel(CPools::GetBuildingPool()->GetSlot(i));
+	for(int i = CPools::GetTreadablePool()->GetSize() - 1; i >= 0; i--)
+		MarkInteriorModel(CPools::GetTreadablePool()->GetSlot(i));
+	for(int i = CPools::GetObjectPool()->GetSize() - 1; i >= 0; i--)
+		MarkInteriorModel(CPools::GetObjectPool()->GetSlot(i));
+	for(int i = CPools::GetDummyPool()->GetSize() - 1; i >= 0; i--)
+		MarkInteriorModel(CPools::GetDummyPool()->GetSlot(i));
+
+	requested = 0;
+	for(id = 0; id < NUMSTREAMINFO; id++)
+		if(s_bInteriorModel[id]){
+			CStreaming::RequestModel(id, STREAMFLAGS_DONT_REMOVE);
+			requested++;
+		}
+	CStreaming::LoadAllRequestedModels(false);
+
+	// A live reference outlives any streaming cleanup: RemoveAllUnusedModels and
+	// RemoveLeastUsedModel both skip models that are in use.
+	resident = 0;
+	for(id = 0; id < NUMSTREAMINFO; id++)
+		if(s_bInteriorModel[id] && CStreaming::HasModelLoaded(id)){
+			if(CModelInfo::GetModelInfo(id)->GetNumRefs() == 0)
+				CModelInfo::GetModelInfo(id)->AddRef();
+			resident++;
+		}
+
+	debug("vcm: %d/%d interior models resident, streaming at %zuK\n",
+	      resident, requested, CStreaming::ms_memoryUsed / 1024);
+}
+
+float
+VCModInteriorDoorFade(float seconds)
+{
+	// Door fades are authored at 0.5s; longer ones belong to missions and
+	// cutscenes, which keep their pacing.
+	if(seconds > 0.0f && seconds <= 0.7f &&
+	   !CCutsceneMgr::IsCutsceneProcessing() && !CTheScripts::IsPlayerOnAMission()){
+		debug("vcm: door fade %.2fs -> 0.10s\n", seconds);
+		return 0.1f;
+	}
+	return seconds;
+}
