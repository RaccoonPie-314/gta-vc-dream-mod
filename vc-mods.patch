+// anim group a model brings with it (false for Tommy and unusable groups)
+int32 VCModPedCategoryOf(int32 pedType);
+int32 VCModPedModelCount(int32 category);
+bool VCModPedModelAt(int32 category, int32 entry, int16 *outIndex, const char **outName);
+bool VCModPedAnimGroupFor(int16 modelIndex, AssocGroupId *out);
+// becomes that model, false when it cannot be done right now
+bool VCModApplyPedModel(int16 modelIndex);
+// a new body or anim set is a new character, so it rolls a fresh ped pace
+void VCModRollPlayerPace(void);
+
+// ride destinations: entry 0 lets traffic drive, the rest are the map zones the
+// game loaded (zone 0 is the whole-map box, so it is never offered)
+int32 VCModRideZoneCount(void);
+bool VCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos);
+// takes over an enter-vehicle press so Tommy rides as a passenger; false means
+// the press is not ours and the stock driver entry should happen
+bool VCModPassengerEntry(CVehicle *vehicle);
+// where the ride has got to, one of eVCModRidePhase
+int32 VCModRidePhase(void);
+// calls the limo, or dismisses the one already on its way
+void VCModCallDriver(void);
+// one-shot travel to the RIDE TO destination; never part of the enter press
+void VCModSkipRide(void);
+
+#ifdef DEBUGMENU
+void VCModPanelRender(void);
+#endif
+
+#endif
diff --git a/src/extras/vcmodpathprobe.cpp b/src/extras/vcmodpathprobe.cpp
new file mode 100644
index 0000000..e2ec92d
--- /dev/null
+++ b/src/extras/vcmodpathprobe.cpp
@@ -0,0 +1,99 @@
+#include "common.h"
+
+#include "vcmodpathprobe.h"
+
+#include "AutoPilot.h"
+#include "PathFind.h"
+#include "PlayerInfo.h"
+#include "Pools.h"
+#include "Vehicle.h"
+
+// A car sits (lane + OneWayLaneOffset()) * LANE_WIDTH sideways of its path node,
+// and OneWayLaneOffset hangs off that node's width and lane counts alone. So when
+// traffic ends up on the kerb, these two cells name the car and the numbers that
+// put it there, and the correction is measured instead of guessed.
+//
+// The car's own position stands in for the node's: both are world coordinates, and
+// the pair differs by less than the offset we are reading.
+
+static void
+ProbeCells(const char **nodeCell, const char **laneCell)
+{
+	static char aNode[32];
+	static char aLane[32];
+
+	*nodeCell = "no car nearby";
+	*laneCell = "";
+
+	CVehiclePool *pool = CPools::GetVehiclePool();
+	if (pool == nil)
+		return;
+
+	CVector probe = FindPlayerCoors();
+	float nearestDist = 1.0e30f;
+	CVehicle *nearest = nil;
+	float roadDist = 1.0e30f;
+	CVehicle *onRoad = nil;
+
+	for (int32 i = 0; i < pool->GetSize(); i++) {
+		CVehicle *v = pool->GetSlot(i);
+		if (v == nil)
+			continue;
+
+		float dist = (v->GetPosition() - probe).Magnitude();
+		if (dist < nearestDist) {
+			nearestDist = dist;
+			nearest = v;
+		}
+		// a parked car has no current link, so it cannot answer the question
+		if (v->AutoPilot.m_nCarMission == MISSION_NONE)
+			continue;
+		if (v->AutoPilot.m_nCurrentPathNodeInfo >= (uint32) ThePaths.m_numCarPathLinks)
+			continue;
+		if (dist < roadDist) {
+			roadDist = dist;
+			onRoad = v;
+		}
+	}
+
+	CVehicle *v = onRoad != nil ? onRoad : nearest;
+	if (v == nil) {
+		*nodeCell = "no car nearby";
+		return;
+	}
+
+	CVector pos = v->GetPosition();
+	*nodeCell = aNode;
+
+	if (onRoad == nil) {
+		snprintf(aNode, sizeof(aNode), "%d,%d", (int32) pos.x, (int32) pos.y);
+		*laneCell = "no path link";
+		return;
+	}
+
+	CCarPathLink *link = &ThePaths.m_carPathLinks[onRoad->AutoPilot.m_nCurrentPathNodeInfo];
+	float offset = (onRoad->AutoPilot.m_nCurrentLane + link->OneWayLaneOffset()) * LANE_WIDTH;
+
+	snprintf(aNode, sizeof(aNode), "%d,%d w%.1f",
+		(int32) pos.x, (int32) pos.y, link->width / 8.0f);
+	snprintf(aLane, sizeof(aLane), "%d/%d L%d off%.1f",
+		link->numLeftLanes, link->numRightLanes,
+		onRoad->AutoPilot.m_nCurrentLane, offset);
+	*laneCell = aLane;
+}
+
+const char *
+VCModPathProbeNodeCell(void)
+{
+	const char *node, *lane;
+	ProbeCells(&node, &lane);
+	return node;
+}
+
+const char *
+VCModPathProbeLaneCell(void)
+{
+	const char *node, *lane;
+	ProbeCells(&node, &lane);
+	return lane;
+}
