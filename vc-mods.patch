new file mode 100644
index 0000000..5f7dd87
--- /dev/null
+++ b/src/extras/vcmodexplosion.cpp
@@ -0,0 +1,35 @@
+#include "common.h"
+
+#include "vcmodexplosion.h"
+
+#include "Entity.h"
+#include "World.h"
+
+bool bVCModExplosionCover = true;
+
+bool
+VCModExplosionReaches(const CVector &from, CEntity *entity)
+{
+	if (!bVCModExplosionCover || entity == nil)
+		return true;
+
+	// tested at torso height: a blast sitting on the ground must not block
+	// itself on the ground it is standing on
+	CVector start = from;
+	start.z += 0.5f;
+	CVector to = entity->GetPosition();
+	to.z += 0.5f;
+
+	CVector dir = to - start;
+	float len = dir.Magnitude();
+	if (len < 1.0f)
+		return true;
+	// a blast that went off against a wall has its centre inside that wall's
+	// col model, so the ray starts a step out: it reads the wall in between,
+	// not the one the grenade was touching
+	start += dir * (0.5f / len);
+
+	// walls are buildings; vehicles, peds and props do not shield a blast
+	return CWorld::GetIsLineOfSightClear(start, to,
+	                                     true, false, false, false, false, false);
+}
