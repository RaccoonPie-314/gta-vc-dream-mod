@@ -0,0 +1,133 @@
+#!/usr/bin/env python3
+"""CPed::Say's speech gates: the camera-speed rule mutes generic lines while
+the view swings, which silenced NPC-mode Tommy because his camera is his own
+viewpoint. He must be exempt while the mode is on; stock peds must keep it.
+"""
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+CHAT = (ROOT / "src/peds/PedChat.cpp").read_text()
+
+SIG = "void\nCPed::Say(uint16 audio)"
+
+STUBS = r'''
+#include <cstdio>
+#define nil NULL
+typedef unsigned short uint16;
+typedef unsigned int uint32;
+typedef int int32;
+typedef int bool8;
+enum { SOUND_NO_SOUND = 9999, SOUND_PED_DEATH = 1000, SOUND_PED_DAMAGE, SOUND_PED_HIT,
+       SOUND_PED_LAND, SOUND_PED_BURNING, SOUND_PED_FLEE_SPRINT, SOUND_PED_TAXI_WAIT,
+       SOUND_PED_EVADE, SOUND_PED_CRASH_VEHICLE, SOUND_PED_CRASH_CAR,
+       SOUND_PED_ANNOYED_DRIVER, SOUND_PED_CHAT, SOUND_PED_INNOCENT,
+       SOUND_PED_COP_ASK_FOR_ID };
+struct PedAudioData { uint32 m_nDelayTime, m_nFixedDelayTime, m_nMaxRandomDelayTime, m_nOverrideMaxRandomDelayTime; };
+extern PedAudioData CommentWaitTime[56];
+PedAudioData CommentWaitTime[56] = { {0,0,0,0} };
+struct CVector { float x, y, z; float z_() const { return z; } };
+struct CCamera {
+    float m_CameraAverageSpeed;
+    CVector GetPosition(void) { return CVector(); }
+};
+CCamera TheCamera;
+struct CTimer { static uint32 GetTimeInMilliseconds(void) { return 0; } };
+struct CGeneral { static uint32 GetRandomNumberInRange(uint32 a, uint32 b) { return a; } };
+bool bVCModNpcMode;
+struct CPed {
+    uint16 m_queuedSound;
+    uint16 m_lastQueuedSound;
+    uint32 m_lastSoundStart;
+    bool player;
+    CPed() : m_queuedSound(SOUND_NO_SOUND), m_lastQueuedSound(SOUND_NO_SOUND), m_lastSoundStart(0), player(false) {}
+    CVector GetPosition(void) { return CVector(); }
+    bool IsPlayer(void) { return player; }
+    void Say(uint16 audio);
+};
+'''
+
+# CommentWaitTime's array initialiser lives in the file; the body needs only the
+# index maths, so the table above is enough
+
+
+def source():
+    return STUBS + "\n" + braced(CHAT, SIG) + "\n"
+
+
+class NpcVoiceTests(unittest.TestCase):
+    def test_npc_mode_player_speaks_while_the_camera_moves(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPed tommy; tommy.player = true;
+    bVCModNpcMode = true;
+    TheCamera.m_CameraAverageSpeed = 2.0f;   // walking: the gate would drop it
+    tommy.Say(SOUND_PED_CHAT);
+    if (tommy.m_queuedSound != SOUND_PED_CHAT) return 1;
+    return 0;
+}
+''')
+
+    def test_stock_rules_still_apply_to_the_player_outside_npc_mode(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPed tommy; tommy.player = true;
+    bVCModNpcMode = false;
+    TheCamera.m_CameraAverageSpeed = 2.0f;
+    tommy.Say(SOUND_PED_CHAT);
+    if (tommy.m_queuedSound != SOUND_NO_SOUND) return 1;
+    return 0;
+}
+''')
+
+    def test_stock_rules_still_apply_to_peds(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPed cop;
+    bVCModNpcMode = true;                    // the mode must not leak to peds
+    TheCamera.m_CameraAverageSpeed = 2.0f;
+    cop.Say(SOUND_PED_CHAT);
+    if (cop.m_queuedSound != SOUND_NO_SOUND) return 1;
+    return 0;
+}
+''')
+
+    def test_the_id_check_exchange_survives_the_moving_camera(self):
+        run_cpp(source() + r'''
+int main(void) {
+    // the citizen answering Tommy's ID check is not the player, and the
+    // exchange happens while he runs, so both its lines ride through the gate
+    CPed civ; CPed cop;
+    bVCModNpcMode = true;
+    TheCamera.m_CameraAverageSpeed = 2.0f;
+    civ.Say(SOUND_PED_INNOCENT);
+    if (civ.m_queuedSound != SOUND_PED_INNOCENT) return 1;
+    cop.player = true;
+    cop.Say(SOUND_PED_COP_ASK_FOR_ID);
+    if (cop.m_queuedSound != SOUND_PED_COP_ASK_FOR_ID) return 2;
+    // outside the mode the stock rules still drop them
+    CPed civ2;
+    bVCModNpcMode = false;
+    civ2.Say(SOUND_PED_INNOCENT);
+    if (civ2.m_queuedSound != SOUND_NO_SOUND) return 3;
+    return 0;
+}
+''')
+
+    def test_a_slow_camera_keeps_everyone_talking(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPed cop;
+    bVCModNpcMode = false;
+    TheCamera.m_CameraAverageSpeed = 0.1f;
+    cop.Say(SOUND_PED_CHAT);
+    if (cop.m_queuedSound != SOUND_PED_CHAT) return 1;
+    return 0;
+}
+''')
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/utils/test_vc_npcwalk.py b/utils/test_vc_npcwalk.py
new file mode 100644
index 0000000..447e616
--- /dev/null
+++ b/utils/test_vc_npcwalk.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""The NPC-mode stroll gait: the engine's move state flips WALK/RUN/STILL on
+consecutive frames while he walks a path. The table value assigned per frame
+snapped his speed and restarted the walk clip (the visible flicker), so the
+speed is eased and the gait comes from the eased value.
+"""
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+NPC = (ROOT / "src/extras/vcmodnpc.cpp").read_text()
+
+SIG = "void\nVCModNpcStrollGait(CPlayerPed *ped)"
+
+STUBS = r'''
+#include <cstdio>
+#define nil NULL
+typedef int int32;
+typedef unsigned uint32;
+enum eMoveState { PEDMOVE_NONE, PEDMOVE_STILL, PEDMOVE_WALK, PEDMOVE_JOG, PEDMOVE_RUN, PEDMOVE_SPRINT };
+enum { WAITSTATE_FALSE = 0 };
+template <class T> T Min(T a, T b) { return a < b ? a : b; }
+struct CTimer { static float GetTimeStep(void) { return 50.0f / 30.0f; } };
+struct CPed {};
+struct CPlayerPed : CPed {
+    eMoveState m_nMoveState;
+    eMoveState m_nStoredMoveState;
+    int m_nWaitState;
+    float m_fMoveSpeed;
+    int anims;
+    CPlayerPed() : m_nMoveState(PEDMOVE_WALK), m_nStoredMoveState(PEDMOVE_NONE),
+                   m_nWaitState(WAITSTATE_FALSE), m_fMoveSpeed(0), anims(0) {}
+    void SetRealMoveAnim(void) { ++anims; }
+};
+static float fVCModNpcStrollSpeed;
+'''
+
+
+def source():
+    return STUBS + "\n" + braced(NPC, SIG) + "\n"
+
+
+class StrollGaitTests(unittest.TestCase):
+    def test_speed_eases_instead_of_snapping(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPlayerPed ped;
+    ped.m_nMoveState = PEDMOVE_RUN;
+    VCModNpcStrollGait(&ped);
+    if (ped.m_fMoveSpeed <= 0.0f) return 1;      // moving
+    if (ped.m_fMoveSpeed >= 1.8f) return 2;      // but not at full speed in one frame
+    return 0;
+}
+''')
+
+    def test_a_one_frame_still_does_not_break_the_walk(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPlayerPed ped;
+    ped.m_nMoveState = PEDMOVE_RUN;
+    for (int i = 0; i < 40; ++i) VCModNpcStrollGait(&ped);
+    if (ped.m_fMoveSpeed < 1.5f) return 1;       // cruising
+    ped.m_nMoveState = PEDMOVE_STILL;            // the engine's per-frame flip
+    VCModNpcStrollGait(&ped);
+    if (ped.m_nMoveState == PEDMOVE_STILL) return 2;   // gait kept
+    if (ped.m_nStoredMoveState != ped.m_nMoveState) return 3;
+    return 0;
+}
+''')
+
+    def test_a_real_stop_settles(self):
+        run_cpp(source() + r'''
+int main(void) {
+    CPlayerPed ped;
+    ped.m_nMoveState = PEDMOVE_RUN;
+    for (int i = 0; i < 40; ++i) VCModNpcStrollGait(&ped);
+    // the engine re-decides the state every frame; a real stop keeps saying STILL
+    for (int i = 0; i < 120; ++i) {
+        ped.m_nMoveState = PEDMOVE_STILL;
+        VCModNpcStrollGait(&ped);
+    }
+    if (ped.m_nMoveState != PEDMOVE_STILL) return 1;
+    if (ped.m_fMoveSpeed > 0.05f) return 2;
+    return 0;
+}
+''')
+
+
+if __name__ == "__main__":
+    unittest.main()
