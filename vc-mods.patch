@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""Panel rows explain themselves: every row has a short description and an
+optional warning, shown for the row under the pointer."""
+import re
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+START = "const VCModRowDef aVCModRows[] = {"
+BEGIN = PANEL.index(START) + len(START)
+TABLE = PANEL[BEGIN : PANEL.index("\n};", BEGIN)]
+
+ROW_LIMIT = 50
+WARN_LIMIT = 48
+
+
+def split_fields(text):
+    fields = []
+    current = ""
+    quoted = False
+    for char in text:
+        if quoted:
+            current += char
+            if char == '"':
+                quoted = False
+        elif char == '"':
+            quoted = True
+            current += char
+        elif char == ",":
+            fields.append(current.strip())
+            current = ""
+        else:
+            current += char
+    if current.strip():
+        fields.append(current.strip())
+    return fields
+
+
+def table_rows():
+    rows = []
+    for entry in re.findall(r"\{(.*?)\},", TABLE, re.S):
+        if "VCMOD_ROW_" not in entry:
+            continue
+        rows.append(split_fields(entry))
+    return rows
+
+
+class PanelInfoTests(unittest.TestCase):
+    def test_every_row_has_a_description(self):
+        rows = table_rows()
+        self.assertGreaterEqual(len(rows), 56)
+        names = set()
+        for fields in rows:
+            self.assertEqual(len(fields), 9, fields)
+            name = fields[0].strip('"')
+            self.assertNotIn(name, names, "duplicate row name")
+            names.add(name)
+
+            info = fields[7]
+            self.assertTrue(info.startswith('"') and info.endswith('"'),
+                            "row without info: " + name)
+            self.assertLessEqual(len(info) - 2, ROW_LIMIT, name)
+
+            warn = fields[8]
+            if warn != "nil":
+                self.assertTrue(warn.startswith('"') and warn.endswith('"'),
+                                "row warning is not text: " + name)
+                self.assertLessEqual(len(warn) - 2, WARN_LIMIT, name)
+
+    def test_a_warning_survives_on_a_risky_row(self):
+        rows = {fields[0].strip('"'): fields for fields in table_rows()}
+        self.assertNotEqual(rows["BECOME NPC"][8], "nil")
+        self.assertNotEqual(rows["NEVER WANTED"][8], "nil")
+        self.assertEqual(rows["FREEAIM+LOCKON"][8], "nil")
+
+    def test_render_shows_the_hovered_row(self):
+        self.assertIn("hover = &aVCModRows[index];", PANEL)
+        self.assertIn("nVCModHelpRow = index;", PANEL)
+        self.assertIn("help = &aVCModRows[nVCModHelpRow];", PANEL)
+        self.assertIn("help->info", PANEL)
+        self.assertIn("help->warn", PANEL)
+        self.assertIn('"INFO  %s"', PANEL)
+        self.assertIn('"! %s"', PANEL)
+        self.assertIn('VCModPrint(VCFONT_WARN, "!"', PANEL)
+        self.assertIn("infoLine[fullCols] = '\\0';", PANEL)
+
+
+if __name__ == "__main__":
+    unittest.main()
