--- /dev/null
+++ b/src/extras/vcmodgang.cpp
@@ -0,0 +1,107 @@
+#include "common.h"
+
+#include "vcmodgang.h"
+#include "vcmodnpc.h"
+#include "vcmoddiag.h"
+
+#include "AnimBlendAssociation.h"
+#include "AnimationId.h"
+#include "Ped.h"
+#include "PedType.h"
+#include "RpAnimBlend.h"
+#include "Stats.h"
+#include "Timer.h"
+#include "Weapon.h"
+
+// the gang profile reads Tommy as GANG7 for the gang bit/type decisions while his
+// real type stays PLAYER1; every other ped reports his own type unchanged
+int32
+VCModGangEffectiveType(CPed *ped)
+{
+	if (ped->IsPlayer() && VCModNpcGangActive())
+		return PEDTYPE_GANG7;
+	return ped->m_nPedType;
+}
+
+// Fearless gang Tommy: refuse fear-driven flee objectives so a cop's
+// CopPatrolScan (or any threat reaction) can't override his fight objective.
+// The flee STATE is gated in SetFlee; this gates the OBJECTIVE itself.
+bool
+VCModGangRefuseFleeObjective(CPed *ped, int32 newObj)
+{
+	if (ped->IsPlayer() && VCModNpcGangActive()
+		&& (newObj == OBJECTIVE_FLEE_ON_FOOT_TILL_SAFE
+			|| newObj == OBJECTIVE_FLEE_CHAR_ON_FOOT_TILL_SAFE
+			|| newObj == OBJECTIVE_FLEE_CHAR_ON_FOOT_ALWAYS)) {
+		VCMOD_DIAG("VCMOD gang obj: REFUSED flee new=%d (keeping %d)\n", newObj, ped->m_objective);
+		return true;
+	}
+	return false;
+}
+
+void
+VCModGangNoteObjective(CPed *ped, int32 newObj)
+{
+	if (ped->IsPlayer() && VCModNpcGangActive()) {
+		static uint32 nVCModGangObjDiag = 0;
+		uint32 now = CTimer::GetTimeInMilliseconds();
+		if (now >= nVCModGangObjDiag) {
+			nVCModGangObjDiag = now + 250;
+			VCMOD_DIAG("VCMOD gang obj: new=%d old=%d prev=%d state=%d\n",
+				newObj, ped->m_objective, ped->m_prevObjective, ped->m_nPedState);
+		}
+	}
+}
+
+void
+VCModGangInterruptKillPose(CPed *ped, int32 newObj)
+{
+	if (ped->IsPlayer() && VCModNpcGangActive() && ped->m_nWaitState == WAITSTATE_DOUBLEBACK
+		&& (newObj == OBJECTIVE_KILL_CHAR_ON_FOOT || newObj == OBJECTIVE_KILL_CHAR_ANY_MEANS)) {
+		ped->ClearWaitState();
+		ped->RestoreHeadingRate();
+		CAnimBlendAssociation *pose = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_IDLE_HBHB);
+		if (pose) {
+			pose->blendDelta = -8.0f;
+			pose->flags |= ASSOC_DELETEFADEDOUT;
+		}
+	}
+}
+
+void
+VCModGangNoteReact(CPed *ped, CEntity *attacker)
+{
+	if (ped->IsPlayer() && VCModNpcGangActive()) {
+		static uint32 nVCModGangReactDiag = 0;
+		uint32 now = CTimer::GetTimeInMilliseconds();
+		if (now >= nVCModGangReactDiag) {
+			nVCModGangReactDiag = now + 1000;
+			CPed *atk = attacker->IsPed() ? (CPed*)attacker : nil;
+			VCMOD_DIAG("VCMOD gang react: state=%d ctrl=%d created=%d myMelee=%d atkMelee=%d fear=%d atkTemper=%d\n",
+				ped->m_nPedState, ped->IsPedInControl(), ped->CharCreatedBy,
+				ped->GetWeapon()->IsTypeMelee(), atk ? atk->GetWeapon()->IsTypeMelee() : -1,
+				ped->m_pedStats->m_fear, atk ? atk->m_pedStats->m_temper : -1);
+		}
+	}
+}
+
+bool
+VCModGangFightBack(CPed *ped, CPed *attacker)
+{
+	if (!(ped->IsPlayer() && VCModNpcGangActive()))
+		return false;
+	VCMOD_DIAG("VCMOD gang react -> FIGHT (fearless)\n");
+	ped->RegisterThreatWithGangPeds(attacker);
+	ped->SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, attacker);
+	// no expiry: fight until the target dies (the kill objective completes
+	// on death), not a 20s timer that drops him back to wandering
+	ped->SetObjectiveTimer(0);
+	return true;
+}
+
+void
+VCModGangReactDiag(CPed *ped, const char *decision)
+{
+	if (ped->IsPlayer() && VCModNpcGangActive())
+		VCMOD_DIAG("VCMOD gang react -> %s\n", decision);
+}
