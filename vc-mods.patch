+#!/usr/bin/env python3
+"""Rear lights: the tail lamps stay red while reversing. The stock code washes
+them white, which reads as the red being overwritten; the white belongs to the
+reversing lamps on models that carry them."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+MODELINFO_H = ROOT / "src/modelinfo/VehicleModelInfo.h"
+MODELINFO = ROOT / "src/modelinfo/VehicleModelInfo.cpp"
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+
+
+class RearLightTests(unittest.TestCase):
+    def test_reverse_keeps_red(self):
+        auto = AUTO.read_text()
+        anchor = auto.index("// Taillight coronas")
+        start = auto.index("if(m_fGasPedal < 0.0f){", anchor)
+        end = auto.index("if(m_fBrakePedal > 0.0f){", start)
+        reverse = auto[start:end]
+
+        self.assertEqual(reverse.count("128*intensity, 0, 0, 255"), 2)
+        self.assertNotIn("128*intensity, 128*intensity, 128*intensity", reverse)
+        self.assertNotIn("128, 128, 128", reverse)
+
+    def test_no_reversing_marker(self):
+        # the marker only existed for the red/white split; with the tails red
+        # always it has no reader
+        self.assertNotIn("CAR_POS_REVERSINGLIGHTS", MODELINFO_H.read_text())
+        self.assertNotIn("CAR_POS_REVERSINGLIGHTS", MODELINFO.read_text())
+        self.assertNotIn("CAR_POS_REVERSINGLIGHTS", AUTO.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
