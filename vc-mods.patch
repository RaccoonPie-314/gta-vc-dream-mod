+#!/usr/bin/env python3
+"""Steering wheel: the pack's car models carry a `steeringwheel` node of their
+own, so the engine turns it with the road wheels instead of leaving it fixed."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+MOD = ROOT / "src/extras/vcmodsteering.cpp"
+MOD_H = ROOT / "src/extras/vcmodsteering.h"
+VEH = ROOT / "src/vehicles/Vehicle.h"
+MODELINFO = ROOT / "src/modelinfo/VehicleModelInfo.cpp"
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+AUTO_H = ROOT / "src/vehicles/Automobile.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class SteeringWheelTests(unittest.TestCase):
+    def test_node_is_named_and_drawn(self):
+        veh = VEH.read_text()
+        self.assertIn("CAR_STEERING_WHEEL,", veh)
+        self.assertLess(veh.index("CAR_STEERING_WHEEL"),
+                        veh.index("NUM_CAR_NODES"))
+        self.assertIn('{ "steeringwheel",\tCAR_STEERING_WHEEL,\t0 },',
+                      MODELINFO.read_text())
+
+    def test_turn_follows_steer_angle(self):
+        mod = MOD.read_text()
+        self.assertIn("bool bVCModSteeringWheel = true;", mod)
+        self.assertIn("#define VCMOD_STEERING_WHEEL_RATIO\t4.0f", mod)
+        self.assertIn("car->m_fSteerAngle * VCMOD_STEERING_WHEEL_RATIO", mod)
+        # the wheel is a disc in its own XZ plane
+        self.assertIn("CVector axis(0.0f, 1.0f, 0.0f);", mod)
+        self.assertIn("RwMatrix result = car->m_steeringWheelRest;", mod)
+        self.assertIn("rwCOMBINEPOSTCONCAT", mod)
+        # a parked car does not dirty its clump on its own
+        self.assertIn("RwFrameUpdateObjects(frame);", mod)
+        self.assertIn("m_aCarNodes[CAR_STEERING_WHEEL]", mod)
+
+    def test_rest_orientation(self):
+        auto_h = AUTO_H.read_text()
+        self.assertIn("RwMatrix m_steeringWheelRest;", auto_h)
+        self.assertIn("bool m_steeringWheelRestValid;", auto_h)
+        self.assertIn("float m_steeringWheelAngle;", auto_h)
+        auto = AUTO.read_text()
+        setup = braced(auto, "CAutomobile::SetupModelNodes")
+        self.assertIn("m_steeringWheelRestValid = false;", setup)
+        self.assertIn("m_steeringWheelAngle = 0.0f;", setup)
+
+    def test_called_after_steering(self):
+        auto = AUTO.read_text()
+        self.assertIn('#include "vcmodsteering.h"', auto)
+        # the body has conditional blocks the naive brace matcher would trip on
+        start = auto.index("CAutomobile::ProcessControl(void)")
+        process = auto[start:auto.index("CAutomobile::FireTruckControl")]
+        self.assertIn("if(bVCModSteeringWheel)", process)
+        self.assertIn("VCModSteeringWheelUpdate(this);", process)
+        self.assertLess(process.index("m_fSteerAngle = DEGTORAD"),
+                        process.index("VCModSteeringWheelUpdate(this);"))
+
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        self.assertIn('"STEERING WHEEL"', rows)
+        self.assertIn("&bVCModSteeringWheel", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "SteeringWheel"', INI.read_text())
+        self.assertIn("extern bool bVCModSteeringWheel;", MOD_H.read_text())
+
+
+if __name__ == "__main__":
+    unittest.main()
