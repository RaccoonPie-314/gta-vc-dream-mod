diff --git a/src/extras/vcmodspawn.cpp b/src/extras/vcmodspawn.cpp
new file mode 100644
index 0000000..47417a9
--- /dev/null
+++ b/src/extras/vcmodspawn.cpp
@@ -0,0 +1,133 @@
+#include "common.h"
+
+#include "vcmodspawn.h"
+
+#include "Automobile.h"
+#include "CarAI.h"
+#include "CarCtrl.h"
+#include "ModelInfo.h"
+#include "PlayerPed.h"
+#include "Script.h"
+#include "Streaming.h"
+#include "Vehicle.h"
+#include "World.h"
+
+#define VCMOD_SPAWN_MAX	128
+
+static int16 aVCModSpawnModels[VCMOD_SPAWN_MAX];
+static int32 nVCModSpawnModels = -1;
+static int32 nVCModSpawnPending = -1;
+
+static const struct {
+	const char *model;
+	const char *label;
+} aVCModSpawnNames[] = {
+	{ "vicechee", "Vice Cheetah" },
+	{ "police", "Police cruiser" },
+	{ "fbicar", "FBI Car" },
+	{ "fbiranch", "FBI Rancher" },
+	{ "enforcer", "Enforcer" },
+	{ "ambulan", "Ambulance" },
+	{ "firetruk", "Firetruck" },
+};
+
+static const char *
+VCModSpawnLabel(const char *model)
+{
+	for(uint32 i = 0; i < ARRAY_SIZE(aVCModSpawnNames); i++)
+		if(strcmp(aVCModSpawnNames[i].model, model) == 0)
+			return aVCModSpawnNames[i].label;
+	return model;
+}
+
+// the list is every car model this install can load, sorted by the name the
+// IDE uses, so the panel list is scrolled by name instead of by model index
+static void
+VCModSpawnBuild(void)
+{
+	nVCModSpawnModels = 0;
+	for(int32 i = 0; i < MODELINFOSIZE && nVCModSpawnModels < VCMOD_SPAWN_MAX; i++){
+		CBaseModelInfo *info = CModelInfo::GetModelInfo(i);
+		if(info == nil || info->GetModelType() != MITYPE_VEHICLE)
+			continue;
+		if(((CVehicleModelInfo*)info)->m_vehicleType != VEHICLE_TYPE_CAR)
+			continue;
+		int32 j = nVCModSpawnModels;
+		while(j > 0 && strcmp(((CBaseModelInfo*)CModelInfo::GetModelInfo(aVCModSpawnModels[j-1]))->GetModelName(),
+		                      info->GetModelName()) > 0){
+			aVCModSpawnModels[j] = aVCModSpawnModels[j-1];
+			j--;
+		}
+		aVCModSpawnModels[j] = i;
+		nVCModSpawnModels++;
+	}
+}
+
+int32
+VCModSpawnCount(void)
+{
+	if(nVCModSpawnModels < 0)
+		VCModSpawnBuild();
+	return nVCModSpawnModels;
+}
+
+const char *
+VCModSpawnModelName(int32 entry)
+{
+	if(entry < 0 || entry >= VCModSpawnCount())
+		return "";
+	return ((CBaseModelInfo*)CModelInfo::GetModelInfo(aVCModSpawnModels[entry]))->GetModelName();
+}
+
+const char *
+VCModSpawnName(int32 entry)
+{
+	if(entry < 0 || entry >= VCModSpawnCount())
+		return "unknown";
+	return VCModSpawnLabel(VCModSpawnModelName(entry));
+}
+
+bool
+VCModSpawnPick(int32 entry)
+{
+	if(entry < 0 || entry >= VCModSpawnCount())
+		return false;
+	nVCModSpawnPending = aVCModSpawnModels[entry];
+	return true;
+}
+
+void
+VCModSpawnTick(void)
+{
+	if(nVCModSpawnPending < 0)
+		return;
+	int16 model = nVCModSpawnPending;
+	nVCModSpawnPending = -1;
+
+	CPlayerPed *player = FindPlayerPed();
+	if(player == nil)
+		return;
+
+	CStreaming::RequestModel(model, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if(!CStreaming::HasModelLoaded(model))
+		return;
+
+	CVector pos = player->GetPosition() + player->GetForward()*4.5f;
+	CAutomobile *car = new CAutomobile(model, RANDOM_VEHICLE);
+	if(car == nil)
+		return;
+
+	car->m_nDoorLock = CARLOCK_UNLOCKED;
+	pos.z += car->GetDistanceFromCentreOfMassToBaseOfModel();
+	CTheScripts::ClearSpaceForMissionEntity(pos, car);
+	car->SetPosition(pos);
+	car->PlaceOnRoadProperly();
+	car->SetStatus(STATUS_PHYSICS);
+	car->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	car->AutoPilot.m_nCruiseSpeed = 0;
+	car->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	CWorld::Add(car);
+}
