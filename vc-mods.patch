+
+#include "common.h"
+
+class CVehicleModelInfo;
+
+// The pack's car and bike models carry a lit lamp texture next to the unlit
+// one; stock VC only ever had the unlit face, so the lamps never glowed.
+extern bool bVCModLightTextures;
+
+// called for every material while the model's editable list is rebuilt
+void VCModLightTextCollect(CVehicleModelInfo *mi, RpMaterial *material);
+
+// called just before a vehicle draws, because the materials are shared by
+// every car of the model and only the drawing car knows whether its lights are
+// on (same reason SetVehicleColour runs here)
+void VCModLightTextRender(CVehicleModelInfo *mi, bool lightsOn, bool serviceOn);
+
+#endif
diff --git a/src/extras/vcmodnpc.cpp b/src/extras/vcmodnpc.cpp
new file mode 100644
index 0000000..2bfec63
--- /dev/null
+++ b/src/extras/vcmodnpc.cpp
@@ -0,0 +1,681 @@
+#include "common.h"
+
+#include <string.h>
+
+#include "vcmodnpc.h"
+#include "vcmodsit.h"
+#include "vcmodstreet.h"
+#include "vcmodcombat.h"
+#include "vcmoddiag.h"
+
+#include "DMAudio.h"
+#include "General.h"
+#include "ModelIndices.h"
+#include "ModelInfo.h"
+#include "Pad.h"
+#include "Ped.h"
+#include "PedAttractor.h"
+#include "PedModelInfo.h"
+#include "PedType.h"
+#include "PlayerInfo.h"
+#include "PlayerPed.h"
+#include "Timer.h"
+#include "Wanted.h"
+#include "Weapon.h"
+#include "WeaponInfo.h"
+#include "World.h"
+
+bool bVCModNpcMode = false;
+int32 nVCModNpcType = 0;
+bool bVCModCopQuickChecks = false;
+
+// the NPC profiles borrow ped stats (and the gang flags) while they drive him;
+// save the player's own so a break/off/switch restores them exactly. The borrowed
+// stat is the worn body's own, or the gang temperament / strong variant
+static CPedStats *pVCModNpcSavedStats = nil;
+static uint8 nVCModNpcSavedGangFlags = 0;
+static bool bVCModNpcStatsBorrowed = false;
+
+bool
+VCModNpcStatsBorrowed(void)
+{
+	return bVCModNpcStatsBorrowed;
+}
+
+// the manual NPC command: edge detection for the toggle-off, and a retry gap so
+// pathless ground does not search for a path node every frame
+static bool bVCModNpcModeWasOn;
+// the command forces STREET IDLE off while it runs; this is the player's own
+// setting, handed back on toggle-off so the reset is complete
+static bool bVCModNpcSavedStreetIdle;
+static uint32 nVCModNpcNextTry;
+#define VCMOD_NPC_RETRY_GAP 500
+// the engine's move state flips WALK/RUN/STILL on consecutive frames while he
+// walks a path (Seek re-decides every frame), and assigning its table value each
+// frame snapped the speed 0/1/1.8 and restarted the walk clip: the visible
+// flicker. Ease toward the target, pick the gait from the eased speed, and a
+// one-frame STILL no longer breaks the walk
+static float fVCModNpcStrollSpeed;
+void
+VCModNpcStrollGait(CPlayerPed *ped)
+{
+	// a wait state owns the body: the blocked-ped tired pose, the after-kill
+	// hands-behind-back, the look-arounds. The stroll's speed and its walk clip
+	// blend over that pose about a second in, so stand down until it ends.
+	if (ped->m_nWaitState != WAITSTATE_FALSE) {
+		fVCModNpcStrollSpeed = 0.0f;
+		ped->m_fMoveSpeed = 0.0f;
+		return;
+	}
+	float target = ped->m_nMoveState == PEDMOVE_SPRINT ? 2.5f
+		: ped->m_nMoveState == PEDMOVE_RUN ? 1.8f
+		: ped->m_nMoveState == PEDMOVE_WALK ? 1.0f : 0.0f;
+	float rate = Min(1.0f, CTimer::GetTimeStep() * 0.035f);
+	fVCModNpcStrollSpeed += (target - fVCModNpcStrollSpeed) * rate;
+	ped->m_fMoveSpeed = fVCModNpcStrollSpeed;
+
+	eMoveState gait = ped->m_nMoveState;
+	if (gait == PEDMOVE_STILL && fVCModNpcStrollSpeed > 0.35f)
+		gait = fVCModNpcStrollSpeed < 1.4f ? PEDMOVE_WALK : PEDMOVE_RUN;
+	else if (gait == PEDMOVE_WALK && fVCModNpcStrollSpeed > 1.95f)
+		gait = PEDMOVE_RUN;
+	// SetRealMoveAnim does not maintain m_nStoredMoveState the way the NPC
+	// SetMoveAnim does; the engine's blocked-ped panic counter reads it, so keep
+	// it in sync or a stuck Tommy never tires/looks about like a ped
+	ped->m_nMoveState = gait;
+	ped->m_nStoredMoveState = gait;
+	ped->SetRealMoveAnim();
+}
+
+// the street wander starts the stroll easing from a standstill
+void
+VCModNpcResetStroll(void)
+{
+	fVCModNpcStrollSpeed = 0.0f;
+}
+
+// the ID check ends with both walk-offs on the same leave timer; hold the stroll
+// until that timer runs out so the pair parts together, as a stock cop and his
+// pedestrian do
+// the civilian AI state NPC-Tommy runs the shared routines with, and the cop
+// patrol's hassle timer; they stand in for the CCivilianPed/CCopPed members
+static SCivilianAIState sVCModNpcCivilian;
+static uint32 nVCModNpcHassleTimer;
+static uint32 nVCModNpcHoldUntil;
+static uint32 nVCModNpcLeaveSeen;
+static bool bVCModNpcStateInit;
+// the profile the civilian state was last initialised for; a switch reloads it
+static int32 nVCModNpcStateProfile = -1;
+
+// init the mod-owned civilian state the way CCivilianPed's ctor does, keeping the
+// RNG call order; NPC-Tommy borrows the criminal car-theft flag so the full
+// civilian crime layer fires on him
+static void
+VCModNpcInitCivilianState(void)
+{
+	sVCModNpcCivilian.m_bLookForVacantCars = true;
+	sVCModNpcCivilian.m_nLookForVacantCarsCounter = 0;
+	sVCModNpcCivilian.m_bJustStoleACar = false;
+	sVCModNpcCivilian.m_bStealCarEvenIfThereIsSomeoneInIt = false;
+	for (int i = 0; i < ARRAY_SIZE(sVCModNpcCivilian.m_nStealWishList); i++) {
+#ifdef FIX_BUGS
+		uint32 randomCarModel = CGeneral::GetRandomNumberInRange(MI_LANDSTAL, MI_LAST_VEHICLE);
+#else
+		uint32 randomCarModel = CGeneral::GetRandomNumberInRange(MI_LANDSTAL, MI_LANDSTAL + VEHICLEMODELSIZE);
+#endif
+		if (CModelInfo::IsCarModel(randomCarModel) || CModelInfo::IsBikeModel(randomCarModel))
+			sVCModNpcCivilian.m_nStealWishList[i] = randomCarModel;
+		else
+			sVCModNpcCivilian.m_nStealWishList[i] = MI_CHEETAH;
+	}
+	sVCModNpcCivilian.m_nAttractorCycleState = 0;
+	sVCModNpcCivilian.m_bAttractorUnk = (CGeneral::GetRandomNumberInRange(0.0f, 1.0f) < 1.25f);
+}
+
+// exported for the civilian type gates that would otherwise skip PLAYER1
+bool
+VCModNpcCivilianActive(void)
+{
+	return bVCModNpcMode && nVCModNpcType == VCMOD_NPC_CIVILIAN;
+}
+
+// exported for the gang type gates that would otherwise skip PLAYER1
+bool
+VCModNpcGangActive(void)
+{
+	return bVCModNpcMode && nVCModNpcType == VCMOD_NPC_GANG;
+}
+
+bool
+VCModNpcCopActive(void)
+{
+	return bVCModNpcMode && nVCModNpcType == VCMOD_NPC_COP;
+}
+
+// strong Tommy: NPC-mode player, civilian profile, his own body. Other bodies
+// answer with their stock personality instead, so this is the only place the mod
+// adds fearlessness on top of the stock numbers
+bool
+VCModNpcStrongActive(void)
+{
+	if (!bVCModNpcMode || nVCModNpcType != VCMOD_NPC_CIVILIAN)
+		return false;
+	CPlayerPed *player = FindPlayerPed();
+	return player != nil && player->GetModelIndex() == MI_PLAYER;
+}
+
+bool
+VCModNpcCombatActive(void)
+{
+	return bVCModNpcMode;
+}
+
+// temporary probe (DIAGNOSTICS): the ID-check candidate gate is stock-tight - a
+// random pedestrian in WANDER_PATH, no objective, no look target, within 5 m and
+// in sight. This names how far the nearest pedestrians get through it, so one
+// play test separates "the check is broken" from "the street had no candidate"
+void
+VCModNpcCopScanDiag(CPed *cop)
+{
+	if (!bVCModNpcMode || nVCModNpcType != VCMOD_NPC_COP || !cop->IsPlayer())
+		return;
+	static uint32 nDiag;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (now < nDiag)
+		return;
+	nDiag = now + 1000;
+
+	CPed *nearest = nil;
+	float nearestDist = 9999.0f;
+	int32 nRand = 0, nWalk = 0, nFree = 0, nClose = 0, nLos = 0;
+	for (int i = 0; i < cop->m_numNearPeds; i++) {
+		CPed *ped = cop->m_nearPeds[i];
+		if (ped == nil)
+			continue;
+		float d = (ped->GetPosition() - cop->GetPosition()).Magnitude2D();
+		if (d < nearestDist) {
+			nearest = ped;
+			nearestDist = d;
+		}
+		if (ped->CharCreatedBy != RANDOM_CHAR)
+			continue;
+		nRand++;
+		if (ped->m_objective != OBJECTIVE_NONE || ped->m_nPedState != PED_WANDER_PATH)
+			continue;
+		nWalk++;
+		if (ped->m_pLookTarget != nil || ped->m_lookTimer >= now)
+			continue;
+		nFree++;
+		if (d >= 5.0f)
+			continue;
+		nClose++;
+		if (CWorld::GetIsLineOfSightClear(cop->GetPosition(), ped->GetPosition(),
+			true, false, false, false, false, false, false))
+			nLos++;
+	}
+
+	VCMOD_DIAG("VCMOD cop scan: n=%d rand=%d walk=%d free=%d close=%d los=%d | near model=%d type=%d created=%d state=%d obj=%d look=%d lookLeft=%d dist=%.1f\n",
+		cop->m_numNearPeds, nRand, nWalk, nFree, nClose, nLos,
+		nearest ? nearest->GetModelIndex() : -1,
+		nearest ? nearest->m_nPedType : -1,
+		nearest ? nearest->CharCreatedBy : -1,
+		nearest ? nearest->m_nPedState : -1,
+		nearest ? nearest->m_objective : -1,
+		nearest ? nearest->m_pLookTarget != nil : -1,
+		nearest ? (int32)(nearest->m_lookTimer - now) : 0,
+		nearest ? nearestDist : -1.0f);
+}
+
+// the blocked-path panic (tired, scratch, turn180) starts from a collision for
+// a ped, and from the controls' stuck flag for a stock player. An NPC-mode
+// player presses nothing, so gating him out of the ped rule made every
+// standstill a false block: he tired out during the ID-check hold, while
+// shooting in a chase, and after a kill
+bool
+VCModNpcBlockedReset(bool isPlayer, bool impact, bool stuck)
+{
+	if (isPlayer && !bVCModNpcMode)
+		return !impact && !stuck;
+	return !impact;
+}
+
+// the manual command ignores player input entirely. Only terminal engine events
+// break it: death, a car, arrest, or controls taken by a mission/cutscene. The
+// civilian/cop reaction states (flee, investigate, chat, mug, hassle, chase) are
+// part of being an NPC, not breaks, so the mode rides through them and resumes
+// the wander when the engine returns him to idle/wander
+static int32
+VCModNpcModeBreak(CPlayerPed *player, CPad *pad)
+{
+	int32 reason = 0;
+	if (player->DyingOrDead()) reason |= VCMOD_CHATBREAK_DEAD;
+	if (player->bInVehicle) reason |= VCMOD_CHATBREAK_IN_CAR;
+	if (pad->ArePlayerControlsDisabled()) reason |= VCMOD_CHATBREAK_CONTROLS;
+	if (player->m_nPedState == PED_ARRESTED) reason |= VCMOD_CHATBREAK_STATE;
+	return reason;
+}
+
+// the personality the worn body has in stock. Tommy's own body gets a strong
+// variant: the player's stock melee numbers, but fear 0 and temper 100 so every
+// stock threshold picks the fight branch and other peds flinch from a bump, and
+// no gun-panic flag. The shared PLAYER stat is never modified: normal play and
+// every other ped keep it
+static CPedStats *
+VCModNpcStrongStats(void)
+{
+	static CPedStats strong;
+	static bool built;
+	if (!built) {
+		memcpy(&strong, CPedStats::ms_apPedStats[PEDSTAT_PLAYER], sizeof(CPedStats));
+		strong.m_fear = 0;
+		strong.m_temper = 100;
+		strong.m_flags &= ~STAT_GUN_PANIC;
+		built = true;
+	}
+	return &strong;
+}
+
+static CPedStats *
+VCModNpcCivilianBodyStats(CPlayerPed *player)
+{
+	int32 model = player->GetModelIndex();
+	if (model == MI_PLAYER)
+		return VCModNpcStrongStats();
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(model);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return CPedStats::ms_apPedStats[PEDSTAT_PLAYER];
+	int32 stat = ((CPedModelInfo *)mi)->m_pedStatType;
+	if (stat < 0 || stat >= NUM_PEDSTATS)
+		return CPedStats::ms_apPedStats[PEDSTAT_PLAYER];
+	return CPedStats::ms_apPedStats[stat];
+}
+
+static void
+VCModNpcRestoreStatBorrow(CPlayerPed *player)
+{
+	if (bVCModNpcStatsBorrowed) {
+		player->m_pedStats = pVCModNpcSavedStats;
+		player->m_gangFlags = nVCModNpcSavedGangFlags;
+		player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+		bVCModNpcStatsBorrowed = false;
+	}
+}
+
+// a completed ID check sets the leave timer on both sides and switches him to
+// OBJECTIVE_WANDER, whose path would start at once. Clearing it in the same
+// frame the completion happens and holding the stroll for a beat is what makes
+// him stand there while the lines play
+static void
+VCModNpcIdCheckHold(CPlayerPed *player, uint32 now)
+{
+	if (player->m_leaveCarTimer <= now || player->m_leaveCarTimer == nVCModNpcLeaveSeen)
+		return;
+	nVCModNpcLeaveSeen = player->m_leaveCarTimer;
+	nVCModNpcHoldUntil = player->m_leaveCarTimer;
+	player->SetObjective(OBJECTIVE_NONE);
+	player->SetIdle();
+	VCMOD_DIAG("VCMOD cop: id hold set (%d ms)\n",
+		(int32)(nVCModNpcHoldUntil - CTimer::GetTimeInMilliseconds()));
+}
+
+// normal play can leave an objective, a threat, an attractor or a path on the
+// player; none of that belongs to the profile and it changed what the patrol
+// reacted to until a toggle-off/on cleared the body
+static bool
+VCModNpcBodyDirty(CPlayerPed *player)
+{
+	return player->m_objective != OBJECTIVE_NONE
+		|| player->m_nWaitState != WAITSTATE_FALSE
+		|| player->m_attractor != nil
+		|| player->m_threatEntity != nil
+		|| player->m_pEventEntity != nil
+		|| player->m_threatFlags != 0
+		|| player->m_pPointGunAt != nil
+		|| player->m_nPedState == PED_AIM_GUN
+		|| player->m_nPedState == PED_FIGHT
+		|| player->m_nPedState == PED_ATTACK
+		|| (!VCModStreetWanderOwnsPlayer() && player->m_pNextPathNode != nil);
+}
+
+// toggle-off hands the ped back the way the player expects him: drop the wander
+// flag first (the restores below call SetWanderPath, and the engine must not
+// re-own him), then every AI leftover the mode started. An objective, a seek, a
+// chat or a wait state keeps running through the base control, and the player's
+// control switch has no input path out of those states — which is why the toggle
+// looked dead while he was stuck at a seat or mid-reaction
+static void
+VCModNpcReleasePed(CPlayerPed *player)
+{
+	VCModStreetClearWander();
+	nVCModNpcNextTry = 0;
+	nVCModNpcHoldUntil = 0;
+	nVCModNpcLeaveSeen = 0;
+	nVCModNpcHassleTimer = 0;
+	VCModNpcResetStroll();
+
+	// death, a car or an arrest owns the ped; the engine restores those itself
+	if (player->DyingOrDead() || player->bInVehicle || player->m_nPedState == PED_ARRESTED)
+		return;
+
+	// the AI leftovers go even while a jump/fall/getup owns the pose: clearing
+	// only once the ped is back in control left a seek or an objective to resume
+	// on the get-up frame, which is the AI still running after the switch is off
+	if (player->m_attractor) {
+		GetPedAttractorManager()->DeRegisterPed(player, player->m_attractor);
+		player->m_attractor = nil;
+	}
+	if (player->m_threatEntity)
+		player->m_threatEntity->CleanUpOldReference((CEntity **)&player->m_threatEntity);
+	player->m_threatEntity = nil;
+	if (player->m_pEventEntity)
+		player->m_pEventEntity->CleanUpOldReference((CEntity **)&player->m_pEventEntity);
+	player->m_pEventEntity = nil;
+	player->m_threatFlags = 0;
+
+	player->ClearChat();
+	player->ClearObjective();
+	player->ClearWaitState();
+	player->ClearLookFlag();
+	player->ClearPointGunAt();
+	player->m_pNextPathNode = nil;
+	player->m_pLastPathNode = nil;
+	player->m_fMoveSpeed = 0.0f;
+	player->bIsRunning = false;
+
+	// only a ped the engine is driving can take the idle hand-back
+	if (player->m_nPedState < PED_STATES_NO_AI) {
+		player->ClearAll();
+		player->SetIdle();
+	}
+
+	VCModSitReset();
+}
+
+void
+VCModUpdateNpcMode(CPlayerPed *player, CPad *pad)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	if (!bVCModNpcMode) {
+		// the toggle is the only manual exit: on the on->off edge, hand control
+		// back the same frame
+		if (bVCModNpcModeWasOn) {
+			bVCModNpcModeWasOn = false;
+			bVCModNpcStateInit = false;
+			nVCModNpcStateProfile = -1;
+			player->CharCreatedBy = MISSION_CHAR;
+			player->m_fearFlags = CPedType::GetThreats(player->m_nPedType);
+			VCModNpcRestoreStatBorrow(player);
+			if (VCModStreetWanderOwnsPlayer())
+				VCModStreetEndWander(player, "switched off");
+			VCModNpcReleasePed(player);
+			bVCModStreetIdle = bVCModNpcSavedStreetIdle;
+			VCMOD_DIAG("VCMOD npc mode: released\n");
+		}
+		return;
+	}
+	if (!bVCModNpcModeWasOn) {
+		bVCModNpcSavedStreetIdle = bVCModStreetIdle;
+		bVCModNpcModeWasOn = true;
+		// a normal-play objective, threat, attractor or path would ride into the
+		// profile and change what the patrol reacts to; the command starts from
+		// the same clean body a toggle-off/on gives. A wander the street layer
+		// already owns is not residue, and the seat keeps him until he stands.
+		VCModNpcRestoreStatBorrow(player);
+		if (!VCModSitting() && VCModNpcBodyDirty(player))
+			VCModNpcReleasePed(player);
+		VCMOD_DIAG("VCMOD npc mode: engaged type=%d\n", nVCModNpcType);
+	}
+	// NPC mode never runs ProcessPlayerWeapon, so the accuracy froze at whatever
+	// normal play left: the DOOM AIM row did nothing mid-mode and the stale value
+	// decided every shot the AI fired. Keep it current every frame, as normal play
+	// does; the aim ramp itself is off in NPC mode (VCModPlayerAimRamp), so this
+	// value is the whole spread
+	VCModPlayerWepAccuracy(player, CWeaponInfo::GetWeaponInfo(player->GetWeapon()->m_eWeaponType));
+	// The armed objective leaves the aim pose up. Nothing releases it when the
+	// fight ends here - that is ClearPointGunAt from the player's weapon code,
+	// which NPC mode skips - so the parked fire clip kept the gun raised for the
+	// whole walk back. A ped drops the pose once it leaves the combat states.
+	if (player->bIsPointingGunAt
+		&& player->m_objective != OBJECTIVE_KILL_CHAR_ON_FOOT
+		&& player->m_objective != OBJECTIVE_KILL_CHAR_ANY_MEANS
+		&& player->m_nPedState != PED_ATTACK && player->m_nPedState != PED_AIM_GUN
+		&& player->m_nPedState != PED_FIGHT)
+		player->ClearPointGunAt();
+	// the street layer stands down while the command runs, so a chat opened
+	// before the switch has no owner: KeepChat holds both peds in PED_CHAT and
+	// the wander (and the cop patrol) never starts. Hand it back first.
+	if (VCModStreetChatActive())
+		VCModStreetAbortChat(player, "npc mode");
+	// the command stands alone: it owns the street, so the idle layer yields
+	bVCModStreetIdle = false;
+
+	// The player ped is created MISSION_CHAR with no threat flags (PLAYER1 has no
+	// Threat line in ped.dat), which gates him out of every civilian scan, threat
+	// and chat decision. While he is actually walking the street as a civilian he
+	// must read as a random pedestrian and fear what a civilian fears; CanBeDeleted's
+	// IsPlayer() guard keeps him safe from culling. A terminal break (car, death,
+	// arrest) drops the wander and both together; gang/cop keep the mission setup.
+	bool bCivilianWander = VCModNpcCivilianActive() && VCModStreetWanderOwnsPlayer();
+	bool bGangWander = VCModNpcGangActive() && VCModStreetWanderOwnsPlayer();
+	player->CharCreatedBy = (bCivilianWander || bGangWander) ? RANDOM_CHAR : MISSION_CHAR;
+	player->m_fearFlags = CPedType::GetThreats(bCivilianWander ? PEDTYPE_CIVMALE
+		: bGangWander ? PEDTYPE_GANG7 : player->m_nPedType);
+	// the profile's temperament is the worn body's own: a civilian body cowers
+	// and flees by its stock stats, a tough body fights. GANG keeps the Vercetti
+	// stat and clears the kin damage bit; the originals restore on break/off/
+	// switch. A body change re-resolves here, so the personality follows the
+	// selected model
+	CPedStats *borrowedStats = nil;
+	if (bGangWander)
+		borrowedStats = CPedStats::ms_apPedStats[PEDSTAT_GANG7];
+	else if (bCivilianWander)
+		borrowedStats = VCModNpcCivilianBodyStats(player);
+
+	if (borrowedStats) {
+		if (!bVCModNpcStatsBorrowed) {
+			pVCModNpcSavedStats = player->m_pedStats;
+			nVCModNpcSavedGangFlags = player->m_gangFlags;
+			bVCModNpcStatsBorrowed = true;
+		}
+		// the body's own turn rate, stock; a mid-mode body change re-applies it,
+		// and wait states still own it afterwards
+		if (player->m_pedStats != borrowedStats) {
+			player->m_headingRate = borrowedStats->m_headingChangeRate;
+			VCMOD_DIAG("VCMOD npc body: model=%d stat=%d fear=%d temper=%d\n",
+				player->GetModelIndex(), (int)borrowedStats->m_type,
+				(int)borrowedStats->m_fear, (int)borrowedStats->m_temper);
+		}
+		player->m_pedStats = borrowedStats;
+		player->m_gangFlags = bGangWander
+			? (uint8)~(1 << (PEDTYPE_GANG7 - PEDTYPE_GANG1))
+			: nVCModNpcSavedGangFlags;
+	} else {
+		VCModNpcRestoreStatBorrow(player);
+	}
+
+	// switching profile reloads the civilian state, the way a fresh engage would
+	if (nVCModNpcType != nVCModNpcStateProfile) {
+		nVCModNpcStateProfile = nVCModNpcType;
+		bVCModNpcStateInit = false;
+	}
+
+	// diagnostic (DIAGNOSTICS): does a reaction state actually translate him?
+	if (player->m_nPedState == PED_INVESTIGATE || player->m_nPedState == PED_FLEE_ENTITY
+		|| player->m_nPedState == PED_FLEE_POS) {
+		static uint32 nReactDiag = 0;
+		if (now >= nReactDiag) {
+			nReactDiag = now + 1000;
+			VCMOD_DIAG("VCMOD react move: state=%d moveSpd=%.2f moveState=%d vel=%.2f wait=%d\n",
+				player->m_nPedState, player->m_fMoveSpeed, player->m_nMoveState,
+				player->m_vecMoveSpeed.Magnitude2D(), player->m_nWaitState);
+		}
+	}
+
+	if (VCModStreetWanderOwnsPlayer()) {
+		int32 brk = VCModNpcModeBreak(player, pad);
+		if (brk != 0) {
+			const char *why = brk & VCMOD_CHATBREAK_DEAD ? "died"
+				: brk & VCMOD_CHATBREAK_IN_CAR ? "into a car"
+				: brk & VCMOD_CHATBREAK_CONTROLS ? "controls taken" : "arrested";
+			VCModStreetEndWander(player, why);
+			return;
+		}
+		VCModNpcIdCheckHold(player, now);
+		// an objective (a seat/ATM attractor, a reaction seek) owns the ped while
+		// it runs; re-issuing the wander on an idle frame would steal him back
+		// mid-approach, which is how a seat objective never completed
+		bool bObjectiveOwnsPed = player->m_objective != OBJECTIVE_NONE;
+		if (player->m_nPedState == PED_IDLE && !bObjectiveOwnsPed && now >= nVCModNpcHoldUntil) {
+			// a dead-end node dropped him to idle; pick a new direction like a ped
+			if (!player->SetWanderPath(CGeneral::GetRandomNumber() & 7)) {
+				VCModStreetEndWander(player, "no path");
+				return;
+			}
+		}
+		// diagnostic (DIAGNOSTICS): flicker probe, one line per visible change,
+		// not a periodic dump. A walk that "resets" shows up here as
+		// state/move/wait/path churn
+		{
+			static int32 nWanderDbgState = -1, nWanderDbgMove = -1, nWanderDbgWait = -1;
+			static bool bWanderDbgPath = false, bWanderDbgLook = false, bWanderDbgRun = false;
+			static uint32 nWanderDbgChat = 0;
+			static int32 nWanderDbgPartner = -1;
+			bool hasPath = player->m_pNextPathNode != nil;
+			bool hasLook = player->m_pLookTarget != nil;
+			int32 partnerState = hasLook && player->m_pLookTarget->IsPed()
+				? ((CPed*)player->m_pLookTarget)->m_nPedState : -1;
+			if (player->m_nPedState != nWanderDbgState || player->m_nMoveState != nWanderDbgMove
+				|| player->m_nWaitState != nWanderDbgWait || hasPath != bWanderDbgPath
+				|| hasLook != bWanderDbgLook || player->bIsRunning != bWanderDbgRun
+				|| player->m_chatTimer != nWanderDbgChat || partnerState != nWanderDbgPartner) {
+				nWanderDbgState = player->m_nPedState;
+				nWanderDbgMove = player->m_nMoveState;
+				nWanderDbgWait = player->m_nWaitState;
+				bWanderDbgPath = hasPath;
+				bWanderDbgLook = hasLook;
+				bWanderDbgRun = player->bIsRunning;
+				nWanderDbgChat = player->m_chatTimer;
+				nWanderDbgPartner = partnerState;
+				VCMOD_DIAG("VCMOD wander: state=%d move=%d stored=%d wait=%d path=%d speed=%.2f obj=%d run=%d chat=%u look=%d partner=%d\n",
+					player->m_nPedState, player->m_nMoveState, player->m_nStoredMoveState,
+					player->m_nWaitState, hasPath, player->m_fMoveSpeed, player->m_objective,
+					(int)player->bIsRunning, player->m_chatTimer, hasLook, partnerState);
+			}
+		}
+		// the profile's native AI layer, in the same order CCivilianPed runs it.
+		// Reaction states ride through here; the engine state machine drives them
+		if (nVCModNpcType == VCMOD_NPC_CIVILIAN) {
+			if (!bVCModNpcStateInit) {
+				VCModNpcInitCivilianState();
+				bVCModNpcStateInit = true;
+			}
+			static uint32 nCivDiag = 0;
+			if (now >= nCivDiag) {
+				nCivDiag = now + 1000;
+				// temporary probe (DIAGNOSTICS): the chat gate needs a wandering
+				// pedestrian within 1.8 m that accepts the player; name the nearest
+				// one and the player's own chat voice so a play test says which side
+				// refuses
+				CPed *nearest = nil;
+				float nearestDist = 9999.0f;
+				for (int i = 0; i < player->m_numNearPeds; i++) {
+					CPed *ped = player->m_nearPeds[i];
+					if (ped == nil)
+						continue;
+					float d = (ped->GetPosition() - player->GetPosition()).Magnitude2D();
+					if (d < nearestDist) {
+						nearest = ped;
+						nearestDist = d;
+					}
+				}
+				VCMOD_DIAG("VCMOD civ layer: state=%d fear=%u created=%d obj=%d ctrl=%d threat=%u near=%d | chat model=%d will=%d dist=%.1f partnerState=%d partnerModel=%d\n",
+					player->m_nPedState, player->m_fearFlags, player->CharCreatedBy,
+					player->m_objective, player->IsPedInControl(), player->m_threatFlags,
+					player->m_numNearPeds, player->GetModelIndex(),
+					nearest ? nearest->WillChat((CPed*)player) : -1,
+					nearest ? nearestDist : -1.0f,
+					nearest ? nearest->m_nPedState : -1,
+					nearest ? nearest->GetModelIndex() : -1);
+			}
+			player->ProcessCivilianState();
+			if (player->IsPedInControl())
+				player->CivilianAI();
+			player->EnterVacantNearbyCars(sVCModNpcCivilian);
+			player->UseNearbyAttractors(sVCModNpcCivilian);
+		} else if (nVCModNpcType == VCMOD_NPC_GANG) {
+			// a gang ped on foot is a CCivilianPed: the same shared layer, with the
+			// GANG7 fear flags/stats borrowed above driving the rival/kin decisions
+			if (!bVCModNpcStateInit) {
+				VCModNpcInitCivilianState();
+				bVCModNpcStateInit = true;
+			}
+			player->ProcessCivilianState();
+			if (player->IsPedInControl())
+				player->CivilianAI();
+			// service the kill/flee objectives the gang AI sets into seek/attack
+			// states; the player override never runs the engine objective layer
+			player->ProcessObjective();
+			player->EnterVacantNearbyCars(sVCModNpcCivilian);
+			player->UseNearbyAttractors(sVCModNpcCivilian);
+		} else if (nVCModNpcType == VCMOD_NPC_COP) {
+			// the CCopPed order: objectives (the chase, the ID check) first, then
+			// CopAI's wanted-0 patrol branch. Its pursuit, arrest and crime scan
+			// all target the player, so they stay native-only
+			player->ProcessObjective();
+			// the completion can land in this call instead of the base one
+			VCModNpcIdCheckHold(player, now);
+			if (player->IsPedInControl() && player->m_nPedState != PED_AIM_GUN
+				&& player->m_pWanted->GetWantedLevel() == 0) {
+				// the debug switch has to shorten a cooldown already running, or
+				// turning it on does nothing until the old 100 s timer expires
+				if (bVCModCopQuickChecks && nVCModNpcHassleTimer > now + 10000)
+					nVCModNpcHassleTimer = now + 5000;
+				player->CopPatrolScan(nVCModNpcHassleTimer);
+			}
+			static uint32 nCopDiag = 0;
+			if (now >= nCopDiag) {
+				nCopDiag = now + 1000;
+				CPed *target = player->m_pedInObjective;
+				VCMOD_DIAG("VCMOD cop: state=%d move=%d wait=%d obj=%d timer=%d dist=%.1f ctrl=%d created=%d hold=%d hassle=%d quick=%d wanted=%d\n",
+					player->m_nPedState, player->m_nMoveState, player->m_nWaitState,
+					player->m_objective, (int32)(player->m_nPedStateTimer - now),
+					target ? (target->GetPosition() - player->GetPosition()).Magnitude2D() : -1.0f,
+					player->IsPedInControl(), player->CharCreatedBy, nVCModNpcHoldUntil > now,
+					(int32)(nVCModNpcHassleTimer - now), (int32)bVCModCopQuickChecks,
+					player->m_pWanted->GetWantedLevel());
+			}
+			// only a police body has the line in its voice bank
+			if (player->m_pPointGunAt && IsPolicePedModel(player->GetModelIndex()))
+				player->Say(SOUND_PED_COP_TARGETING);
+		}
+		return;
+	}
+
+	// not walking yet: hand over as soon as he is resting and in control. The seat
+	// owns his pose while he is sitting, so the command waits for him to stand.
+	// A civilian chat ends in RestorePreviousState, which drops him back into
+	// PED_WANDER_PATH (not IDLE) and calls SetWanderPath while the wander flag is
+	// still down, so the engine's own resume bails on the player guard. That leaves
+	// an orphaned walk this branch must re-adopt, or he stands still after chatting
+	if ((player->m_nPedState == PED_IDLE || player->m_nPedState == PED_WANDER_PATH)
+		&& player->m_objective == OBJECTIVE_NONE
+		&& !player->bInVehicle && !player->DyingOrDead()
+		&& player->IsPedInControl() && !VCModSitting() && now >= nVCModNpcNextTry) {
+		VCModStreetStartWander(player);
+		if (!VCModStreetWanderOwnsPlayer())
+			nVCModNpcNextTry = now + VCMOD_NPC_RETRY_GAP;
+	} else {
+		// diagnostic (DIAGNOSTICS): the command is on but cannot start walking;
+		// this names the state that owns him, so a silent engage has a reason
+		static uint32 nNpcWaitDiag = 0;
+		if (now >= nNpcWaitDiag) {
+			nNpcWaitDiag = now + 1000;
+			VCMOD_DIAG("VCMOD npc wait: state=%d obj=%d ctrl=%d sit=%d car=%d dead=%d\n",
+				player->m_nPedState, player->m_objective, player->IsPedInControl(),
+				VCModSitting(), (int)player->bInVehicle, (int)player->DyingOrDead());
+		}
+	}
+}
+
diff --git a/src/extras/vcmodnpc.h b/src/extras/vcmodnpc.h
new file mode 100644
index 0000000..e3ac066
--- /dev/null
+++ b/src/extras/vcmodnpc.h
@@ -0,0 +1,49 @@
+#ifndef VCMODNPC_H
+#define VCMODNPC_H
+
+class CPlayerPed;
+class CPad;
+class CPed;
+
+// BECOME NPC: Tommy walks the street on the engine's own AI until switched off
+extern bool bVCModNpcMode;
+// the profile he walks with; see eVCModNpcType
+extern int32 nVCModNpcType;
+// debug aid: cop ID checks recur every 5-10 s instead of the normal 100 s
+extern bool bVCModCopQuickChecks;
+
+enum eVCModNpcType
+{
+	VCMOD_NPC_GANG,		// the plain shared wander, exactly what a gang ped walks
+	VCMOD_NPC_CIVILIAN,	// the full native civilian AI: reactions, chat, crime, attractors
+	VCMOD_NPC_COP,		// the foot patrol: chase criminals/gangs, hassle wanderers
+	NUM_VCMOD_NPC_TYPES
+};
+
+bool VCModNpcCivilianActive(void);
+bool VCModNpcGangActive(void);
+bool VCModNpcCopActive(void);
+// civilian profile wearing Tommy's own body: the strong variant (no fear, no
+// flee/cower; corpses and blasts are investigated, gunshots are answered). Other
+// bodies keep the personality their model has in stock
+bool VCModNpcStrongActive(void);
+// NPC mode owns the attack/fight states with no pad presses: the melee checks
+// have to take the ped path, not the player-press path
+bool VCModNpcCombatActive(void);
+// CPed's blocked-path check: true when this frame must clear the panic counter.
+// A stock player is blocked only from his own controls' stuck flag; an
+// NPC-mode player has no pad, so he takes the pedestrian rule: a real impact
+bool VCModNpcBlockedReset(bool isPlayer, bool impact, bool stuck);
+// the mode has borrowed the worn body's stats and gang flags
+bool VCModNpcStatsBorrowed(void);
+// per frame: drives the chosen profile and the toggle-off hand-back
+void VCModUpdateNpcMode(CPlayerPed *player, CPad *pad);
+// temporary probe (DIAGNOSTICS): why the cop ID-check candidate gate refuses the
+// nearest pedestrian
+void VCModNpcCopScanDiag(CPed *cop);
+// the stroll easing runs every frame the mode owns the walk
+void VCModNpcStrollGait(CPlayerPed *ped);
+// a fresh wander starts the stroll from a standstill
+void VCModNpcResetStroll(void);
+
+#endif
diff --git a/src/extras/vcmodpanel.cpp b/src/extras/vcmodpanel.cpp
new file mode 100644
index 0000000..0e4caba
--- /dev/null
+++ b/src/extras/vcmodpanel.cpp
@@ -0,0 +1,774 @@
+#include "common.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "General.h"
+#include "RwHelper.h"
+#include "Pad.h"
+#include "Camera.h"
+#include "AnimBlendAssocGroup.h"
+#include "AnimBlendAssociation.h"
+#include "AnimBlendHierarchy.h"
+#include "ModelInfo.h"
+#include "PedModelInfo.h"
+#include "ModelIndices.h"
+#include "Ped.h"
+#include "PlayerPed.h"
+#include "World.h"
+#include "PedType.h"
+#include "Streaming.h"
+#include "Directory.h"
+#include "Zones.h"
+#include "Radar.h"
+#include "main.h"
+#include "vcmodpanel.h"
+#include "vcmodpanelinternal.h"
+#include "vcmodcharacter.h"
+#include "vcmodcombat.h"
+#include "vcmodadrenaline.h"
+#include "vcmodsit.h"
+#include "vcmodstreet.h"
+#include "vcmodnpc.h"
+#include "vcmodride.h"
+#include "vcmodplayer.h"
