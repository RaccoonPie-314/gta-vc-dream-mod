+    gShot = true;
+    VCModCopSetStance(&player, &assoc, false);
+    for (int i = 0; i < 11; ++i) assert(nodes[i].sequence == &sequences[i]);
+    gShot = false;
+    // the parked clip is the hold
+    assoc.flags &= ~1;
+    VCModCopSetStance(&player, &assoc, false);
+    assert(nodes[0].sequence == &sequences[0]);
+    for (int i = 1; i < 11; ++i) assert(nodes[i].sequence == nil);
+    assert(assoc.seeks == 0);
+    assoc.flags |= 1;
+    for (int cycle = 0; cycle < 3; ++cycle) {
+        assoc.currentTime = 0.4f + cycle * 0.3f;
+        VCModCopSetStance(&player, &assoc, true);
+        for (int i = 0; i < 11; ++i) {
+            // the shot keeps Root (its drop is the stance's weight on the floor)
+            assert(nodes[i].sequence == &sequences[i]);
+            assert(nodes[i].sampledTime == assoc.currentTime);
+            assert(templateNodes[i].sequence == &sequences[i]);
+            assert(templateNodes[i].sampledTime == 0.0f);
+        }
+        assert(assoc.seeks == cycle + 1);
+        VCModCopSetStance(&player, &assoc, true);
+        assert(assoc.seeks == cycle + 1);
+        assert(assoc.flags == 25 && assoc.blendAmount == 0.7f && assoc.blendDelta == 2.0f);
+        // the clip's bone translations stay off the player's skeleton in the shot
+        for (int i = 2; i < 11; ++i)
+            if (i != 3 && i != 4) // spine and spine1 keep their tracks untouched
+                assert((frames[i].flag & AnimBlendFrameData::IGNORE_TRANSLATION) != 0);
