diff --git a/src/extras/vcmodshootable.cpp b/src/extras/vcmodshootable.cpp
new file mode 100644
index 0000000..5f15c99
--- /dev/null
+++ b/src/extras/vcmodshootable.cpp
@@ -0,0 +1,71 @@
+#include "common.h"
+
+#include "vcmodshootable.h"
+
+#include "Ped.h"
+#include "Projectile.h"
+#include "ProjectileInfo.h"
+#include "Vehicle.h"
+
+// wide enough to catch a grenade without turning the shot into aim assist
+#define VCMOD_PROJECTILE_HIT_RADIUS	0.6f
+
+bool bVCModShootableProjectiles = true;
+
+bool
+VCModShotHitsPoint(const CVector &from, const CVector &to, const CVector &point, float radius)
+{
+	CVector dir = to - from;
+	float len2 = dir.MagnitudeSqr();
+	if (len2 < 0.0001f)
+		return false;
+
+	float t = DotProduct(point - from, dir) / len2;
+	if (t < 0.0f || t > 1.0f)
+		return false;
+
+	return (from + dir * t - point).MagnitudeSqr() <= radius * radius;
+}
+
+static bool
+VCModPlayerShot(CEntity *shooter)
+{
+	if (shooter == nil)
+		return false;
+	if (shooter->IsPed())
+		return ((CPed*)shooter)->IsPlayer();
+	if (shooter->IsVehicle()) {
+		CPed *driver = ((CVehicle*)shooter)->pDriver;
+		return driver != nil && driver->IsPlayer();
+	}
+	return false;
+}
+
+bool
+VCModShootProjectiles(const CVector &from, const CVector &to, CEntity *shooter)
+{
+	if (!bVCModShootableProjectiles || !VCModPlayerShot(shooter))
+		return false;
+
+	for (int i = 0; i < NUM_PROJECTILES; i++) {
+		CProjectileInfo *info = &gaProjectileInfo[i];
+		if (!info->m_bInUse || CProjectileInfo::ms_apProjectile[i] == nil)
+			continue;
+		if (info->m_eWeaponType != WEAPONTYPE_GRENADE
+			&& info->m_eWeaponType != WEAPONTYPE_MOLOTOV
+			&& info->m_eWeaponType != WEAPONTYPE_ROCKET)
+			continue;
+		// RemoveProjectile dereferences the source to credit a rocket
+		if (info->m_eWeaponType == WEAPONTYPE_ROCKET && info->m_pSource == nil)
+			continue;
+
+		if (!VCModShotHitsPoint(from, to, CProjectileInfo::ms_apProjectile[i]->GetPosition(),
+				VCMOD_PROJECTILE_HIT_RADIUS))
+			continue;
+
+		debug("vcm: shot down projectile (weapon %d)\n", (int)info->m_eWeaponType);
+		CProjectileInfo::RemoveProjectile(info, CProjectileInfo::ms_apProjectile[i]);
+		return true;
+	}
+	return false;
+}
