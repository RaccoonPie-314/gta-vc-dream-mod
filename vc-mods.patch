+def doubleback_source():
+    start = PED.index("case WAITSTATE_DOUBLEBACK:", PED.index("CPed::Wait(void)"))
+    end = PED.index("case WAITSTATE_HITWALL:", start)
+    setup_start = PED.index("case WAITSTATE_DOUBLEBACK:", PED.index("CPed::SetWaitState("))
+    setup_end = PED.index("case WAITSTATE_HITWALL:", setup_start)
+    return (WANDER_STUBS + braced(NPC, GATE) + braced(NPC, "bool\nVCModNpcCopActive(void)")
+            + braced(PED, "void\nCPed::WanderPath(void)")
+            + "void CPed::Wait(void) { switch (m_nWaitState) {"
+            + PED[start:end] + "default: break; } }"
+            + "void CPed::SetWaitState(int state, void* time) { CAnimBlendAssociation* animAssoc; switch(state) {"
+            + PED[setup_start:setup_end] + "default: break; } m_nWaitState = state; }")
+
