+
+
+class NpcAimTests(unittest.TestCase):
+    def test_wander_owned_player_is_not_steered_by_the_camera(self):
+        fn = braced(PED, "CPed::CanStrafeOrMouseControl(void)")
+        run_cpp(STUBS + fn + r'''
+int main() {
+    const int combat[] = { PED_IDLE, PED_ATTACK, PED_FIGHT, PED_AIM_GUN, PED_FLEE_POS, PED_FLEE_ENTITY };
+    CPed tommy, npc;
+    npc.player = false;
+    for (int i = 0; i < 6; i++) {
+        tommy.m_nPedState = npc.m_nPedState = combat[i];
+        wanderOwns = false;
+        if (!tommy.CanStrafeOrMouseControl()) { printf("normal play lost mouse control %d\n", i); return 1; }
+        wanderOwns = true;
+        if (tommy.CanStrafeOrMouseControl()) { printf("camera steers NPC-owned Tommy in %d\n", i); return 1; }
+        if (!npc.CanStrafeOrMouseControl()) { printf("other peds changed %d\n", i); return 1; }
+    }
+    wanderOwns = false;
+    tommy.m_nPedState = PED_IDLE;
+    tommy.m_nWaitState = WAITSTATE_SIT_IDLE;
+    if (tommy.CanStrafeOrMouseControl()) { printf("seat gate lost\n"); return 1; }
+    return 0;
+}
+''')
+
+    def test_camera_heading_writes_route_through_the_gate(self):
+        self.assertIn("((CPed*)CamTargetEntity)->CanStrafeOrMouseControl() && !VCModPlayerTurnsWithInput()", CAM)
+        self.assertIn("if(player && player->CanStrafeOrMouseControl()){", CAM)
+
+    def test_player_fire_follows_the_target_not_the_crosshair(self):
+        branches = re.findall(r"shooter == FindPlayerPed\(\) && TheCamera\.Cams\[0\]\.Using3rdPersonMouseCam\(\)[^\n]*", WEAPON)
+        self.assertEqual(len(branches), 3)
+        for line in branches:
+            self.assertIn("!VCModStreetWanderOwnsPlayer()", line)
+
+
+if __name__ == '__main__':
+    unittest.main()
