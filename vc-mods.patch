+// Air insertion. The heli is a real CAutomobile so it has seats and an AI
+// pilot; the AI CHeli has no seats and cannot carry the team. The air start is
+// a pursuit: the heli chases the fleeing criminal and guns his car until it is
+// wrecked and he bails out, and only then does the team rope down.
+#define VCMOD_CHASE_AIR_MARKER_ID		0x56434349
+#define VCMOD_CHASE_GROUND_MARKER_ID	0x5643434A
+#define VCMOD_CHASE_AIR_ENTER_NEAR		2.5f
+// The Police Maverick, not the AI chopper: MI_CHOPPER is IDE type "heli", whose
+// HELI_CHASSIS node id (1) collides with CAR_WHEEL_RF (1), so the CAutomobile
+// constructor's wheel-hiding switches the body off and it spawns invisible.
+// MI_POLMAV is IDE type "car" with heli handling — the rideable police heli.
+#define VCMOD_CHASE_HELI_MODEL			MI_POLMAV
+// A mission heli must not be destructible: an explosion with the player aboard
+// ends the run. Kept high so a stray blast or a bullet cannot bring it down.
+#define VCMOD_CHASE_HELI_HEALTH			4000.0f
+// the rope pool hangs 31 half-metre segments, about 19.4 m; the top sits 1.5 m
+// below the heli's origin, so a 21.5 m hover puts the last man's feet at about
+// one metre off the road
+#define VCMOD_CHASE_HELI_HOVER			21.5f
+#define VCMOD_CHASE_ROPE_TOP			1.5f
+#define VCMOD_CHASE_ROPE_BOTTOM			0.98f
+#define VCMOD_CHASE_ROPE_SPAN			(31.0f * 0.625f)	// the pool's node spacing
+#define VCMOD_CHASE_CLIMB_RATE			0.005f
+// stock SWAT descent advances its rope parameter by 0.003 per tick
+// (CCopPed::ProcessHeliSwat), about 6.5 s from the podium; too slow to watch, so
+// the descent runs at 0.007, about 2.8 s at 50 fps
+#define VCMOD_CHASE_DROP_RATE			0.007f
+// the air team stages at the HQ door and runs in to the hanging ropes; the
+// climb starts when everyone is at their rope, or this long after the pick
+#define VCMOD_CHASE_RALLY_NEAR			2.5f
+#define VCMOD_CHASE_RALLY_MAX			8000
+#define VCMOD_CHASE_AIR_SPEED			110
+// The chase leg flies on a 1:1 copy of the stock police chopper's own flight
+// model (CHeli::Process): it chases the criminal's car the way the stock chopper
+// chases the player, levelling off over the ground rather than at a fixed
+// altitude over the car, with the stock hover/chase switch and the stock bob.
+#define VCMOD_CHASE_AIR_CHASE_OVER		12.0f	// stock CHASE_PLAYER height over the ground
+#define VCMOD_CHASE_AIR_HOVER_OVER		8.0f	// stock HOVER height over the ground
+#define VCMOD_CHASE_AIR_HOVER_DIST		30.0f
+#define VCMOD_CHASE_AIR_HOVER_LEAVE		40.0f
+#define VCMOD_CHASE_AIR_FOLLOW_EVERY	500
+#define VCMOD_CHASE_AIR_FOLLOW_HIGH		60.0f
