+
+// CPopulation::AddPed(PEDTYPE_COP, ...) reads its second argument as an eCopType,
+// not a model index. Handing it the model index leaves a vice ped with model -1
+// (97 is out of the cop-type range, so CCopPed never calls SetModelIndex) and
+// CWorld::Add then crashes reading the collision model of model -1. It also swaps
+// the street cop for an FBI model. Map the unit to its cop type and let CCopPed
+// pick the model; the vice variant rides in the modifier.
+static eCopType
+VCModChaseCopType(eVCModChaseUnit unit)
+{
+	switch (unit) {
+	case VCMOD_UNIT_SWAT: return COP_SWAT;
+	case VCMOD_UNIT_VICE: return COP_MIAMIVICE;
+	case VCMOD_UNIT_FBI:  return COP_FBI;
+	case VCMOD_UNIT_ARMY: return COP_ARMY;
+	default:              return COP_STREET;
+	}
+}
+
+// The CCopPed constructor arms every cop type itself and requests its delayed
+// weapon model (CopPed.cpp:22-70): street gets a nightstick and a delayed
+// Colt, SWAT and Vice a UZI, FBI and Army an MP5. The mission must not hand out
+// a weapon of its own — it used to give every tier a UZI, which left the Army
+// tier carrying the wrong gun. Only the primary model is requested here, the
+// nightstick included, so the gun in hand always renders.
+static void
+VCModChaseRequestCopWeapon(eVCModChaseUnit unit)
+{
+	eWeaponType weapon;
+	switch (unit) {
+	case VCMOD_UNIT_COP: weapon = WEAPONTYPE_NIGHTSTICK; break;
+	case VCMOD_UNIT_FBI:
+	case VCMOD_UNIT_ARMY: weapon = WEAPONTYPE_MP5; break;
+	default: weapon = WEAPONTYPE_UZI; break;	// SWAT, Vice
+	}
+	int32 model = CWeaponInfo::GetWeaponInfo(weapon)->m_nModelId;
+	if (model > 0)
+		CStreaming::RequestModel(model, 0);
+}
