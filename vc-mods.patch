+#ifdef LOAD_INI_SETTINGS
+bool
+VCModRowPinned(const VCModRowDef *row)
+{
+	return row->iniKey != nil && IniHasKey("VC Mods", row->iniKey);
+}
+
+// the value a pinned row carries into the ini: the flag for switches, the state
+// for a cycle row, the choice for the list rows
+static int32
+VCModRowValue(const VCModRowDef *row)
+{
+	switch (row->kind) {
+	case VCMOD_ROW_CYCLE:	return row->cycle->get();
+	case VCMOD_ROW_ANIMSET:	return nVCModAnimChoice;
+	case VCMOD_ROW_PEDCHAR: {
+		// the pending model is cleared once the swap happens, so the worn body is
+		// what a pin has to remember; the pending one wins while it is still queued
+		if (nVCModPedModel >= 0)
+			return nVCModPedModel;
+		CPlayerPed *player = FindPlayerPed();
+		return player != nil ? player->GetModelIndex() : nVCModPedModel;
+	}
+	case VCMOD_ROW_RIDEZONE:	return nVCModRideZone;
+	case VCMOD_ROW_RIDESTYLE:	return nVCModRideStyle;
+	case VCMOD_ROW_CREWCAR:	return nVCModCrewCar;
+	}
+	return row->state != nil && *row->state ? 1 : 0;
+}
+
+// every pinned row from live state, so a debug-menu change is not overwritten by
+// the value the file held at startup. The ini write itself is the caller's.
+void
+VCModPersistPinned(void)
+{
+	for (uint32 i = 0; i < ARRAY_SIZE(aVCModRows); i++)
+		if (VCModRowPinned(&aVCModRows[i]))
+			IniStoreKey("VC Mods", aVCModRows[i].iniKey,
+				VCModRowValue(&aVCModRows[i]));
+}
+#else
+bool VCModRowPinned(const VCModRowDef *row) { return false; }
+void VCModPersistPinned(void) {}
+#endif
