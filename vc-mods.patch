+}
+
+// the engine's own way of wearing another model, from ChangePlayerCheat: the ped
+// keeps its identity and only the clump underneath it is replaced
+bool
+VCModApplyPedModel(int16 modelIndex)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return false;
+
+	int32 oldIndex = player->GetModelIndex();
+	if (modelIndex == oldIndex)
+		return true;
+	if (modelIndex < 0)
+		return false;
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+
+	if (modelIndex == MI_PLAYER) {
+		if (!CStreaming::HasModelLoaded(MI_PLAYER)) {
+			CStreaming::RequestSpecialModel(MI_PLAYER, "player", STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+			CStreaming::LoadAllRequestedModels(false);
+		}
+	} else if (modelIndex >= MI_SPECIAL01 && modelIndex <= MI_LAST_PED) {
+		// default.ide calls these slots special01..21 and no file answers to that;
+		// the body has to be named before the slot has anything to stream
+		const char *name = CStreaming::GetSpecialCharModelName(modelIndex - MI_SPECIAL01);
+		if (name == nil)
+			return false;
+		CStreaming::RequestSpecialModel(modelIndex, name, STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+		CStreaming::LoadAllRequestedModels(false);
+	} else {
+		CStreaming::RequestModel(modelIndex, STREAMFLAGS_DEPENDENCY | STREAMFLAGS_DONT_REMOVE);
+		CStreaming::LoadAllRequestedModels(false);
+	}
+	// a slot can report itself loaded while streaming nothing, and SetModelIndex
+	// then hands a nil clump to the anim blend
+	if (!CStreaming::HasModelLoaded(modelIndex) || mi->GetRwObject() == nil) {
+		// nothing was rebuilt, so only the request that failed is worth dropping
+		CStreaming::SetModelIsDeletable(modelIndex);
+		return false;
+	}
+
+	AssocGroupId animGroup;
+	if (!VCModPedAnimGroupFor(modelIndex, &animGroup))
+		animGroup = ASSOCGRP_PLAYER;
+
+	player->DeleteRwObject();
+	player->m_modelIndex = -1;
+	player->SetModelIndex(modelIndex);
+	// SetModelIndex takes both of these from the model, and Tommy is still Tommy
+	player->SetPedStats(PEDSTAT_PLAYER);
+	player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+	player->m_animGroup = animGroup;
+	player->ReApplyMoveAnims();
+	VCModRollPlayerPace();
+
+	// the held weapon is its own atomic parented to the hand each frame, so it
+	// outlived the clump and has to be freed before the new one is attached
+	if (player->m_wepModelID >= 0) {
+		int32 w = player->m_wepModelID;
+		player->RemoveWeaponModel(-1);
+		player->AddWeaponModel(w);
+	}
+
+	// only release what this mod pinned: a model a save or a script put on the
+	// player was never ours to hand back
+	if (nVCModHeldModelRequest >= 0 && nVCModHeldModelRequest != modelIndex) {
+		CStreaming::SetModelIsDeletable(nVCModHeldModelRequest);
+		nVCModHeldModelRequest = -1;
+	}
+	if (modelIndex != MI_PLAYER)
+		nVCModHeldModelRequest = modelIndex;
+
+	return true;
+}
+
+static void
+VCModApplyPedModelDefault(void)
+{
+	if (nVCModPedModel < 0)
+		return;
+
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl())
+		return;
+
+	// one try per start: a model that cannot be worn is not worth requesting
+	// again on every frame
+	int32 want = nVCModPedModel;
+	nVCModPedModel = -1;
+	VCModApplyPedModel((int16) want);
+}
+
+// respawn rebuilds the ped through Undress/Dress, which takes stats and group
+// from whatever model is worn, and a save can swap the ped out entirely, so the
+// mod's own bookkeeping has to be re-checked rather than trusted
+static void
+VCModReconcilePedModel(CPlayerPed *player)
+{
+	int32 worn = player->GetModelIndex();
+
+	if (nVCModHeldModelRequest >= 0 && nVCModHeldModelRequest != worn) {
+		CStreaming::SetModelIsDeletable(nVCModHeldModelRequest);
+		nVCModHeldModelRequest = -1;
+	}
+
+	if (worn == MI_PLAYER)
+		return;
+
+	if (player->m_pedStats->m_type != PEDSTAT_PLAYER) {
+		player->SetPedStats(PEDSTAT_PLAYER);
+		player->m_headingRate = player->m_pedStats->m_headingChangeRate;
+	}
+}
+
+// ---- passenger mode and the chauffeur: an NPC drives, Tommy rides along -----
+// the ride is tracked by pool handle because the car can be destroyed or blown up
+// between the enter press and actually sitting down
+static int32 nVCModRideHandle = -1;
+static int32 nVCModRidePhase = VCMOD_RIDE_NONE;
+static bool bVCModRideSummoned;
+static bool bVCModRideHasDestination;
+static CVector vecVCModRideDestination;
+static CVector vecVCModRidePickup;
+static uint32 nVCModRideRetargetAt;
+static int32 nVCModRideAppliedStyle = -1;
+static uint32 nVCModRideBoardAt;
+// a dismissed chauffeur waits for Tommy to get out; the limo is released then
+static int32 nVCModDismissedHandle = -1;
+// the car's own traffic pace, put back when the ride ends; releasing a street car
+// at the ride's cruise speed and weaving style made the driver bolt like a maniac
+static uint8 nVCModRideTrafficCruise;
+static uint8 nVCModRideTrafficStyle;
+static float fVCModRideTrafficMaxSpeed;
+static bool bVCModRideTrafficSaved;
+
+#define VCMOD_DRIVER_MODEL	MI_STRETCH
+#define VCMOD_SPAWN_BACK	80.0f
+#define VCMOD_PICKUP_NEAR	15.0f
+#define VCMOD_RETARGET_NEAR	20.0f
+#define VCMOD_RETARGET_WAIT	3000
+#define VCMOD_ABANDON_FAR	120.0f
+#define VCMOD_ARRIVE_NEAR	20.0f
+#define VCMOD_BOARD_ABANDON_FAR	30.0f
+#define VCMOD_BOARD_TIMEOUT	15000
+
+static CVehicle *VCModRideVehicle(void);
+static bool VCModRideSkipTravel(void);
+
+static void
+VCModRideNotice(const char *text)
+{
+	static wchar notice[64];
+	int32 i;
+	for (i = 0; i < (int32) ARRAY_SIZE(notice) - 1 && text[i] != '\0'; i++)
+		notice[i] = (wchar) text[i];
+	notice[i] = 0;
+	CHud::SetHelpMessage(notice, false);
+}
+
+int32
+VCModRidePhase(void)
+{
+	return nVCModRidePhase;
+}
+
+// back to ordinary traffic; a car held for boarding would otherwise sit at
+// MISSION_STOP_FOREVER with its driver frozen for the rest of the session
+static void
+VCModRideReleaseToTraffic(CVehicle *veh)
+{
+	if (veh == nil)
+		return;
+	CCarCtrl::JoinCarWithRoadSystem(veh);
+	veh->AutoPilot.m_nCarMission = MISSION_CRUISE;
+	veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	if (bVCModRideTrafficSaved && nVCModRideTrafficCruise != 0) {
+		// exactly how the car drove before we borrowed it, so the driver blends
+		// back into the traffic instead of speeding and weaving away
+		veh->AutoPilot.m_nDrivingStyle = nVCModRideTrafficStyle;
+		veh->AutoPilot.m_nCruiseSpeed = nVCModRideTrafficCruise;
+		veh->AutoPilot.m_fMaxTrafficSpeed = fVCModRideTrafficMaxSpeed;
+	} else {
+		// a car we caught stopped, or a limo we conjured, had no pace to restore
+		veh->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_STOP_FOR_CARS;
+		veh->AutoPilot.m_nCruiseSpeed = 12;
+		veh->AutoPilot.m_fMaxTrafficSpeed = 12.0f;
+	}
+}
+
+// a summoned limo goes back to traffic rather than being deleted, so the pool and
+// the radar never hold a slot we freed by hand
+static void
+VCModRideHandBack(CVehicle *veh)
+{
+	if (veh == nil)
+		return;
+	if (veh->VehicleCreatedBy == MISSION_VEHICLE) {
+		veh->VehicleCreatedBy = RANDOM_VEHICLE;
+		CCarCtrl::NumMissionCars--;
+		CCarCtrl::NumRandomCars++;
+	}
+	CRadar::ClearBlipForEntity(BLIP_CAR, CPools::GetVehiclePool()->GetIndex(veh));
+	VCModRideReleaseToTraffic(veh);
+}
+
+static void
+VCModRideStandDown(void)
+{
+	CVehicle *veh = VCModRideVehicle();
+	CPlayerPed *player = FindPlayerPed();
+	bool aboard = player != nil && veh != nil && player->InVehicle() && player->m_pMyVehicle == veh;
+
+	// an abandoned boarding must not leave Tommy chasing a car that drove off
+	if (player != nil && player->m_objective == OBJECTIVE_ENTER_CAR_AS_PASSENGER &&
+			player->m_carInObjective == veh)
+		player->SetObjective(OBJECTIVE_NONE, nil);
+
+	if (bVCModRideSummoned)
+		VCModRideHandBack(veh);
+	// a street car we held for boarding goes back to traffic once nobody is in it
+	else if (veh != nil && !aboard)
+		VCModRideReleaseToTraffic(veh);
+	nVCModRideHandle = -1;
+	nVCModRidePhase = VCMOD_RIDE_NONE;
+	bVCModRideSummoned = false;
+	bVCModRideHasDestination = false;
+	nVCModRideAppliedStyle = -1;
+	bVCModRideTrafficSaved = false;
+}
+
+static CVehicle *
+VCModRideVehicle(void)
+{
+	if (nVCModRideHandle < 0)
+		return nil;
+	// a handle, not an index: GetAt drops it once the slot has been recycled
+	return CPools::GetVehiclePool()->GetAt(nVCModRideHandle);
+}
+
+static bool
+VCModPassengerSeatFree(CVehicle *veh)
+{
+	for (int32 i = 0; i < veh->m_nNumMaxPassengers; i++)
+		if (veh->pPassengers[i] == nil)
+			return true;
+	return false;
+}
+
+bool
+VCModPassengerEntry(CVehicle *vehicle)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl() || player->bInVehicle || vehicle == nil)
+		return false;
+
+	// the limo we called is always boardable; the flag governs street cars
+	bool summoned = bVCModRideSummoned && vehicle == VCModRideVehicle();
+	if (!bVCModPassengerMode && !summoned)
+		return false;
+
+	// planes and helis have no passenger seat at all, trains are not rideable here
+	if (vehicle->IsPlane() || vehicle->IsHeli() || vehicle->IsTrain()) {
+		VCModRideNotice("passenger mode: no seat in this");
+		return true;
+	}
+	if (!VCModPassengerSeatFree(vehicle)) {
+		VCModRideNotice("passenger mode: every seat taken");
+		return true;
+	}
+
+	// an unoccupied vehicle is not a passenger ride; leave it as it is and give the
+	// press back to the game, so Tommy gets in as the driver
+	if (vehicle->pDriver == nil)
+		return false;
+
+	// a new press replaces whatever ride was armed; the car we were holding must
+	// go back to traffic, or it sits stopped in the road for the session
+	bool sameRide = nVCModRidePhase != VCMOD_RIDE_NONE && vehicle == VCModRideVehicle();
+	if (!sameRide)
+		VCModRideStandDown();
+
+	// A simple car is moved by the on-rails traffic update, which writes its
+	// position directly; re-routing one drags it sideways onto the path lane.
+	// Driving promotes the car to STATUS_PLAYER when the player sits down, but
+	// riding as a passenger does not, so promote it before we touch its route.
+	if (vehicle->GetStatus() == STATUS_SIMPLE) {
+		vehicle->SetStatus(STATUS_PHYSICS);
+		CCarCtrl::SwitchVehicleToRealPhysics(vehicle);
+	}
+
+	// remember the pace the car was already keeping, so handing it back does not
+	// leave a street car driving to the ride's tune; a re-press on a car we already
+	// hold keeps the pace captured before it was stopped
+	if (summoned) {
+		bVCModRideTrafficSaved = false;
+	} else if (!sameRide) {
+		nVCModRideTrafficCruise = vehicle->AutoPilot.m_nCruiseSpeed;
+		nVCModRideTrafficStyle = vehicle->AutoPilot.m_nDrivingStyle;
+		fVCModRideTrafficMaxSpeed = vehicle->AutoPilot.m_fMaxTrafficSpeed;
+		bVCModRideTrafficSaved = true;
+	}
+
+	// hold the car until Tommy is aboard, the way the shortcut taxi waits
+	vehicle->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	vehicle->AutoPilot.m_nCruiseSpeed = 0;
+
+	player->SetObjective(OBJECTIVE_ENTER_CAR_AS_PASSENGER, vehicle);
+
+	nVCModRideHandle = CPools::GetVehiclePool()->GetIndex(vehicle);
+	nVCModRidePhase = VCMOD_RIDE_BOARDING;
+	nVCModRideBoardAt = CTimer::GetTimeInMilliseconds();
+	// boarding always routes, even when the chauffeur was already driving to us
+	nVCModRideAppliedStyle = -1;
+	return true;
+}
+
+// SAFE is the only style that scans for cars and peds and the only one that stops
+// at a red light; PLOUGH_THROUGH does neither and never weaves around traffic.
+static void
+VCModRideApplyStyle(CVehicle *veh, bool goingSomewhere)
+{
+	// both styles steer with real physics; a simple car would instead be dragged
+	// along its path lane every frame, which is the car snapping sideways
+	veh->SetStatus(STATUS_PHYSICS);
+	if (nVCModRideStyle == VCMOD_RIDE_FAST) {
+		veh->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_PLOUGH_THROUGH;
+		veh->AutoPilot.m_nCruiseSpeed = goingSomewhere ? 55 : 45;
+	} else {
+		veh->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_STOP_FOR_CARS;
+		veh->AutoPilot.m_nCruiseSpeed = goingSomewhere ? 25 : 20;
+	}
+	nVCModRideAppliedStyle = nVCModRideStyle;
+}
+
+// the journey: a zone routes the driver, anything else lets traffic take him
+static void
+VCModRideDrive(CVehicle *veh)
+{
+	int32 zoneIndex;
+	CVector dest;
+	if (VCModRideZoneAt(nVCModRideZone, &zoneIndex, nil, &dest) && zoneIndex >= 0) {
+		CCarCtrl::JoinCarWithRoadSystemGotoCoors(veh, dest, false);
+		veh->AutoPilot.m_nCarMission = MISSION_GOTOCOORDS;
+		vecVCModRideDestination = dest;
+		bVCModRideHasDestination = true;
+		VCModRideApplyStyle(veh, true);
+	} else {
+		CCarCtrl::JoinCarWithRoadSystem(veh);
+		veh->AutoPilot.m_nCarMission = MISSION_CRUISE;
+		bVCModRideHasDestination = false;
+		VCModRideApplyStyle(veh, false);
+	}
+	veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+}
+
+// the engine's own waypoint teleport, aimed at the nearest road so a zone centre
+// in the sea or inside a block cannot be where Tommy lands
+static bool
+VCModRideSkipTravel(void)
+{
+	int32 zoneIndex;
+	CVector dest;
+	if (!VCModRideZoneAt(nVCModRideZone, &zoneIndex, nil, &dest) || zoneIndex < 0) {
+		VCModRideNotice("skip the ride: pick a destination first");
+		return false;
+	}
+	int32 node = ThePaths.FindNodeClosestToCoors(dest, PATH_CAR, 999999.9f, true, true);
+	if (node < 0) {
+		VCModRideNotice("skip the ride: no road there");
+		return false;
+	}
+	dest = ThePaths.m_pathNodes[node].GetPosition();
+
+	// the car when Tommy is aboard, Tommy otherwise, so one path covers both
+	CEntity *who = FindPlayerEntity();
+	if (who == nil)
+		return false;
+
+	CColStore::RequestCollision(dest);
+	CStreaming::LoadSceneCollision(dest);
+	CStreaming::LoadScene(dest);
+	dest.z = CWorld::FindGroundZForCoord(dest.x, dest.y) + who->GetDistanceFromCentreOfMassToBaseOfModel();
+	CTheScripts::ClearSpaceForMissionEntity(dest, who);
+	who->Teleport(dest);
+	if (who->IsVehicle() && ((CVehicle*)who)->IsCar())
+		((CAutomobile*)who)->PlaceOnRoadProperly();
+	// the camera has to accept a discontinuous jump, the same way the engine's
+	// own map teleport does; there is no fade-out to wait for here
+	TheCamera.RestoreWithJumpCut();
+	VCModRideNotice("skip the ride: arrived");
+	return true;
+}
+
+static bool
+VCModRideSpawnLimo(CPlayerPed *player)
+{
+	CStreaming::RequestModel(VCMOD_DRIVER_MODEL, 0);
+	CStreaming::LoadAllRequestedModels(false);
+	if (!CStreaming::HasModelLoaded(VCMOD_DRIVER_MODEL)) {
+		VCModRideNotice("driver: the limo cannot be loaded");
+		return false;
+	}
+
+	// come from behind Tommy so the approach is a drive, not a car under his feet
+	CVector here = player->GetPosition();
+	CVector from = here - player->GetForward() * VCMOD_SPAWN_BACK;
+	int32 node = ThePaths.FindNodeClosestToCoors(from, PATH_CAR, 60.0f, true, true);
+	if (node < 0)
+		node = ThePaths.FindNodeClosestToCoors(here, PATH_CAR, 200.0f, true, true);
+	if (node < 0) {
+		VCModRideNotice("driver: no road to come from");
+		return false;
+	}
+
+	CAutomobile *limo = new CAutomobile(VCMOD_DRIVER_MODEL, RANDOM_VEHICLE);
+	if (limo == nil) {
+		VCModRideNotice("driver: no room for a limo");
+		return false;
+	}
+
+	CVector pos = ThePaths.m_pathNodes[node].GetPosition();
+	limo->SetPosition(pos);
+	// face the pickup the way traffic spawns face their destination
+	CVector2D direction = here - pos;
+	direction.Normalise();
+	limo->GetForward() = CVector(direction.x, direction.y, 0.0f);
+	limo->GetRight() = CVector(direction.y, -direction.x, 0.0f);
+	limo->GetUp() = CVector(0.0f, 0.0f, 1.0f);
+	pos.z += limo->GetDistanceFromCentreOfMassToBaseOfModel();
+	limo->SetPosition(pos);
+	limo->PlaceOnRoadProperly();
+	limo->SetStatus(STATUS_PHYSICS);
+	limo->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+	limo->AutoPilot.m_nCruiseSpeed = 0;
+
+	if (limo->SetUpDriver() == nil) {
+		// nowhere to put a chauffeur: leave it as an abandoned car and say so
+		limo->SetStatus(STATUS_ABANDONED);
+		CWorld::Add(limo);
+		VCModRideNotice("driver: nobody to drive this");
+		return false;
+	}
+
+	// mission ownership keeps traffic from reclaiming it while it waits for us
+	limo->VehicleCreatedBy = MISSION_VEHICLE;
+	CCarCtrl::NumRandomCars--;
+	CCarCtrl::NumMissionCars++;
+	CTheScripts::ClearSpaceForMissionEntity(pos, limo);
+	CWorld::Add(limo);
+	CRadar::SetEntityBlip(BLIP_CAR, CPools::GetVehiclePool()->GetIndex(limo), 0, BLIP_DISPLAY_BOTH);
+
+	nVCModRideHandle = CPools::GetVehiclePool()->GetIndex(limo);
+	nVCModRidePhase = VCMOD_RIDE_APPROACH;
+	bVCModRideSummoned = true;
+	vecVCModRidePickup = here;
+	nVCModRideRetargetAt = 0;
+	CCarCtrl::JoinCarWithRoadSystemGotoCoors(limo, here, false);
+	limo->AutoPilot.m_nCarMission = MISSION_GOTOCOORDS;
+	limo->AutoPilot.m_nTempAction = TEMPACT_NONE;
+	VCModRideApplyStyle(limo, true);
+	VCModRideNotice("your driver is on the way");
+	return true;
+}
+
+void
+VCModCallDriver(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil || !player->IsPedInControl()) {
+		VCModRideNotice("driver: not right now");
+		return;
+	}
+
+	// calling again dismisses him, from the kerb or from the back seat
+	if (bVCModRideSummoned && nVCModRidePhase != VCMOD_RIDE_NONE) {
+		CVehicle *veh = VCModRideVehicle();
+		bool aboard = player->InVehicle() && player->m_pMyVehicle == veh;
+		VCModRideStandDown();
+		// dismissed while riding: wait for Tommy to get out instead of driving off,
+		// then the update pass hands the limo back to ordinary traffic
+		if (aboard && veh != nil) {
+			veh->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+			veh->AutoPilot.m_nCruiseSpeed = 0;
+			veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+			nVCModDismissedHandle = CPools::GetVehiclePool()->GetIndex(veh);
+		}
+		VCModRideNotice("driver dismissed");
+		return;
+	}
+
+	if (player->bInVehicle) {
+		VCModRideNotice("driver: get out first");
+		return;
+	}
+	VCModRideStandDown();
+	VCModRideSpawnLimo(player);
+}
+
+// the one-shot travel action: it is not a driving style, so no press of the enter
+// key can ever turn itself into a jump
+void
+VCModSkipRide(void)
+{
+	if (!VCModRideSkipTravel())
+		return;
+
+	CVehicle *veh = VCModRideVehicle();
+	CPlayerPed *player = FindPlayerPed();
+	bool aboard = player != nil && veh != nil && player->InVehicle() && player->m_pMyVehicle == veh;
+
+	// arrived with Tommy still inside: park and keep the ride open, so getting out
+	// ends it the ordinary way and the car goes back to traffic instead of staying
+	// stopped where the jump landed
+	if (aboard) {
+		veh->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		veh->AutoPilot.m_nCruiseSpeed = 0;
+		veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+		bVCModRideHasDestination = false;
+		return;
+	}
+	VCModRideStandDown();
+}
+
+static void
+VCModUpdatePickup(CPlayerPed *player, CVehicle *veh)
+{
+	if (nVCModRideAppliedStyle != nVCModRideStyle)
+		VCModRideApplyStyle(veh, true);
+
+	CVector here = player->GetPosition();
+	if (nVCModRidePhase == VCMOD_RIDE_APPROACH) {
+		// Tommy walked on: send the chauffeur to where he is now, not where he was
+		if ((here - vecVCModRidePickup).Magnitude2D() > VCMOD_RETARGET_NEAR &&
+				CTimer::GetTimeInMilliseconds() >= nVCModRideRetargetAt) {
+			vecVCModRidePickup = here;
+			nVCModRideRetargetAt = CTimer::GetTimeInMilliseconds() + VCMOD_RETARGET_WAIT;
+			CCarCtrl::JoinCarWithRoadSystemGotoCoors(veh, here, false);
+			veh->AutoPilot.m_nCarMission = MISSION_GOTOCOORDS;
+		}
+		if ((veh->GetPosition() - vecVCModRidePickup).Magnitude2D() < VCMOD_PICKUP_NEAR) {
+			veh->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+			veh->AutoPilot.m_nCruiseSpeed = 0;
+			nVCModRidePhase = VCMOD_RIDE_PICKUP;
+			VCModRideNotice("your driver is here");
+		}
+		return;
+	}
+
+	// waiting at the kerb: walking far enough away calls it off, the taxi's own rule
+	if ((here - veh->GetPosition()).Magnitude2D() > VCMOD_ABANDON_FAR) {
+		VCModRideStandDown();
+		VCModRideNotice("driver left: too far away");
+	}
+}
+
+static void
+VCModUpdateRide(CPlayerPed *player)
+{
+	// a dismissed chauffeur waits for Tommy to get out; the limo then goes back to
+	// ordinary traffic instead of being left stopped in the road
+	if (nVCModDismissedHandle >= 0) {
+		CVehicle *dismissed = CPools::GetVehiclePool()->GetAt(nVCModDismissedHandle);
+		if (dismissed == nil || !player->InVehicle() || player->m_pMyVehicle != dismissed) {
+			VCModRideReleaseToTraffic(dismissed);
+			nVCModDismissedHandle = -1;
+		}
+	}
+
+	if (nVCModRidePhase == VCMOD_RIDE_NONE)
+		return;
+
+	CVehicle *veh = VCModRideVehicle();
+	if (veh == nil) {
+		VCModRideStandDown();
+		return;
+	}
+
+	if (nVCModRidePhase == VCMOD_RIDE_APPROACH || nVCModRidePhase == VCMOD_RIDE_PICKUP) {
+		// Tommy got into a car himself instead of waiting: the call is off
+		if (player->InVehicle()) {
+			VCModRideStandDown();
+			return;
+		}
+		VCModUpdatePickup(player, veh);
+		return;
+	}
+
+	if (nVCModRidePhase == VCMOD_RIDE_BOARDING) {
+		if (player->InVehicle() && player->m_pMyVehicle == veh) {
+			nVCModRidePhase = VCMOD_RIDE_DRIVING;
+			return;
+		}
+		// another car, the objective taken away by something else, Tommy wandering
+		// off, or a door that never opens: the driver cannot be left stopped in the
+		// road waiting on a boarding that is not coming
+		bool otherCar = player->InVehicle();
+		bool lostObjective = player->m_objective != OBJECTIVE_ENTER_CAR_AS_PASSENGER ||
+			player->m_carInObjective != veh;
+		bool walkedOff = (player->GetPosition() - veh->GetPosition()).Magnitude2D() > VCMOD_BOARD_ABANDON_FAR;
+		bool waited = CTimer::GetTimeInMilliseconds() - nVCModRideBoardAt > VCMOD_BOARD_TIMEOUT;
+		if (otherCar || lostObjective || walkedOff || waited)
+			VCModRideStandDown();
+		return;
+	}
+
+	// out of the car, or it went away: the ride is over either way
+	if (!player->InVehicle() || player->m_pMyVehicle != veh) {
+		VCModRideStandDown();
+		return;
+	}
+
+	// the selector is live: changing it re-routes the driver
+	if (nVCModRideAppliedStyle != nVCModRideStyle)
+		VCModRideDrive(veh);
+
+	if (bVCModRideHasDestination &&
+			(veh->GetPosition() - vecVCModRideDestination).Magnitude2D() < VCMOD_ARRIVE_NEAR) {
+		// wait here with Tommy inside; getting out is what ends the ride, and the
+		// ordinary exit then hands the car back to traffic with its own pace
+		veh->AutoPilot.m_nCarMission = MISSION_STOP_FOREVER;
+		veh->AutoPilot.m_nCruiseSpeed = 0;
+		veh->AutoPilot.m_nTempAction = TEMPACT_NONE;
+		bVCModRideHasDestination = false;
+		VCModRideNotice(bVCModRideSummoned ? "your driver has arrived" : "passenger mode: arrived");
+	}
+}
+
+// which group the player wears: the picker when it is on, otherwise whatever the
+// character model brought, and neither while the stock logic needs its own
+static bool
+VCModPlayerAnimGroup(CPlayerPed *player, bool strafing, AssocGroupId *out)
+{
+	if (strafing)
+		return false;
+	if (bVCModPlayerNpcAnims)
+		return VCModPickAnimGroup(out);
+	return VCModPedAnimGroupFor(player->GetModelIndex(), out);
+}
+
+// ---- street idle: waiting on the pavement, and the pair chat the peds have --
+// the reasons are the peds' own, not new ones: a ped who is stuck waiting on a
+// pavement plays idle_hbhb (WAITSTATE_CROSS_ROAD / DOUBLEBACK), and a wandering
+// ped within 1.8 m of another one starts the same idle_chat pair both ways.
+// Tommy gets both on the same terms, on foot, unarmed and off the tarmac.
+static bool bVCModStreetChat;
+static CPed *pVCModStreetPartner;
+static uint32 nVCModStreetChatEnd;
+static uint32 nVCModStreetStillSince;
+static uint32 nVCModStreetGestureEnd;
+static uint32 nVCModStreetNextGesture;
+static uint32 nVCModStreetNextChat;
+// the chat's own voices: whose line is next, and when it may land
+static uint32 nVCModStreetNextTalk;
+static bool bVCModStreetPlayerTurn;
+// the chat's own gesture: when the speaker's hands go back to rest
+static uint32 nVCModStreetTalkEnd;
+static int32 nVCModStreetLastBlock = -1;
+// the head scratch that sometimes follows the waiting pose
+static bool bVCModStreetScratch;
+static uint32 nVCModStreetScratchEnd;
+// sitting on a seat attractor
+static bool bVCModSitting;
+static bool bVCModSitStanding;
+static bool bVCModSitIdleHeld;
+// the anchor he sat down on: the on-foot mouse camera aims the ped wherever it
+// looks, which swings him around the seat, so the seat keeps him
+static CVector vecVCModSeatPos;
+static float fVCModSeatHeading;
+// who a seat is really holding, read from the peds instead of the attractor
+// manager's slot count
+#define VCMOD_SIT_USER_RANGE 12.0f	// a ped picks a seat from up to 10 m away
+#define VCMOD_SIT_USERS		24
+static CPed *pVCModSeatUsersLive[VCMOD_SIT_USERS];
+static CPed *pVCModSeatUsersDead[VCMOD_SIT_USERS];
+static int32 nVCModSeatUsersLive;
+static int32 nVCModSeatUsersDead;
+static CPed *pVCModSeatChosenDead;
+static CPed *pVCModSeatBlockedBy;
+
+#define VCMOD_STREET_WAIT		4000	// still this long before the waiting pose
+#define VCMOD_STREET_GESTURE_GAP 14000
+#define VCMOD_STREET_CHAT_WAIT	2500
+#define VCMOD_STREET_CHAT_RANGE	1.8f	// the ped chat start distance
+#define VCMOD_STREET_CHAT_KEEP	4.0f	// how far they may drift and still talk
+#define VCMOD_STREET_CHAT_MIN	10000
+#define VCMOD_STREET_CHAT_MAX	14000
+#define VCMOD_STREET_CHAT_GAP	30000
+#define VCMOD_STREET_CHAT_ABORT_GAP 10000
+// a line is a second or two, so this leaves a beat of silence between them:
+// Chat()'s own 1.5 s per ped is what made the pair talk over itself
+#define VCMOD_STREET_TALK_MIN	3500
+#define VCMOD_STREET_TALK_MAX	5000
+// a line measures ~1.6 s in the voice bank; the hands ride a little past it and
+// rest until the next turn, instead of Chat()'s restart every two seconds
+#define VCMOD_STREET_TALK_GESTURE 1800
+// the beat after the last line's gesture before the pair parts: a ped walks on
+// after the exchange, and the player needs somewhere for it to end instead of
+// a timer cutting the conversation mid-line
+#define VCMOD_STREET_TALK_REST	600
+#define VCMOD_SIT_RANGE		2.0f	// reach from the feet to the seat effect
+#define VCMOD_SIT_HOLD		600000	// the seat's own 25-30 s is not how C should end
+
+// one bit per refusal, so a feature that stays silent can say which condition
+// held it back instead of only failing to start
+enum
+{
+	VCMOD_STREET_NO_AI	= 1 << 0,
+	VCMOD_STREET_IN_CAR	= 1 << 1,
+	VCMOD_STREET_DYING	= 1 << 2,
+	VCMOD_STREET_DUCKING = 1 << 3,
+	VCMOD_STREET_AIMING	= 1 << 4,
+	VCMOD_STREET_STATE	= 1 << 5,
+	VCMOD_STREET_MOVING	= 1 << 6,
+	VCMOD_STREET_IN_AIR	= 1 << 7,
+	VCMOD_STREET_IN_WATER = 1 << 8,
+	VCMOD_STREET_CONTROLS = 1 << 9,
+	VCMOD_STREET_INPUT	= 1 << 10,
+	VCMOD_STREET_ACTION	= 1 << 11,
+	VCMOD_STREET_TARMAC	= 1 << 12
+};
+
+static int32
+VCModStreetBlockReason(CPlayerPed *player, CPad *pad)
+{
+	int32 reason = 0;
+	if (!player->IsPedInControl()) reason |= VCMOD_STREET_NO_AI;
+	if (player->bInVehicle) reason |= VCMOD_STREET_IN_CAR;
+	if (player->DyingOrDead()) reason |= VCMOD_STREET_DYING;
+	if (player->bIsDucking) reason |= VCMOD_STREET_DUCKING;
+	if (player->bIsAimingGun || player->bIsPointingGunAt) reason |= VCMOD_STREET_AIMING;
+	if (player->m_nPedState != PED_IDLE && player->m_nPedState != PED_CHAT) reason |= VCMOD_STREET_STATE;
+	if (player->m_fMoveSpeed > 0.05f) reason |= VCMOD_STREET_MOVING;
+	if (player->bIsInTheAir) reason |= VCMOD_STREET_IN_AIR;
+	if (player->bIsInWater) reason |= VCMOD_STREET_IN_WATER;
+	if (pad->ArePlayerControlsDisabled()) reason |= VCMOD_STREET_CONTROLS;
+	if (pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0) reason |= VCMOD_STREET_INPUT;
+	if (pad->JumpJustDown() || pad->GetWeapon() != 0 || pad->GetTarget()) reason |= VCMOD_STREET_ACTION;
+	if (player->m_nSurfaceTouched == SURFACE_TARMAC) reason |= VCMOD_STREET_TARMAC;
+	return reason;
+}
+
+static void
+VCModStreetFadeGesture(CPlayerPed *player)
+{
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_IDLE_HBHB);
+	if (assoc) {
+		// the ped's own waits fade the pose at 8.0, but those end at a timer and
+		// this one ends when Tommy walks off, so give the arms half a second to
+		// come back instead of the 0.125 s cut the engine uses
+		assoc->blendDelta = -2.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+static void
+VCModStreetStartGesture(CPlayerPed *player)
+{
+	CAnimBlendAssociation *assoc = CAnimManager::BlendAnimation(player->GetClump(), ASSOCGRP_STD, ANIM_STD_IDLE_HBHB, 2.0f);
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	// idle_hbhb is one 3.9 s cycle that raises the arms, holds, and puts them
+	// back at the pose it started from. A fixed 3-5 s hold faded the pose at a
+	// random point of that cycle, sometimes a frame after the repeat had started
+	// raising the arms again, which is the snap the ped wait states never show.
+	// Hold exactly one cycle and fade where the clip has already returned.
+	uint32 cycle = (uint32)(assoc->hierarchy->totalLength * 1000.0f);
+	nVCModStreetGestureEnd = now + (cycle > 200 ? cycle - 120 : cycle);
+	nVCModStreetNextGesture = nVCModStreetGestureEnd + VCMOD_STREET_GESTURE_GAP;
+	fprintf(stderr, "VCMOD street idle: waiting pose (%.2fs cycle)\n", assoc->hierarchy->totalLength);
+}
+
+// the ped DOUBLEBACK wait goes from the hands-behind-back pose into a scratch,
+// so half the time Tommy follows his cycle with the same one
+static void
+VCModStreetStartScratch(CPlayerPed *player)
+{
+	CAnimBlendAssociation *assoc = CAnimManager::BlendAnimation(player->GetClump(), ASSOCGRP_STD, ANIM_STD_XPRESS_SCRATCH, 2.0f);
+	// the stock idle pool owns everything flagged ASSOC_IDLE and would fade this
+	// out at 8.0; it is ours until the cycle ends, so take the flag off
+	assoc->flags &= ~ASSOC_IDLE;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	uint32 cycle = (uint32)(assoc->hierarchy->totalLength * 1000.0f);
+	nVCModStreetScratchEnd = now + (cycle > 200 ? cycle - 120 : cycle);
+	bVCModStreetScratch = true;
+	fprintf(stderr, "VCMOD street idle: head scratch (%.2fs cycle)\n", assoc->hierarchy->totalLength);
+}
+
+static void
+VCModStreetFadeScratch(CPlayerPed *player)
+{
+	if (!bVCModStreetScratch)
+		return;
+	bVCModStreetScratch = false;
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_XPRESS_SCRATCH);
+	if (assoc) {
+		assoc->blendDelta = -2.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+static void
+VCModStreetFadePose(CPlayerPed *player)
+{
+	VCModStreetFadeGesture(player);
+	VCModStreetFadeScratch(player);
+}
+
+// the pair's own chat gesture: one line gets one talk cycle from the clip's
+// first pose. Chat()'s stock cycle threw the clip in at a random offset and
+// faded it a second or two later, so the arms restarted mid-gesture all
+// through the conversation.
+static void
+VCModStreetFadeTalk(CPed *ped)
+{
+	if (ped == nil)
+		return;
+	CAnimBlendAssociation *assoc = RpAnimBlendClumpGetAssociation(ped->GetClump(), ANIM_STD_CHAT);
+	if (assoc) {
+		assoc->blendDelta = -4.0f;
+		assoc->flags |= ASSOC_DELETEFADEDOUT;
+	}
+}
+
+static void
+VCModStreetStartTalk(CPlayerPed *player, CPed *ped)
+{
+	// one gesture at a time: the other side's hands rest while this one talks
+	VCModStreetFadeTalk(ped == player ? pVCModStreetPartner : (CPed*)player);
+	CAnimBlendAssociation *assoc = CAnimManager::BlendAnimation(ped->GetClump(), ASSOCGRP_STD, ANIM_STD_CHAT, 4.0f);
+	if (assoc) {
+		assoc->SetCurrentTime(0.0f);
+		assoc->SetRun();
+	}
+	nVCModStreetTalkEnd = CTimer::GetTimeInMilliseconds() + VCMOD_STREET_TALK_GESTURE;
+	fprintf(stderr, "VCMOD street idle: %s gesture\n", ped == player ? "player" : "partner");
+}
+
+static void
+VCModStreetEndTalk(CPlayerPed *player)
+{
+	VCModStreetFadeTalk(player);
+	VCModStreetFadeTalk(pVCModStreetPartner);
+	nVCModStreetTalkEnd = 0;
+}
+
+// the same candidate the ped chat start would pick: a wandering civilian in
+// reach, both able to see each other, on a surface WillChat accepts
+static CPed *
+VCModStreetChatPartner(CPlayerPed *player)
+{
+	float rangeSqr = sq(VCMOD_STREET_CHAT_RANGE);
+	for (int32 i = 0; i < player->m_numNearPeds; i++) {
+		CPed *ped = player->m_nearPeds[i];
+		if (ped == nil || ped == player || ped->CharCreatedBy != RANDOM_CHAR)
+			continue;
+		if (!ped->IsPedShootable() || ped->DyingOrDead() || ped->bInVehicle)
+			continue;
+		if (ped->m_nPedState != PED_WANDER_PATH && ped->m_nPedState != PED_IDLE)
+			continue;
+		// cops and gang members have their own business with Tommy
+		if (ped->m_nPedType != PEDTYPE_CIVMALE && ped->m_nPedType != PEDTYPE_CIVFEMALE)
+			continue;
+		if ((ped->GetPosition() - player->GetPosition()).MagnitudeSqr() > rangeSqr)
+			continue;
+		if (!player->CanSeeEntity(ped) || !ped->CanSeeEntity(player))
+			continue;
+		if (!ped->WillChat(player))
+			continue;
+		return ped;
+	}
+	return nil;
+}
+
+// the chat is not a wait state: only a press, a car, a death or being knocked
+// down ends it. The point is what is NOT here - a ped shoving Tommy changes the
+// move speed and the touched surface for a frame or two, and testing those used
+// to end the conversation the moment anybody brushed past.
+enum
+{
+	VCMOD_CHATBREAK_DEAD	= 1 << 0,
+	VCMOD_CHATBREAK_IN_CAR	= 1 << 1,
+	VCMOD_CHATBREAK_CONTROLS = 1 << 2,
+	VCMOD_CHATBREAK_INPUT	= 1 << 3,
+	VCMOD_CHATBREAK_ACTION	= 1 << 4,
+	VCMOD_CHATBREAK_DUCK	= 1 << 5,
+	VCMOD_CHATBREAK_STATE	= 1 << 6,
+	VCMOD_CHATBREAK_PARTNER = 1 << 7
+};
+
+static int32
+VCModStreetChatBreak(CPlayerPed *player, CPad *pad)
+{
+	int32 reason = 0;
+	if (player->DyingOrDead()) reason |= VCMOD_CHATBREAK_DEAD;
+	if (player->bInVehicle) reason |= VCMOD_CHATBREAK_IN_CAR;
+	if (pad->ArePlayerControlsDisabled()) reason |= VCMOD_CHATBREAK_CONTROLS;
+	if (pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0) reason |= VCMOD_CHATBREAK_INPUT;
+	if (pad->JumpJustDown() || pad->GetWeapon() != 0 || pad->GetTarget()) reason |= VCMOD_CHATBREAK_ACTION;
+	if (player->bIsDucking) reason |= VCMOD_CHATBREAK_DUCK;
+	// only a state that actually took him out of the chat (a fall, a stagger)
+	// counts; a shove that leaves him standing keeps him in PED_CHAT
+	if (player->m_nPedState != PED_CHAT && player->m_nPedState != PED_IDLE) reason |= VCMOD_CHATBREAK_STATE;
+	return reason;
+}
+
+static bool
+VCModStreetPartnerLost(CPlayerPed *player, CPed *partner)
+{
+	if (partner == nil || partner->DyingOrDead() || partner->bInVehicle)
+		return true;
+	// a pedestrian that got frightened or pulled into a fight is done talking;
+	// only the shove that knocks it out of the chat for a frame is put back
+	if (partner->m_nPedState != PED_CHAT
+		&& partner->m_nPedState != PED_IDLE
+		&& partner->m_nPedState != PED_WANDER_PATH
+		&& partner->m_nPedState != PED_WANDER_RANGE
+		&& partner->m_nPedState != PED_NONE)
+		return true;
+	return (partner->GetPosition() - player->GetPosition()).MagnitudeSqr() > sq(VCMOD_STREET_CHAT_KEEP);
+}
+
+static void
+VCModStreetEndChat(CPlayerPed *player, uint32 nextGap, const char *why)
+{
+	CPed *partner = pVCModStreetPartner;
+	if (partner) {
+		if (partner->m_nPedState == PED_CHAT)
+			partner->ClearChat();
+		partner->CleanUpOldReference((CEntity**)&pVCModStreetPartner);
+		pVCModStreetPartner = nil;
+	}
+	if (player->m_nPedState == PED_CHAT)
+		player->ClearChat();
+	// ClearChat drops the clip at 8.0, an eighth of a second, which is the snap at
+	// the end of the conversation; the hands come down at the gesture's own 4.0
+	// instead, so parting reads as a beat after the last line
+	VCModStreetFadeTalk(player);
+	if (partner)
+		VCModStreetFadeTalk(partner);
+	// the engine's own chat end leaves a 30 s gap before a ped chats again; with
+	// its timer gated for the pair, that gap is set here instead
+	player->m_chatTimer = CTimer::GetTimeInMilliseconds() + 30000;
+	if (partner)
+		partner->m_chatTimer = player->m_chatTimer;
+	nVCModStreetTalkEnd = 0;
+	bVCModStreetChat = false;
+	bVCModStreetPlayerTurn = false;
+	nVCModStreetNextTalk = 0;
+	nVCModStreetStillSince = 0;
+	nVCModStreetNextChat = CTimer::GetTimeInMilliseconds() + nextGap;
+	fprintf(stderr, "VCMOD street idle: chat ended (%s)\n", why);
+}
+
+// the chat owns its pair's voices and hands; CPed::Chat() runs its own animation
+// cycle for both of them, which put two lines on top of each other and restarted
+// the gesture every couple of seconds
+bool
+VCModStreetChatOwnsPed(CPed *ped)
+{
+	return bVCModStreetChat && (ped == FindPlayerPed() || ped == pVCModStreetPartner);
+}
+
+static void
+VCModStreetSayChat(CPed *ped)
+{
+	// straight into the ped's own voice, with the repeat guard Say() would have
+	// set after speaking: the next line must not repeat the one before it
+	DMAudio.PlayOneShot(ped->m_audioEntityId, SOUND_PED_CHAT, 1.0f);
+	ped->m_lastSoundStart = CTimer::GetTimeInMilliseconds();
+	ped->m_lastQueuedSound = SOUND_PED_CHAT;
+	fprintf(stderr, "VCMOD street idle: %s line\n", ped->IsPlayer() ? "player" : "partner");
+}
+
+static bool
+VCModStreetPlayerHasChatVoice(CPlayerPed *player)
+{
+	int32 model = player->GetModelIndex();
+	// Tommy and the cutscene bodies carry no chat lines in their bank, and a turn
+	// nobody can voice would be a hole in the exchange, so the partner takes it
+	return model != MI_PLAYER && !(model >= MI_SPECIAL01 && model <= MI_LAST_PED);
+}
+
+static void
+VCModStreetStartChat(CPlayerPed *player, CPed *partner, uint32 time)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	VCModStreetFadePose(player);
+	player->SetChat(partner, time);
+	partner->SetChat(player, time);
+	pVCModStreetPartner = partner;
+	pVCModStreetPartner->RegisterReference((CEntity**)&pVCModStreetPartner);
+	bVCModStreetChat = true;
+	nVCModStreetChatEnd = now + time;
+	nVCModStreetNextChat = now + VCMOD_STREET_CHAT_GAP;
+
+	// the partner opens and the player answers, then it goes back and forth on the
+	// same beat; the pair's own Say() is out of the loop while this chat runs
+	VCModStreetSayChat(partner);
+	VCModStreetStartTalk(player, partner);
+	bVCModStreetPlayerTurn = true;
+	nVCModStreetNextTalk = now + CGeneral::GetRandomNumberInRange(VCMOD_STREET_TALK_MIN, VCMOD_STREET_TALK_MAX);
+
+	fprintf(stderr, "VCMOD street idle: chat started with model %d for %.1fs\n",
+		(int)partner->GetModelIndex(), time / 1000.0f);
+}
+
+static void
+VCModStreetKeepChat(CPlayerPed *player)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (now >= nVCModStreetChatEnd || pVCModStreetPartner == nil)
+		return;
+
+	uint32 left = nVCModStreetChatEnd - now;
+	// a shove can drop either side out of PED_CHAT for a frame without either of
+	// them having finished; put them back and keep the clock where it was
+	if (pVCModStreetPartner->m_nPedState != PED_CHAT && pVCModStreetPartner->IsPedInControl())
+		pVCModStreetPartner->SetChat(player, left);
+	if (player->m_nPedState != PED_CHAT)
+		player->SetChat(pVCModStreetPartner, left);
+
+	// Chat() only turns the body while the look flag is up, and SetChat gives it
+	// a three second timer, so the pair used to stop facing each other a third of
+	// the way in. Re-arm it after the control code so nothing later overwrites it.
+	if (!player->bIsLooking || player->m_pLookTarget != pVCModStreetPartner)
+		player->SetLookFlag(pVCModStreetPartner, true, true);
+	if (!pVCModStreetPartner->bIsLooking || pVCModStreetPartner->m_pLookTarget != player)
+		pVCModStreetPartner->SetLookFlag(player, true, true);
+
+	// one line a turn with a beat between them: the pair trades lines instead of
+	// both animation cycles barking at their own 1.5 s pace
+	if (nVCModStreetTalkEnd && now >= nVCModStreetTalkEnd) {
+		VCModStreetEndTalk(player);
+		// the hands are down and the next line would land past the clock, so
+		// this rest beat is where the pair parts; without this the chat would
+		// run on in silence until the timer
+		if (nVCModStreetNextTalk >= nVCModStreetChatEnd)
+			nVCModStreetChatEnd = now + VCMOD_STREET_TALK_REST;
+	}
+	if (now >= nVCModStreetNextTalk) {
+		// the hands belong to the turn, not to the voice: a body with no chat
+		// bank still answers with its hands while the partner speaks
+		CPed *turn = bVCModStreetPlayerTurn ? (CPed*)player : pVCModStreetPartner;
+		CPed *speaker = bVCModStreetPlayerTurn && VCModStreetPlayerHasChatVoice(player)
+			? (CPed*)player : pVCModStreetPartner;
+		VCModStreetSayChat(speaker);
+		VCModStreetStartTalk(player, turn);
+		bVCModStreetPlayerTurn = !bVCModStreetPlayerTurn;
+		nVCModStreetNextTalk = now + CGeneral::GetRandomNumberInRange(VCMOD_STREET_TALK_MIN, VCMOD_STREET_TALK_MAX);
+		// a line that runs past the clock moves the clock: the pair parts on the
+		// rest beat after its last line, the way a ped finishes the exchange
+		// before walking on, instead of leaving or cutting it mid-turn
+		if (nVCModStreetTalkEnd + VCMOD_STREET_TALK_REST > nVCModStreetChatEnd)
+			nVCModStreetChatEnd = nVCModStreetTalkEnd + VCMOD_STREET_TALK_REST;
+	}
+}
+
+static void
+VCModUpdateStreetIdle(CPlayerPed *player, CPad *pad)
+{
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	// the seat owns Tommy's pose; no waiting gesture or chat starts on top of it
+	if (bVCModSitting) {
+		VCModStreetFadePose(player);
+		nVCModStreetStillSince = 0;
+		return;
+	}
+
+	if (!bVCModStreetIdle) {
+		VCModStreetFadePose(player);
+		if (bVCModStreetChat)
+			VCModStreetEndChat(player, VCMOD_STREET_CHAT_ABORT_GAP, "switched off");
+		nVCModStreetStillSince = 0;
+		return;
+	}
+
+	if (bVCModStreetChat) {
+		int32 brk = VCModStreetChatBreak(player, pad);
+		if (VCModStreetPartnerLost(player, pVCModStreetPartner))
+			brk |= VCMOD_CHATBREAK_PARTNER;
+		if (brk != 0) {
+			const char *why = brk & VCMOD_CHATBREAK_PARTNER ? "partner gone"
+				: brk & VCMOD_CHATBREAK_DEAD ? "died"
+				: brk & VCMOD_CHATBREAK_IN_CAR ? "into a car"
+				: brk & VCMOD_CHATBREAK_CONTROLS ? "controls taken"
+				: brk & VCMOD_CHATBREAK_STATE ? "knocked down"
+				: brk & VCMOD_CHATBREAK_DUCK ? "crouched"
+				: brk & VCMOD_CHATBREAK_INPUT ? "walked off" : "drew a weapon";
+			VCModStreetEndChat(player, VCMOD_STREET_CHAT_ABORT_GAP, why);
+		} else if (now >= nVCModStreetChatEnd) {
+			VCModStreetEndChat(player, VCMOD_STREET_CHAT_GAP, "time up");
+		}
+		// the pair is kept turned and in the chat by VCModStreetKeepChat, which
+		// runs at the end of the frame, after the control and camera code
+		return;
+	}
+
+	int32 block = VCModStreetBlockReason(player, pad);
+	if (block != 0) {
+		// one line per distinct refusal, so a silent feature names its reason
+		if (block != nVCModStreetLastBlock) {
+			fprintf(stderr, "VCMOD street idle held: 0x%x state=%d wep=%d surf=%d spd=%.2f\n",
+				(uint32)block, (int)player->m_nPedState, (int)player->GetWeapon()->m_eWeaponType,
+				(int)player->m_nSurfaceTouched, player->m_fMoveSpeed);
+			nVCModStreetLastBlock = block;
+		}
+		nVCModStreetStillSince = 0;
+		VCModStreetFadePose(player);
+		return;
+	}
+	nVCModStreetLastBlock = -1;
+
+	if (nVCModStreetStillSince == 0)
+		nVCModStreetStillSince = now;
+
+	uint32 stillFor = now - nVCModStreetStillSince;
+
+	bool waiting = RpAnimBlendClumpGetAssociation(player->GetClump(), ANIM_STD_IDLE_HBHB) != nil;
+	// the stock bored fidget (stretch, watch, scratch) owns the pose when it is
+	// playing, and the waiting pose steps aside for it
+	if (bVCModStreetScratch) {
+		if (now >= nVCModStreetScratchEnd)
+			VCModStreetFadeScratch(player);
+	} else if (RpAnimBlendClumpGetFirstAssociation(player->GetClump(), ASSOC_IDLE)) {
+		VCModStreetFadeGesture(player);
+	} else if (waiting && now >= nVCModStreetGestureEnd) {
+		if (CGeneral::GetRandomNumber() & 1)
+			VCModStreetStartScratch(player);
+		else
+			VCModStreetFadeGesture(player);
+	} else if (!waiting && stillFor >= VCMOD_STREET_WAIT && now >= nVCModStreetNextGesture) {
+		VCModStreetStartGesture(player);
+	}
+
+	if (stillFor >= VCMOD_STREET_CHAT_WAIT && now >= nVCModStreetNextChat) {
+		CPed *partner = VCModStreetChatPartner(player);
+		if (partner)
+			VCModStreetStartChat(player, partner,
+				CGeneral::GetRandomNumberInRange(VCMOD_STREET_CHAT_MIN, VCMOD_STREET_CHAT_MAX));
+		else
+			// nobody to talk to this time; look again once the scene has moved
+			nVCModStreetNextChat = now + 2000;
+	}
+}
+
+// ---- sitting: C on a chair or bench -----------------------------------------
+// the map's seat attractors are what the peds sit on, so C looks for the seat a
+// ped would use (same front-side approach test) and runs the same SEAT_down,
+// SEAT_idle and SEAT_up sequence the ped wait states run. Without a seat in
+// reach the press stays the stock crouch.
+//
+// the manager's slot test counts per effect, not per bench: a ped on any other
+// instance of the same bench model makes every instance read as full, and a
+// count can outlive the ped that held it (a sitter killed on the bench). The
+// seat's real users are therefore read from the peds: a living ped blocks the
+// seat its attractor points at, on this instance's position; a dead one does
+// not. A ped registers from up to 10 m away, so the search is wider than the
+// press range.
+static bool
+VCModSeatUserMatches(CPed *ped, const C2dEffect *effect, const CVector &seatPos)
+{
+	return ped->m_attractor
+		&& ped->m_attractor->GetEffect() == effect
+		&& (ped->m_attractor->GetEffectPos() - seatPos).MagnitudeSqr() < 0.01f;
+}
+
+static CPed *
+VCModSeatUser(CPed **peds, int32 count, const C2dEffect *effect, const CVector &seatPos)
+{
+	for (int32 i = 0; i < count; i++)
+		if (VCModSeatUserMatches(peds[i], effect, seatPos))
+			return peds[i];
+	return nil;
+}
+
+static void
+VCModStreetCollectSeatUsers(CPlayerPed *player)
+{
+	CVector from = player->GetPosition();
+	nVCModSeatUsersLive = 0;
+	nVCModSeatUsersDead = 0;
+
+	int32 xstart = Max(0, CWorld::GetSectorIndexX(from.x - VCMOD_SIT_USER_RANGE));
+	int32 xend = Min(NUMSECTORS_X - 1, CWorld::GetSectorIndexX(from.x + VCMOD_SIT_USER_RANGE));
+	int32 ystart = Max(0, CWorld::GetSectorIndexY(from.y - VCMOD_SIT_USER_RANGE));
+	int32 yend = Min(NUMSECTORS_Y - 1, CWorld::GetSectorIndexY(from.y + VCMOD_SIT_USER_RANGE));
+
+	for (int32 y = ystart; y <= yend; y++) {
+		for (int32 x = xstart; x <= xend; x++) {
+			CPtrList &list = CWorld::GetSector(x, y)->m_lists[ENTITYLIST_PEDS];
+			for (CPtrNode *node = list.first; node; node = node->next) {
+				CPed *ped = (CPed*)node->item;
+				if (!ped->m_attractor || !ped->m_attractor->GetEffect()
+					|| ped->m_attractor->GetEffect()->type != EFFECT_PED_ATTRACTOR)
+					continue;
+				if (ped->DyingOrDead()) {
+					if (nVCModSeatUsersDead < VCMOD_SIT_USERS)
+						pVCModSeatUsersDead[nVCModSeatUsersDead++] = ped;
+				} else if (nVCModSeatUsersLive < VCMOD_SIT_USERS) {
+					pVCModSeatUsersLive[nVCModSeatUsersLive++] = ped;
+				}
+			}
+		}
+	}
+}
+
+static bool
+VCModStreetScanSeats(CPlayerPed *player, CPtrList &list, float &best, float &nearest, CEntity **outEnt, C2dEffect **outEffect)
+{
+	bool found = false;
+	for (CPtrNode *node = list.first; node; node = node->next) {
+		CEntity *ent = (CEntity*)node->item;
+		// a real object that has already been smashed is not a seat any more
+		if (ent->IsObject() && ((CObject*)ent)->bHasBeenDamaged)
+			continue;
+
+		CBaseModelInfo *info = CModelInfo::GetModelInfo(ent->GetModelIndex());
+		for (int32 i = 0; i < info->GetNum2dEffects(); i++) {
+			C2dEffect *effect = info->Get2dEffect(i);
+			if (effect->type != EFFECT_PED_ATTRACTOR || effect->pedattr.type != ATTRACTOR_SEAT)
+				continue;
+
+			CVector pos;
+			CPedAttractorManager::ComputeEffectPos(effect, ent->GetMatrix(), pos);
+			if (Abs(pos.z - player->GetPosition().z) > 1.5f)
+				continue;
+
+			float dist = (pos - player->GetPosition()).MagnitudeSqr();
+			if (dist < nearest)
+				nearest = dist;
+			if (dist >= best)
+				continue;
+			// a living ped heading for this seat, queued or sitting in it, is
+			// what makes it taken; a dead one left behind does not
+			CPed *user = VCModSeatUser(pVCModSeatUsersLive, nVCModSeatUsersLive, effect, pos);
+			if (user) {
+				pVCModSeatBlockedBy = user;
+				continue;
+			}
+
+			best = dist;
+			pVCModSeatChosenDead = VCModSeatUser(pVCModSeatUsersDead, nVCModSeatUsersDead, effect, pos);
+			*outEnt = ent;
+			*outEffect = effect;
+			found = true;
+		}
+	}
+	return found;
+}
+
+// a seat whose only left-over user is a body is free to use, but the log has to
+// say that is why the press went through
+static void
+VCModStreetSeatIgnoredDead(void)
+{
+	if (!pVCModSeatChosenDead)
+		return;
+	static uint32 lastAt;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (lastAt != 0 && now - lastAt <= 5000)
+		return;
+	lastAt = now;
+	fprintf(stderr, "VCMOD sit: dead sitter ignored (ped %d)\n", pVCModSeatChosenDead->GetModelIndex());
+}
+
+// and when a living ped is the reason, name it instead of only saying "someone"
+static void
+VCModStreetSeatTakenLog(void)
+{
+	if (!pVCModSeatBlockedBy)
+		return;
+	static uint32 lastAt;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (lastAt != 0 && now - lastAt <= 5000)
+		return;
+	lastAt = now;
+	CPed *ped = pVCModSeatBlockedBy;
+	fprintf(stderr, "VCMOD sit: seat held by ped %d state %d wait %d\n",
+		ped->GetModelIndex(), (int32)ped->m_nPedState, (int32)ped->m_nWaitState);
+}
+
+static bool
+VCModStreetFindSeat(CPlayerPed *player, CVector *outPos, float *outHeading, float *outNearest)
+{
+	CVector from = player->GetPosition();
+	float best = sq(VCMOD_SIT_RANGE);
+	// how close the closest seat gets, taken or not; the refusal uses it to tell
+	// "stand closer" from "someone is sitting there"
+	float nearest = sq(4.0f);
+	CEntity *bestEnt = nil;
+	C2dEffect *bestEffect = nil;
+
+	pVCModSeatBlockedBy = nil;
+	pVCModSeatChosenDead = nil;
+	VCModStreetCollectSeatUsers(player);
+
+	int32 xstart = Max(0, CWorld::GetSectorIndexX(from.x - VCMOD_SIT_RANGE));
+	int32 xend = Min(NUMSECTORS_X - 1, CWorld::GetSectorIndexX(from.x + VCMOD_SIT_RANGE));
+	int32 ystart = Max(0, CWorld::GetSectorIndexY(from.y - VCMOD_SIT_RANGE));
+	int32 yend = Min(NUMSECTORS_Y - 1, CWorld::GetSectorIndexY(from.y + VCMOD_SIT_RANGE));
+
+	for (int32 y = ystart; y <= yend; y++) {
+		for (int32 x = xstart; x <= xend; x++) {
+			CSector *sector = CWorld::GetSector(x, y);
+			// map props are placed as dummies, not objects: a park bench is in the
+			// dummies list, so the ped attractor scan alone would never see one
+			VCModStreetScanSeats(player, sector->m_lists[ENTITYLIST_BUILDINGS], best, nearest, &bestEnt, &bestEffect);
+			VCModStreetScanSeats(player, sector->m_lists[ENTITYLIST_OBJECTS], best, nearest, &bestEnt, &bestEffect);
+			VCModStreetScanSeats(player, sector->m_lists[ENTITYLIST_DUMMIES], best, nearest, &bestEnt, &bestEffect);
+			VCModStreetScanSeats(player, sector->m_lists[ENTITYLIST_BUILDINGS_OVERLAP], best, nearest, &bestEnt, &bestEffect);
+			VCModStreetScanSeats(player, sector->m_lists[ENTITYLIST_OBJECTS_OVERLAP], best, nearest, &bestEnt, &bestEffect);
+			VCModStreetScanSeats(player, sector->m_lists[ENTITYLIST_DUMMIES_OVERLAP], best, nearest, &bestEnt, &bestEffect);
+		}
+	}
+	*outNearest = nearest;
+	if (bestEffect == nil)
+		return false;
+
+	// the seat effect position is where a ped's feet stand; the use direction is
+	// the way the sitter faces. Seeking is 2D for the peds, so drop to the ground
+	// at that x/y instead of trusting the effect's own z.
+	CPedAttractorManager::ComputeEffectPos(bestEffect, bestEnt->GetMatrix(), *outPos);
+	CPedPlacement::FindZCoorForPed(outPos);
+	CVector useDir;
+	CPedAttractorManager::ComputeEffectUseDir(bestEffect, bestEnt->GetMatrix(), useDir);
+	*outHeading = CGeneral::GetRadianAngleBetweenPoints(useDir.x, useDir.y, 0.0f, 0.0f);
+	VCModStreetSeatIgnoredDead();
+	return true;
+}
+
+static void
+VCModStreetSitDown(CPlayerPed *player, const CVector &pos, float heading)
+{
+	VCModStreetFadePose(player);
+	player->SetPosition(pos);
+	player->m_vecMoveSpeed = CVector(0.0f, 0.0f, 0.0f);
+	player->m_fRotationCur = heading;
+	player->m_fRotationDest = heading;
+	player->SetHeading(heading);
+	player->SetMoveState(PEDMOVE_STILL);
+	player->ClearLookFlag();
+	player->SetWaitState(WAITSTATE_SIT_DOWN, nil);
+	vecVCModSeatPos = pos;
+	fVCModSeatHeading = heading;
+	bVCModSitting = true;
+	bVCModSitStanding = false;
+	bVCModSitIdleHeld = false;
+	fprintf(stderr, "VCMOD street idle: sitting down\n");
+}
+
+static void
+VCModStreetSitUp(CPlayerPed *player)
+{
+	if (player->m_nWaitState == WAITSTATE_SIT_DOWN || player->m_nWaitState == WAITSTATE_SIT_IDLE)
+		player->SetWaitState(WAITSTATE_SIT_UP, nil);
+	if (player->m_nWaitState == WAITSTATE_SIT_UP) {
+		bVCModSitStanding = true;
+		return;
+	}
+	// the wait state is already gone (or refused); nothing to play, so let go
+	bVCModSitting = false;
+	bVCModSitStanding = false;
+	bVCModSitIdleHeld = false;
+	fprintf(stderr, "VCMOD street idle: seat released\n");
+}
+
+// C on the pavement is also the crouch key, so a refusal has to name itself in
+// the log and on the help line; otherwise "the press only crouched" is all the
+// player can see
+static void
+VCModStreetSitRefused(const char *why, const char *notice)
+{
+	static const char *lastWhy;
+	static uint32 lastAt;
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	if (why != lastWhy || now - lastAt > 5000) {
+		lastWhy = why;
+		lastAt = now;
+		fprintf(stderr, "VCMOD sit: %s\n", why);
+		if (notice)
+			VCModRideNotice(notice);
+	}
+}
+
+static void
+VCModUpdateSitting(CPlayerPed *player, CPad *pad)
+{
+	if (bVCModSitting) {
+		// anything that takes him out of the idle state (death, a script, a car)
+		// owns him from then on
+		if (player->DyingOrDead() || player->bInVehicle || player->m_nPedState != PED_IDLE) {
+			bVCModSitting = false;
+			bVCModSitStanding = false;
+			bVCModSitIdleHeld = false;
+			return;
+		}
+		if (player->m_nWaitState == WAITSTATE_FALSE) {
+			// seat_up finished, or something cleared the sequence
+			bVCModSitting = false;
+			bVCModSitStanding = false;
+			bVCModSitIdleHeld = false;
+			fprintf(stderr, "VCMOD street idle: stood up\n");
+			return;
+		}
+
+		// the sit-down clip is over and the loop is playing: keep him there
+		// instead of letting the ped's own 25-30 s timer stand him up
+		if (!bVCModSitIdleHeld && player->m_nWaitState == WAITSTATE_SIT_IDLE) {
+			int32 hold = VCMOD_SIT_HOLD;
+			player->SetWaitState(WAITSTATE_SIT_IDLE, &hold);
+			bVCModSitIdleHeld = true;
+		}
+
+		// hold the seat: nothing may slide him off it or turn his body around
+		// while the camera looks elsewhere
+		if ((player->GetPosition() - vecVCModSeatPos).MagnitudeSqr() > 0.0025f)
+			player->SetPosition(vecVCModSeatPos);
+		if (Abs(CGeneral::LimitRadianAngle(player->m_fRotationCur - fVCModSeatHeading)) > 0.01f) {
+			player->m_fRotationCur = fVCModSeatHeading;
+			player->m_fRotationDest = fVCModSeatHeading;
+			player->SetHeading(fVCModSeatHeading);
+		}
+
+		// switching the mod off has to stand him up too, or the lock stays on
+		if (!bVCModSitStanding && (!bVCModStreetIdle
+			|| (!pad->ArePlayerControlsDisabled()
+				&& (pad->DuckJustDown() || pad->JumpJustDown()
+					|| pad->GetPedWalkLeftRight() != 0 || pad->GetPedWalkUpDown() != 0)))) {
+			VCModStreetSitUp(player);
+		}
+		return;
+	}
+
+	if (!bVCModStreetIdle)
+		return;
+	if (pad->ArePlayerControlsDisabled() || !pad->DuckJustDown())
+		return;
+	if (player->DyingOrDead() || player->bInVehicle)
+		return;
+
+	// find the seat first, so a press next to a bench that cannot be used says
+	// why instead of quietly crouching
+	CVector pos;
+	float heading;
+	float nearest;
+	if (!VCModStreetFindSeat(player, &pos, &heading, &nearest)) {
+		// no seat anywhere around is just a normal crouch, no message
+		if (nearest <= sq(VCMOD_SIT_RANGE)) {
+			VCModStreetSeatTakenLog();
+			VCModStreetSitRefused("seat taken", "street idle: someone is sitting there");
+		} else if (nearest <= sq(4.0f))
+			VCModStreetSitRefused("seat too far", "street idle: stand closer to the seat");
+		return;
+	}
+	if (player->m_nPedState != PED_IDLE || player->bIsDucking
+		|| player->bIsInWater || player->bIsInTheAir) {
+		VCModStreetSitRefused("not standing still", nil);
+		return;
+	}
+	VCModStreetSitDown(player, pos, heading);
+}
+
+// the spinning roundhouse the peds throw at arm's length: the same
+// FIGHT_ROUNDHOUSE clip through the fight path, so the spin, reach, height and
+// damage are the ped's own instead of a scripted animation
+static void
+VCModSpinKick(CPlayerPed *player)
+{
+	if (player->DyingOrDead() || player->bInVehicle || bVCModSitting)
+		return;
+	if (player->GetWeapon()->m_eWeaponType != WEAPONTYPE_UNARMED) {
+		static uint32 lastAt;
+		uint32 now = CTimer::GetTimeInMilliseconds();
+		if (lastAt == 0 || now - lastAt > 5000) {
+			lastAt = now;
+			fprintf(stderr, "VCMOD spin kick: fists only\n");
+			VCModRideNotice("spin kick: select fists");
+		}
+		return;
+	}
+	// the stock melee attack only starts from a near-stop or mid-fight
+	if (player->m_fMoveSpeed >= 1.0f && player->m_nPedState != PED_FIGHT)
+		return;
+	VCModStreetFadePose(player);
+	if (bVCModStreetChat)
+		VCModStreetEndChat(player, VCMOD_STREET_CHAT_ABORT_GAP, "spin kick");
+	player->StartFightAttack(255, FIGHTMOVE_ROUNDHOUSE);
+}
