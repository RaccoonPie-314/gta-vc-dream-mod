+    def test_destination_list(self):
+        labelBuffer = re.findall(r"^static char aVCModZoneLabel\[32\];$", PANEL, re.M)[0]
+        label = braced(PANEL, "static const char *\nVCModZoneLabel(CZone *zone)")
+        count = braced(PANEL, "int32\nVCModRideZoneCount(void)")
+        at = braced(PANEL, "bool\nVCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos)")
+        run_cpp(ENGINE_STUBS + VEHICLE_STUBS + r'''
+struct CZone {
+    char name[8];
+    float minx, miny, minz, maxx, maxy, maxz;
+    wchar translated[24];
+    wchar *GetTranslatedName(void) { return translated; }
+};
+CZone zones[4];
+int32 numZones = 1;
+struct CTheZones {
+    static uint16 GetNumberOfMapZones(void) { return (uint16) numZones; }
+    static CZone *GetMapZone(uint16 i) { return (int32) i < numZones ? &zones[i] : nil; }
+};
+void makeZone(int32 index, const char *name, float minX, float minY, float maxX, float maxY) {
+    std::strcpy(zones[index].name, name);
+    zones[index].minx = minX; zones[index].miny = minY; zones[index].maxx = maxX; zones[index].maxy = maxY;
+    for (int i = 0; name[i] != '\0'; ++i) zones[index].translated[i] = (wchar) name[i];
+    zones[index].translated[std::strlen(name)] = 0;
+}
+''' + labelBuffer + "\n" + label + "\n" + count + "\n" + at + CHECK_HELPER + r'''
+int main() {
+    check(VCModRideZoneCount() == 1, "only the whole-map box means cruise alone");
+    const char *name;
+    int32 zoneIndex;
+    check(VCModRideZoneAt(0, &zoneIndex, &name, nil) && zoneIndex == -1,
+          "entry 0 is cruise and stores no zone");
+    check(std::strcmp(name, "traffic (cruise)") == 0, "the cruise entry is labelled");
+    check(!VCModRideZoneAt(1, &zoneIndex, &name, nil), "a zone that is not there is refused");
+    check(!VCModRideZoneAt(-1, &zoneIndex, &name, nil), "cruise below zero is refused");
+
+    makeZone(1, "OceanB", -100.0f, -50.0f, 100.0f, 50.0f);
+    makeZone(2, "ViceP", 300.0f, 400.0f, 500.0f, 600.0f);
+    numZones = 3;
+    check(VCModRideZoneCount() == 3, "cruise plus every zone but the map box");
+    CVector pos;
+    check(VCModRideZoneAt(1, &zoneIndex, &name, &pos) && zoneIndex == 1 &&
+          std::strcmp(name, "OceanB") == 0, "list entry one is the first real zone");
+    check(pos.x == 0.0f && pos.y == 0.0f, "the destination is the zone centre");
+    check(VCModRideZoneAt(2, &zoneIndex, &name, &pos) && zoneIndex == 2 && pos.x == 400.0f && pos.y == 500.0f,
+          "entry two is the second zone with its own centre");
+    check(!VCModRideZoneAt(3, &zoneIndex, &name, &pos), "entry past the last zone is refused");
+
+    /* a gxt name longer than the label buffer must not walk past it */
+    wchar longName[64];
+    for (int i = 0; i < 63; ++i) longName[i] = (wchar) ('a' + i % 26);
+    longName[63] = 0;
+    for (int i = 0; i < 23; ++i) zones[1].translated[i] = longName[i];
+    zones[1].translated[23] = 0;
+    check(VCModRideZoneAt(1, &zoneIndex, &name, nil) && std::strlen(name) < 32,
+          "an over-long zone name is truncated into the label buffer");
+    std::printf("PASS: %d destination list checks\n", checks);
+}
