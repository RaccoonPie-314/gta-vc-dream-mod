+#ifndef VCMODDIAG_H
+#define VCMODDIAG_H
+
+// Temporary probes, kept for future debugging. Off by default; turn them on
+// from the panel's DEBUG page (DIAGNOSTICS) or with `Diagnostics=1` in
+// [VC Mods]. Feature events and error lines stay on regardless.
+extern bool bVCModDiagnostics;
+
+void VCModDiagPrintf(const char *fmt, ...);
+
+#define VCMOD_DIAG(...) do { if (bVCModDiagnostics) VCModDiagPrintf(__VA_ARGS__); } while (0)
+
+#endif
diff --git a/src/extras/vcmoddrivecam.cpp b/src/extras/vcmoddrivecam.cpp
new file mode 100644
index 0000000..450e24d
--- /dev/null
+++ b/src/extras/vcmoddrivecam.cpp
@@ -0,0 +1,197 @@
+#include "common.h"
+
+#include "vcmoddrivecam.h"
+
+#include "Camera.h"
+#include "Entity.h"
+#include "General.h"
+#include "Pad.h"
+#include "Replay.h"
+#include "Timer.h"
+#include "Vehicle.h"
+
+// Idle time before the camera gives up the angle the player left it at, and how
+// long the ease back to behind the car takes. The easing has to be short enough
+// that a stop at a light does not feel like the camera is drifting on its own.
+#define VCMOD_DRIVECAM_IDLE_MS		1500
+#define VCMOD_DRIVECAM_RETURN_MS	600
+
+// Same rates the on-foot mouse camera uses, so the car view turns like the rest
+// of the game. The stick rates are per second at full deflection.
+#define VCMOD_DRIVECAM_MOUSE_YAW	2.5f
+#define VCMOD_DRIVECAM_MOUSE_PITCH	4.0f
+#define VCMOD_DRIVECAM_STICK_YAW	2.2f
+#define VCMOD_DRIVECAM_STICK_PITCH	1.3f
+
+// Straight down is under the road and straight up flips the view over the car.
+#define VCMOD_DRIVECAM_ELEV_MIN		DEGTORAD(-20.0f)
+#define VCMOD_DRIVECAM_ELEV_MAX		DEGTORAD(88.0f)
+
+static CEntity *sTarget;
+static int16 sMode;
+static bool sEngaged;
+static bool sAnchorPending;
+static bool sReturning;
+static uint32 sLastFrame;
+static uint32 sLastInputMs;
+static uint32 sReturnStartMs;
+static float sYaw;              // offset from directly behind the car
+static float sPitch;            // elevation added to the mode's own camera height
+static float sAnchorYaw;
+static float sAnchorPitch;
+static float sReturnYaw;
+static float sReturnPitch;
+
+static float
+WrapAngle(float angle)
+{
+	while(angle >= PI)
+		angle -= TWOPI;
+	while(angle < -PI)
+		angle += TWOPI;
+	return angle;
+}
+
+static void
+Disengage(void)
+{
+	sEngaged = false;
+	sAnchorPending = false;
+	sReturning = false;
+	sYaw = 0.0f;
+	sPitch = 0.0f;
+}
+
+void
+VCModDriveCamTick(CEntity *target, int16 mode)
+{
+	uint32 frame = CTimer::GetFrameCounter();
+	if(frame == sLastFrame)
+		return;
+	sLastFrame = frame;
+
+	bool inVehicle = (mode == CCam::MODE_CAM_ON_A_STRING || mode == CCam::MODE_BEHINDBOAT) &&
+	                 target != nil && target->IsVehicle();
+	if(!inVehicle || target != sTarget || mode != sMode){
+		Disengage();
+		sTarget = target;
+		sMode = mode;
+		if(!inVehicle)
+			return;
+	}
+
+	CPad *pad = CPad::GetPad(0);
+	if(pad == nil)
+		return;
+
+	// the look keys are the stock camera's own controls; they take over whole
+	if(pad->GetLookBehindForCar() || pad->GetLookLeft() || pad->GetLookRight()){
+		Disengage();
+		return;
+	}
+	if(TheCamera.WhoIsInControlOfTheCamera != CAMCONTROL_GAME ||
+	   TheCamera.m_uiTransitionState != 0 ||
+	   CReplay::IsPlayingBack() ||
+	   pad->ArePlayerControlsDisabled())
+		return;
+
+	float yawIn = 0.0f;
+	float pitchIn = 0.0f;
+
+	// the mouse is free only when it is not steering, same rule the SA car cam uses
+	if(CCamera::m_bUseMouse3rdPerson && CVehicle::m_bDisableMouseSteering){
+		yawIn   -= VCMOD_DRIVECAM_MOUSE_YAW * pad->GetMouseX() * TheCamera.m_fMouseAccelHorzntl;
+		// inverted on purpose: pushing up looks down over the car, the way this
+		// camera is wanted. The stock invert setting still flips it on top.
+		pitchIn -= VCMOD_DRIVECAM_MOUSE_PITCH * pad->GetMouseY() * TheCamera.m_fMouseAccelVertical;
+	}
+
+	if(CPad::IsAffectedByController){
+		float dt = CTimer::GetTimeStep();
+		float stickX = -pad->GetCarGunLeftRight() / 128.0f;
+		float stickY = pad->GetCarGunUpDown() / 128.0f;
+		if(CPad::bInvertLook4Pad)
+			stickY = -stickY;
+		yawIn   += VCMOD_DRIVECAM_STICK_YAW * stickX * dt;
+		pitchIn += VCMOD_DRIVECAM_STICK_PITCH * stickY * dt;
+	}
+
+	uint32 now = CTimer::GetTimeInMilliseconds();
+
+	if(yawIn != 0.0f || pitchIn != 0.0f){
+		if(!sEngaged){
+			sEngaged = true;
+			sAnchorPending = true;
+			sAnchorYaw = 0.0f;
+			sAnchorPitch = 0.0f;
+		}
+		// the first frame has no camera position to anchor against yet, so the
+		// input is kept and folded in once Orbit sees the stock angle
+		if(sAnchorPending){
+			sAnchorYaw += yawIn;
+			sAnchorPitch += pitchIn;
+		}else{
+			sYaw = WrapAngle(sYaw + yawIn);
+			sPitch = Clamp(sPitch + pitchIn, VCMOD_DRIVECAM_ELEV_MIN, VCMOD_DRIVECAM_ELEV_MAX);
+		}
+		sReturning = false;
+		sLastInputMs = now;
+		return;
+	}
+
+	if(!sEngaged)
+		return;
+
+	if(!sReturning && (int32)(now - sLastInputMs) > VCMOD_DRIVECAM_IDLE_MS){
+		sReturning = true;
+		sReturnStartMs = now;
+		sReturnYaw = sYaw;
+		sReturnPitch = sPitch;
+	}
+
+	if(sReturning){
+		float t = (float)(now - sReturnStartMs) / VCMOD_DRIVECAM_RETURN_MS;
+		if(t >= 1.0f){
+			Disengage();
+		}else{
+			float ease = t*t*(3.0f - 2.0f*t);
+			sYaw = sReturnYaw * (1.0f - ease);
+			sPitch = sReturnPitch * (1.0f - ease);
+		}
+	}
+}
+
+bool
+VCModDriveCamBusy(void)
+{
+	return sEngaged;
+}
+
+bool
+VCModDriveCamOrbit(CVector &source, const CVector &target, float carHeading, float radius)
+{
+	if(!sEngaged)
+		return false;
+
+	if(sAnchorPending){
+		sAnchorPending = false;
+		if(radius > 0.1f){
+			float stockBeta = CGeneral::GetATanOfXY(target.x - source.x, target.y - source.y);
+			sYaw = WrapAngle(stockBeta - carHeading + sAnchorYaw);
+			sPitch = Clamp(sAnchorPitch, VCMOD_DRIVECAM_ELEV_MIN, VCMOD_DRIVECAM_ELEV_MAX);
+		}
+	}
+
+	float beta = carHeading + sYaw;
+	source.x = target.x - Cos(beta) * radius;
+	source.y = target.y - Sin(beta) * radius;
+	return true;
+}
+
+float
+VCModDriveCamElevation(float stock)
+{
+	if(!sEngaged)
+		return stock;
+	return Clamp(stock + sPitch, VCMOD_DRIVECAM_ELEV_MIN, VCMOD_DRIVECAM_ELEV_MAX);
+}
