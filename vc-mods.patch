@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Loose mod files: models and texture dictionaries open through RwStreamOpen,
+so that path has to consult the mods folder before falling back to the game."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+FAKE = ROOT / "src/fakerw/fake.cpp"
+FILEMGR = ROOT / "src/core/FileMgr.cpp"
+
+
+def filename_case(source):
+    start = source.index("case rwSTREAMFILENAME:{")
+    end = source.index("case rwSTREAMMEMORY", start)
+    return source[start:end]
+
+
+class ModFileTests(unittest.TestCase):
+    def test_stream_reads_mods(self):
+        case = filename_case(FAKE.read_text())
+        self.assertIn(
+            "CFileMgr::FindModFile((const char*)pData, modPath, sizeof(modPath))",
+            case,
+        )
+        self.assertLess(
+            case.index("CFileMgr::FindModFile"),
+            case.index("CFileMgr::ResolveBundledGameFile"),
+        )
+        # writes must never be redirected into the mods folder
+        self.assertEqual(case.count("accessType == rwSTREAMREAD &&"), 2)
+
+    def test_buffer(self):
+        self.assertIn("char modPath[FILEMGR_PATH_SIZE];", FAKE.read_text())
+
+    def test_lookup_skips_own_prefix(self):
+        mgr = FILEMGR.read_text()
+        start = mgr.index("CFileMgr::FindModFile(const char *file")
+        end = mgr.index("\n}\n", start)
+        body = mgr[start:end]
+        # mods.ini order decides, so the list is walked backwards
+        self.assertIn("for(int i = ms_numMods - 1; i >= 0; i--)", body)
+        self.assertIn("StartsWithMods(file)", body)
+
+
+if __name__ == "__main__":
+    unittest.main()
