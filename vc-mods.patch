+};
+CPedPool animPedPoolStore;
+struct CPools { static CPedPool *GetPedPool(void) { return &animPedPoolStore; } };
+static int32 nVCModCrewPedHandle[VCMOD_CREW_SIZE] = { -1, -1, -1 };
