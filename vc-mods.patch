+    def test_the_map_marker_is_a_destination(self):
+        labelBuffer = re.findall(r"^static char aVCModZoneLabel\[32\];$", PANEL, re.M)[0]
+        label = braced(PANEL, "static const char *\nVCModZoneLabel(CZone *zone)")
+        count = braced(PANEL, "int32\nVCModRideZoneCount(void)")
+        value = braced(PANEL, "int32\nVCModRideZoneValue(int32 position)")
+        entry = braced(PANEL, "int32\nVCModRideZoneEntry(int32 stored)")
+        moved = braced(PANEL, "bool\nVCModRideZoneMoved(const CVector &applied)")
+        rowtext = braced(PANEL, "const char *\nVCModRideZoneRowText(void)")
+        at = braced(PANEL, "bool\nVCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos)")
+        run_cpp(ENGINE_STUBS + VEHICLE_STUBS + r'''
+struct CZone {
+    char name[8];
+    float minx, miny, minz, maxx, maxy, maxz;
+    wchar translated[24];
+    wchar *GetTranslatedName(void) { return translated; }
+};
+CZone zones[4];
+int32 numZones = 1;
+struct CTheZones {
+    static uint16 GetNumberOfMapZones(void) { return (uint16) numZones; }
+    static CZone *GetMapZone(uint16 i) { return (int32) i < numZones ? &zones[i] : nil; }
+};
+/* the pause-map waypoint, the same two fields CRadar exposes */
+struct CRadar {
+    static int TargetMarkerId;
+    static CVector TargetMarkerPos;
+};
+int CRadar::TargetMarkerId = -1;
+CVector CRadar::TargetMarkerPos;
+/* the setting the row text and the moved test read */
+int32 nVCModRideZone = -1;
+#define VCMOD_RIDE_ZONE_AUTO	(-1)
+#define VCMOD_RIDE_RETARGET_NEAR	25.0f
+void makeZone(int32 index, const char *name, float minX, float minY, float maxX, float maxY) {
+    std::strcpy(zones[index].name, name);
+    zones[index].minx = minX; zones[index].miny = minY; zones[index].maxx = maxX; zones[index].maxy = maxY;
+    for (int i = 0; name[i] != '\0'; ++i) zones[index].translated[i] = (wchar) name[i];
+    zones[index].translated[std::strlen(name)] = 0;
+}
+''' + labelBuffer + "\n" + label + "\n" + count + "\n" + value + "\n" + entry + "\n" +
+            moved + "\n" + at + "\n" + rowtext + CHECK_HELPER + r'''
+int main() {
+    const char *name = "?";
+    int32 zoneIndex = -99;
+    CVector pos;
+
+    makeZone(1, "OceanB", -100.0f, -50.0f, 100.0f, 50.0f);
+    numZones = 2;
+    check(VCModRideZoneCount() == 4, "auto, cruise, the zone, and the marker entry");
+
+    /* the list is one longer and only its first slot is new, so a RideZone an
+       older build saved still selects the same place */
+    check(VCModRideZoneValue(0) == VCMOD_RIDE_ZONE_AUTO, "the first position is auto");
+    check(VCModRideZoneValue(1) == 0, "cruise keeps its own entry");
+    check(VCModRideZoneValue(2) == 1, "the first zone keeps its entry");
+    check(VCModRideZoneValue(3) == 2, "the marker keeps the last entry");
+
+    /* auto follows the marker: traffic while none is placed, the marker with one */
+    CRadar::TargetMarkerId = -1;
+    nVCModRideZone = VCMOD_RIDE_ZONE_AUTO;
+    check(VCModRideZoneEntry(VCMOD_RIDE_ZONE_AUTO) == 0, "auto without a marker means traffic");
+    name = "?";
+    check(VCModRideZoneAt(VCMOD_RIDE_ZONE_AUTO, &zoneIndex, &name, &pos) && zoneIndex == -1,
+          "and auto is a cruise");
+    check(std::strcmp(VCModRideZoneRowText(), "auto: traffic") == 0, "the row says so");
+    check(!VCModRideZoneMoved(CVector(10.0f, 10.0f, 0.0f)), "with no marker nothing has moved");
+
+    CRadar::TargetMarkerId = 7;
+    CRadar::TargetMarkerPos = CVector(123.0f, -456.0f, 0.0f);
+    check(VCModRideZoneEntry(VCMOD_RIDE_ZONE_AUTO) == 2, "auto resolves to the marker entry");
+    name = "?";
+    zoneIndex = -99;
+    check(VCModRideZoneAt(VCMOD_RIDE_ZONE_AUTO, &zoneIndex, &name, &pos), "auto with a marker is a destination");
+    check(zoneIndex == 2, "at the marker's own entry");
+    check(pos.x == 123.0f && pos.y == -456.0f, "which is the marker point");
+    check(std::strcmp(name, "map marker") == 0, "named by what it is");
+    check(std::strcmp(VCModRideZoneRowText(), "auto: map marker") == 0,
+          "and the row names the marker");
+    check(!VCModRideZoneMoved(CVector(123.0f, -456.0f, 0.0f)), "the marker where it was is no move");
+    check(VCModRideZoneMoved(CVector(123.0f, -500.0f, 0.0f)), "a marker dragged away is a move");
+    check(!VCModRideZoneMoved(CVector(133.0f, -456.0f, 0.0f)), "a nudge of the marker is not");
+
+    /* a zone picked by hand is a fixed point, marker or no marker */
+    nVCModRideZone = 1;
+    check(!VCModRideZoneMoved(CVector(0.0f, 0.0f, 0.0f)), "a named zone never follows the marker");
+    check(std::strcmp(VCModRideZoneRowText(), "OceanB") == 0, "the row names the zone");
