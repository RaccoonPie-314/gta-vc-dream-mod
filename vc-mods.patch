+    RunFrames(stopped, 0.2f);
+    idle = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_IDLE);
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(idle != nil && idle->blendDelta > 0.0f, "stopping mid-start blends the idle back in");
+    check(walk == nil || walk->blendDelta < 0.0f, "stopping mid-start fades the movement clip out");
+
+    // with walk mode on, every group fades the start, Tommy's own included
+    ClearLive();
+    bVCModWalkMode = true;
+    CPlayerPed tommy = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    tommy.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) == nil,
+          "walk mode does not play a start clip");
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->blendAmount < 0.5f && walk->blendDelta > 0.0f,
+          "walk mode fades into the walk clip");
+    bVCModWalkMode = false;
+
+    // an npc group carries no start clip; borrowing Tommy's was the jank
+    ClearLive();
+    CPlayerPed npcSkin = MakePed(ASSOCGRP_MAN, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    npcSkin.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) == nil,
+          "npc groups do not borrow Tommy's start clip");
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->blendAmount < 0.5f && walk->blendDelta > 0.0f,
+          "npc groups fade into the walk clip");
+
+    // a sprint start still takes the step the start clip gives
+    ClearLive();
+    CPlayerPed sprintSkin = MakePed(ASSOCGRP_MAN, 0.4f);
+    sprintSkin.m_nMoveState = PEDMOVE_SPRINT;
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    sprintSkin.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) != nil,
+          "sprint starts keep the start clip step");
+
+    // groups that do have a start clip keep the native cut into it
+    ClearLive();
+    CPlayerPed normal = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    normal.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) != nil,
+          "full groups still play the walking start clip");
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_IDLE) == nil,
+          "full groups drop the idle when the start clip takes over");
+
+    // dropping from run to walk in one frame crossfades instead of swapping weights
+    ClearLive();
+    CPlayerPed crossing = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    CAnimBlendAssociation *walkSlot = NewLive(ANIM_STD_WALK, 0.0f);
+    CAnimBlendAssociation *runSlot = NewLive(ANIM_STD_RUN, 1.0f);
+    crossing.SetRealMoveAnim();
+    check(walkSlot->blendDelta > 0.0f && runSlot->blendDelta < 0.0f,
+          "walk/run boundary crossfades instead of cutting");
+    check(walkSlot->blendAmount < 1.0f, "incoming walk clip does not jump to full weight");
+
+    // a worn ped body takes the ped engine's pace roll: the clips' root motion
+    // is what walks the ped, so the rate is the ground speed
+    ClearLive();
+    CPlayerPed npcBody = MakePed(ASSOCGRP_MAN, 0.9f);
+    npcBody.modelIndex = 1;
+    npcBody.m_randomSeed = 0;
+    npcBody.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    CAnimBlendAssociation *run = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_RUN);
+    check(walk != nil && walk->speed > 1.19f && walk->speed < 1.21f,
+          "a ped body walks at the fastest ped roll");
+    check(run != nil && run->speed > 1.19f && run->speed < 1.21f,
+          "run takes the same roll as walk");
+
+    ClearLive();
+    CPlayerPed slowBody = MakePed(ASSOCGRP_MAN, 1.5f);
+    slowBody.modelIndex = 1;
+    slowBody.m_randomSeed = MYRAND_MAX;
+    slowBody.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->speed > 0.79f && walk->speed < 0.81f,
+          "the slow end of the roll walks at the slowest ped pace");
+
+    // the fixed camera keeps its sprint rate, which is its own look
+    ClearLive();
+    CPlayerPed fixedCam = MakePed(ASSOCGRP_MAN, 2.5f);
+    fixedCam.modelIndex = 1;
+    fixedCam.m_nMoveState = PEDMOVE_SPRINT;
+    CAnimBlendAssociation *sprint = NewLive(ANIM_STD_RUNFAST, 1.0f);
+    TheCamera.ActiveCam = 0;
+    TheCamera.Cams[0].Mode = CCam::MODE_FIXED;
+    fixedCam.SetRealMoveAnim();
+    check(sprint->speed == 0.7f, "the fixed camera keeps its sprint rate");
+    TheCamera.Cams[0].Mode = 0;
+
+    // Tommy keeps the authored 1.0 unless an NPC anim set was picked
+    ClearLive();
+    CPlayerPed plainTommy = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    plainTommy.m_randomSeed = 0;
+    plainTommy.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->speed == 1.0f, "Tommy's own body keeps the authored tempo");
+
+    ClearLive();
+    bVCModPlayerNpcAnims = true;
+    CPlayerPed tommyWithNpcAnims = MakePed(ASSOCGRP_MAN, 0.9f);
+    tommyWithNpcAnims.m_randomSeed = 0;
+    tommyWithNpcAnims.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->speed > 1.19f && walk->speed < 1.21f,
+          "a chosen NPC anim set takes the ped roll");
+    bVCModPlayerNpcAnims = false;
+
+    std::printf("ok %d checks\n", checks);
+    return 0;
+}
