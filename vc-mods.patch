+	{ "igphil", "Phil Cassidy" },
+	{ "igmerc", "Mercedes Cortez" },
+	{ "igdick", "Dick (Love Fist)" },
+	{ "igdiaz", "Ricardo Diaz" },
+
+	// the one civilian whose name does not fit the five-letter pattern
+	{ "male01", "Common street guy" },
+};
+
+// the two letters the IDE puts after race, sex and age
+static const struct {
+	const char *code;
+	const char *style;
+} aVCModPedStyles[] = {
+	{ "st", "street" },
+	{ "ri", "rich" },
+	{ "be", "beach" },
+	{ "bu", "business" },
+	{ "md", "maid" },
+	{ "cg", "cigar seller" },
+	{ "pr", "prostitute" },
+	{ "tr", "tramp" },
+	{ "ap", "airport worker" },
+	{ "ca", "cab driver" },
+	{ "dk", "dock worker" },
+	{ "cr", "criminal" },
+	{ "pi", "pimp" },
+	{ "bb", "tracksuit" },
+	{ "cw", "construction" },
+	{ "go", "golfer" },
+	{ "lg", "lifeguard" },
+	{ "jg", "jogger" },
+	{ "sk", "skater" },
+	{ "sh", "shopper" },
+	{ "to", "tourist" },
+};
+
+static char aVCModPedLabel[32];
+
+static const char *
+VCModPedDisplayName(const char *modelName)
+{
+	uint32 i;
+
+	if (modelName == nil || modelName[0] == '\0')
+		return "unknown";
+
+	for (i = 0; i < ARRAY_SIZE(aVCModPedNames); i++)
+		if (!CGeneral::faststricmp(modelName, aVCModPedNames[i].model))
+			return aVCModPedNames[i].label;
+
+	// hfyst is race + sex + age + clothing: Hispanic, female, young, street.
+	if (strlen(modelName) == 5) {
+		char race = tolower((unsigned char) modelName[0]);
+		char sex = tolower((unsigned char) modelName[1]);
+		char age = tolower((unsigned char) modelName[2]);
+		char code0 = tolower((unsigned char) modelName[3]);
+		char code1 = tolower((unsigned char) modelName[4]);
+		const char *raceName = nil;
+		const char *person = nil;
+
+		switch (race) {
+		case 'h': raceName = "Hispanic"; break;
+		case 'b': raceName = "Black"; break;
+		case 'w': raceName = "White"; break;
+		case 'j': raceName = "Japanese"; break;
+		}
+		if (sex == 'm')
+			person = age == 'y' ? "guy" : age == 'o' ? "man" : nil;
+		else if (sex == 'f')
+			person = age == 'y' ? "girl" : age == 'o' ? "woman" : nil;
+
+		if (raceName != nil && person != nil) {
+			for (i = 0; i < ARRAY_SIZE(aVCModPedStyles); i++) {
+				if (code0 == aVCModPedStyles[i].code[0] &&
+				    code1 == aVCModPedStyles[i].code[1]) {
+					snprintf(aVCModPedLabel, sizeof(aVCModPedLabel),
+						"%s %s, %s", raceName, person, aVCModPedStyles[i].style);
+					return aVCModPedLabel;
+				}
+			}
+			snprintf(aVCModPedLabel, sizeof(aVCModPedLabel), "%s %s", raceName, person);
+			return aVCModPedLabel;
+		}
+	}
+
+	// a modded IDE gets its own name back rather than an empty row
+	snprintf(aVCModPedLabel, sizeof(aVCModPedLabel), "%.28s", modelName);
+	return aVCModPedLabel;
+}
+
+const char *
+VCModCurrentPedLabel(void)
+{
+	int16 modelIndex = VCModCurrentPedModel();
+	if (modelIndex == MI_PLAYER)
+		return "Tommy Vercetti";
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil)
+		return "unknown";
+	return VCModPedDisplayName(mi->GetModelName());
+}
+
+const char *
+VCModCrewCell(void)
+{
+	switch (VCModCrewPhase()) {
+	case VCMOD_CREW_APPROACH:	return "[EN ROUTE]  V dismiss";
+	case VCMOD_CREW_PICKUP:		return "[WAITING]   V dismiss";
+	case VCMOD_CREW_SWAP:		return "[HANDOVER]";
+	case VCMOD_CREW_ABOARD:		return "[ABOARD]    V dismiss";
+	case VCMOD_CREW_ESCORT:		return "[ON FOOT]   V dismiss";
+	case VCMOD_CREW_DISMISS_WAIT:	return "[LEAVING]";
+	}
+	return "[CALL]      V";
+}
+
+const char *
+VCModDriverCell(void)
+{
+	switch (VCModRidePhase()) {
+	case VCMOD_RIDE_APPROACH:	return "[EN ROUTE]  H dismiss";
+	case VCMOD_RIDE_PICKUP:		return "[WAITING]   H dismiss";
+	case VCMOD_RIDE_BOARDING:	return "[BOARDING]";
+	case VCMOD_RIDE_DRIVING:	return "[DRIVING]   H dismiss";
+	}
+	return "[CALL]      H";
+}
+
+const char *
+VCModListLabel(int32 list, int32 entry, bool *selected)
+{
+	static char missing[24];
+
+	switch (list) {
+	case VCMOD_LIST_ANIM:
+		*selected = entry == nVCModAnimChoice;
+		return VCModAnimSetName(entry);
+	case VCMOD_LIST_PEDCAT:
+		*selected = entry == nVCModPedCategory;
+		return aVCModPedCategoryNames[entry];
+
+	case VCMOD_LIST_RIDESTYLE:
+		*selected = entry == nVCModRideStyle;
+		return aVCModRideStyleNames[entry];
+
+	case VCMOD_LIST_CREWCAR: {
+		int16 model;
+		const char *name;
+		if (!VCModCrewCarAt(entry, &model, &name))
+			return "unknown";
+		*selected = model == nVCModCrewCar;
+		return name;
+	}
+
+	case VCMOD_LIST_SPAWN:
+		*selected = false;
+		return VCModSpawnName(entry);
+
+	case VCMOD_LIST_RIDEZONE: {
+		// the stored value is the entry the position maps to; auto says what it is
+		// rather than what it currently resolves to, or the list row would move
+		// under the pointer whenever the marker is placed
+		int32 value = VCModRideZoneValue(entry);
+		const char *name = "auto (marker / cruise)";
+		if (value != VCMOD_RIDE_ZONE_AUTO)
+			VCModRideZoneAt(value, nil, &name, nil);
+		*selected = value == nVCModRideZone;
+		return name;
+	}
+	}
+
+	int16 modelIndex = MI_PLAYER;
+	const char *name = nil;
+	if (!VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name) || name == nil) {
+		snprintf(missing, sizeof(missing), "model %d", (int) entry);
+		*selected = false;
+		return missing;
+	}
+	*selected = modelIndex == VCModCurrentPedModel();
+	return VCModPedDisplayName(name);
+}
+
+void
+VCModListPick(int32 list, int32 entry)
+{
+	switch (list) {
+	case VCMOD_LIST_ANIM:
+		nVCModAnimChoice = entry;
+		bVCModPlayerNpcAnims = true;
+		VCModRollPlayerPace();
+		break;
+
+	case VCMOD_LIST_PEDCAT:
+		nVCModPedCategory = entry;
+		nVCModListScroll = 0;
+		break;
+
+	case VCMOD_LIST_RIDESTYLE:
+		nVCModRideStyle = entry;
+		break;
+
+	case VCMOD_LIST_CREWCAR: {
+		int16 model;
+		if (VCModCrewCarAt(entry, &model, nil))
+			nVCModCrewCar = model;
+		break;
+	}
+
+	case VCMOD_LIST_SPAWN:
+		// streaming and clump creation wait for the update pass
+		VCModSpawnPick(entry);
+		break;
+
+	case VCMOD_LIST_RIDEZONE:
+		if (entry >= 0 && entry < VCModRideZoneCount())
+			nVCModRideZone = VCModRideZoneValue(entry);
+		break;
+
+	default: {
+		// the swap streams models and destroys clumps, so it waits for the update
+		// pass rather than running inside the render
+		int16 modelIndex;
+		const char *name;
+		if (VCModPedModelAt(nVCModPedCategory, entry, &modelIndex, &name))
+			nVCModPedModel = modelIndex;
+		break;
+	}
+	}
+	nVCModOpenList = VCMOD_LIST_NONE;
+}
+#endif
diff --git a/src/extras/vcmodpanelinternal.h b/src/extras/vcmodpanelinternal.h
new file mode 100644
index 0000000..f9a12bc
--- /dev/null
+++ b/src/extras/vcmodpanelinternal.h
@@ -0,0 +1,113 @@
+#ifndef VCMODPANELINTERNAL_H
+#define VCMODPANELINTERNAL_H
+
+#include "common.h"
+#include "vcmodpanel.h"
+
+// The panel's private interface. The row table, the catalog lookups and the
+// drawing loop share these types and the state each of them writes, so they are
+// declared here once and defined in the one source that owns them.
+
+// The row table is the panel's whole content: a page for each kind of switch, and
+// the ini key that makes a row remembered. A key that exists in [VC Mods] means
+// pinned, so the file carries its own pin list and a hand edit still works.
+enum eVCModPage
+{
+	VCMOD_PAGE_COMBAT,
+	VCMOD_PAGE_PLAYER,
+	VCMOD_PAGE_DRIVING,
+	VCMOD_PAGE_WORLD,
+	VCMOD_PAGE_KEYS,
+	VCMOD_PAGE_DEBUG,
+	NUM_VCMOD_PAGES
+};
+
+enum eVCModRowKind
+{
+	VCMOD_ROW_FLAG,		// flips the flag it points at
+	VCMOD_ROW_CYCLE,	// steps through a fixed set of states
+	VCMOD_ROW_ANIMSET,	// opens the animation list
+	VCMOD_ROW_PEDCAT,	// opens the category list
+	VCMOD_ROW_PEDCHAR,	// opens that category's roster
+	VCMOD_ROW_RIDEZONE,	// opens the ride destination list
+	VCMOD_ROW_RIDESTYLE,	// opens the driving style list
+	VCMOD_ROW_SKIPRIDE,	// travels to the RIDE TO destination now
+	VCMOD_ROW_CALLDRIVER,	// calls the chauffeur, or dismisses him
+	VCMOD_ROW_CALLCREW,	// calls the crew, or dismisses it
+	VCMOD_ROW_CREWCAR,	// opens the four-door shelf the crew arrives in
+	VCMOD_ROW_KEY,		// arms a hotkey capture; the next press becomes it
+	VCMOD_ROW_KEYRESET,	// restores every hotkey to its default
+	VCMOD_ROW_PATHPROBE_NODE,	// read-only: where the nearest traffic car is
+	VCMOD_ROW_PATHPROBE_LANE,	// read-only: what its path node is doing to it
+	VCMOD_ROW_SPAWN		// opens the car model list; picking one spawns it
+};
+
+// A row that steps through states instead of flipping: the old layout needed one
+// row for a switch and another for its mode, which is two clicks and two states
+// to reconcile. get/set work on the live value, so the panel, the debug menu and
+// the ini all read the same thing.
+struct VCModCycleDef
+{
+	int32 (*get)(void);
+	void (*set)(int32 value);
+	int32 count;
+	const char *const *labels;	// count of them, the current one is the cell
+	bool selector;	// true: every state is a live choice, so none renders as the greyed 0=off
+};
+
+struct VCModRowDef
+{
+	const char *name;
+	eVCModRowKind kind;
+	bool *state;
+	const char *iniKey;	// nil when the row has nothing to remember
+	eVCModPage page;
+	const VCModCycleDef *cycle;	// CYCLE rows only
+	int32 key;	// KEY rows only: the eVCModKey slot
+	const char *info;	// one plain-language line, shown for the hovered row
+	const char *warn;	// optional: what can surprise the player
+};
+
+// one list is open at a time, and any list longer than the window scrolls
+enum eVCModList
+{
+	VCMOD_LIST_NONE,
+	VCMOD_LIST_ANIM,
+	VCMOD_LIST_PEDCAT,
+	VCMOD_LIST_PEDCHAR,
+	VCMOD_LIST_RIDEZONE,
+	VCMOD_LIST_RIDESTYLE,
+	VCMOD_LIST_CREWCAR,
+	VCMOD_LIST_SPAWN,
+	NUM_VCMOD_LISTS
+};
+
+// the drawing state the catalog writes back when a list is picked
+extern int32 nVCModOpenList;
+extern int32 nVCModListScroll;
+
+// vcmodpanelregistry.cpp
+extern const VCModRowDef aVCModRows[];
+extern const char *aVCModPageNames[NUM_VCMOD_PAGES];
+int32 VCModRowCount(void);
+int32 VCModPageRowCount(int32 page);
+int32 VCModPageRow(int32 page, int32 entry);
+int32 VCModMaxPageRows(void);
+bool VCModRowPinned(const VCModRowDef *row);
+void VCModSavePins(void);
+void VCModTogglePin(const VCModRowDef *row);
+void VCModToggleAll(void);
+int32 VCModCountOn(void);
+int32 VCModSwitchedCount(void);
+
+// vcmodpanelcatalog.cpp
+extern const char *aVCModRideStyleNames[];
+extern const char *aVCModPedCategoryNames[];
+int32 VCModListCount(int32 list);
+const char *VCModListLabel(int32 list, int32 entry, bool *selected);
+void VCModListPick(int32 list, int32 entry);
+const char *VCModCurrentPedLabel(void);
+const char *VCModCrewCell(void);
+const char *VCModDriverCell(void);
+
+#endif
