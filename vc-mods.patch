+#!/usr/bin/env python3
+"""Behavior checks for the civilian AI routines extracted from CCivilianPed onto
+CPed (NPC mode full 1:1). The extraction is a verbatim move / mechanical field
+rename; these checks pin the moved routines' behavior on representative inputs.
+"""
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+PED = (ROOT / "src/peds/Ped.cpp").read_text()
+HEAD = (ROOT / "src/peds/Ped.h").read_text()
+
+STRUCT = braced(HEAD, "struct SCivilianAIState") + ";"
+
+STUBS = r'''
+#include <cstdio>
+#include <cstdint>
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+typedef int8_t int8;
+typedef int32_t int32;
+typedef uint32_t uint32;
+enum { ATTRACTOR_ATM = 0, ATTRACTOR_SEAT, ATTRACTOR_STOP, ATTRACTOR_PIZZA,
+       ATTRACTOR_SHELTER, ATTRACTOR_ICECREAM };
+struct CWeather { static float Rain; };
+float CWeather::Rain = 0.0f;
+'''
+
+CPED = ("\nstruct CPed { bool IsAttractedTo(int8 type); "
+        "bool IsOnStealWishList(SCivilianAIState& state, int32 model); };\n")
+
+IS_ATTRACTED = "bool CPed::IsAttractedTo(int8 type)"
+WISHLIST_SIG = "bool\nCPed::IsOnStealWishList(SCivilianAIState& state, int32 model)"
+
+
+def base():
+    return STUBS + "\n" + STRUCT + CPED
+
+
+class IsAttractedToTests(unittest.TestCase):
+    def source(self):
+        return base() + braced(PED, IS_ATTRACTED) + "\n"
+
+    def test_atm_seat_stop_pizza_always(self):
+        run_cpp(self.source() + r'''
+int main(void) {
+    CPed p;
+    if (!p.IsAttractedTo(ATTRACTOR_ATM)) return 1;
+    if (!p.IsAttractedTo(ATTRACTOR_SEAT)) return 2;
+    if (!p.IsAttractedTo(ATTRACTOR_STOP)) return 3;
+    if (!p.IsAttractedTo(ATTRACTOR_PIZZA)) return 4;
+    return 0;
+}
+''')
+
+    def test_shelter_only_in_rain(self):
+        run_cpp(self.source() + r'''
+int main(void) {
+    CPed p;
+    CWeather::Rain = 0.0f;
+    if (p.IsAttractedTo(ATTRACTOR_SHELTER)) return 1;
+    CWeather::Rain = 0.3f;
+    if (!p.IsAttractedTo(ATTRACTOR_SHELTER)) return 2;
+    return 0;
+}
+''')
+
+    def test_icecream_and_unknown_never(self):
+        run_cpp(self.source() + r'''
+int main(void) {
+    CPed p;
+    CWeather::Rain = 0.5f;
+    if (p.IsAttractedTo(ATTRACTOR_ICECREAM)) return 1;
+    if (p.IsAttractedTo(99)) return 2;
+    return 0;
+}
+''')
+
+
+class IsOnStealWishListTests(unittest.TestCase):
+    def source(self):
+        return base() + braced(PED, WISHLIST_SIG) + "\n"
+
+    def test_matches_a_wishlist_model(self):
