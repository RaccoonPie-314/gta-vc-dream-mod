+def ride_functions(*names):
+    """Pull the named production functions out of PlayerPed.cpp in caller order."""
+    signatures = {
+        "notice": "static void\nVCModRideNotice(const char *text)",
+        "phase": "int32\nVCModRidePhase(void)",
+        "release": "static void\nVCModRideReleaseToTraffic(CVehicle *veh)",
+        "handback": "static void\nVCModRideHandBack(CVehicle *veh)",
+        "standdown": "static void\nVCModRideStandDown(void)",
+        "vehicle": "static CVehicle *\nVCModRideVehicle(void)",
+        "seatfree": "static bool\nVCModPassengerSeatFree(CVehicle *veh)",
+        "style": "static void\nVCModRideApplyStyle(CVehicle *veh, bool goingSomewhere)",
+        "drive": "static void\nVCModRideDrive(CVehicle *veh)",
+        "skip": "static bool\nVCModRideSkipTravel(void)",
+        "spawn": "static bool\nVCModRideSpawnLimo(CPlayerPed *player)",
+        "call": "void\nVCModCallDriver(void)",
+        "pickup": "static void\nVCModUpdatePickup(CPlayerPed *player, CVehicle *veh)",
+        "entry": "bool\nVCModPassengerEntry(CVehicle *vehicle)",
+        "update": "static void\nVCModUpdateRide(CPlayerPed *player)",
+        "skipride": "void\nVCModSkipRide(void)",
+    }
+    return "\n".join(braced(PLAYER, signatures[name]) for name in names) + "\n"
+
+
+def ride_source(*functions):
+    return (ENGINE_STUBS + VEHICLE_STUBS + ride_enums() + RIDE_STUBS + WORLD_STUBS +
+            WORLD_STUBS_TAIL + RIDE_GLOBALS + ride_statics() +
+            ride_functions(*functions) + ROAD_NODES + CHECK_HELPER + RESET_RIDE)
+
