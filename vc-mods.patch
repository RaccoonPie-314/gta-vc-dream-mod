+++ b/src/extras/vcmodadrenaline.h
@@ -0,0 +1,23 @@
+#ifndef VCMODADRENALINE_H
+#define VCMODADRENALINE_H
+
+class CPlayerPed;
+
+// 0 off, 1 normal, 2 slow-mo; one row cycles it in the panel and one integer in
+// the debug menu, so there is no half-on state to explain
+extern int32 nVCModAdrenalineMode;
+
+// true while the mod owns this player's adrenaline: the native flag is on
+// because the row asked for it, not because of a pill pickup
+bool VCModAdrenalineOwns(CPlayerPed *player);
+
+// per frame while the player is in play: borrows the native flag, the stamina
+// refill and, in slow-mo, the world time scale, and gives the scale back when
+// the mode no longer applies
+void VCModUpdateAdrenaline(CPlayerPed *player);
+
+// the engine is about to discard the player (replay snapshot); give the time
+// scale back before its state is copied
+void VCModSuspendAdrenaline(void);
+
+#endif
