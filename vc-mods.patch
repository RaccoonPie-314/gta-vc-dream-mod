+#!/usr/bin/env python3
+import math
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+PLAYER = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+PED = (ROOT / "src/peds/Ped.cpp").read_text()
+CAM = (ROOT / "src/core/Cam.cpp").read_text()
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+CHARACTER = (ROOT / "src/extras/vcmodcharacter.cpp").read_text()
+PLAYERMOD = (ROOT / "src/extras/vcmodplayer.cpp").read_text()
+INI = (ROOT / "src/core/re3.cpp").read_text()
+
+ENGINE_STUBS = r'''
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+#include <stdint.h>
+#define nil NULL
+typedef int8_t int8;
+typedef uint8_t uint8;
+typedef int16_t int16;
+typedef uint16_t uint16;
+typedef int32_t int32;
+typedef uint32_t uint32;
+#define VCMOD_DIAG(...) do { } while (0)
+bool bVCModDiagnostics = false;
+
+enum AnimationId {
+    ANIM_STD_WALK = 0, ANIM_STD_RUN, ANIM_STD_RUNFAST, ANIM_STD_IDLE, ANIM_STD_STARTWALK,
+    ANIM_STD_RUNSTOP1, ANIM_STD_RUNSTOP2, ANIM_STD_IDLE_TIRED, ANIM_STD_FIGHT_IDLE,
+    ANIM_MELEE_IDLE_FIGHTMODE
+};
+enum AssocGroupId { ASSOCGRP_PLAYER = 0, ASSOCGRP_STD, ASSOCGRP_MAN, ASSOCGRP_SKATE };
+enum eMoveState { PEDMOVE_NONE, PEDMOVE_STILL, PEDMOVE_WALK, PEDMOVE_RUN, PEDMOVE_SPRINT };
+enum PedState { PED_IDLE = 0, PED_FIGHT, PED_ATTACK, PED_DIE };
+enum { ASSOC_RUNNING = 1, ASSOC_DELETEFADEDOUT = 2 };
+enum { MI_PLAYER = 0 };
+enum { WAITSTATE_FALSE, WAITSTATE_STUCK, WAITSTATE_FINISH_FLEE };
+#define MYRAND_MAX 65535
+
+struct CAnimBlendHierarchy { const char *name; CAnimBlendHierarchy() : name("stub") {} };
+
+struct CAnimBlendAssociation {
+    static std::vector<CAnimBlendAssociation *> live;
+    AnimationId animId;
+    uint32 flags;
+    float blendAmount, blendDelta, speed, currentTime;
+    CAnimBlendHierarchy *hierarchy;
+
+    CAnimBlendAssociation()
+        : animId(ANIM_STD_IDLE), flags(ASSOC_RUNNING), blendAmount(1.0f),
+          blendDelta(0.0f), speed(1.0f), currentTime(0.0f), hierarchy(nil) {}
+    ~CAnimBlendAssociation();
+    void Unregister(void) {
+        for (size_t i = 0; i < live.size(); i++)
+            if (live[i] == this) { live.erase(live.begin() + i); return; }
+    }
+    bool IsRunning(void) const { return (flags & ASSOC_RUNNING) != 0; }
+    void SetRun(void) { flags |= ASSOC_RUNNING; }
+    void SetCurrentTime(float time) { currentTime = time; }
+    float GetProgress(void) const { return 0.5f; }
+    void SetDeleteCallback(void (*)(CAnimBlendAssociation *, void *), void *) {}
+};
+std::vector<CAnimBlendAssociation *> CAnimBlendAssociation::live;
+CAnimBlendAssociation::~CAnimBlendAssociation(void) { Unregister(); }
+
+// the group table: only the player groups carry a start clip, like the real
+// aStdAnimDescs sets
+static CAnimBlendAssociation *GroupStart(AssocGroupId group)
+{
+    static CAnimBlendHierarchy hierarchy;
+    static CAnimBlendAssociation start;
+    if (group != ASSOCGRP_PLAYER && group != ASSOCGRP_STD)
+        return nil;
+    start.hierarchy = &hierarchy;
+    return &start;
+}
+
+static CAnimBlendAssociation *NewLive(AnimationId id, float amount)
+{
+    CAnimBlendAssociation *anim = new CAnimBlendAssociation();
+    anim->animId = id;
+    anim->blendAmount = amount;
+    CAnimBlendAssociation::live.push_back(anim);
+    return anim;
+}
+
+CAnimBlendAssociation *RpAnimBlendClumpGetAssociation(void *, AnimationId id)
+{
+    for (size_t i = 0; i < CAnimBlendAssociation::live.size(); i++)
+        if (CAnimBlendAssociation::live[i]->animId == id)
+            return CAnimBlendAssociation::live[i];
+    return nil;
+}
+
+struct CAnimManager {
+    static CAnimBlendAssociation *GetAnimAssociation(AssocGroupId group, AnimationId id) {
+        return id == ANIM_STD_STARTWALK ? GroupStart(group) : nil;
+    }
+    static CAnimBlendAssociation *AddAnimation(void *, AssocGroupId, AnimationId id) {
+        CAnimBlendAssociation *anim = NewLive(id, 1.0f);
+        anim->flags |= ASSOC_RUNNING;
+        return anim;
+    }
+    static CAnimBlendAssociation *BlendAnimation(void *, AssocGroupId, AnimationId id, float delta) {
+        bool isMovement = id <= ANIM_STD_RUNFAST;
+        bool removePrev = false;
+        CAnimBlendAssociation *found = nil;
+        for (size_t i = 0; i < CAnimBlendAssociation::live.size(); i++) {
+            CAnimBlendAssociation *anim = CAnimBlendAssociation::live[i];
+            if (anim->animId == id) { found = anim; continue; }
+            if (anim->blendAmount > 0.0f) {
+                float blendDelta = -delta * anim->blendAmount;
+                if (blendDelta < anim->blendDelta)
+                    anim->blendDelta = blendDelta;
+            } else
+                anim->blendDelta = -1.0f;
+            anim->flags |= ASSOC_DELETEFADEDOUT;
+            removePrev = true;
+        }
+        (void)isMovement;
+        if (found) {
+            found->blendDelta = (1.0f - found->blendAmount) * delta;
+        } else {
+            found = NewLive(id, 0.0f);
+            if (!removePrev)
+                found->blendAmount = 1.0f;
+            else
+                found->blendDelta = delta;
+        }
+        return found;
+    }
+};
+
+struct CTimer {
+    static float scale;
+    static uint32 now;
+    static uint32 GetTimeInMilliseconds(void) { return now; }
+    static void SetTimeScale(float value) { scale = value; }
+};
+float CTimer::scale = 1.0f;
+uint32 CTimer::now = 1000;
+
+struct CGeneral {
+    static int GetRandomNumberInRange(int low, int) { return low; }
+};
+
+struct CWorld {
+    static bool TestSphereAgainstWorld(int, float, void *, bool, bool, bool, bool, bool, bool) {
+        return false;
+    }
+};
+
+struct CCam { enum { MODE_FIXED = 4 }; int Mode; };
+struct CCamera { CCam Cams[8]; int ActiveCam; } TheCamera;
+
+static void RestoreHeadingRateCB(CAnimBlendAssociation *, void *) {}
+
+struct CPlayerPed {
+    bool bResetWalkAnims, bIsAimingGun, m_bAdrenalineActive;
+    uint32 m_nWaitTimer, m_nAdrenalineTime;
+    PedState m_nPedState;
+    eMoveState m_nMoveState;
+    int m_nWaitState;
+    AssocGroupId m_animGroup;
+    float m_fMoveSpeed, m_fCurrentStamina, m_headingRate;
+    uint32 m_randomSeed;
+    int modelIndex;
+    void *GetClump(void) { return this; }
+    int GetPosition(void) { return 0; }
+    int GetModelIndex(void) { return modelIndex; }
+    void SetRealMoveAnim(void);
+    void UseSprintEnergy(void) {}
+    void RestoreHeadingRate(void) {}
+};
+bool VCModAdrenalineOwns(CPlayerPed *) { return false; }
+bool bVCModWalkMode = false;
+bool bVCModPlayerNpcAnims = false;
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def tempo_hook(source):
+    # the one-shot log seed is a file static in the module, outside the hook body
+    seed = next(line for line in source.splitlines()
+                if line.startswith("static uint32 nVCModLoggedSeed"))
+    return seed + "\n" + braced(source, "void\nVCModCharacterMoveTempo(")
+
+
+def walk_mode_predicate(source):
+    # WALK MODE owns the flag now, so the fade condition calls the real predicate
+    return braced(source, "bool\nVCModWalkModeOn(void)") + "\n"
+
+
+HARNESS = r'''
+static int checks;
+static void check(bool condition, const char *name)
+{
+    if (!condition) {
+        std::fprintf(stderr, "FAIL: %s\n", name);
+        std::exit(1);
+    }
+    ++checks;
+}
+
+static void ClearLive(void)
+{
+    while (!CAnimBlendAssociation::live.empty())
+        delete CAnimBlendAssociation::live.back();
+}
+
+static CPlayerPed MakePed(AssocGroupId group, float speed)
+{
+    CPlayerPed ped = {};
+    ped.m_animGroup = group;
+    ped.m_nPedState = PED_IDLE;
+    ped.m_nMoveState = PEDMOVE_STILL;
+    ped.m_fMoveSpeed = speed;
+    ped.m_fCurrentStamina = 100.0f;
+    ped.modelIndex = MI_PLAYER;
+    return ped;
+}
+
+// mirrors CAnimBlendAssociation::UpdateBlend
+static void Advance(float dt)
+{
+    for (size_t i = 0; i < CAnimBlendAssociation::live.size(); ) {
+        CAnimBlendAssociation *anim = CAnimBlendAssociation::live[i];
+        anim->blendAmount += anim->blendDelta * dt;
+        if (anim->blendAmount <= 0.0f && anim->blendDelta < 0.0f) {
+            anim->blendAmount = 0.0f;
+            anim->blendDelta = 0.0f;
+            if (anim->flags & ASSOC_DELETEFADEDOUT) {
+                delete anim;
+                continue;
+            }
+        }
+        if (anim->blendAmount > 1.0f) {
+            anim->blendAmount = 1.0f;
+            anim->blendDelta = 0.0f;
+        }
+        ++i;
+    }
+}
+
+static void RunFrames(CPlayerPed &ped, float seconds)
+{
+    int frames = (int)(seconds * 30.0f + 0.5f);
+    for (int i = 0; i < frames; i++) {
+        ped.SetRealMoveAnim();
+        Advance(1.0f / 30.0f);
+    }
+}
+
+int main()
+{
+    // a skater starting from a standstill: the block has no start clip, so
+    // the movement clip has to fade in over the idle the way CPed::SetMoveAnim
+    // does instead of snapping to full weight
+    ClearLive();
+    CPlayerPed skater = MakePed(ASSOCGRP_SKATE, 0.9f);
+    CAnimBlendAssociation *idle = NewLive(ANIM_STD_IDLE, 1.0f);
+    skater.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) == nil,
+          "skate does not borrow the walking start clip");
+    CAnimBlendAssociation *walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil, "skate start adds the movement clip");
+    check(walk->blendAmount < 0.5f, "skate movement clip starts near zero weight");
+    check(walk->blendDelta > 0.0f, "skate movement clip fades in");
+    check(idle->blendDelta < 0.0f && (idle->flags & ASSOC_DELETEFADEDOUT),
+          "skate idle fades out under the movement clip");
+
+    RunFrames(skater, 0.5f);
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    idle = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_IDLE);
+    check(walk != nil && walk->blendAmount > 0.3f && walk->blendAmount < 0.8f,
+          "skate start is a crossfade, not a cut");
+    check(idle != nil && idle->blendAmount > 0.1f, "skate idle is still blended mid-start");
+
+    RunFrames(skater, 1.0f);
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->blendAmount == 1.0f, "skate movement clip ends at full weight");
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_IDLE) == nil, "skate idle is gone after the fade");
+    check(skater.m_nMoveState == PEDMOVE_WALK, "walk speed keeps the player in the walk state");
+
+    // stopping in the middle of the fade has to bring the idle back
+    ClearLive();
+    CPlayerPed stopped = MakePed(ASSOCGRP_SKATE, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    RunFrames(stopped, 0.3f);
+    stopped.m_fMoveSpeed = 0.0f;
+    RunFrames(stopped, 0.2f);
+    idle = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_IDLE);
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(idle != nil && idle->blendDelta > 0.0f, "stopping mid-start blends the idle back in");
+    check(walk == nil || walk->blendDelta < 0.0f, "stopping mid-start fades the movement clip out");
+
+    // with walk mode on, every group fades the start, Tommy's own included
+    ClearLive();
+    bVCModWalkMode = true;
+    CPlayerPed tommy = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    tommy.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) == nil,
+          "walk mode does not play a start clip");
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->blendAmount < 0.5f && walk->blendDelta > 0.0f,
+          "walk mode fades into the walk clip");
+    bVCModWalkMode = false;
+
+    // an npc group carries no start clip; borrowing Tommy's was the jank
+    ClearLive();
+    CPlayerPed npcSkin = MakePed(ASSOCGRP_MAN, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    npcSkin.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) == nil,
+          "npc groups do not borrow Tommy's start clip");
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->blendAmount < 0.5f && walk->blendDelta > 0.0f,
+          "npc groups fade into the walk clip");
+
+    // a sprint start still takes the step the start clip gives
+    ClearLive();
+    CPlayerPed sprintSkin = MakePed(ASSOCGRP_MAN, 0.4f);
+    sprintSkin.m_nMoveState = PEDMOVE_SPRINT;
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    sprintSkin.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) != nil,
+          "sprint starts keep the start clip step");
+
+    // groups that do have a start clip keep the native cut into it
+    ClearLive();
+    CPlayerPed normal = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    NewLive(ANIM_STD_IDLE, 1.0f);
+    normal.SetRealMoveAnim();
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_STARTWALK) != nil,
+          "full groups still play the walking start clip");
+    check(RpAnimBlendClumpGetAssociation(nil, ANIM_STD_IDLE) == nil,
+          "full groups drop the idle when the start clip takes over");
+
+    // dropping from run to walk in one frame crossfades instead of swapping weights
+    ClearLive();
+    CPlayerPed crossing = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    CAnimBlendAssociation *walkSlot = NewLive(ANIM_STD_WALK, 0.0f);
+    CAnimBlendAssociation *runSlot = NewLive(ANIM_STD_RUN, 1.0f);
+    crossing.SetRealMoveAnim();
+    check(walkSlot->blendDelta > 0.0f && runSlot->blendDelta < 0.0f,
+          "walk/run boundary crossfades instead of cutting");
+    check(walkSlot->blendAmount < 1.0f, "incoming walk clip does not jump to full weight");
+
+    // a worn ped body takes the ped engine's pace roll: the clips' root motion
+    // is what walks the ped, so the rate is the ground speed
+    ClearLive();
+    CPlayerPed npcBody = MakePed(ASSOCGRP_MAN, 0.9f);
+    npcBody.modelIndex = 1;
+    npcBody.m_randomSeed = 0;
+    npcBody.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    CAnimBlendAssociation *run = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_RUN);
+    check(walk != nil && walk->speed > 1.19f && walk->speed < 1.21f,
+          "a ped body walks at the fastest ped roll");
+    check(run != nil && run->speed > 1.19f && run->speed < 1.21f,
+          "run takes the same roll as walk");
+
+    ClearLive();
+    CPlayerPed slowBody = MakePed(ASSOCGRP_MAN, 1.5f);
+    slowBody.modelIndex = 1;
+    slowBody.m_randomSeed = MYRAND_MAX;
+    slowBody.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->speed > 0.79f && walk->speed < 0.81f,
+          "the slow end of the roll walks at the slowest ped pace");
+
+    // the fixed camera keeps its sprint rate, which is its own look
+    ClearLive();
+    CPlayerPed fixedCam = MakePed(ASSOCGRP_MAN, 2.5f);
+    fixedCam.modelIndex = 1;
+    fixedCam.m_nMoveState = PEDMOVE_SPRINT;
+    CAnimBlendAssociation *sprint = NewLive(ANIM_STD_RUNFAST, 1.0f);
+    TheCamera.ActiveCam = 0;
+    TheCamera.Cams[0].Mode = CCam::MODE_FIXED;
+    fixedCam.SetRealMoveAnim();
+    check(sprint->speed == 0.7f, "the fixed camera keeps its sprint rate");
+    TheCamera.Cams[0].Mode = 0;
+
+    // Tommy keeps the authored 1.0 unless an NPC anim set was picked
+    ClearLive();
+    CPlayerPed plainTommy = MakePed(ASSOCGRP_PLAYER, 0.9f);
+    plainTommy.m_randomSeed = 0;
+    plainTommy.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->speed == 1.0f, "Tommy's own body keeps the authored tempo");
+
+    ClearLive();
+    bVCModPlayerNpcAnims = true;
+    CPlayerPed tommyWithNpcAnims = MakePed(ASSOCGRP_MAN, 0.9f);
+    tommyWithNpcAnims.m_randomSeed = 0;
+    tommyWithNpcAnims.SetRealMoveAnim();
+    walk = RpAnimBlendClumpGetAssociation(nil, ANIM_STD_WALK);
+    check(walk != nil && walk->speed > 1.19f && walk->speed < 1.21f,
+          "a chosen NPC anim set takes the ped roll");
+    bVCModPlayerNpcAnims = false;
+
+    std::printf("ok %d checks\n", checks);
+    return 0;
+}
+'''
+
+
+def run_cpp(source):
+    with tempfile.TemporaryDirectory(prefix="vc-moveanim-test-") as directory:
+        cpp = Path(directory) / "test.cpp"
+        binary = Path(directory) / "test"
+        cpp.write_text(source)
+        build = subprocess.run(["c++", "-std=c++98", "-Wall", "-Wextra", str(cpp), "-o", str(binary)],
+                               capture_output=True, text=True)
+        if build.returncode:
+            print(build.stderr)
+            numbered = "".join(f"{n}: {line}\n" for n, line in enumerate(source.splitlines(), 1))
+            raise RuntimeError("compile failed\n" + numbered)
+        if build.stderr:
+            print(build.stderr)
+        run = subprocess.run([str(binary)], capture_output=True, text=True)
+        if run.returncode:
+            print(run.stdout, run.stderr)
+            raise RuntimeError("test binary failed")
+        print(run.stdout.strip())
+
+
+class MoveAnimTests(unittest.TestCase):
+    def test_start_transitions(self):
+        source = (ENGINE_STUBS + tempo_hook(CHARACTER) + walk_mode_predicate(PLAYERMOD)
+                  + braced(PLAYER, "void\nCPlayerPed::SetRealMoveAnim(void)") + HARNESS)
+        run_cpp(source)
+
+
+# ---- no strafe: the keys choose the heading, the camera does not ----
+
+def _limit_radian(angle):
+    # CGeneral::LimitRadianAngle, src/core/General.h
+    result = max(-25.0, min(25.0, angle))
+    while result >= math.pi:
+        result -= 2 * math.pi
+    while result < -math.pi:
+        result += 2 * math.pi
+    return result
+
+
+def _angle_between(x, y):
+    # CGeneral::GetRadianAngleBetweenPoints(0, 0, x, y), src/core/General.h
+    if y == 0.0:
+        y = 0.0001
+    if x > 0.0:
+        return math.pi - math.atan2(x / y, 1.0) if y > 0.0 else -math.atan2(x / y, 1.0)
+    return -(math.pi + math.atan2(x / y, 1.0)) if y > 0.0 else -math.atan2(x / y, 1.0)
+
+
+class NoStrafeTests(unittest.TestCase):
+    def test_wiring(self):
+        self.assertIn("bool bVCModNoStrafe;", PLAYERMOD)
+        self.assertNotIn("bool bVCModNoStrafe;", PANEL)
+        self.assertRegex(PANEL, r'\{ "NO STRAFE",\s*VCMOD_ROW_FLAG,\s*&bVCModNoStrafe,'
+                                r'\s*"NoStrafe",\s*VCMOD_PAGE_PLAYER,')
+        self.assertIn('ReadIniIfExists("VC Mods", "NoStrafe", &bVCModNoStrafe);', INI)
+
+        # the heading is the pad direction taken off the camera orientation
+        run_around = braced(PLAYER, "void\nCPlayerPed::PlayerControl1stPersonRunAround(CPad *padUsed)")
+        self.assertIn("GetRadianAngleBetweenPoints(0.0f, 0.0f, -leftRight, upDown) - TheCamera.Orientation",
+                      run_around)
+
+        # CalculateNewVelocity must not build a walk angle in this mode, or the
+        # input feeds back into the heading and the ped turns in circles
+        velocity = braced(PED, "void\nCPed::CalculateNewVelocity(void)")
+        self.assertIn("|| VCModPlayerTurnsWithInput()", velocity)
+
+        # no stock side-step groups, and the camera stops aiming the ped
+        anim = braced(PLAYER, "void\nCPlayerPed::ProcessAnimGroups(void)")
+        self.assertEqual(anim.count("!VCModPlayerTurnsWithInput()"), 2)
+        self.assertIn("!VCModPlayerTurnsWithInput()", CAM)
+
+    def test_key_directions(self):
+        # each key must point where the same key goes on screen, for any camera
+        for heading in (0.0, 0.7, -2.1, 3.0, -math.pi + 0.2):
+            vx, vy = -math.sin(heading), math.cos(heading)
+            orientation = math.atan2(vx, vy)  # == -heading
+            right = (vy, -vx)
+            forward = (vx, vy)
+            expected = {
+                "W": forward,
+                "S": (-forward[0], -forward[1]),
+                "D": right,
+                "A": (-right[0], -right[1]),
+            }
+            keys = {"W": (0, -127), "S": (0, 127), "D": (127, 0), "A": (-127, 0)}
+            for name, (left_right, up_down) in keys.items():
+                dest = _limit_radian(_angle_between(-left_right, up_down) - orientation)
+                got = (-math.sin(dest), math.cos(dest))
+                ex = expected[name]
+                dot = got[0] * ex[0] + got[1] * ex[1]
+                self.assertAlmostEqual(dot, 1.0, places=3,
+                                       msg="%s at camera heading %.2f" % (name, heading))
+
+
+if __name__ == "__main__":
+    unittest.main()
