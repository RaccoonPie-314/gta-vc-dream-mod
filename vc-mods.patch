+    check(!VCModLockShotHomes(&p), "losing the lock returns it to the pose");
+    std::printf("ok %d checks\n", checks);
+    return 0;
+}
+'''
+        run_cpp(source)
+
+
+class FreeAimCameraTests(unittest.TestCase):
+    def test_free_camera_keeps_the_view_and_hides_the_crosshair(self):
+        source = STUBS + r'''
+struct CCamera { static bool m_bUseMouse3rdPerson; };
+bool CCamera::m_bUseMouse3rdPerson;
+''' + "\n".join((
+            braced(MODULE, "bool\nVCModFreeAimCameraLock(void)"),
+            braced(MODULE, "bool\nVCModFreeAimCrosshairHidden(CPed *player)"),
+        )) + r'''
+static int checks;
+static void check(bool condition, const char *name)
+{
+    if (!condition) { std::fprintf(stderr, "FAIL: %s\n", name); std::exit(1); }
+    ++checks;
+}
+
+int main() {
+    CPlayerPed p = {};
+    CEntity target;
+    target.tag = 1;
+    CCamera::m_bUseMouse3rdPerson = true;
+
+    bVCModMouseAimLockOn = false;
+    check(!VCModFreeAimCameraLock(),
+          "the row off leaves the stock lock camera to the game");
+
+    bVCModMouseAimLockOn = true;
+    check(VCModFreeAimCameraLock(),
+          "the row on keeps the free mouse camera over a lock");
+
+    CCamera::m_bUseMouse3rdPerson = false;
+    check(!VCModFreeAimCameraLock(),
+          "the classic control method keeps the stock lock camera");
+    CCamera::m_bUseMouse3rdPerson = true;
+
+    check(!VCModFreeAimCrosshairHidden(&p),
+          "the free-aim crosshair shows with no target");
+    p.m_pPointGunAt = &target;
+    check(VCModFreeAimCrosshairHidden(&p),
+          "a locked target hides the free-aim crosshair");
+    bVCModMouseAimLockOn = false;
+    check(!VCModFreeAimCrosshairHidden(&p),
+          "the row off leaves the crosshair alone");
+
+    std::printf("ok %d checks\n", checks);
+    return 0;
+}
+'''
+        run_cpp(source)
+
+
+class PlayerWiringTests(unittest.TestCase):
+    def test_module_owns_the_state(self):
+        for decl in ("bool bVCModWalkMode;", "bool bVCModNoStrafe;",
+                     "bool bVCModLockOnVehicles;", "bool bVCModLockOnLatch;",
+                     "bool bVCModMouseAimLockOn;"):
+            self.assertIn(decl, MODULE)
+            self.assertNotIn(decl, PANEL)
+        self.assertNotIn("VCModPlayerTurnsWithInput", PANEL)
+        self.assertIn("VCModPlayerTurnsWithInput", MODULE)
+
+    def test_engine_keeps_hooks_only(self):
+        self.assertEqual(PLAYER.count("VCModWalkModeCap(this);"), 2)
+        self.assertIn("VCModPlayerToggleWalkMode();", PLAYER)
+        self.assertIn("VCModLockOnLatchTick(this, padUsed);", PLAYER)
+        self.assertIn("VCModLockOnVehiclesNext(this, previousTarget, &nextTarget", PLAYER)
+        self.assertIn("VCModLockOnVehiclesFirst(this, &nextTarget", PLAYER)
+        for state in ("bVCModWalkMode", "bVCModNoStrafe", "bVCModLockOnLatch",
+                      "bVCModLockOnVehicles", "bVCModMouseAimLockOn", "bVCModLockOnHeld"):
+            self.assertNotIn(state, PLAYER)
+
+    def test_panel_rows_still_point_at_the_flags(self):
+        for row in ("&bVCModWalkMode", "&bVCModNoStrafe", "&bVCModLockOnVehicles",
+                    "&bVCModLockOnLatch", "&bVCModMouseAimLockOn"):
+            self.assertIn(row, PANEL)
+        self.assertIn("TWEAKBOOL(bVCModWalkMode);", PANEL)
+
+    def test_camera_and_velocity_read_the_predicate(self):
+        self.assertIn("!VCModPlayerTurnsWithInput()", CAM)
+        self.assertIn("|| VCModPlayerTurnsWithInput()", PED)
+
+    def test_free_camera_lock_sites(self):
+        # the lock camera stands down for the free mouse camera, and the HUD
+        # asks before stacking the crosshair over the target marker
+        self.assertIn("if (!VCModFreeAimCameraLock())", PLAYER)
+        self.assertIn("VCModFreeAimCrosshairHidden(playerPed)", HUD)
+        self.assertNotIn("MODE_SYPHON", HUD)
+
+    def test_the_lock_still_homes_the_shot(self):
+        # the arm's pointed flag fails once NO STRAFE turns the body; the lock
+        # has to win the shot back from the heading fallback
+        self.assertIn('#include "vcmodplayer.h"', WEAPONS)
+        self.assertIn("|| VCModLockShotHomes(shooterPed)", WEAPONS)
+        self.assertLess(WEAPONS.index("VCModLockShotHomes(shooterPed)"),
+                        WEAPONS.index("TransformToNode(target, PED_HANDR)"))
+
+    def test_the_firing_stance_sites(self):
+        # the aim owns the body while the trigger is held at a lock: the stock
+        # clamp stands down, the camera keeps its hands off the heading
+        self.assertIn("if (VCModFiringStanceTurn(this))", PLAYER)
+        self.assertIn("!VCModFiringStance()", CAM)
+
+
+if __name__ == "__main__":
+    unittest.main()
