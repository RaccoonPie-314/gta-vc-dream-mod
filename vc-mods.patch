diff --git a/src/extras/vcmodtraffic.cpp b/src/extras/vcmodtraffic.cpp
new file mode 100644
index 0000000..4a1f7cd
--- /dev/null
+++ b/src/extras/vcmodtraffic.cpp
@@ -0,0 +1,295 @@
+#include "common.h"
+
+#include "vcmodtraffic.h"
+
+#include "Automobile.h"
+#include "Camera.h"
+#include "CarCtrl.h"
+#include "ColPoint.h"
+#include "General.h"
+#include "ModelInfo.h"
+#include "Pools.h"
+#include "Timer.h"
+#include "TrafficLights.h"
+#include "Vehicle.h"
+#include "World.h"
+
+bool bVCModTrafficAI = true;
+
+// Values from Real Traffic Fix's own source (JuniorDjjr, real-traffic-fix), VC build.
+#define RTF_CRUISE		15.0f
+#define RTF_MIN			3.0f
+#define RTF_MAX			30.0f
+#define RTF_TURN_DECREASE	15.0f
+#define RTF_FRONT_MULT		50.0f
+#define RTF_SIDES_DIV		70.0f
+#define RTF_CHECK_GROUND	0.5f
+#define RTF_FINAL_GROUND	0.5f
+#define RTF_HEIGHT_LIMIT	3.0f
+#define RTF_ACCEL		0.005f
+#define RTF_DECEL		0.01f
+#define RTF_OBSTACLE_DECREASE	20.0f
+#define RTF_HORN_ONE_IN		100
+
+static const float MAGIC = 50.0f / 30.0f;
+
+#define FLAG_PHYSICS	1
+#define FLAG_GROUNDFIX	2
+
+static float aFreeLineTimer[NUMVEHICLES];
+static uint8 aFlags[NUMVEHICLES];
+static uint32 aBlockedSince[NUMVEHICLES];
+static uint32 aAvoidUntil[NUMVEHICLES];
+static int32 aStyleBefore[NUMVEHICLES];
+
+#define RTF_STUCK_MS	3000	// held up this long by a stationary car
+#define RTF_AVOID_MS	4000	// then give way / go around for this long
+#define RTF_STOPPED	0.06f	// speed under which the car counts as not moving
+
+int32
+VCModTrafficLane(CVehicle *vehicle, uint8 lanes)
+{
+	if (lanes == 0)
+		return 0;
+
+	if (bVCModTrafficAI && vehicle->GetModelInfo()->m_vehicleClass == CCarCtrl::BIG)
+		return lanes - 1;
+
+	return CGeneral::GetRandomNumber() % lanes;
+}
+
+bool
+VCModTrafficHornAllowed(void)
+{
+	if (!bVCModTrafficAI)
+		return true;
+
+	// the mod spends a dice roll per call instead of a cooldown
+	return CGeneral::GetRandomNumberInRange(0, RTF_HORN_ONE_IN) == 0;
+}
+
+static float
+ClampCruise(float speed)
+{
+	if (speed < RTF_MIN)
+		return RTF_MIN;
+	if (speed > RTF_MAX)
+		return RTF_MAX;
+	return speed;
+}
+
+// A car sitting with no ground underneath it is inside the collision, not floating
+// over a hole: probing above its own roof finds ground again.
+static bool
+NeedsRepos(CVehicle *vehicle, const CVector &local, float roof)
+{
+	CVector world = vehicle->GetMatrix() * local;
+	world.z = vehicle->GetPosition().z;
+
+	bool found;
+	CWorld::FindGroundZFor3DCoord(world.x, world.y, world.z, &found);
+	if (found)
+		return false;
+
+	CWorld::FindGroundZFor3DCoord(world.x, world.y, world.z + roof, &found);
+	return found;
+}
+
+static bool
+ReposVehicle(CVehicle *vehicle)
+{
+	CVector pos = vehicle->GetPosition();
+
+	for (int32 attempt = 0; attempt < 2; attempt++) {
+		pos.x += 0.027f;
+		pos.y += 0.027f;
+		pos.z += 2.0f;
+
+		bool found;
+		float ground = CWorld::FindGroundZFor3DCoord(pos.x, pos.y, pos.z, &found);
+		if (!found)
+			continue;
+
+		pos.z = ground + 0.5f;
+		vehicle->SetPosition(pos);
+		((CAutomobile*)vehicle)->PlaceOnRoadProperly();
+		return true;
+	}
+
+	return false;
+}
+
+static bool
+GroundStuckFix(CVehicle *vehicle, bool isBike)
+{
+	CColModel *col = vehicle->GetModelInfo()->GetColModel();
+	CVector front(0.0f, col->boundingBox.max.y * 0.9f, 0.0f);
+	CVector back(0.0f, col->boundingBox.min.y * 0.9f, 0.0f);
+
+	if (!NeedsRepos(vehicle, back, col->boundingBox.max.z) &&
+	    (isBike || !NeedsRepos(vehicle, front, col->boundingBox.max.z)))
+		return false;
+
+	return ReposVehicle(vehicle);
+}
+
+// Is anything in the way? Returns false and sets the hit point when the road ahead
+// is clear. Three probes: centre, and the two edges of the body for cars.
+static bool
+ProbeAhead(CVehicle *vehicle, bool isBike, float speed, float speedFactor,
+	CColPoint *colPoint)
+{
+	CColModel *col = vehicle->GetModelInfo()->GetColModel();
+	float ground = col->boundingBox.min.z * 0.4f;
+	if (ground < -1.0f)
+		ground = -1.0f;
+	if (ground > 1.0f)
+		ground = 1.0f;
+
+	float bonus = isBike ? 0.5f : 0.15f;
+	float limit = RTF_HEIGHT_LIMIT * (isBike ? 2.0f : 1.0f);
+	float dist = Max(1.0f, vehicle->GetMoveSpeed().Magnitude() * RTF_FRONT_MULT);
+	float steer = -vehicle->m_fSteerAngle * 20.0f * speedFactor;
+	float side = speed / RTF_SIDES_DIV;
+
+	struct { CVector from, to; } ray[3];
+	ray[0].from = CVector(0.0f, col->boundingBox.max.y, ground + bonus);
+	ray[0].to = CVector(steer, col->boundingBox.max.y + dist, ground / 1.5f + bonus * 2.0f);
+	ray[1].from = CVector(col->boundingBox.min.x,
+		col->boundingBox.max.y - Max(0.0f, col->boundingBox.max.y * vehicle->m_fSteerAngle),
+		ground + bonus);
+	ray[1].to = CVector(col->boundingBox.min.x - side + steer,
+		col->boundingBox.max.y + dist, ground / 1.5f);
+	ray[2].from = CVector(col->boundingBox.max.x,
+		col->boundingBox.max.y + Min(0.0f, col->boundingBox.max.y * vehicle->m_fSteerAngle),
+		ground + bonus);
+	ray[2].to = CVector(col->boundingBox.max.x + side + steer,
+		col->boundingBox.max.y + dist, ground / 1.5f);
+
+	CWorld::pIgnoreEntity = vehicle;
+	for (int32 i = 0; i < (isBike ? 1 : 3); i++) {
+		CVector from = vehicle->GetMatrix() * ray[i].from;
+		CVector to = vehicle->GetMatrix() * ray[i].to;
+
+		bool found;
+		float ground = CWorld::FindGroundZFor3DCoord(to.x, to.y, to.z + RTF_CHECK_GROUND, &found);
+		if (!found || ABS(ground - to.z) > limit) {
+			// no road where the car is heading: treat the probe end as the wall
+			colPoint->point = to;
+			return true;
+		}
+		to.z = ground + RTF_FINAL_GROUND;
+
+		CEntity *hit = nil;
+		if (CWorld::ProcessLineOfSight(from, to, *colPoint, hit,
+			true, true, true, false, false, false))
+			return true;
+	}
+	return false;
+}
+
+void
+VCModTrafficUpdate(CVehicle *vehicle)
+{
+	if (!bVCModTrafficAI)
+		return;
+	if (vehicle->pDriver == nil || vehicle->pDriver->IsPlayer())
+		return;
+	if (vehicle->VehicleCreatedBy == MISSION_VEHICLE)
+		return;
+	if (vehicle->m_vehType != VEHICLE_TYPE_CAR && vehicle->m_vehType != VEHICLE_TYPE_BIKE)
+		return;
+
+	// The mod hooked the render pass, so it only ever touched visible cars. Do the
+	// same explicitly: three line-of-sight probes per car is not free.
+	if ((vehicle->GetPosition() - TheCamera.GetPosition()).Magnitude() > 120.0f)
+		return;
+
+	int32 index = CPools::GetVehiclePool()->GetIndex(vehicle);
+	if (index < 0 || index >= NUMVEHICLES)
+		return;
+
+	bool isBike = vehicle->m_vehType == VEHICLE_TYPE_BIKE;
+	float step = CTimer::GetTimeStep() / MAGIC;
+
+	vehicle->AutoPilot.m_nCruiseSpeed = RTF_CRUISE;
+
+	if ((aFlags[index] & FLAG_PHYSICS) == 0) {
+		CCarCtrl::SwitchVehicleToRealPhysics(vehicle);
+		aFlags[index] |= FLAG_PHYSICS;
+	}
+
+	if ((aFlags[index] & FLAG_GROUNDFIX) && vehicle->GetMoveSpeed().Magnitude() < 0.005f)
+		GroundStuckFix(vehicle, isBike);
+
+	if (vehicle->GetMoveSpeed().Magnitude() <= 0.0005f) {
+		aFreeLineTimer[index] = 0.0f;
+		return;
+	}
+
+	if (vehicle->AutoPilot.m_pTargetCar != nil)
+		return;
+	if (vehicle->m_bSirenOrAlarm && vehicle->GetModelIndex() != MI_MRWHOOP)
+		return;
+
+	float speed = vehicle->GetMoveSpeed().Magnitude() * 50.0f * 3.6f;
+	CVector cam = TheCamera.GetPosition();
+	if (speed > 10.0f && (vehicle->GetPosition() - cam).Magnitude() < 30.0f)
+		aFlags[index] &= ~FLAG_GROUNDFIX;
+
+	if (vehicle->m_nCurrentGear == 0)
+		return;
+
+	float cruise = RTF_CRUISE;
+	if (ABS(vehicle->m_fSteerAngle) > 0.001f)
+		cruise = ClampCruise(RTF_CRUISE - RTF_TURN_DECREASE * ABS(vehicle->m_fSteerAngle));
+
+	float speedFactor = Min(speed / 40.0f, 1.0f);
+	CColPoint colPoint;
+	bool blocked = ProbeAhead(vehicle, isBike, speed, speedFactor, &colPoint);
+
+	// A car held up by something that is not a light gets one chance to give way
+	// rather than sit there for ever. AVOID_CARS is the engine's own style for it.
+	uint32 now = CTimer::GetTimeInMilliseconds();
+	bool atLight = CTrafficLights::ShouldCarStopForLight(vehicle, false) ||
+		CTrafficLights::ShouldCarStopForBridge(vehicle);
+
+	if (aAvoidUntil[index] != 0 && now >= aAvoidUntil[index]) {
+		if (vehicle->AutoPilot.m_nDrivingStyle == DRIVINGSTYLE_AVOID_CARS)
+			vehicle->AutoPilot.m_nDrivingStyle = aStyleBefore[index];
+		aAvoidUntil[index] = 0;
+	}
+
+	if (blocked && !atLight && vehicle->GetMoveSpeed().Magnitude() < RTF_STOPPED) {
+		if (aBlockedSince[index] == 0)
+			aBlockedSince[index] = now;
+		else if (now - aBlockedSince[index] >= RTF_STUCK_MS && aAvoidUntil[index] == 0) {
+			aStyleBefore[index] = vehicle->AutoPilot.m_nDrivingStyle;
+			vehicle->AutoPilot.m_nDrivingStyle = DRIVINGSTYLE_AVOID_CARS;
+			aAvoidUntil[index] = now + RTF_AVOID_MS;
+			aBlockedSince[index] = 0;
+		}
+	} else if (!blocked || atLight) {
+		aBlockedSince[index] = 0;
+	}
+
+	if (blocked) {
+		float near = Min(1.0f, (colPoint.point - vehicle->GetPosition()).Magnitude() / 20.0f);
+		float factor = 1.0f - near;
+		aFreeLineTimer[index] -= factor * speedFactor * step;
+		if (aFreeLineTimer[index] < 0.0f)
+			aFreeLineTimer[index] = 0.0f;
+		cruise = ClampCruise(RTF_CRUISE - RTF_OBSTACLE_DECREASE * factor * step);
+	} else if (vehicle->m_fGasPedal >= 0.05f) {
+		aFreeLineTimer[index] += RTF_ACCEL * step;
+		if (aFreeLineTimer[index] > 1.0f)
+			aFreeLineTimer[index] = 1.0f;
+		cruise = ClampCruise(cruise + (RTF_MAX - RTF_CRUISE) * aFreeLineTimer[index]);
+	} else {
+		aFreeLineTimer[index] -= RTF_DECEL * step;
+		if (aFreeLineTimer[index] < 0.0f)
+			aFreeLineTimer[index] = 0.0f;
+	}
+
+	vehicle->AutoPilot.m_nCruiseSpeed = (int8)cruise;
+}
