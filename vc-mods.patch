+    def test_toggle_off_resets_the_ai_leftovers(self):
+        # the "cannot regain control" report: toggling off at a seat left the
+        # seat objective and its seek running, and the player's control switch
+        # has no input path out of PED_SEEK_POS. The release drops all of it
+        run_cpp(npc_source() + r'''
+int main(void) {
+''' + setup(state="PED_SEEK_POS") + r'''
+    CEntity corpse; CPedAttractor seat;
+    bVCModStreetWander = true;
+    p.m_objective = 39;                         // the seat objective
+    p.m_nWaitState = 24;                        // WAITSTATE_SIT_IDLE
+    p.m_fMoveSpeed = 1.0f;
+    p.bIsRunning = true;
+    p.m_attractor = &seat;
+    p.m_threatEntity = &corpse;
+    p.m_threatFlags = 8;
+    bVCModSitting = true;
+    bVCModSitEngine = true;
+    bVCModNpcModeWasOn = true;
+    bVCModNpcMode = false;
+    VCModUpdateNpcMode(&p, &pad);
+    if (p.m_objective != 0) return 1;            // ClearObjective ran
+    if (p.m_nWaitState != 0) return 2;           // no sit/panic pose left
+    if (p.m_nPedState != PED_IDLE) return 3;     // out of the seek state
+    if (p.m_fMoveSpeed != 0.0f || p.bIsRunning) return 4;
+    if (p.m_attractor != nil) return 5;          // the seat is released
+    if (p.m_threatEntity != nil || p.m_threatFlags != 0) return 6;
+    if (bVCModSitting || bVCModSitEngine) return 7;
+    if (p.m_pNextPathNode != nil) return 8;
+    return 0;
+}
+''')
