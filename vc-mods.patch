+};
+CPlayerPed *focusedPlayer;
+CPlayerPed *FindPlayerPed() { return focusedPlayer; }
+CPad *GetPadFromPlayer(CPlayerPed*) { return &pad; }
+CAnimBlendAssociation *RpAnimBlendClumpGetAssociation(CPlayerPed *player, AnimationId id) {
+    return player->missingAnimations ? nil : &player->animations[id];
+}
+''' + definitions + "\n" + state + "\n" + owns + "\n" + clear + "\n" + update + "\n" + stamina + "\n" + suspend +
+            "\nvoid BeforeReplaySnapshot() {\n" + replay_hook + "\n}\n" + tempo + r'''
+void CPlayerPed::ApplyMovement() {
+    CAnimBlendAssociation *curWalkStartAssoc = RpAnimBlendClumpGetAssociation(this, ANIM_STD_STARTWALK);
+    CAnimBlendAssociation *curWalkAssoc = RpAnimBlendClumpGetAssociation(this, ANIM_STD_WALK);
+    CAnimBlendAssociation *curRunAssoc = RpAnimBlendClumpGetAssociation(this, ANIM_STD_RUN);
+    CAnimBlendAssociation *curSprintAssoc = RpAnimBlendClumpGetAssociation(this, ANIM_STD_RUNFAST);
+''' + movement + r'''
+static int checks;
+void check(bool condition, const char *name) {
+    if (!condition) { std::fprintf(stderr, "FAIL: %s\n", name); std::exit(1); }
+    ++checks;
+}
+void reset(CPlayerPed &player) {
+    player.ClearAdrenaline();
+    player.bInVehicle = player.m_bAdrenalineActive = player.missingAnimations = false;
+    player.m_nAdrenalineTime = 0;
+    player.m_nPedState = PED_IDLE;
+    player.m_fHealth = 100.0f;
+    player.m_fCurrentStamina = -100.0f;
+    player.m_fMaxStamina = 150.0f;
+    player.m_fStaminaProgress = 0.0f;
+    for (int i = 0; i < 4; ++i) player.animations[i].speed = 1.0f;
+    nVCModAdrenalineMode = 0;
+    pad.disabled = CCutsceneMgr::running = CReplay::playing = false;
+    CTimer::scale = 1.0f;
+    CTimer::now = 1000;
+    focusedPlayer = &player;
+}
+int main() {
+    CPlayerPed player = {};
+    check(nVCModAdrenalineMode == 0, "defaults to off");
+    reset(player);
+    nVCModAdrenalineMode = 2;
+    VCModUpdateAdrenaline(&player);
+    player.ApplyMovement();
+    check(player.m_bAdrenalineActive, "toggle activates native gameplay flag");
+    check(CTimer::scale == 1.0f / 3, "slow-mo uses native world speed");
+    check(player.m_fCurrentStamina == 150.0f, "activation refills exhausted stamina");
+    for (int i = 0; i < 4; ++i) check(player.animations[i].speed == 1.0f, "mod adrenaline does not double locomotion speed");
+    player.UseSprintEnergy();
+    check(player.m_fCurrentStamina == 150.0f, "native sprint remains unlimited");
+    CTimer::now += 100000;
+    VCModUpdateAdrenaline(&player);
+    player.ApplyMovement();
+    check(player.m_bAdrenalineActive, "toggle outlasts the pill timer");
+    nVCModAdrenalineMode = 1;
+    VCModUpdateAdrenaline(&player);
+    player.ApplyMovement();
+    check(CTimer::scale == 1.0f, "switching to normal removes slowdown");
+    check(player.m_bAdrenalineActive && player.animations[1].speed == 1.0f, "normal keeps native flag effects without doubled movement");
+    nVCModAdrenalineMode = 2;
+    VCModUpdateAdrenaline(&player);
+    check(CTimer::scale == 1.0f / 3, "normal switches back to slow-mo");
+    nVCModAdrenalineMode = 0;
+    VCModUpdateAdrenaline(&player);
+    check(!player.m_bAdrenalineActive && player.m_nAdrenalineTime == 0, "off clears native flag and timer");
+    check(CTimer::scale == 1.0f, "off restores world speed without a movement update");
+    for (int i = 0; i < 4; ++i) check(player.animations[i].speed == 1.0f, "off resets all locomotion speeds");
+    player.UseSprintEnergy();
+    check(player.m_fCurrentStamina == 149.0f, "off restores stamina drain");
+
+    reset(player);
