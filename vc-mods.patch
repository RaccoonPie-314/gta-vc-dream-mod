+#include "vcmodlighttex.h"
+#include "vcmodfirstperson.h"
+#include "vcmodspawn.h"
+#include "vcmoddiag.h"
+
+#ifdef DEBUGMENU
+#include "rtcharse.h"
+#include "re3_inttypes.h"
+#include "ControllerConfig.h"
+#include "PlayerPed.h"
+#include "World.h"
+#include "debugmenu.h"
+
+// Colour comes from the charset, the same way the debug menu highlights a selected
+// row: an opaque background on every glyph is what makes a row read as a panel.
+enum eVCModFont
+{
+	VCFONT_TITLE,
+	VCFONT_LABEL,
+	VCFONT_ON,
+	VCFONT_OFF,
+	VCFONT_SET,
+	VCFONT_WARN,
+	VCFONT_HINT,
+	VCFONT_MARK,
+	VCFONT_PIN,
+	NUM_VCFONTS
+};
+
+static RtCharset *aVCModFonts[NUM_VCFONTS];
+static int32 nVCModCharW, nVCModCharH;
+static bool bVCModPanelOpen;
+static float fVCModCursorX, fVCModCursorY;
+
+int32 nVCModOpenList;
+int32 nVCModListScroll;
+// which row opened the list: page row for drawing, table index for its pin
+static int32 nVCModListAnchor;
+static int32 nVCModListRow;
+// the last tab looked at, kept for the session
+static int32 nVCModPage = VCMOD_PAGE_COMBAT;
+// the last row the pointer was on: the help line stays readable after the
+// pointer moves away, which is what makes it useful while reading a value
+static int32 nVCModHelpRow = -1;
+
+#define VCMOD_PANEL_X		20
+#define VCMOD_PANEL_Y		60
+#define VCMOD_PIN_COLS		5
+#define VCMOD_NAME_COLS		22	// PERMA cell plus 17 label columns
+#define VCMOD_VALUE_COLS	28
+#define VCMOD_LIST_ROWS		16
+
+static void
+VCModMakeFonts(void)
+{
+	static const RwRGBA aFg[NUM_VCFONTS] = {
+		{ 255,  96, 192, 255 },	// title
+		{ 232, 232, 240, 255 },	// label
+		{ 112, 240, 148, 255 },	// on
+		{ 132, 132, 144, 255 },	// off
+		{ 110, 216, 255, 255 },	// anim set name
+		{ 255, 200,  72, 255 },	// warning
+		{ 196, 156, 255, 255 },	// key hints
+		{ 255, 255, 255, 255 },	// marker
+		{ 255, 200,  72, 255 }		// pin
+	};
+	static const RwRGBA aBgPanel[NUM_VCFONTS] = {
+		{  32,   8,  40, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20, 255 },
+		{  36,  24,   4, 255 },
+		{  12,  12,  20, 255 },
+		{  12,  12,  20,   0 },
+		{  12,  12,  20, 255 }
+	};
+
+	OpenCharsetSafe();
+
+	for (int32 i = 0; i < NUM_VCFONTS; i++) {
+		aVCModFonts[i] = RtCharsetCreate(&aFg[i], &aBgPanel[i]);
+		if (aVCModFonts[i] == nil)
+			return;
+	}
+
+	RtCharsetDesc desc;
+	RtCharsetGetDesc(aVCModFonts[VCFONT_LABEL], &desc);
+	nVCModCharW = desc.width;
+	nVCModCharH = desc.height;
+}
+
+static void
+VCModPrint(int32 style, const char *s, int32 x, int32 y)
+{
+	RtCharsetPrintBuffered(aVCModFonts[style], s, x, y, false);
+}
+
+// every cell is padded to a fixed width, otherwise the row backgrounds end at
+// ragged distances and the panel reads as floating text
+static void
+VCModCell(int32 style, const char *s, int32 x, int32 y, int32 cols)
+{
+	char cell[64];
+	snprintf(cell, sizeof(cell), "%-*s", cols, s);
+	VCModPrint(style, cell, x, y);
+}
+
+static bool
+VCModCursorInRect(float px, float py, int32 x, int32 y, int32 w, int32 h)
+{
+	return px >= x && px < x + w && py >= y && py < y + h;
+}
+
+static void
+VCModUpdateMouse(CPad *pad, int32 screenW, int32 screenH)
+{
+	// the panel cursor has to follow the same invert settings the game's own mouse
+	// look uses, or it moves against the hand that is pointing it
+	int dirX = MousePointerStateHelper.bInvertHorizontally ? -1 : 1;
+	int dirY = MousePointerStateHelper.bInvertVertically ? -1 : 1;
+
+	fVCModCursorX += pad->NewMouseControllerState.x * dirX;
+	fVCModCursorY += pad->NewMouseControllerState.y * dirY;
+	if (fVCModCursorX < 0.0f) fVCModCursorX = 0.0f;
+	if (fVCModCursorY < 0.0f) fVCModCursorY = 0.0f;
+	if (fVCModCursorX >= screenW) fVCModCursorX = screenW - 1.0f;
+	if (fVCModCursorY >= screenH) fVCModCursorY = screenH - 1.0f;
+
+	// the camera must not turn while the panel is being pointed at
+	pad->NewMouseControllerState.x = 0.0f;
+	pad->NewMouseControllerState.y = 0.0f;
+}
+
+// title, tab strip, PERMA column header, then the page's rows
+static int32
+VCModRowY(int32 row)
+{
+	return VCMOD_PANEL_Y + nVCModCharH * (row + 3);
+}
+
+static int32
+VCModTabY(void)
+{
+	return VCMOD_PANEL_Y + nVCModCharH;
+}
+
+static int32
+VCModHeaderY(void)
+{
+	return VCMOD_PANEL_Y + nVCModCharH * 2;
+}
+
+// the strip starts one column in, with two columns between names
+static int32
+VCModTabX(int32 page)
+{
+	int32 x = VCMOD_PANEL_X + nVCModCharW;
+	for (int32 i = 0; i < page; i++)
+		x += ((int32) strlen(aVCModPageNames[i]) + 2) * nVCModCharW;
+	return x;
+}
+
+static int32
+VCModTabW(int32 page)
+{
+	return (int32) strlen(aVCModPageNames[page]) * nVCModCharW;
+}
+
+// lists open beside the panel instead of pushing the rows down, so the panel
+// keeps one shape while choosing
+static int32
+VCModListX(void)
+{
+	return VCMOD_PANEL_X + (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW + 20;
+}
+
+static int32
+VCModListRowY(int32 anchorRow, int32 visible)
+{
+	return VCModRowY(anchorRow) + nVCModCharH * visible;
+}
+
+static int32
+VCModRowList(int32 kind)
+{
+	switch (kind) {
+	case VCMOD_ROW_ANIMSET:	return VCMOD_LIST_ANIM;
+	case VCMOD_ROW_PEDCAT:	return VCMOD_LIST_PEDCAT;
+	case VCMOD_ROW_PEDCHAR:	return VCMOD_LIST_PEDCHAR;
+	case VCMOD_ROW_RIDEZONE:	return VCMOD_LIST_RIDEZONE;
+	case VCMOD_ROW_RIDESTYLE:	return VCMOD_LIST_RIDESTYLE;
+	case VCMOD_ROW_CREWCAR:	return VCMOD_LIST_CREWCAR;
+	case VCMOD_ROW_SPAWN:		return VCMOD_LIST_SPAWN;
+	}
+	return VCMOD_LIST_NONE;
+}
+
+// the first entry drawn: lists that fit show everything, longer ones scroll
+static int32
+VCModListFirst(int32 list)
+{
+	int32 max = VCModListCount(list) - VCMOD_LIST_ROWS;
+	if (max < 0)
+		max = 0;
+	if (nVCModListScroll > max)
+		nVCModListScroll = max;
+	return nVCModListScroll;
+}
+
+static void
+VCModTriangle(RwCamera *cam, float x0, float y0, float x1, float y1, float x2, float y2,
+	uint8 r, uint8 g, uint8 b)
+{
+	RwIm2DVertex verts[3];
+	float recipz = 1.0f / RwCameraGetNearClipPlane(cam);
+
+	RwRenderStateSet(rwRENDERSTATETEXTURERASTER, nil);
+
+	RwIm2DVertexSetScreenX(&verts[0], x0);
+	RwIm2DVertexSetScreenY(&verts[0], y0);
+	RwIm2DVertexSetScreenZ(&verts[0], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[0], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[0], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[0], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[1], x1);
+	RwIm2DVertexSetScreenY(&verts[1], y1);
+	RwIm2DVertexSetScreenZ(&verts[1], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[1], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[1], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[1], r, g, b, 255);
+
+	RwIm2DVertexSetScreenX(&verts[2], x2);
+	RwIm2DVertexSetScreenY(&verts[2], y2);
+	RwIm2DVertexSetScreenZ(&verts[2], RwIm2DGetNearScreenZ());
+	RwIm2DVertexSetCameraZ(&verts[2], RwCameraGetNearClipPlane(cam));
+	RwIm2DVertexSetRecipCameraZ(&verts[2], recipz);
+	RwIm2DVertexSetIntRGBA(&verts[2], r, g, b, 255);
+
+	RwIm2DRenderPrimitive(rwPRIMTYPETRILIST, verts, 3);
+}
+
+// a charset "+" was unreadably small, so the pointer is geometry: a filled arrow
+// with a dark edge that stays visible on both the panel and the sky
+static void
+VCModDrawCursor(RwCamera *cam)
+{
+	int32 x = (int32) fVCModCursorX;
+	int32 y = (int32) fVCModCursorY;
+
+	VCModTriangle(cam, x - 2.0f, y - 2.0f, x - 2.0f, y + 22.0f, x + 16.0f, y + 12.0f, 8, 8, 12);
+	VCModTriangle(cam, (float) x, (float) y, (float) x, y + 19.0f, x + 14.0f, y + 10.0f, 255, 255, 255);
+}
+
+// the two-finger scroll is the only gesture the trackpad has left once aiming
+// owns the hold, so it is what moves through a list
+static void
+VCModScroll(CPad *pad)
+{
+	if (nVCModOpenList == VCMOD_LIST_NONE)
+		return;
+
+	int32 max = VCModListCount(nVCModOpenList) - VCMOD_LIST_ROWS;
+	if (max < 0)
+		max = 0;
+
+	if (pad->GetMouseWheelUpJustDown())
+		nVCModListScroll--;
+	if (pad->GetMouseWheelDownJustDown())
+		nVCModListScroll++;
+	if (nVCModListScroll < 0)
+		nVCModListScroll = 0;
+	if (nVCModListScroll > max)
+		nVCModListScroll = max;
+
+	// browsing the roster must not cycle weapons underneath the cursor
+	pad->NewMouseControllerState.WHEELUP = false;
+	pad->NewMouseControllerState.WHEELDN = false;
+}
+
+static void
+VCModClick(CPad *pad)
+{
+	if (!(pad->NewMouseControllerState.LMB && !pad->OldMouseControllerState.LMB))
+		return;
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+
+	// tabs first: switching page closes whatever list was open
+	for (int32 page = 0; page < NUM_VCMOD_PAGES; page++) {
+		if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCModTabX(page), VCModTabY(),
+				VCModTabW(page), nVCModCharH))
+			continue;
+		nVCModPage = page;
+		nVCModOpenList = VCMOD_LIST_NONE;
+		nVCModListScroll = 0;
+		return;
+	}
+
+	// the master switch rides at the right end of the title row
+	if (VCModCursorInRect(fVCModCursorX, fVCModCursorY,
+			VCMOD_PANEL_X + rowW - 9 * nVCModCharW, VCMOD_PANEL_Y,
+			9 * nVCModCharW, nVCModCharH)) {
+		VCModToggleAll();
+		return;
+	}
+
+	if (nVCModOpenList != VCMOD_LIST_NONE) {
+		int32 first = VCModListFirst(nVCModOpenList);
+		int32 count = VCModListCount(nVCModOpenList);
+		if (count > first + VCMOD_LIST_ROWS)
+			count = first + VCMOD_LIST_ROWS;
+
+		for (int32 entry = first; entry < count; entry++) {
+			if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCModListX(),
+					VCModListRowY(nVCModListAnchor, entry - first),
+					VCMOD_VALUE_COLS * nVCModCharW, nVCModCharH))
+				continue;
+
+			VCModListPick(nVCModOpenList, entry);
+			if (nVCModListRow >= 0 && VCModRowPinned(&aVCModRows[nVCModListRow]))
+				VCModSavePins();
+			return;
+		}
+	}
+
+	int32 pageRows = VCModPageRowCount(nVCModPage);
+	for (int32 row = 0; row < pageRows; row++) {
+		int32 index = VCModPageRow(nVCModPage, row);
+		if (index < 0)
+			break;
+
+		const VCModRowDef *def = &aVCModRows[index];
+		int32 y = VCModRowY(row);
+		if (!VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCMOD_PANEL_X, y, rowW, nVCModCharH))
+			continue;
+
+		// the pin cell is its own target; the rest of the row acts
+		if (def->iniKey != nil &&
+		    VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCMOD_PANEL_X, y,
+				VCMOD_PIN_COLS * nVCModCharW, nVCModCharH)) {
+			VCModTogglePin(def);
+			return;
+		}
+
+		switch (def->kind) {
+		case VCMOD_ROW_FLAG:
+			*def->state = !*def->state;
+			// STREET IDLE and BECOME NPC are mutually exclusive
+			if (def->state == &bVCModNpcMode && bVCModNpcMode)
+				bVCModStreetIdle = false;
+			if (def->state == &bVCModStreetIdle && bVCModStreetIdle)
+				bVCModNpcMode = false;
+			if (VCModRowPinned(def))
+				VCModSavePins();
+			break;
+		case VCMOD_ROW_CYCLE:
+			def->cycle->set((def->cycle->get() + 1) % def->cycle->count);
+			if (VCModRowPinned(def))
+				VCModSavePins();
+			break;
+		case VCMOD_ROW_ANIMSET:
+		case VCMOD_ROW_PEDCAT:
+		case VCMOD_ROW_PEDCHAR:
+		case VCMOD_ROW_RIDEZONE:
+		case VCMOD_ROW_RIDESTYLE:
+		case VCMOD_ROW_SPAWN: {
+			int32 want = VCModRowList(def->kind);
+			nVCModOpenList = nVCModOpenList == want ? VCMOD_LIST_NONE : want;
+			nVCModListAnchor = row;
+			nVCModListRow = index;
+			nVCModListScroll = 0;
+			break;
+		}
+		case VCMOD_ROW_CALLDRIVER:
+			VCModCallDriver();
+			break;
+		case VCMOD_ROW_CALLCREW:
+			VCModCrewCall();
+			break;
+		case VCMOD_ROW_SKIPRIDE:
+			VCModSkipRide();
+			break;
+		case VCMOD_ROW_KEY:
+			VCModKeyArm(def->key);
+			break;
+		case VCMOD_ROW_KEYRESET:
+			VCModKeyResetAll();
+			break;
+		default:
+			break;
+		}
+		return;
+	}
+
+	nVCModOpenList = VCMOD_LIST_NONE;
+}
+
+bool
+VCModPanelShowing(void)
+{
+	return bVCModPanelOpen;
+}
+
+void
+VCModPanelRender(void)
+{
+	// the debug menu writes these flags directly, so the lifespan pass runs before
+	// either menu draws: a switch flipped there must not wait for a panel click
+	VCModRefreshParticleLifetimes();
+
+	CPad *pad = CPad::GetPad(0);
+	if (pad == nil)
+		return;
+
+	// the debug menu's page column occupies the same corner, so it wins while open
+	if (DebugMenuIsActive()) {
+		// a capture that stops being polled would keep every hotkey suppressed
+		VCModKeyCancel();
+		return;
+	}
+
+	if (!VCModKeyCapturing() &&
+	    ControlsManager.GetIsKeyboardKeyJustDown((RsKeyCodes)aVCModKeys[VCKEY_PANEL]))
+		bVCModPanelOpen = !bVCModPanelOpen;
+	if (!bVCModPanelOpen) {
+		VCModKeyCancel();
+		nVCModOpenList = VCMOD_LIST_NONE;
+		return;
+	}
+
+	RwRenderStateSet(rwRENDERSTATEZTESTENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEZWRITEENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATEVERTEXALPHAENABLE, (void*)TRUE);
+	RwRenderStateSet(rwRENDERSTATESRCBLEND, (void*)rwBLENDSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEDESTBLEND, (void*)rwBLENDINVSRCALPHA);
+	RwRenderStateSet(rwRENDERSTATEFOGENABLE, 0);
+	RwRenderStateSet(rwRENDERSTATECULLMODE, (void*)rwCULLMODECULLNONE);
+
+	RwCamera *cam = RwCameraGetCurrentCamera();
+	if (cam == nil)
+		return;
+	int32 screenW = RwRasterGetWidth(RwCameraGetRaster(cam));
+	int32 screenH = RwRasterGetHeight(RwCameraGetRaster(cam));
+
+	if (aVCModFonts[VCFONT_LABEL] == nil) {
+		VCModMakeFonts();
+		if (aVCModFonts[VCFONT_LABEL] == nil)
+			return;
+	}
+
+	VCModUpdateMouse(pad, screenW, screenH);
+	VCModScroll(pad);
+	VCModClick(pad);
+	// the armed capture runs after the click so a fresh arm waits for its own press
+	VCModKeyPoll();
+
+	int32 rowW = (VCMOD_NAME_COLS + VCMOD_VALUE_COLS) * nVCModCharW;
+	int32 fullCols = rowW / nVCModCharW;
+	VCModCell(VCFONT_TITLE, " VC MODS ", VCMOD_PANEL_X, VCMOD_PANEL_Y, fullCols);
+
+	// the master switch sits at the right end of the title bar, on every page
+	{
+		int32 n = VCModCountOn();
+		int32 style;
+		const char *master;
+		if (n == VCModSwitchedCount()) {
+			style = VCFONT_ON;
+			master = "[ALL ON]";
+		} else if (n == 0) {
+			style = VCFONT_OFF;
+			master = "[ALL OFF]";
+		} else {
+			style = VCFONT_WARN;
+			master = "[MIXED]";
+		}
+		VCModCell(style, master, VCMOD_PANEL_X + rowW - 9 * nVCModCharW, VCMOD_PANEL_Y, 9);
+	}
+
+	for (int32 page = 0; page < NUM_VCMOD_PAGES; page++)
+		VCModCell(page == nVCModPage ? VCFONT_TITLE : VCFONT_OFF,
+			aVCModPageNames[page], VCModTabX(page), VCModTabY(),
+			(int32) strlen(aVCModPageNames[page]));
+
+	// names the checkbox column, so it reads as a switch rather than a bullet
+	VCModCell(VCFONT_HINT, "PERMA", VCMOD_PANEL_X, VCModHeaderY(), VCMOD_PIN_COLS);
+
+	int32 pageRows = VCModPageRowCount(nVCModPage);
+	for (int32 row = 0; row < pageRows; row++) {
+		int32 index = VCModPageRow(nVCModPage, row);
+		if (index < 0)
+			break;
+
+		const VCModRowDef *def = &aVCModRows[index];
+		int32 y = VCModRowY(row);
+		int32 style = VCFONT_OFF;
+		const char *value = "[--]";
+		char holdCell[16];
+		char keyCell[24];
+		bool pinned = VCModRowPinned(def);
+
+		switch (def->kind) {
+		case VCMOD_ROW_FLAG:
+			if (*def->state) {
+				style = VCFONT_ON;
+				value = "[ON]";
+				if (def->state == &bVCModCopPistol) {
+					snprintf(holdCell, sizeof(holdCell), "[ON  f%d]", nVCModCopHoldFrame);
+					value = holdCell;
+				}
+			}
+			break;
+
+		case VCMOD_ROW_ANIMSET:
+			style = VCFONT_SET;
+			value = VCModAnimSetName(nVCModAnimChoice);
+			break;
+
+		case VCMOD_ROW_PEDCAT:
+			style = VCFONT_SET;
+			value = aVCModPedCategoryNames[nVCModPedCategory];
+			break;
+
+		case VCMOD_ROW_PEDCHAR:
+			style = VCFONT_SET;
+			value = VCModCurrentPedLabel();
+			break;
+
+		case VCMOD_ROW_RIDEZONE:
+			style = VCFONT_SET;
+			// auto names the marker or traffic it resolved to, so the row always
+			// says where the driver will go
+			value = VCModRideZoneRowText();
+			break;
+
+		case VCMOD_ROW_RIDESTYLE:
+			style = VCFONT_SET;
+			value = aVCModRideStyleNames[nVCModRideStyle];
+			break;
+
+		case VCMOD_ROW_SPAWN:
+			style = VCFONT_SET;
+			value = "[LIST]";
+			break;
+
+		case VCMOD_ROW_SKIPRIDE: {
+			int32 zoneIndex;
+			bool hasDestination = VCModRideZoneAt(nVCModRideZone, &zoneIndex, nil, nil) && zoneIndex >= 0;
+			style = hasDestination ? VCFONT_SET : VCFONT_WARN;
+			if (hasDestination)
+				value = "[JUMP]  to RIDE TO";
+			else if (nVCModRideZone == VCMOD_RIDE_ZONE_AUTO)
+				value = "[--]  place a map marker";
+			else
+				value = "[--]  pick RIDE TO";
+			break;
+		}
+
+		case VCMOD_ROW_CALLDRIVER:
+			style = VCModRidePhase() == VCMOD_RIDE_NONE ? VCFONT_OFF : VCFONT_ON;
+			value = VCModDriverCell();
+			break;
+
+		case VCMOD_ROW_CREWCAR: {
+			style = VCFONT_SET;
+			value = "car";
+			for (int32 i = 0; i < VCModCrewCarCount(); i++) {
+				int16 model;
+				const char *name;
+				if (VCModCrewCarAt(i, &model, &name) && model == nVCModCrewCar) {
+					value = name;
+					break;
+				}
+			}
+			break;
+		}
+
+		case VCMOD_ROW_CALLCREW:
+			style = VCModCrewPhase() == VCMOD_CREW_NONE ? VCFONT_OFF : VCFONT_ON;
+			value = VCModCrewCell();
+			break;
+
+		case VCMOD_ROW_KEY:
+			if (VCModKeyArmed(def->key)) {
+				style = VCFONT_ON;
+				value = "[PRESS A KEY]";
+			} else {
+				style = VCFONT_SET;
+				VCModKeyName(aVCModKeys[def->key], keyCell, sizeof(keyCell));
+				value = keyCell;
+			}
+			break;
+
+		case VCMOD_ROW_KEYRESET:
+			style = VCFONT_WARN;
+			value = "[RESET]";
+			break;
+
+		case VCMOD_ROW_CYCLE: {
+			int32 mode = def->cycle->get();
+			style = (mode != 0 || def->cycle->selector) ? VCFONT_ON : VCFONT_OFF;
+			value = def->cycle->labels[mode];
+			break;
+		}
+
+		case VCMOD_ROW_PATHPROBE_NODE:
+			style = VCFONT_SET;
+			value = VCModPathProbeNodeCell();
+			break;
+
+		case VCMOD_ROW_PATHPROBE_LANE:
+			style = VCFONT_SET;
+			value = VCModPathProbeLaneCell();
+			break;
+		}
+
+		VCModCell(pinned ? VCFONT_PIN : VCFONT_OFF, pinned ? "[x]" : "[ ]",
+			VCMOD_PANEL_X, y, VCMOD_PIN_COLS);
+		VCModCell(VCFONT_LABEL, def->name, VCMOD_PANEL_X + VCMOD_PIN_COLS*nVCModCharW, y,
+			VCMOD_NAME_COLS - VCMOD_PIN_COLS);
+		VCModCell(style, value, VCMOD_PANEL_X + VCMOD_NAME_COLS*nVCModCharW, y, VCMOD_VALUE_COLS);
+
+		// the affordance that this row opens a list rather than flipping anything
+		int32 rowList = VCModRowList(def->kind);
+		if (rowList != VCMOD_LIST_NONE)
+			VCModPrint(VCFONT_MARK, nVCModOpenList == rowList ? "-" : "+",
+				VCMOD_PANEL_X + rowW + nVCModCharW, y);
+		// a warning badge, inside the value cell so it cannot fall outside the panel
+		if (def->warn != nil)
+			VCModPrint(VCFONT_WARN, "!", VCMOD_PANEL_X + rowW - nVCModCharW, y);
+	}
+
+	if (nVCModOpenList != VCMOD_LIST_NONE) {
+		int32 anchor = nVCModListAnchor;
+		int32 first = VCModListFirst(nVCModOpenList);
+		int32 count = VCModListCount(nVCModOpenList);
+		int32 last = count;
+		if (last > first + VCMOD_LIST_ROWS)
+			last = first + VCMOD_LIST_ROWS;
+
+		for (int32 entry = first; entry < last; entry++) {
+			bool selected = false;
+			const char *label = VCModListLabel(nVCModOpenList, entry, &selected);
+			int32 listY = VCModListRowY(anchor, entry - first);
+			VCModCell(selected ? VCFONT_ON : VCFONT_SET, label, VCModListX(), listY, VCMOD_VALUE_COLS);
+			if (selected)
+				VCModPrint(VCFONT_ON, ">", VCModListX() - nVCModCharW, listY);
+		}
+
+		// the roster is longer than one list, so mark the directions scroll has left
+		if (count > VCMOD_LIST_ROWS) {
+			int32 markX = VCModListX() + VCMOD_VALUE_COLS * nVCModCharW;
+			if (first > 0)
+				VCModPrint(VCFONT_MARK, "^", markX, VCModListRowY(anchor, 0));
+			if (last < count)
+				VCModPrint(VCFONT_MARK, "v", markX, VCModListRowY(anchor, last - first - 1));
+		}
+	}
+
+	// which row the pointer is on, for the help line; computed here so the row
+	// loop stays a plain drawing loop
+	const VCModRowDef *hover = nil;
+	for (int32 row = 0; row < pageRows; row++) {
+		int32 index = VCModPageRow(nVCModPage, row);
+		if (index < 0)
+			break;
+		int32 rowY = VCModRowY(row);
+		if (VCModCursorInRect(fVCModCursorX, fVCModCursorY, VCMOD_PANEL_X, rowY, rowW, nVCModCharH)) {
+			hover = &aVCModRows[index];
+			nVCModHelpRow = index;
+		}
+	}
+
+	// keep showing the last row the pointer was on; a page switch drops it
+	const VCModRowDef *help = hover;
+	if (help == nil && nVCModHelpRow >= 0 && nVCModHelpRow < VCModRowCount()
+	    && aVCModRows[nVCModHelpRow].page == nVCModPage)
+		help = &aVCModRows[nVCModHelpRow];
+
+	int32 y = VCModRowY(VCModMaxPageRows());
+
+	// line 1: what the row does. This reuses the footer line that already
+	// renders, instead of adding a new line above it.
+	char infoLine[128];
+	snprintf(infoLine, sizeof(infoLine), "INFO  %s",
+		help != nil && help->info != nil ? help->info : "point at a row to see what it does");
+	if ((int32) strlen(infoLine) > fullCols)
+		infoLine[fullCols] = '\0';
+	VCModCell(VCFONT_HINT, infoLine, VCMOD_PANEL_X, y, fullCols);
+
+	// line 2: the row's warning, then the global warnings, then the live bindings
+	const char *warn = help != nil ? help->warn : nil;
+	if (warn == nil && bVCModNoScopedAim && !bVCModAimAllWeapons)
+		warn = "sniper needs AIM ALL WEAPONS";
+	if (warn == nil && !bVCModMouseAimLockOn && CCamera::m_bUseMouse3rdPerson)
+		warn = "two-finger hold does nothing";
+	if (warn != nil) {
+		char warnLine[128];
+		snprintf(warnLine, sizeof(warnLine), "! %s", warn);
+		if ((int32) strlen(warnLine) > fullCols)
+			warnLine[fullCols] = '\0';
+		VCModCell(VCFONT_WARN, warnLine, VCMOD_PANEL_X, y + nVCModCharH, fullCols);
+	} else {
+		// the footer names the live bindings, so a rebind shows up here at once
+		char hint[128];
+		char kFire[12], kWalk[12], kDriver[12], kKick[12], kPanel[12];
+		VCModKeyName(aVCModKeys[VCKEY_FIRE], kFire, sizeof(kFire));
+		VCModKeyName(aVCModKeys[VCKEY_WALK], kWalk, sizeof(kWalk));
+		VCModKeyName(aVCModKeys[VCKEY_DRIVER], kDriver, sizeof(kDriver));
+		VCModKeyName(aVCModKeys[VCKEY_KICK], kKick, sizeof(kKick));
+		VCModKeyName(aVCModKeys[VCKEY_PANEL], kPanel, sizeof(kPanel));
+		snprintf(hint, sizeof(hint), "%s fire %s walk %s driver %s spin %s panel",
+			kFire, kWalk, kDriver, kKick, kPanel);
+		if ((int32) strlen(hint) > fullCols)
+			hint[fullCols] = '\0';
+		VCModCell(VCFONT_HINT, hint, VCMOD_PANEL_X, y + nVCModCharH, fullCols);
+	}
+
+	// charset glyphs go through the buffered path, so flush them before the cursor
+	// geometry or the pointer ends up underneath the panel
+	RtCharsetBufferFlush();
+	VCModDrawCursor(cam);
+}
+#endif
diff --git a/src/extras/vcmodpanel.h b/src/extras/vcmodpanel.h
new file mode 100644
index 0000000..07f8dca
--- /dev/null
+++ b/src/extras/vcmodpanel.h
@@ -0,0 +1,44 @@
+#ifndef VCMODPANEL_H
+#define VCMODPANEL_H
+
+#include "AnimManager.h"
+#include "Vector.h"
+
+class CPed;
+class CVehicle;
+
+// Mod switches shared by the debug menu and the on-screen panel. Each feature
+// module owns its own; this header only declares the ones still parked here.
+extern int32 nVCModPedCategory;
+
+// RIDE TO's automatic setting: the pause-map marker while one is placed, traffic
+// otherwise. It is the default, and -1 is also what an ini written by an older
+// build stored for traffic, so such a value now follows the marker.
+#define VCMOD_RIDE_ZONE_AUTO	(-1)
+
+// ride destinations: the list starts on auto, then entry 0 lets traffic drive, the
+// rest are the map zones the game loaded (zone 0 is the whole-map box, so it is
+// never offered) and the pause-map marker closes the list
+int32 VCModRideZoneCount(void);
+// the stored setting behind a list position; auto is the only new one, so every
+// other position maps onto the entry number a saved RideZone already used
+int32 VCModRideZoneValue(int32 position);
+// what a stored setting means right now, as an entry: auto becomes cruise or the
+// marker's own entry
+int32 VCModRideZoneEntry(int32 stored);
+bool VCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos);
+// auto follows a marker that is moved while the car is already driving to it
+bool VCModRideZoneMoved(const CVector &applied);
+// the panel row's value: auto names the point it resolved to
+const char *VCModRideZoneRowText(void);
+
+// every pinned row's current value into the loaded ini; the caller writes the file
+void VCModPersistPinned(void);
+
+#ifdef DEBUGMENU
+void VCModPanelRender(void);
+// the panel is up: the player ped takes no input while a menu owns the screen
+bool VCModPanelShowing(void);
+#endif
+
+#endif
diff --git a/src/extras/vcmodpanelcatalog.cpp b/src/extras/vcmodpanelcatalog.cpp
new file mode 100644
index 0000000..be46c12
--- /dev/null
+++ b/src/extras/vcmodpanelcatalog.cpp
@@ -0,0 +1,505 @@
+#include "common.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "General.h"
+#include "RwHelper.h"
+#include "Pad.h"
+#include "Camera.h"
