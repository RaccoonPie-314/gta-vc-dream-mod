+void
+CAutomobile::DropWheel(uint16 piece, const CVector &impactPos, float impulse)
+{
+	static const int status[4] = {
+		CARWHEEL_FRONT_LEFT, CARWHEEL_FRONT_RIGHT,
+		CARWHEEL_REAR_LEFT, CARWHEEL_REAR_RIGHT
+	};
+	static const int node[4] = { CAR_WHEEL_LF, CAR_WHEEL_RF, CAR_WHEEL_LB, CAR_WHEEL_RB };
+
+	if(GetModelIndex() == MI_RHINO || bTyresDontBurst)
+		return;
+
+	int slot = -1;
+	switch(piece){
+	case CAR_PIECE_WHEEL_LF: slot = 0; break;
+	case CAR_PIECE_WHEEL_RF: slot = 1; break;
+	case CAR_PIECE_WHEEL_LR: slot = 2; break;
+	case CAR_PIECE_WHEEL_RR: slot = 3; break;
+	}
+
+	// a body hit still takes off the wheel nearest the panel that was struck
+	if(slot < 0){
+		if(impactPos.x == 0.0f && impactPos.y == 0.0f && impactPos.z == 0.0f)
+			return;
+		float best = 1.0e10f;
+		for(int i = 0; i < 4; i++){
+			if(Damage.GetWheelStatus(status[i]) == WHEEL_STATUS_MISSING)
+				continue;
+			CVector wheelPos;
+			GetComponentWorldPosition(node[i], wheelPos);
+			float dist = (wheelPos - impactPos).MagnitudeSqr();
+			if(dist < best){
+				best = dist;
+				slot = i;
+			}
+		}
+	}
+
+	if(slot < 0 || Damage.GetWheelStatus(status[slot]) == WHEEL_STATUS_MISSING)
+		return;
+	if(m_aCarNodes[node[slot]] == nil)
+		return;
+
+	Damage.SetWheelStatus(status[slot], WHEEL_STATUS_MISSING);
+
+	SpawnFlyingComponent(node[slot], COMPGROUP_WHEEL);
+
+	// SetComponentVisibility keys off the damage-variant atomic ids; a wheel has
+	// none, so ATOMIC_FLAG_NONE would put it back on screen. Clear the render
+	// flag the same way BlowUpCar does.
+	RpAtomic *atomic = nil;
+	RwFrameForAllObjects(m_aCarNodes[node[slot]], GetCurrentAtomicObjectCB, &atomic);
+	if(atomic)
+		RpAtomicSetFlags(atomic, 0);
+
+	if(GetStatus() == STATUS_SIMPLE){
+		SetStatus(STATUS_PHYSICS);
+		CCarCtrl::SwitchVehicleToRealPhysics(this);
+	}
+
+	DMAudio.PlayOneShot(m_audioEntityId, SOUND_CAR_TYRE_POP, 0.0f);
+	debug("vcm: wheel off (slot %d, piece %d, impulse %.0f)\n", slot, (int)piece, impulse);
+}
+
+void
+CAutomobile::DoHeliBladeCollision(void)
+{
+	if(m_aWheelSpeed[1] <= 0.015f || m_aCarNodes[CAR_BONNET] == nil)
+		return;
+
+	CMatrix mat;
+	mat.Attach(RwFrameGetMatrix(m_aCarNodes[CAR_BONNET]));
+	if(GetModelIndex() == MI_RCRAIDER || GetModelIndex() == MI_RCGOBLIN)
+		DoBladeCollision(mat.GetPosition(), GetMatrix(), ROTOR_TOP, 0.72f, 0.9f);
+	else if(GetModelIndex() == MI_SPARROW || GetModelIndex() == MI_SEASPAR)
+		DoBladeCollision(mat.GetPosition(), GetMatrix(), ROTOR_TOP, 5.15f, 0.8f);
+	else if(GetModelIndex() == MI_HUNTER)
+		DoBladeCollision(mat.GetPosition(), GetMatrix(), ROTOR_TOP, 6.15f, 0.5f);
+	else
+		DoBladeCollision(mat.GetPosition(), GetMatrix(), ROTOR_TOP, 6.15f, 1.0f);
+}
