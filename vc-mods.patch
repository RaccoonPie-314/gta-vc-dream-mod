diff --git a/src/extras/vcmodfiretruck.cpp b/src/extras/vcmodfiretruck.cpp
new file mode 100644
index 0000000..ad9c38b
--- /dev/null
+++ b/src/extras/vcmodfiretruck.cpp
@@ -0,0 +1,40 @@
+#include "common.h"
+
+#include "vcmodfiretruck.h"
+
+bool bVCModFireTruckCannon = true;
+
+// The mod's firetruck hangs the water cannon on the rear-bumper node: an 18 cm
+// pedestal at y 0.97..1.14 with its top at z 1.88, and the barrel mesh turning
+// on it. barrel_dummy marks the muzzle 73 cm ahead of that pivot.
+static const CVector cannonPivot(0.0f, 1.052f, 1.902f);
+static const CVector cannonMuzzle(0.0f, 0.728f, 0.108f);	// from the pivot
+
+CVector
+VCModFireTruckCannonPos(float yaw)
+{
+	// the muzzle swings with the yaw about the pivot, so an aimed jet leaves
+	// the barrel tip instead of the middle of the tower
+	float s = Sin(yaw);
+	float c = Cos(yaw);
+	return cannonPivot + CVector(cannonMuzzle.x*c + cannonMuzzle.y*s,
+	                             cannonMuzzle.y*c - cannonMuzzle.x*s,
+	                             cannonMuzzle.z);
+}
+
+void
+VCModFireTruckCannonAim(RwFrame *frame, float yaw)
+{
+	// the node's own rest orientation is identity; SetRotateZ replaces it, so
+	// the mount position has to be put back afterwards
+	CMatrix m;
+	m.Attach(RwFrameGetMatrix(frame));
+	CVector pos = m.GetPosition();
+	m.SetRotateZ(-yaw);	// negative: +yaw aims the jet to the car's right
+	m.Translate(pos);
+	m.UpdateRW();
+
+	// a parked truck never dirties its clump, so the turn would stay invisible
+	// until it moved; the frame has to schedule its own update
+	RwFrameUpdateObjects(frame);
+}
