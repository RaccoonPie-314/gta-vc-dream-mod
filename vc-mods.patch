+#!/usr/bin/env python3
+"""Firetruck cannon: the player's and the AI driver's water jet start from the
+same point on the model, the model's barrel turns with the aim, and the stock
+pair survives as the off path."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+AUTO = ROOT / "src/vehicles/Automobile.cpp"
+MOD = ROOT / "src/extras/vcmodfiretruck.cpp"
+MOD_H = ROOT / "src/extras/vcmodfiretruck.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class FireTruckCannonTests(unittest.TestCase):
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+
+        self.assertIn('"FIRETRUCK CANNON"', rows)
+        self.assertIn("&bVCModFireTruckCannon", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "FireTruckCannon"', INI.read_text())
+        self.assertIn("extern bool bVCModFireTruckCannon;", MOD_H.read_text())
+
+    def test_both_sites(self):
+        auto = AUTO.read_text()
+        self.assertIn('#include "vcmodfiretruck.h"', auto)
+
+        fire = braced(auto, "CAutomobile::FireTruckControl")
+        # the two cannon sites plus the aim block, all behind the flag
+        self.assertEqual(fire.count("bVCModFireTruckCannon"), 3)
+        # both jets leave the muzzle, which moves with the cannon's yaw
+        self.assertEqual(fire.count("VCModFireTruckCannonPos(m_fCarGunLR)"), 2)
+        # the old split stays reachable, each site keeping its own vector
+        self.assertEqual(fire.count("CVector(0.0f, 1.5f, 1.9f)"), 1)
+        self.assertEqual(fire.count("CVector(0.0f, 0.0f, 2.2f)"), 1)
+
+    def test_arrow_aim(self):
+        fire = braced(AUTO.read_text(), "CAutomobile::FireTruckControl")
+        # a keyboard has no D-pad and no right stick, so the stock accessors
+        # read zero; the arrows have to be added on top
+        self.assertIn("GetCarGunLeftRight()", fire)
+        self.assertIn("GetCarGunUpDown()", fire)
+        self.assertIn("pad->GetRight() - pad->GetLeft()", fire)
+        self.assertIn("pad->GetUp() - pad->GetDown()", fire)
+        # same rates as the stock stick path
+        self.assertIn("gunLR * 0.00025f", fire)
+        self.assertIn("gunUD * 0.0001f", fire)
+
+    def test_mount(self):
+        mod = MOD.read_text()
+        self.assertIn("bool bVCModFireTruckCannon = true;", mod)
+        # the mod's model pivots the cannon on the rear-bumper node at this
+        # point, with barrel_dummy 73 cm ahead of it
+        self.assertIn("CVector cannonPivot(0.0f, 1.052f, 1.902f)", mod)
+        self.assertIn("CVector cannonMuzzle(0.0f, 0.728f, 0.108f)", mod)
+        # an aimed jet leaves the muzzle instead of the tower's middle
+        self.assertIn("cannonMuzzle.x*c + cannonMuzzle.y*s", mod)
+        self.assertIn("cannonMuzzle.y*c - cannonMuzzle.x*s", mod)
+
+    def test_barrel_follows_aim(self):
+        pre = braced(AUTO.read_text(), "CAutomobile::PreRender")
+        self.assertIn("GetModelIndex() == MI_FIRETRUCK", pre)
+        self.assertIn("bVCModFireTruckCannon", pre)
+        self.assertIn("VCModFireTruckCannonAim(m_aCarNodes[CAR_BUMP_REAR], m_fCarGunLR)", pre)
+
+        mod = MOD.read_text()
+        # +yaw aims right, and SetRotateZ turns the other way round
+        self.assertIn("m.SetRotateZ(-yaw);", mod)
+        # a parked truck never dirties its clump on its own
+        self.assertIn("RwFrameUpdateObjects(frame);", mod)
+        # the node's own rest orientation is replaced, so keep its position
+        self.assertIn("m.Translate(pos);", mod)
+
+
+if __name__ == "__main__":
+    unittest.main()
