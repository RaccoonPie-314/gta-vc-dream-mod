+#!/usr/bin/env python3
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def run_cpp(source):
+    with tempfile.TemporaryDirectory(prefix="vc-adrenaline-test-") as directory:
+        cpp = Path(directory) / "test.cpp"
+        binary = Path(directory) / "test"
+        cpp.write_text(source)
+        subprocess.run(["c++", "-std=c++98", "-Wall", "-Wextra", str(cpp), "-o", str(binary)], check=True)
+        subprocess.run([str(binary)], check=True)
+
+
+class AdrenalineTests(unittest.TestCase):
+    def test_native_adrenaline_lifecycle(self):
+        source = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+        panel = (ROOT / "src/extras/vcmodpanel.cpp").read_text()
+        self.assertIn("VCModUpdateAdrenaline(CPlayerPed *player)", source)
+        definitions = "\n".join(re.findall(r"^bool bVCModAdrenaline\w*[^;]*;", panel, re.M))
+        state = "\n".join(re.findall(r"^static [^\n;]*VCModAdrenaline[^\n;]*;", source, re.M))
+        clear = braced(source, "void\nCPlayerPed::ClearAdrenaline(void)")
+        update = braced(source, "static void\nVCModUpdateAdrenaline(CPlayerPed *player)")
+        stamina = braced(source, "void\nCPlayerPed::UseSprintEnergy(void)")
+        replay = (ROOT / "src/control/Replay.cpp").read_text()
+        store = braced(replay, "void CReplay::StoreStuffInMem(void)")
+        replay_hook = "\n".join(line for line in store.splitlines() if "VCModSuspendAdrenaline();" in line)
+        suspend_marker = "void\nVCModSuspendAdrenaline(void)"
+        suspend = braced(source, suspend_marker) if suspend_marker in source else ""
+        movement = braced(source, "void\nCPlayerPed::SetRealMoveAnim(void)")
+        movement = movement[movement.index("\tif (m_bAdrenalineActive) {"):]
+        run_cpp(r'''
+#include <cstdio>
+#include <cstdlib>
+#include <stdint.h>
+#define nil NULL
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+typedef uint32_t uint32;
+enum AnimationId { ANIM_STD_STARTWALK, ANIM_STD_WALK, ANIM_STD_RUN, ANIM_STD_RUNFAST };
+enum PedState { PED_IDLE, PED_DIE, PED_DEAD, PED_ARRESTED, PED_DRIVING };
+struct CAnimBlendAssociation { float speed; };
+struct CTimer {
+    static float scale;
+    static uint32 now;
+    static float GetTimeScale() { return scale; }
+    static void SetTimeScale(float value) { scale = value; }
+    static uint32 GetTimeInMilliseconds() { return now; }
+    static float GetTimeStep() { return 1.0f; }
+};
+float CTimer::scale = 1.0f;
+uint32 CTimer::now = 1000;
+struct CPad {
+    bool disabled;
+    bool ArePlayerControlsDisabled() { return disabled; }
+};
+CPad pad = { false };
+struct CCutsceneMgr {
+    static bool running;
+    static bool IsRunning() { return running; }
+};
+bool CCutsceneMgr::running = false;
+struct CReplay {
+    static bool playing;
+    static bool IsPlayingBack() { return playing; }
