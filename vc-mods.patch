+#!/usr/bin/env python3
+"""Two-hand colt: the pose selection on its own, plus static checks that the
+fire loop looks up the clip SetAttack blended."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+PEDFIGHT = ROOT / "src/peds/PedFight.cpp"
+COMBAT = ROOT / "src/extras/vcmodcombat.cpp"
+PED = ROOT / "src/peds/Ped.cpp"
+PLAYER = ROOT / "src/peds/PlayerPed.cpp"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+
+PRELUDE = r'''
+#include <stdio.h>
+typedef int AnimationId;
+typedef int uint32;
+#define nil 0
+enum {
+    ANIM_WEAPON_FIRE = 1,
+    ANIM_WEAPON_FIRE_3RD = 5,
+    WEAPONFLAG_COP3_RD = 1 << 18
+};
+enum { PED_IDLE, PED_ATTACK, PED_AIM_GUN };
+bool bVCModCopPistol = true;
+bool bVCModCopRecovering = false;
+
+struct CWeaponInfo {
+    uint32 m_Flags;
+    bool IsFlagSet(uint32 flag) const { return (m_Flags & flag) != 0; }
+    AnimationId GetFireAnimNotDucking() const { return ANIM_WEAPON_FIRE; }
+};
+
+struct CPed {
+    bool bPlayer, bCop;
+    int m_nPedState;
+    bool IsPlayer() const { return bPlayer; }
+    AnimationId GetFireAnimNotDucking(CWeaponInfo *weapon) const {
+        if (bCop && weapon->IsFlagSet(WEAPONFLAG_COP3_RD))
+            return Get3rdFireAnim(weapon);
+        return ANIM_WEAPON_FIRE;
+    }
+    static AnimationId Get3rdFireAnim(CWeaponInfo *weapon) {
+        return weapon->IsFlagSet(WEAPONFLAG_COP3_RD) ? ANIM_WEAPON_FIRE_3RD : (AnimationId)0;
+    }
+};
+
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    CPed player = { true, false };
+    CPed cop = { false, true };
+    CWeaponInfo colt = { WEAPONFLAG_COP3_RD };
+    CWeaponInfo uzi = { 0 };
+
+    bVCModCopPistol = true;
+    CHECK(VCModCopTwoHandPose(&player, &colt), "the two-hand row owns the player's colt");
+    CHECK(VCModCopFireAnim(&player, &colt) == ANIM_WEAPON_FIRE_3RD,
+          "the two-hand player fires the cop clip");
+    CHECK(VCModCopAimAnim(&player, &colt) == ANIM_WEAPON_FIRE_3RD,
+          "the two-hand player holds the cop clip");
+
+    bVCModCopPistol = false;
+    CHECK(!VCModCopTwoHandPose(&player, &colt), "the row off releases the player's colt");
+    CHECK(VCModCopFireAnim(&player, &colt) == ANIM_WEAPON_FIRE,
+          "the player keeps the stock clip when the row is off");
+    CHECK(VCModCopAimAnim(&player, &colt) == ANIM_WEAPON_FIRE,
+          "the player holds the stock clip when the row is off");
+    CHECK(VCModCopFireAnim(&cop, &colt) == ANIM_WEAPON_FIRE_3RD,
+          "cops keep the cop clip");
+    CHECK(VCModCopFireAnim(&cop, &uzi) == ANIM_WEAPON_FIRE,
+          "cops keep the stock clip for weapons without the flag");
+
+    bVCModCopPistol = true;
+    CHECK(!VCModCopTwoHandPose(&player, &uzi), "another gun keeps its own pose");
+
+    player.m_nPedState = PED_ATTACK;
+    CHECK(VCModCopTwoHandFiring(&player, &colt), "the shot stands the player still");
+    CHECK(!VCModCopTwoHandFiring(&player, &uzi), "another gun keeps its movement");
+    player.m_nPedState = PED_AIM_GUN;
+    CHECK(!VCModCopTwoHandFiring(&player, &colt), "the parked hold is not the shot");
+    bVCModCopRecovering = true;
+    CHECK(VCModCopTwoHandFiring(&player, &colt), "the lowering tail is still the shot");
+    bVCModCopRecovering = false;
+    CHECK(!VCModCopTwoHandFiring(&cop, &colt), "cops keep their own movement");
+    bVCModCopPistol = false;
+    player.m_nPedState = PED_ATTACK;
+    CHECK(!VCModCopTwoHandFiring(&player, &colt), "the row off keeps stock movement");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(text, name):
+    match = re.search(r"(?m)^(?:static\s+)?(?:bool|AnimationId)\s*\n" + re.escape(name) + r"\(", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {COMBAT}")
+    opening = text.index("{", match.end())
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[match.start():i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
