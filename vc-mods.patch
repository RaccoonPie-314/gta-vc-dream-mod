+#include "AnimBlendAssociation.h"
+#include "AnimBlendHierarchy.h"
+#include "ModelInfo.h"
+#include "PedModelInfo.h"
+#include "ModelIndices.h"
+#include "Ped.h"
+#include "PlayerPed.h"
+#include "World.h"
+#include "PedType.h"
+#include "Streaming.h"
+#include "Directory.h"
+#include "Zones.h"
+#include "Radar.h"
+#include "main.h"
+#include "vcmodpanel.h"
+#include "vcmodpanelinternal.h"
+#include "vcmodcharacter.h"
+#include "vcmodcombat.h"
+#include "vcmodadrenaline.h"
+#include "vcmodsit.h"
+#include "vcmodstreet.h"
+#include "vcmodnpc.h"
+#include "vcmodride.h"
+#include "vcmodplayer.h"
