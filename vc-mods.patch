+
+class CEntity;
+class CVector;
+
+// The stock car camera is a cam on a string: it trails the car and only swings
+// back when the car is nearly facing it, so there is no way to look around while
+// driving. This gives the mouse (and the right stick) the yaw and pitch for as
+// long as it keeps moving, then eases back to directly behind the car, a framing
+// the string camera takes over without a jump.
+void VCModDriveCamTick(CEntity *target, int16 mode);
+
+// True while the orbit owns the camera's yaw; the stock behind-the-car fix has
+// to stay out of the way while it does.
+bool VCModDriveCamBusy(void);
+
+// Swings source around target to the orbit angle, keeping its distance. Returns
+// false and leaves source alone when the orbit is not engaged.
+bool VCModDriveCamOrbit(CVector &source, const CVector &target, float carHeading, float radius);
+
+// The camera height the stock mode would use, plus the orbit pitch. Returns
+// stock untouched when the orbit is not engaged.
+float VCModDriveCamElevation(float stock);
+
+#endif
