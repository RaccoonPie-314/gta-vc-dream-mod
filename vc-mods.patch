+
+#include <stddef.h>
+
+class CPlayerInfo;
+
+// The original's small rough edges. One master switch, one flag per behaviour,
+// so the panel can turn the lot off and each item can still be isolated in the ini.
+extern bool bVCModVanillaFixes;
+extern bool bVCModHudCleanup;
+extern bool bVCModKeepWheelAngle;
+extern bool bVCModExitHoldOff;
+extern bool bVCModLongerFx;
+
+// "$42" instead of "$00000042"; the sign is kept when the balance is negative
+void VCModFormatMoney(char *out, size_t size, int32 money);
+// false only when no wanted level is showing and none is pending: the empty
+// slot outlines are what the cleanup hides, never the bright or flashing ones
+bool VCModWantedSlotVisible(int32 level, int32 minLevel, int32 slot);
+// wrap-safe elapsed test for the exit hold; the caller owns the armed state
+bool VCModExitHoldElapsed(uint32 now, uint32 since, uint32 threshold);
