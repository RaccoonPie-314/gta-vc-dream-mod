+#!/usr/bin/env python3
+"""Strong Tommy: civilian NPC mode wearing his own body.
+
+Every stock ped's personality is its model's CPedStats line from pedstats.dat
+(fear, temper, flags). The mod's body selector flattens every worn body to
+PEDSTAT_PLAYER, so the civilian profile now borrows the worn model's own stat
+while it drives him, and MI_PLAYER answers with a mod strong variant: the
+player's stock numbers, fear 0 and temper 100 (so every stock threshold picks
+the fight branch and other peds flinch from a bump), gun panic cleared. The
+shared PLAYER stat is never modified.
+
+The reaction gates for the strong variant are pinned from the sources at the
+bottom: gunshot -> fight, fresh corpse and explosion -> investigate, attacked ->
+no flee-on-foot, seated threat -> keep the seat.
+"""
+import re
+import unittest
+from pathlib import Path
+
+from vcmod_test_support import braced, run_cpp
+
+ROOT = Path(__file__).resolve().parents[1]
+PLAYER = (ROOT / "src/peds/PlayerPed.cpp").read_text()
+NPC = (ROOT / "src/extras/vcmodnpc.cpp").read_text()
+PED = (ROOT / "src/peds/Ped.cpp").read_text()
+PEDAI = (ROOT / "src/peds/PedAI.cpp").read_text()
+
+STUBS = r'''
+#include <cstdio>
+#include <cstring>
+#include <cstdint>
+#define nil NULL
+typedef int32_t int32;
+
+enum { NUM_PEDSTATS = 4, PEDSTAT_PLAYER = 0, PEDSTAT_BODY = 2 };
+enum { STAT_CAN_KICK = 4, STAT_GUN_PANIC = 0x80 };
+enum { MITYPE_PED = 1, MITYPE_OTHER = 2 };
+enum { MI_PLAYER = 0, MI_BODY = 1, MI_NOT_A_PED = 2 };
+
+struct CPedStats {
+    int m_type;
+    char m_name[8];
+    float m_fleeDistance;
+    float m_headingChangeRate;
+    int8_t m_fear;
+    int8_t m_temper;
+    int8_t m_lawfulness;
+    int8_t m_sexiness;
+    float m_attackStrength;
+    float m_defendWeakness;
+    int16_t m_flags;
+    static CPedStats *ms_apPedStats[NUM_PEDSTATS];
+};
+CPedStats *CPedStats::ms_apPedStats[NUM_PEDSTATS];
+
+struct CBaseModelInfo {
+    int m_type;
+    int GetModelType(void) { return m_type; }
+};
+struct CPedModelInfo : CBaseModelInfo {
+    int m_pedStatType;
+};
+static CBaseModelInfo g_notAPed;
+static CPedModelInfo g_bodyInfo;
+
+struct CModelInfo {
+    static CBaseModelInfo *GetModelInfo(int model) {
+        if (model == MI_BODY) return &g_bodyInfo;
+        if (model == MI_NOT_A_PED) return &g_notAPed;
+        return nil;
+    }
+};
+
+struct CPlayerPed {
+    int m_modelIndex;
+    int GetModelIndex(void) { return m_modelIndex; }
+};
+static CPlayerPed g_player;
+
+struct CPedType {};
+'''
+
+STATICS = r'''
+bool bVCModNpcMode;
+int32 nVCModNpcType;
+enum { VCMOD_NPC_GANG, VCMOD_NPC_CIVILIAN, VCMOD_NPC_COP };
+static CPlayerPed *FindPlayerPed(void) { return &g_player; }
+'''
+
+SIGS = [
+    "static CPedStats *\nVCModNpcStrongStats(void)",
+    "static CPedStats *\nVCModNpcCivilianBodyStats(CPlayerPed *player)",
+    "bool\nVCModNpcStrongActive(void)",
+]
+
+
+def strong_source():
+    return STUBS + STATICS + "\n".join(braced(NPC, s) for s in SIGS) + "\n"
+
+
+SETUP = r'''
+    for (int i = 0; i < NUM_PEDSTATS; i++) {
+        CPedStats::ms_apPedStats[i] = new CPedStats();
+        CPedStats::ms_apPedStats[i]->m_type = i;
+        CPedStats::ms_apPedStats[i]->m_fear = 50;
+        CPedStats::ms_apPedStats[i]->m_temper = 50;
+        CPedStats::ms_apPedStats[i]->m_flags = STAT_CAN_KICK;
+        CPedStats::ms_apPedStats[i]->m_attackStrength = 1.0f;
+        CPedStats::ms_apPedStats[i]->m_defendWeakness = 1.0f;
+    }
+    CPedStats::ms_apPedStats[PEDSTAT_PLAYER]->m_attackStrength = 3.0f;
+    CPedStats::ms_apPedStats[PEDSTAT_PLAYER]->m_defendWeakness = 0.4f;
+    CPedStats::ms_apPedStats[PEDSTAT_BODY]->m_fear = 30;
+    CPedStats::ms_apPedStats[PEDSTAT_BODY]->m_temper = 70;
+    g_bodyInfo.m_type = MITYPE_PED;
+    g_bodyInfo.m_pedStatType = PEDSTAT_BODY;
+    g_notAPed.m_type = MITYPE_OTHER;
+    g_player.m_modelIndex = MI_PLAYER;
+    bVCModNpcMode = true;
+    nVCModNpcType = VCMOD_NPC_CIVILIAN;
+'''
+
+
+class StrongStatTests(unittest.TestCase):
+    def test_tommys_body_gets_the_strong_variant(self):
+        run_cpp(strong_source() + r'''
+int main(void) {
+''' + SETUP + r'''
+    CPlayerPed *player = &g_player;
+    CPedStats *s = VCModNpcCivilianBodyStats(player);
+    if (s == CPedStats::ms_apPedStats[PEDSTAT_PLAYER]) return 1;  // never the shared line
+    if (s->m_fear != 0) return 2;           // never flees or cowers
+    if (s->m_temper != 100) return 3;       // others flinch from a bump, fights back
+    if (s->m_flags & STAT_GUN_PANIC) return 4;
+    if (!(s->m_flags & STAT_CAN_KICK)) return 5;  // every other stock bit stays
+    if (s->m_attackStrength != 3.0f) return 6;    // the player's own melee numbers
+    if (s->m_defendWeakness != 0.4f) return 7;
+    return 0;
+}
+''')
+
+    def test_every_other_body_answers_with_its_stock_stat(self):
+        run_cpp(strong_source() + r'''
+int main(void) {
+''' + SETUP + r'''
+    CPlayerPed *player = &g_player;
+    player->m_modelIndex = MI_BODY;
+    CPedStats *s = VCModNpcCivilianBodyStats(player);
+    if (s != CPedStats::ms_apPedStats[PEDSTAT_BODY]) return 1;
+    if (s->m_fear != 30 || s->m_temper != 70) return 2;  // untouched stock numbers
+    return 0;
+}
+''')
+
+    def test_a_model_without_a_usable_stat_falls_back_to_the_player_line(self):
+        run_cpp(strong_source() + r'''
+int main(void) {
+''' + SETUP + r'''
+    CPlayerPed *player = &g_player;
+    player->m_modelIndex = MI_NOT_A_PED;
+    if (VCModNpcCivilianBodyStats(player) != CPedStats::ms_apPedStats[PEDSTAT_PLAYER]) return 1;
+    player->m_modelIndex = 99;                    // no model info at all
+    if (VCModNpcCivilianBodyStats(player) != CPedStats::ms_apPedStats[PEDSTAT_PLAYER]) return 2;
+    g_bodyInfo.m_pedStatType = NUM_PEDSTATS;      // stat index out of range
+    player->m_modelIndex = MI_BODY;
+    if (VCModNpcCivilianBodyStats(player) != CPedStats::ms_apPedStats[PEDSTAT_PLAYER]) return 3;
+    return 0;
+}
+''')
+
+    def test_strong_predicate_reads_mode_profile_and_body(self):
+        run_cpp(strong_source() + r'''
+int main(void) {
+''' + SETUP + r'''
+    if (!VCModNpcStrongActive()) return 1;
+    g_player.m_modelIndex = MI_BODY;
+    if (VCModNpcStrongActive()) return 2;        // other bodies keep stock behavior
+    g_player.m_modelIndex = MI_PLAYER;
+    nVCModNpcType = VCMOD_NPC_GANG;
+    if (VCModNpcStrongActive()) return 3;        // gang stays a Vercetti
+    nVCModNpcType = VCMOD_NPC_CIVILIAN;
+    bVCModNpcMode = false;
+    if (VCModNpcStrongActive()) return 4;        // normal play is untouched
+    return 0;
+}
+''')
+
+
+class StrongReactionWiring(unittest.TestCase):
+    """The stock decision sites carry the strong exception, not a parallel AI."""
+
+    def test_gunshot_threat_fights_the_shooter(self):
+        ai = braced(PED, "CPed::CivilianAI")
+        strong = ai.index("IsPlayer() && VCModNpcStrongActive()")
+        fight = ai.index("SetObjective(OBJECTIVE_KILL_CHAR_ON_FOOT, m_threatEntity);", strong)
+        fear = ai.index("m_pedStats->m_temper <= m_pedStats->m_fear", strong)
+        self.assertLess(strong, fight)
+        self.assertLess(fight, fear)   # ahead of the stock fear chain
+
+    def test_corpse_is_investigated_not_fled(self):
+        ai = braced(PED, "CPed::CivilianAI")
+        self.assertIn("eventDistSqr > sq(5.0f) || (IsPlayer() && VCModNpcStrongActive())", ai)
+
+    def test_explosion_is_investigated(self):
+        ai = braced(PED, "CPed::CivilianAI")
+        block = ai[ai.index("else if (eventDistSqr < sq(20.0f))"):]
+        self.assertIn("VCModNpcStrongActive()", block)
+        self.assertIn("SetInvestigateEvent(EVENT_EXPLOSION", block)
+
+    def test_attack_never_takes_the_flee_branch(self):
+        react = braced(PEDAI, "CPed::ReactToAttack")
+        self.assertTrue(re.search(
+            r"!attackerPed->GetWeapon\(\)->IsTypeMelee\(\) && GetWeapon\(\)->IsTypeMelee\(\)\s*\n\s*&& !\(IsPlayer\(\) && VCModNpcStrongActive\(\)\)",
+            react))
+
+    def test_seated_threat_does_not_stand_him_up_to_run(self):
+        self.assertTrue(re.search(
+            r"threatFlag == PED_FLAG_GUN \|\| threatFlag == PED_FLAG_EXPLOSION \|\| threatFlag == PED_FLAG_DEADPEDS\)\s*\n\s*&& !\(IsPlayer\(\) && VCModNpcStrongActive\(\)\)",
+            PED))
+
+
+if __name__ == "__main__":
+    unittest.main()
