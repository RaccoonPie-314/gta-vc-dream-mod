+#include "vcmodpathprobe.h"
+#include "vcmodtraffic.h"
+#include "vcmodqol.h"
+#include "vcmodreload.h"
+#include "vcmodcopcover.h"
+#include "vcmodwheel.h"
+#include "vcmodrotor.h"
+#include "vcmodshootable.h"
+#include "vcmodexplosion.h"
+#include "vcmodfbilights.h"
+#include "vcmodfiretruck.h"
+#include "vcmodsteering.h"
+#include "vcmodlighttex.h"
+#include "vcmodfirstperson.h"
+#include "vcmodspawn.h"
+#include "vcmoddiag.h"
+
+int32 nVCModPedCategory;
+
+const char *aVCModRideStyleNames[] = {
+	"safe (traffic law)", "fast & aggressive"
+};
+
+const char *aVCModPedCategoryNames[] = { "cops", "gangs", "civilians", "mission" };
+
+// gxt names are 16 bit and the panel charset fonts take bytes, so the zone label
+// has to be narrowed before it can be drawn
+static char aVCModZoneLabel[32];
+
+// how far the pause-map marker has to move before auto treats it as a new
+// destination, so a shaky placement does not re-route the car every frame
+#define VCMOD_RIDE_RETARGET_NEAR	25.0f
+
+static const char *
+VCModZoneLabel(CZone *zone)
+{
+	wchar *name = zone->GetTranslatedName();
+	int32 i;
+	for (i = 0; i < (int32) sizeof(aVCModZoneLabel) - 1 && name != nil && name[i] != 0; i++)
+		aVCModZoneLabel[i] = (char) name[i];
+	aVCModZoneLabel[i] = '\0';
+	return aVCModZoneLabel;
+}
+
+int32
+VCModRideZoneCount(void)
+{
+	// the list opens on auto, entry 0 after it is cruise with traffic, the next
+	// ones are every map zone but the whole-map box, and the marker is last
+	return (int32) CTheZones::GetNumberOfMapZones() + 2;
+}
+
+int32
+VCModRideZoneValue(int32 position)
+{
+	// the list is one longer than the stored entries and only the first slot is
+	// new: position n stores n-1, so a RideZone saved by an older build still
+	// selects the same place and only traffic has to be read as auto
+	if (position <= 0)
+		return VCMOD_RIDE_ZONE_AUTO;
+	return position - 1;
+}
+
+int32
+VCModRideZoneEntry(int32 stored)
+{
+	// auto is read here, once, so the panel and both drivers agree on where a
+	// marker that was just placed puts the car
+	if (stored != VCMOD_RIDE_ZONE_AUTO)
+		return stored;
+	return CRadar::TargetMarkerId == -1 ? 0 : (int32) CTheZones::GetNumberOfMapZones();
+}
+
+bool
+VCModRideZoneMoved(const CVector &applied)
+{
+	// only auto is live: a zone picked by hand and the marker picked by hand are
+	// both fixed points, and re-routing them would be a surprise
+	if (nVCModRideZone != VCMOD_RIDE_ZONE_AUTO || CRadar::TargetMarkerId == -1)
+		return false;
+	return (CRadar::TargetMarkerPos - applied).Magnitude2D() > VCMOD_RIDE_RETARGET_NEAR;
+}
+
+const char *
+VCModRideZoneRowText(void)
+{
+	static char text[40];
+
+	if (nVCModRideZone == VCMOD_RIDE_ZONE_AUTO) {
+		// name what auto resolved to, so the row says where the driver will go
+		// without the list having to be opened
+		snprintf(text, sizeof(text), "auto: %s",
+			CRadar::TargetMarkerId == -1 ? "traffic" : "map marker");
+		return text;
+	}
+
+	const char *name = nil;
+	if (VCModRideZoneAt(nVCModRideZone, nil, &name, nil) && name != nil)
+		return name;
+	return "traffic (cruise)";
+}
+
+bool
+VCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos)
+{
+	entry = VCModRideZoneEntry(entry);
+	if (entry < 0 || entry > (int32) CTheZones::GetNumberOfMapZones())
+		return false;
+
+	if (entry == 0) {
+		if (outZoneIndex != nil)
+			*outZoneIndex = -1;
+		if (outName != nil)
+			*outName = "traffic (cruise)";
+		return true;
+	}
+
+	// the pause-map marker is the last entry; the name is filled before the point
+	// test so the menu can still name a choice the player has not placed yet
+	if (entry == (int32) CTheZones::GetNumberOfMapZones()) {
+		if (outName != nil)
+			*outName = "map marker";
+		// unplaced, it has no point: refusing here keeps the ride on traffic
+		// instead of driving it at the map origin
+		if (CRadar::TargetMarkerId == -1)
+			return false;
+		if (outZoneIndex != nil)
+			*outZoneIndex = entry;
+		if (outPos != nil)
+			*outPos = CRadar::TargetMarkerPos;
+		return true;
+	}
+
+	// zone 0 is "THEMAP", so the list is offset by one
+	CZone *zone = CTheZones::GetMapZone((uint16) entry);
+	if (zone == nil)
+		return false;
+
+	if (outZoneIndex != nil)
+		*outZoneIndex = entry;
+	if (outName != nil)
+		*outName = VCModZoneLabel(zone);
+	if (outPos != nil) {
+		outPos->x = (zone->minx + zone->maxx) * 0.5f;
+		outPos->y = (zone->miny + zone->maxy) * 0.5f;
+		outPos->z = 0.0f;
+	}
+	return true;
+}
+
+#ifdef DEBUGMENU
+int32
+VCModListCount(int32 list)
+{
+	switch (list) {
+	case VCMOD_LIST_ANIM:	return NUM_VCMOD_ANIM_SETS;
+	case VCMOD_LIST_PEDCAT:	return NUM_VCMOD_PEDCATS;
+	case VCMOD_LIST_RIDEZONE:	return VCModRideZoneCount();
+	case VCMOD_LIST_RIDESTYLE:	return NUM_VCMOD_RIDE_STYLES;
+	case VCMOD_LIST_CREWCAR:	return VCModCrewCarCount();
+	case VCMOD_LIST_SPAWN:		return VCModSpawnCount();
+	}
+	return VCModPedModelCount(nVCModPedCategory);
+}
+
+// the character being worn right now is the whole state, so the panel reads it
+// off the ped instead of keeping a second copy of the choice
+static int16
+VCModCurrentPedModel(void)
+{
+	CPlayerPed *player = FindPlayerPed();
+	if (player == nil)
+		return MI_PLAYER;
+	return player->GetModelIndex();
+}
+
+// The model table names bodies the way the IDE does (hfyst, wmybu), which says
+// nothing to someone picking a character. These are the ones worth spelling out;
+// the rest decode from the same letters the IDE uses.
+static const struct {
+	const char *model;
+	const char *label;
+} aVCModPedNames[] = {
+	// cops and emergency services
+	{ "cop", "Cop" },
