+#ifndef VCMODCREW_H
+#define VCMODCREW_H
+
+#include "Vector.h"
+
+class CVehicle;
+class CPed;
+
+enum eVCModCrewPhase
+{
+	VCMOD_CREW_NONE,
+	VCMOD_CREW_APPROACH,
+	VCMOD_CREW_PICKUP,
+	VCMOD_CREW_SWAP,
+	VCMOD_CREW_ABOARD,
+	VCMOD_CREW_ESCORT,
+	VCMOD_CREW_DISMISS_WAIT
+};
+
+// the car the crew comes in, as a model index; the ini seeds it, the panel owns it
+extern int32 nVCModCrewCar;
+// off: the ride after the pick-up drives like traffic. On: fast, through red
+// lights, steering round cars instead of queueing. Live during a ride.
+extern bool bVCModCrewAggressive;
+
+// every four-door car this install loads, by model name
+int32 VCModCrewCarCount(void);
+bool VCModCrewCarAt(int32 entry, int16 *outModel, const char **outName);
+// a saved car that is not on the shelf falls back to the Admiral
+void VCModCrewCarValidate(void);
+
+int32 VCModCrewPhase(void);
+CVehicle *VCModCrewVehicle(void);
+bool VCModCrewOwnsCar(CVehicle *vehicle);
+// true for the three men the crew summoned; they keep their own gang animations
+bool VCModCrewOwnsPed(CPed *ped);
+// the run-in is late for its passenger; the ride itself obeys the lights
+bool VCModCrewIgnoresLights(CVehicle *vehicle);
+// takes over an enter-vehicle press on the crew car; false means the press is
+// the game's and the stock driver entry or carjack should happen
+bool VCModCrewEntry(CVehicle *vehicle);
+// calls the crew, or dismisses one already out
+void VCModCrewCall(void);
+// once per frame while a crew exists
+void VCModCrewUpdate(void);
+// hands the crew to the street the moment Tommy dies
+void VCModCrewPlayerDied(void);
+
+#endif
