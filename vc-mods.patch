+#!/usr/bin/env python3
+"""Car light glow: the stock bright-light is a translucent box drawn around
+each lamp. Up close it reads as a cube of light over the bodywork, so it now
+fades out at arm's length while the far-distance glow is unchanged."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+FX = ROOT / "src/renderer/SpecialFX.cpp"
+
+
+class CarLightGlowTests(unittest.TestCase):
+    def test_box_fades_before_the_camera(self):
+        fx = FX.read_text()
+        self.assertIn("#define CARLIGHTS_BOX_OFF_DIST (8.0f)", fx)
+        self.assertIn("if(aBrightLights[i].m_camDist < CARLIGHTS_BOX_OFF_DIST)\n\t\t\t\ta = 0;", fx)
+        # 0 at the near cutoff, 31 where the stock ramp starts, 255 at the far one
+        self.assertIn("a = 31*(aBrightLights[i].m_camDist-CARLIGHTS_BOX_OFF_DIST)"
+                      "/(CARLIGHTS_FADE_DIST-CARLIGHTS_BOX_OFF_DIST);", fx)
+        self.assertIn("31 + (255-31)*((aBrightLights[i].m_camDist-CARLIGHTS_FADE_DIST)"
+                      "/(CARLIGHTS_MAX_DIST-CARLIGHTS_FADE_DIST))", fx)
+
+    def test_only_the_car_light_types_fade(self):
+        fx = FX.read_text()
+        start = fx.index("// fade car lights down as they come near")
+        block = fx[start:fx.index("switch(aBrightLights[i].m_type)", start)]
+        self.assertIn("BRIGHTLIGHT_FRONT_LONG && aBrightLights[i].m_type <= BRIGHTLIGHT_REAR_TALL", block)
+        # traffic lights and sirens keep their own alpha
+        self.assertNotIn("BRIGHTLIGHT_TRAFFIC", block)
+        self.assertNotIn("BRIGHTLIGHT_SIREN", block)
+
+
+if __name__ == "__main__":
+    unittest.main()
