+                            "style", "drive", "pickup", "entry", "update") + r'''
+void sit(CVehicle &veh) {
+    playerPed.bInVehicle = true; playerPed.m_pMyVehicle = &veh;
+    playerPed.m_objective = OBJECTIVE_NONE; playerPed.m_carInObjective = nil;
+    playerPed.m_nPedState = PED_DRIVING;
+    veh.pDriver = &driverPed;
+}
+void beginRide(CVehicle &veh, int32 zone) {
+    reset(veh);
+    veh.pDriver = &driverPed;
+    nVCModRideZone = zone;
+    check(VCModPassengerEntry(&veh), "ride armed");
+    events.clear();
+}
+/* boarding takes one frame to notice the seat, then the next one routes */
+void seated(CVehicle &veh) {
+    sit(veh);
+    VCModUpdateRide(&playerPed);
+    VCModUpdateRide(&playerPed);
+}
+int main() {
+    CVehicle veh;
+
+    reset(veh);
+    VCModUpdateRide(&playerPed);
+    check(events.empty(), "no ride means nothing to update");
+
+    beginRide(veh, -1);
+    VCModUpdateRide(&playerPed);
+    check(events.empty(), "walking to the door starts no driving");
+    check(nVCModRidePhase == VCMOD_RIDE_BOARDING, "still waiting for the seat");
+
+    playerPed.m_objective = OBJECTIVE_LEAVE_CAR;
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(nVCModRideHandle == -1 && nVCModRidePhase == VCMOD_RIDE_NONE,
+          "an entry given up releases the ride");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE,
+          "and the car is driving again instead of waiting forever");
+
+    /* a boarding that never happens must not leave the car stopped */
+    beginRide(veh, -1);
+    playerPed.pos = CVector(31.0f, 0.0f, 0.0f);
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "walking away abandons the boarding");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE && veh.AutoPilot.m_nCruiseSpeed == 11,
+          "and the held car is released at its own pace");
+    check(playerPed.m_objective == OBJECTIVE_NONE, "Tommy stops chasing the car");
+
+    beginRide(veh, -1);
+    nowMs += VCMOD_BOARD_TIMEOUT + 1;
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_NONE, "a door that never opens times out");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE, "and the driver is let go");
+
+    /* getting into another car abandons the held one at once */
+    beginRide(veh, -1);
+    CVehicle other;
+    other.handle = 2; other.pDriver = &driverPed;
+    poolAdd(&other);
+    playerPed.bInVehicle = true; playerPed.m_pMyVehicle = &other;
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_NONE && veh.AutoPilot.m_nCarMission == MISSION_CRUISE,
+          "another car releases the held one");
+    playerPed.bInVehicle = false; playerPed.m_pMyVehicle = nil;
+
+    /* a new press on another car releases the one we were holding */
+    beginRide(veh, -1);
+    CVehicle second;
+    second.handle = 3; second.pDriver = &driverPed;
+    poolAdd(&second);
+    check(VCModPassengerEntry(&second), "the second car takes the press");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE && veh.AutoPilot.m_nCruiseSpeed == 11,
+          "the first car is released, not left waiting");
+    check(nVCModRideHandle == second.handle, "and the ride follows the new car");
+
+    beginRide(veh, -1);
+    sit(veh);
+    VCModUpdateRide(&playerPed);
+    check(nVCModRidePhase == VCMOD_RIDE_DRIVING, "seating moves the phase on");
+    check(events.empty(), "the journey is decided on the next frame");
+    VCModUpdateRide(&playerPed);
+    check(saw("join:1"), "traffic ride puts the car on the road system");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE, "the mission is cruise");
+    check(!bVCModRideHasDestination, "a cruise ride never arrives anywhere");
+
+    beginRide(veh, 1);
+    seated(veh);
+    check(saw("goto:1:100,200"), "a zone destination routes the driver");
+    check(veh.AutoPilot.m_nCarMission == MISSION_GOTOCOORDS, "the mission is goto coords");
+    check(bVCModRideHasDestination, "arrival is now being watched");
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(events.empty(), "far from the destination keeps driving");
+
+    veh.pos = CVector(105.0f, 205.0f, 0.0f);
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(veh.AutoPilot.m_nCarMission == MISSION_STOP_FOREVER && veh.AutoPilot.m_nCruiseSpeed == 0,
+          "arriving parks a street car");
+    check(saw("notice:passenger mode: arrived"), "arrival is announced");
+    check(nVCModRideHandle == veh.handle && nVCModRidePhase == VCMOD_RIDE_DRIVING,
+          "the ride waits with Tommy still in the car");
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(events.empty(), "the parked wait neither re-routes nor announces again");
+    playerPed.bInVehicle = false; playerPed.m_pMyVehicle = nil;
+    events.clear();
+    VCModUpdateRide(&playerPed);
+    check(nVCModRideHandle == -1 && nVCModRidePhase == VCMOD_RIDE_NONE,
+          "getting out of the parked car ends the ride");
+    check(veh.AutoPilot.m_nCarMission == MISSION_CRUISE && veh.AutoPilot.m_nCruiseSpeed == 11,
+          "and it goes back to traffic at its own pace, not left stopped");
+
+    beginRide(veh, 2);
+    seated(veh);
