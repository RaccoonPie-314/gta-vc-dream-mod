diff --git a/src/extras/vcmodpanel.cpp b/src/extras/vcmodpanel.cpp
new file mode 100644
index 0000000..af0f4a5
--- /dev/null
+++ b/src/extras/vcmodpanel.cpp
@@ -0,0 +1,1246 @@
+#include "common.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <ctype.h>
+
+#include "General.h"
+#include "RwHelper.h"
+#include "Pad.h"
+#include "Camera.h"
+#include "AnimBlendAssocGroup.h"
+#include "AnimBlendAssociation.h"
+#include "AnimBlendHierarchy.h"
+#include "ModelInfo.h"
+#include "PedModelInfo.h"
+#include "ModelIndices.h"
+#include "PedType.h"
+#include "Streaming.h"
+#include "Directory.h"
+#include "Zones.h"
+#include "vcmodpanel.h"
+#include "vcmodpathprobe.h"
+#include "vcmodtraffic.h"
+
+bool bVCModPlayerNpcAnims;
+int32 nVCModAnimChoice;
+bool bVCModMouseAimLockOn;
+bool bVCModAimAllWeapons;
+bool bVCModPlayerDoomAim;
+bool bVCModNoScopedAim;
+bool bVCModWalkMode;
+bool bVCModLockOnVehicles;
+bool bVCModNeverWanted;
+bool bVCModLockOnLatch;
+bool bVCModAdrenaline;
+bool bVCModAdrenalineSlowMo = true;
+bool bVCModCopPistol;
+// weapon.dat has no loop window for the cop animation, so the frame it is held at
+// has to come from somewhere the player can see and change
+int32 nVCModCopHoldFrame;
+int32 nVCModPedModel = -1;
+int32 nVCModPedCategory;
+bool bVCModPassengerMode;
+// ambient flavour rather than a cheat, so it starts on; the ini can turn it off
+// and the panel can flip it live
+bool bVCModStreetIdle = true;
+int32 nVCModRideZone;
+int32 nVCModRideStyle;
+
+static const char *aVCModRideStyleNames[] = {
+	"safe (traffic law)", "fast & aggressive"
+};
+
+// only groups built from aStdAnimDescs are offered. The skate group is the one
+// exception to the five-slot rule: it carries walk, run, sprint and idle, and
+// borrows startwalk from the player set the same way the game's skaters do.
+static const char *aVCModAnimGroupNames[] = {
+	"man (police, most male civs)", "gang1", "gang2", "shuffle", "oldman", "fatman",
+	"oldfatman", "jogger", "woman", "shopping", "busywoman", "sexywoman",
+	"fatwoman", "oldwoman", "jogwoman", "panicchunky", "skater (rollerblades)"
+};
+static const int32 aVCModAnimGroups[] = {
+	ASSOCGRP_STD, ASSOCGRP_GANG1, ASSOCGRP_GANG2, ASSOCGRP_SHUFFLE, ASSOCGRP_OLD,
+	ASSOCGRP_FAT, ASSOCGRP_OLDFAT, ASSOCGRP_JOGGER, ASSOCGRP_WOMAN, ASSOCGRP_WOMANSHOP,
+	ASSOCGRP_BUSYWOMAN, ASSOCGRP_SEXYWOMAN, ASSOCGRP_FATWOMAN, ASSOCGRP_OLDWOMAN,
+	ASSOCGRP_JOGWOMAN, ASSOCGRP_PANICCHUNKY, ASSOCGRP_SKATE
+};
+
+// SetRealMoveAnim blends these directly, so a group that cannot hand them out
+// must never become current. STARTWALK is left out: AddAnimation borrows the
+// player's clip for it, and ReApplyMoveAnims skips a slot the group lacks.
+static const AnimationId aVCModMoveAnims[] = {
+	ANIM_STD_IDLE, ANIM_STD_WALK, ANIM_STD_RUN, ANIM_STD_RUNFAST
+};
+
+static bool
+VCModGroupPlayable(AssocGroupId groupId)
+{
+	// model info carries group ids the mod never offered, so range-check before
+	// indexing the group table
+	if (groupId < 0 || groupId >= NUM_ANIM_ASSOC_GROUPS)
+		return false;
+
+	CAnimBlendAssocGroup *grp = &CAnimManager::GetAnimAssocGroups()[groupId];
+	if (grp->numAssociations <= 0) {
+		fprintf(stderr, "VCMOD refusing group %d, nothing built\n", groupId);
+		return false;
+	}
+	for (int32 i = 0; i < grp->numAssociations; i++) {
+		CAnimBlendHierarchy *h = grp->assocList[i].hierarchy;
+		if (h == nil || h->sequences == nil || h->numSequences <= 0) {
+			fprintf(stderr, "VCMOD refusing group %d, assoc %d (%s)\n",
+				groupId, i, h ? h->name : "nil hierarchy");
+			return false;
+		}
+	}
+
+	for (int32 i = 0; i < ARRAY_SIZE(aVCModMoveAnims); i++) {
+		CAnimBlendAssociation *anim = CAnimManager::GetAnimAssociation(groupId, aVCModMoveAnims[i]);
+		if (anim == nil || anim->hierarchy == nil) {
+			fprintf(stderr, "VCMOD refusing group %d, no slot %d\n", groupId, aVCModMoveAnims[i]);
+			return false;
+		}
+	}
+	return true;
+}
+
+bool
+VCModPickAnimGroup(AssocGroupId *out)
+{
+	if (!bVCModPlayerNpcAnims)
+		return false;
+
+	AssocGroupId want = (AssocGroupId) aVCModAnimGroups[nVCModAnimChoice];
+	static AssocGroupId loggedWant = NUM_ANIM_ASSOC_GROUPS;
+	if (want != loggedWant) {
+		fprintf(stderr, "VCMOD selecting %s (list %d -> group %d)\n",
+			aVCModAnimGroupNames[nVCModAnimChoice], nVCModAnimChoice, want);
+		loggedWant = want;
+	}
+	if (!VCModGroupPlayable(want))
+		return false;
+
+	*out = want;
+	return true;
+}
+
+static const char *aVCModPedCategoryNames[] = { "cops", "gangs", "civilians", "mission" };
+
+int32
+VCModPedCategoryOf(int32 pedType)
+{
+	switch (pedType) {
+	case PEDTYPE_COP:
+	case PEDTYPE_EMERGENCY:
+	case PEDTYPE_FIREMAN:
+		return VCMOD_PEDCAT_COPS;
+	case PEDTYPE_GANG1:
+	case PEDTYPE_GANG2:
+	case PEDTYPE_GANG3:
+	case PEDTYPE_GANG4:
+	case PEDTYPE_GANG5:
+	case PEDTYPE_GANG6:
+	case PEDTYPE_GANG7:
+	case PEDTYPE_GANG8:
+	case PEDTYPE_GANG9:
+		return VCMOD_PEDCAT_GANGS;
+	// the player shelves are Tommy's own, and he is already on the list. The
+	// story bodies are not a ped type either: default.ide hands those slots to
+	// CIVMALE, and their real models live in the cutscene table
+	case PEDTYPE_SPECIAL:
+	case PEDTYPE_PLAYER1:
+	case PEDTYPE_PLAYER2:
+	case PEDTYPE_PLAYER3:
+	case PEDTYPE_PLAYER4:
+		return -1;
+	}
+	return VCMOD_PEDCAT_CIVILIANS;
+}
+
+// read from the model table the game loaded, so every ped it actually ships
+// appears without a hand-kept list going stale
+static bool
+VCModRosterPed(int32 modelIndex, int32 category, int16 *outIndex, const char **outName)
+{
+	if (modelIndex >= MI_SPECIAL01 && modelIndex <= MI_LAST_PED)
+		return false;
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+	if (VCModPedCategoryOf(((CPedModelInfo *) mi)->m_pedType) != category)
+		return false;
+	if (outIndex)
+		*outIndex = modelIndex;
+	if (outName)
+		*outName = mi->GetModelName();
+	return true;
+}
+
+// a special slot only has a body once the archive actually holds the file the
+// cutscene table names for it; asking for the placeholder streams nothing
+static bool
+VCModRosterSpecial(int32 entry, int16 *outIndex, const char **outName)
+{
+	if (entry < 0 || entry > MI_LAST_PED - MI_SPECIAL01)
+		return false;
+
+	const char *name = CStreaming::GetSpecialCharModelName(entry);
+	if (name == nil)
+		return false;
+
+	uint32 pos, size;
+	if (CStreaming::ms_pExtraObjectsDir == nil ||
+			!CStreaming::ms_pExtraObjectsDir->FindItem(name, pos, size))
+		return false;
+
+	if (outIndex)
+		*outIndex = (int16) (MI_SPECIAL01 + entry);
+	if (outName)
+		*outName = name;
+	return true;
+}
+
+int32
+VCModPedModelCount(int32 category)
+{
+	// entry 0 is always Tommy: the way back from any character
+	int32 n = 1;
+	if (category == VCMOD_PEDCAT_MISSION) {
+		for (int32 i = 0; i <= MI_LAST_PED - MI_SPECIAL01; i++)
+			if (VCModRosterSpecial(i, nil, nil))
+				n++;
+		return n;
+	}
+	for (int32 i = MI_COP; i <= MI_LAST_PED; i++)
+		if (VCModRosterPed(i, category, nil, nil))
+			n++;
+	return n;
+}
+
+bool
+VCModPedModelAt(int32 category, int32 entry, int16 *outIndex, const char **outName)
+{
+	if (entry < 0)
+		return false;
+	if (entry == 0) {
+		*outIndex = MI_PLAYER;
+		*outName = "Tommy Vercetti";
+		return true;
+	}
+	if (category == VCMOD_PEDCAT_MISSION) {
+		for (int32 i = 0; i <= MI_LAST_PED - MI_SPECIAL01; i++) {
+			if (!VCModRosterSpecial(i, outIndex, outName))
+				continue;
+			if (--entry == 0)
+				return true;
+		}
+		return false;
+	}
+	for (int32 i = MI_COP; i <= MI_LAST_PED; i++) {
+		if (!VCModRosterPed(i, category, outIndex, outName))
+			continue;
+		if (--entry == 0)
+			return true;
+	}
+	return false;
+}
+
+// gxt names are 16 bit and the panel charset fonts take bytes, so the zone label
+// has to be narrowed before it can be drawn
+static char aVCModZoneLabel[32];
+
+static const char *
+VCModZoneLabel(CZone *zone)
+{
+	wchar *name = zone->GetTranslatedName();
+	int32 i;
+	for (i = 0; i < (int32) sizeof(aVCModZoneLabel) - 1 && name != nil && name[i] != 0; i++)
+		aVCModZoneLabel[i] = (char) name[i];
+	aVCModZoneLabel[i] = '\0';
+	return aVCModZoneLabel;
+}
+
+int32
+VCModRideZoneCount(void)
+{
+	// entry 0 is cruise with traffic, then every map zone but the whole-map box
+	if (CTheZones::GetNumberOfMapZones() <= 1)
+		return 1;
+	return 1 + (int32) CTheZones::GetNumberOfMapZones() - 1;
+}
+
+bool
+VCModRideZoneAt(int32 entry, int32 *outZoneIndex, const char **outName, CVector *outPos)
+{
+	if (entry < 0 || entry >= VCModRideZoneCount())
+		return false;
+
+	if (entry == 0) {
+		if (outZoneIndex != nil)
+			*outZoneIndex = -1;
+		if (outName != nil)
+			*outName = "traffic (cruise)";
+		return true;
+	}
+
+	// zone 0 is "THEMAP", so the list is offset by one
+	CZone *zone = CTheZones::GetMapZone((uint16) entry);
+	if (zone == nil)
+		return false;
+
+	if (outZoneIndex != nil)
+		*outZoneIndex = entry;
+	if (outName != nil)
+		*outName = VCModZoneLabel(zone);
+	if (outPos != nil) {
+		outPos->x = (zone->minx + zone->maxx) * 0.5f;
+		outPos->y = (zone->miny + zone->maxy) * 0.5f;
+		outPos->z = 0.0f;
+	}
+	return true;
+}
+
+bool
+VCModPedAnimGroupFor(int16 modelIndex, AssocGroupId *out)
+{
+	// Tommy's stock logic picks a different group per weapon and per strafe, so
+	// pinning him to one group would take those away
+	if (modelIndex == MI_PLAYER)
+		return false;
+
+	CBaseModelInfo *mi = CModelInfo::GetModelInfo(modelIndex);
+	if (mi == nil || mi->GetModelType() != MITYPE_PED)
+		return false;
+
+	AssocGroupId grp = (AssocGroupId) ((CPedModelInfo *) mi)->m_animGroup;
+	if (!VCModGroupPlayable(grp))
+		return false;
+
+	*out = grp;
+	return true;
+}
