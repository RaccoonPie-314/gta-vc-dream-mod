+#!/usr/bin/env python3
+"""Diagnostic probes: temporary logging stays in the tree behind one switch.
+
+The probes flooded reVC.log during street idle. They are kept for future
+debugging, but print only when DIAGNOSTICS is on; feature events and errors
+stay unconditional.
+"""
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
