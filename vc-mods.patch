+#!/usr/bin/env python3
+"""Manual-reload tests: the clip decision on its own, plus static checks that the
+input, the ped hook and the panel row stay wired."""
+import pathlib
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+RELOAD = ROOT / "src/extras/vcmodreload.cpp"
+RELOAD_H = ROOT / "src/extras/vcmodreload.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+PED = ROOT / "src/peds/Ped.h"
+PEDFIGHT = ROOT / "src/peds/PedFight.cpp"
+PLAYERINFO = ROOT / "src/core/PlayerInfo.cpp"
+INI = ROOT / "src/core/re3.cpp"
+
+PRELUDE = r'''
+#include <stdio.h>
+typedef int int32;
+#define Min(a,b) ((a) < (b) ? (a) : (b))
+static int failed = 0;
+#define CHECK(c, m) do { if (!(c)) { printf("FAIL: %s\n", m); failed++; } } while (0)
+'''
+
+MAIN = r'''
+int main() {
+    CHECK(VCModReloadNeeded(0, 30, 17), "an empty clip with a reserve reloads");
+    CHECK(VCModReloadNeeded(10, 30, 17), "a part-used clip reloads");
+    CHECK(!VCModReloadNeeded(17, 30, 17), "a full clip does nothing");
+    CHECK(!VCModReloadNeeded(5, 5, 17), "a reserve already in the clip does nothing");
+    CHECK(!VCModReloadNeeded(0, 0, 17), "no rounds at all does nothing");
+    CHECK(VCModReloadNeeded(0, 8, 17), "a short reserve still fills the clip");
+    CHECK(!VCModReloadNeeded(0, 30, 0), "a weapon with no clip size does nothing");
+    return failed != 0;
+}
+'''
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+def cut(name):
+    text = RELOAD.read_text()
+    match = re.search(r"((?:[A-Za-z_][A-Za-z0-9_]*[\s*]+)+)" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text)
+    if match is None:
+        raise AssertionError(f"{name} not found in {RELOAD}")
+    start = match.start()
+    opening = match.end() - 1
+    depth = 0
+    for i in range(opening, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:i + 1]
+    raise AssertionError(f"{name} is unbalanced")
+
+
+def source():
+    return PRELUDE + cut("VCModReloadNeeded") + MAIN
+
+
+class ReloadTests(unittest.TestCase):
+    def test_clip_decision(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            exe = pathlib.Path(tmp) / "reload"
+            build = subprocess.run(
+                ["c++", "-std=c++98", "-x", "c++", "-", "-o", str(exe)],
+                input=source(), text=True, capture_output=True)
+            self.assertEqual(build.returncode, 0, build.stderr)
+            run = subprocess.run([str(exe)], text=True, capture_output=True)
+            self.assertEqual(run.returncode, 0, run.stdout + run.stderr)
+            self.assertNotIn("FAIL:", run.stdout)
+
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+        ped = PED.read_text()
+        fight = PEDFIGHT.read_text()
+        info = PLAYERINFO.read_text()
+        ini = INI.read_text()
+        hook = RELOAD.read_text()
+
+        self.assertIn('"MANUAL RELOAD"', rows)
+        self.assertIn("&bVCModManualReload", rows)
+        self.assertIn("&bVCModManualReload", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "ManualReload"', ini)
+        self.assertIn("VCModManualReloadTick(this)", info)
+
+        self.assertIn("void StartReloadNow(void);", ped)
+        self.assertIn("CPed::StartReloadNow(void)", fight)
+        call = braced(fight, "CPed::StartReloadNow(void)")
+        self.assertIn("WEAPONSTATE_RELOADING", call)
+        self.assertIn("FinishedReloadCB", call)
+        self.assertIn("m_nReload", call)
+        self.assertIn("m_bFastReload", call)
+
+        # R is the radio key in a car, so the tick must stay on foot and skip melee
+        tick = braced(RELOAD.read_text(), "VCModManualReloadTick(CPlayerInfo *info)")
+        self.assertIn("aVCModKeys[VCKEY_RELOAD]", hook)
+        self.assertIn("VCModKeyCapturing()", tick)
+        self.assertIn("bInVehicle", tick)
+        self.assertIn("WEAPON_FIRE_MELEE", tick)
+        self.assertIn("StartReloadNow();", tick)
+
+
+if __name__ == "__main__":
+    unittest.main()
