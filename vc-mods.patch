+#!/usr/bin/env python3
+"""Explosion cover: a building between the blast and a victim stops the damage
+and the chain detonation behind it, and the stock radius test still comes first."""
+import pathlib
+import unittest
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+WORLD = ROOT / "src/core/World.cpp"
+MOD = ROOT / "src/extras/vcmodexplosion.cpp"
+MOD_H = ROOT / "src/extras/vcmodexplosion.h"
+PANEL = "".join((ROOT / "src/extras" / name).read_text() for name in (
+    "vcmodpanel.cpp", "vcmodpanelregistry.cpp", "vcmodpanelcatalog.cpp",
+    "vcmodpanelinternal.h"))
+INI = ROOT / "src/core/re3.cpp"
+
+
+def braced(source, marker):
+    start = source.index(marker)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+class ExplosionCoverTests(unittest.TestCase):
+    def test_wiring(self):
+        panel = PANEL
+        rows = braced(panel, "const VCModRowDef aVCModRows[]")
+        switched = braced(panel, "static bool *aVCModSwitched[]")
+
+        self.assertIn('"EXPLOSION COVER"', rows)
+        self.assertIn("&bVCModExplosionCover", switched)
+        self.assertIn('ReadIniIfExists("VC Mods", "ExplosionCover"', INI.read_text())
+        self.assertIn("extern bool bVCModExplosionCover;", MOD_H.read_text())
+
+    def test_hook(self):
+        world = WORLD.read_text()
+        self.assertIn('#include "vcmodexplosion.h"', world)
+
+        func = braced(world, "CWorld::TriggerExplosionSectorList")
+        reach = func.index("VCModExplosionReaches(position, pEntity)")
+        # only entities the blast already covers are tested for cover
+        self.assertLess(func.index("if(fRadius > fMagnitude)"), reach)
+        # and the barrel behind the wall stays intact
+        self.assertLess(reach, func.index("CWeapon::BlowUpExplosiveThings(pEntity)"))
+
+    def test_helper(self):
+        mod = MOD.read_text()
+        self.assertIn("bool bVCModExplosionCover = true;", mod)
+
+        helper = braced(mod, "VCModExplosionReaches(const CVector &from, CEntity *entity)")
+        self.assertIn("if (!bVCModExplosionCover || entity == nil)", helper)
+        # buildings only: a car or a ped in the way does not shield a blast
+        self.assertIn("GetIsLineOfSightClear(start, to,", helper)
+        self.assertIn("true, false, false, false, false, false", helper)
+        # the ray starts a step out, so a blast against a wall still reads the room
+        self.assertIn("0.5f / len", helper)
+
+
+if __name__ == "__main__":
+    unittest.main()
