diff --git a/src/extras/vcmodkeys.cpp b/src/extras/vcmodkeys.cpp
new file mode 100644
index 0000000..6ea3a64
--- /dev/null
+++ b/src/extras/vcmodkeys.cpp
@@ -0,0 +1,210 @@
+#include "common.h"
+
+#include <stdio.h>
+#include <ctype.h>
+
+#include "main.h"
+#include "Pad.h"
+#include "ControllerConfig.h"
+#include "vcmodkeys.h"
+
+// the keys the mod shipped with, one per action in eVCModKey order
+int32 aVCModKeys[NUM_VCKEYS] = {
+	'\\',	// panel
+	'B',	// walk mode
+	'G',	// fire
+	'H',	// call driver
+	'K',	// spin kick
+	'R',	// reload
+	'J',	// chase spot
+	'U',	// chase capture
+	'C',	// cockpit view
+	'V',	// call crew
+	'P'		// passenger
+};
+
+static const int32 aVCModKeyDefaults[NUM_VCKEYS] = {
+	'\\', 'B', 'G', 'H', 'K', 'R', 'J', 'U', 'C', 'V', 'P'
+};
+
+static const char *aVCModKeyLabels[NUM_VCKEYS] = {
+	"PANEL KEY", "WALK MODE", "FIRE", "CALL DRIVER",
+	"SPIN KICK", "RELOAD", "CHASE SPOT", "CHASE CAPTURE", "1ST PERSON",
+	"CALL CREW", "PASSENGER"
+};
+
+static const char *aVCModKeyIniNames[NUM_VCKEYS] = {
+	"KeyPanel", "KeyWalk", "KeyFire", "KeyDriver",
+	"KeyKick", "KeyReload", "KeySpot", "KeyCapture", "KeyFirstPerson",
+	"KeyCrew", "KeyPassenger"
+};
+
+static int32 nVCModCaptureWhich = -1;
+
+const char *
+VCModKeyLabel(int32 which)
+{
+	if (which < 0 || which >= NUM_VCKEYS)
+		return "KEY";
+	return aVCModKeyLabels[which];
+}
+
+const char *
+VCModKeyIniKey(int32 which)
+{
+	if (which < 0 || which >= NUM_VCKEYS)
+		return nil;
+	return aVCModKeyIniNames[which];
+}
+
+void
+VCModKeyName(int32 code, char *buf, int32 size)
+{
+	if (code >= ' ' && code < 127) {
+		if (code == ' ')
+			snprintf(buf, size, "SPACE");
+		else
+			snprintf(buf, size, "%c", (char) toupper(code));
+		return;
+	}
+
+	if (code >= rsF1 && code <= rsF12) {
+		snprintf(buf, size, "F%d", (int) (code - rsF1 + 1));
+		return;
+	}
+
+	switch (code) {
+	case rsESC:	snprintf(buf, size, "ESC");	return;
+	case rsINS:	snprintf(buf, size, "INS");	return;
+	case rsDEL:	snprintf(buf, size, "DEL");	return;
+	case rsHOME:	snprintf(buf, size, "HOME");	return;
+	case rsEND:	snprintf(buf, size, "END");	return;
+	case rsPGUP:	snprintf(buf, size, "PGUP");	return;
+	case rsPGDN:	snprintf(buf, size, "PGDN");	return;
+	case rsUP:	snprintf(buf, size, "UP");	return;
+	case rsDOWN:	snprintf(buf, size, "DOWN");	return;
+	case rsLEFT:	snprintf(buf, size, "LEFT");	return;
+	case rsRIGHT:	snprintf(buf, size, "RIGHT");	return;
+	case rsDIVIDE:	snprintf(buf, size, "PAD/");	return;
+	case rsTIMES:	snprintf(buf, size, "PAD*");	return;
+	case rsPLUS:	snprintf(buf, size, "PAD+");	return;
+	case rsMINUS:	snprintf(buf, size, "PAD-");	return;
+	case rsPADDEL:	snprintf(buf, size, "PADDEL");	return;
+	case rsPADEND:	snprintf(buf, size, "PADEND");	return;
+	case rsPADDOWN:	snprintf(buf, size, "PADDOWN");	return;
+	case rsPADPGDN:	snprintf(buf, size, "PADPGDN");	return;
+	case rsPADLEFT:	snprintf(buf, size, "PADLEFT");	return;
+	case rsPAD5:	snprintf(buf, size, "PAD5");	return;
+	case rsNUMLOCK:	snprintf(buf, size, "NUMLOCK");	return;
+	case rsPADRIGHT:	snprintf(buf, size, "PADRIGHT");	return;
+	case rsPADHOME:	snprintf(buf, size, "PADHOME");	return;
+	case rsPADUP:	snprintf(buf, size, "PADUP");	return;
+	case rsPADPGUP:	snprintf(buf, size, "PADPGUP");	return;
+	case rsPADINS:	snprintf(buf, size, "PADINS");	return;
+	case rsPADENTER:	snprintf(buf, size, "PADENTER");	return;
+	case rsSCROLL:	snprintf(buf, size, "SCROLL");	return;
+	case rsPAUSE:	snprintf(buf, size, "PAUSE");	return;
+	case rsBACKSP:	snprintf(buf, size, "BKSP");	return;
+	case rsTAB:	snprintf(buf, size, "TAB");	return;
+	case rsCAPSLK:	snprintf(buf, size, "CAPS");	return;
+	case rsENTER:	snprintf(buf, size, "ENTER");	return;
+	case rsLSHIFT:	snprintf(buf, size, "LSHIFT");	return;
+	case rsRSHIFT:	snprintf(buf, size, "RSHIFT");	return;
+	case rsSHIFT:	snprintf(buf, size, "SHIFT");	return;
+	case rsLCTRL:	snprintf(buf, size, "LCTRL");	return;
+	case rsRCTRL:	snprintf(buf, size, "RCTRL");	return;
+	case rsLALT:	snprintf(buf, size, "LALT");	return;
+	case rsRALT:	snprintf(buf, size, "RALT");	return;
+	case rsLWIN:	snprintf(buf, size, "LWIN");	return;
+	case rsRWIN:	snprintf(buf, size, "RWIN");	return;
+	case rsAPPS:	snprintf(buf, size, "APPS");	return;
+	}
+
+	snprintf(buf, size, "KEY %d", (int) code);
+}
+
+bool
+VCModKeyCapturing(void)
+{
+	return nVCModCaptureWhich >= 0;
+}
+
+bool
+VCModKeyArmed(int32 which)
+{
+	return nVCModCaptureWhich == which;
+}
+
+void
+VCModKeyArm(int32 which)
+{
+	if (which < 0 || which >= NUM_VCKEYS)
+		return;
+	nVCModCaptureWhich = which;
+}
+
+void
+VCModKeyCancel(void)
+{
+	nVCModCaptureWhich = -1;
+}
+
+void
+VCModKeySave(int32 which)
+{
+#ifdef LOAD_INI_SETTINGS
+	if (which < 0 || which >= NUM_VCKEYS)
+		return;
+	IniStoreKey("VC Mods", aVCModKeyIniNames[which], aVCModKeys[which]);
+	if (!IniFlush())
+		fprintf(stderr, "VCMOD could not write reVC.ini\n");
+#endif
+}
+
+void
+VCModKeyPoll(void)
+{
+	if (nVCModCaptureWhich < 0)
+		return;
+
+	int32 code = rsNULL;
+	CPad::EditCodesForControls(&code, 1);
+	if (code == rsNULL)
+		return;
+
+	int32 which = nVCModCaptureWhich;
+	nVCModCaptureWhich = -1;
+
+	// Esc is the way out of a capture that was a mistake
+	if (code == rsESC)
+		return;
+
+	aVCModKeys[which] = code;
+	VCModKeySave(which);
+	fprintf(stderr, "VCMOD key %s = %d\n", aVCModKeyLabels[which], (int) code);
+}
+
+void
+VCModKeyResetAll(void)
+{
+	for (int32 i = 0; i < NUM_VCKEYS; i++) {
+		aVCModKeys[i] = aVCModKeyDefaults[i];
+#ifdef LOAD_INI_SETTINGS
+		IniStoreKey("VC Mods", aVCModKeyIniNames[i], aVCModKeys[i]);
+#endif
+	}
+#ifdef LOAD_INI_SETTINGS
+	if (!IniFlush())
+		fprintf(stderr, "VCMOD could not write reVC.ini\n");
+#endif
+	fprintf(stderr, "VCMOD keys reset to defaults\n");
+}
+
+void
+VCModKeySanitize(void)
+{
+	for (int32 i = 0; i < NUM_VCKEYS; i++) {
+		if (aVCModKeys[i] <= 0 || aVCModKeys[i] >= rsNULL)
+			aVCModKeys[i] = aVCModKeyDefaults[i];
+	}
+}
diff --git a/src/extras/vcmodkeys.h b/src/extras/vcmodkeys.h
new file mode 100644
index 0000000..61707fc
--- /dev/null
+++ b/src/extras/vcmodkeys.h
@@ -0,0 +1,45 @@
+#ifndef VCMODKEYS_H
+#define VCMODKEYS_H
+
+// The mod's own hotkeys, rebindable from the panel's KEYS page. Printable keys
+// are ASCII; the rest are RsKeyCodes. A binding is a setting, not a switch, so
+// it is written to reVC.ini the moment it changes instead of waiting for PERMA.
+enum eVCModKey
+{
+	VCKEY_PANEL,	// opens the VC MODS panel
+	VCKEY_WALK,		// WALK MODE on and off
+	VCKEY_FIRE,		// presses fire without the stock binding
+	VCKEY_DRIVER,	// calls or dismisses the chauffeur
+	VCKEY_KICK,		// the spinning roundhouse
+	VCKEY_RELOAD,	// manual reload on foot
+	VCKEY_SPOT,		// chase minigame: shows the next beat
+	VCKEY_CAPTURE,	// chase minigame: grabs the lead car
+	VCKEY_FIRSTPERSON,	// cockpit view on and off
+	VCKEY_CREW,		// calls or dismisses the Vercetti crew
+	VCKEY_PASSENGER,	// boards the nearest car as a passenger
+	NUM_VCKEYS
+};
+
+extern int32 aVCModKeys[NUM_VCKEYS];
+
+// short label for the panel's value cell
+void VCModKeyName(int32 code, char *buf, int32 size);
+const char *VCModKeyLabel(int32 which);
+const char *VCModKeyIniKey(int32 which);
+
+// The next key press becomes `which`. While armed the mod's own hotkey handlers
+// stand down, so the press used to bind does not also fire, reload or toggle.
+void VCModKeyArm(int32 which);
+bool VCModKeyCapturing(void);
+bool VCModKeyArmed(int32 which);
+// drops an arm without binding; for a panel that stops drawing mid-capture
+void VCModKeyCancel(void);
+// once per frame while the panel is open: assigns and saves on a press, Esc cancels
+void VCModKeyPoll(void);
+
+void VCModKeyResetAll(void);
+void VCModKeySave(int32 which);
+// a value read from the ini that is not a key falls back to its default
+void VCModKeySanitize(void);
+
+#endif
diff --git a/src/extras/vcmodlighttex.cpp b/src/extras/vcmodlighttex.cpp
new file mode 100644
index 0000000..02b2ba8
--- /dev/null
+++ b/src/extras/vcmodlighttex.cpp
@@ -0,0 +1,82 @@
+#include "common.h"
+
+#include "vcmodlighttex.h"
+
+#include "VehicleModelInfo.h"
+#include "TxdStore.h"
+
+bool bVCModLightTextures = true;
+
+// the unlit texture the model material already points at, and the lit one the
+// same TXD carries beside it
+static const char *ms_lightTexNames[][2] = {
+	{ "lights",        "lightson" },
+	{ "servicelights", "servicelightson" },
+};
+
+void
+VCModLightTextCollect(CVehicleModelInfo *mi, RpMaterial *material)
+{
+	RwTexture *tex = RpMaterialGetTexture(material);
+	if(tex == nil)
+		return;
+
+	const char *name = RwTextureGetName(tex);
+	for(uint32 p = 0; p < ARRAY_SIZE(ms_lightTexNames); p++){
+		if(strcmp(name, ms_lightTexNames[p][0]) != 0)
+			continue;
+
+		for(uint32 i = 0; i < mi->m_numLightMaterials; i++)
+			if(mi->m_lightMaterials[i] == material)
+				return;
+		if(mi->m_numLightMaterials >= NUM_LIGHT_MATERIALS)
+			return;
+
+		uint32 i = mi->m_numLightMaterials++;
+		mi->m_lightMaterials[i] = material;
+		mi->m_lightOffTex[i] = tex;
+		mi->m_lightOnTex[i] = nil;
+		mi->m_lightPair[i] = p;
+		return;
+	}
+}
+
+static RwTexture*
+FindLitTexture(CVehicleModelInfo *mi, uint8 pair)
+{
+	int16 slot = mi->GetTxdSlot();
+	if(slot < 0)
+		return nil;
+
+	TxdDef *def = CTxdStore::GetSlot(slot);
+	if(def == nil || def->texDict == nil)
+		return nil;
+
+	return RwTexDictionaryFindNamedTexture(def->texDict, ms_lightTexNames[pair][1]);
+}
+
+void
+VCModLightTextRender(CVehicleModelInfo *mi, bool lightsOn, bool serviceOn)
+{
+	if(mi->m_numLightMaterials == 0)
+		return;
+
+	for(uint32 i = 0; i < mi->m_numLightMaterials; i++){
+		// the roof bar of a police car follows the siren, the rest follows the
+		// headlight switch
+		bool on = lightsOn || (mi->m_lightPair[i] == 1 && serviceOn);
+		if(!bVCModLightTextures)
+			on = false;
+
+		// the model's texture dictionary may not have been loaded when the
+		// material list was built, so the pair is looked up on first use
+		if(on && mi->m_lightOnTex[i] == nil && !(mi->m_lightTexTried & (1u << i))){
+			mi->m_lightOnTex[i] = FindLitTexture(mi, mi->m_lightPair[i]);
+			mi->m_lightTexTried |= 1u << i;
+		}
+
+		RwTexture *tex = on && mi->m_lightOnTex[i] ? mi->m_lightOnTex[i] : mi->m_lightOffTex[i];
+		if(RpMaterialGetTexture(mi->m_lightMaterials[i]) != tex)
+			RpMaterialSetTexture(mi->m_lightMaterials[i], tex);
+	}
+}
diff --git a/src/extras/vcmodlighttex.h b/src/extras/vcmodlighttex.h
